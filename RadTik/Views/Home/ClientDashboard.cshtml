@using RadTik.Models
@{
    ViewData["Title"] = "لوحة التحكم";
    Client? clientData = ViewBag.Client as Client;
    bool noSubscription = ViewBag.NoSubscription ?? true;
    int daysRemaining = ViewBag.DaysRemaining ?? 0;
    bool isExpired = ViewBag.IsExpired ?? false;
    double usagePercent = ViewBag.UsagePercent ?? 0;
}

<link rel="stylesheet" href="~/css/radtik-theme.css" asp-append-version="true" />

<style>
    .client-dashboard {
        animation: fadeIn 0.5s ease;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .no-subscription-card {
        background: var(--bg-card);
        border-radius: 20px;
        padding: 60px 40px;
        text-align: center;
        box-shadow: var(--shadow-md);
        border: 1px solid var(--border-light);
    }

    .no-subscription-icon {
        width: 120px;
        height: 120px;
        background: rgba(113, 128, 150, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 30px;
    }

    .no-subscription-icon i {
        font-size: 50px;
        color: #718096;
    }

    .no-subscription-card h2 {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 15px;
    }

    .no-subscription-card p {
        color: var(--text-muted);
        max-width: 500px;
        margin: 0 auto 30px;
        line-height: 1.7;
    }

    .support-buttons {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .support-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 28px;
        border-radius: 12px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s;
    }

    .support-btn.primary {
        background: var(--primary);
        color: white;
    }

    .support-btn.success {
        background: #25D366;
        color: white;
    }

    .support-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.15);
    }

    /* Client with subscription styles */
    .welcome-section {
        margin-bottom: 30px;
    }

    .welcome-section h1 {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 5px;
    }

    .welcome-section p {
        color: var(--text-muted);
    }

    .subscription-hero {
        background: var(--bg-card);
        border-radius: 20px;
        overflow: hidden;
        box-shadow: var(--shadow-md);
        border: 1px solid var(--border-light);
        margin-bottom: 30px;
    }

    .subscription-header {
        background: linear-gradient(135deg, var(--primary) 0%, #004d99 100%);
        padding: 35px;
        color: white;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

    .subscription-header::before {
        content: '';
        position: absolute;
        top: -50%;
        right: -50%;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
    }

    .subscription-header.warning {
        background: linear-gradient(135deg, #ff9800 0%, #f57c00 100%);
    }

    .subscription-header.expired {
        background: linear-gradient(135deg, #f44336 0%, #d32f2f 100%);
    }

    .subscription-plan {
        font-size: 1.75rem;
        font-weight: 700;
        margin-bottom: 10px;
        position: relative;
    }

    .subscription-speed {
        font-size: 1.1rem;
        opacity: 0.95;
        position: relative;
    }

    .subscription-speed i {
        margin-left: 5px;
    }

    .subscription-body {
        padding: 30px;
    }

    .subscription-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .sub-stat {
        text-align: center;
        padding: 20px;
        background: var(--bg-hover);
        border-radius: 15px;
    }

    .sub-stat-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-primary);
        margin-bottom: 5px;
    }

    .sub-stat-value.active { color: var(--primary); }
    .sub-stat-value.success { color: var(--success); }
    .sub-stat-value.warning { color: #ff9800; }
    .sub-stat-value.danger { color: var(--danger); }

    .sub-stat-label {
        font-size: 0.85rem;
        color: var(--text-muted);
    }

    .usage-section {
        background: var(--bg-hover);
        border-radius: 15px;
        padding: 25px;
    }

    .usage-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 15px;
    }

    .usage-label {
        font-weight: 600;
        color: var(--text-primary);
    }

    .usage-value {
        font-weight: 700;
        color: var(--primary);
    }

    .usage-bar {
        height: 12px;
        background: var(--border-color);
        border-radius: 6px;
        overflow: hidden;
    }

    .usage-fill {
        height: 100%;
        background: linear-gradient(90deg, var(--primary) 0%, var(--success) 100%);
        border-radius: 6px;
        transition: width 0.5s ease;
    }

    .usage-fill.warning {
        background: linear-gradient(90deg, #ffc107 0%, #ff9800 100%);
    }

    .usage-fill.danger {
        background: linear-gradient(90deg, #ff9800 0%, #f44336 100%);
    }

    .details-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 25px;
        margin-bottom: 30px;
    }

    .detail-card {
        background: var(--bg-card);
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-light);
        overflow: hidden;
    }

    .detail-card-header {
        padding: 18px 25px;
        border-bottom: 1px solid var(--border-light);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .detail-card-header i {
        font-size: 1.1rem;
        color: var(--primary);
    }

    .detail-card-header h3 {
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0;
    }

    .detail-card-body {
        padding: 20px 25px;
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid var(--border-light);
    }

    .info-row:last-child {
        border-bottom: none;
    }

    .info-row .label {
        color: var(--text-muted);
        font-size: 0.9rem;
    }

    .info-row .value {
        font-weight: 600;
        color: var(--text-primary);
    }

    .info-row .value code {
        background: var(--bg-hover);
        padding: 4px 10px;
        border-radius: 6px;
        font-family: monospace;
    }

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .status-badge.active {
        background: rgba(0, 200, 83, 0.1);
        color: var(--success);
    }

    .status-badge.inactive {
        background: rgba(244, 67, 54, 0.1);
        color: var(--danger);
    }

    /* Support Section */
    .support-section {
        background: var(--bg-card);
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-light);
        overflow: hidden;
    }

    .support-header {
        padding: 18px 25px;
        border-bottom: 1px solid var(--border-light);
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .support-header i {
        font-size: 1.1rem;
        color: var(--primary);
    }

    .support-header h3 {
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-primary);
        margin: 0;
    }

    .support-body {
        padding: 25px;
    }

    .support-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
    }

    .support-item {
        text-align: center;
        padding: 25px;
        background: var(--bg-hover);
        border-radius: 15px;
    }

    .support-item h4 {
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .support-item h4 i {
        font-size: 1.2rem;
    }

    .support-item h4 i.fa-phone { color: var(--primary); }
    .support-item h4 i.fa-whatsapp { color: #25D366; }
    .support-item h4 i.fa-clock { color: #00B4D8; }

    .support-item p {
        color: var(--text-muted);
        font-size: 0.9rem;
        margin-bottom: 15px;
    }

    .support-item .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 24px;
        border-radius: 10px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s;
    }

    .support-item .btn-primary {
        background: var(--primary);
        color: white;
    }

    .support-item .btn-success {
        background: #25D366;
        color: white;
    }

    .support-item .btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.15);
    }

    @@media (max-width: 992px) {
        .subscription-stats {
            grid-template-columns: repeat(2, 1fr);
        }
        .details-grid {
            grid-template-columns: 1fr;
        }
        .support-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 576px) {
        .subscription-stats {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="client-dashboard">
    @if (noSubscription)
    {
        <div class="no-subscription-card">
            <div class="no-subscription-icon">
                <i class="fas fa-user-slash"></i>
            </div>
            <h2>لا يوجد اشتراك مرتبط بحسابك</h2>
            <p>
                يرجى التواصل مع الإدارة لربط حسابك باشتراك خدمة الإنترنت الخاص بك.
                يمكنك الاتصال بنا أو التواصل عبر واتساب.
            </p>
            <div class="support-buttons">
                <a href="tel:+963123456789" class="support-btn primary">
                    <i class="fas fa-phone"></i>
                    اتصل بالدعم الفني
                </a>
                <a href="https://wa.me/963123456789" target="_blank" class="support-btn success">
                    <i class="fab fa-whatsapp"></i>
                    واتساب
                </a>
            </div>
        </div>
    }
    else if (clientData != null)
    {
        <div class="welcome-section">
            <h1>مرحباً، @clientData.Name!</h1>
            <p>إليك ملخص اشتراكك في خدمة الإنترنت</p>
        </div>
        
        <div class="subscription-hero">
            <div class="subscription-header @(isExpired ? "expired" : daysRemaining <= 7 ? "warning" : "")">
                @if (isExpired)
                {
                    <div style="font-size: 1.5rem; margin-bottom: 10px;">
                        <i class="fas fa-exclamation-triangle"></i>
                    </div>
                    <div class="subscription-plan">اشتراك منتهي</div>
                    <div class="subscription-speed">يرجى تجديد اشتراكك للاستمرار في الخدمة</div>
                }
                else
                {
                    <div class="subscription-plan">@(clientData.Profile?.Name ?? "غير محدد")</div>
                    <div class="subscription-speed">
                        @if (clientData.Profile != null)
                        {
                            <span><i class="fas fa-download"></i> @(clientData.Profile.DownloadSpeedDisplay)</span>
                            <span style="margin: 0 15px;">|</span>
                            <span><i class="fas fa-upload"></i> @(clientData.Profile.UploadSpeedDisplay)</span>
                        }
                    </div>
                }
            </div>
            
            <div class="subscription-body">
                <div class="subscription-stats">
                    <div class="sub-stat">
                        <div class="sub-stat-value @(clientData.IsActive ? "active" : "danger")">
                            @(clientData.IsActive ? "نشط" : "معطل")
                        </div>
                        <div class="sub-stat-label">حالة الحساب</div>
                    </div>
                    
                    <div class="sub-stat">
                        <div class="sub-stat-value @(isExpired ? "danger" : daysRemaining <= 7 ? "warning" : "success")">
                            @(isExpired ? "منتهي" : daysRemaining + " يوم")
                        </div>
                        <div class="sub-stat-label">الأيام المتبقية</div>
                    </div>
                    
                    <div class="sub-stat">
                        <div class="sub-stat-value">
                            @(clientData.AccountExpirationDate?.ToString("MM/dd") ?? "--")
                        </div>
                        <div class="sub-stat-label">تاريخ الانتهاء</div>
                    </div>
                    
                    <div class="sub-stat">
                        <div class="sub-stat-value">
                            @(clientData.Profile?.PriceWithVAT.ToString("N0") ?? "0")
                        </div>
                        <div class="sub-stat-label">قيمة الاشتراك (ل.س)</div>
                    </div>
                </div>
                
                @if (!isExpired)
                {
                    <div class="usage-section">
                        <div class="usage-header">
                            <span class="usage-label">استهلاك فترة الاشتراك</span>
                            <span class="usage-value">@(usagePercent)%</span>
                        </div>
                        <div class="usage-bar">
                            <div class="usage-fill @(usagePercent > 80 ? "danger" : usagePercent > 60 ? "warning" : "")" 
                                 style="width: @(usagePercent)%;"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
        
        <div class="details-grid">
            <div class="detail-card">
                <div class="detail-card-header">
                    <i class="fas fa-user"></i>
                    <h3>معلومات الحساب</h3>
                </div>
                <div class="detail-card-body">
                    <div class="info-row">
                        <span class="label">اسم المستخدم</span>
                        <span class="value"><code>@clientData.UserName</code></span>
                    </div>
                    <div class="info-row">
                        <span class="label">رقم الهاتف</span>
                        <span class="value">@(clientData.PhoneNumber ?? "غير محدد")</span>
                    </div>
                    <div class="info-row">
                        <span class="label">تاريخ التسجيل</span>
                        <span class="value">@clientData.CreatedDate.ToString("yyyy/MM/dd")</span>
                    </div>
                    <div class="info-row">
                        <span class="label">رقم العميل</span>
                        <span class="value">#@clientData.SID</span>
                    </div>
                </div>
            </div>
            
            <div class="detail-card">
                <div class="detail-card-header">
                    <i class="fas fa-network-wired"></i>
                    <h3>معلومات الاتصال</h3>
                </div>
                <div class="detail-card-body">
                    <div class="info-row">
                        <span class="label">المستقبل</span>
                        <span class="value">@(clientData.Receiver?.Name ?? "غير محدد")</span>
                    </div>
                    <div class="info-row">
                        <span class="label">القطاع</span>
                        <span class="value">@(clientData.Receiver?.Sector?.Name ?? "غير محدد")</span>
                    </div>
                    <div class="info-row">
                        <span class="label">نوع الخدمة</span>
                        <span class="value">@(clientData.Service ?? "PPPoE")</span>
                    </div>
                    <div class="info-row">
                        <span class="label">حالة الاتصال</span>
                        @if (clientData.IsActive)
                        {
                            <span class="status-badge active">
                                <i class="fas fa-wifi"></i> متصل
                            </span>
                        }
                        else
                        {
                            <span class="status-badge inactive">
                                <i class="fas fa-times"></i> غير متصل
                            </span>
                        }
                    </div>
                </div>
            </div>
        </div>
        
        <div class="support-section">
            <div class="support-header">
                <i class="fas fa-headset"></i>
                <h3>الدعم الفني</h3>
            </div>
            <div class="support-body">
                <div class="support-grid">
                    <div class="support-item">
                        <h4>
                            <i class="fas fa-phone"></i> اتصل بنا
                        </h4>
                        <p>للاستفسارات والدعم الفني</p>
                        <a href="tel:+963123456789" class="btn btn-primary">
                            <i class="fas fa-phone"></i>
                            +963 123 456 789
                        </a>
                    </div>
                    
                    <div class="support-item">
                        <h4>
                            <i class="fab fa-whatsapp"></i> واتساب
                        </h4>
                        <p>تواصل معنا عبر واتساب</p>
                        <a href="https://wa.me/963123456789" target="_blank" class="btn btn-success">
                            <i class="fab fa-whatsapp"></i>
                            واتساب
                        </a>
                    </div>
                    
                    <div class="support-item">
                        <h4>
                            <i class="fas fa-clock"></i> ساعات العمل
                        </h4>
                        <p style="margin-bottom: 0; line-height: 1.8;">
                            السبت - الخميس<br />
                            9:00 ص - 6:00 م
                        </p>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
