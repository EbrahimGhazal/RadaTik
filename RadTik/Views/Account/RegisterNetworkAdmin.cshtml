@model RadTik.ViewModels.Account.RegisterViewModel
@{
    ViewData["Title"] = "إنشاء حساب مدير شبكة";
    ViewData["BodyClass"] = "login-page register-page login-page--radtik-spa-identity register-page--radtik-spa-identity";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="login-brand" dir="ltr">
                <div class="login-brand-inner">
                    @{
                        ViewData["RtBrandVariant"] = "auth";
                    }
                    <partial name="_RadTikBrandLogo" />
                </div>
            </div>
            <p class="login-subtitle login-subtitle--muted">إنشاء حساب مدير شبكة · الخطوة الأولى لإدارة شبكتك</p>
        </div>

        <div class="login-body">
            <div class="rt-register-info" role="note">
                <i class="fas fa-info-circle" aria-hidden="true"></i>
                <span><strong>ملاحظة:</strong> سيتم إرسال طلبك للمراجعة من قبل الإدارة. بعد الموافقة على طلبك، سيتم إنشاء حسابك وستتمكن من تسجيل الدخول وإنشاء شبكتك الخاصة.</span>
            </div>

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger rt-alert">
                    <i class="fas fa-exclamation-circle"></i>
                    @TempData["Error"]
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success rt-alert">
                    <i class="fas fa-check-circle"></i>
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info rt-alert">
                    <i class="fas fa-info-circle"></i>
                    @TempData["Info"]
                </div>
            }

            <form asp-action="RegisterNetworkAdmin" asp-controller="Account" asp-route-area="" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="validation-error"></div>

                <div class="form-group">
                    <label asp-for="UserName" class="form-label">اسم المستخدم <span class="text-danger">*</span></label>
                    <div class="input-wrapper">
                        <input asp-for="UserName" class="form-control rt-input" placeholder="أدخل اسم المستخدم" autocomplete="username" />
                        <i class="fas fa-user"></i>
                    </div>
                    <span asp-validation-for="UserName" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email" class="form-label">البريد الإلكتروني <span class="text-danger">*</span></label>
                    <div class="input-wrapper">
                        <input asp-for="Email" class="form-control rt-input" type="email" placeholder="أدخل البريد الإلكتروني" autocomplete="email" />
                        <i class="fas fa-envelope"></i>
                    </div>
                    <span asp-validation-for="Email" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="FullName" class="form-label">الاسم الكامل</label>
                    <div class="input-wrapper">
                        <input asp-for="FullName" class="form-control rt-input" placeholder="أدخل الاسم الكامل" />
                        <i class="fas fa-id-card"></i>
                    </div>
                    <span asp-validation-for="FullName" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="PhoneNumber" class="form-label">رقم الهاتف</label>
                    <div class="input-wrapper">
                        <input asp-for="PhoneNumber" class="form-control rt-input" placeholder="أدخل رقم الهاتف" />
                        <i class="fas fa-phone"></i>
                    </div>
                    <span asp-validation-for="PhoneNumber" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="form-label">كلمة المرور <span class="text-danger">*</span></label>
                    <div class="input-wrapper">
                        <input asp-for="Password" class="form-control rt-input" type="password" placeholder="6 أحرف على الأقل" autocomplete="new-password" />
                        <i class="fas fa-lock"></i>
                    </div>
                    <span asp-validation-for="Password" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword" class="form-label">تأكيد كلمة المرور <span class="text-danger">*</span></label>
                    <div class="input-wrapper">
                        <input asp-for="ConfirmPassword" class="form-control rt-input" type="password" placeholder="أعد إدخال كلمة المرور" autocomplete="new-password" />
                        <i class="fas fa-lock"></i>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="validation-error"></span>
                </div>

                <button type="submit" class="btn btn-primary rt-btn-submit">
                    <i class="fas fa-user-plus"></i>
                    إنشاء الحساب
                </button>

                <a href="@Url.RouteUrl("reglog-login")" class="btn-register-outline">
                    <i class="fas fa-arrow-right"></i>
                    العودة لتسجيل الدخول
                </a>
            </form>

        </div>

        <div class="login-footer">
            <p class="login-footer-copy">© @DateTime.Now.Year RadTik — نظام إدارة مزود خدمة الإنترنت</p>
            <div class="login-footer-links">
                <a class="back-link back-link--emphasis" asp-route="reglog-login">تسجيل الدخول</a>
                <span class="login-footer-sep">·</span>
                <a href="@Url.Action("Index", "Public")" class="back-link">الصفحة الرئيسية</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
