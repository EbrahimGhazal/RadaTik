@model RadTik.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "تسجيل الدخول";
    ViewData["BodyClass"] = "login-page login-page--radtik-spa-identity";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="login-brand" dir="ltr">
                <div class="login-brand-inner">
                    <svg class="rt-logomark" width="44" height="44" viewBox="0 0 48 48" aria-hidden="true">
                        <defs>
                            <filter id="radtik-glow-filter-login" x="-40%" y="-40%" width="180%" height="180%">
                                <feGaussianBlur stdDeviation="1.2" result="b" />
                                <feMerge>
                                    <feMergeNode in="b" />
                                    <feMergeNode in="SourceGraphic" />
                                </feMerge>
                            </filter>
                        </defs>
                        <circle cx="24" cy="24" r="20" fill="none" class="rt-svg-ring" stroke-width="2" opacity="0.9" />
                        <path d="M12 30 L24 18 L36 30 M18 14 L30 26" fill="none" class="rt-svg-accent" stroke-width="1.8" stroke-linecap="round" opacity="0.95" />
                        <path d="M17 14 V34 M17 14 H26 Q31 14 31 19 Q31 24 26 24 H17 M24 24 L31 34" fill="none" class="rt-svg-ring" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                        <circle cx="31" cy="16" r="2.4" class="rt-svg-glow" filter="url(#radtik-glow-filter-login)" />
                    </svg>
                    <span class="rt-wordmark" translate="no">
                        <span class="rt-wm-text">
                            <span class="rt-wm-r">R</span><span class="rt-wm-ad">ad</span><span class="rt-wm-r">T</span><span class="rt-wm-i">i<span class="rt-wm-dot" aria-hidden="true"></span></span><span class="rt-wm-r">k</span>
                        </span>
                    </span>
                </div>
            </div>
            <p class="login-subtitle login-subtitle--muted">نظام إدارة مزود خدمة الإنترنت</p>
        </div>

        <div class="login-body">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger rt-alert">
                    <i class="fas fa-exclamation-circle"></i>
                    @TempData["Error"]
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success rt-alert">
                    <i class="fas fa-check-circle"></i>
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info rt-alert">
                    <i class="fas fa-info-circle"></i>
                    @TempData["Info"]
                </div>
            }

            <form id="loginForm" asp-route="reglog-login" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="validation-error"></div>

                <div class="form-group">
                    <label asp-for="UserName" class="form-label">اسم المستخدم</label>
                    <div class="input-wrapper">
                        <input asp-for="UserName" class="form-control rt-input" placeholder="أدخل اسم المستخدم" autocomplete="username" required />
                        <i class="fas fa-user"></i>
                    </div>
                    <span asp-validation-for="UserName" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="form-label">كلمة المرور</label>
                    <div class="input-wrapper">
                        <input asp-for="Password" class="form-control rt-input" id="passwordInput" type="password" placeholder="أدخل كلمة المرور" autocomplete="current-password" required />
                        <i class="fas fa-lock"></i>
                        <button type="button" class="password-toggle" id="passwordToggle" aria-label="إظهار كلمة المرور" title="إظهار كلمة المرور">
                            <i class="fas fa-eye" id="passwordToggleIcon"></i>
                        </button>
                    </div>
                    <div class="capslock-hint" id="capsLockHint" style="display:none;">
                        <i class="fas fa-triangle-exclamation"></i>
                        تنبيه: زر Caps Lock مفعّل
                    </div>
                    <span asp-validation-for="Password" class="validation-error"></span>
                </div>

                <div class="form-options">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label">تذكرني</label>
                    </div>
                    <a asp-route="reglog-forgotpassword" class="forgot-link">نسيت كلمة المرور؟</a>
                </div>

                <button type="submit" class="btn btn-primary rt-btn-submit" id="loginSubmitBtn">
                    <span class="btn-content">
                        <i class="fas fa-sign-in-alt"></i>
                        تسجيل الدخول
                    </span>
                    <span class="btn-loading" aria-hidden="true">
                        <i class="fas fa-circle-notch fa-spin"></i>
                        جاري الدخول...
                    </span>
                </button>
            </form>

        </div>

        <div class="login-footer">
            <p class="login-footer-copy">© @DateTime.Now.Year RadTik - جميع الحقوق محفوظة</p>
            <div class="login-footer-links">
                <a asp-controller="Public" asp-action="Index" class="back-link">
                    <i class="fas fa-arrow-right"></i>
                    العودة للصفحة الرئيسية
                </a>
                <span class="login-footer-sep">|</span>
                <a asp-action="RegisterNetworkAdmin" asp-controller="Account" asp-area="" class="back-link back-link--emphasis">
                    <i class="fas fa-user-shield"></i>
                    إنشاء حساب مدير شبكة
                </a>
                <span class="login-footer-sep">|</span>
                <a asp-route="networkManager-collectionpoints" asp-route-action="Create" class="back-link back-link--emphasis">
                    <i class="fas fa-paper-plane"></i>
                    طلب إنشاء نقطة تحصيل
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/login.js" asp-append-version="true"></script>
}
