@model IEnumerable<RadTik.Models.JoinRequest>

@{
    ViewData["Title"] = "طلبات الانضمام";
    var selectedType = ViewBag.SelectedType as RadTik.Models.JoinRequestType?;
    var selectedStatus = ViewBag.SelectedStatus as RadTik.Models.JoinRequestStatus?;
    int pendingCount = ViewBag.PendingCount ?? 0;
    int clientCount = ViewBag.ClientRequestsCount ?? 0;
    int employeeCount = ViewBag.EmployeeRequestsCount ?? 0;
    int networkAdminCount = ViewBag.NetworkAdminRequestsCount ?? 0;
    var isSystemAdmin = User.IsInRole("SystemAdministrator");
}

<link rel="stylesheet" href="~/css/pages/network-page.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/pages/join-requests-page.css" asp-append-version="true" />

@{
    var isFilteredByType = selectedType.HasValue;
    var isFilteredByStatus = selectedStatus.HasValue;

    var pageTitle = "طلبات الانضمام";

    var pageSubtitle = selectedType == RadTik.Models.JoinRequestType.NetworkAdministrator
        ? "طلبات إنشاء حساب مدير شركة — مراجعة وقبول/رفض الطلبات"
        : "طلبات الانضمام (عملاء/موظفين/مديري شركة) — مراجعة ومتابعة الطلبات";

    var headerIcon = selectedType == RadTik.Models.JoinRequestType.NetworkAdministrator ? "fa-user-shield" : "fa-user-plus";
}

<div class="network-page join-requests-page">
    <div class="network-page-header">
        <div class="network-page-header-content">
            <div class="network-page-header-icon">
                <i class="fas @headerIcon"></i>
            </div>
            <div>
                <h1 class="network-page-title">@pageTitle</h1>
                <p class="network-page-subtitle">@pageSubtitle</p>
            </div>
        </div>
    </div>

    <!-- شريط الإحصائيات (نفس أسلوب صفحة الشبكات) -->
    <div class="network-stats-grid">
        <a asp-action="Index"
           asp-controller="JoinRequests"
           asp-route-status="@((int)RadTik.Models.JoinRequestStatus.Pending)"
           class="network-stat-card network-stat-pending @((selectedStatus == RadTik.Models.JoinRequestStatus.Pending) ? "network-stat-selected" : "")">
            <div class="network-stat-icon">
                <i class="fas fa-clock"></i>
            </div>
            <div class="network-stat-body">
                <span class="network-stat-value">@pendingCount</span>
                <span class="network-stat-label">قيد الانتظار</span>
            </div>
        </a>

        <a asp-action="Index"
           asp-controller="JoinRequests"
           asp-route-type="@((int)RadTik.Models.JoinRequestType.Client)"
           class="network-stat-card network-stat-client @((selectedType == RadTik.Models.JoinRequestType.Client) ? "network-stat-selected" : "")">
            <div class="network-stat-icon">
                <i class="fas fa-user"></i>
            </div>
            <div class="network-stat-body">
                <span class="network-stat-value">@clientCount</span>
                <span class="network-stat-label">طلبات العملاء</span>
            </div>
        </a>

        <a asp-action="Index"
           asp-controller="JoinRequests"
           asp-route-type="@((int)RadTik.Models.JoinRequestType.Employee)"
           class="network-stat-card network-stat-employee @((selectedType == RadTik.Models.JoinRequestType.Employee) ? "network-stat-selected" : "")">
            <div class="network-stat-icon">
                <i class="fas fa-briefcase"></i>
            </div>
            <div class="network-stat-body">
                <span class="network-stat-value">@employeeCount</span>
                <span class="network-stat-label">طلبات التوظيف</span>
            </div>
        </a>

        @* طلبات مديري الشركة: يعرضها مدير النظام فقط *@
        @if (isSystemAdmin)
        {
            <a asp-action="Index"
               asp-controller="JoinRequests"
               asp-route-type="@((int)RadTik.Models.JoinRequestType.NetworkAdministrator)"
               class="network-stat-card network-stat-networkadmin @((selectedType == RadTik.Models.JoinRequestType.NetworkAdministrator) ? "network-stat-selected" : "")">
                <div class="network-stat-icon">
                    <i class="fas fa-user-shield"></i>
                </div>
                <div class="network-stat-body">
                    <span class="network-stat-value">@networkAdminCount</span>
                    <span class="network-stat-label">طلبات مديري الشركات</span>
                </div>
            </a>
        }
    </div>

    <!-- الفلاتر -->
    <form method="get" class="join-requests-filters">
        <span class="filter-label">
            <i class="fas fa-filter"></i>
            تصفية:
        </span>

        <select class="form-select" name="type" onchange="this.form.submit()">
            <option value="" selected="@(!selectedType.HasValue)">جميع الأنواع</option>
            <option value="1" selected="@(selectedType == RadTik.Models.JoinRequestType.Client)">عملاء</option>
            <option value="2" selected="@(selectedType == RadTik.Models.JoinRequestType.Employee)">موظفين</option>
            @if (isSystemAdmin)
            {
                <option value="3" selected="@(selectedType == RadTik.Models.JoinRequestType.NetworkAdministrator)">مديري شركة</option>
            }
        </select>

        <select class="form-select" name="status" onchange="this.form.submit()">
            <option value="" selected="@(!selectedStatus.HasValue)">جميع الحالات</option>
            <option value="1" selected="@(selectedStatus == RadTik.Models.JoinRequestStatus.Pending)">قيد الانتظار</option>
            <option value="2" selected="@(selectedStatus == RadTik.Models.JoinRequestStatus.UnderReview)">قيد المراجعة</option>
            <option value="3" selected="@(selectedStatus == RadTik.Models.JoinRequestStatus.Approved)">مقبول</option>
            <option value="4" selected="@(selectedStatus == RadTik.Models.JoinRequestStatus.Rejected)">مرفوض</option>
        </select>
    </form>

    @if (Model == null || !Model.Any())
    {
        <div class="network-empty">
            <div class="network-empty-icon">
                <i class="fas fa-inbox"></i>
            </div>
            <h3>لا توجد طلبات</h3>
            <p>لم يتم العثور على طلبات انضمام مطابقة للتصفية الحالية.</p>
            @if (isFilteredByType || isFilteredByStatus)
            {
                <a asp-action="Index" asp-controller="JoinRequests" class="btn btn-outline-primary btn-lg">
                    <i class="fas fa-list me-2"></i>
                    عرض الكل
                </a>
            }
        </div>
    }
    else
    {
        <div class="network-cards">
            @foreach (var request in Model)
            {
                var statusClass =
                    request.Status == RadTik.Models.JoinRequestStatus.Pending ? "pending" :
                    request.Status == RadTik.Models.JoinRequestStatus.UnderReview ? "underreview" :
                    request.Status == RadTik.Models.JoinRequestStatus.Approved ? "approved" : "rejected";

                var typeClass =
                    request.RequestType == RadTik.Models.JoinRequestType.Client ? "client" :
                    request.RequestType == RadTik.Models.JoinRequestType.Employee ? "employee" : "networkadmin";

                var typeIcon =
                    request.RequestType == RadTik.Models.JoinRequestType.Client ? "fa-user" :
                    request.RequestType == RadTik.Models.JoinRequestType.Employee ? "fa-briefcase" : "fa-user-shield";

                var typeLabel =
                    request.RequestType == RadTik.Models.JoinRequestType.Client ? "عميل" :
                    request.RequestType == RadTik.Models.JoinRequestType.Employee ? "موظف" : "مدير شركة";

                var statusIcon =
                    request.Status == RadTik.Models.JoinRequestStatus.Pending ? "fa-clock" :
                    request.Status == RadTik.Models.JoinRequestStatus.UnderReview ? "fa-search" :
                    request.Status == RadTik.Models.JoinRequestStatus.Approved ? "fa-check" : "fa-times";

                var statusLabel =
                    request.Status == RadTik.Models.JoinRequestStatus.Pending ? "قيد الانتظار" :
                    request.Status == RadTik.Models.JoinRequestStatus.UnderReview ? "قيد المراجعة" :
                    request.Status == RadTik.Models.JoinRequestStatus.Approved ? "مقبول" : "مرفوض";

                string? requestedUserName = null;
                if (request.RequestType == RadTik.Models.JoinRequestType.NetworkAdministrator && !string.IsNullOrWhiteSpace(request.Notes))
                {
                    var marker = "اسم المستخدم المطلوب:";
                    var idx = request.Notes.IndexOf(marker, StringComparison.OrdinalIgnoreCase);
                    if (idx >= 0)
                        requestedUserName = request.Notes[(idx + marker.Length)..].Trim();
                }

                <div class="network-company-card joinrequest-card joinrequest-card-@statusClass">
                    <div class="network-company-card-accent"></div>

                    <div class="network-company-card-header">
                        <div class="network-company-logo-wrap">
                            <div class="joinrequest-type-icon joinrequest-type-@typeClass">
                                <i class="fas @typeIcon"></i>
                            </div>
                        </div>

                        <div class="network-company-meta">
                            <h3 class="network-company-name">@request.FullName</h3>
                            <span class="network-company-date">
                                <i class="fas fa-calendar-alt"></i>
                                @request.CreatedDate.ToString("yyyy/MM/dd hh:mm tt")
                            </span>
                            <div class="joinrequest-meta" style="margin-top: 8px;">
                                <span class="joinrequest-type-chip">
                                    <i class="fas @typeIcon"></i>
                                    <strong>@typeLabel</strong>
                                </span>
                                <span class="joinrequest-type-chip">
                                    <i class="fas fa-hashtag"></i>
                                    <strong>#@request.Id</strong>
                                </span>
                            </div>
                        </div>

                        <span class="network-company-badge joinrequest-status-badge-@statusClass">
                            <i class="fas @statusIcon"></i>
                            <span>@statusLabel</span>
                        </span>
                    </div>

                    <div class="network-company-card-body">
                        <div class="network-company-field">
                            <i class="fas fa-envelope"></i>
                            <span>@request.Email</span>
                        </div>
                        <div class="network-company-field">
                            <i class="fas fa-phone"></i>
                            <span>@request.PhoneNumber</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(request.Address))
                        {
                            <div class="network-company-field">
                                <i class="fas fa-map-marker-alt"></i>
                                <span>@request.Address</span>
                            </div>
                        }

                        @if (request.RequestType == RadTik.Models.JoinRequestType.NetworkAdministrator && !string.IsNullOrWhiteSpace(requestedUserName))
                        {
                            <div class="network-company-field">
                                <i class="fas fa-user"></i>
                                <span>اسم المستخدم المطلوب: <strong class="text-primary">@requestedUserName</strong></span>
                            </div>
                        }
                        else if (request.RequestType == RadTik.Models.JoinRequestType.Client && request.RequestedProfile != null)
                        {
                            <div class="network-company-field">
                                <i class="fas fa-boxes"></i>
                                <span>الباقة المطلوبة: <strong class="text-primary">@request.RequestedProfile.Name</strong></span>
                            </div>
                        }
                        else if (request.RequestType == RadTik.Models.JoinRequestType.Employee && !string.IsNullOrWhiteSpace(request.DesiredPosition))
                        {
                            <div class="network-company-field">
                                <i class="fas fa-briefcase"></i>
                                <span>الوظيفة المطلوبة: <strong class="text-primary">@request.DesiredPosition</strong></span>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(request.AdminNotes))
                        {
                            <p class="network-company-notes">@(request.AdminNotes.Length > 90 ? request.AdminNotes.Substring(0, 90) + "…" : request.AdminNotes)</p>
                        }
                    </div>

                    <div class="network-company-card-footer">
                        <a asp-action="Details" asp-controller="JoinRequests" asp-route-id="@request.Id"
                           class="btn btn-company-action btn-company-details">
                            <i class="fas fa-eye"></i>
                            <span>التفاصيل</span>
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>
