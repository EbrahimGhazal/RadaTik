@model RadTik.ViewModels.Public.ContactViewModel

@{
    ViewData["Title"] = "اتصل بنا";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<style>
    .page-hero {
        background: var(--gradient-hero);
        padding: 150px 0 100px;
        text-align: center;
        color: white;
    }

    .page-hero-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 30px;
    }

    .page-hero-title {
        font-size: 48px;
        font-weight: 800;
        margin-bottom: 20px;
    }

    .page-hero-desc {
        font-size: 20px;
        color: rgba(255,255,255,0.8);
    }

    .contact-section {
        padding: 100px 0;
    }

    .contact-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 30px;
    }

    .contact-grid {
        display: grid;
        grid-template-columns: 1fr 1.5fr;
        gap: 60px;
    }

    .contact-info {
        background: var(--dark);
        border-radius: 20px;
        padding: 50px;
        color: white;
    }

    .contact-info h3 {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 20px;
    }

    .contact-info > p {
        color: rgba(255,255,255,0.7);
        margin-bottom: 40px;
        line-height: 1.8;
    }

    .contact-item {
        display: flex;
        gap: 20px;
        margin-bottom: 30px;
    }

    .contact-item-icon {
        width: 60px;
        height: 60px;
        background: rgba(255,255,255,0.1);
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        color: var(--primary-light);
        flex-shrink: 0;
    }

    .contact-item-content h4 {
        font-size: 18px;
        font-weight: 600;
        margin-bottom: 5px;
    }

    .contact-item-content p {
        color: rgba(255,255,255,0.7);
        font-size: 15px;
    }

    .contact-social {
        display: flex;
        gap: 15px;
        margin-top: 40px;
        padding-top: 40px;
        border-top: 1px solid rgba(255,255,255,0.1);
    }

    .contact-social a {
        width: 50px;
        height: 50px;
        background: rgba(255,255,255,0.1);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 20px;
        text-decoration: none;
        transition: all 0.3s;
    }

    .contact-social a:hover {
        background: var(--primary);
        transform: translateY(-3px);
    }

    .contact-form-card {
        background: white;
        border-radius: 20px;
        padding: 50px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
    }

    .contact-form-card h3 {
        font-size: 28px;
        font-weight: 700;
        color: var(--dark);
        margin-bottom: 30px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        font-weight: 600;
        color: var(--dark);
        margin-bottom: 10px;
        font-size: 15px;
    }

    .form-control {
        width: 100%;
        padding: 16px 20px;
        border: 2px solid #eee;
        border-radius: 12px;
        font-size: 16px;
        font-family: 'Tajawal', sans-serif;
        transition: all 0.3s;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(0, 102, 204, 0.1);
    }

    textarea.form-control {
        min-height: 150px;
        resize: vertical;
    }

    .form-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 18px 40px;
        background: var(--gradient-primary);
        color: white;
        border: none;
        border-radius: 12px;
        font-size: 17px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        font-family: 'Tajawal', sans-serif;
    }

    .form-btn:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(0, 102, 204, 0.3);
    }

    .text-danger {
        color: #dc3545;
        font-size: 13px;
        margin-top: 5px;
    }

    .validation-summary {
        background: #fff3cd;
        border: 1px solid #ffc107;
        border-radius: 10px;
        padding: 15px 20px;
        margin-bottom: 25px;
        color: #856404;
    }

    @@media (max-width: 992px) {
        .contact-grid {
            grid-template-columns: 1fr;
        }

        .form-row {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 576px) {
        .page-hero-title {
            font-size: 36px;
        }

        .contact-info,
        .contact-form-card {
            padding: 30px;
        }
    }
</style>

<section class="page-hero">
    <div class="page-hero-container">
        <h1 class="page-hero-title">اتصل بنا</h1>
        <p class="page-hero-desc">راسلنا في أي وقت</p>
    </div>
</section>

<section class="contact-section">
    <div class="contact-container">
        <div class="contact-grid">
            <div class="contact-info">
                <h3>معلومات التواصل</h3>
                <p>نسعد بتواصلكم معنا عبر أي من القنوات التالية. متاح 24/7 — فريقنا جاهز للرد على استفساراتكم على مدار الساعة.</p>

                <div class="contact-item">
                    <div class="contact-item-icon">
                        <i class="fas fa-map-marker-alt"></i>
                    </div>
                    <div class="contact-item-content">
                        <h4>العنوان</h4>
                        <p>اللاذقية - سوريا<br>فرع 1 - خلف بناء الهجرة والجوازات<br>فرع 2 - المشروع الخامس - دخلة معهد تقنيات الحاسوب</p>
                    </div>
                </div>

                <div class="contact-item">
                    <div class="contact-item-icon">
                        <i class="fas fa-phone-alt"></i>
                    </div>
                    <div class="contact-item-content">
                        <h4>الهاتف</h4>
                        <p><a href="tel:+963966284236" style="color: inherit;">+963 966284236</a><br><a href="tel:+905050888882" style="color: inherit;">+90 5050888882</a></p>
                    </div>
                </div>

                <div class="contact-item">
                    <div class="contact-item-icon">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <div class="contact-item-content">
                        <h4>البريد الإلكتروني</h4>
                        <p><a href="mailto:EbrahimGhazal@Gmail.com" style="color: inherit;">EbrahimGhazal@Gmail.com</a><br><a href="mailto:info@skybeam.sy" style="color: inherit;">info@skybeam.sy</a></p>
                    </div>
                </div>

                <div class="contact-item">
                    <div class="contact-item-icon">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="contact-item-content">
                        <h4>ساعات العمل</h4>
                        <p>على مدار الساعة<br>7 أيام في الأسبوع</p>
                    </div>
                </div>

                <div class="contact-social">
                    <a href="https://www.facebook.com/share/1Dhy17asAP/?mibextid=wwXIfr" target="_blank" rel="noopener noreferrer" title="Facebook — SkyBeam"><i class="fab fa-facebook-f"></i></a>
                    <a href="#" title="X — أضف الرابط لاحقاً"><i class="fab fa-x-twitter"></i></a>
                    <a href="https://www.instagram.com/skybeam3?igsh=aGVyZnJlZDkxM2Vs&amp;utm_source=qr" target="_blank" rel="noopener noreferrer" title="Instagram — SkyBeam"><i class="fab fa-instagram"></i></a>
                    <a href="https://wa.me/963966284236" target="_blank" rel="noopener noreferrer" title="واتساب"><i class="fab fa-whatsapp"></i></a>
                </div>
            </div>

            <div class="contact-form-card">
                <h3>أرسل لنا رسالة</h3>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="validation-summary">
                        <i class="fas fa-exclamation-triangle"></i>
                        يرجى تصحيح الأخطاء أدناه
                    </div>
                }

                <form asp-action="Contact" method="post">
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Name" class="form-label">الاسم الكامل</label>
                            <input asp-for="Name" class="form-control" placeholder="أدخل اسمك" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Email" class="form-label">البريد الإلكتروني</label>
                            <input asp-for="Email" class="form-control" placeholder="example@email.com" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Phone" class="form-label">رقم الهاتف</label>
                            <input asp-for="Phone" class="form-control" placeholder="+963 XX XXX XXXX" />
                            <span asp-validation-for="Phone" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Subject" class="form-label">الموضوع</label>
                            <input asp-for="Subject" class="form-control" placeholder="موضوع الرسالة" />
                            <span asp-validation-for="Subject" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group">
                        <label asp-for="Message" class="form-label">الرسالة</label>
                        <textarea asp-for="Message" class="form-control" placeholder="اكتب رسالتك هنا..."></textarea>
                        <span asp-validation-for="Message" class="text-danger"></span>
                    </div>

                    <button type="submit" class="form-btn">
                        <i class="fas fa-paper-plane"></i>
                        إرسال الرسالة
                    </button>
                </form>
            </div>
        </div>
    </div>
</section>
