<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- تأكيد نسخ ملفات Razor عند النشر (لوحة networkManager وغيرها) -->
    <CopyRazorGenerateFilesToPublishDirectory>true</CopyRazorGenerateFilesToPublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Razor.RuntimeCompilation" Version="9.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="9.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="9.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="9.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
	  <PackageReference Include="tik4net" Version="3.5.0" />
    <PackageReference Include="ClosedXML" Version="0.105.0" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Migrations\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude local verification/build artifact folders from default SDK globs -->
    <Compile Remove="_verify*/**;_build_out/**" />
    <Content Remove="_verify*/**;_build_out/**" />
    <None Remove="_verify*/**;_build_out/**" />
    <EmbeddedResource Remove="_verify*/**;_build_out/**" />
  </ItemGroup>

  <Target Name="KillRunningRadTikBeforeBuild"
          BeforeTargets="Build"
          Condition="'$(Configuration)' == 'Debug' and '$(OS)' == 'Windows_NT' and '$(BuildingInsideVisualStudio)' == 'true'">
    <Exec Command="taskkill /F /IM RadTik.exe /T &gt;NUL 2&gt;NUL || exit /b 0"
          ContinueOnError="true" />
  </Target>

  <!-- بناء واجهة React ووضعها في wwwroot/app (مسار الويب /app) -->
  <PropertyGroup>
    <RadTikWebDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\radtik-web'))</RadTikWebDir>
  </PropertyGroup>
  <Target Name="BuildRadTikWeb"
          BeforeTargets="BeforeBuild"
          Condition="Exists('$(RadTikWebDir)\package.json')">
    <Exec WorkingDirectory="$(RadTikWebDir)"
          Command="npm run build" />
  </Target>

</Project>
