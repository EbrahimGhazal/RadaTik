@model RadTik.ViewModels.CollectionPoint.ClientDetailsForCollectionPointViewModel
@{
    ViewData["Title"] = "تفاصيل العميل - نقطة التحصيل";
    var hasBlockingInvoices = (ViewBag.HasBlockingInvoices as bool?) ?? false;
    var blockingInvoicesCount = (ViewBag.BlockingInvoicesCount as int?) ?? 0;
    var blockingInvoicesTotal = (ViewBag.BlockingInvoicesTotal as decimal?) ?? 0m;
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1><i class="fas fa-user"></i> تفاصيل العميل</h1>
        <p class="text-muted mb-0">@Model.ClientName (@Model.ClientUserName)</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-right"></i> رجوع للقائمة
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (hasBlockingInvoices)
{
    <div class="alert alert-warning">
        لا يمكن تنفيذ التجديد قبل تسديد فواتير الصيانة المستحقة على المشترك
        (عدد الفواتير: @blockingInvoicesCount - إجمالي المستحقات: @blockingInvoicesTotal.ToString("N0") ل.س).
    </div>
}

<div class="row">
    <div class="col-lg-6 mb-3">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title mb-0"><i class="fas fa-id-card"></i> بيانات المشترك</h5>
            </div>
            <div class="card-body">
                <p class="mb-1"><strong>اسم المستخدم:</strong> @(Model.ClientUserName ?? "—")</p>
                <p class="mb-1"><strong>الاسم الثلاثي:</strong> @(Model.ClientName ?? "—")</p>
                <p class="mb-1"><strong>رقم الجوال:</strong> @(Model.PhoneNumber ?? "—")</p>
                <p class="mb-1"><strong>مكان السكن:</strong> @(Model.ResidenceAddress ?? "—")</p>
                <p class="mb-1"><strong>اسم الشركة:</strong> @(Model.CompanyName ?? "—")</p>
                <p class="mb-0"><strong>الشبكة التابعة لها:</strong> @(Model.NetworkName ?? "—")</p>
            </div>
        </div>
    </div>
    <div class="col-lg-6 mb-3">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title mb-0"><i class="fas fa-wallet"></i> الرصيد والمبلغ الواجب</h5>
            </div>
            <div class="card-body">
                <p class="mb-1"><strong>رصيد العميل:</strong> <span class="text-info fw-bold">@Model.ClientBalance.ToString("0.##") ل.س</span></p>
                <p class="mb-1"><strong>رصيد نقطة التحصيل:</strong> <span class="text-success">@Model.CollectionPointBalance.ToString("0.##") ل.س</span></p>
                <p class="mb-1"><strong>السعر الأساسي:</strong> <span>@Model.CurrentBasePrice.ToString("0.##") ل.س</span></p>
                <p class="mb-1"><strong>الضريبة:</strong> <span>@Model.CurrentCommissionAmount.ToString("0.##") ل.س</span></p>
                <p class="mb-1"><strong>المبلغ النهائي للتجديد:</strong> <span class="text-primary fs-5">@Model.AmountDue.ToString("0.##") ل.س</span></p>
                <p class="mb-1 small text-muted">المعادلة: @Model.CurrentBasePrice.ToString("0.##") + @Model.CurrentCommissionAmount.ToString("0.##") = @Model.AmountDue.ToString("0.##") ل.س</p>
                @if (Model.AccountExpirationDate.HasValue)
                {
                    <p class="mb-0 text-muted small">انتهاء الاشتراك: @Model.AccountExpirationDate.Value.ToString("yyyy/MM/dd")</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="fas fa-list"></i> أسعار الباقات المحددة من مدير الشبكة</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm table-bordered">
                <thead>
                    <tr>
                        <th>الباقة</th>
                        <th>السرعة</th>
                        <th>حجم البيانات</th>
                        <th>السعر</th>
                        <th>الضريبة</th>
                        <th>الإجمالي</th>
                        <th>الحالية للمشترك</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.ProfilePrices)
                    {
                        <tr class="@(p.ProfileId == Model.CurrentProfileId ? "table-primary" : "")">
                            <td>@p.Name</td>
                            <td>@p.SpeedDisplay</td>
                            <td>@p.DataLimitDisplay</td>
                            <td>@p.Price.ToString("0.##")</td>
                            <td>@p.CommissionAmount.ToString("0.##")</td>
                            <td>@p.PriceWithVAT.ToString("0.##")</td>
                            <td>@(p.ProfileId == Model.CurrentProfileId ? "✓ الباقة الحالية" : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="mb-0 small text-muted">
            <strong>الباقة المحددة حالياً للمشترك:</strong> @(Model.CurrentProfileName ?? "—") — السعر: @Model.CurrentProfilePrice.ToString("0.##")
        </p>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header bg-info text-white">
        <h5 class="card-title mb-0"><i class="fas fa-coins"></i> تبويب تغذية الرصيد (من نقطة التحصيل)</h5>
    </div>
    <div class="card-body">
        <p class="text-muted mb-3">تغذية رصيد العميل من رصيد نقطة التحصيل. سيتم خصم المبلغ من رصيدك وإضافته لرصيد العميل.</p>
        <form asp-action="TopUpClientBalance" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="clientId" value="@Model.ClientId" />
            <div class="col-md-2">
                <label class="form-label">المبلغ (ل.س)</label>
                <input type="number" name="amount" class="form-control" min="0.01" step="0.01" required placeholder="0" />
            </div>
            <div class="col-md-3">
                <label class="form-label">ملاحظات (اختياري)</label>
                <input type="text" name="notes" class="form-control" placeholder="ملاحظات" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-info w-100" onclick="return confirm('تأكيد تغذية الرصيد؟ سيتم خصم المبلغ من رصيد نقطة التحصيل.');">
                    <i class="fas fa-plus-circle"></i> تغذية الرصيد
                </button>
            </div>
        </form>
        @{
            var recentTopUps = ViewBag.RecentTopUps as IEnumerable<RadTik.Models.ClientTopUpTransaction> ?? Enumerable.Empty<RadTik.Models.ClientTopUpTransaction>();
        }
        @if (recentTopUps.Any())
        {
            <h6 class="mt-3 mb-2">آخر عمليات التغذية</h6>
            <div class="table-responsive">
                <table class="table table-sm">
                    <thead><tr><th>التاريخ</th><th>المبلغ</th><th>المصدر</th><th>بواسطة</th></tr></thead>
                    <tbody>
                        @foreach (var t in recentTopUps)
                        {
                            <tr>
                                <td>@t.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>+@t.Amount.ToString("N0") ل.س</td>
                                <td>@(t.SourceType == RadTik.Models.ClientTopUpSource.CollectionPoint ? "نقطة التحصيل" : t.SourceType == RadTik.Models.ClientTopUpSource.SystemAdmin ? "مدير النظام" : "مدير الشبكة")</td>
                                <td>@(t.CreatedByUser?.UserName ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card border-success">
    <div class="card-header bg-success text-white">
        <h5 class="card-title mb-0"><i class="fas fa-hand-holding-usd"></i> تسديد المبلغ</h5>
    </div>
    <div class="card-body">
        <p class="text-muted">
            عند النقر على "تسديد المبلغ" سيتم حسم المبلغ من رصيد نقطة التحصيل وتنفيذ التجديد مباشرة بعد التحقق من عدم وجود فواتير صيانة مستحقة.
        </p>
        <form asp-action="PayAndRequestRenewal" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="clientId" value="@Model.ClientId" />
            <div class="col-md-3">
                <label class="form-label">المبلغ</label>
                <input type="number" name="amount" step="0.01" min="0.01" value="@Model.AmountDue.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" class="form-control" required />
                <small class="text-muted d-block mt-1">الإجمالي = الأساسي @Model.CurrentBasePrice.ToString("0.##") + الضريبة @Model.CurrentCommissionAmount.ToString("0.##")</small>
            </div>
            <div class="col-md-4">
                <label class="form-label">ملاحظات (اختياري)</label>
                <input type="text" name="notes" class="form-control" placeholder="ملاحظات" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-success w-100" @(hasBlockingInvoices ? "disabled" : null)>
                    <i class="fas fa-check-circle"></i> تسديد المبلغ
                </button>
            </div>
        </form>
    </div>
</div>
