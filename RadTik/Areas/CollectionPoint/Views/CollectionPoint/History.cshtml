@model List<RadTik.Models.PaymentTransaction>

@{
    ViewData["Title"] = "سجل التحصيل";
}

<div class="page-header">
    <h1>
        <i class="fas fa-list"></i>
        @ViewData["Title"]
    </h1>
    <p class="text-muted">آخر 200 عملية تحصيل</p>
</div>

<div class="mb-3 d-print-none">
    <button type="button" class="btn btn-outline-primary" onclick="window.print();">
        <i class="fas fa-print"></i> طباعة
    </button>
</div>

<div class="card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>التاريخ</th>
                        <th>نوع العملية</th>
                        <th>المنفذ</th>
                        <th>العميل</th>
                        <th>المبلغ</th>
                        <th>رصيد العميل قبل</th>
                        <th>رصيد العميل بعد</th>
                        <th>رصيد النقطة قبل</th>
                        <th>رصيد النقطة بعد</th>
                        <th>رقم المرجع</th>
                        <th>ملاحظات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var t in Model)
                        {
                            <tr>
                                <td>@t.Id</td>
                                <td>@t.PaymentDate.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>
                                    @if (t.OperationType == "Renewal")
                                    {
                                        <span class="badge bg-success">تجديد</span>
                                    }
                                    else if (t.OperationType == "ClientTopUp")
                                    {
                                        <span class="badge bg-info">تغذية رصيد</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">تحصيل</span>
                                    }
                                </td>
                                <td>@(t.ReceivedByUser?.UserName ?? t.ReceivedByUserId)</td>
                                <td>@(t.Client?.Name ?? t.ClientId.ToString())</td>
                                <td>@t.Amount.ToString("0.##")</td>
                                <td>@t.PreviousClientBalance.ToString("0.##")</td>
                                <td>@t.NewClientBalance.ToString("0.##")</td>
                                <td>@t.PreviousPointBalance.ToString("0.##")</td>
                                <td>@t.NewPointBalance.ToString("0.##")</td>
                                <td class="small text-muted">@(string.IsNullOrWhiteSpace(t.ReferenceNumber) ? "—" : t.ReferenceNumber)</td>
                                <td class="text-muted">@t.Notes</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted">لا توجد بيانات</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mt-3">
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i>
                رجوع
            </a>
        </div>
    </div>
</div>

