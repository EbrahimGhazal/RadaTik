@using RadTik.Models
@{
    ViewData["Title"] = "طلب تغذية رصيد المحفظة";
    var accountBalance = ViewBag.AccountBalance as decimal? ?? 0m;
    var networkName = ViewBag.NetworkName as string ?? "";
    var pendingCount = ViewBag.PendingCount as int? ?? 0;
    var networksForRequest = ViewBag.NetworksForRequest as List<Network> ?? new List<Network>();
    var paymentMethods = ViewBag.PaymentMethods as IEnumerable<PaymentMethod> ?? Enumerable.Empty<PaymentMethod>();
    var pmList = paymentMethods.ToList();
    var shamCashQrPath = ViewBag.CollectionPointShamCashQrCodePath as string;
}

<div class="wallet-topup-page">
    <div class="page-header wallet-topup-header">
        <div>
            <h1>
                <i class="fas fa-wallet"></i>
                طلب تغذية رصيد المحفظة
            </h1>
            <p class="text-muted mb-0">قدم طلب تغذية رصيد وحدد جهة الطلب: مدير النظام أو مدير الشركة.</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i>
            @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle"></i>
            @TempData["Error"]
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i>
            @TempData["Info"]
        </div>
    }

    <div class="row g-4 align-items-start">
        <div class="col-xl-8">
            <div class="card wallet-form-card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-plus-circle text-success"></i>
                        طلب تغذية رصيد جديد
                    </h5>
                    <p class="text-muted mb-0 mt-2">املأ البيانات بدقة ليتم مراجعة الطلب بشكل أسرع.</p>
                </div>
                <div class="card-body">
                    <form asp-area="CollectionPoint" asp-controller="Wallet" asp-action="TopUp" method="post" id="topUpForm" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label">جهة الطلب</label>
                                <div class="request-target-box">
                                    <div class="form-check form-check-inline mb-0">
                                        <input class="form-check-input" type="radio" name="requestTargetType" id="targetSystemAdmin" value="@((int)CollectionPointTopUpTarget.SystemAdmin)">
                                        <label class="form-check-label" for="targetSystemAdmin">مدير النظام</label>
                                    </div>
                                    <div class="form-check form-check-inline mb-0">
                                        <input class="form-check-input" type="radio" name="requestTargetType" id="targetCompanyManager" value="@((int)CollectionPointTopUpTarget.CompanyManager)" checked>
                                        <label class="form-check-label" for="targetCompanyManager">مدير الشركة</label>
                                    </div>
                                </div>
                            </div>

                            <div class="col-md-6" id="targetNetworkGroup">
                                <label for="targetNetworkId" class="form-label">صاحب الشركة / الشبكة</label>
                                <select id="targetNetworkId" name="targetNetworkId" class="form-select" data-placeholder="اختر الشبكة...">
                                    <option value=""></option>
                                    @foreach (var net in networksForRequest)
                                    {
                                        <option value="@net.Id">@net.Name - @(net.ManagerUser?.UserName ?? net.ManagerUser?.FullName ?? "بدون مدير")</option>
                                    }
                                </select>
                                <small class="text-muted">سيتم إرسال الطلب إلى مدير هذه الشبكة</small>
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">طريقة الدفع</label>
                                @if (pmList.Any())
                                {
                                    <select class="form-select" id="paymentMethodId" name="paymentMethodId" required data-placeholder="اختر طريقة الدفع...">
                                        <option value=""></option>
                                        @foreach (var m in pmList)
                                        {
                                            <option value="@m.Id">@m.Name</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input type="text" class="form-control" name="method" required placeholder="مثال: كاش، تحويل..." />
                                    <div class="text-muted small mt-1">لا توجد طرق دفع معرفة حالياً. يمكن لمدير النظام إضافتها.</div>
                                }
                            </div>

                            <div class="col-md-6">
                                <label for="referenceNumber" class="form-label">رقم إشعار/مرجع الدفع</label>
                                <input type="text" id="referenceNumber" name="referenceNumber" class="form-control" required placeholder="رقم إيصال/مرجع الدفع" />
                            </div>

                            <div class="col-md-6">
                                <label for="amount" class="form-label">المبلغ المطلوب (ل.س)</label>
                                <input type="number" id="amount" name="amount" class="form-control" min="0.01" step="0.01" required placeholder="أدخل المبلغ المطلوب" />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">صورة الإيصال</label>
                                <input type="file" name="receiptImage" class="form-control" required accept="image/*" data-max-bytes="3145728" data-size-message="حجم صورة الإيصال يجب ألا يتجاوز 3 ميغابايت." />
                                <small class="text-muted">يرجى رفع صورة واضحة للإيصال (الحد الأقصى: 3 ميغابايت).</small>
                            </div>

                            <div class="col-md-6">
                                <label for="notes" class="form-label">ملاحظات (اختياري)</label>
                                <textarea id="notes" name="notes" class="form-control" rows="3" placeholder="أي ملاحظات إضافية..."></textarea>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 mt-4">
                            <i class="fas fa-paper-plane"></i>
                            إرسال الطلب
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card wallet-stat-card mb-4">
                <div class="card-body">
                    <div class="wallet-stat-label">الرصيد الحالي</div>
                    <div class="wallet-stat-value">
                        @accountBalance.ToString("N0")
                        <span class="wallet-currency">ل.س</span>
                    </div>
                    @if (!string.IsNullOrEmpty(networkName))
                    {
                        <div class="wallet-stat-meta">الشبكة: @networkName</div>
                    }
                </div>
            </div>

            @if (pendingCount > 0)
            {
                <div class="alert alert-info mb-4">
                    <i class="fas fa-clock"></i>
                    لديك <strong>@pendingCount</strong> طلب/طلبات قيد الانتظار. سيتم إشعارك عند الموافقة أو الرفض.
                </div>
            }

            <div class="card wallet-help-card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-circle-question text-info"></i>
                        خطوات سريعة
                    </h5>
                </div>
                <div class="card-body">
                    <ul class="wallet-help-list">
                        <li><span>1</span> حدد الجهة المستهدفة بدقة قبل تعبئة البيانات.</li>
                        <li><span>2</span> أدخل طريقة الدفع ورقم المرجع كما هو في الإيصال.</li>
                        <li><span>3</span> ارفع صورة واضحة للإيصال ثم أرسل الطلب.</li>
                    </ul>
                </div>
            </div>
            <div class="card wallet-help-card mt-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-qrcode text-primary"></i>
                        QR شام كاش الخاص بك
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-area="CollectionPoint" asp-controller="Wallet" asp-action="UpdateShamCashQr" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="file" name="shamCashQrCodeFile" class="form-control" accept="image/*" data-max-bytes="3145728" data-size-message="حجم صورة QR يجب ألا يتجاوز 3 ميغابايت." />
                        <div class="form-text mt-1">الحد الأقصى لحجم صورة QR: 3 ميغابايت.</div>
                        @if (!string.IsNullOrWhiteSpace(shamCashQrPath))
                        {
                            <div class="mt-2">
                                <img src="@shamCashQrPath" alt="QR شام كاش" class="img-thumbnail" style="max-width:220px;" />
                            </div>
                            <div class="form-check mt-2">
                                <input class="form-check-input" type="checkbox" name="removeShamCashQrCode" id="removeShamCashQrCode" value="true" />
                                <label class="form-check-label" for="removeShamCashQrCode">حذف QR الحالي</label>
                            </div>
                        }
                        else
                        {
                            <div class="form-text mt-2">لم يتم إضافة QR شام كاش بعد.</div>
                        }
                        <button type="submit" class="btn btn-outline-primary w-100 mt-3">
                            حفظ QR شام كاش
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
<style>
    .wallet-topup-page {
        max-width: 1280px;
        margin: 0 auto;
    }

    .wallet-topup-header {
        margin-bottom: 1.25rem;
    }

    .wallet-form-card,
    .wallet-stat-card,
    .wallet-help-card {
        border-radius: 1rem;
    }

    .request-target-box {
        border: 1px solid var(--border-color);
        border-radius: .8rem;
        padding: .75rem .9rem;
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        background: var(--bg-card);
    }

    .wallet-stat-label {
        color: var(--text-muted);
        font-size: .9rem;
        margin-bottom: .35rem;
    }

    .wallet-stat-value {
        font-size: 1.85rem;
        font-weight: 700;
        color: var(--text-primary);
        line-height: 1.2;
    }

    .wallet-currency {
        font-size: 1rem;
        font-weight: 500;
        color: var(--text-muted);
        margin-inline-start: .35rem;
    }

    .wallet-stat-meta {
        margin-top: .55rem;
        color: var(--text-muted);
        font-size: .88rem;
    }

    .wallet-help-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        gap: .75rem;
    }

    .wallet-help-list li {
        display: flex;
        align-items: flex-start;
        gap: .6rem;
        color: var(--text-secondary);
    }

    .wallet-help-list li span {
        width: 1.45rem;
        height: 1.45rem;
        border-radius: 999px;
        background: rgba(0, 102, 204, .12);
        color: var(--primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: .8rem;
        font-weight: 700;
        flex-shrink: 0;
        margin-top: .1rem;
    }

    .wallet-topup-page .form-control,
    .wallet-topup-page .form-select {
        min-height: 2.65rem;
        border-radius: .75rem;
    }

    [data-theme="dark"] .wallet-topup-page .request-target-box {
        background: var(--bg-card);
        border-color: var(--border-color);
    }

    [data-theme="dark"] .wallet-topup-page .form-control::file-selector-button {
        background: var(--bg-hover);
        color: var(--text-primary);
        border: 1px solid var(--border-color);
    }
</style>
}

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        function bindImageSizeValidation(selector) {
            var input = document.querySelector(selector);
            if (!input) return;

            var maxBytes = Number(input.getAttribute('data-max-bytes') || (3 * 1024 * 1024));
            var sizeMessage = input.getAttribute('data-size-message') || 'حجم الصورة يجب ألا يتجاوز 3 ميغابايت.';
            input.addEventListener('change', function () {
                var file = input.files && input.files.length ? input.files[0] : null;
                if (!file) {
                    input.setCustomValidity('');
                    return;
                }

                if (file.size > maxBytes) {
                    input.value = '';
                    input.setCustomValidity(sizeMessage);
                    input.reportValidity();
                } else {
                    input.setCustomValidity('');
                }
            });
        }

        bindImageSizeValidation('input[name="receiptImage"]');
        bindImageSizeValidation('input[name="shamCashQrCodeFile"]');

        var targetSystemAdmin = document.getElementById('targetSystemAdmin');
        var targetCompanyManager = document.getElementById('targetCompanyManager');
        var targetNetworkGroup = document.getElementById('targetNetworkGroup');
        var targetNetworkId = document.getElementById('targetNetworkId');
        var form = document.getElementById('topUpForm');

        function toggleTargetNetwork() {
            targetNetworkGroup.style.display = targetCompanyManager.checked ? 'block' : 'none';
            if (!targetCompanyManager.checked) targetNetworkId.value = '';
        }
        targetSystemAdmin.addEventListener('change', toggleTargetNetwork);
        targetCompanyManager.addEventListener('change', toggleTargetNetwork);
        toggleTargetNetwork();

        form.addEventListener('submit', function(e) {
            if (targetCompanyManager.checked && (!targetNetworkId.value || targetNetworkId.value === '')) {
                e.preventDefault();
                alert('يرجى تحديد صاحب الشركة أو الشبكة عند اختيار مدير الشركة.');
                targetNetworkGroup.scrollIntoView();
                return false;
            }
        });

        if (window.jQuery && jQuery.fn.select2) {
            function initTopUpSelect2(selector, placeholderText) {
                var $select = jQuery(selector);
                if (!$select.length) return;

                if ($select.hasClass('select2-hidden-accessible')) {
                    $select.select2('destroy');
                }

                $select.select2({
                    theme: 'bootstrap-5',
                    dir: 'rtl',
                    width: '100%',
                    allowClear: true,
                    placeholder: placeholderText
                });
            }

            initTopUpSelect2('#targetNetworkId', 'اختر الشبكة...');
            initTopUpSelect2('#paymentMethodId', 'اختر طريقة الدفع...');
        }
    });
</script>
}
