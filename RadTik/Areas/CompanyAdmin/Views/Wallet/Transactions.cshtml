@model RadTik.ViewModels.CompanyAdmin.CompanyWalletTransactionsViewModel
@using RadTik.Models
@using RadTik.Helpers
@{
    ViewData["Title"] = ViewData["Title"] ?? "عمليات التعبئة";

    var txCount = Model.Transactions?.Count ?? 0;
    var totalIn = Model.Transactions?.Where(t => t.SignedAmount > 0).Sum(t => t.SignedAmount) ?? 0m;
    var totalOut = Model.Transactions?.Where(t => t.SignedAmount < 0).Sum(t => Math.Abs(t.SignedAmount)) ?? 0m;

}

<div class="financial-page financial-transactions-page">
    <div class="page-header d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
        <div>
            <h1>
                <i class="fas fa-list"></i>
                @ViewData["Title"]
            </h1>
            <p class="text-muted mb-0">سجل كامل لحركات الرصيد على الشبكة المحددة.</p>
        </div>
        <a class="btn btn-primary micro-btn" asp-route="networkManager-wallet-topup">
            <i class="fas fa-plus-circle"></i>
            تغذية رصيد جديدة
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3 mb-3">
        <div class="col-md-6 col-xl-3">
            <div class="card financial-stat-card h-100">
                <div class="card-body">
                    <div class="financial-stat-label">الشركة المحتسبة</div>
                    <div class="financial-stat-value">@Model.EffectiveCompanyNetworkName</div>
                    <div class="financial-stat-meta">#@Model.EffectiveCompanyNetworkId</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card financial-stat-card financial-stat-accent h-100">
                <div class="card-body">
                    <div class="financial-stat-label">الرصيد الحالي</div>
                    <div class="financial-stat-value">@Model.CompanyBalance.ToString("N2")</div>
                    <div class="financial-stat-meta">ل.س.ج</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card financial-stat-card h-100">
                <div class="card-body">
                    <div class="financial-stat-label">إجمالي الإضافات</div>
                    <div class="financial-stat-value text-success">@totalIn.ToString("N2")</div>
                    <div class="financial-stat-meta">ل.س.ج</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-3">
            <div class="card financial-stat-card h-100">
                <div class="card-body">
                    <div class="financial-stat-label">إجمالي الحسومات</div>
                    <div class="financial-stat-value text-danger">@totalOut.ToString("N2")</div>
                    <div class="financial-stat-meta">@txCount حركة</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card financial-table-card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h3 class="card-title mb-0">
                <i class="fas fa-clock text-secondary"></i>
                سجل الحركات
            </h3>
            <span class="text-muted small">إجمالي السجلات: @txCount</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0 financial-table">
                    <thead>
                        <tr>
                            <th style="width: 160px;">التاريخ</th>
                            <th style="width: 140px;">النوع</th>
                            <th class="text-center" style="width: 140px;">المبلغ</th>
                            <th class="text-center" style="width: 140px;">قبل</th>
                            <th class="text-center" style="width: 140px;">بعد</th>
                            <th style="width: 230px;">تفاصيل النوع</th>
                            <th>ملاحظات</th>
                            <th style="width: 180px;">بواسطة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Transactions != null && Model.Transactions.Any())
                        {
                            foreach (var t in Model.Transactions)
                            {
                                var typeClass = NetworkWalletTransactionDisplayHelper.TypeClass(t.Type);
                                var amountClass = t.SignedAmount >= 0 ? "text-success" : "text-danger";
                                <tr class="financial-row @typeClass">
                                    <td data-label="التاريخ">@t.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td data-label="النوع">
                                        <span class="financial-chip @typeClass">@NetworkWalletTransactionDisplayHelper.TypeLabel(t.Type)</span>
                                    </td>
                                    <td data-label="المبلغ" class="text-center @amountClass"><strong>@t.SignedAmount.ToString("N2")</strong></td>
                                    <td data-label="قبل" class="text-center">@t.PreviousBalance.ToString("N2")</td>
                                    <td data-label="بعد" class="text-center">@t.NewBalance.ToString("N2")</td>
                                    <td data-label="تفاصيل النوع" class="text-muted">@NetworkWalletTransactionDisplayHelper.TypeDetails(t)</td>
                                    <td data-label="ملاحظات" class="text-muted">@(string.IsNullOrWhiteSpace(t.Notes) ? "—" : t.Notes)</td>
                                    <td data-label="بواسطة">@(t.CreatedByUser?.FullName ?? t.CreatedByUser?.UserName ?? t.CreatedByUserId)</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="8" class="text-center text-muted py-4">لا توجد عمليات حتى الآن.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
