@model RadTik.ViewModels.CompanyAdmin.CompanyWalletTopUpViewModel
@{
    ViewData["Title"] = ViewData["Title"] ?? "تغذية رصيد";
    var paymentMethods = ViewBag.PaymentMethods as IEnumerable<RadTik.Models.PaymentMethod> ?? Enumerable.Empty<RadTik.Models.PaymentMethod>();
    var pmList = paymentMethods.ToList();
}

<div class="wallet-topup-page">
    <div class="page-header d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
        <div>
            <h1>
                <i class="fas fa-wallet"></i>
                @ViewData["Title"]
            </h1>
            <p class="text-muted mb-0">أنشئ طلب تغذية رصيد وسيقوم مدير النظام بالموافقة عليه.</p>
        </div>
        <a class="btn btn-outline-secondary micro-btn" asp-route="networkManager-wallet-transactions">
            <i class="fas fa-list"></i>
            عمليات التعبئة
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info">@TempData["Info"]</div>
    }

    <div class="row g-3 mb-3">
        <div class="col-md-6 col-xl-4">
            <div class="card wallet-stat-card h-100">
                <div class="card-body">
                    <div class="wallet-stat-label">الشبكة المحددة</div>
                    <div class="wallet-stat-value">@Model.SelectedNetworkName</div>
                    <div class="wallet-stat-meta">#@Model.SelectedNetworkId</div>
                </div>
            </div>
        </div>
        <div class="col-md-6 col-xl-4">
            <div class="card wallet-stat-card h-100">
                <div class="card-body">
                    <div class="wallet-stat-label">الشركة المحتسبة</div>
                    <div class="wallet-stat-value">@Model.EffectiveCompanyNetworkName</div>
                    <div class="wallet-stat-meta">#@Model.EffectiveCompanyNetworkId</div>
                </div>
            </div>
        </div>
        <div class="col-md-12 col-xl-4">
            <div class="card wallet-stat-card wallet-stat-balance h-100">
                <div class="card-body">
                    <div class="wallet-stat-label">الرصيد الحالي</div>
                    <div class="wallet-stat-value">
                        @Model.CompanyBalance.ToString("N2")
                        <span class="wallet-currency">ل.س.ج</span>
                    </div>
                    <div class="wallet-stat-meta">يتم الخصم والإضافة على هذا الرصيد</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 align-items-start">
        <div class="col-xl-8">
            <div class="card wallet-form-card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-plus-circle text-success"></i>
                        إنشاء طلب تغذية رصيد
                    </h3>
                    <p class="text-muted mb-0 mt-2">املأ الحقول التالية بدقة لتسريع المراجعة والموافقة.</p>
                </div>
                <div class="card-body">
                    <form asp-area="CompanyAdmin" asp-controller="Wallet" asp-action="TopUp" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()

                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Amount" class="form-label"></label>
                                <input asp-for="Amount" class="form-control" type="number" min="0.01" step="0.01" placeholder="مثال: 250000" />
                                <span asp-validation-for="Amount" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ReferenceNumber" class="form-label"></label>
                                <input asp-for="ReferenceNumber" class="form-control" required placeholder="رقم إشعار/مرجع الدفع" />
                                <span asp-validation-for="ReferenceNumber" class="text-danger"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="PaymentMethodId" class="form-label">طريقة الدفع</label>
                                @if (pmList.Any())
                                {
                                    <select asp-for="PaymentMethodId" class="form-select" data-placeholder="اختر طريقة الدفع...">
                                        <option value=""></option>
                                        @foreach (var m in pmList)
                                        {
                                            <option value="@m.Id">@m.Name</option>
                                        }
                                    </select>
                                    <span asp-validation-for="PaymentMethodId" class="text-danger"></span>
                                }
                                else
                                {
                                    <input asp-for="Method" class="form-control" placeholder="مثال: دفع مباشر، تحويل..." />
                                    <span asp-validation-for="Method" class="text-danger"></span>
                                    <div class="text-muted small mt-1">لا توجد طرق دفع معرفة حالياً. يمكن لمدير النظام إضافتها.</div>
                                }
                            </div>

                            <div class="col-md-6">
                                <label asp-for="ReceiptImage" class="form-label"></label>
                                <input asp-for="ReceiptImage" class="form-control" type="file" required accept="image/*" data-max-bytes="3145728" data-size-message="حجم صورة الإيصال يجب ألا يتجاوز 3 ميغابايت." />
                                <span asp-validation-for="ReceiptImage" class="text-danger"></span>
                                <div class="text-muted small mt-1">صيغة مقبولة: JPG, JPEG, PNG, GIF, WebP. الحد الأقصى للحجم: 3 ميغابايت.</div>
                            </div>

                            <div class="col-12">
                                <label asp-for="Notes" class="form-label"></label>
                                <textarea asp-for="Notes" class="form-control" rows="4" placeholder="أي تفاصيل تساعد مدير النظام بالموافقة"></textarea>
                                <span asp-validation-for="Notes" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="wallet-form-actions d-flex justify-content-end gap-2 mt-4">
                            <a class="btn btn-outline-secondary micro-btn" asp-route="networkManager-features">
                                <i class="fas fa-arrow-right"></i>
                                الخدمات المتاحة
                            </a>
                            <button type="submit" class="btn btn-primary micro-btn">
                                <i class="fas fa-paper-plane"></i>
                                إرسال الطلب
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-xl-4">
            <div class="card wallet-help-card mb-4">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-circle-question text-info"></i>
                        كيف يتم تعبئة الرصيد؟
                    </h3>
                </div>
                <div class="card-body">
                    <ul class="wallet-help-steps">
                        <li>
                            <span class="step-dot">1</span>
                            <div>أدخل المبلغ وطريقة الدفع ورقم المرجع/الإشعار.</div>
                        </li>
                        <li>
                            <span class="step-dot">2</span>
                            <div>ارفع صورة الإيصال ثم اضغط <strong>إرسال الطلب</strong>.</div>
                        </li>
                        <li>
                            <span class="step-dot">3</span>
                            <div>يقوم <strong>مدير النظام</strong> بمراجعة الطلب والموافقة أو الرفض.</div>
                        </li>
                        <li>
                            <span class="step-dot">4</span>
                            <div>بعد الموافقة تضاف القيمة تلقائيا وتظهر في <strong>عمليات التعبئة</strong>.</div>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card wallet-actions-card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas fa-bolt text-warning"></i>
                        إجراءات سريعة
                    </h3>
                </div>
                <div class="card-body d-grid gap-2">
                    <a class="btn btn-outline-secondary micro-btn" asp-route="networkManager-wallet-transactions">
                        <i class="fas fa-list"></i>
                        عرض عمليات التعبئة
                    </a>
                    <a class="btn btn-outline-secondary micro-btn" asp-route="networkManager-receipts" asp-route-action="Index">
                        <i class="fas fa-receipt"></i>
                        عرض سجل القبض
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var receiptInput = document.getElementById('ReceiptImage');
            if (receiptInput) {
                var maxBytes = Number(receiptInput.getAttribute('data-max-bytes') || (3 * 1024 * 1024));
                var sizeMessage = receiptInput.getAttribute('data-size-message') || 'حجم الصورة يجب ألا يتجاوز 3 ميغابايت.';
                receiptInput.addEventListener('change', function () {
                    var file = receiptInput.files && receiptInput.files.length ? receiptInput.files[0] : null;
                    if (!file) {
                        receiptInput.setCustomValidity('');
                        return;
                    }

                    if (file.size > maxBytes) {
                        receiptInput.value = '';
                        receiptInput.setCustomValidity(sizeMessage);
                        receiptInput.reportValidity();
                    } else {
                        receiptInput.setCustomValidity('');
                    }
                });
            }

            if (!(window.jQuery && jQuery.fn.select2)) return;

            var $paymentMethod = jQuery('#PaymentMethodId');
            if (!$paymentMethod.length) return;

            if ($paymentMethod.hasClass('select2-hidden-accessible')) {
                $paymentMethod.select2('destroy');
            }

            $paymentMethod.select2({
                theme: 'bootstrap-5',
                dir: 'rtl',
                width: '100%',
                allowClear: true,
                placeholder: $paymentMethod.data('placeholder') || 'اختر طريقة الدفع...'
            });
        });
    </script>
}
