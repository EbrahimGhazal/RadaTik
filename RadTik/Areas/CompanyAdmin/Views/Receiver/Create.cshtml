@model RadTik.Models.Receiver

@{
    ViewData["Title"] = "إضافة مستقبل جديد";
    var isEmployeeActor = User.IsInRole("CompanyEmployee") || User.IsInRole("Employee") || User.IsInRole("EmployeeLegacy");
    var pendingSectorApprovalsCount = (int?)(ViewBag.PendingSectorApprovalsCount) ?? 0;
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="fas fa-plus-circle"></i>
            @ViewData["Title"]
        </h1>
        <div class="page-actions">
            <a asp-action="Index" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-right"></i> رجوع للقائمة
            </a>
        </div>
    </div>
</div>

@if (isEmployeeActor)
{
    <div class="alert alert-info mb-3">
        <i class="fas fa-circle-info me-1"></i>
        طلب الإضافة سيُرسل إلى مدير الشركة للموافقة قبل تفعيل المستقبل.
    </div>
}
else if (pendingSectorApprovalsCount > 0)
{
    <div class="alert alert-warning mb-3">
        <i class="fas fa-clock me-1"></i>
        لا توجد قطاعات مفعلة متاحة حالياً. يوجد <strong>@pendingSectorApprovalsCount</strong> طلب قطاع معلّق بانتظار الموافقة.
        <a asp-area="CompanyAdmin" asp-controller="EmployeeServiceApprovals" asp-action="Index" class="alert-link">انتقل لصفحة الموافقات</a>.
    </div>
}

<div class="card">
    <div class="card-header card-header-success">
        <h3 class="card-title">
            <i class="fas fa-wifi"></i>
            بيانات المستقبل الجديد
        </h3>
    </div>
    <div class="card-body">
        <form asp-action="Create" id="receiverForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-grid">
                <!-- القسم الأول: المعلومات الأساسية -->
                <div class="form-section">
                    <h4 class="form-section-title">
                        <i class="fas fa-info-circle"></i> المعلومات الأساسية
                    </h4>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Name" class="form-label required" for="Name">اسم المستقبل</label>
                            <input asp-for="Name" class="form-control" id="Name" placeholder="أدخل اسم المستقبل" autocomplete="off" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="SectorId" class="form-label required" for="sectorSelect">القطاع التابع له</label>
                            <select asp-for="SectorId" class="form-control no-select2" asp-items="ViewBag.SectorId" id="sectorSelect" name="SectorId" autocomplete="off">
                                <option value="">-- اختر القطاع --</option>
                            </select>
                            <span asp-validation-for="SectorId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="IPAddress" class="form-label required" for="ipAddressInput">عنوان IP</label>
                            <div class="input-with-btn">
                                <input asp-for="IPAddress" class="form-control" id="ipAddressInput" name="IPAddress" value="@ViewBag.NextIP" placeholder="xxx.xxx.xxx.xxx" autocomplete="off" />
                                <button type="button" class="btn btn-secondary" id="btnGenerateIP" title="توليد IP تلقائي">
                                    <i class="fas fa-sync-alt"></i>
                                </button>
                            </div>
                            <span asp-validation-for="IPAddress" class="text-danger"></span>
                            <small class="form-hint">يتم توليده تلقائياً بناءً على القطاع المحدد</small>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="NetworkMask" class="form-label" for="networkMaskInput">قناع الشبكة</label>
                            <input asp-for="NetworkMask" class="form-control" id="networkMaskInput" name="NetworkMask" value="@ViewBag.DefaultMask" placeholder="255.255.255.0" autocomplete="off" />
                            <span asp-validation-for="NetworkMask" class="text-danger"></span>
                            <small class="form-hint">يتم تعبئته تلقائياً من القطاع</small>
                        </div>
                    </div>
                </div>

                <!-- القسم الثاني: الموقع -->
                <div class="form-section">
                    <h4 class="form-section-title">
                        <i class="fas fa-map-marked-alt"></i> موقع المستقبل
                    </h4>
                    
                    <div class="map-container-form">
                        <div id="map"></div>
                        <div class="map-controls-overlay">
                            <div class="map-type-controls">
                                <button type="button" class="map-type-btn active" data-map-type="streets">شوارع</button>
                                <button type="button" class="map-type-btn" data-map-type="satellite">قمر صناعي</button>
                                <button type="button" class="map-type-btn" data-map-type="terrain">تضاريس</button>
                            </div>
                        </div>
                        <div class="map-info-overlay" id="sectorInfoOverlay">
                            <div class="info-box" id="sectorInfoPlaceholder">
                                <small><i class="fas fa-info-circle"></i> اختر القطاع أولاً لعرضه على الخريطة (الزاوية، المدى، الاتجاه)</small>
                            </div>
                            <div id="sectorInfo" class="d-none">
                                <small><strong>القطاع:</strong> <span id="selectedSectorName"></span></small>
                                <small><strong>الاتجاه (درجات):</strong> <span id="sectorDirection"></span></small>
                                <small><strong>زاوية الانتشار (درجات):</strong> <span id="sectorAngle"></span></small>
                                <small><strong>مدى الانتشار:</strong> <span id="coverageRange"></span> كم</small>
                                <small class="text-muted"><i class="fas fa-map-marker-alt"></i> الشكل على الخريطة يمثل نطاق التغطية</small>
                            </div>
                        </div>
                    </div>
                    <small class="form-hint">انقر على الخريطة لتحديد موقع المستقبل فقط. الحقول أدناه لموقع <strong>المستقبل</strong> وليست لموقع القطاع. بعد التحديد تُستخرج قيم الارتفاع والهوائي تلقائياً (يمكنك تعديلها).</small>

                    <div class="form-row form-row-3">
                        <div class="form-group">
                            <label asp-for="Latitude" class="form-label" for="latitudeInput">خط العرض (موقع المستقبل)</label>
                            <div class="input-with-btn">
                                <input asp-for="Latitude" class="form-control" id="latitudeInput" name="Latitude" type="number" step="0.000001" readonly autocomplete="off" />
                                <button type="button" class="btn btn-secondary btn-copy" data-copy="latitudeInput" title="نسخ">
                                    <i class="fas fa-copy"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Latitude" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="Longitude" class="form-label" for="longitudeInput">خط الطول (موقع المستقبل)</label>
                            <div class="input-with-btn">
                                <input asp-for="Longitude" class="form-control" id="longitudeInput" name="Longitude" type="number" step="0.000001" readonly autocomplete="off" />
                                <button type="button" class="btn btn-secondary btn-copy" data-copy="longitudeInput" title="نسخ">
                                    <i class="fas fa-copy"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Longitude" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label" for="distanceFromSector">المسافة من القطاع</label>
                            <div class="input-with-addon">
                                <input type="text" class="form-control" id="distanceFromSector" name="distanceFromSector" readonly value="غير محدد" autocomplete="off" aria-readonly="true" />
                                <span class="input-addon">كم</span>
                            </div>
                            <small class="form-hint" id="distanceStatus"></small>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="ElevationMeters" class="form-label" for="receiverElevationInput">الارتفاع عن سطح البحر عند المستقبل (م)</label>
                            <input asp-for="ElevationMeters" class="form-control" id="receiverElevationInput" type="number" step="0.1" placeholder="يُملأ عند النقر على الخريطة" />
                            <span asp-validation-for="ElevationMeters" class="text-danger"></span>
                            <small class="form-hint" id="receiverElevationHint">يُحدَّد تلقائياً عند اختيار موقع المستقبل على الخريطة (قابل للتعديل).</small>
                        </div>
                        <div class="form-group">
                            <label asp-for="AntennaHeightAglMeters" class="form-label" for="receiverAntennaAglInput">ارتفاع هوائي المستقبل عن الأرض (م)</label>
                            <input asp-for="AntennaHeightAglMeters" class="form-control" id="receiverAntennaAglInput" type="number" step="0.1" placeholder="6" />
                            <span asp-validation-for="AntennaHeightAglMeters" class="text-danger"></span>
                            <small class="form-hint">القيمة الافتراضية 6 م وتُعبَّأ تلقائياً مع موقع الخريطة (قابل للتعديل).</small>
                        </div>
                    </div>

                    <div class="los-static-notes" id="losStaticNotes">
                        <h5 class="los-notes-title"><i class="fas fa-info-circle"></i> ملاحظات مهمة — اقرأ قبل الاعتماد على التحليل</h5>
                        <ul class="los-notes-list">
                            <li><strong>ما الذي يُحسب؟</strong> مسار تقريبي مستقيم في المستوى بين موقع القطاع (المرسل) وموقع المستقبل، مع مقارنة ارتفاع خط الرؤية بين الهوائيات مع: ارتفاع التضاريس (نموذج خارجي)، ثم المبانٍ المسجّلة في خريطة الشارع المفتوحة إن وُجدت.</li>
                            <li><strong>دقة النتيجة:</strong> النتيجة <strong>تقديرية</strong> وليست مسحاً ميدانياً. التضاريس من خدمة ارتفاعات عامة؛ المبانٍ قد تكون ناقصة أو بارتفاع غير دقيق؛ لا يُغني عن المعاينة أو قياسات مهنية عند الحاجة.</li>
                            <li><strong>عند فشل جلب المبانٍ:</strong> يُعرض تحذير في النتيجة، والتحليل يبقى مفيداً لتضاريس المسار فقط.</li>
                            <li><strong>الخريطة بعد الضغط على «تحليل خط الرؤية»:</strong> خط برتقالي = مسار التحليل؛ دوائر حمراء = مبانٍ يُرجّح أنها أعلى من خط الرؤية عند ذلك الموضع؛ دائرة صفراء = أضيق نقطة تضاريس على المسار (يظهر فقط إذا كان الهامش أقل من حدّ معيّن).</li>
                        </ul>
                    </div>

                    <div id="losResultPanel" class="los-result-panel d-none" role="region" aria-live="polite">
                        <div class="los-result-header">
                            <h4 class="los-result-title"><i class="fas fa-mountain"></i> نتيجة تحليل خط الرؤية</h4>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnLosResultClose" title="إخفاء النتيجة">×</button>
                        </div>
                        <div id="losResultContent" class="los-result-content"></div>
                    </div>
                </div>

                <!-- القسم الثالث: معلومات إضافية -->
                <div class="form-section">
                    <div class="info-grid">
                        <div class="form-check-wrapper">
                            <input asp-for="IsActive" class="form-check-input" id="isActiveCheck" checked />
                            <label asp-for="IsActive" class="form-check-label" for="isActiveCheck">
                                <span class="check-text">تفعيل المستقبل</span>
                                <small class="check-hint">المستقبل سيكون نشطاً ويمكن إضافة مستخدمين له</small>
                            </label>
                        </div>

                        <div class="quick-info-box">
                            <h6><i class="fas fa-chart-bar"></i> معلومات القطاع</h6>
                            <div class="info-row">
                                <span>عدد المستقبلات:</span>
                                <strong id="receiversCount">0</strong>
                            </div>
                            <div class="info-row">
                                <span>نطاق IP:</span>
                                <strong id="sectorIPRange">غير محدد</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save"></i> حفظ المستقبل
                </button>
                <button type="button" class="btn btn-outline-primary" id="btnAnalyzeLos" title="تحليل المسار فوق التضاريس والمباني (بيانات خارجية)">
                    <i class="fas fa-mountain"></i> تحليل خط الرؤية
                </button>
                <button type="button" class="btn btn-info" id="btnCheckConnection" title="فحص اتصال المستقبل">
                    <i class="fas fa-wifi"></i> فحص الاتصال
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-times"></i> إلغاء
                </a>
            </div>
        </form>
    </div>
</div>

<style>
    .page-header {
        margin-bottom: var(--spacing-lg);
    }
    
    .page-header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .page-title {
        font-size: var(--font-2xl);
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }
    
    .page-title i {
        color: var(--success);
    }
    
    .card-header-success {
        background: linear-gradient(135deg, var(--success), #00a854) !important;
        color: white !important;
    }

    .form-grid {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xl);
    }

    .form-section {
        background: var(--bg-hover);
        padding: var(--spacing-lg);
        border-radius: var(--radius);
    }

    .form-section-title {
        font-size: var(--font-lg);
        font-weight: 600;
        margin-bottom: var(--spacing-lg);
        padding-bottom: var(--spacing-sm);
        border-bottom: 2px solid var(--primary);
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .form-section-title i {
        color: var(--primary);
    }

    .form-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--spacing-lg);
        margin-bottom: var(--spacing-md);
    }

    .form-row-3 {
        grid-template-columns: repeat(3, 1fr);
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
    }

    .form-label {
        font-weight: 500;
        font-size: var(--font-sm);
        color: var(--text-secondary);
    }

    .form-label.required::after {
        content: ' *';
        color: var(--danger);
    }

    .form-hint {
        font-size: 11px;
        color: var(--text-muted);
    }

    .input-with-btn {
        display: flex;
        gap: var(--spacing-xs);
    }

    .input-with-btn .form-control {
        flex: 1;
    }

    .input-with-addon {
        display: flex;
        align-items: stretch;
    }

    .input-with-addon .form-control {
        border-radius: var(--radius-sm) 0 0 var(--radius-sm);
    }

    .input-addon {
        display: flex;
        align-items: center;
        padding: 0 12px;
        background: var(--bg-hover);
        border: 1px solid var(--border-light);
        border-right: none;
        border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
        font-size: var(--font-sm);
        color: var(--text-muted);
    }

    .map-container-form {
        position: relative;
        height: 350px;
        border-radius: var(--radius);
        overflow: hidden;
        margin-bottom: var(--spacing-md);
    }

    .map-container-form #map {
        width: 100%;
        height: 100%;
    }

    .map-controls-overlay {
        position: absolute;
        top: 10px;
        right: 10px;
        z-index: 1000;
    }

    .map-type-controls {
        display: flex;
        gap: 2px;
        background: var(--bg-card);
        border-radius: var(--radius-sm);
        padding: 2px;
        box-shadow: var(--shadow-md);
    }

    .map-type-btn {
        padding: 4px 10px;
        border: none;
        background: transparent;
        border-radius: var(--radius-sm);
        font-size: var(--font-xs);
        cursor: pointer;
        transition: all 0.2s;
        color: var(--text-secondary);
    }

    .map-type-btn:hover {
        background: var(--bg-hover);
    }

    .map-type-btn.active {
        background: var(--primary);
        color: white;
    }

    .map-info-overlay {
        position: absolute;
        bottom: 10px;
        right: 10px;
        background: var(--bg-card);
        padding: var(--spacing-sm);
        border-radius: var(--radius-sm);
        box-shadow: var(--shadow-md);
        z-index: 1000;
        font-size: var(--font-xs);
    }

    .map-info-overlay small {
        display: block;
        margin-bottom: 2px;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--spacing-lg);
    }

    .form-check-wrapper {
        display: flex;
        align-items: flex-start;
        gap: var(--spacing-sm);
        padding: var(--spacing-md);
        background: var(--bg-card);
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-light);
    }

    .form-check-input {
        width: 20px;
        height: 20px;
        margin-top: 2px;
        cursor: pointer;
    }

    .form-check-label {
        cursor: pointer;
    }

    .check-text {
        display: block;
        font-weight: 600;
        margin-bottom: 2px;
    }

    .check-hint {
        display: block;
        font-size: 12px;
        color: var(--text-muted);
    }

    .quick-info-box {
        background: var(--bg-card);
        padding: var(--spacing-md);
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-light);
    }

    .quick-info-box h6 {
        margin-bottom: var(--spacing-sm);
        color: var(--text-secondary);
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        font-size: var(--font-sm);
        margin-bottom: 4px;
    }

    .form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-sm);
        margin-top: var(--spacing-xl);
        padding-top: var(--spacing-lg);
        border-top: 1px solid var(--border-light);
    }

    .los-result-panel {
        margin-top: var(--spacing-md);
        padding: var(--spacing-md);
        border: 1px solid var(--border-light);
        border-radius: var(--radius);
        background: var(--bg-card);
    }

    .los-result-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--spacing-sm);
    }

    .los-result-title {
        margin: 0;
        font-size: var(--font-md);
        font-weight: 600;
    }

    .los-result-content {
        font-size: var(--font-sm);
        line-height: 1.6;
    }

    .los-result-content table {
        width: 100%;
        border-collapse: collapse;
        margin-top: var(--spacing-sm);
    }

    .los-result-content th,
    .los-result-content td {
        border: 1px solid var(--border-light);
        padding: 6px 8px;
        text-align: right;
    }

    .los-result-content .badge-ok { color: var(--success); font-weight: 600; }
    .los-result-content .badge-warn { color: var(--danger); font-weight: 600; }

    .los-static-notes {
        margin-top: var(--spacing-md);
        padding: var(--spacing-md);
        border-radius: var(--radius);
        border: 1px solid rgba(13, 110, 253, 0.35);
        background: rgba(13, 110, 253, 0.06);
    }

    .los-notes-title {
        margin: 0 0 var(--spacing-sm) 0;
        font-size: var(--font-md);
        font-weight: 700;
        color: var(--text-primary);
    }

    .los-notes-list {
        margin: 0;
        padding-right: 1.25rem;
        font-size: var(--font-sm);
        line-height: 1.75;
        color: var(--text-secondary);
    }

    .los-notes-list li {
        margin-bottom: var(--spacing-sm);
    }

    .los-notes-list li:last-child {
        margin-bottom: 0;
    }

    .los-result-block {
        margin-top: var(--spacing-md);
        padding-top: var(--spacing-md);
        border-top: 1px solid var(--border-light);
    }

    .los-result-block:first-of-type {
        margin-top: 0;
        padding-top: 0;
        border-top: none;
    }

    .los-result-block h5 {
        margin: 0 0 var(--spacing-xs) 0;
        font-size: var(--font-sm);
        font-weight: 700;
        color: var(--text-primary);
    }

    .los-result-kv {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 4px 12px;
        font-size: var(--font-sm);
        align-items: baseline;
    }

    .los-result-kv dt {
        margin: 0;
        font-weight: 600;
        color: var(--text-secondary);
    }

    .los-result-kv dd {
        margin: 0;
    }

    @@media (max-width: 768px) {
        .form-row,
        .form-row-3,
        .info-grid {
            grid-template-columns: 1fr;
        }

        .map-container-form {
            height: 250px;
        }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script type="application/json" id="receiverSectorsMapJson">@Html.Raw(ViewBag.MapDataJson ?? "[]")</script>
    <script>
        (function () {
            function bootReceiverMap() {
            if (typeof L === 'undefined') {
                return;
            }

            // بيانات القطاعات من الخادم (JSON منفصل لتجنب كسر السكربت بسبب علامات التنصيص أو HTML)
            var mapJsonEl = document.getElementById('receiverSectorsMapJson');
            var raw = mapJsonEl && mapJsonEl.textContent ? mapJsonEl.textContent.trim() : '[]';
            var sectors = [];
            try { sectors = JSON.parse(raw); } catch (e) { sectors = []; }

            var getSectorInfoUrl = '@Url.Action("GetSectorInfo", "Receiver", new { area = "CompanyAdmin" })';
            var analyzeLosUrl = '@Url.Action("AnalyzeLineOfSight", "Receiver", new { area = "CompanyAdmin" })';
            var getElevationAtUrl = '@Url.Action("GetElevationAtPoint", "Receiver", new { area = "CompanyAdmin" })';

            var sectorSelect = document.getElementById('sectorSelect');
            var ipInput = document.getElementById('ipAddressInput');
            var maskInput = document.getElementById('networkMaskInput');
            var latInput = document.getElementById('latitudeInput');
            var lngInput = document.getElementById('longitudeInput');
            var distanceInput = document.getElementById('distanceFromSector');
            var distanceStatus = document.getElementById('distanceStatus');
            var receiversCount = document.getElementById('receiversCount');
            var sectorIPRange = document.getElementById('sectorIPRange');
            var sectorInfo = document.getElementById('sectorInfo');
            var sectorInfoPlaceholder = document.getElementById('sectorInfoPlaceholder');
            var selectedSector = null;
            var receiverElevInput = document.getElementById('receiverElevationInput');
            var receiverAglInput = document.getElementById('receiverAntennaAglInput');
            var receiverElevationHint = document.getElementById('receiverElevationHint');
            var defaultReceiverAntennaM = 6;
            var terrainFetchToken = 0;

            if (!sectorSelect) {
                return;
            }

            // إنشاء الخريطة بدون أي قطاع مبدئيًا
            var defaultLat = 35.5200;
            var defaultLng = 35.7800;
            var map = L.map('map').setView([defaultLat, defaultLng], 10);

            var streetLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap', maxZoom: 19
            }).addTo(map);

            var satelliteLayer = L.tileLayer('https://{s}.google.com/vt/lyrs=s&x={x}&y={y}&z={z}', {
                maxZoom: 20, subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
            });

            var terrainLayer = L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', { maxZoom: 17 });

            var currentSectorMarker = null;
            var currentCoverage = null;
            var currentDirectionLine = null;
            var currentReceiversLayer = null;
            var receiverMarker = null;
            var losAnalysisLayerGroup = null;

            var sectorsById = {};
            sectors.forEach(function (s) {
                sectorsById[String(s.id)] = s;
            });

            function refreshMapLayout() {
                requestAnimationFrame(function () {
                    map.invalidateSize(false);
                    setTimeout(function () { map.invalidateSize(false); }, 50);
                    setTimeout(function () { map.invalidateSize(false); }, 280);
                });
            }

            function clearLosAnalysisOverlay() {
                if (losAnalysisLayerGroup) {
                    map.removeLayer(losAnalysisLayerGroup);
                    losAnalysisLayerGroup = null;
                }
            }

            /** رسم خط المسار + مبانٍ تعيق + أضيق نقطة تضاريس بعد نجاح التحليل */
            function renderLosAnalysisOnMap(analysis) {
                clearLosAnalysisOverlay();
                if (!selectedSector || !isFinite(selectedSector.latitude) || !isFinite(selectedSector.longitude)) {
                    return;
                }
                var lat0 = selectedSector.latitude;
                var lon0 = selectedSector.longitude;
                var lat1 = parseFloat(latInput.value);
                var lon1 = parseFloat(lngInput.value);
                if (!isFinite(lat1) || !isFinite(lon1)) {
                    return;
                }

                losAnalysisLayerGroup = L.layerGroup();

                var pathLine = L.polyline([[lat0, lon0], [lat1, lon1]], {
                    color: '#fd7e14',
                    weight: 3,
                    opacity: 0.9,
                    dashArray: '10,7'
                });
                pathLine.bindPopup('مسار خط الرؤية (تقريبي بين الهوائيات)');
                losAnalysisLayerGroup.addLayer(pathLine);

                var distTotal = analysis.distanceMeters || 0;
                if (distTotal > 0 && analysis.profile && analysis.profile.length) {
                    var worst = null;
                    analysis.profile.forEach(function (p) {
                        if (worst == null || p.marginMeters < worst.marginMeters) {
                            worst = p;
                        }
                    });
                    if (worst && worst.marginMeters < 2) {
                        var t = worst.distanceFromStartMeters / distTotal;
                        if (isFinite(t)) {
                            t = Math.max(0, Math.min(1, t));
                            var wlat = lat0 + t * (lat1 - lat0);
                            var wlon = lon0 + t * (lon1 - lon0);
                            var wm = L.circleMarker([wlat, wlon], {
                                radius: 8,
                                color: '#e0a800',
                                fillColor: '#ffc107',
                                fillOpacity: 0.95,
                                weight: 2
                            });
                            wm.bindPopup('أضيق هامش تضاريس: ' + worst.marginMeters + ' م (تقريبي)');
                            losAnalysisLayerGroup.addLayer(wm);
                        }
                    }
                }

                var buildings = analysis.buildingObstructions || [];
                buildings.forEach(function (b) {
                    if (!isFinite(b.lat) || !isFinite(b.lon)) {
                        return;
                    }
                    if (!b.likelyBlocksLos) {
                        return;
                    }
                    var icon = L.divIcon({
                        className: 'los-building-marker',
                        html: '<div style="background:#dc3545;width:28px;height:28px;border-radius:50%;border:2px solid #fff;box-shadow:0 1px 5px rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;"><i class="fas fa-building"></i></div>',
                        iconSize: [28, 28],
                        iconAnchor: [14, 14]
                    });
                    var m = L.marker([b.lat, b.lon], { icon: icon });
                    m.bindPopup(
                        '<strong>مبنى — قد يعيق</strong><br>' +
                        'سقف تقريبي: ' + (b.roofMslMeters != null ? b.roofMslMeters : '—') + ' م<br>' +
                        'خط الرؤية هنا: ' + (b.lineHeightAtPointMslMeters != null ? b.lineHeightAtPointMslMeters : '—') + ' م<br>' +
                        'جانبي عن المسار: ~' + (b.crossTrackMeters != null ? b.crossTrackMeters : '—') + ' م'
                    );
                    losAnalysisLayerGroup.addLayer(m);
                });

                losAnalysisLayerGroup.addTo(map);
                try {
                    var b = losAnalysisLayerGroup.getBounds();
                    if (b.isValid()) {
                        map.fitBounds(b.pad(0.15));
                    }
                } catch (e) { /* ignore */ }
            }

            /** يملأ ارتفاع الأرض (Open-Elevation عبر الخادم) وارتفاع الهوائي الافتراضي عند تحديد موقع على الخريطة */
            function refreshReceiverTerrainFromMap(lat, lng) {
                clearLosAnalysisOverlay();
                if (!receiverElevInput || !receiverAglInput) {
                    return;
                }
                if (!isFinite(lat) || !isFinite(lng)) {
                    return;
                }
                receiverAglInput.value = String(defaultReceiverAntennaM);
                receiverElevInput.value = '';
                receiverElevInput.placeholder = 'جارٍ جلب الارتفاع...';
                if (receiverElevationHint) {
                    receiverElevationHint.textContent = 'جارٍ جلب الارتفاع من نموذج التضاريس...';
                }
                var myToken = ++terrainFetchToken;
                var url = getElevationAtUrl + '?lat=' + encodeURIComponent(lat) + '&lon=' + encodeURIComponent(lng);
                fetch(url, {
                    credentials: 'same-origin',
                    headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                    .then(function (r) {
                        return r.json();
                    })
                    .then(function (data) {
                        if (myToken !== terrainFetchToken) {
                            return;
                        }
                        receiverElevInput.placeholder = 'يُملأ عند النقر على الخريطة';
                        if (receiverElevationHint) {
                            receiverElevationHint.textContent = 'يُحدَّد تلقائياً عند اختيار موقع المستقبل على الخريطة (قابل للتعديل).';
                        }
                        if (data && data.success && data.elevationMeters != null) {
                            receiverElevInput.value = String(data.elevationMeters);
                        }
                    })
                    .catch(function () {
                        if (myToken !== terrainFetchToken) {
                            return;
                        }
                        receiverElevInput.placeholder = 'أدخل الارتفاع يدوياً أو أعد المحاولة';
                        if (receiverElevationHint) {
                            receiverElevationHint.textContent = 'تعذر جلب الارتفاع تلقائياً — يمكنك إدخاله يدوياً.';
                        }
                    });
            }

            function applySector(s) {
                if (!s) return;
                selectedSector = s;
                updateSectorInfoPanel(s);
                drawSelectedSector(s);
                if (isFinite(s.latitude) && isFinite(s.longitude)) {
                    latInput.value = Number(s.latitude).toFixed(6);
                    lngInput.value = Number(s.longitude).toFixed(6);
                    updateReceiverMarker(s.latitude, s.longitude);
                    updateDistanceFromSector();
                    refreshReceiverTerrainFromMap(s.latitude, s.longitude);
                }
                refreshMapLayout();
            }

            /** مصدر الحقيقة: الخادم؛ القائمة المضمّنة احتياط عند فشل الشبكة */
            function loadSectorForMap(sectorId) {
                if (!sectorId) {
                    clearSectorInfo();
                    return;
                }
                fetch(getSectorInfoUrl + '?sectorId=' + encodeURIComponent(sectorId), {
                    credentials: 'same-origin',
                    headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                    .then(function (r) {
                        if (!r.ok) {
                            throw new Error('http_' + r.status);
                        }
                        var ct = r.headers.get('content-type') || '';
                        if (ct.indexOf('application/json') === -1) {
                            throw new Error('not_json');
                        }
                        return r.json();
                    })
                    .then(function (data) {
                        if (!data || !data.success || !data.sector) {
                            var fallback = sectorsById[String(sectorId)];
                            if (fallback) {
                                applySector(fallback);
                                return;
                            }
                            showAlert('تعذر تحميل بيانات القطاع للخريطة.', 'warning');
                            return;
                        }
                        var sec = data.sector;
                        var mapped = {
                            id: sec.id,
                            name: sec.name,
                            latitude: sec.latitude,
                            longitude: sec.longitude,
                            direction: sec.direction,
                            coverageAngle: sec.coverageAngle,
                            coverageRange: sec.coverageRange,
                            ipAddress: sec.ipAddress,
                            networkMask: sec.networkMask,
                            elevationMeters: sec.elevationMeters,
                            antennaHeightAglMeters: sec.antennaHeightAglMeters,
                            receivers: (data.receivers || []).map(function (r) {
                                return { id: r.id, name: r.name, latitude: r.latitude, longitude: r.longitude, ip: r.ip };
                            })
                        };
                        sectorsById[String(mapped.id)] = mapped;
                        applySector(mapped);
                    })
                    .catch(function () {
                        var fallback = sectorsById[String(sectorId)];
                        if (fallback) {
                            applySector(fallback);
                            return;
                        }
                        showAlert('تعذر الاتصال بالخادم لتحميل بيانات القطاع.', 'danger');
                    });
            }

            // تبديل نوع الخريطة
            document.querySelectorAll('.map-type-btn').forEach(function (button) {
                button.addEventListener('click', function () {
                    document.querySelectorAll('.map-type-btn').forEach(function (btn) { btn.classList.remove('active'); });
                    this.classList.add('active');
                    map.removeLayer(streetLayer); map.removeLayer(satelliteLayer); map.removeLayer(terrainLayer);
                    switch (this.getAttribute('data-map-type')) {
                        case 'satellite': satelliteLayer.addTo(map); break;
                        case 'terrain': terrainLayer.addTo(map); break;
                        default: streetLayer.addTo(map);
                    }
                });
            });

            // عند اختيار قطاع — لا نعتمد على Select2 (مُعطَّل لهذا الحقل عبر no-select2)؛ وربط إضافي لأحداث jQuery إن وُجدت
            function onSectorChosen() {
                loadSectorForMap(sectorSelect.value);
            }
            sectorSelect.addEventListener('change', onSectorChosen);
            if (typeof jQuery !== 'undefined') {
                jQuery(sectorSelect)
                    .off('change.rtMap select2:select.rtMap select2:clear.rtMap')
                    .on('change.rtMap', onSectorChosen)
                    .on('select2:select.rtMap', onSectorChosen)
                    .on('select2:clear.rtMap', function () { clearSectorInfo(); });
            }

            // النقر على الخريطة لتغيير موقع المستقبل
            map.on('click', function (e) {
                clearLosAnalysisOverlay();
                latInput.value = e.latlng.lat.toFixed(6);
                lngInput.value = e.latlng.lng.toFixed(6);
                updateReceiverMarker(e.latlng.lat, e.latlng.lng);
                updateDistanceFromSector();
                refreshReceiverTerrainFromMap(e.latlng.lat, e.latlng.lng);
            });

            document.getElementById('btnGenerateIP').addEventListener('click', function () {
                var sectorId = sectorSelect.value;
                if (!sectorId) {
                    showAlert('يرجى اختيار القطاع أولاً', 'warning');
                    return;
                }
                generateIPForSector(sectorId);
            });

            document.querySelectorAll('.btn-copy').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var inputId = this.getAttribute('data-copy');
                    var input = document.getElementById(inputId);
                    input.select();
                    navigator.clipboard.writeText(input.value || '');
                    showAlert('تم النسخ', 'success');
                });
            });

            document.getElementById('btnCheckConnection').addEventListener('click', checkConnection);

            function parseOptionalFloatInput(el) {
                if (!el || el.value === '' || el.value === null) {
                    return null;
                }
                var v = parseFloat(el.value);
                return isFinite(v) ? v : null;
            }

            function analyzeLineOfSight() {
                var sectorId = sectorSelect.value;
                if (!sectorId) {
                    showAlert('يرجى اختيار القطاع أولاً', 'warning');
                    return;
                }
                var lat = parseFloat(latInput.value);
                var lng = parseFloat(lngInput.value);
                if (!isFinite(lat) || !isFinite(lng)) {
                    showAlert('يرجى تحديد موقع المستقبل على الخريطة أولاً', 'warning');
                    return;
                }
                var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                var token = tokenInput ? tokenInput.value : '';
                var elevIn = document.getElementById('receiverElevationInput');
                var aglIn = document.getElementById('receiverAntennaAglInput');
                var body = {
                    sectorId: parseInt(sectorId, 10),
                    receiverLatitude: lat,
                    receiverLongitude: lng,
                    receiverElevationMeters: parseOptionalFloatInput(elevIn),
                    receiverAntennaHeightAglMeters: parseOptionalFloatInput(aglIn)
                };
                var btn = document.getElementById('btnAnalyzeLos');
                var prev = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري التحليل...';
                clearLosAnalysisOverlay();
                var panel = document.getElementById('losResultPanel');
                var content = document.getElementById('losResultContent');
                panel.classList.remove('d-none');
                content.innerHTML = '<p class="text-muted mb-0">جارٍ جلب التضاريس وبيانات المبانٍ...</p>';

                fetch(analyzeLosUrl, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'X-CSRF-TOKEN': token,
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(body)
                })
                    .then(function (r) {
                        if (!r.ok) {
                            throw new Error('http_' + r.status);
                        }
                        return r.json();
                    })
                    .then(function (data) {
                        if (!data || !data.success) {
                            content.innerHTML = '<p class="text-danger">' + (data && data.message ? data.message : 'فشل التحليل') + '</p>';
                            return;
                        }
                        var a = data.analysis;
                        var terrainOk = a.terrainClear
                            ? '<span class="badge-ok">لا يظهر حجب واضح في النموذج</span>'
                            : '<span class="badge-warn">قد يوجد حجب (تضاريس و/أو مبنى)</span>';
                        var terrainSummary = a.terrainClear
                            ? 'ضمن العينات الحسابية، خط الرؤية يبقى فوق سطح الأرض بهامش كافٍ تقريباً، ولم يُرصد مبنى يعيق في البيانات المتاحة (إن وُجدت مبانٍ).'
                            : 'هناك على الأقل موضع على المسار حيث يقل الهامش عن التضاريس أو يُرصد مبنى أعلى من خط الرؤية — راجع التفاصيل أدناه والخريطة.';

                        var buildingIntro = '';
                        if (a.buildingsDataAvailable) {
                            buildingIntro = 'تم جلب بيانات مبانٍ من خريطة الشارع المفتوحة وفحص ما يقارب ' + (a.buildingsConsidered || 0) + ' مبنى ضمن ممر يحيط بالمسار. الارتفاعات تقديرية.';
                        } else {
                            buildingIntro = '<strong class="text-warning">لم تُحمّل بيانات المبانٍ من الخادم الخارجي.</strong> النتيجة تعتمد على التضاريس فقط؛ قد توجد مبانٍ غير مُدرَجة في الخريطة.';
                        }

                        var obstructs = (a.buildingObstructions || []).filter(function (b) { return b.likelyBlocksLos; });
                        var obstHtml = '';
                        if (obstructs.length) {
                            obstHtml = '<ul class="los-notes-list" style="margin-top:8px">';
                            obstructs.forEach(function (b) {
                                obstHtml += '<li>موقع تقريبي: سقف المبنى ~' + b.roofMslMeters + ' م (فوق سطح البحر)، بينما ارتفاع خط الرؤية عند هذا الموضع ~' + b.lineHeightAtPointMslMeters + ' م. بعد المبنى عن محور المسار ~' + b.crossTrackMeters + ' م.</li>';
                            });
                            obstHtml += '</ul>';
                        } else if (a.buildingsDataAvailable && (a.buildingsConsidered || 0) > 0) {
                            obstHtml = '<p class="mb-0 mt-1 text-muted">لم يُعتبر أي مبنى من العيّنات «حاجباً» لخط الرؤية ضمن القواعد المستخدمة (ارتفاع السقف مقابل خط الرؤية).</p>';
                        } else if (!a.buildingsDataAvailable) {
                            obstHtml = '';
                        } else {
                            obstHtml = '<p class="mb-0 mt-1 text-muted">لم يُعثر على مبانٍ ضمن نطاق الفحص التقريبي.</p>';
                        }

                        var profileBlock = '';
                        if (a.profile && a.profile.length) {
                            profileBlock =
                                '<dl class="los-result-kv">' +
                                '<dt>أقل هامش عن سطح الأرض:</dt><dd><strong>' + a.minTerrainMarginMeters + '</strong> متراً (أضيق نقطة بين العينات على المسار)</dd>' +
                                '</dl>' +
                                '<p class="form-hint mb-0 mt-1">إذا كان هذا الرقم صغيراً جداً أو سالباً، يعني أن خط الرؤية قريب جداً من الأرض أو أسفلها في النموذج.</p>';
                        }

                        content.innerHTML =
                            '<div class="los-result-block">' +
                            '<h5>الخلاصة</h5>' +
                            '<dl class="los-result-kv">' +
                            '<dt>المسافة (خط جوّي):</dt><dd>' + a.distanceMeters + ' م</dd>' +
                            '<dt>الحالة المجمّعة:</dt><dd>' + terrainOk + '</dd>' +
                            '</dl>' +
                            '<p class="mb-0 mt-2">' + terrainSummary + '</p>' +
                            '</div>' +

                            '<div class="los-result-block">' +
                            '<h5>التضاريس والمسار الرأسي</h5>' +
                            '<p class="mb-1"><strong>ما يعنيه النظام:</strong> ' + (a.terrainNote || '—') + '</p>' +
                            profileBlock +
                            '</div>' +

                            '<div class="los-result-block">' +
                            '<h5>المبانٍ (من بيانات خارجية)</h5>' +
                            '<p class="mb-1">' + buildingIntro + '</p>' +
                            obstHtml +
                            '</div>' +

                            '<div class="los-result-block">' +
                            '<h5>الخريطة</h5>' +
                            '<p class="mb-0">بعد هذا التحليل تُرسَم على الخريطة: <strong>خط برتقالي متقطع</strong> = مسار التحليل؛ <strong>علامات حمراء</strong> = مبانٍ يُرجّح أنها أعلى من خط الرؤية؛ <strong>دائرة صفراء</strong> = أضيق نقطة تضاريس (تظهر فقط إذا كان الهامش أقل من 2 م).</p>' +
                            '</div>' +

                            '<div class="los-result-block">' +
                            '<h5>تحذير نهائي</h5>' +
                            '<p class="mb-0 text-muted">لا تُستخدم هذه الشاشة وحدها لاتخاذ قرار تركيب نهائي دون تحقق ميداني أو قياسات عند الحاجة؛ البيانات والنموذج تقريبيان.</p>' +
                            '</div>';
                        renderLosAnalysisOnMap(a);
                    })
                    .catch(function () {
                        content.innerHTML = '<p class="text-danger">تعذر إكمال التحليل. تحقق من الاتصال أو حاول لاحقاً.</p>';
                    })
                    .finally(function () {
                        btn.disabled = false;
                        btn.innerHTML = prev;
                        panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    });
            }

            var btnAnalyzeLos = document.getElementById('btnAnalyzeLos');
            if (btnAnalyzeLos) {
                btnAnalyzeLos.addEventListener('click', analyzeLineOfSight);
            }
            var btnLosResultClose = document.getElementById('btnLosResultClose');
            if (btnLosResultClose) {
                btnLosResultClose.addEventListener('click', function () {
                    document.getElementById('losResultPanel').classList.add('d-none');
                });
            }

            function clearMapLayers() {
                clearLosAnalysisOverlay();
                if (currentSectorMarker) { map.removeLayer(currentSectorMarker); currentSectorMarker = null; }
                if (currentCoverage) { map.removeLayer(currentCoverage); currentCoverage = null; }
                if (currentDirectionLine) { map.removeLayer(currentDirectionLine); currentDirectionLine = null; }
                if (currentReceiversLayer) { map.removeLayer(currentReceiversLayer); currentReceiversLayer = null; }
                if (receiverMarker) { map.removeLayer(receiverMarker); receiverMarker = null; }
            }

            function updateSectorInfoPanel(s) {
                document.getElementById('selectedSectorName').textContent = s.name || '';
                document.getElementById('sectorDirection').textContent = (Number(s.direction) || 0).toFixed(1) + '°';
                document.getElementById('sectorAngle').textContent = (Number(s.coverageAngle) || 0).toFixed(1) + '°';
                document.getElementById('coverageRange').textContent = (Number(s.coverageRange) || 0).toFixed(2);
                receiversCount.textContent = Array.isArray(s.receivers) ? s.receivers.length : 0;
                sectorIPRange.textContent = (s.ipAddress || '') + ' / ' + (s.networkMask || '');
                sectorInfo.classList.remove('d-none');
                if (sectorInfoPlaceholder) sectorInfoPlaceholder.classList.add('d-none');
            }

            function drawSelectedSector(s) {
                clearMapLayers();

                if (!isFinite(s.latitude) || !isFinite(s.longitude)) {
                    showAlert('لا يمكن عرض القطاع على الخريطة لأن إحداثياته غير محددة. يرجى ضبط موقع القطاع أولاً من صفحة القطاعات.', 'warning');
                    return;
                }

                var sectorIcon = L.divIcon({
                    html: '<div style="background:#007bff;width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-size:20px;"><i class="fas fa-broadcast-tower"></i></div>',
                    iconSize: [40, 40], iconAnchor: [20, 20]
                });

                currentSectorMarker = L.marker([s.latitude, s.longitude], { icon: sectorIcon }).addTo(map)
                    .bindPopup(
                        '<strong>' + (s.name || '') + '</strong>' +
                        '<br>IP: ' + (s.ipAddress || '') +
                        '<br>الاتجاه: ' + ((Number(s.direction) || 0).toFixed(1)) + '°' +
                        '<br>زاوية التغطية: ' + ((Number(s.coverageAngle) || 0).toFixed(1)) + '°' +
                        '<br>مدى التغطية: ' + ((Number(s.coverageRange) || 0).toFixed(2)) + ' كم'
                    );

                var coverageResult = drawCoverageSector(s);
                currentCoverage = coverageResult.coverageLayer;
                currentDirectionLine = coverageResult.directionLine;

                var bounds = [[s.latitude, s.longitude]];
                if (Array.isArray(coverageResult.boundsPoints)) {
                    coverageResult.boundsPoints.forEach(function (p) { bounds.push(p); });
                }

                var markers = [];
                if (Array.isArray(s.receivers)) {
                    s.receivers.forEach(function (r) {
                        if (!isFinite(r.latitude) || !isFinite(r.longitude)) return;
                        var icon = L.divIcon({
                            html: '<div style="background:#6c757d;width:25px;height:25px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;"><i class="fas fa-wifi"></i></div>',
                            iconSize: [25, 25], iconAnchor: [12.5, 12.5]
                        });
                        var m = L.marker([r.latitude, r.longitude], { icon: icon })
                            .bindPopup('<strong>' + (r.name || '') + '</strong><br>IP: ' + (r.ip || ''));
                        markers.push(m);
                        bounds.push([r.latitude, r.longitude]);
                    });
                }

                if (markers.length) {
                    currentReceiversLayer = L.layerGroup(markers).addTo(map);
                }

                if (bounds.length > 0) {
                    map.fitBounds(bounds, { padding: [30, 30] });
                } else {
                    map.setView([s.latitude, s.longitude], 15);
                }
            }

            function drawCoverageSector(s) {
                var direction = Number(s.direction) || 0;
                var angle = Number(s.coverageAngle) || 60;
                var range = Number(s.coverageRange) || 5;
                var rangeMeters = range * 1000;
                var center = [s.latitude, s.longitude];
                var boundsPoints = [];
                var coverageLayers = [];
                var directionEnd = destinationPointByBearing(center, rangeMeters, direction);

                if (angle >= 359.5) {
                    var circle = L.circle(center, {
                        radius: rangeMeters,
                        color: '#007bff',
                        fillColor: '#007bff',
                        fillOpacity: 0.18,
                        weight: 2
                    });
                    coverageLayers.push(circle);
                    boundsPoints.push(destinationPointByBearing(center, rangeMeters, 0));
                    boundsPoints.push(destinationPointByBearing(center, rangeMeters, 90));
                    boundsPoints.push(destinationPointByBearing(center, rangeMeters, 180));
                    boundsPoints.push(destinationPointByBearing(center, rangeMeters, 270));
                } else {
                    var startBearing = (direction - angle / 2 + 360) % 360;
                    var endBearing = (direction + angle / 2 + 360) % 360;
                    var points = [center];
                    var steps = 36;
                    for (var i = 0; i <= steps; i++) {
                        var b = (startBearing + ((angle * i) / steps) + 360) % 360;
                        var p = destinationPointByBearing(center, rangeMeters, b);
                        points.push(p);
                        boundsPoints.push(p);
                    }
                    points.push(center);

                    var wedge = L.polygon(points, {
                        color: '#007bff',
                        fillColor: '#007bff',
                        fillOpacity: 0.2,
                        weight: 2
                    });
                    coverageLayers.push(wedge);

                    var edgeStart = destinationPointByBearing(center, rangeMeters, startBearing);
                    var edgeEnd = destinationPointByBearing(center, rangeMeters, endBearing);
                    coverageLayers.push(L.polyline([center, edgeStart], { color: '#0b5ed7', weight: 1.5, dashArray: '4,4' }));
                    coverageLayers.push(L.polyline([center, edgeEnd], { color: '#0b5ed7', weight: 1.5, dashArray: '4,4' }));
                }

                var coverageLayer = L.layerGroup(coverageLayers).addTo(map);
                var directionLine = L.polyline([center, directionEnd], {
                    color: '#dc3545',
                    weight: 3,
                    opacity: 0.9
                }).addTo(map);
                boundsPoints.push(directionEnd);

                return {
                    coverageLayer: coverageLayer,
                    directionLine: directionLine,
                    boundsPoints: boundsPoints
                };
            }

            function destinationPointByBearing(center, distanceMeters, bearingDeg) {
                var R = 6371000;
                var brng = bearingDeg * Math.PI / 180;
                var lat1 = center[0] * Math.PI / 180;
                var lng1 = center[1] * Math.PI / 180;
                var dByR = distanceMeters / R;

                var lat2 = Math.asin(Math.sin(lat1) * Math.cos(dByR) + Math.cos(lat1) * Math.sin(dByR) * Math.cos(brng));
                var lng2 = lng1 + Math.atan2(
                    Math.sin(brng) * Math.sin(dByR) * Math.cos(lat1),
                    Math.cos(dByR) - Math.sin(lat1) * Math.sin(lat2)
                );

                return [lat2 * 180 / Math.PI, lng2 * 180 / Math.PI];
            }

            function updateReceiverMarker(lat, lng) {
                if (receiverMarker) { map.removeLayer(receiverMarker); }
                var receiverIcon = L.divIcon({
                    className: 'receiver-marker',
                    html: '<div style="background:#28a745;width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;"><i class="fas fa-wifi"></i></div>',
                    iconSize: [30, 30], iconAnchor: [15, 15]
                });
                receiverMarker = L.marker([lat, lng], { icon: receiverIcon }).addTo(map);
            }

            function updateDistanceFromSector() {
                if (!selectedSector || !isFinite(selectedSector.latitude) || !isFinite(selectedSector.longitude)) {
                    distanceInput.value = 'غير محدد';
                    distanceStatus.textContent = '';
                    return;
                }
                var lat = Number(latInput.value);
                var lng = Number(lngInput.value);
                if (!isFinite(lat) || !isFinite(lng)) {
                    distanceInput.value = 'غير محدد';
                    distanceStatus.textContent = '';
                    return;
                }

                var R = 6371;
                var dLat = (lat - selectedSector.latitude) * Math.PI / 180;
                var dLon = (lng - selectedSector.longitude) * Math.PI / 180;
                var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                    Math.cos(selectedSector.latitude * Math.PI / 180) *
                    Math.cos(lat * Math.PI / 180) *
                    Math.sin(dLon / 2) * Math.sin(dLon / 2);
                var distance = R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));

                distanceInput.value = distance.toFixed(2);
                if (distance <= (Number(selectedSector.coverageRange) || 0)) {
                    distanceStatus.textContent = '✅ داخل نطاق التغطية';
                    distanceStatus.style.color = 'var(--success)';
                } else {
                    distanceStatus.textContent = '⚠️ خارج نطاق التغطية';
                    distanceStatus.style.color = 'var(--danger)';
                }
            }

            function generateIPForSector(sectorId) {
                var btn = document.getElementById('btnGenerateIP');
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                btn.disabled = true;
                var url = '@Url.Action("GetNextReceiverIP", "Receiver", new { area = "CompanyAdmin" })' + '?sectorId=' + encodeURIComponent(sectorId);
                fetch(url)
                    .then(function (response) { return response.json(); })
                    .then(function (data) {
                        if (data.success && ipInput) {
                            ipInput.value = data.nextIP;
                        }
                    })
                    .finally(function () {
                        btn.innerHTML = '<i class="fas fa-sync-alt"></i>';
                        btn.disabled = false;
                    });
            }

            function checkConnection() {
                var ip = ipInput.value;
                if (!ip) {
                    showAlert('يرجى إدخال عنوان IP أولاً', 'warning');
                    return;
                }
                var btn = document.getElementById('btnCheckConnection');
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الفحص...';
                btn.disabled = true;
                setTimeout(function () {
                    var success = Math.random() > 0.3;
                    showAlert(success ? '✅ اتصال ناجح' : '❌ فشل الاتصال', success ? 'success' : 'danger');
                    btn.innerHTML = '<i class="fas fa-wifi"></i> فحص الاتصال';
                    btn.disabled = false;
                }, 1500);
            }

            function clearSectorInfo() {
                selectedSector = null;
                sectorInfo.classList.add('d-none');
                if (sectorInfoPlaceholder) sectorInfoPlaceholder.classList.remove('d-none');
                receiversCount.textContent = '0';
                sectorIPRange.textContent = 'غير محدد';
                distanceInput.value = 'غير محدد';
                distanceStatus.textContent = '';
                if (receiverElevInput) {
                    receiverElevInput.value = '';
                    receiverElevInput.placeholder = 'يُملأ عند النقر على الخريطة';
                }
                if (receiverAglInput) {
                    receiverAglInput.value = '';
                }
                if (receiverElevationHint) {
                    receiverElevationHint.textContent = 'يُحدَّد تلقائياً عند اختيار موقع المستقبل على الخريطة (قابل للتعديل).';
                }
                terrainFetchToken++;
                clearMapLayers();
            }

            function showAlert(message, type) {
                var alertHtml = '<div class="alert alert-' + type +
                    ' alert-dismissible fade show" style="position:fixed;top:20px;left:50%;transform:translateX(-50%);z-index:9999;">' +
                    message +
                    '<button type="button" class="btn-close" onclick="this.parentElement.remove()"></button></div>';
                document.body.insertAdjacentHTML('beforeend', alertHtml);
                setTimeout(function () {
                    var el = document.querySelector('.alert');
                    if (el) el.remove();
                }, 3000);
            }

            if (sectorSelect.value) {
                loadSectorForMap(sectorSelect.value);
            }
            } /* bootReceiverMap */

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', bootReceiverMap);
            } else {
                bootReceiverMap();
            }
        })();
    </script>
}
