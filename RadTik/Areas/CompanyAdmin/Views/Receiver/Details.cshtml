@model RadTik.Models.Receiver

@{
    ViewData["Title"] = "تفاصيل المستقبل";
    var isPendingApproval = (bool?)ViewBag.IsPendingReceiverApproval == true;
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="fas fa-info-circle"></i>
            @ViewData["Title"]: @Model.Name
        </h1>
        <div class="page-actions">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning btn-sm">
                <i class="fas fa-edit"></i> تعديل
            </a>
            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger btn-sm">
                <i class="fas fa-trash"></i> حذف
            </a>
            <a asp-action="Index" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-right"></i> رجوع
            </a>
        </div>
    </div>
</div>

<!-- Stats Bar -->
<div class="stats-bar">
    <div class="stat-item stat-primary">
        <div class="stat-icon-mini"><i class="fas fa-wifi"></i></div>
        <div class="stat-data">
            <span class="stat-number">@(Model.IsActive ? "نشط" : isPendingApproval ? "بانتظار الموافقة" : "متوقف")</span>
            <span class="stat-label">الحالة</span>
        </div>
    </div>
    
    <div class="stat-item stat-warning">
        <div class="stat-icon-mini"><i class="fas fa-users"></i></div>
        <div class="stat-data">
            <span class="stat-number">@Model.UserCount</span>
            <span class="stat-label">مستخدمين</span>
        </div>
    </div>
    
    <div class="stat-item stat-info">
        <div class="stat-icon-mini"><i class="fas fa-broadcast-tower"></i></div>
        <div class="stat-data">
            <span class="stat-number">@(Model.Sector?.Name ?? "غير محدد")</span>
            <span class="stat-label">القطاع</span>
        </div>
    </div>
</div>

<div class="details-grid">
    <!-- Info Card -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-info-circle"></i>
                معلومات المستقبل
            </h3>
        </div>
        <div class="card-body">
            <div class="info-list">
                <div class="info-item">
                    <span class="info-label"><i class="fas fa-tag"></i> اسم المستقبل</span>
                    <span class="info-value"><strong>@Model.Name</strong></span>
                </div>

                <div class="info-item">
                    <span class="info-label"><i class="fas fa-broadcast-tower"></i> القطاع التابع له</span>
                    <span class="info-value">
                        @if (Model.Sector != null)
                        {
                            <a asp-controller="Sector" asp-action="Details" asp-route-id="@Model.Sector.Id" class="badge badge-info">
                                @Model.Sector.Name
                            </a>
                        }
                        else
                        {
                            <span class="text-muted">غير مرتبط</span>
                        }
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label"><i class="fas fa-network-wired"></i> عنوان IP</span>
                    <span class="info-value"><code>@Model.IPAddress</code></span>
                </div>

                <div class="info-item">
                    <span class="info-label"><i class="fas fa-mask"></i> قناع الشبكة</span>
                    <span class="info-value">@Model.NetworkMask</span>
                </div>

                <div class="info-item">
                    <span class="info-label"><i class="fas fa-map-marker-alt"></i> خط العرض</span>
                    <span class="info-value">@Model.Latitude.ToString("F6")</span>
                </div>

                <div class="info-item">
                    <span class="info-label"><i class="fas fa-map-marker-alt"></i> خط الطول</span>
                    <span class="info-value">@Model.Longitude.ToString("F6")</span>
                </div>

                <div class="info-item">
                    <span class="info-label"><i class="fas fa-database"></i> البروفايلات</span>
                    <span class="info-value">
                        @if (!string.IsNullOrEmpty(Model.ProfileNames))
                        {
                            <span class="badge badge-info">@Model.ProfileNames</span>
                        }
                        else
                        {
                            <span class="text-muted">لا يوجد بروفايلات</span>
                        }
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label"><i class="fas fa-users"></i> عدد المستخدمين</span>
                    <span class="info-value">
                        <span class="badge badge-warning">@Model.UserCount مستخدم</span>
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label"><i class="fas fa-calendar-plus"></i> تاريخ الإضافة</span>
                    <span class="info-value">@Model.CreatedDate.ToString("yyyy-MM-dd hh:mm tt")</span>
                </div>

                <div class="info-item">
                    <span class="info-label"><i class="fas fa-toggle-on"></i> الحالة</span>
                    <span class="info-value">
                        @if (Model.IsActive)
                        {
                            <span class="status-badge status-active">
                                <i class="fas fa-check-circle"></i> نشط
                            </span>
                        }
                        else if (isPendingApproval)
                        {
                            <span class="status-badge status-awaiting">
                                <i class="fas fa-hourglass-half"></i> بانتظار موافقة المدير
                            </span>
                        }
                        else
                        {
                            <span class="status-badge status-inactive">
                                <i class="fas fa-times-circle"></i> غير نشط
                            </span>
                        }
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Map Card -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-map-marked-alt"></i>
                موقع المستقبل
            </h3>
        </div>
        <div class="card-body" style="padding: 0;">
            <div id="map"></div>
        </div>
    </div>
</div>

<style>
    .page-header {
        margin-bottom: var(--spacing-lg);
    }
    
    .page-header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--spacing-md);
    }
    
    .page-title {
        font-size: var(--font-2xl);
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }
    
    .page-title i {
        color: var(--info);
    }
    
    .page-actions {
        display: flex;
        gap: var(--spacing-sm);
        flex-wrap: wrap;
    }

    .stats-bar {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-sm);
        padding: var(--spacing-md);
        background: var(--bg-card);
        border-radius: var(--radius);
        box-shadow: var(--shadow-sm);
        margin-bottom: var(--spacing-lg);
    }
    
    .stat-item {
        display: flex;
        align-items: center;
        gap: var(--spacing-xs);
        padding: var(--spacing-xs) var(--spacing-sm);
        border-radius: var(--radius-sm);
        background: var(--bg-hover);
        min-width: 100px;
    }
    
    .stat-icon-mini {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        color: white;
    }
    
    .stat-data {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }
    
    .stat-number {
        font-size: var(--font-lg);
        font-weight: 700;
    }
    
    .stat-label {
        font-size: 11px;
        color: var(--text-muted);
    }
    
    .stat-primary .stat-icon-mini { background: var(--primary); }
    .stat-primary .stat-number { color: var(--primary); }
    .stat-info .stat-icon-mini { background: var(--info); }
    .stat-info .stat-number { color: var(--info); }
    .stat-warning .stat-icon-mini { background: var(--warning); }
    .stat-warning .stat-number { color: var(--warning); }
    .status-awaiting {
        background: rgba(255, 193, 7, 0.22);
        color: #8a6700;
        border: 1px solid rgba(255, 193, 7, 0.4);
    }

    .details-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--spacing-lg);
    }

    #map {
        width: 100%;
        height: 400px;
    }

    .info-list {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--spacing-sm);
        background: var(--bg-hover);
        border-radius: var(--radius-sm);
    }

    .info-label {
        font-size: var(--font-sm);
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: var(--spacing-xs);
    }

    .info-label i {
        width: 16px;
        text-align: center;
        color: var(--primary);
    }

    .info-value {
        font-size: var(--font-sm);
    }

    @@media (max-width: 992px) {
        .details-grid {
            grid-template-columns: 1fr;
        }

        #map {
            height: 300px;
        }
    }
</style>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var lat = @Model.Latitude;
            var lng = @Model.Longitude;

            var map = L.map('map').setView([lat, lng], 15);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap'
            }).addTo(map);

            var receiverIcon = L.AwesomeMarkers.icon({
                icon: 'wifi',
                markerColor: '@(Model.IsActive ? "green" : "red")',
                prefix: 'fa',
                iconColor: 'white'
            });

            L.marker([lat, lng], {icon: receiverIcon}).addTo(map)
                .bindPopup('<strong>@Model.Name</strong><br>IP: @Model.IPAddress')
                .openPopup();

            @if (Model.Sector != null)
            {
                @:var sectorIcon = L.AwesomeMarkers.icon({
                @:    icon: 'broadcast-tower',
                @:    markerColor: 'blue',
                @:    prefix: 'fa',
                @:    iconColor: 'white'
                @:});
                @:
                @:L.marker([@Model.Sector.Latitude, @Model.Sector.Longitude], {icon: sectorIcon}).addTo(map)
                @:    .bindPopup('<strong>@Model.Sector.Name</strong><br>القطاع');
                @:
                @:L.polyline([[lat, lng], [@Model.Sector.Latitude, @Model.Sector.Longitude]], {
                @:    color: '#007bff',
                @:    weight: 2,
                @:    dashArray: '5, 10'
                @:}).addTo(map);
            }
        });
    </script>
}
