@model RadTik.Models.Receiver

@{
    ViewData["Title"] = "حذف المستقبل";
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="fas fa-trash-alt"></i>
            @ViewData["Title"]
        </h1>
        <div class="page-actions">
            <a asp-action="Index" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-right"></i> إلغاء والعودة
            </a>
        </div>
    </div>
</div>

<div class="delete-container">
    <!-- Warning Alert -->
    <div class="alert alert-danger">
        <div class="alert-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </div>
        <div class="alert-content">
            <h4>تنبيه مهم!</h4>
            <p>هل أنت متأكد من رغبتك في حذف هذا المستقبل؟</p>
            <p class="mb-0"><strong>سيتم حذف جميع العملاء المرتبطين بهذا المستقبل أيضاً!</strong></p>
        </div>
    </div>

    <div class="card">
        <div class="card-header card-header-danger">
            <h3 class="card-title">
                <i class="fas fa-wifi"></i>
                بيانات المستقبل
            </h3>
        </div>
        <div class="card-body">
            <div class="info-list">
                <div class="info-item">
                    <span class="info-label"><i class="fas fa-tag"></i> اسم المستقبل</span>
                    <span class="info-value"><strong>@Model.Name</strong></span>
                </div>

                <div class="info-item">
                    <span class="info-label"><i class="fas fa-broadcast-tower"></i> القطاع</span>
                    <span class="info-value">
                        @if (Model.Sector != null)
                        {
                            <span>@Model.Sector.Name</span>
                        }
                        else
                        {
                            <span class="text-muted">غير مرتبط</span>
                        }
                    </span>
                </div>

                <div class="info-item">
                    <span class="info-label"><i class="fas fa-network-wired"></i> عنوان IP</span>
                    <span class="info-value"><code>@Model.IPAddress</code></span>
                </div>

                <div class="info-item">
                    <span class="info-label"><i class="fas fa-mask"></i> قناع الشبكة</span>
                    <span class="info-value">@Model.NetworkMask</span>
                </div>

                <div class="info-item">
                    <span class="info-label"><i class="fas fa-map-marker-alt"></i> الموقع</span>
                    <span class="info-value">@Model.Latitude.ToString("F6"), @Model.Longitude.ToString("F6")</span>
                </div>
            </div>

            <!-- Warning Stats -->
            <div class="delete-stats">
                <div class="delete-stat stat-danger">
                    <div class="stat-icon"><i class="fas fa-users"></i></div>
                    <div class="stat-info">
                        <span class="stat-value">@Model.UserCount</span>
                        <span class="stat-label">مستخدم سيتم حذفه</span>
                    </div>
                </div>

                <div class="delete-stat">
                    <div class="stat-icon"><i class="fas fa-toggle-@(Model.IsActive ? "on" : "off")"></i></div>
                    <div class="stat-info">
                        <span class="stat-value">@(Model.IsActive ? "نشط" : "غير نشط")</span>
                        <span class="stat-label">الحالة الحالية</span>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(Model.ProfileNames))
            {
                <div class="info-item" style="margin-top: var(--spacing-md);">
                    <span class="info-label"><i class="fas fa-database"></i> البروفايلات</span>
                    <span class="info-value"><span class="badge badge-info">@Model.ProfileNames</span></span>
                </div>
            }
        </div>
    </div>

    <!-- Delete Form -->
    <form asp-action="Delete" class="delete-form">
        <input type="hidden" asp-for="Id" />
        <div class="form-actions">
            <button type="submit" class="btn btn-danger btn-lg">
                <i class="fas fa-trash"></i> تأكيد الحذف
            </button>
            <a asp-action="Index" class="btn btn-secondary btn-lg">
                <i class="fas fa-times"></i> إلغاء والعودة
            </a>
        </div>
    </form>
</div>

<style>
    .page-header {
        margin-bottom: var(--spacing-lg);
    }
    
    .page-header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .page-title {
        font-size: var(--font-2xl);
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }
    
    .page-title i {
        color: var(--danger);
    }

    .delete-container {
        max-width: 700px;
        margin: 0 auto;
    }

    .alert-danger {
        display: flex;
        align-items: flex-start;
        gap: var(--spacing-md);
        padding: var(--spacing-lg);
        background: rgba(220, 53, 69, 0.1);
        border: 1px solid var(--danger);
        border-radius: var(--radius);
        margin-bottom: var(--spacing-lg);
    }

    .alert-icon {
        font-size: 2.5rem;
        color: var(--danger);
        animation: pulse-danger 2s infinite;
    }

    @@keyframes pulse-danger {
        0%, 100% { opacity: 1; }
        50% { opacity: 0.5; }
    }

    .alert-content h4 {
        margin: 0 0 var(--spacing-xs) 0;
        color: var(--danger);
    }

    .alert-content p {
        margin: var(--spacing-xs) 0;
        color: var(--text-primary);
    }

    .card-header-danger {
        background: linear-gradient(135deg, var(--danger), #c82333) !important;
        color: white !important;
    }

    .info-list {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--spacing-sm);
        background: var(--bg-hover);
        border-radius: var(--radius-sm);
    }

    .info-label {
        font-size: var(--font-sm);
        color: var(--text-muted);
        display: flex;
        align-items: center;
        gap: var(--spacing-xs);
    }

    .info-label i {
        width: 16px;
        text-align: center;
        color: var(--danger);
    }

    .info-value {
        font-size: var(--font-sm);
    }

    .delete-stats {
        display: flex;
        gap: var(--spacing-md);
        margin-top: var(--spacing-lg);
        padding-top: var(--spacing-lg);
        border-top: 1px solid var(--border-light);
    }

    .delete-stat {
        flex: 1;
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
        padding: var(--spacing-md);
        background: var(--bg-hover);
        border-radius: var(--radius-sm);
    }

    .delete-stat.stat-danger {
        background: rgba(220, 53, 69, 0.1);
        border: 1px solid rgba(220, 53, 69, 0.3);
    }

    .delete-stat .stat-icon {
        font-size: 1.5rem;
        color: var(--text-muted);
    }

    .delete-stat.stat-danger .stat-icon {
        color: var(--danger);
    }

    .delete-stat .stat-info {
        display: flex;
        flex-direction: column;
    }

    .delete-stat .stat-value {
        font-size: var(--font-xl);
        font-weight: 700;
    }

    .delete-stat.stat-danger .stat-value {
        color: var(--danger);
    }

    .delete-stat .stat-label {
        font-size: 11px;
        color: var(--text-muted);
    }

    .delete-form {
        margin-top: var(--spacing-xl);
        padding-top: var(--spacing-lg);
        border-top: 1px solid var(--border-light);
    }

    .form-actions {
        display: flex;
        gap: var(--spacing-sm);
        justify-content: center;
    }

    .btn-lg {
        padding: var(--spacing-md) var(--spacing-xl);
        font-size: var(--font-lg);
    }

    @@media (max-width: 768px) {
        .delete-stats {
            flex-direction: column;
        }

        .form-actions {
            flex-direction: column;
        }
    }
</style>
