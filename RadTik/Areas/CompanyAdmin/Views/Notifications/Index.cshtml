@model IEnumerable<RadTik.Models.UserNotification>
@{
    ViewData["Title"] = ViewData["Title"] ?? "التنبيهات";
    ViewData["BodyClass"] = "notifications-page";
    var unreadOnly = (bool?)ViewBag.UnreadOnly ?? true;
}

<div class="page-header notifications-header">
    <h1>
        <i class="fas fa-bell"></i>
        @ViewData["Title"]
    </h1>
    <p class="text-muted mb-0">تنبيهات تشغيلية لمتابعة الأنشطة اليومية والخدمات المتاحة.</p>
</div>

<div class="d-flex gap-2 mb-3">
    <a class="btn btn-sm @(unreadOnly ? "btn-primary" : "btn-outline-primary")"
       asp-route="networkManager-notifications" asp-route-unreadOnly="true">
        غير مقروءة
    </a>
    <a class="btn btn-sm @(!unreadOnly ? "btn-primary" : "btn-outline-primary")"
       asp-route="networkManager-notifications" asp-route-unreadOnly="false">
        الكل
    </a>
</div>

<div class="card">
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            <div class="notifications-list d-flex flex-column gap-3">
                @foreach (var n in Model)
                {
                    var isUnread = !n.IsRead;
                    var typeBadgeClass = "bg-secondary";
                    var typeBadgeText = "إشعار عام";

                    switch (n.Type)
                    {
                        case RadTik.Models.NotificationType.SubscriptionExpiring:
                            typeBadgeClass = "bg-warning text-dark";
                            typeBadgeText = "متابعة خدمة";
                            break;
                        case RadTik.Models.NotificationType.MaintenanceRequestSubmitted:
                            typeBadgeClass = "bg-info text-dark";
                            typeBadgeText = "طلب صيانة";
                            break;
                        case RadTik.Models.NotificationType.SpeedChangeRequestSubmitted:
                            typeBadgeClass = "bg-primary";
                            typeBadgeText = "طلب تعديل سرعة";
                            break;
                        case RadTik.Models.NotificationType.ClientTopUpSubmitted:
                            typeBadgeClass = "bg-success";
                            typeBadgeText = "تغذية رصيد مشترك";
                            break;
                        case RadTik.Models.NotificationType.CollectionPointTopUpRequestSubmitted:
                            typeBadgeClass = "bg-success";
                            typeBadgeText = "طلب تغذية نقطة تحصيل";
                            break;
                        case RadTik.Models.NotificationType.ClientWalletTopUpRequestSubmitted:
                            typeBadgeClass = "bg-success";
                            typeBadgeText = "طلب تغذية من مشترك";
                            break;
                    }

                    <div class="notification-item border rounded-3 p-3 @(isUnread ? "bg-light" : "bg-white") shadow-sm-sm">
                        <div class="d-flex justify-content-between align-items-start gap-3">
                            <div class="d-flex gap-2 align-items-start flex-grow-1">
                                <div class="mt-1">
                                    <span class="notification-status-icon d-inline-flex align-items-center justify-content-center rounded-circle @(isUnread ? "bg-primary text-white" : "bg-success text-white")" style="width:32px;height:32px;">
                                        <i class="fas @(isUnread ? "fa-bell" : "fa-circle-check")"></i>
                                    </span>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                        <a asp-area="CompanyAdmin"
                                           asp-controller="Notifications"
                                           asp-action="Open"
                                           asp-route-id="@n.Id"
                                           class="notification-open-link @(isUnread ? "fw-bold mark-as-read-trigger" : "") text-decoration-none text-body">
                                            @n.Title
                                        </a>
                                        <span class="badge @typeBadgeClass">@typeBadgeText</span>
                                        @if (isUnread)
                                        {
                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">غير مقروء</span>
                                        }
                                    </div>
                                    <div class="text-muted small mb-1">
                                        @n.Message
                                    </div>
                                    <div class="text-muted small d-flex flex-wrap gap-3 align-items-center">
                                        <span>
                                            <i class="far fa-clock"></i>
                                            @n.CreatedAt.ToString("yyyy/MM/dd HH:mm")
                                        </span>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex flex-column gap-2 text-nowrap">
                                <a asp-area="CompanyAdmin"
                                   asp-controller="Notifications"
                                   asp-action="Open"
                                   asp-route-id="@n.Id"
                                   class="btn btn-sm btn-outline-primary">
                                    الانتقال للعمل المطلوب
                                </a>
                                @if (isUnread)
                                {
                                    <form method="post"
                                          asp-area="CompanyAdmin"
                                          asp-controller="Notifications"
                                          asp-action="MarkRead"
                                          class="mark-read-form">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@n.Id" />
                                        <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                        <button type="submit" class="btn btn-sm btn-link text-success p-0">
                                            تعليم كمقروء
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <span class="badge bg-secondary align-self-start">مقروء</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center text-muted py-4">
                <i class="far fa-bell-slash fa-2x mb-2"></i>
                <div>لا توجد تنبيهات حالياً</div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            function updateNotificationsBadgeImmediately() {
                var badge = document.getElementById('notificationsUnreadBadge');
                if (!badge || badge.style.display === 'none') return;

                var current = parseInt((badge.textContent || '0').replace('+', ''), 10);
                if (isNaN(current) || current <= 0) return;

                var next = current - 1;
                if (next <= 0) {
                    badge.textContent = '0';
                    badge.style.display = 'none';
                } else {
                    badge.textContent = next > 99 ? '99+' : String(next);
                    badge.style.display = 'inline-flex';
                }
            }

            document.querySelectorAll('.mark-read-form').forEach(function (form) {
                form.addEventListener('submit', function () {
                    updateNotificationsBadgeImmediately();
                });
            });

            document.querySelectorAll('.mark-as-read-trigger').forEach(function (link) {
                link.addEventListener('click', function () {
                    updateNotificationsBadgeImmediately();
                });
            });
        })();
    </script>
}

