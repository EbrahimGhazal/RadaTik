@model RadTik.Models.Sector

@{
    ViewData["Title"] = "تعديل القطاع";
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="fas fa-edit"></i>
            @ViewData["Title"]: @Model.Name
        </h1>
        <div class="page-actions">
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info btn-sm">
                <i class="fas fa-eye"></i> عرض التفاصيل
            </a>
            <a asp-action="Index" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-right"></i> رجوع للقائمة
            </a>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header card-header-warning">
        <h3 class="card-title">
            <i class="fas fa-broadcast-tower"></i>
            تعديل بيانات القطاع
        </h3>
    </div>
    <div class="card-body">
        <form asp-action="Edit" id="sectorForm">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="Id" />

            <div class="form-grid">
                <!-- القسم الأول: المعلومات الأساسية -->
                <div class="form-section">
                    <h4 class="form-section-title">
                        <i class="fas fa-info-circle"></i> المعلومات الأساسية
                    </h4>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Name" class="form-label required">اسم القطاع</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="MikroTikServerId" class="form-label required">خادم MikroTik</label>
                            <select asp-for="MikroTikServerId" class="form-control" asp-items="ViewBag.MikroTikServers" id="mikroTikSelect">
                                <option value="">-- اختر خادم --</option>
                            </select>
                            <span asp-validation-for="MikroTikServerId" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="IPAddress" class="form-label required">عنوان IP</label>
                            <div class="input-with-btn">
                                <input asp-for="IPAddress" class="form-control" id="ipAddressInput" />
                                <button type="button" class="btn btn-secondary" id="btnGenerateIP" title="توليد IP تلقائي">
                                    <i class="fas fa-sync-alt"></i>
                                </button>
                            </div>
                            <span asp-validation-for="IPAddress" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="NetworkMask" class="form-label">قناع الشبكة</label>
                            <input asp-for="NetworkMask" class="form-control" />
                            <span asp-validation-for="NetworkMask" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="RadioInterfaceName" class="form-label">واجهة المراقبة الراديوية</label>
                            <input asp-for="RadioInterfaceName" class="form-control" placeholder="wlan1 (اختياري)" />
                            <span asp-validation-for="RadioInterfaceName" class="text-danger"></span>
                            <small class="form-hint">تُستخدم كمصدر mapping مباشر لقراءة القياسات.</small>
                        </div>
                        <div class="form-group">
                            <label class="form-label">عتبات التنبيه</label>
                            <div class="row g-2">
                                <div class="col-4">
                                    <input asp-for="NoiseAlertThresholdDbm" class="form-control" type="number" placeholder="-90" />
                                    <small class="form-hint">Noise dBm</small>
                                </div>
                                <div class="col-4">
                                    <input asp-for="SnrAlertMinDb" class="form-control" type="number" placeholder="20" />
                                    <small class="form-hint">SNR dB</small>
                                </div>
                                <div class="col-4">
                                    <input asp-for="CcqAlertMinPercent" class="form-control" type="number" placeholder="70" />
                                    <small class="form-hint">CCQ %</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- القسم الثاني: الموقع والتغطية -->
                <div class="form-section">
                    <h4 class="form-section-title">
                        <i class="fas fa-map-marked-alt"></i> الموقع ونطاق التغطية
                    </h4>
                    
                    <div class="map-container-form">
                        <div id="map"></div>
                        <div class="map-controls-overlay">
                            <div class="map-type-controls">
                                <button type="button" class="map-type-btn active" data-map-type="streets">شوارع</button>
                                <button type="button" class="map-type-btn" data-map-type="satellite">قمر صناعي</button>
                                <button type="button" class="map-type-btn" data-map-type="terrain">تضاريس</button>
                            </div>
                        </div>
                        <div class="coverage-legend">
                            <div class="legend-title">مفتاح التغطية</div>
                            <div class="legend-item"><span class="legend-color" style="background: #00ff00;"></span> ممتازة</div>
                            <div class="legend-item"><span class="legend-color" style="background: #ffff00;"></span> جيدة</div>
                            <div class="legend-item"><span class="legend-color" style="background: #ff0000;"></span> ضعيفة</div>
                        </div>
                    </div>
                    <small class="form-hint">انقر على الخريطة لتحديد موقع القطاع</small>

                    <div class="form-row form-row-3">
                        <div class="form-group">
                            <label asp-for="Latitude" class="form-label">خط العرض</label>
                            <input asp-for="Latitude" class="form-control" id="latitudeInput" type="number" step="0.000001" />
                            <span asp-validation-for="Latitude" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="Longitude" class="form-label">خط الطول</label>
                            <input asp-for="Longitude" class="form-control" id="longitudeInput" type="number" step="0.000001" />
                            <span asp-validation-for="Longitude" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="Direction" class="form-label">الاتجاه</label>
                            <div class="input-with-addon">
                                <input asp-for="Direction" class="form-control" id="directionInput" type="number" min="0" max="360" step="1" />
                                <span class="input-addon">°</span>
                            </div>
                            <span asp-validation-for="Direction" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-row form-row-3">
                        <div class="form-group">
                            <label asp-for="AntennaHeightAglMeters" class="form-label">الارتفاع عن سطح الأرض</label>
                            <div class="input-with-addon">
                                <input asp-for="AntennaHeightAglMeters"
                                       class="form-control"
                                       id="antennaHeightAglInput"
                                       type="number"
                                       min="0"
                                       max="500"
                                       step="0.01"
                                       placeholder="مثال: 6" />
                                <span class="input-addon">م</span>
                            </div>
                            <small class="form-hint">ارتفاع الهوائي فوق سطح الأرض (AGL).</small>
                            <span asp-validation-for="AntennaHeightAglMeters" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="CoverageAngle" class="form-label">زاوية الانتشار</label>
                            <div class="input-with-addon">
                                <input asp-for="CoverageAngle" class="form-control" id="angleInput" type="number" min="1" max="360" step="1" />
                                <span class="input-addon">°</span>
                            </div>
                            <span asp-validation-for="CoverageAngle" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="CoverageRange" class="form-label">مدى الانتشار</label>
                            <div class="input-with-addon">
                                <input asp-for="CoverageRange" class="form-control" id="rangeInput" type="number" min="0.1" step="0.1" />
                                <span class="input-addon">كم</span>
                            </div>
                            <span asp-validation-for="CoverageRange" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <!-- القسم الثالث: الحالة -->
                <div class="form-section">
                    <div class="form-check-wrapper">
                        <input asp-for="IsActive" class="form-check-input" id="isActiveCheck" />
                        <label asp-for="IsActive" class="form-check-label" for="isActiveCheck">
                            <span class="check-text">تفعيل القطاع</span>
                            <small class="check-hint">القطاع سيكون نشطاً ويمكن إضافة مستقبلات له</small>
                        </label>
                    </div>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-warning">
                    <i class="fas fa-save"></i> حفظ التعديلات
                </button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info">
                    <i class="fas fa-eye"></i> عرض التفاصيل
                </a>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-times"></i> إلغاء
                </a>
            </div>
        </form>
    </div>
</div>

<style>
    .page-header {
        margin-bottom: var(--spacing-lg);
    }
    
    .page-header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--spacing-md);
    }
    
    .page-title {
        font-size: var(--font-2xl);
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }
    
    .page-title i {
        color: var(--warning);
    }

    .page-actions {
        display: flex;
        gap: var(--spacing-sm);
    }
    
    .card-header-warning {
        background: linear-gradient(135deg, var(--warning), #f57c00) !important;
        color: white !important;
    }

    .form-grid {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xl);
    }

    .form-section {
        background: var(--bg-hover);
        padding: var(--spacing-lg);
        border-radius: var(--radius);
    }

    .form-section-title {
        font-size: var(--font-lg);
        font-weight: 600;
        margin-bottom: var(--spacing-lg);
        padding-bottom: var(--spacing-sm);
        border-bottom: 2px solid var(--warning);
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .form-section-title i {
        color: var(--warning);
    }

    .form-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--spacing-lg);
        margin-bottom: var(--spacing-md);
    }

    .form-row-3 {
        grid-template-columns: repeat(3, 1fr);
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
    }

    .form-label {
        font-weight: 500;
        font-size: var(--font-sm);
        color: var(--text-secondary);
    }

    .form-label.required::after {
        content: ' *';
        color: var(--danger);
    }

    .form-hint {
        font-size: 11px;
        color: var(--text-muted);
    }

    .input-with-btn {
        display: flex;
        gap: var(--spacing-xs);
    }

    .input-with-btn .form-control {
        flex: 1;
    }

    .input-with-addon {
        display: flex;
        align-items: stretch;
    }

    .input-with-addon .form-control {
        border-radius: var(--radius-sm) 0 0 var(--radius-sm);
    }

    .input-addon {
        display: flex;
        align-items: center;
        padding: 0 12px;
        background: var(--bg-hover);
        border: 1px solid var(--border-light);
        border-right: none;
        border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
        font-size: var(--font-sm);
        color: var(--text-muted);
    }

    .map-container-form {
        position: relative;
        height: 350px;
        border-radius: var(--radius);
        overflow: hidden;
        margin-bottom: var(--spacing-md);
    }

    .map-container-form #map {
        width: 100%;
        height: 100%;
    }

    .map-controls-overlay {
        position: absolute;
        top: 10px;
        right: 10px;
        z-index: 1000;
    }

    .map-type-controls {
        display: flex;
        gap: 2px;
        background: var(--bg-card);
        border-radius: var(--radius-sm);
        padding: 2px;
        box-shadow: var(--shadow-md);
    }

    .map-type-btn {
        padding: 4px 10px;
        border: none;
        background: transparent;
        border-radius: var(--radius-sm);
        font-size: var(--font-xs);
        cursor: pointer;
        transition: all 0.2s;
        color: var(--text-secondary);
    }

    .map-type-btn:hover {
        background: var(--bg-hover);
    }

    .map-type-btn.active {
        background: var(--primary);
        color: white;
    }

    .coverage-legend {
        position: absolute;
        bottom: 10px;
        right: 10px;
        background: var(--bg-card);
        padding: var(--spacing-sm);
        border-radius: var(--radius-sm);
        box-shadow: var(--shadow-md);
        z-index: 1000;
        font-size: var(--font-xs);
    }

    .legend-title {
        font-weight: 600;
        margin-bottom: 6px;
        padding-bottom: 4px;
        border-bottom: 1px solid var(--border-light);
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 4px;
    }

    .legend-color {
        width: 12px;
        height: 12px;
        border-radius: 3px;
    }

    .form-check-wrapper {
        display: flex;
        align-items: flex-start;
        gap: var(--spacing-sm);
        padding: var(--spacing-md);
        background: var(--bg-card);
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-light);
    }

    .form-check-input {
        width: 20px;
        height: 20px;
        margin-top: 2px;
        cursor: pointer;
    }

    .form-check-label {
        cursor: pointer;
    }

    .check-text {
        display: block;
        font-weight: 600;
        margin-bottom: 2px;
    }

    .check-hint {
        display: block;
        font-size: 12px;
        color: var(--text-muted);
    }

    .form-actions {
        display: flex;
        gap: var(--spacing-sm);
        margin-top: var(--spacing-xl);
        padding-top: var(--spacing-lg);
        border-top: 1px solid var(--border-light);
    }

    @@media (max-width: 768px) {
        .form-row,
        .form-row-3 {
            grid-template-columns: 1fr;
        }

        .map-container-form {
            height: 250px;
        }
    }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            initializeMap();

            document.getElementById('mikroTikSelect').addEventListener('change', function() {
                generateIPForMikroTik(this.value);
            });

            document.getElementById('btnGenerateIP').addEventListener('click', function() {
                var mikrotikId = document.getElementById('mikroTikSelect').value;
                if (mikrotikId) {
                    generateIPForMikroTik(mikrotikId);
                } else {
                    alert('يرجى اختيار خادم MikroTik أولاً');
                }
            });
        });

        function generateIPForMikroTik(mikrotikId) {
            if (!mikrotikId) return;

            var btn = document.getElementById('btnGenerateIP');
            var originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            btn.disabled = true;

            fetch(`/Sector/GetNextIP?mikrotikServerId=${mikrotikId}&currentIP=@Model.IPAddress`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('ipAddressInput').value = data.nextIP;
                    } else {
                        alert('حدث خطأ في توليد IP: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('حدث خطأ في الاتصال بالخادم');
                })
                .finally(() => {
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                });
        }

        function initializeMap() {
            var defaultLat = 35.5200;
            var defaultLng = 35.7800;
            var currentLat = @(Model.Latitude != 0 ? Model.Latitude : "defaultLat");
            var currentLng = @(Model.Longitude != 0 ? Model.Longitude : "defaultLng");
            var currentDirection = @Model.Direction;
            var currentAngle = @Model.CoverageAngle;
            var currentRange = @Model.CoverageRange;

            try {
                var map = L.map('map').setView([currentLat, currentLng], 15);

                var streetLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenStreetMap',
                    maxZoom: 19
                });

                var satelliteLayer = L.tileLayer('https://{s}.google.com/vt/lyrs=s&x={x}&y={y}&z={z}', {
                    maxZoom: 20,
                    subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
                });

                var terrainLayer = L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', {
                    maxZoom: 17
                });

                streetLayer.addTo(map);

                var wifiIcon = L.AwesomeMarkers.icon({
                    icon: 'wifi',
                    markerColor: 'blue',
                    prefix: 'fa',
                    iconColor: 'white'
                });

                var marker = null;
                var coverageLayers = [];

                marker = L.marker([currentLat, currentLng], {icon: wifiIcon}).addTo(map)
                    .bindPopup('موقع القطاع - @Model.Name')
                    .openPopup();

                drawCoverageArea(currentLat, currentLng);

                map.on('click', function(e) {
                    var lat = e.latlng.lat;
                    var lng = e.latlng.lng;

                    document.getElementById('latitudeInput').value = lat.toFixed(6);
                    document.getElementById('longitudeInput').value = lng.toFixed(6);

                    if (marker) map.removeLayer(marker);
                    clearCoverageLayers();

                    marker = L.marker([lat, lng], {icon: wifiIcon}).addTo(map)
                        .bindPopup('موقع القطاع - @Model.Name')
                        .openPopup();

                    drawCoverageArea(lat, lng);
                });

                document.querySelectorAll('.map-type-btn').forEach(button => {
                    button.addEventListener('click', function() {
                        document.querySelectorAll('.map-type-btn').forEach(btn => btn.classList.remove('active'));
                        this.classList.add('active');
                        changeMapType(this.getAttribute('data-map-type'));
                    });
                });

                function changeMapType(type) {
                    map.removeLayer(streetLayer);
                    map.removeLayer(satelliteLayer);
                    map.removeLayer(terrainLayer);

                    switch(type) {
                        case 'satellite': satelliteLayer.addTo(map); break;
                        case 'terrain': terrainLayer.addTo(map); break;
                        default: streetLayer.addTo(map);
                    }
                }

                ['directionInput', 'angleInput', 'rangeInput', 'latitudeInput', 'longitudeInput'].forEach(id => {
                    document.getElementById(id).addEventListener('input', updateCoverageArea);
                });

                function updateCoverageArea() {
                    var lat = parseFloat(document.getElementById('latitudeInput').value);
                    var lng = parseFloat(document.getElementById('longitudeInput').value);

                    if (!isNaN(lat) && !isNaN(lng)) {
                        if (marker) map.removeLayer(marker);
                        marker = L.marker([lat, lng], {icon: wifiIcon}).addTo(map);
                        clearCoverageLayers();
                        drawCoverageArea(lat, lng);
                    }
                }

                function clearCoverageLayers() {
                    coverageLayers.forEach(layer => {
                        if (layer && map.hasLayer(layer)) map.removeLayer(layer);
                    });
                    coverageLayers = [];
                }

                function drawCoverageArea(lat, lng) {
                    var direction = parseFloat(document.getElementById('directionInput').value) || 0;
                    var angle = parseFloat(document.getElementById('angleInput').value) || 60;
                    var range = parseFloat(document.getElementById('rangeInput').value) || 5;

                    var layersCount = 10;
                    var startAngleRad = (direction - angle/2) * Math.PI / 180;
                    var endAngleRad = (direction + angle/2) * Math.PI / 180;

                    for (var i = 0; i < layersCount; i++) {
                        var innerRadius = (i / layersCount) * range * 1000;
                        var outerRadius = ((i + 1) / layersCount) * range * 1000;

                        var colorRatio = i / (layersCount - 1);
                        var color = 'rgb(' + Math.floor(255 * colorRatio) + ',' + Math.floor(255 * (1 - colorRatio)) + ',0)';

                        var sector = createSector([lat, lng], innerRadius, outerRadius, startAngleRad, endAngleRad, color);
                        coverageLayers.push(sector);
                        sector.addTo(map);
                    }
                }

                function createSector(center, innerRadius, outerRadius, startAngle, endAngle, color) {
                    var points = [];
                    for (var i = 0; i <= 20; i++) {
                        var angle = startAngle + (endAngle - startAngle) * i / 20;
                        points.push(calculatePoint(center, innerRadius, angle));
                    }
                    for (var i = 20; i >= 0; i--) {
                        var angle = startAngle + (endAngle - startAngle) * i / 20;
                        points.push(calculatePoint(center, outerRadius, angle));
                    }
                    points.push(points[0]);
                    return L.polygon(points, { color: color, fillColor: color, fillOpacity: 0.3, weight: 1 });
                }

                /** 0 = الشمال، باتجاه عقارب الساعة — يطابق خريطة لوحة التحكم */
                function calculatePoint(center, radius, bearingRad) {
                    var lat = center[0] + (radius / 111320) * Math.cos(bearingRad);
                    var lng = center[1] + (radius / (111320 * Math.cos(center[0] * Math.PI / 180))) * Math.sin(bearingRad);
                    return [lat, lng];
                }

            } catch (error) {
                console.error('حدث خطأ في تهيئة الخريطة:', error);
                document.getElementById('map').innerHTML =
                    '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--text-muted);">' +
                    '<i class="fas fa-exclamation-triangle" style="margin-left:10px;"></i> خطأ في تحميل الخريطة</div>';
            }
        }
    </script>
}
