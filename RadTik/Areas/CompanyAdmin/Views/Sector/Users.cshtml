@model IEnumerable<RadTik.Models.Client>

@{
    ViewData["Title"] = "المستخدمين التابعين للقطاع";
    var totalUsers = Model.Count();
    var activeUsers = Model.Count(u => u.IsActive);
    var connectedUsers = Model.Count(u => u.ConnectionStatus == "نشط");
    int totalDataSize = 0;
    foreach (var user in Model)
    {
        if (!string.IsNullOrEmpty(user.ProfileName))
        {
            var match = System.Text.RegularExpressions.Regex.Match(user.ProfileName, @"\d+");
            if (match.Success && int.TryParse(match.Value, out int size))
            {
                totalDataSize += size;
            }
        }
    }
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="fas fa-users"></i>
            مستخدمين القطاع: @ViewBag.SectorName
        </h1>
        <div class="page-actions">
            <a asp-action="Index" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-right"></i> العودة للقطاعات
            </a>
        </div>
    </div>
</div>

<!-- Compact Statistics Bar -->
<div class="stats-bar">
    <div class="stat-item stat-primary">
        <div class="stat-icon-mini"><i class="fas fa-users"></i></div>
        <div class="stat-data">
            <span class="stat-number">@totalUsers</span>
            <span class="stat-label">إجمالي</span>
        </div>
    </div>
    
    <div class="stat-item stat-success">
        <div class="stat-icon-mini"><i class="fas fa-check-circle"></i></div>
        <div class="stat-data">
            <span class="stat-number">@activeUsers</span>
            <span class="stat-label">مفعلين</span>
        </div>
    </div>
    
    <div class="stat-item stat-info">
        <div class="stat-icon-mini"><i class="fas fa-database"></i></div>
        <div class="stat-data">
            <span class="stat-number">@totalDataSize</span>
            <span class="stat-label">ميجا</span>
        </div>
    </div>
    
    <div class="stat-item stat-warning">
        <div class="stat-icon-mini"><i class="fas fa-plug"></i></div>
        <div class="stat-data">
            <span class="stat-number">@connectedUsers</span>
            <span class="stat-label">متصلين</span>
        </div>
    </div>
</div>

<!-- Users Table -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-list"></i>
            قائمة المستخدمين
        </h3>
        <span class="badge badge-warning">@totalUsers مستخدم</span>
    </div>
    <div class="card-body" style="padding: 0;">
        @if (Model.Any())
        {
            <div class="table-container">
                <table class="table" id="usersTable">
                    <thead>
                        <tr>
                            <th>المستخدم</th>
                            <th>الاسم الثلاثي</th>
                            <th>الهاتف</th>
                            <th>البروفايل</th>
                            <th>العنوان</th>
                            <th>حالة الاتصال</th>
                            <th>تاريخ الإضافة</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="user-info">
                                        <div class="user-avatar @(item.IsActive ? "active" : "inactive")">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <div>
                                            <div class="user-name">@item.UserName</div>
                                        </div>
                                    </div>
                                </td>
                                <td>@item.Name</td>
                                <td>
                                    <span class="phone-number">
                                        <i class="fas fa-phone text-success"></i>
                                        @item.PhoneNumber
                                    </span>
                                </td>
                                <td>
                                    <span class="badge badge-info">
                                        <i class="fas fa-database"></i> @item.ProfileName
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(item.Address))
                                    {
                                        <code>@item.Address</code>
                                    }
                                    else
                                    {
                                        <span class="text-muted">غير محدد</span>
                                    }
                                </td>
                                <td>
                                    @if (item.ConnectionStatus == "نشط")
                                    {
                                        <span class="connection-badge connection-active">
                                            <i class="fas fa-plug"></i> متصل
                                        </span>
                                    }
                                    else if (item.ConnectionStatus == "معطل")
                                    {
                                        <span class="connection-badge connection-disabled">
                                            <i class="fas fa-ban"></i> معطل
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="connection-badge connection-unknown">
                                            <i class="fas fa-question-circle"></i> غير معروف
                                        </span>
                                    }
                                </td>
                                <td>
                                    <div class="date-info">
                                        <span>@item.CreatedDate.ToString("yyyy-MM-dd")</span>
                                        <small class="text-muted">@item.CreatedDate.ToString("hh:mm tt")</small>
                                    </div>
                                </td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="status-badge status-active">
                                            <i class="fas fa-check-circle"></i> مفعل
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge status-inactive">
                                            <i class="fas fa-times-circle"></i> معطل
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-users"></i>
                <h4>لا يوجد مستخدمين</h4>
                <p>لم يتم إضافة أي مستخدمين للقطاع بعد</p>
            </div>
        }
    </div>
</div>

<style>
    .page-header {
        margin-bottom: var(--spacing-lg);
    }
    
    .page-header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--spacing-md);
    }
    
    .page-title {
        font-size: var(--font-2xl);
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }
    
    .page-title i {
        color: var(--warning);
    }

    .stats-bar {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-sm);
        padding: var(--spacing-md);
        background: var(--bg-card);
        border-radius: var(--radius);
        box-shadow: var(--shadow-sm);
        margin-bottom: var(--spacing-lg);
    }
    
    .stat-item {
        display: flex;
        align-items: center;
        gap: var(--spacing-xs);
        padding: var(--spacing-xs) var(--spacing-sm);
        border-radius: var(--radius-sm);
        background: var(--bg-hover);
        min-width: 100px;
    }
    
    .stat-icon-mini {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        color: white;
    }
    
    .stat-data {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }
    
    .stat-number {
        font-size: var(--font-xl);
        font-weight: 700;
    }
    
    .stat-label {
        font-size: 11px;
        color: var(--text-muted);
    }
    
    .stat-primary .stat-icon-mini { background: var(--primary); }
    .stat-primary .stat-number { color: var(--primary); }
    .stat-success .stat-icon-mini { background: var(--success); }
    .stat-success .stat-number { color: var(--success); }
    .stat-info .stat-icon-mini { background: var(--info); }
    .stat-info .stat-number { color: var(--info); }
    .stat-warning .stat-icon-mini { background: var(--warning); }
    .stat-warning .stat-number { color: var(--warning); }

    .user-info {
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .user-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
    }

    .user-avatar.active { background: var(--primary); }
    .user-avatar.inactive { background: var(--text-muted); }

    .user-name {
        font-weight: 600;
        font-size: var(--font-sm);
    }

    .phone-number {
        display: flex;
        align-items: center;
        gap: var(--spacing-xs);
        font-size: var(--font-sm);
    }

    .connection-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
    }

    .connection-active {
        background: rgba(0, 200, 83, 0.15);
        color: var(--success);
    }

    .connection-disabled {
        background: rgba(220, 53, 69, 0.15);
        color: var(--danger);
    }

    .connection-unknown {
        background: rgba(113, 128, 150, 0.15);
        color: var(--text-muted);
    }

    .date-info {
        display: flex;
        flex-direction: column;
        font-size: var(--font-xs);
    }

    .empty-state {
        text-align: center;
        padding: var(--spacing-3xl);
        color: var(--text-muted);
    }

    .empty-state i {
        font-size: 4rem;
        margin-bottom: var(--spacing-md);
        opacity: 0.5;
    }

    .empty-state h4 {
        margin-bottom: var(--spacing-sm);
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#usersTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/ar.json'
                },
                order: [[0, 'asc']],
                pageLength: 25,
                responsive: true
            });
        });
    </script>
}
