@model IEnumerable<RadTik.Models.PasswordResetRequest>

@{
    ViewData["Title"] = "طلبات استعادة كلمة المرور";
    var selectedStatus = ViewBag.SelectedStatus as RadTik.Models.PasswordResetStatus?;
    int pendingCount = ViewBag.PendingCount ?? 0;
}

<link rel="stylesheet" href="~/css/radtik-theme.css" asp-append-version="true" />

<style>
    /* Page Header */
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--spacing-lg);
        flex-wrap: wrap;
        gap: var(--spacing-md);
    }

    .page-header h1 {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 0;
    }

    .page-header h1 i {
        color: #ff9800;
    }

    /* Alert Box */
    .alert-box {
        background: rgba(255, 152, 0, 0.1);
        border: 1px solid rgba(255, 152, 0, 0.3);
        border-radius: var(--radius);
        padding: var(--spacing-lg);
        margin-bottom: var(--spacing-lg);
        display: flex;
        align-items: center;
        gap: var(--spacing-md);
    }

    .alert-box i {
        font-size: 24px;
        color: #ff9800;
    }

    .alert-box span {
        color: var(--text-primary);
        font-weight: 500;
    }

    /* Filter Bar */
    .filter-bar {
        background: var(--bg-card);
        border-radius: var(--radius);
        padding: var(--spacing-lg);
        margin-bottom: var(--spacing-lg);
        display: flex;
        gap: var(--spacing-md);
        align-items: center;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-light);
        flex-wrap: wrap;
    }

    .filter-bar label {
        font-weight: 600;
        color: var(--text-primary);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .filter-bar select {
        padding: 10px 15px;
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        background: var(--bg-body);
        color: var(--text-primary);
        font-family: 'Tajawal', sans-serif;
        min-width: 150px;
        cursor: pointer;
    }

    .filter-bar select:focus {
        outline: none;
        border-color: var(--primary);
    }

    /* Table Card */
    .table-card {
        background: var(--bg-card);
        border-radius: var(--radius);
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-light);
        overflow: hidden;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

    .data-table th,
    .data-table td {
        padding: 15px;
        text-align: right;
        border-bottom: 1px solid var(--border-light);
    }

    .data-table th {
        background: var(--bg-hover);
        font-weight: 600;
        color: var(--text-secondary);
        font-size: 0.85rem;
    }

    .data-table tbody tr {
        transition: background 0.2s;
    }

    .data-table tbody tr:hover {
        background: var(--bg-hover);
    }

    .data-table tbody tr:last-child td {
        border-bottom: none;
    }

    /* User Info */
    .user-info {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .user-info .name {
        font-weight: 600;
        color: var(--text-primary);
    }

    .user-info .email {
        font-size: 0.85rem;
        color: var(--text-muted);
    }

    /* Date Info */
    .date-info {
        font-size: 0.85rem;
        color: var(--text-muted);
    }

    /* Notes */
    .notes-text {
        font-size: 0.85rem;
        color: var(--text-muted);
        max-width: 200px;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* Action Buttons */
    .action-buttons {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }

    .action-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 15px;
        border-radius: 8px;
        border: none;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        font-family: 'Tajawal', sans-serif;
        gap: 6px;
    }

    .action-btn.reset {
        background: var(--success);
        color: white;
    }

    .action-btn.reset:hover {
        background: #00a854;
        transform: translateY(-1px);
    }

    .action-btn.reject {
        background: rgba(244, 67, 54, 0.1);
        color: var(--danger);
    }

    .action-btn.reject:hover {
        background: var(--danger);
        color: white;
    }

    /* Empty State */
    .empty-state {
        padding: 60px;
        text-align: center;
        color: var(--text-muted);
    }

    .empty-state i {
        font-size: 50px;
        margin-bottom: 15px;
        opacity: 0.5;
    }

    .empty-state h3 {
        font-size: 1.25rem;
        color: var(--text-primary);
        margin-bottom: 10px;
    }

    /* Modal */
    .modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 1000;
        padding: var(--spacing-md);
    }

    .modal-overlay.show {
        display: flex;
    }

    .modal-content {
        background: var(--bg-card);
        border-radius: var(--radius);
        padding: var(--spacing-xl);
        width: 100%;
        max-width: 450px;
        box-shadow: var(--shadow-lg);
        animation: modalIn 0.3s ease;
    }

    @@keyframes modalIn {
        from {
            opacity: 0;
            transform: scale(0.9);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--spacing-lg);
    }

    .modal-header h3 {
        font-size: 1.2rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .modal-header h3 i {
        color: var(--primary);
    }

    .modal-close {
        background: none;
        border: none;
        font-size: 1.5rem;
        color: var(--text-muted);
        cursor: pointer;
        transition: color 0.2s;
    }

    .modal-close:hover {
        color: var(--danger);
    }

    .modal-body {
        margin-bottom: var(--spacing-lg);
    }

    .modal-body p {
        margin-bottom: var(--spacing-lg);
        color: var(--text-secondary);
    }

    .form-group {
        margin-bottom: var(--spacing-lg);
    }

    .form-group label {
        display: block;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 8px;
    }

    .form-control {
        width: 100%;
        padding: 12px 15px;
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        background: var(--bg-body);
        color: var(--text-primary);
        font-family: 'Tajawal', sans-serif;
        transition: border-color 0.2s, box-shadow 0.2s;
    }

    .form-control:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 3px rgba(0, 102, 204, 0.1);
    }

    .modal-footer {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 20px;
        border-radius: var(--radius);
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s;
        border: none;
        font-family: 'Tajawal', sans-serif;
    }

    .btn-primary {
        background: var(--primary);
        color: white;
    }

    .btn-primary:hover {
        background: var(--primary-dark);
    }

    .btn-secondary {
        background: var(--bg-hover);
        color: var(--text-primary);
    }

    .btn-secondary:hover {
        background: var(--border-color);
    }

    /* Mobile Cards View */
    .mobile-cards {
        display: none;
    }

    .request-card {
        background: var(--bg-card);
        border-radius: var(--radius);
        padding: var(--spacing-lg);
        margin-bottom: var(--spacing-md);
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-light);
    }

    .request-card-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: var(--spacing-md);
    }

    .request-card-body {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--spacing-md);
        margin-bottom: var(--spacing-md);
    }

    .request-card-item {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .request-card-item label {
        font-size: 0.75rem;
        color: var(--text-muted);
    }

    .request-card-item span {
        font-weight: 500;
        color: var(--text-primary);
    }

    .request-card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-top: var(--spacing-md);
        border-top: 1px solid var(--border-light);
        flex-wrap: wrap;
        gap: var(--spacing-sm);
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .filter-bar {
            flex-direction: column;
            align-items: stretch;
        }

        .filter-bar select {
            width: 100%;
        }

        .data-table-container {
            display: none;
        }

        .mobile-cards {
            display: block;
        }

        .alert-box {
            flex-direction: column;
            text-align: center;
        }

        .modal-content {
            margin: var(--spacing-md);
        }
    }

    @@media (max-width: 480px) {
        .request-card-body {
            grid-template-columns: 1fr;
        }

        .request-card-footer {
            flex-direction: column;
            align-items: stretch;
        }

        .action-buttons {
            justify-content: stretch;
        }

        .action-btn {
            flex: 1;
            justify-content: center;
        }
    }
</style>

<!-- Page Header -->
<div class="page-header">
    <h1>
        <i class="fas fa-key"></i>
        طلبات استعادة كلمة المرور
    </h1>
</div>

<!-- Alert Box -->
@if (pendingCount > 0)
{
    <div class="alert-box">
        <i class="fas fa-exclamation-circle"></i>
        <span>يوجد @pendingCount طلب/طلبات قيد الانتظار تحتاج لمراجعتك</span>
    </div>
}

<!-- Filter Bar -->
<form method="get" asp-route="networkManager-joinRequests-passwordResets" asp-route-action="PasswordResets" class="filter-bar">
    <label><i class="fas fa-filter"></i> تصفية:</label>
    <select name="status" onchange="this.form.submit()">
        @{
            var statusOptions = new[] { ("", "جميع الحالات"), ("1", "قيد الانتظار"), ("4", "مكتمل"), ("5", "ملغي") };
        }
        @foreach (var opt in statusOptions)
        {
            if (selectedStatus.HasValue && ((int)selectedStatus.Value).ToString() == opt.Item1)
            {
                <option value="@opt.Item1" selected>@opt.Item2</option>
            }
            else
            {
                <option value="@opt.Item1">@opt.Item2</option>
            }
        }
    </select>
</form>

<!-- Desktop Table View -->
<div class="table-card data-table-container">
    @if (Model != null && Model.Any())
    {
        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>المستخدم</th>
                    <th>الحالة</th>
                    <th>تاريخ الطلب</th>
                    <th>ملاحظات</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model)
                {
                    <tr>
                        <td>@request.Id</td>
                        <td>
                            <div class="user-info">
                                <span class="name">@(request.User?.FullName ?? request.User?.UserName ?? "غير معروف")</span>
                                <span class="email">@request.Email</span>
                            </div>
                        </td>
                        <td>
                            @switch (request.Status)
                            {
                                case RadTik.Models.PasswordResetStatus.Pending:
                                    <span class="status-badge pending">
                                        <i class="fas fa-clock"></i>
                                        قيد الانتظار
                                    </span>
                                    break;
                                case RadTik.Models.PasswordResetStatus.Completed:
                                    <span class="status-badge completed">
                                        <i class="fas fa-check"></i>
                                        مكتمل
                                    </span>
                                    break;
                                case RadTik.Models.PasswordResetStatus.Cancelled:
                                    <span class="status-badge cancelled">
                                        <i class="fas fa-times"></i>
                                        ملغي
                                    </span>
                                    break;
                            }
                        </td>
                        <td>
                            <span class="date-info">
                                @request.CreatedDate.ToString("yyyy/MM/dd hh:mm tt")
                            </span>
                        </td>
                        <td>
                            <span class="notes-text" title="@(request.Notes ?? "-")">@(request.Notes ?? "-")</span>
                        </td>
                        <td>
                            @if (request.Status == RadTik.Models.PasswordResetStatus.Pending)
                            {
                                <div class="action-buttons">
                                    <button type="button" class="action-btn reset" 
                                            onclick="openResetModal(@request.Id, '@(request.User?.FullName ?? request.User?.UserName ?? "المستخدم")')">
                                        <i class="fas fa-key"></i>
                                        إعادة تعيين
                                    </button>
                                    <form asp-route="networkManager-joinRequests-passwordResets" asp-route-action="RejectPasswordReset" method="post" style="display: inline;"
                                          onsubmit="return confirm('هل أنت متأكد من رفض هذا الطلب؟');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="requestId" value="@request.Id" />
                                        <button type="submit" class="action-btn reject">
                                            <i class="fas fa-times"></i>
                                            رفض
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="date-info">تمت المعالجة</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-inbox"></i>
            <h3>لا توجد طلبات</h3>
            <p>لم يتم العثور على طلبات استعادة كلمة مرور</p>
        </div>
    }
</div>

<!-- Mobile Cards View -->
<div class="mobile-cards">
    @if (Model != null && Model.Any())
    {
        @foreach (var request in Model)
        {
            <div class="request-card">
                <div class="request-card-header">
                    <div class="user-info">
                        <span class="name">@(request.User?.FullName ?? request.User?.UserName ?? "غير معروف")</span>
                        <span class="email">@request.Email</span>
                    </div>
                    @switch (request.Status)
                    {
                        case RadTik.Models.PasswordResetStatus.Pending:
                            <span class="status-badge pending">
                                <i class="fas fa-clock"></i>
                                قيد الانتظار
                            </span>
                            break;
                        case RadTik.Models.PasswordResetStatus.Completed:
                            <span class="status-badge completed">
                                <i class="fas fa-check"></i>
                                مكتمل
                            </span>
                            break;
                        case RadTik.Models.PasswordResetStatus.Cancelled:
                            <span class="status-badge cancelled">
                                <i class="fas fa-times"></i>
                                ملغي
                            </span>
                            break;
                    }
                </div>
                <div class="request-card-body">
                    <div class="request-card-item">
                        <label>رقم الطلب</label>
                        <span>#@request.Id</span>
                    </div>
                    <div class="request-card-item">
                        <label>تاريخ الطلب</label>
                        <span>@request.CreatedDate.ToString("yyyy/MM/dd")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(request.Notes))
                    {
                        <div class="request-card-item" style="grid-column: span 2;">
                            <label>ملاحظات</label>
                            <span>@request.Notes</span>
                        </div>
                    }
                </div>
                @if (request.Status == RadTik.Models.PasswordResetStatus.Pending)
                {
                    <div class="request-card-footer">
                        <div class="action-buttons" style="width: 100%;">
                            <button type="button" class="action-btn reset" 
                                    onclick="openResetModal(@request.Id, '@(request.User?.FullName ?? request.User?.UserName ?? "المستخدم")')">
                                <i class="fas fa-key"></i>
                                إعادة تعيين
                            </button>
                            <form asp-route="networkManager-joinRequests-passwordResets" asp-route-action="RejectPasswordReset" method="post" style="flex: 1;"
                                  onsubmit="return confirm('هل أنت متأكد من رفض هذا الطلب؟');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="requestId" value="@request.Id" />
                                <button type="submit" class="action-btn reject" style="width: 100%;">
                                    <i class="fas fa-times"></i>
                                    رفض
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-inbox"></i>
            <h3>لا توجد طلبات</h3>
            <p>لم يتم العثور على طلبات استعادة كلمة مرور</p>
        </div>
    }
</div>

<!-- Modal for Password Reset -->
<div class="modal-overlay" id="resetModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3><i class="fas fa-key"></i> إعادة تعيين كلمة المرور</h3>
            <button type="button" class="modal-close" onclick="closeResetModal()">&times;</button>
        </div>
        <form asp-route="networkManager-joinRequests-passwordResets" asp-route-action="ResetUserPassword" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestId" id="resetRequestId" />
            <div class="modal-body">
                <p>
                    إعادة تعيين كلمة مرور المستخدم: <strong id="resetUserName"></strong>
                </p>
                <div class="form-group">
                    <label>كلمة المرور الجديدة</label>
                    <input type="password" name="newPassword" class="form-control" required minlength="6"
                           placeholder="أدخل كلمة المرور الجديدة (6 أحرف على الأقل)" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeResetModal()">إلغاء</button>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i>
                    حفظ
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    function openResetModal(requestId, userName) {
        document.getElementById('resetRequestId').value = requestId;
        document.getElementById('resetUserName').textContent = userName;
        document.getElementById('resetModal').classList.add('show');
    }

    function closeResetModal() {
        document.getElementById('resetModal').classList.remove('show');
    }

    // Close modal on outside click
    document.getElementById('resetModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeResetModal();
        }
    });

    // Close modal on escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeResetModal();
        }
    });
</script>
