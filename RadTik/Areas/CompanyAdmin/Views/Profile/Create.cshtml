@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            var isPriceEditable = false;
            const PRICE_PER_MBPS = 500; // 1 ميغابت = 500 ليرة سورية جديدة

            // حساب السعر تلقائياً بناءً على السرعة
            function calculatePriceFromSpeed() {
                if (!isPriceEditable) {
                    var downloadSpeed = parseFloat($('#DownloadSpeed').val()) || 0;
                    var calculatedPrice = downloadSpeed * PRICE_PER_MBPS;
                    $('#priceInput').val(calculatedPrice.toFixed(2));
                    updatePriceDisplay();
                }
            }

            // تحديث عرض السعر والتلميحات
            function updatePriceDisplay() {
                var price = parseFloat($('#priceInput').val()) || 0;
                var vat = parseFloat($('#VATPercentage').val()) || 0;
                var priceWithVAT = price * (1 + vat / 100);
                
                // عرض السعر بعد الضريبة
                $('#priceWithVAT').text(priceWithVAT.toFixed(2) + ' ل.س جديد');
                
                // عرض القيمة بالليرة القديمة (السعر * 100)
                var oldPrice = price * 100;
                var oldPriceWithVAT = priceWithVAT * 100;
                $('#oldPriceValue').text(oldPrice.toLocaleString('ar-SY'));
                $('#priceWithVATOld').text(oldPriceWithVAT.toLocaleString('ar-SY'));
            }

            // تفعيل/تعطيل تعديل السعر يدوياً
            $('#editPriceBtn').on('click', function() {
                isPriceEditable = !isPriceEditable;
                if (isPriceEditable) {
                    $('#priceInput').prop('readonly', false);
                    $(this).html('<i class="fas fa-lock"></i>').removeClass('btn-outline-secondary').addClass('btn-warning');
                    $(this).attr('title', 'حساب السعر تلقائياً من السرعة');
                } else {
                    $('#priceInput').prop('readonly', true);
                    $(this).html('<i class="fas fa-edit"></i>').removeClass('btn-warning').addClass('btn-outline-secondary');
                    $(this).attr('title', 'تعديل السعر يدوياً');
                    calculatePriceFromSpeed();
                }
            });

            // حساب السعر بعد الضريبة
            function calculatePriceWithVAT() {
                updatePriceDisplay();
            }

            // عند تغيير السرعة، احسب السعر تلقائياً
            $('#DownloadSpeed').on('input', function() {
                if (!isPriceEditable) {
                    calculatePriceFromSpeed();
                }
            });

            // عند تغيير السعر أو الضريبة، حدّث العرض
            $('#priceInput, #VATPercentage').on('input', calculatePriceWithVAT);
            
            // حساب السعر الأولي
            calculatePriceFromSpeed();
            calculatePriceWithVAT();

            // حساب Rate Limit تلقائياً
            window.calculateRateLimit = function() {
                var download = $('#DownloadSpeed').val() || 0;
                var upload = $('#UploadSpeed').val() || download;

                if (download > 0) {
                    var rateLimit = download + 'M';
                    if (upload > 0) {
                        rateLimit += '/' + upload + 'M';
                    }
                    $('#rateLimitInput').val(rateLimit);
                }
            }

            $('#DownloadSpeed, #UploadSpeed').on('input', calculateRateLimit);

            // التنقل بين التبويبات - محسّن
            var currentTab = 0;
            var tabs = $('#profileTabs button');
            var tabPanes = $('#profileTabsContent .tab-pane');

            function showTab(n) {
                // تحديث التبويبات
                tabs.removeClass('active').eq(n).addClass('active');
                tabPanes.removeClass('show active').eq(n).addClass('show active');
                currentTab = n;

                // تحديث الأزرار
                var prevBtn = $('#prevTabBtn');
                var nextBtn = $('#nextTabBtn');

                if (currentTab === 0) {
                    prevBtn.prop('disabled', true).addClass('disabled');
                } else {
                    prevBtn.prop('disabled', false).removeClass('disabled');
                }

                if (currentTab === tabs.length - 1) {
                    nextBtn.prop('disabled', true).addClass('disabled');
                } else {
                    nextBtn.prop('disabled', false).removeClass('disabled');
                }

                // إضافة تأثير بسيط
                tabPanes.eq(n).hide().fadeIn(300);
            }

            // دالة الانتقال للتبويب التالي
            window.nextTab = function() {
                if (currentTab < tabs.length - 1) {
                    showTab(currentTab + 1);
                    // تمرير سلس للتبويب
                    $('html, body').animate({
                        scrollTop: $('#profileTabs').offset().top - 20
                    }, 300);
                }
            }

            // دالة الانتقال للتبويب السابق
            window.previousTab = function() {
                if (currentTab > 0) {
                    showTab(currentTab - 1);
                    // تمرير سلس للتبويب
                    $('html, body').animate({
                        scrollTop: $('#profileTabs').offset().top - 20
                    }, 300);
                }
            }

            // إضافة مستمعات النقر على التبويبات
            tabs.on('click', function() {
                var index = tabs.index(this);
                showTab(index);
            });

            // تهيئة الأزرار عند التحميل
            showTab(0);

            // التحقق من صحة النموذج قبل الإرسال
            $('#createForm').on('submit', function(e) {
                var mikrotikServer = $('#MikroTikServerId').val();
                if (mikrotikServer) {
                    if (!confirm('سيتم إضافة البروفايل إلى MikroTik أولاً. هل تريد المتابعة؟')) {
                        e.preventDefault();
                        return false;
                    }
                }
                
                // إظهار رسالة التحميل
                var submitBtn = $(this).find('button[type="submit"]');
                submitBtn.html('<i class="fas fa-spinner fa-spin me-2"></i>جاري الحفظ...').prop('disabled', true);
                
                return true;
            });
        });
    </script>
}