@model RadTik.Models.Profile
@{
    ViewData["Title"] = "إنشاء بروفايل جديد";
    var profileCreateUnitPrice = (decimal?)(ViewBag.ProfileCreateUnitPrice) ?? 0m;
    var systemProfileVatPercentage = (decimal?)(ViewBag.SystemProfileVatPercentage) ?? 15m;
}

<style>
    /* تحسينات التصميم */
    .profile-create-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 20px;
    }

    .profile-header {
        background: linear-gradient(135deg, #0066CC 0%, #004C99 100%);
        color: white;
        padding: 25px 30px;
        border-radius: 12px 12px 0 0;
        margin-bottom: 0;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    }

    .profile-header h4 {
        margin: 0;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    /* تحسين التبويبات */
    .tabs-wrapper {
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        padding: 20px 20px 0;
        border-radius: 0;
        position: relative;
    }

    .nav-tabs {
        border: none;
        background: transparent;
        padding: 0;
        margin: 0;
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        position: relative;
    }

    .nav-tabs::after {
        content: '';
        position: absolute;
        bottom: 0;
        right: 0;
        left: 0;
        height: 2px;
        background: #e0e0e0;
    }

    .nav-tabs .nav-item {
        margin: 0;
        position: relative;
    }

    .nav-tabs .nav-link {
        border: none;
        border-radius: 12px 12px 0 0;
        color: #6c757d;
        padding: 18px 32px;
        font-weight: 600;
        font-size: 1em;
        transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        margin-bottom: 0;
        background: rgba(255, 255, 255, 0.7);
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.08);
        min-width: 180px;
        text-align: center;
    }

    .nav-tabs .nav-link::before {
        content: '';
        position: absolute;
        bottom: 0;
        right: 0;
        left: 0;
        height: 4px;
        background: linear-gradient(90deg, #0066CC 0%, #004C99 100%);
        transform: scaleX(0);
        transform-origin: center;
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        border-radius: 2px 2px 0 0;
    }

    .nav-tabs .nav-link::after {
        content: '';
        position: absolute;
        top: 50%;
        right: 50%;
        width: 0;
        height: 0;
        background: radial-gradient(circle, rgba(0,102,204,0.1) 0%, transparent 70%);
        border-radius: 50%;
        transform: translate(50%, -50%);
        transition: all 0.4s ease;
    }

    .nav-tabs .nav-link:hover {
        background: rgba(255, 255, 255, 1);
        color: #0066CC;
        transform: translateY(-4px);
        box-shadow: 0 6px 16px rgba(0, 102, 204, 0.25);
    }

    .nav-tabs .nav-link:hover::before {
        transform: scaleX(1);
    }

    .nav-tabs .nav-link:hover::after {
        width: 200px;
        height: 200px;
    }

    .nav-tabs .nav-link.active {
        background: white;
        color: #0066CC;
        font-weight: 700;
        box-shadow: 0 8px 20px rgba(0, 102, 204, 0.3);
        transform: translateY(-5px);
        z-index: 10;
    }

    .nav-tabs .nav-link.active::before {
        transform: scaleX(1);
        height: 5px;
        box-shadow: 0 -2px 8px rgba(0, 102, 204, 0.4);
    }

    .nav-tabs .nav-link.active::after {
        width: 0;
        height: 0;
    }

    .nav-tabs .nav-link i {
        font-size: 1.2em;
        transition: all 0.3s ease;
        display: inline-block;
    }

    .nav-tabs .nav-link:hover i {
        transform: scale(1.2) rotate(5deg);
        color: #0066CC;
    }

    .nav-tabs .nav-link.active i {
        transform: scale(1.25);
        color: #0066CC;
        text-shadow: 0 2px 4px rgba(0, 102, 204, 0.3);
    }

    .nav-tabs .nav-link span {
        transition: all 0.3s ease;
    }

    .nav-tabs .nav-link:hover span,
    .nav-tabs .nav-link.active span {
        letter-spacing: 0.5px;
    }

    .tab-content {
        background: white;
        padding: 30px;
        border-radius: 0 0 12px 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .form-section {
        background: #f8f9fa;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 20px;
        border-left: 4px solid #0066CC;
    }

    .form-section-title {
        font-weight: 600;
        color: #333;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 1.1em;
    }

    .form-label {
        font-weight: 600;
        color: #333;
        margin-bottom: 8px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .form-label.required::after {
        content: "*";
        color: #dc3545;
        margin-right: 4px;
    }

    .form-control, .form-select {
        border-radius: 6px;
        border: 1px solid #ddd;
        padding: 10px 15px;
        transition: all 0.3s ease;
    }

    .form-control:focus, .form-select:focus {
        border-color: #0066CC;
        box-shadow: 0 0 0 0.2rem rgba(0, 102, 204, 0.25);
    }

    .input-group-text {
        background: #f8f9fa;
        border-color: #ddd;
        font-weight: 500;
    }

    .info-card {
        background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
        border: none;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .info-card h5 {
        color: #1976d2;
        font-weight: 600;
        margin-bottom: 15px;
    }

    .info-card ul {
        margin: 0;
        padding-right: 20px;
    }

    .info-card li {
        margin-bottom: 8px;
        color: #555;
    }

    .price-display-card {
        background: linear-gradient(135deg, #e8f5e9 0%, #c8e6c9 100%);
        border: none;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .price-display-card strong {
        color: #2e7d32;
        font-size: 1.1em;
    }

    .price-display-card .fs-4 {
        color: #1b5e20;
        font-weight: 700;
    }

    .tips-card {
        background: #fff3cd;
        border: 1px solid #ffc107;
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 20px;
    }

    .tips-card h5 {
        color: #856404;
        font-weight: 600;
    }

    .action-buttons {
        background: #f8f9fa;
        padding: 20px 30px;
        border-radius: 0 0 12px 12px;
        border-top: 1px solid #e0e0e0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

    .btn {
        border-radius: 6px;
        padding: 10px 20px;
        font-weight: 500;
        transition: all 0.3s ease;
    }

    .btn-primary {
        background: linear-gradient(135deg, #0066CC 0%, #004C99 100%);
        border: none;
        color: white;
        box-shadow: 0 4px 6px rgba(0,102,204,0.3);
    }

    .btn-primary:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 12px rgba(0,102,204,0.4);
    }

    .form-check-input {
        width: 1.5em;
        height: 1.5em;
        cursor: pointer;
    }

    .form-check-label {
        cursor: pointer;
        margin-right: 8px;
    }

    /* تحسين Select2 */
    .select2-container--bootstrap-5 .select2-selection {
        border-radius: 6px;
        min-height: 42px;
    }

    /* تحسين التبويبات للشاشات الصغيرة */
    @@media (max-width: 768px) {
        .nav-tabs {
            padding: 10px 10px 0;
            gap: 5px;
        }
        
        .nav-tabs .nav-link {
            padding: 12px 16px;
            font-size: 0.85em;
            flex-direction: column;
            gap: 5px;
            min-width: auto;
        }
        
        .nav-tabs .nav-link i {
            font-size: 1em;
        }
        
        .tab-content {
            padding: 20px 15px;
        }
    }

    /* تحسين التبويبات للشاشات المتوسطة */
    @@media (max-width: 992px) and (min-width: 769px) {
        .nav-tabs .nav-link {
            padding: 14px 20px;
            font-size: 0.9em;
        }
    }
</style>

<div class="profile-create-container">
    <div class="card shadow-lg border-0">
        <div class="profile-header">
            <h4>
                <i class="fas fa-plus-circle"></i>
                إنشاء بروفايل جديد
            </h4>
        </div>

        <div class="alert alert-success m-3 mb-0" role="alert">
            <i class="fas fa-money-check-dollar me-2"></i>
            <strong>تنبيه التسعير:</strong>
            سيتم تطبيق حسم إنشاء/إضافة البروفايل حسب تسعير مدير النظام.
            سعر الوحدة الحالي:
            <strong>@profileCreateUnitPrice.ToString("N2") ل.س.ج</strong>
        </div>

        <form asp-action="Create" id="createForm">
            @Html.AntiForgeryToken()

            <!-- رسائل الخطأ -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger m-3" role="alert">
                    <h5 class="alert-heading">
                        <i class="fas fa-exclamation-triangle me-2"></i>يوجد أخطاء في النموذج
                    </h5>
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                </div>
            }

            <!-- شريط التبويبات المحسّن -->
            <div class="tabs-wrapper">
                <ul class="nav nav-tabs" id="profileTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="basic-tab" data-bs-toggle="tab" data-bs-target="#basic" type="button" role="tab">
                            <i class="fas fa-info-circle"></i>
                            <span>المعلومات الأساسية</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="financial-tab" data-bs-toggle="tab" data-bs-target="#financial" type="button" role="tab">
                            <i class="fas fa-money-bill-wave"></i>
                            <span>المعلومات المالية</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="mikrotik-tab" data-bs-toggle="tab" data-bs-target="#mikrotik" type="button" role="tab">
                            <i class="fas fa-server"></i>
                            <span>إعدادات MikroTik</span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="advanced-tab" data-bs-toggle="tab" data-bs-target="#advanced" type="button" role="tab">
                            <i class="fas fa-cog"></i>
                            <span>إعدادات متقدمة</span>
                        </button>
                    </li>
                </ul>
            </div>

                        <!-- محتوى التبويبات -->
                        <div class="tab-content" id="profileTabsContent">
                            <!-- التبويب 1: المعلومات الأساسية -->
                            <div class="tab-pane fade show active" id="basic" role="tabpanel">
                                <div class="row g-4">
                                    <div class="col-lg-6">
                                        <div class="form-section">
                                            <div class="form-section-title">
                                                <i class="fas fa-info-circle text-primary"></i>
                                                البيانات الأساسية
                                            </div>

                                            <div class="mb-4">
                                                <label asp-for="Name" class="form-label required">
                                                    <i class="fas fa-tag"></i>
                                                    اسم البروفايل
                                                </label>
                                                <input asp-for="Name" class="form-control" placeholder="أدخل اسم البروفايل" />
                                                <span asp-validation-for="Name" class="text-danger small d-block mt-1"></span>
                                                <small class="form-text text-muted mt-1 d-block">
                                                    <i class="fas fa-info-circle"></i> @ViewData["Name_Description"]
                                                </small>
                                            </div>

                                            <div class="mb-4">
                                                <label asp-for="Description" class="form-label">
                                                    <i class="fas fa-align-right"></i>
                                                    الوصف
                                                </label>
                                                <textarea asp-for="Description" class="form-control" rows="4" placeholder="وصف مختصر للبروفايل والخدمات المقدمة"></textarea>
                                                <span asp-validation-for="Description" class="text-danger small d-block mt-1"></span>
                                                <small class="form-text text-muted mt-1 d-block">
                                                    <i class="fas fa-info-circle"></i> @ViewData["Description_Description"]
                                                </small>
                                            </div>

                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <div class="mb-3">
                                                        <label asp-for="Type" class="form-label required">
                                                            <i class="fas fa-layer-group"></i>
                                                            نوع البروفايل
                                                        </label>
                                                        <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<ProfileType>()">
                                                            <option value="">-- اختر النوع --</option>
                                                        </select>
                                                        <span asp-validation-for="Type" class="text-danger small d-block mt-1"></span>
                                                        <small class="form-text text-muted mt-1 d-block">
                                                            <i class="fas fa-info-circle"></i> @ViewData["Type_Description"]
                                                        </small>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="mb-3">
                                                        <label asp-for="BillingCycle" class="form-label required">
                                                            <i class="fas fa-calendar-alt"></i>
                                                            دورة الفاتورة
                                                        </label>
                                                        <select asp-for="BillingCycle" class="form-select" asp-items="Html.GetEnumSelectList<BillingCycle>()">
                                                            <option value="">-- اختر دورة الفاتورة --</option>
                                                        </select>
                                                        <span asp-validation-for="BillingCycle" class="text-danger small d-block mt-1"></span>
                                                        <small class="form-text text-muted mt-1 d-block">
                                                            <i class="fas fa-info-circle"></i> @ViewData["BillingCycle_Description"]
                                                        </small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-6">
                                        <div class="info-card">
                                            <h5>
                                                <i class="fas fa-lightbulb me-2"></i>نصائح مهمة
                                            </h5>
                                            <ul>
                                                <li><i class="fas fa-check-circle text-success me-2"></i>اختر اسماً واضحاً يصف البروفايل</li>
                                                <li><i class="fas fa-check-circle text-success me-2"></i>تأكد من اختيار النوع المناسب للخدمة</li>
                                                <li><i class="fas fa-check-circle text-success me-2"></i>اكتب وصفاً مختصراً للبروفايل</li>
                                                <li><i class="fas fa-check-circle text-success me-2"></i>اختر دورة الفاتورة المناسبة للخدمة</li>
                                            </ul>
                                        </div>

                                        <div class="form-section">
                                            <div class="form-section-title">
                                                <i class="fas fa-toggle-on text-success"></i>
                                                إعدادات التفعيل
                                            </div>

                                            <div class="form-check form-switch mb-3 p-3 bg-white rounded">
                                                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="isActiveSwitch" checked style="transform: scale(1.3);">
                                                <label class="form-check-label fw-bold" for="isActiveSwitch">
                                                    تفعيل البروفايل
                                                </label>
                                                <small class="form-text text-muted d-block mt-2">
                                                    <i class="fas fa-info-circle"></i> @ViewData["IsActive_Description"]
                                                </small>
                                            </div>

                                            <div class="form-check form-switch mb-3 p-3 bg-white rounded">
                                                <input asp-for="IsForNewClients" class="form-check-input" type="checkbox" id="isForNewClientsSwitch" checked style="transform: scale(1.3);">
                                                <label class="form-check-label fw-bold" for="isForNewClientsSwitch">
                                                    متاح للعملاء الجدد
                                                </label>
                                                <small class="form-text text-muted d-block mt-2">
                                                    <i class="fas fa-info-circle"></i> @ViewData["IsForNewClients_Description"]
                                                </small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- التبويب 2: المعلومات المالية -->
                            <div class="tab-pane fade" id="financial" role="tabpanel">
                                <div class="row g-4">
                                    <div class="col-lg-6">
                                        <div class="form-section">
                                            <div class="form-section-title">
                                                <i class="fas fa-money-bill-wave text-success"></i>
                                                معلومات التسعير
                                            </div>

                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <div class="mb-4">
                                                        <label asp-for="Price" class="form-label required">
                                                            <i class="fas fa-coins"></i>
                                                            السعر
                                                        </label>
                                                        <div class="input-group">
                                                            <span class="input-group-text bg-light">
                                                                <i class="fas fa-lira-sign"></i> ل.س جديد
                                                            </span>
                                                            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" id="priceInput" readonly />
                                                            <button type="button" class="btn btn-outline-secondary" id="editPriceBtn" title="تعديل السعر يدوياً">
                                                                <i class="fas fa-edit"></i>
                                                            </button>
                                                        </div>
                                                        <span asp-validation-for="Price" class="text-danger small d-block mt-1"></span>
                                                        <small class="form-text text-muted mt-2 d-block">
                                                            <i class="fas fa-info-circle"></i>
                                                            السعر يُحسب تلقائياً: 1 ميغابت = 500 ل.س جديد
                                                            <br />
                                                            <span id="oldPriceHint" class="text-info fw-bold">
                                                                <i class="fas fa-coins me-1"></i>
                                                                القيمة بالليرة القديمة: <strong id="oldPriceValue">0</strong> ل.س
                                                            </span>
                                                        </small>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="mb-4">
                                                        <label asp-for="VATPercentage" class="form-label">
                                                            <i class="fas fa-percent"></i>
                                                            ضريبة القيمة المضافة
                                                        </label>
                                                        <div class="input-group">
                                                            <input asp-for="VATPercentage" class="form-control" type="number" step="0.01" min="0" max="100" value="@systemProfileVatPercentage" readonly />
                                                            <span class="input-group-text bg-light">%</span>
                                                        </div>
                                                        <span asp-validation-for="VATPercentage" class="text-danger small d-block mt-1"></span>
                                                        <small class="form-text text-muted mt-1 d-block">
                                                            <i class="fas fa-info-circle"></i> يتم تحديد هذه الضريبة من مدير النظام وتُطبّق تلقائياً.
                                                        </small>
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="price-display-card">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <strong>
                                                        <i class="fas fa-calculator me-2"></i>
                                                        السعر بعد الضريبة:
                                                    </strong>
                                                    <span id="priceWithVAT" class="fs-4">0 ل.س جديد</span>
                                                </div>
                                                <div class="text-muted small">
                                                    <i class="fas fa-coins me-1"></i>
                                                    القيمة بالليرة القديمة: <strong id="priceWithVATOld">0</strong> ل.س
                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-section">
                                            <div class="form-section-title">
                                                <i class="fas fa-tachometer-alt text-primary"></i>
                                                سرعات الاتصال
                                            </div>

                                            <div class="row g-3">
                                                <div class="col-md-6">
                                                    <div class="mb-3">
                                                        <label asp-for="DownloadSpeed" class="form-label required">
                                                            <i class="fas fa-download"></i>
                                                            سرعة التنزيل
                                                        </label>
                                                        <div class="input-group">
                                                            <input asp-for="DownloadSpeed" class="form-control" type="number" min="1" value="10" placeholder="رقم صحيح" />
                                                            <select asp-for="DownloadSpeedUnit" asp-items="Html.GetEnumSelectList<RadTik.Models.SpeedUnit>()" class="form-select" style="max-width: 110px;"></select>
                                                        </div>
                                                        <span asp-validation-for="DownloadSpeed" class="text-danger small d-block mt-1"></span>
                                                        <small class="form-text text-muted mt-1 d-block">
                                                            <i class="fas fa-info-circle"></i> رقم صحيح + الوحدة (Kbps, Mbps, Gbps)
                                                        </small>
                                                    </div>
                                                </div>
                                                <div class="col-md-6">
                                                    <div class="mb-3">
                                                        <label asp-for="UploadSpeed" class="form-label">
                                                            <i class="fas fa-upload"></i>
                                                            سرعة الرفع
                                                        </label>
                                                        <div class="input-group">
                                                            <input asp-for="UploadSpeed" class="form-control" type="number" min="1" value="10" placeholder="اختياري" />
                                                            <select asp-for="UploadSpeedUnit" class="form-select" style="max-width: 110px;">
                                                                <option value="">نفس التنزيل</option>
                                                                @foreach (var e in Enum.GetValues<RadTik.Models.SpeedUnit>())
                                                                {
                                                                    <option value="@((int)e)">@e</option>
                                                                }
                                                            </select>
                                                        </div>
                                                        <span asp-validation-for="UploadSpeed" class="text-danger small d-block mt-1"></span>
                                                        <small class="form-text text-muted mt-1 d-block">
                                                            <i class="fas fa-info-circle"></i> اتركه فارغاً لاستخدام نفس سرعة التنزيل
                                                        </small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-lg-6">
                                        <div class="form-section">
                                            <div class="form-section-title">
                                                <i class="fas fa-sliders-h text-info"></i>
                                                حدود الاستخدام
