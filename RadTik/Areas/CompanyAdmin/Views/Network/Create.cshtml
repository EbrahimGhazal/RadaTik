@model RadTik.ViewModels.Network.NetworkViewModel

@{
    ViewData["Title"] = "إنشاء شبكة جديدة";
    var isFirstNetworkFree = (ViewBag.NetworkPricingIsFirstFree as bool?) ?? true;
    var companyName = ViewBag.NetworkPricingCompanyName as string ?? "شبكة جديدة";
    var totalNetworks = (ViewBag.NetworkPricingTotalNetworks as int?) ?? 0;
    var hasInitialPricing = (ViewBag.NetworkPricingHasInitial as bool?) ?? false;
    var hasRenewalPricing = (ViewBag.NetworkPricingHasRenewal as bool?) ?? false;
    var initialPriceSyp = (ViewBag.NetworkPricingInitialSyp as decimal?) ?? 0m;
    var renewalPriceSyp = (ViewBag.NetworkPricingRenewalSyp as decimal?) ?? 0m;
    var renewalPeriodLabel = ViewBag.NetworkPricingRenewalPeriodLabel as string ?? "غير محدد";
}

<div class="sys-hero mb-4">
    <div class="sys-hero-main">
        <div class="sys-hero-icon"><i class="fas fa-plus-circle"></i></div>
        <div>
            <h1 class="sys-hero-title">@ViewData["Title"]</h1>
            <p class="sys-hero-subtitle">ابدأ بإنشاء شبكتك الخاصة وإدارة جميع مواردك من مكان واحد، بنفس تجربة واجهة مدير النظام.</p>
        </div>
    </div>
    <div class="sys-hero-chips">
        <span class="sys-hero-chip"><i class="fas fa-pen-to-square"></i> نموذج إنشاء شبكة</span>
        <span class="sys-hero-chip"><i class="fas fa-image"></i> شعار اختياري</span>
        <span class="sys-hero-chip"><i class="fas fa-layer-group"></i> جاهز للمخدمات والقطاعات لاحقاً</span>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header">
                <h5 class="card-title mb-0">معلومات الشبكة</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="All" class="alert alert-danger"></div>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger">
                            <i class="fas fa-exclamation-circle"></i>
                            @TempData["Error"]
                        </div>
                    }

                    @if (isFirstNetworkFree)
                    {
                        <div class="alert alert-success mb-3">
                            <i class="fas fa-gift"></i>
                            هذه هي <strong>أول شبكة</strong> لك، لذلك سيتم إنشاؤها <strong>مجاناً</strong>.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning mb-3">
                            <i class="fas fa-coins"></i>
                            سيتم اعتبار هذه الشبكة <strong>شبكة إضافية</strong> للشركة <strong>@companyName</strong> (عدد الشبكات الحالية: @totalNetworks).
                            <div class="small mt-2">
                                <div>سعر الإضافة الآن: <strong>@initialPriceSyp.ToString("N2") ل.س.ج</strong></div>
                                <div>التجديد الدوري: <strong>@renewalPeriodLabel</strong></div>
                                <div>سعر التجديد لكل شبكة إضافية: <strong>@renewalPriceSyp.ToString("N2") ل.س.ج</strong></div>
                            </div>
                        </div>
                    }

                    @if (!isFirstNetworkFree && (!hasInitialPricing || !hasRenewalPricing))
                    {
                        <div class="alert alert-danger mb-3">
                            <i class="fas fa-triangle-exclamation"></i>
                            إعدادات تسعير/تجديد الشبكات غير مكتملة من مدير النظام. يرجى إكمالها من تبويب
                            <strong>الأسعار والتجديد</strong> في صفحة الخدمات.
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">اسم الشبكة <span class="text-danger">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="أدخل اسم الشبكة" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Governorates" class="form-label">المحافظات</label>
                        <textarea asp-for="Governorates" class="form-control" rows="4" placeholder="أدخل المحافظات التي تعمل بها الشبكة (مفصولة بفواصل أو كل محافظة في سطر)"></textarea>
                        <span asp-validation-for="Governorates" class="text-danger"></span>
                        <small class="form-text text-muted">مثال: دمشق، حلب، اللاذقية</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="LogoFile" class="form-label">شعار الشبكة</label>
                        <input asp-for="LogoFile" type="file" class="form-control" accept="image/*" data-max-bytes="3145728" data-size-message="حجم شعار الشبكة يجب ألا يتجاوز 3 ميغابايت." />
                        <span asp-validation-for="LogoFile" class="text-danger"></span>
                        <small class="form-text text-muted">الصيغ المدعومة: JPG, PNG, GIF (الحجم الأقصى: 3MB)</small>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Status" class="form-label">حالة الشبكة <span class="text-danger">*</span></label>
                        <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<NetworkStatus>()"></select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label">ملاحظات</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="أي ملاحظات إضافية عن الشبكة"></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="alert alert-info mb-4">
                        <i class="fas fa-info-circle"></i>
                        <strong>ملاحظة:</strong> بعد إنشاء الشبكة، ستتمكن من إدارة المخدمات والقطاعات والمستقبلات والعملاء والبروفايلات.
                        <div class="mt-2 small">
                            سياسة التسعير: <strong>أول شبكة مجانية</strong> لكل مدير شركة، وكل شبكة إضافية تُخصم وفق إعدادات مدير النظام
                            (سعر الإضافة + التجديد الدوري لكل وحدة).
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i>
                            إنشاء الشبكة
                        </button>
                        @if (isFirstNetworkFree)
                        {
                            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle d-inline-flex align-items-center px-3">
                                <i class="fas fa-gift me-1"></i>
                                الخصم المتوقع الآن: مجاني (0.00 ل.س.ج)
                            </span>
                        }
                        else if (hasInitialPricing)
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle d-inline-flex align-items-center px-3">
                                <i class="fas fa-wallet me-1"></i>
                                الخصم المتوقع الآن: @initialPriceSyp.ToString("N2") ل.س.ج
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-danger-subtle text-danger-emphasis border border-danger-subtle d-inline-flex align-items-center px-3">
                                <i class="fas fa-triangle-exclamation me-1"></i>
                                الخصم المتوقع الآن: غير متاح (إعدادات التسعير غير مكتملة)
                            </span>
                        }
                        <a asp-route="networkManager-dashboard" class="btn btn-outline-secondary">
                            <i class="fas fa-times"></i>
                            إلغاء
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-lightbulb text-primary"></i>
                    معلومات مفيدة
                </h5>
            </div>
            <div class="card-body">
                <h6 class="fw-semibold">ما هي الشبكة؟</h6>
                <p class="small text-muted mb-3">
                    الشبكة هي الوحدة الأساسية لإدارة جميع مواردك. بعد إنشاء الشبكة، يمكنك:
                </p>
                <ul class="small mb-0 ps-3">
                    <li>إدارة خوادم MikroTik</li>
                    <li>إدارة القطاعات والمستقبلات</li>
                    <li>إدارة العملاء والبروفايلات</li>
                    <li>تتبع جميع الإحصائيات</li>
                </ul>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var logoInput = document.getElementById('LogoFile');
            if (!logoInput) return;

            var maxBytes = Number(logoInput.getAttribute('data-max-bytes') || (3 * 1024 * 1024));
            var sizeMessage = logoInput.getAttribute('data-size-message') || 'حجم الصورة يجب ألا يتجاوز 3 ميغابايت.';
            logoInput.addEventListener('change', function () {
                var file = logoInput.files && logoInput.files.length ? logoInput.files[0] : null;
                if (!file) {
                    logoInput.setCustomValidity('');
                    return;
                }

                if (file.size > maxBytes) {
                    logoInput.value = '';
                    logoInput.setCustomValidity(sizeMessage);
                    logoInput.reportValidity();
                } else {
                    logoInput.setCustomValidity('');
                }
            });
        });
    </script>
}
