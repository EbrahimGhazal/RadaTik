@model RadTik.ViewModels.CompanyAdmin.CompanyReportsResultViewModel
@{
    ViewData["Title"] = Model.Title;
    Layout = "~/Areas/CompanyAdmin/Views/Shared/_Layout.cshtml";
}

<style media="print">
    .no-print { display: none !important; }
    body { background: #fff !important; }
    .report-table { font-size: 11px; }
</style>

<div class="no-print mb-3 d-flex flex-wrap gap-2 align-items-center">
    <button type="button" class="btn btn-primary" onclick="window.print()"><i class="fas fa-print"></i> طباعة</button>
    <a class="btn btn-outline-secondary" asp-action="Index"><i class="fas fa-arrow-right"></i> تقارير أخرى</a>
    @if (Model.ChargedAmountSyp.HasValue && Model.ChargedAmountSyp.Value > 0)
    {
        <span class="text-muted small">تم خصم @Model.ChargedAmountSyp.Value.ToString("N2") ل.س.ج من المحفظة.</span>
    }
</div>

<div class="card report-print-area">
    <div class="card-body">
        @if (Model.UseCustomTemplate)
        {
            @if (!string.IsNullOrWhiteSpace(Model.CustomHtmlBeforeTable))
            {
                <div class="report-custom-html mb-3">@Html.Raw(Model.CustomHtmlBeforeTable)</div>
            }
        }
        else
        {
            <h2 class="h4 mb-1">@Model.Title</h2>
            <p class="text-muted mb-1">الشبكة: <strong>@Model.NetworkName</strong></p>
            <p class="text-muted mb-3">
                الفترة: @Model.Range.FromInclusive.ToString("yyyy/MM/dd HH:mm")
                — @Model.Range.ToInclusive.ToString("yyyy/MM/dd HH:mm")
            </p>
        }

        <div class="table-responsive">
            <table class="table table-striped table-bordered report-table align-middle">
                <thead>
                    <tr>
                        @foreach (var h in Model.Headers)
                        {
                            <th>@h</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            @foreach (var cell in row)
                            {
                                <td>@cell</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.UseCustomTemplate && !string.IsNullOrWhiteSpace(Model.CustomHtmlAfterTable))
        {
            <div class="report-custom-html mt-3">@Html.Raw(Model.CustomHtmlAfterTable)</div>
        }

        @if (Model.Rows.Count == 0)
        {
            <p class="text-center text-muted my-4">لا توجد بيانات ضمن هذه الفترة.</p>
        }
    </div>
</div>
