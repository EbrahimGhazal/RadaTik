@using RadTik.ViewModels.CompanyAdmin
@{
    ViewData["Title"] = "قوالب التقارير";
    var existing = ViewBag.ExistingKinds as IReadOnlyDictionary<CompanyReportKind, DateTime>;
}

<div class="page-header">
    <div class="page-header-content d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h1 class="page-title mb-0"><i class="fas fa-file-code"></i> @ViewData["Title"]</h1>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Index"><i class="fas fa-arrow-right"></i> رجوع للتقارير</a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-body">
        <p class="text-muted">
            لكل نوع تقرير يمكنك كتابة نصوص وثوابت وتنسيق HTML، بينما تُستبدل المتغيرات مثل <code>{{CompanyName}}</code> تلقائياً من التطبيق.
            ضع <code>{{DATA_TABLE}}</code> في المكان الذي تريد ظهور جدول البيانات فيه.
        </p>
        <div class="table-responsive">
            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>نوع التقرير</th>
                        <th>آخر تحديث</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (CompanyReportKind k in Enum.GetValues<CompanyReportKind>())
                    {
                        var title = RadTik.Services.Reports.ReportTemplateFormatter.GetReportTitleDisplay(k);
                        DateTime? updatedAt = existing != null && existing.TryGetValue(k, out var u) ? u : null;
                        <tr>
                            <td><strong>@title</strong></td>
                            <td>@(updatedAt.HasValue ? updatedAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm") : "—")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-primary" asp-action="EditTemplate" asp-route-kind="@((int)k)">تعديل القالب</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
