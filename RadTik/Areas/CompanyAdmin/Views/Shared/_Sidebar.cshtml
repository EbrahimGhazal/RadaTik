@using RadTik.Security
@using RadTik.Helpers
@using RadTik.Data
@using RadTik.Models
@using Microsoft.EntityFrameworkCore
@inject RadTik.Services.IFeatureAccessService FeatureAccess
@inject ApplicationDbContext Db
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager

@{
    // CompanyAdmin sidebar (NetworkAdministrator).
    // This menu is intentionally separated from other roles for future UI customization.

    var isAuthenticated = (bool?)(ViewData["Layout_IsAuthenticated"]) == true;
    var userName = ViewData["Layout_UserName"] as string ?? (User.Identity?.Name ?? "مستخدم");
    var userInitials = ViewData["Layout_UserInitials"] as string ?? (userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "م");
    var userRole = ViewData["Layout_UserRole"] as string ?? "مدير الشركة";

    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var currentType = ViewContext.HttpContext.Request.Query["type"].ToString();
    if (string.IsNullOrWhiteSpace(currentType))
    {
        currentType = ViewContext.RouteData.Values["type"]?.ToString() ?? "";
    }
}

<aside class="sidebar sidebar-pro" id="sidebar">
    <div class="sidebar-header">
        <div class="sidebar-logo">
            <i class="fas fa-network-wired"></i>
        </div>
        <div class="sidebar-brand">
            <span class="sidebar-brand-name">RadTik</span>
            <small class="sidebar-brand-sub">إدارة الشبكة</small>
        </div>
    </div>

    <nav class="sidebar-nav" data-single-open="true">
        @if (!isAuthenticated)
        {
            <div class="nav-section">
                <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                    <i class="fas fa-bars"></i>
                    <span>القائمة</span>
                    <i class="fas fa-chevron-down nav-section-chevron"></i>
                </div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link" asp-route="reglog-login">
                            <span class="nav-icon"><i class="fas fa-sign-in-alt"></i></span>
                            <span>تسجيل الدخول</span>
                        </a>
                    </li>
                </ul>
            </div>
        }
        else
        {
            // Feature gating (paid/optional modules) - per selected NetworkId.
            var canUseNetworks = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Networks);
            var canUseMikroTikServers = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.MikroTikServers);
            var canUseProfiles = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Profiles);
            var canUseUsers = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Users);
            var canUseCollectionPoints = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.CollectionPoints);
            var canUseClients = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Clients);
            var canUseSectors = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Sectors);
            var canUseReceivers = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Receivers);
            var canUseRequests = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Requests);
            var canUseReports = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Reports);
            var pendingEmployeeApprovalsCount = 0;

            try
            {
                var currentUser = await UserManager.GetUserAsync(User);
                var selectedNetworkId = NetworkHelper.GetCurrentNetworkId(ViewContext.HttpContext, Db, currentUser);
                if (selectedNetworkId.HasValue)
                {
                    var selectedNetwork = await Db.Networks
                        .AsNoTracking()
                        .Where(n => n.Id == selectedNetworkId.Value)
                        .Select(n => new { n.ParentNetworkId })
                        .FirstOrDefaultAsync();
                    var companyNetworkId = selectedNetwork?.ParentNetworkId ?? selectedNetworkId.Value;
                    var companyScope = await PricingChargeHelper.GetCompanyScopeNetworkIdsAsync(Db, companyNetworkId);

                    pendingEmployeeApprovalsCount = await Db.NetworkServiceRequests
                        .AsNoTracking()
                        .Where(r =>
                            companyScope.Contains(r.NetworkId) &&
                            r.Status == NetworkServiceRequestStatus.Pending &&
                            (
                                (r.Notes != null && r.Notes.StartsWith("EMP_REQ:"))
                                ||
                                (r.Notes != null && r.Notes.Contains("SECTOR_CREATE_PENDING:"))
                            ))
                        .CountAsync();
                }
            }
            catch
            {
                // Keep sidebar rendering stable even when count fails.
            }

            // خدمات مخصّصة: تظهر إذا كانت مفعّلة من مدير النظام.
            var customServicesMenu = new List<SystemService>();
            try
            {
                customServicesMenu = await Db.SystemServices
                    .AsNoTracking()
                    .Where(s => s.IsActive && s.Key.StartsWith("CUSTOM:"))
                    .OrderBy(s => s.DisplayName)
                    .ToListAsync();
            }
            catch
            {
                // ignore - keep sidebar robust
            }

            <div class="nav-section">
                <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                    <i class="fas fa-th-large"></i>
                    <span>الرئيسية</span>
                    <i class="fas fa-chevron-down nav-section-chevron"></i>
                </div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Dashboard" ? "active" : "")"
                           asp-route="networkManager-dashboard">
                            <span class="nav-icon"><i class="fas fa-gauge-high"></i></span>
                            <span>لوحة التحكم</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Notifications" ? "active" : "")"
                           asp-route="networkManager-notifications">
                            <span class="nav-icon"><i class="fas fa-bell"></i></span>
                            <span>التنبيهات</span>
                            <span class="nav-badge" id="notificationsUnreadBadge" style="display: none;">0</span>
                        </a>
                    </li>
                    @if (canUseReports)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(controller == "Reports" ? "active" : "")"
                               asp-route="networkManager-reports" asp-route-action="Index">
                                <span class="nav-icon"><i class="fas fa-chart-bar"></i></span>
                                <span>التقارير</span>
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Features" ? "active" : "")"
                           asp-route="networkManager-features">
                            <span class="nav-icon"><i class="fas fa-plus-circle"></i></span>
                            <span>الخدمات المتاحة</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="nav-section">
                <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                    <i class="fas fa-coins"></i>
                    <span>المالية</span>
                    <i class="fas fa-chevron-down nav-section-chevron"></i>
                </div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Wallet" && action == "TopUp" ? "active" : "")"
                           asp-route="networkManager-wallet-topup">
                            <span class="nav-icon"><i class="fas fa-wallet"></i></span>
                            <span>تغذية رصيد</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Wallet" && action == "Transactions" ? "active" : "")"
                           asp-route="networkManager-wallet-transactions">
                            <span class="nav-icon"><i class="fas fa-list"></i></span>
                            <span>عمليات التعبئة</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Receipts" ? "active" : "")"
                           asp-route="networkManager-receipts"
                           asp-route-action="Index">
                            <span class="nav-icon"><i class="fas fa-receipt"></i></span>
                            <span>سجل القبض</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "CashBox" ? "active" : "")"
                           asp-route="networkManager-cashbox"
                           asp-route-action="Index">
                            <span class="nav-icon"><i class="fas fa-money-bill-wave"></i></span>
                            <span>الصندوق النقدي</span>
                        </a>
                    </li>
                </ul>
            </div>

            @if (customServicesMenu.Any())
            {
                <div class="nav-section">
                    <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                        <i class="fas fa-layer-group"></i>
                        <span>الخدمات</span>
                        <i class="fas fa-chevron-down nav-section-chevron"></i>
                    </div>
                    <ul class="nav-list">
                        @foreach (var s in customServicesMenu)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controller == "CustomServices" && (ViewContext.HttpContext.Request.Path.Value?.Contains(s.Key, StringComparison.OrdinalIgnoreCase) == true) ? "active" : "")"
                                   asp-route="networkManager-customService-index"
                                   asp-route-serviceKey="@s.Key">
                                    <span class="nav-icon"><i class="@(string.IsNullOrWhiteSpace(s.IconClass) ? "fas fa-layer-group" : s.IconClass)"></i></span>
                                    <span>@s.DisplayName</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (canUseNetworks)
            {
                <div class="nav-section">
                    <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                        <i class="fas fa-network-wired"></i>
                        <span>إدارة الشبكة</span>
                        <i class="fas fa-chevron-down nav-section-chevron"></i>
                    </div>
                    <ul class="nav-list">
                        <li class="nav-item">
                            <a class="nav-link @(controller == "Network" ? "active" : "")"
                               asp-route="networkManager-network" asp-route-action="Index">
                                <span class="nav-icon"><i class="fas fa-sitemap"></i></span>
                                <span>الشبكة</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "MaintenancePricing" ? "active" : "")"
                               asp-area="CompanyAdmin" asp-controller="MaintenancePricing" asp-action="Index">
                                <span class="nav-icon"><i class="fas fa-screwdriver-wrench"></i></span>
                                <span>تسعير الصيانة</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "RenewalRequests" ? "active" : "")"
                               asp-route="networkManager-renewalRequests" asp-route-action="Index">
                                <span class="nav-icon"><i class="fas fa-sync-alt"></i></span>
                                <span>طلبات تجديد من نقاط التحصيل</span>
                            </a>
                        </li>
                    </ul>
                </div>
            }

            @if (canUseMikroTikServers || canUseProfiles)
            {
                <div class="nav-section">
                    <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                        <i class="fas fa-cogs"></i>
                        <span>إدارة النظام</span>
                        <i class="fas fa-chevron-down nav-section-chevron"></i>
                    </div>
                    <ul class="nav-list">
                        @if (canUseProfiles)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Profile" ? "active" : "")"
                                   asp-route="networkManager-profile" asp-route-action="Index">
                                    <span class="nav-icon"><i class="fas fa-boxes"></i></span>
                                    <span>باقات السرعة</span>
                                </a>
                            </li>
                        }
                        @if (canUseMikroTikServers)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controller == "MikroTikServers" ? "active" : "")"
                                   asp-route="networkManager-mikrotikservers" asp-route-action="Index">
                                    <span class="nav-icon"><i class="fas fa-server"></i></span>
                                    <span>خوادم MikroTik</span>
                                </a>
                            </li>
                            @if (User.IsInRole(RoleNames.NetworkAdministrator))
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(controller == "MikroTikTraffic" ? "active" : "")"
                                       asp-route="networkManager-mikrotik-traffic">
                                        <span class="nav-icon"><i class="fas fa-chart-area"></i></span>
                                        <span>ترافك MikroTik (مباشر)</span>
                                    </a>
                                </li>
                            }
                        }
                    </ul>
                </div>
            }

            @if (canUseUsers || canUseCollectionPoints)
            {
                <div class="nav-section">
                    <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                        <i class="fas fa-users-cog"></i>
                        <span>المستخدمون</span>
                        <i class="fas fa-chevron-down nav-section-chevron"></i>
                    </div>
                    <ul class="nav-list">
                        @if (canUseUsers)
                        {
                            <li class="nav-item has-dropdown">
                                <div class="nav-link-toggle">
                                    <span class="nav-icon"><i class="fas fa-users"></i></span>
                                    <span>إدارة المستخدمين</span>
                                    <i class="fas fa-chevron-down nav-chevron"></i>
                                </div>
                                <ul class="nav-sublist">
                                    <li class="nav-item">
                                        <a class="nav-link nav-link-sub @(controller == "Admin" && currentType == "employees" ? "active" : "")"
                                           asp-route="networkManager-users-employees">
                                            <i class="fas fa-user-tie"></i>
                                            <span>الموظفون</span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link nav-link-sub @(controller == "Admin" && currentType == "clients" ? "active" : "")"
                                           asp-route="networkManager-users-clients">
                                            <i class="fas fa-user-friends"></i>
                                            <span>المشتركون</span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link nav-link-sub @(controller == "Admin" && currentType == "points" ? "active" : "")"
                                           asp-route="networkManager-users-collectionPoints">
                                            <i class="fas fa-store"></i>
                                            <span>نقاط البيع</span>
                                        </a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link nav-link-sub @(controller == "Admin" && string.IsNullOrEmpty(currentType) ? "active" : "")"
                                           asp-route="networkManager-users">
                                            <i class="fas fa-users"></i>
                                            <span>كل المستخدمين</span>
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-route="networkManager-addnewEmployee">
                                    <span class="nav-icon"><i class="fas fa-user-plus"></i></span>
                                    <span>إضافة موظف جديد</span>
                                </a>
                            </li>
                        }

                        @if (canUseCollectionPoints)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controller == "CollectionPoints" && action == "Create" ? "active" : "")"
                                   asp-route="networkManager-collectionpoints" asp-route-action="Create">
                                    <span class="nav-icon"><i class="fas fa-paper-plane"></i></span>
                                    <span>طلب إنشاء نقطة تحصيل</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controller == "CollectionPoints" && action == "TopUpRequests" ? "active" : "")"
                                   asp-route="networkManager-collectionpoints" asp-route-action="TopUpRequests">
                                    <span class="nav-icon"><i class="fas fa-wallet"></i></span>
                                    <span>طلبات تغذية رصيد نقاط التحصيل</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (canUseClients)
            {
                <div class="nav-section">
                    <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                        <i class="fas fa-user-friends"></i>
                        <span>العملاء</span>
                        <i class="fas fa-chevron-down nav-section-chevron"></i>
                    </div>
                    <ul class="nav-list">
                        <li class="nav-item">
                            @* Controller خارج الـ Area حالياً *@
                            <a class="nav-link @(controller == "Clients" ? "active" : "")"
                               asp-route="networkManager-clients" asp-route-action="Index">
                                <span class="nav-icon"><i class="fas fa-users"></i></span>
                                <span>إدارة العملاء</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "Clients" && action == "ContractTemplateSettings" ? "active" : "")"
                               asp-route="networkManager-clients" asp-route-action="ContractTemplateSettings">
                                <span class="nav-icon"><i class="fas fa-file-signature"></i></span>
                                <span>إعدادات عقد الانضمام</span>
                            </a>
                        </li>
                    </ul>
                </div>
            }

            @if (canUseSectors || canUseReceivers)
            {
                <div class="nav-section">
                    <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                        <i class="fas fa-microchip"></i>
                        <span>الأجهزة</span>
                        <i class="fas fa-chevron-down nav-section-chevron"></i>
                    </div>
                    <ul class="nav-list">
                        @if (canUseSectors)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Sector" ? "active" : "")"
                                   asp-route="networkManager-sector" asp-route-action="Index">
                                    <span class="nav-icon"><i class="fas fa-broadcast-tower"></i></span>
                                    <span>المرسلات (القطاعات)</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Sector" && action == "RadioEngineering" ? "active" : "")"
                                   asp-route="networkManager-sector" asp-route-action="RadioEngineering">
                                    <span class="nav-icon"><i class="fas fa-flask-vial"></i></span>
                                    <span>دراسة التحكم الراديوي</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Sector" && action == "RadioMonitoring" ? "active" : "")"
                                   asp-route="networkManager-sector" asp-route-action="RadioMonitoring">
                                    <span class="nav-icon"><i class="fas fa-wave-square"></i></span>
                                    <span>مراقبة القطاعات</span>
                                </a>
                            </li>
                        }
                        @if (canUseReceivers)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Receiver" ? "active" : "")"
                                   asp-route="networkManager-receiver" asp-route-action="Index">
                                    <span class="nav-icon"><i class="fas fa-satellite-dish"></i></span>
                                    <span>المستقبلات</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (canUseRequests)
            {
                <div class="nav-section">
                    <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                        <i class="fas fa-tasks"></i>
                        <span>إدارة الطلبات</span>
                        <i class="fas fa-chevron-down nav-section-chevron"></i>
                    </div>
                    <ul class="nav-list">
                        <li class="nav-item">
                            <a class="nav-link @(controller == "RequestsManagement" && action == "Index" ? "active" : "")"
                               asp-route="networkManager-requestsManagement" asp-route-action="Index">
                                <span class="nav-icon"><i class="fas fa-clipboard-list"></i></span>
                                <span>لوحة الطلبات</span>
                                <span class="nav-badge" id="pendingRequestsBadge" style="display: none;">0</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "RequestsManagement" && action == "SpeedChangeRequests" ? "active" : "")"
                               asp-route="networkManager-requestsManagement" asp-route-action="SpeedChangeRequests">
                                <span class="nav-icon"><i class="fas fa-tachometer-alt"></i></span>
                                <span>طلبات تغيير السرعة</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "RequestsManagement" && action == "MaintenanceRequests" ? "active" : "")"
                               asp-route="networkManager-requestsManagement" asp-route-action="MaintenanceRequests">
                                <span class="nav-icon"><i class="fas fa-wrench"></i></span>
                                <span>طلبات الصيانة</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "EmployeeServiceApprovals" ? "active" : "")"
                               asp-area="CompanyAdmin" asp-controller="EmployeeServiceApprovals" asp-action="Index">
                                <span class="nav-icon"><i class="fas fa-user-check"></i></span>
                                <span>موافقات طلبات الموظفين</span>
                                @if (pendingEmployeeApprovalsCount > 0)
                                {
                                    <span class="nav-badge">@pendingEmployeeApprovalsCount</span>
                                }
                            </a>
                        </li>
                    </ul>
                </div>
            }

            <div class="nav-section nav-section-account">
                <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                    <i class="fas fa-user-cog"></i>
                    <span>الحساب</span>
                    <i class="fas fa-chevron-down nav-section-chevron"></i>
                </div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Account" && action == "Profile" ? "active" : "")"
                           asp-route="networkManager-account-profile">
                            <span class="nav-icon"><i class="fas fa-user-circle"></i></span>
                            <span>الملف الشخصي</span>
                        </a>
                    </li>
                </ul>
            </div>
        }
    </nav>

</aside>

