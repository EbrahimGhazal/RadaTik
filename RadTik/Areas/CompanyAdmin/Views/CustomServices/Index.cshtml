@model IEnumerable<RadTik.Models.CustomServiceItem>
@{
    var service = ViewBag.Service as RadTik.Models.SystemService;
    var serviceKey = ViewBag.ServiceKey as string ?? "";
    ViewData["Title"] = ViewData["Title"] ?? (service?.DisplayName ?? "الخدمة");
}

<div class="page-header">
    <h1>
        <i class="@(string.IsNullOrWhiteSpace(service?.IconClass) ? "fas fa-layer-group" : service!.IconClass)"></i>
        @ViewData["Title"]
    </h1>
    <p class="text-muted mb-0">@service?.Description</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="content-grid">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h3 class="card-title mb-0">
                <i class="fas fa-list"></i>
                القائمة
            </h3>
            <a class="btn btn-primary" asp-area="CompanyAdmin" asp-controller="CustomServices" asp-action="Create" asp-route-serviceKey="@serviceKey">
                <i class="fas fa-plus"></i>
                إضافة
            </a>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>العنوان</th>
                            <th style="width: 170px;">تاريخ الإضافة</th>
                            <th style="width: 120px;">إجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td>
                                        <div><strong>@item.Title</strong></div>
                                        @if (!string.IsNullOrWhiteSpace(item.Body))
                                        {
                                            <div class="text-muted small">@item.Body</div>
                                        }
                                    </td>
                                    <td>@item.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>
                                        <a class="btn btn-sm btn-outline-primary"
                                           asp-area="CompanyAdmin" asp-controller="CustomServices" asp-action="Edit" asp-route-id="@item.Id">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="3" class="text-center text-muted py-4">لا توجد بيانات بعد</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

