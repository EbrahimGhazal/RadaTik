@model RadTik.Models.CustomServiceItem
@{
    var service = ViewBag.Service as RadTik.Models.SystemService;
    var serviceKey = ViewBag.ServiceKey as string ?? Model.ServiceKey ?? "";
    ViewData["Title"] = ViewData["Title"] ?? "تعديل";
}

<div class="page-header">
    <h1>
        <i class="fas fa-edit"></i>
        @ViewData["Title"]
    </h1>
    <p class="text-muted mb-0">@service?.DisplayName</p>
</div>

<div class="content-grid">
    <div class="card">
        <div class="card-body">
            <form method="post" asp-area="CompanyAdmin" asp-controller="CustomServices" asp-action="Edit">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="ServiceKey" />

                <div class="mb-3">
                    <label asp-for="Title" class="form-label"></label>
                    <input asp-for="Title" class="form-control" />
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Body" class="form-label"></label>
                    <textarea asp-for="Body" class="form-control" rows="4"></textarea>
                    <span asp-validation-for="Body" class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a class="btn btn-outline-secondary" asp-area="CompanyAdmin" asp-controller="CustomServices" asp-action="Index" asp-route-serviceKey="@serviceKey">رجوع</a>
                    <button type="submit" class="btn btn-primary">حفظ</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

