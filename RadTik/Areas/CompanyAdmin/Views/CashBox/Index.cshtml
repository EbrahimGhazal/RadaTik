@using RadTik.Models
@{
    ViewData["Title"] = "الصندوق النقدي";
    var cashBox = ViewBag.CashBox as CashBox;
    var ownerName = ViewBag.OwnerName as string ?? "الشبكة";
    var withdrawals = ViewBag.Withdrawals as List<CashBoxWithdrawal> ?? new List<CashBoxWithdrawal>();
    var deposits = ViewBag.Deposits as List<CashBoxDeposit> ?? new List<CashBoxDeposit>();
    var balance = cashBox?.Balance ?? 0m;
}

<div class="financial-page financial-cashbox-page">
    <div class="page-header d-flex justify-content-between align-items-start flex-wrap gap-3 mb-3">
        <div>
            <h1>
                <i class="fas fa-money-bill-wave"></i>
                الصندوق النقدي
            </h1>
            <p class="text-muted mb-0">إدارة النقد المباشر: إيداع، سحب، وسجل حركة مفصل.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a class="btn btn-outline-secondary micro-btn" asp-route="networkManager-receipts" asp-route-action="Index">
                <i class="fas fa-receipt"></i>
                سجل القبض
            </a>
            <a class="btn btn-primary micro-btn" asp-route="networkManager-wallet-topup">
                <i class="fas fa-plus-circle"></i>
                تغذية رصيد
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="row g-3 mb-3">
        <div class="col-md-4">
            <div class="card financial-stat-card financial-stat-accent h-100">
                <div class="card-body">
                    <div class="financial-stat-label">رصيد الصندوق الحالي</div>
                    <div class="financial-stat-value">@balance.ToString("N2")</div>
                    <div class="financial-stat-meta">ل.س - @ownerName</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card financial-stat-card h-100">
                <div class="card-body">
                    <div class="financial-stat-label">عدد عمليات الإيداع</div>
                    <div class="financial-stat-value text-success">@deposits.Count</div>
                    <div class="financial-stat-meta">آخر 50 عملية في الجدول</div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card financial-stat-card h-100">
                <div class="card-body">
                    <div class="financial-stat-label">عدد عمليات السحب</div>
                    <div class="financial-stat-value text-danger">@withdrawals.Count</div>
                    <div class="financial-stat-meta">آخر 50 عملية في الجدول</div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <div class="col-xl-4">
            <div class="card financial-form-card mb-4">
                <div class="card-header">
                    <h6 class="card-title mb-0"><i class="fas fa-hand-holding-usd text-success"></i> إيداع في الصندوق</h6>
                </div>
                <div class="card-body">
                    <form asp-area="CompanyAdmin" asp-controller="CashBox" asp-action="Deposit" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <label class="form-label">المبلغ (ل.س)</label>
                            <input type="number" name="amount" class="form-control" min="0.01" step="0.01" required placeholder="0.00" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">ملاحظات (اختياري)</label>
                            <input type="text" name="notes" class="form-control" placeholder="سبب الإيداع" />
                        </div>
                        <button type="submit" class="btn btn-success w-100 micro-btn">
                            <i class="fas fa-plus"></i> إيداع
                        </button>
                    </form>
                </div>
            </div>

            <div class="card financial-form-card">
                <div class="card-header">
                    <h6 class="card-title mb-0"><i class="fas fa-minus-circle text-danger"></i> سحب من الصندوق</h6>
                </div>
                <div class="card-body">
                    <form asp-area="CompanyAdmin" asp-controller="CashBox" asp-action="Withdraw" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-2">
                            <label class="form-label">المبلغ (ل.س)</label>
                            <input type="number" name="amount" class="form-control" min="0.01" step="0.01" required placeholder="0.00" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">ملاحظات / سبب السحب (اختياري)</label>
                            <input type="text" name="notes" class="form-control" placeholder="سبب السحب" />
                        </div>
                        <button type="submit" class="btn btn-danger w-100 micro-btn" @(balance < 0.01m ? "disabled" : "")>
                            <i class="fas fa-hand-holding"></i> سحب
                        </button>
                        @if (balance < 0.01m)
                        {
                            <small class="text-muted d-block mt-1">لا يوجد رصيد كاف للسحب حاليا.</small>
                        }
                    </form>
                </div>
            </div>
        </div>

        <div class="col-xl-8">
            <div class="card financial-table-card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="card-title mb-0"><i class="fas fa-history text-warning"></i> سجلات السحب</h5>
                    <span class="text-muted small">@(withdrawals.Count > 50 ? "عرض آخر 50 عملية" : $"{withdrawals.Count} عملية")</span>
                </div>
                <div class="card-body p-0">
                    @if (withdrawals.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 financial-table">
                                <thead>
                                    <tr>
                                        <th>التاريخ</th>
                                        <th>المبلغ</th>
                                        <th>الرصيد قبل</th>
                                        <th>الرصيد بعد</th>
                                        <th>من نفذ</th>
                                        <th>ملاحظات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var w in withdrawals.Take(50))
                                    {
                                        <tr class="financial-row is-danger">
                                            <td data-label="التاريخ">@w.WithdrawnAt.ToString("yyyy/MM/dd HH:mm")</td>
                                            <td data-label="المبلغ" class="text-danger">-@w.Amount.ToString("N2")</td>
                                            <td data-label="الرصيد قبل">@w.BalanceBefore.ToString("N2")</td>
                                            <td data-label="الرصيد بعد">@w.BalanceAfter.ToString("N2")</td>
                                            <td data-label="من نفذ">@(w.WithdrawnByUser?.FullName ?? w.WithdrawnByUser?.UserName ?? w.WithdrawnByUserId)</td>
                                            <td data-label="ملاحظات" class="text-muted small">@(w.Notes ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted p-3 mb-0">لا توجد عمليات سحب حتى الآن.</p>
                    }
                </div>
            </div>

            <div class="card financial-table-card">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="card-title mb-0"><i class="fas fa-piggy-bank text-success"></i> سجلات الإيداع</h5>
                    <span class="text-muted small">@(deposits.Count > 50 ? "عرض آخر 50 عملية" : $"{deposits.Count} عملية")</span>
                </div>
                <div class="card-body p-0">
                    @if (deposits.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 financial-table">
                                <thead>
                                    <tr>
                                        <th>التاريخ</th>
                                        <th>المبلغ</th>
                                        <th>الرصيد قبل</th>
                                        <th>الرصيد بعد</th>
                                        <th>من نفذ</th>
                                        <th>ملاحظات</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in deposits.Take(50))
                                    {
                                        <tr class="financial-row is-success">
                                            <td data-label="التاريخ">@d.DepositedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                            <td data-label="المبلغ" class="text-success">+@d.Amount.ToString("N2")</td>
                                            <td data-label="الرصيد قبل">@d.BalanceBefore.ToString("N2")</td>
                                            <td data-label="الرصيد بعد">@d.BalanceAfter.ToString("N2")</td>
                                            <td data-label="من نفذ">@(d.DepositedByUser?.FullName ?? d.DepositedByUser?.UserName ?? d.DepositedByUserId)</td>
                                            <td data-label="ملاحظات" class="text-muted small">@(d.Notes ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <p class="text-muted p-3 mb-0">لا توجد عمليات إيداع حتى الآن.</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
