@model IEnumerable<RadTik.Models.Client>
@{
    ViewData["Title"] = "اشتراكات تنتهي خلال 3 أيام";
    var totalExpiring = ViewBag.TotalExpiring ?? 0;
    var expiringToday = ViewBag.ExpiringToday ?? 0;
    var expiringTomorrow = ViewBag.ExpiringTomorrow ?? 0;
    var expiringIn2Days = ViewBag.ExpiringIn2Days ?? 0;
    var expiringIn3Days = ViewBag.ExpiringIn3Days ?? 0;
}

<!-- Page Header -->
<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="fas fa-clock text-warning"></i>
            @ViewData["Title"]
        </h1>
        <div class="page-actions">
            <a asp-action="ExpiredAccounts" class="btn btn-danger btn-sm">
                <i class="fas fa-exclamation-triangle"></i> المنتهية
            </a>
            <a asp-action="Index" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-right"></i> العودة
            </a>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle alert-icon"></i>
        <div class="alert-content">@TempData["Success"]</div>
        <button class="alert-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle alert-icon"></i>
        <div class="alert-content">@TempData["Error"]</div>
        <button class="alert-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>
    </div>
}

<!-- Compact Statistics Bar -->
<div class="stats-bar">
    <div class="stat-item stat-warning">
        <div class="stat-icon-mini"><i class="fas fa-hourglass-half"></i></div>
        <div class="stat-data">
            <span class="stat-number">@totalExpiring</span>
            <span class="stat-label">إجمالي</span>
        </div>
    </div>
    
    <div class="stat-divider"></div>
    
    <div class="stat-item stat-danger">
        <div class="stat-icon-mini"><i class="fas fa-fire"></i></div>
        <div class="stat-data">
            <span class="stat-number">@expiringToday</span>
            <span class="stat-label">اليوم!</span>
        </div>
    </div>
    
    <div class="stat-item stat-orange">
        <div class="stat-icon-mini"><i class="fas fa-calendar-day"></i></div>
        <div class="stat-data">
            <span class="stat-number">@expiringTomorrow</span>
            <span class="stat-label">غداً</span>
        </div>
    </div>
    
    <div class="stat-item stat-yellow">
        <div class="stat-icon-mini"><i class="fas fa-calendar-week"></i></div>
        <div class="stat-data">
            <span class="stat-number">@expiringIn2Days</span>
            <span class="stat-label">بعد يومين</span>
        </div>
    </div>
    
    <div class="stat-item stat-info">
        <div class="stat-icon-mini"><i class="fas fa-calendar-alt"></i></div>
        <div class="stat-data">
            <span class="stat-number">@expiringIn3Days</span>
            <span class="stat-label">بعد 3 أيام</span>
        </div>
    </div>
</div>

<!-- Expiring Accounts Table -->
<div class="card">
    <div class="card-header" style="background: linear-gradient(135deg, var(--warning) 0%, #F57C00 100%); color: white;">
        <h3 class="card-title" style="color: white;">
            <i class="fas fa-list"></i>
            اشتراكات تحتاج تجديد عاجل
        </h3>
    </div>
    <div class="card-body" style="padding: 0;">
        @if (Model.Any())
        {
            <div class="table-container">
                <table class="table" id="expiringTable">
                    <thead>
                        <tr>
                            <th>العميل</th>
                            <th>اسم المستخدم</th>
                            <th>الهاتف</th>
                            <th>تاريخ الانتهاء</th>
                            <th>متبقي</th>
                            <th>الباقة</th>
                            <th>إجراءات التمديد</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var client in Model)
                        {
                            var daysRemaining = (client.AccountExpirationDate!.Value.Date - DateTime.Now.Date).Days;
                            var urgencyClass = daysRemaining <= 0 ? "urgency-critical" : 
                                              daysRemaining == 1 ? "urgency-high" : 
                                              daysRemaining == 2 ? "urgency-medium" : "urgency-low";
                            <tr class="@urgencyClass">
                                <td>
                                    <div class="client-info">
                                        <div class="client-avatar @(daysRemaining <= 0 ? "critical" : daysRemaining == 1 ? "high" : "warning")">
                                            @(client.Name?.Substring(0, 1).ToUpper() ?? "?")
                                        </div>
                                        <div>
                                            <div class="client-name">@client.Name</div>
                                            @if (!string.IsNullOrEmpty(client.SID))
                                            {
                                                <div class="client-sid">#@client.SID</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td><code>@client.UserName</code></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(client.PhoneNumber))
                                    {
                                        <a href="tel:@client.PhoneNumber" class="phone-link">
                                            <i class="fas fa-phone"></i> @client.PhoneNumber
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(daysRemaining <= 0 ? "badge-danger" : "badge-warning")">
                                        @client.AccountExpirationDate.Value.ToString("yyyy/MM/dd")
                                    </span>
                                </td>
                                <td>
                                    @if (daysRemaining <= 0)
                                    {
                                        <span class="days-badge days-critical">
                                            <i class="fas fa-fire"></i> اليوم!
                                        </span>
                                    }
                                    else if (daysRemaining == 1)
                                    {
                                        <span class="days-badge days-high">
                                            <i class="fas fa-exclamation"></i> غداً
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="days-badge days-medium">
                                            <i class="fas fa-clock"></i> @daysRemaining أيام
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (client.Profile != null)
                                    {
                                        <span class="badge badge-info">@client.Profile.Name</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a asp-action="Details" asp-route-id="@client.Id" class="btn btn-sm btn-icon btn-info" title="تفاصيل">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (User.IsInRole("SystemAdministrator"))
                                        {
                                            <form asp-action="QuickExtend" method="post" style="display: inline;">
                                                <input type="hidden" name="id" value="@client.Id" />
                                                <input type="hidden" name="days" value="3" />
                                                <button type="submit" class="btn btn-sm btn-warning" title="تمديد 3 أيام"
                                                        onclick="return confirm('تمديد 3 أيام للعميل @client.Name؟')">
                                                    <i class="fas fa-plus"></i> 3 أيام
                                                </button>
                                            </form>
                                            <form asp-action="RenewTo8thNextMonth" method="post" style="display: inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@client.Id" />
                                                <button type="submit" class="btn btn-sm btn-success" title="تمديد لـ 8 الشهر القادم"
                                                        onclick="return confirm('تمديد للعميل @client.Name حتى 8 الشهر القادم؟')">
                                                    <i class="fas fa-calendar-check"></i> 8 الشهر
                                                </button>
                                            </form>
                                            <a asp-action="RenewSubscription" asp-route-id="@client.Id" class="btn btn-sm btn-primary" title="تجديد مخصص">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon text-success">
                    <i class="fas fa-check-circle"></i>
                </div>
                <h3>لا توجد اشتراكات تنتهي قريباً</h3>
                <p class="text-muted">جميع الاشتراكات لديها أكثر من 3 أيام متبقية</p>
            </div>
        }
    </div>
</div>

<style>
    .page-header {
        margin-bottom: var(--spacing-lg);
    }
    
    .page-header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--spacing-md);
    }
    
    .page-title {
        font-size: var(--font-2xl);
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }
    
    .page-actions {
        display: flex;
        gap: var(--spacing-sm);
        flex-wrap: wrap;
    }

    .stats-bar {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-sm);
        padding: var(--spacing-md);
        background: var(--bg-card);
        border-radius: var(--radius);
        box-shadow: var(--shadow-sm);
        margin-bottom: var(--spacing-lg);
        align-items: center;
    }
    
    .stat-item {
        display: flex;
        align-items: center;
        gap: var(--spacing-xs);
        padding: var(--spacing-xs) var(--spacing-sm);
        border-radius: var(--radius-sm);
        background: var(--bg-hover);
        min-width: 80px;
    }
    
    .stat-icon-mini {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        color: white;
    }
    
    .stat-data {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
    }
    
    .stat-number {
        font-size: var(--font-xl);
        font-weight: 700;
    }
    
    .stat-label {
        font-size: 11px;
        color: var(--text-muted);
    }
    
    .stat-divider {
        width: 1px;
        height: 36px;
        background: var(--border-color);
        margin: 0 var(--spacing-xs);
    }
    
    .stat-warning .stat-icon-mini { background: var(--warning); }
    .stat-warning .stat-number { color: var(--warning); }
    
    .stat-danger .stat-icon-mini { background: var(--danger); }
    .stat-danger .stat-number { color: var(--danger); }
    
    .stat-orange .stat-icon-mini { background: #FF5722; }
    .stat-orange .stat-number { color: #FF5722; }
    
    .stat-yellow .stat-icon-mini { background: #FFC107; }
    .stat-yellow .stat-number { color: #FFA000; }
    
    .stat-info .stat-icon-mini { background: var(--info); }
    .stat-info .stat-number { color: var(--info); }

    .client-info {
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }
    
    .client-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        color: white;
        font-size: var(--font-sm);
    }
    
    .client-avatar.critical {
        background: var(--danger);
        animation: pulse-critical 1s infinite;
    }
    
    .client-avatar.high {
        background: #FF5722;
    }
    
    .client-avatar.warning {
        background: var(--warning);
    }
    
    .client-name {
        font-weight: 600;
        font-size: var(--font-sm);
    }
    
    .client-sid {
        font-size: 11px;
        color: var(--text-muted);
    }

    .phone-link {
        color: var(--info);
        text-decoration: none;
        font-size: var(--font-sm);
    }
    
    .phone-link:hover {
        text-decoration: underline;
    }

    .days-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 10px;
        border-radius: 12px;
        font-size: 12px;
        font-weight: 600;
    }
    
    .days-critical {
        background: rgba(244, 67, 54, 0.15);
        color: var(--danger);
        animation: pulse-critical 1.5s infinite;
    }
    
    .days-high {
        background: rgba(255, 87, 34, 0.15);
        color: #FF5722;
    }
    
    .days-medium {
        background: rgba(255, 152, 0, 0.15);
        color: var(--warning);
    }

    .urgency-critical {
        background: rgba(244, 67, 54, 0.08) !important;
    }
    
    .urgency-high {
        background: rgba(255, 87, 34, 0.05) !important;
    }
    
    .urgency-medium {
        background: rgba(255, 152, 0, 0.03) !important;
    }

    .action-buttons {
        display: flex;
        gap: 4px;
        flex-wrap: wrap;
    }
    
    .btn-icon {
        width: 28px;
        height: 28px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .empty-state {
        text-align: center;
        padding: 3rem;
    }
    
    .empty-icon {
        font-size: 4rem;
        margin-bottom: 1rem;
    }

    @@keyframes pulse-critical {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.7; transform: scale(1.05); }
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#expiringTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/ar.json'
                },
                order: [[4, 'asc']],
                pageLength: 25
            });
        });
    </script>
}
