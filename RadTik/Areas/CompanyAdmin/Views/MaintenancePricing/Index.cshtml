@model RadTik.Areas.CompanyAdmin.ViewModels.MaintenancePricingPageViewModel
@{
    ViewData["Title"] = "تسعير الصيانة";
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
    <h1><i class="fas fa-screwdriver-wrench"></i> تسعير الصيانة الثابت</h1>
    <a asp-route="networkManager-dashboard" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-right"></i> رجوع
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label mb-1">نوع الشبكة للتسعير</label>
                <form method="get" asp-action="Index" id="networkScopeForm">
                    <select class="form-select" name="networkScope" onchange="this.form.submit()">
                        @if (Model.NetworkScope == "main")
                        {
                            <option value="main" selected>الشبكة الرئيسية</option>
                        }
                        else
                        {
                            <option value="main">الشبكة الرئيسية</option>
                        }
                        @if (Model.CanUseCurrentNetworkScope)
                        {
                            if (Model.NetworkScope == "current")
                            {
                                <option value="current" selected>الشبكة الحالية (الفرعية)</option>
                            }
                            else
                            {
                                <option value="current">الشبكة الحالية (الفرعية)</option>
                            }
                        }
                    </select>
                </form>
            </div>
            <div class="col-md-8">
                <div class="text-muted small">التسعير الحالي يطبق على:</div>
                <div class="fw-semibold">
                    @Model.EffectiveNetworkName
                    @if (Model.NetworkScope == "main")
                    {
                        <span class="badge text-bg-primary ms-2">رئيسية</span>
                    }
                    else
                    {
                        <span class="badge text-bg-info ms-2">حالية/فرعية</span>
                    }
                </div>
                @if (Model.CanUseCurrentNetworkScope)
                {
                    <form method="post" asp-action="CopyFromOtherScope" class="mt-2"
                          onsubmit="return confirm('سيتم نسخ الأسعار من النطاق الآخر إلى النطاق الحالي المعروض. هل تريد المتابعة؟');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="networkScope" value="@Model.NetworkScope" />
                        <button type="submit" class="btn btn-outline-primary btn-sm">
                            <i class="fas fa-copy"></i>
                            نسخ الأسعار من @(Model.NetworkScope == "main" ? "الشبكة الحالية (الفرعية)" : "الشبكة الرئيسية")
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <h5 class="mb-0">أسعار طرق الحل</h5>
            <button type="submit" form="maintenancePricingBulkForm" class="btn btn-primary btn-sm">
                <i class="fas fa-floppy-disk"></i> حفظ كل الأسعار مرة واحدة
            </button>
        </div>
    </div>
    <div class="card-body p-0">
        <form asp-action="SaveAll" method="post" id="maintenancePricingBulkForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="NetworkScope" value="@Model.NetworkScope" />
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead>
                        <tr>
                            <th>طريقة الحل</th>
                            <th>السعر الثابت (ل.س.جديدة)</th>
                            <th>نشط</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Rows.Count; i++)
                        {
                            var row = Model.Rows[i];
                            <tr>
                                <td>
                                    @row.SolutionName
                                    <input type="hidden" name="Rows[@i].Type" value="@row.Type" />
                                </td>
                                <td>
                                    <input type="number"
                                           name="Rows[@i].AmountSyp"
                                           min="0"
                                           step="0.01"
                                           class="form-control"
                                           style="max-width:220px"
                                           value="@row.AmountSyp.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                                </td>
                                <td>
                                    <div class="form-check mb-0">
                                        <input type="hidden" name="Rows[@i].IsActive" value="false" />
                                        <input class="form-check-input" type="checkbox" name="Rows[@i].IsActive" value="true" @(row.IsActive ? "checked" : "") />
                                        <label class="form-check-label">مفعل</label>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </form>
    </div>
</div>
