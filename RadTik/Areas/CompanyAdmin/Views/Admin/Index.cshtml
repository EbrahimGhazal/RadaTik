@model List<RadTik.Controllers.AdminUserListItem>

@{
    ViewData["Title"] = "إدارة المستخدمين";
    var currentType = ((ViewBag.Type as string) ?? "").ToLowerInvariant();
    var isEmployeesView = string.Equals(currentType, "employees", StringComparison.OrdinalIgnoreCase);
    var filterTitle = (ViewBag.FilterTitle as string) ?? "المستخدمين";
    var searchValue = (ViewBag.Search as string) ?? string.Empty;

    var listRouteName = currentType switch
    {
        "employees" => "networkManager-users-employees",
        "points" => "networkManager-users-collectionPoints",
        _ => "networkManager-users"
    };

    var returnUrl = Url.RouteUrl(listRouteName, new { q = searchValue }) ?? Url.RouteUrl(listRouteName);
    var totalUsers = Model?.Count ?? 0;
    var activeUsers = Model?.Count(u => u.IsActive) ?? 0;
    var inactiveUsers = totalUsers - activeUsers;
    var isNetworkAdmin = User.IsInRole("NetworkAdministrator");
}

<div class="users-hero card border-0 shadow-sm mb-3 @(isEmployeesView ? "users-hero-employees" : "")">
    <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1 class="mb-1 users-title">
            <i class="fas fa-users-cog"></i>
                @ViewData["Title"] - @filterTitle
            </h1>
            <p class="text-muted mb-0">
                عرض منظم ومُوحّد للمستخدمين المرتبطين بالشبكة الحالية.
            </p>
        </div>
        <div class="d-flex gap-2">
            @if (isEmployeesView)
            {
                <a class="btn btn-primary users-primary-btn"
                   asp-route="networkManager-addnewEmployee"
                   asp-route-returnUrl="@Url.RouteUrl("networkManager-users-employees")">
                    <i class="fas fa-user-plus"></i> إضافة موظف
                </a>
            }
        </div>
    </div>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-4">
        <div class="card users-stat-card total h-100">
            <div class="card-body">
                <div class="users-stat-label">إجمالي @filterTitle</div>
                <div class="users-stat-value">@totalUsers</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card users-stat-card active h-100">
            <div class="card-body">
                <div class="users-stat-label">الحسابات النشطة</div>
                <div class="users-stat-value">@activeUsers</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card users-stat-card inactive h-100">
            <div class="card-body">
                <div class="users-stat-label">الحسابات المجمّدة</div>
                <div class="users-stat-value">@inactiveUsers</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3 border-0 shadow-sm">
    <div class="card-body">
        <form method="get" asp-route="@listRouteName" class="row g-2 align-items-end">
            <div class="col-lg-7">
                <label class="form-label">بحث سريع</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="fas fa-search"></i></span>
                    <input type="text" name="q" value="@searchValue" class="form-control"
                           placeholder="الاسم، اسم المستخدم، البريد الإلكتروني، رقم الجوال..." />
                </div>
            </div>
            <div class="col-lg-5 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-filter"></i> تطبيق
                </button>
                <a asp-route="@listRouteName" class="btn btn-outline-secondary">
                    <i class="fas fa-undo"></i> إعادة تعيين
                </a>
            </div>
        </form>
    </div>
</div>

<div class="alert alert-info border-0 shadow-sm mb-3 users-db-note @(isEmployeesView ? "users-db-note-employees" : "")" role="alert">
    <i class="fas fa-database me-2"></i>
    ملاحظة: العمليات في هذا الجدول تتم على قاعدة البيانات فقط ولا تنفذ أي إجراء مباشر على سيرفر MikroTik. مدير الشركة يملك كامل الصلاحيات، بينما الموظف يملك فقط الصلاحيات التي يحددها له مدير الشركة.
</div>

<div class="card users-table-card border-0 shadow-sm @(isEmployeesView ? "users-table-card-employees" : "")">
    <div class="card-body">
        <div class="table-responsive users-table-wrap">
            <table class="table table-hover align-middle users-table">
                <thead class="table-light">
                    <tr>
                        <th>الاسم الكامل</th>
                        <th>رقم الجوال</th>
                        <th>الدور</th>
                        <th>الحالة</th>
                        <th class="text-nowrap">الإجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var u in Model)
                        {
                            var roles = string.IsNullOrWhiteSpace(u.Roles)
                                ? Array.Empty<string>()
                                : u.Roles.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                            var canManageEmployee = roles.Contains("CompanyEmployee") || roles.Contains("EmployeeLegacy");
                            var canManageRow = isNetworkAdmin || canManageEmployee;

                            <tr>
                                <td class="fw-semibold">@(string.IsNullOrWhiteSpace(u.FullName) ? "-" : u.FullName)</td>
                                <td>@(string.IsNullOrWhiteSpace(u.PhoneNumber) ? "-" : u.PhoneNumber)</td>
                                <td>
                                    @if (roles.Length == 0)
                                    {
                                        <span>-</span>
                                    }
                                    else
                                    {
                                        foreach (var role in roles)
                                        {
                                            var roleClass = role switch
                                            {
                                                "CompanyEmployee" or "EmployeeLegacy" => "text-bg-primary",
                                                "CollectionPoint" => "text-bg-warning",
                                                "Client" => "text-bg-info",
                                                _ => "text-bg-secondary"
                                            };
                                            <span class="badge user-role-badge @roleClass">@role</span>
                                        }
                                    }
                                </td>
                                <td>
                                    @if (u.IsActive)
                                    {
                                        <span class="badge users-status-badge bg-success-subtle text-success-emphasis border border-success-subtle">نشط</span>
                                    }
                                    else
                                    {
                                        <span class="badge users-status-badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">مجمّد</span>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    <div class="d-flex gap-2 flex-wrap users-actions">
                                        <a class="btn btn-sm btn-outline-info users-action-btn users-action-icon-btn users-action-btn-info"
                                           asp-area="CompanyAdmin"
                                           asp-controller="Admin"
                                           asp-action="DetailsEmployee"
                                           asp-route-id="@u.Id"
                                           asp-route-returnUrl="@returnUrl"
                                           title="تفاصيل"
                                           aria-label="تفاصيل">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        @if (canManageRow)
                                        {
                                            <a class="btn btn-sm btn-outline-primary users-action-btn users-action-icon-btn users-action-btn-primary"
                                               asp-route="networkManager-employee-edit"
                                               asp-route-id="@u.Id"
                                               asp-route-returnUrl="@returnUrl"
                                               title="تعديل"
                                               aria-label="تعديل">
                                                <i class="fas fa-edit"></i>
                                            </a>

                                            <form asp-area="CompanyAdmin" asp-controller="Admin" asp-action="ToggleEmployeeStatus" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@u.Id" />
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                @if (u.IsActive)
                                                {
                                                    <button type="submit" class="btn btn-sm btn-outline-secondary users-action-btn users-action-icon-btn users-action-btn-neutral"
                                                            onclick="return confirm('هل تريد تجميد حساب الموظف؟');"
                                                            title="تجميد"
                                                            aria-label="تجميد">
                                                        <i class="fas fa-user-slash"></i>
                                                    </button>
                                                }
                                                else
                                                {
                                                    <button type="submit" class="btn btn-sm btn-success users-action-btn users-action-icon-btn users-action-btn-success"
                                                            onclick="return confirm('هل تريد تفعيل حساب الموظف؟');"
                                                            title="تفعيل"
                                                            aria-label="تفعيل">
                                                        <i class="fas fa-user-check"></i>
                                                    </button>
                                                }
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="badge text-bg-light border align-self-center">التعديل/التجميد غير متاح لهذا الدور</span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted">
                                لا يوجد مستخدمون ضمن هذه الشبكة.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .users-hero {
        background: linear-gradient(135deg, #f8fbff 0%, #eef5ff 100%);
    }

    .users-hero-employees {
        background: linear-gradient(135deg, #f8fbff 0%, #eef5ff 45%, #f5faff 100%);
    }

    .users-title {
        font-weight: 700;
        color: #1b2a4b;
    }

    .users-stat-card {
        border: 1px solid #e9ecef;
        border-radius: 0.9rem;
    }

    .users-stat-label {
        color: #6c757d;
        font-size: 0.9rem;
    }

    .users-stat-value {
        font-size: 1.6rem;
        font-weight: 700;
        margin-top: 0.25rem;
    }

    .users-stat-card.total .users-stat-value {
        color: #0d6efd;
    }

    .users-stat-card.active .users-stat-value {
        color: #198754;
    }

    .users-stat-card.inactive .users-stat-value {
        color: #6c757d;
    }

    .users-table-card {
        overflow: hidden;
    }

    .users-table-card-employees {
        border: 1px solid #e8eef8;
    }

    .users-db-note {
        background: linear-gradient(135deg, #eef7ff 0%, #f7fbff 100%);
        color: #24496e;
    }

    .users-db-note-employees {
        border-inline-start: 4px solid #2563eb;
    }

    .users-table-wrap {
        border: 1px solid #e6edf6;
        border-radius: 0.9rem;
        background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
    }

    .users-table thead th {
        background: #f8fafc;
        color: #344054;
        font-weight: 700;
        border-bottom: 1px solid #dbe4f0;
        position: sticky;
        top: 0;
        z-index: 2;
    }

    .users-table td,
    .users-table th {
        padding: 0.68rem 0.8rem;
        white-space: nowrap;
        vertical-align: middle;
    }

    .users-table tbody tr:hover {
        background-color: #f7fbff;
    }

    .users-status-badge {
        font-weight: 600;
        letter-spacing: 0.1px;
        padding: 0.36rem 0.56rem;
    }

    .user-role-badge {
        margin-inline-end: 0.25rem;
        margin-bottom: 0.2rem;
        padding: 0.38rem 0.55rem;
        border-radius: 0.65rem;
        font-weight: 500;
    }

    .users-actions {
        min-width: 235px;
    }

    .users-action-btn {
        border-radius: 0.65rem;
        font-weight: 500;
        box-shadow: none;
    }

    .users-action-icon-btn {
        width: 2.15rem;
        height: 2.15rem;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .users-action-btn-info:hover {
        background: #e9f4ff;
        border-color: #9ac7ff;
    }

    .users-action-btn-primary:hover {
        background: #edf4ff;
    }

    .users-action-btn-neutral:hover {
        background: #f3f4f6;
    }

    .users-action-btn-success {
        border-color: #198754;
    }

    .users-primary-btn {
        border-radius: 0.7rem;
        font-weight: 600;
    }

    @@media (max-width: 992px) {
        .users-table td,
        .users-table th {
            padding: 0.55rem 0.62rem;
            font-size: 0.88rem;
        }

        .users-actions {
            min-width: 0;
        }
    }
</style>

