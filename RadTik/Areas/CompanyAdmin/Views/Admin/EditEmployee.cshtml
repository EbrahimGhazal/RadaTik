@model RadTik.ViewModels.Admin.EditEmployeeViewModel

@{
    ViewData["Title"] = "تعديل موظف";
}

<div class="employee-edit-page">
<div class="employee-edit-hero card border-0 shadow-sm mb-3">
    <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3">
        <div>
            <h1 class="mb-1 employee-edit-title">
                <i class="fas fa-user-edit"></i>
                @ViewData["Title"]
            </h1>
            <p class="text-muted mb-0">تعديل بيانات الموظف وصلاحياته التشغيلية لكل خدمة مفعّلة للشركة.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary"
               href="@(string.IsNullOrWhiteSpace(Model.ReturnUrl) ? (Url.RouteUrl("networkManager-users-employees") ?? "/networkManager/Users/Employee") : Model.ReturnUrl)">
                <i class="fas fa-arrow-right"></i> رجوع
            </a>
        </div>
    </div>
</div>

<div class="alert alert-info border-0 shadow-sm employee-edit-note" role="alert">
    <i class="fas fa-circle-info me-2"></i>
    مدير الشركة يملك كامل الصلاحيات. أدناه تظهر الخدمات المفعّلة للشركة فقط، وتُمنح صلاحيات الموظف بشكل مقيد حسب سياسة الشركة.
</div>

<div class="card border-0 shadow-sm employee-edit-form-card">
    <div class="card-body">
        <form asp-area="CompanyAdmin" asp-controller="Admin" asp-action="EditEmployee" method="post" class="row g-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="col-12">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            </div>

            <div class="col-md-4">
                <label asp-for="UserName" class="form-label"></label>
                <input asp-for="UserName" class="form-control" autocomplete="off" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="off" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="col-md-4">
                <label asp-for="PhoneNumber" class="form-label"></label>
                <input asp-for="PhoneNumber" class="form-control" autocomplete="off" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" autocomplete="off" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="col-md-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="NewPassword" class="text-danger"></span>
                <div class="form-text">اتركها فارغة إذا لا تريد تغيير كلمة المرور.</div>
            </div>

            <div class="col-md-3">
                <label asp-for="ConfirmNewPassword" class="form-label"></label>
                <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
            </div>

            <div class="col-12">
                <div class="form-check">
                    <input class="form-check-input" asp-for="IsActive" />
                    <label class="form-check-label" asp-for="IsActive"></label>
                </div>
            </div>

            <div class="col-12">
                <hr class="my-2" />
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <h5 class="mb-0"><i class="fas fa-key"></i> صلاحيات الخدمات المفعّلة</h5>
                    <div class="d-flex gap-2 align-items-center">
                        <span class="small text-muted">صلاحيات محددة: <strong id="permSelectedCount">0</strong></span>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="permSelectAll">
                            تحديد الكل
                        </button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" id="permClearAll">
                            إلغاء الكل
                        </button>
                    </div>
                </div>
                <div class="alert alert-info mt-2 mb-2">
                    <i class="fas fa-circle-info me-1"></i>
                    <strong>سياسة منح الصلاحيات للموظف:</strong>
                    <ul class="mb-0 mt-1">
                        <li>المرسلات والمستقبلات والعملاء: العرض مباشر، أمّا الإضافة والتعديل فتتطلب موافقة مدير الشركة.</li>
                        <li>المخدمات (MikroTik): مجمّدة حالياً للموظفين.</li>
                        <li>طلبات الصيانة: تعمل كما هي حالياً.</li>
                        <li>طلبات التركيب: متاحة للعرض فقط.</li>
                    </ul>
                </div>

                <partial name="_EmployeePermissionMatrix" model="Model.SelectedPermissionIds" />
            </div>

            <div class="col-12 d-flex gap-2 justify-content-end">
                <a class="btn btn-outline-secondary"
                   href="@(string.IsNullOrWhiteSpace(Model.ReturnUrl) ? Url.Action("Index","Admin", new { type = "employees" }) : Model.ReturnUrl)">
                    إلغاء
                </a>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i> حفظ التغييرات
                </button>
            </div>
        </form>
    </div>
</div>
</div>

<style>
    .employee-edit-hero {
        background: linear-gradient(135deg, #f8fbff 0%, #eef5ff 100%);
    }

    .employee-edit-title {
        font-weight: 700;
        color: #1b2a4b;
    }

    .employee-edit-note {
        background: linear-gradient(135deg, #eef7ff 0%, #f7fbff 100%);
        color: #24496e;
    }

</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const selectAllBtn = document.getElementById('permSelectAll');
            const clearAllBtn = document.getElementById('permClearAll');

            function updateSelectedCount() {
                const el = document.getElementById('permSelectedCount');
                if (!el) return;
                const set = new Set();
                document.querySelectorAll('input[name="SelectedPermissionIds"]:checked').forEach(function (i) {
                    set.add(i.value);
                });
                el.textContent = set.size.toString();
            }

            if (selectAllBtn) {
                selectAllBtn.addEventListener('click', function () {
                    document.querySelectorAll('input[name="SelectedPermissionIds"]').forEach(function (cb) {
                        cb.checked = true;
                    });
                    document.querySelectorAll('.perm-master').forEach(function (m) {
                        m.checked = true;
                    });
                    updateSelectedCount();
                });
            }
            if (clearAllBtn) {
                clearAllBtn.addEventListener('click', function () {
                    document.querySelectorAll('input[name="SelectedPermissionIds"]').forEach(function (cb) {
                        cb.checked = false;
                    });
                    document.querySelectorAll('.perm-master').forEach(function (m) {
                        m.checked = false;
                    });
                    updateSelectedCount();
                });
            }

            document.addEventListener('change', function (e) {
                if (e.target.matches('input[name="SelectedPermissionIds"], .perm-master')) {
                    updateSelectedCount();
                }
            });
            updateSelectedCount();
        })();
    </script>
}

