@model List<RadTik.Controllers.AdminClientListItem>

@{
    ViewData["Title"] = "مشتركو الشركة";
    var searchValue = (ViewBag.Search as string) ?? string.Empty;
    var today = DateTime.Today;
    var hasRows = Model != null && Model.Any();
    var totalClients = Model?.Count ?? 0;
    var expiredClients = Model?.Count(c => c.ExpirationDate.HasValue && c.ExpirationDate.Value.Date < today) ?? 0;
    var expiringSoonClients = Model?.Count(c =>
        c.ExpirationDate.HasValue &&
        c.ExpirationDate.Value.Date >= today &&
        c.ExpirationDate.Value.Date <= today.AddDays(7)) ?? 0;
}

<div class="admin-clients-page">
    <div class="admin-clients-hero">
        <div class="admin-clients-hero-main">
            <div class="admin-clients-hero-icon"><i class="fas fa-users"></i></div>
            <div>
                <div class="admin-clients-chip"><i class="fas fa-network-wired"></i> إدارة المشتركين</div>
                <h1 class="admin-clients-title">@ViewData["Title"]</h1>
                <p class="admin-clients-subtitle">عرض وبحث وتعديل مشتركي الشبكة الحالية مع إحصاءات سريعة للاشتراكات.</p>
            </div>
        </div>
        <div class="admin-clients-actions">
            <a asp-route="networkManager-clients" asp-route-action="ImportFromServer" class="btn btn-admin-clients btn-import">
                <i class="fas fa-download"></i> استيراد من السيرفر
            </a>
            <a asp-route="networkManager-clients" asp-route-action="Create" class="btn btn-admin-clients btn-create">
                <i class="fas fa-user-plus"></i> إضافة مشترك
            </a>
        </div>
    </div>

    <div class="row g-3 mb-3 admin-clients-kpis">
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="admin-kpi-card admin-kpi-total">
                <div class="admin-kpi-icon"><i class="fas fa-users"></i></div>
                <div>
                    <div class="admin-kpi-label">إجمالي المشتركين</div>
                    <div class="admin-kpi-value">@totalClients</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="admin-kpi-card admin-kpi-soon">
                <div class="admin-kpi-icon"><i class="fas fa-hourglass-half"></i></div>
                <div>
                    <div class="admin-kpi-label">ينتهي خلال 7 أيام</div>
                    <div class="admin-kpi-value">@expiringSoonClients</div>
                </div>
            </div>
        </div>
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="admin-kpi-card admin-kpi-expired">
                <div class="admin-kpi-icon"><i class="fas fa-exclamation-circle"></i></div>
                <div>
                    <div class="admin-kpi-label">منتهي الصلاحية</div>
                    <div class="admin-kpi-value">@expiredClients</div>
                </div>
            </div>
        </div>
    </div>

    <div class="admin-clients-search-card">
        <form method="get" asp-route="networkManager-users-clients" class="row g-3 align-items-end">
            <div class="col-lg">
                <label class="form-label admin-clients-label"><i class="fas fa-search me-1"></i> بحث</label>
                <div class="admin-clients-input-wrap">
                    <input type="text" name="q" value="@searchValue" class="form-control"
                           placeholder="اسم المشترك، اسم المستخدم، اللاقط، القطاع، السيرفر…" autocomplete="off" />
                </div>
            </div>
            <div class="col-lg-auto d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary px-4">
                    <i class="fas fa-filter"></i> تطبيق
                </button>
                <a asp-route="networkManager-users-clients" class="btn btn-outline-secondary px-3">
                    <i class="fas fa-undo"></i> إعادة التعيين
                </a>
            </div>
        </form>
    </div>

    <div class="admin-clients-table-card">
        <div class="admin-clients-table-toolbar">
            <div class="btn-group">
                <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-columns"></i> الأعمدة
                </button>
                <div class="dropdown-menu dropdown-menu-end p-2 shadow admin-clients-col-menu">
                    <div class="form-check"><input class="form-check-input admin-col-toggle" type="checkbox" data-col="0" id="admin-col-network" checked><label class="form-check-label" for="admin-col-network">اسم الشبكة</label></div>
                    <div class="form-check"><input class="form-check-input admin-col-toggle" type="checkbox" data-col="1" id="admin-col-client" checked><label class="form-check-label" for="admin-col-client">اسم المشترك</label></div>
                    <div class="form-check"><input class="form-check-input admin-col-toggle" type="checkbox" data-col="2" id="admin-col-username" checked><label class="form-check-label" for="admin-col-username">اسم المستخدم</label></div>
                    <div class="form-check"><input class="form-check-input admin-col-toggle" type="checkbox" data-col="3" id="admin-col-receiver" checked><label class="form-check-label" for="admin-col-receiver">اللاقط</label></div>
                    <div class="form-check"><input class="form-check-input admin-col-toggle" type="checkbox" data-col="4" id="admin-col-sector" checked><label class="form-check-label" for="admin-col-sector">القطاع</label></div>
                    <div class="form-check"><input class="form-check-input admin-col-toggle" type="checkbox" data-col="5" id="admin-col-created" checked><label class="form-check-label" for="admin-col-created">تاريخ التسجيل</label></div>
                    <div class="form-check"><input class="form-check-input admin-col-toggle" type="checkbox" data-col="6" id="admin-col-expiration" checked><label class="form-check-label" for="admin-col-expiration">انتهاء الصلاحية</label></div>
                    <div class="form-check"><input class="form-check-input admin-col-toggle" type="checkbox" data-col="7" id="admin-col-updated" checked><label class="form-check-label" for="admin-col-updated">آخر تعديل</label></div>
                    <div class="form-check"><input class="form-check-input admin-col-toggle" type="checkbox" data-col="8" id="admin-col-server" checked><label class="form-check-label" for="admin-col-server">السيرفر</label></div>
                </div>
            </div>
            @if (hasRows)
            {
                <span class="small admin-clients-meta">@totalClients مشترك في القائمة الحالية</span>
            }
        </div>

        @if (!hasRows)
        {
            <div class="admin-clients-empty">
                <div class="admin-clients-empty-icon"><i class="fas fa-user-slash"></i></div>
                <h3>لا يوجد مشتركون</h3>
                <p>لم يُعثر على مشتركين للشبكة الحالية@(string.IsNullOrWhiteSpace(searchValue) ? "" : " ضمن نتائج البحث").</p>
                <div class="d-flex flex-wrap gap-2 justify-content-center">
                    <a asp-route="networkManager-clients" asp-route-action="Create" class="btn btn-success"><i class="fas fa-user-plus"></i> إضافة مشترك</a>
                    @if (!string.IsNullOrWhiteSpace(searchValue))
                    {
                        <a asp-route="networkManager-users-clients" class="btn btn-outline-secondary">مسح البحث</a>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="admin-clients-table-wrapper">
                <table class="table table-hover align-middle w-100 mb-0" id="adminClientsTable">
                    <thead>
                        <tr>
                            <th>اسم الشبكة</th>
                            <th>اسم المشترك</th>
                            <th>اسم المستخدم</th>
                            <th>اللاقط</th>
                            <th>القطاع</th>
                            <th>تاريخ التسجيل</th>
                            <th>انتهاء الصلاحية</th>
                            <th>آخر تعديل</th>
                            <th>السيرفر</th>
                            <th class="text-center">إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in Model!)
                        {
                            var expirationClass = "";
                            if (c.ExpirationDate.HasValue)
                            {
                                if (c.ExpirationDate.Value.Date < today)
                                {
                                    expirationClass = "admin-exp-expired";
                                }
                                else if (c.ExpirationDate.Value.Date <= today.AddDays(7))
                                {
                                    expirationClass = "admin-exp-soon";
                                }
                            }

                            <tr>
                                <td>@(string.IsNullOrWhiteSpace(c.NetworkName) ? "—" : c.NetworkName)</td>
                                <td class="fw-semibold admin-clients-name">@c.ClientName</td>
                                <td><span class="client-username">@c.UserName</span></td>
                                <td>@(string.IsNullOrWhiteSpace(c.ReceiverName) ? "—" : c.ReceiverName)</td>
                                <td>@(string.IsNullOrWhiteSpace(c.SectorName) ? "—" : c.SectorName)</td>
                                <td data-order="@c.CreatedDate.Ticks">@c.CreatedDate.ToString("yyyy/MM/dd")</td>
                                <td class="@expirationClass" data-order="@(c.ExpirationDate?.Ticks ?? 0)">@(c.ExpirationDate.HasValue ? c.ExpirationDate.Value.ToString("yyyy/MM/dd") : "—")</td>
                                <td data-order="@c.LastUpdated.Ticks">@c.LastUpdated.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(c.ServerName))
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        <span class="badge admin-server-badge">@c.ServerName</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-route="networkManager-clients" asp-route-action="Details" asp-route-id="@c.Id" class="btn btn-outline-info" title="تفاصيل"><i class="fas fa-eye"></i></a>
                                        <a asp-route="networkManager-clients" asp-route-action="Edit" asp-route-id="@c.Id" class="btn btn-outline-warning" title="تعديل"><i class="fas fa-edit"></i></a>
                                        <a asp-route="networkManager-clients" asp-route-action="Delete" asp-route-id="@c.Id" class="btn btn-outline-danger" title="حذف"><i class="fas fa-trash"></i></a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<style>
    .admin-clients-page {
        --ac-bg-hero: linear-gradient(135deg, #eff6ff 0%, #f8fafc 50%, #ffffff 100%);
        --ac-border: rgba(148, 163, 184, 0.28);
        --ac-text: #0f172a;
        --ac-muted: #64748b;
        --ac-surface: #ffffff;
        --ac-table-head: linear-gradient(180deg, #f1f5f9 0%, #e2e8f0 100%);
        --ac-row-hover: rgba(37, 99, 235, 0.06);
        --ac-chip-bg: rgba(37, 99, 235, 0.1);
        --ac-chip-fg: #1d4ed8;
        padding-bottom: 1rem;
    }

    [data-theme="dark"] .admin-clients-page {
        --ac-bg-hero: linear-gradient(135deg, #0f172a 0%, #1e293b 45%, #172033 100%);
        --ac-border: rgba(148, 163, 184, 0.22);
        --ac-text: #f1f5f9;
        --ac-muted: #94a3b8;
        --ac-surface: #1e293b;
        --ac-table-head: linear-gradient(180deg, #1e293b 0%, #0f172a 100%);
        --ac-row-hover: rgba(59, 130, 246, 0.12);
        --ac-chip-bg: rgba(59, 130, 246, 0.2);
        --ac-chip-fg: #93c5fd;
    }

    .admin-clients-hero {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1.25rem;
        padding: 1.25rem 1.35rem;
        border-radius: 16px;
        background: var(--ac-bg-hero);
        border: 1px solid var(--ac-border);
        box-shadow: 0 14px 36px -24px rgba(15, 23, 42, 0.35);
        margin-bottom: 1.25rem;
    }

    .admin-clients-hero-main {
        display: flex;
        gap: 1rem;
        align-items: flex-start;
        flex: 1;
        min-width: min(100%, 280px);
    }

    .admin-clients-hero-icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--ac-chip-bg);
        color: var(--ac-chip-fg);
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .admin-clients-chip {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.75rem;
        font-weight: 700;
        padding: 0.28rem 0.65rem;
        border-radius: 999px;
        background: var(--ac-chip-bg);
        color: var(--ac-chip-fg);
        margin-bottom: 0.4rem;
    }

    .admin-clients-title {
        font-size: 1.45rem;
        font-weight: 800;
        color: var(--ac-text);
        margin: 0 0 0.25rem 0;
    }

    .admin-clients-subtitle {
        margin: 0;
        font-size: 0.92rem;
        color: var(--ac-muted);
        max-width: 520px;
        line-height: 1.45;
    }

    .admin-clients-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
    }

    .btn-admin-clients {
        border-radius: 10px;
        font-weight: 600;
        padding: 0.5rem 1rem;
    }

    .btn-admin-clients.btn-import {
        background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
        border: none;
        color: #fff;
    }

    .btn-admin-clients.btn-import:hover {
        filter: brightness(1.06);
        color: #fff;
    }

    .btn-admin-clients.btn-create {
        background: linear-gradient(135deg, #10b981 0%, #059669 100%);
        border: none;
        color: #fff;
    }

    .btn-admin-clients.btn-create:hover {
        filter: brightness(1.06);
        color: #fff;
    }

    .admin-kpi-card {
        display: flex;
        align-items: center;
        gap: 0.9rem;
        padding: 1rem 1.1rem;
        border-radius: 14px;
        border: 1px solid var(--ac-border);
        background: var(--ac-surface);
        box-shadow: 0 10px 28px -22px rgba(15, 23, 42, 0.28);
        height: 100%;
    }

    .admin-kpi-icon {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .admin-kpi-total .admin-kpi-icon {
        background: rgba(37, 99, 235, 0.15);
        color: #2563eb;
    }

    [data-theme="dark"] .admin-kpi-total .admin-kpi-icon {
        background: rgba(59, 130, 246, 0.2);
        color: #60a5fa;
    }

    .admin-kpi-soon .admin-kpi-icon {
        background: rgba(245, 158, 11, 0.18);
        color: #d97706;
    }

    .admin-kpi-expired .admin-kpi-icon {
        background: rgba(239, 68, 68, 0.15);
        color: #ef4444;
    }

    .admin-kpi-label {
        font-size: 0.82rem;
        font-weight: 600;
        color: var(--ac-muted);
    }

    .admin-kpi-value {
        font-size: 1.55rem;
        font-weight: 800;
        color: var(--ac-text);
        line-height: 1.1;
    }

    .admin-kpi-total .admin-kpi-value { color: #2563eb; }
    [data-theme="dark"] .admin-kpi-total .admin-kpi-value { color: #60a5fa; }
    .admin-kpi-soon .admin-kpi-value { color: #ea580c; }
    .admin-kpi-expired .admin-kpi-value { color: #dc2626; }

    .admin-clients-search-card {
        background: var(--ac-surface);
        border: 1px solid var(--ac-border);
        border-radius: 14px;
        padding: 1rem 1.15rem;
        margin-bottom: 1rem;
        box-shadow: 0 8px 24px -22px rgba(15, 23, 42, 0.2);
    }

    .admin-clients-label {
        font-weight: 600;
        color: var(--ac-text);
        font-size: 0.88rem;
    }

    .admin-clients-input-wrap .form-control {
        border-radius: 10px;
        border: 1px solid var(--ac-border);
        background: var(--ac-surface);
        color: var(--ac-text);
    }

    [data-theme="dark"] .admin-clients-input-wrap .form-control {
        background: #0f172a;
        border-color: #334155;
        color: #e2e8f0;
    }

    [data-theme="dark"] .admin-clients-input-wrap .form-control::placeholder {
        color: #64748b;
    }

    .admin-clients-input-wrap .form-control:focus {
        border-color: #3b82f6;
        box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.18);
    }

    .admin-clients-table-card {
        background: var(--ac-surface);
        border: 1px solid var(--ac-border);
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 12px 32px -24px rgba(15, 23, 42, 0.35);
    }

    .admin-clients-table-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.75rem;
        padding: 0.85rem 1.15rem;
        border-bottom: 1px solid var(--ac-border);
        background: var(--ac-surface);
    }

    .admin-clients-meta {
        color: var(--ac-muted);
    }

    .admin-clients-col-menu {
        min-width: 220px;
        border-radius: 12px;
    }

    .admin-clients-col-menu .form-check {
        margin-bottom: 0.35rem;
    }

    .admin-clients-table-wrapper {
        overflow-x: auto;
    }

    .admin-clients-page #adminClientsTable thead th {
        background: var(--ac-table-head);
        color: var(--ac-text);
        font-weight: 700;
        font-size: 0.82rem;
        text-transform: none;
        border-bottom: 1px solid var(--ac-border);
        white-space: nowrap;
        padding: 0.75rem 0.85rem;
    }

    .admin-clients-page #adminClientsTable tbody td {
        color: var(--ac-text);
        border-color: var(--ac-border);
        padding: 0.65rem 0.85rem;
        vertical-align: middle;
        font-size: 0.88rem;
    }

    .admin-clients-page #adminClientsTable tbody tr:hover {
        background: var(--ac-row-hover);
    }

    .admin-clients-name {
        color: var(--ac-text);
    }

    .admin-exp-expired {
        color: #ef4444 !important;
        font-weight: 700;
    }

    .admin-exp-soon {
        color: #d97706 !important;
        font-weight: 700;
    }

    [data-theme="dark"] .admin-exp-soon {
        color: #fbbf24 !important;
    }

    .client-username {
        display: inline-block;
        background: var(--ac-chip-bg);
        border: 1px solid var(--ac-border);
        color: var(--ac-chip-fg);
        border-radius: 999px;
        padding: 0.15rem 0.6rem;
        font-size: 0.8rem;
        font-weight: 600;
    }

    .admin-server-badge {
        background: rgba(6, 182, 212, 0.14);
        color: #0891b2;
        border: 1px solid rgba(6, 182, 212, 0.35);
        font-weight: 600;
        border-radius: 8px;
        padding: 0.25rem 0.5rem;
    }

    [data-theme="dark"] .admin-server-badge {
        background: rgba(34, 211, 238, 0.12);
        color: #22d3ee;
        border-color: rgba(34, 211, 238, 0.3);
    }

    .admin-clients-empty {
        text-align: center;
        padding: 2.5rem 1.5rem;
        color: var(--ac-muted);
    }

    .admin-clients-empty-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 1rem;
        border-radius: 18px;
        background: var(--ac-chip-bg);
        color: var(--ac-chip-fg);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.75rem;
    }

    .admin-clients-empty h3 {
        color: var(--ac-text);
        font-size: 1.15rem;
        font-weight: 700;
        margin-bottom: 0.5rem;
    }

    .admin-clients-empty p {
        max-width: 400px;
        margin: 0 auto 1.25rem;
        line-height: 1.5;
    }

    .admin-clients-page .dataTables_wrapper .dataTables_filter input,
    .admin-clients-page .dataTables_wrapper .dataTables_length select {
        border-radius: 8px;
        border: 1px solid var(--ac-border);
        background: var(--ac-surface);
        color: var(--ac-text);
    }

    [data-theme="dark"] .admin-clients-page .dataTables_wrapper .dataTables_info,
    [data-theme="dark"] .admin-clients-page .dataTables_wrapper .dataTables_length,
    [data-theme="dark"] .admin-clients-page .dataTables_wrapper .dataTables_filter {
        color: var(--ac-muted);
    }

    div.dataTables_wrapper div.dataTables_scrollBody {
        overflow-x: auto !important;
    }

    @@media (max-width: 576px) {
        .admin-clients-actions {
            width: 100%;
        }

        .admin-clients-actions .btn-admin-clients {
            flex: 1;
            justify-content: center;
        }
    }
</style>

@section Scripts {
    @if (hasRows)
    {
        <script>
            $(document).ready(function () {
                var table = $('#adminClientsTable').DataTable({
                    scrollX: true,
                    autoWidth: false,
                    language: {
                        url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/ar.json'
                    },
                    order: [[5, 'desc']],
                    pageLength: 25,
                    lengthMenu: [[10, 25, 50, 100], [10, 25, 50, 100]],
                    columnDefs: [
                        { targets: 9, orderable: false, className: 'text-center' }
                    ]
                });

                $('.admin-col-toggle').on('change', function () {
                    var colIndex = $(this).data('col');
                    table.column(colIndex).visible(this.checked);
                });
            });
        </script>
    }
}
