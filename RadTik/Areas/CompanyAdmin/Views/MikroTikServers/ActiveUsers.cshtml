@model List<RadTik.Models.Client>

@{
    ViewData["Title"] = "المستخدمون النشطين - " + ViewData["ServerName"];
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>
        <i class="fas fa-users text-success"></i>
        @ViewData["Title"]
    </h2>
    <div>
        <a asp-action="AllUsers" asp-route-id="@ViewData["ServerId"]" class="btn btn-outline-primary">
            <i class="fas fa-list"></i> جميع المستخدمين
        </a>
        <a asp-action="Details" asp-route-id="@ViewData["ServerId"]" class="btn btn-secondary">
            <i class="fas fa-arrow-right"></i> العودة للخادم
        </a>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        <i class="fas fa-info-circle"></i>
        لا يوجد مستخدمين نشطين حالياً
    </div>
}
else
{
    <div class="card">
        <div class="card-header bg-success text-white">
            <i class="fas fa-chart-line"></i>
            المستخدمون المتصلون حالياً: @Model.Count مستخدم
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>الاسم الثلاثي</th>
                            <th>اسم المستخدم</th>
                            <th>الهاتف</th>
                            <th>العنوان IP</th>
                            <th>وقت التشغيل</th>
                            <th>الخدمة</th>
                            <th>الماك ادرس</th>
                            <th>الحالة</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    @if (!string.IsNullOrEmpty(user.Name))
                                    {
                                        <i class="fas fa-user text-primary"></i>
                                        <strong>@user.Name</strong>
                                    }
                                    else
                                    {
                                        <span class="text-muted">غير مسجل</span>
                                    }
                                </td>
                                <td>
                                    <strong>@user.UserName</strong>
                                </td>
                                <td>
                                    @if (!string.IsNullOrEmpty(user.PhoneNumber))
                                    {
                                        <i class="fas fa-phone text-info"></i>
                                        @user.PhoneNumber
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-info">@user.Address</span>
                                </td>
                                <td>
                                    <small class="text-muted">@user.Uptime</small>
                                </td>
                                <td>@user.Service</td>
                                <td>
                                    <code>@user.MacAddress</code>
                                </td>
                                <td>
                                    <span class="badge bg-success">
                                        <i class="fas fa-check-circle"></i> @user.ConnectionStatus
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}