@model IEnumerable<RadTik.Models.MikroTikServer>
@using RadTik.Security
@using RadTik.Models

@{
    ViewData["Title"] = "خوادم مايكروتك";
    var hasRenewalPricing = (ViewBag.ServerRenewalHasPricing as bool?) ?? false;
    var renewalPeriodLabel = ViewBag.ServerRenewalPeriodLabel as string ?? "غير محدد";
    var activeServers = (ViewBag.ServerRenewalActiveServers as int?) ?? 0;
    var additionalServers = (ViewBag.ServerRenewalAdditionalServers as int?) ?? 0;
    var renewalUnitPrice = (ViewBag.ServerRenewalUnitPriceSyp as decimal?) ?? 0m;
    var renewalEstimate = (ViewBag.ServerRenewalEstimatedAmountSyp as decimal?) ?? 0m;
    var showAllNetworks = (ViewBag.ShowAllNetworks as bool?) ?? false;
    var isAllNetworksSelection = (ViewBag.IsAllNetworksSelection as bool?) ?? false;
    var selectedNetworkId = (ViewBag.SelectedNetworkId as int?) ?? 0;
    var networks = ViewBag.Networks as IEnumerable<Network> ?? Enumerable.Empty<Network>();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <h1>
        <i class="fas fa-server"></i>
        @ViewData["Title"]
    </h1>
    <div class="d-flex flex-wrap gap-2">
        @if (User.IsInRole(RoleNames.NetworkAdministrator))
        {
            <a asp-route="networkManager-mikrotik-traffic"
               class="btn btn-outline-info">
                <i class="fas fa-chart-area"></i> مراقبة الترافك المباشر
            </a>
        }
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> إضافة خادم جديد
        </a>
    </div>
</div>

@if (isAllNetworksSelection)
{
    <div class="alert alert-secondary mb-4">
        <i class="fas fa-layer-group me-1"></i>
        تم اختيار <strong>كل الشبكات</strong>. ملخص التجديد الدوري يظهر عند اختيار شبكة محددة.
    </div>
}
else
{
    <div class="alert @(hasRenewalPricing ? "alert-info" : "alert-warning") mb-4">
        <div class="d-flex flex-wrap gap-3 align-items-center justify-content-between">
            <div>
                <i class="fas fa-calendar-check me-1"></i>
                <strong>ملخص التجديد الدوري لخدمة السيرفرات</strong>
                <div class="small mt-1">
                    @(hasRenewalPricing
                        ? $"الدورة: {renewalPeriodLabel} | سعر التجديد للوحدة: {renewalUnitPrice:N2} ل.س.ج"
                        : "لم يتم تعريف سياسة تجديد السيرفرات بعد من مدير النظام.")
                </div>
            </div>
            @if (hasRenewalPricing)
            {
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-light text-dark border">إجمالي السيرفرات: @activeServers</span>
                    <span class="badge bg-warning text-dark">سيرفرات إضافية: @additionalServers</span>
                    <span class="badge bg-primary">تقدير التجديد القادم: @renewalEstimate.ToString("N2") ل.س.ج</span>
                </div>
            }
        </div>
    </div>
}

<div class="card">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end mb-3">
            <div class="col-md-4 col-lg-3">
                <label for="selectedNetworkId" class="form-label">تصفية حسب الشبكة</label>
                <select id="selectedNetworkId" name="selectedNetworkId" class="form-select">
                    @if (selectedNetworkId == 0)
                    {
                        <option value="0" selected>كل الشبكات</option>
                    }
                    else
                    {
                        <option value="0">كل الشبكات</option>
                    }
                    @foreach (var network in networks)
                    {
                        if (selectedNetworkId == network.Id)
                        {
                            <option value="@network.Id" selected>@network.Name</option>
                        }
                        else
                        {
                            <option value="@network.Id">@network.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-auto">
                <button type="submit" class="btn btn-outline-primary">
                    <i class="fas fa-filter"></i> تطبيق
                </button>
            </div>
            <div class="col-md-auto">
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="fas fa-undo"></i> إعادة الضبط
                </a>
            </div>
        </form>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-server fa-3x text-muted mb-3"></i>
                <h4>لا توجد خوادم مضافة</h4>
                <p class="text-muted">ابدأ بإضافة خادم مايكروتك جديد.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i> إضافة خادم جديد
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-light">
                        <tr>
                            @if (showAllNetworks)
                            {
                                <th>الشبكة</th>
                            }
                            <th>اسم الخادم</th>
                            <th>المضيف</th>
                            <th>المنفذ</th>
                            <th>اسم المستخدم</th>
                            <th>الحالة</th>
                            <th>تاريخ الإنشاء</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                @if (showAllNetworks)
                                {
                                    <td>@(item.Network?.Name ?? "-")</td>
                                }
                                <td>
                                    <strong>@item.Name</strong>
                                    @if (!string.IsNullOrEmpty(item.UserID))
                                    {
                                        <br />
                                        <small class="text-muted">@item.UserID</small>
                                    }
                                </td>
                                <td>@item.Host</td>
                                <td>@item.Port</td>
                                <td>@item.User</td>
                                <td>
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">نشط</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">غير نشط</span>
                                    }
                                </td>
                                <td>@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-outline-info" title="تفاصيل">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-outline-warning" title="تعديل">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="TestConnection" asp-route-id="@item.Id"
                                           class="btn btn-outline-primary" title="اختبار الاتصال">
                                            <i class="fas fa-wifi"></i>
                                        </a>
                                        <a asp-action="AllUsers" asp-route-id="@item.Id"
                                           class="btn btn-outline-success" title="المستخدمين">
                                            <i class="fas fa-users"></i>
                                        </a>
                                        @if (User.IsInRole(RoleNames.NetworkAdministrator))
                                        {
                                            <a asp-route="networkManager-mikrotik-traffic"
                                               asp-route-serverId="@item.Id"
                                               class="btn btn-outline-secondary" title="ترافك الواجهات">
                                                <i class="fas fa-chart-line"></i>
                                            </a>
                                        }
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-outline-danger" title="حذف">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    @if (Model.Any())
    {
        <div class="card-footer text-muted">
            <div class="row">
                <div class="col-md-6">
                    <i class="fas fa-info-circle"></i>
                    <small>إجمالي الخوادم: @Model.Count()</small>
                </div>
                <div class="col-md-6 text-end">
                    <small>
                        <i class="far fa-clock"></i>
                        آخر تحديث: @DateTime.Now.ToString("yyyy-MM-dd HH:mm")
                    </small>
                </div>
            </div>
        </div>
    }
</div>