@model List<RadTik.ViewModels.MikroTikServers.EditMikroTikUserViewModel>
@using System.Text.RegularExpressions
@{
    ViewData["Title"] = "جميع المستخدمين - " + ViewData["ServerName"];
    var importPreview = ViewData["ImportPreview"] as RadTik.Services.ImportUsersPreviewResult ?? new RadTik.Services.ImportUsersPreviewResult();
    var importEstimate = ViewData["ImportEstimate"] as RadTik.Services.UsageImportChargeEstimate ?? new RadTik.Services.UsageImportChargeEstimate();
    var clientImportUnitPrice = (decimal?)(ViewData["ClientImportUnitPrice"]) ?? 0m;
    var mustImportProfilesFirst = importPreview.MissingProfileCount > 0;
    int GetSpeedFromProfile(string profileName)
    {
        if (string.IsNullOrWhiteSpace(profileName)) return 0;
        var m = Regex.Match(profileName, @"\d+");
        return m.Success ? int.Parse(m.Value) : 0;
    }
    var totalSpeed = Model.Sum(u => GetSpeedFromProfile(u.ProfileName));
}

<div class="card border-0 shadow-sm mb-3 border-start border-4 border-primary">
    <div class="card-body py-2">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center" style="width:34px;height:34px;">
                    <i class="fas fa-users"></i>
                </span>
                <div>
                    <div class="small text-muted mb-1">التسعير الفعّال</div>
                    <div class="fw-semibold">سعر الوحدة المعتمد لاستيراد كل عميل</div>
                </div>
            </div>
            <div class="fw-bold text-primary">@clientImportUnitPrice.ToString("N2") ل.س.ج</div>
        </div>
    </div>
</div>

<!-- شريط استيراد من السيرفر - واضح في أعلى الصفحة -->
<div class="alert alert-warning border-warning mb-3 d-flex flex-wrap align-items-center justify-content-between gap-2 import-banner" role="alert">
    <span class="fw-bold">
        <i class="fas fa-download"></i> استيراد المشتركين من هذا السيرفر إلى قاعدة البيانات
        <span class="d-block small mt-1">
            على السيرفر: <strong>@importPreview.TotalUsersOnServer</strong> |
            قابل للاستيراد: <strong>@importPreview.ImportableUsersCount</strong> |
            سعر كل عميل: <strong>@importEstimate.UnitPriceSyp.ToString("N2")</strong> ل.س.ج |
            الإجمالي المتوقع: <strong>@importEstimate.RequiredAmountSyp.ToString("N2")</strong> ل.س.ج |
            الرصيد الحالي: <strong>@importEstimate.WalletBalance.ToString("N2")</strong> ل.س.ج
        </span>
    </span>
    <form asp-action="ImportAllUsersToDatabase" method="post" class="d-inline">
        @Html.AntiForgeryToken()
        <input type="hidden" name="serverId" value="@ViewData["ServerId"]" />
        <button type="submit"
                class="btn btn-warning btn-sm"
                data-total-users="@importPreview.TotalUsersOnServer"
                data-importable-users="@importPreview.ImportableUsersCount"
                data-missing-profiles="@importPreview.MissingProfileCount"
                data-requires-profiles="@(mustImportProfilesFirst ? "true" : "false")"
                data-unit-price="@importEstimate.UnitPriceSyp.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                data-total-charge="@importEstimate.RequiredAmountSyp.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                data-wallet-balance="@importEstimate.WalletBalance.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                disabled="@(mustImportProfilesFirst ? "disabled" : null)"
                onclick="return confirmAllUsersImport(this);">
            <i class="fas fa-download"></i> استيراد من سيرفر
        </button>
    </form>
</div>

@if (mustImportProfilesFirst)
{
    <div class="alert alert-danger border-danger-subtle mb-3 d-flex align-items-start gap-2" role="alert">
        <i class="fas fa-ban mt-1"></i>
        <div>
            <div class="fw-bold mb-1">لا يمكن استيراد المشتركين قبل استيراد البروفايلات</div>
            <div class="small">
                يوجد <strong>@importPreview.MissingProfileCount</strong> مشترك مرتبط ببروفايلات غير موجودة في قاعدة البيانات.
                قم باستيراد البروفايلات أولاً ثم أعد المحاولة.
            </div>
        </div>
    </div>
}

<div class="row g-3 mb-3 allusers-summary-cards">
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="summary-card summary-card-primary h-100">
            <div class="summary-icon"><i class="fas fa-server"></i></div>
            <div class="summary-label">إجمالي المستخدمين على السيرفر</div>
            <div class="summary-value">@importPreview.TotalUsersOnServer</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="summary-card summary-card-success h-100">
            <div class="summary-icon"><i class="fas fa-file-import"></i></div>
            <div class="summary-label">قابل للاستيراد</div>
            <div class="summary-value">@importPreview.ImportableUsersCount</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="summary-card summary-card-warning h-100">
            <div class="summary-icon"><i class="fas fa-layer-group"></i></div>
            <div class="summary-label">مفقود البروفايل</div>
            <div class="summary-value">@importPreview.MissingProfileCount</div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="summary-card summary-card-neutral h-100">
            <div class="summary-icon"><i class="fas fa-database"></i></div>
            <div class="summary-label">موجود مسبقًا بقاعدة البيانات</div>
            <div class="summary-value">@importPreview.ExistingUsersCount</div>
        </div>
    </div>
</div>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <h2 class="mb-0">
        <i class="fas fa-list-alt text-primary"></i>
        @ViewData["Title"]
    </h2>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="ActiveUsers" asp-route-id="@ViewData["ServerId"]" class="btn btn-outline-success">
            <i class="fas fa-bolt"></i> النشطين فقط
        </a>
        <a asp-action="Details" asp-route-id="@ViewData["ServerId"]" class="btn btn-secondary">
            <i class="fas fa-arrow-right"></i> العودة للخادم
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle"></i>
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="fas fa-exclamation-triangle"></i>
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["ImportFailedUsersDetails"] is string failedUsersJson && !string.IsNullOrWhiteSpace(failedUsersJson))
{
    var failedUsers = System.Text.Json.JsonSerializer.Deserialize<List<string>>(failedUsersJson) ?? new List<string>();
    if (failedUsers.Any())
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            <i class="fas fa-exclamation-circle"></i>
            <strong>تعذر إنشاء حسابات لبعض المستخدمين:</strong>
            <ul class="mb-0 mt-1 ps-3">
                @foreach (var item in failedUsers)
                {
                    <li>@item</li>
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
}

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        <i class="fas fa-info-circle"></i>
        لا يوجد مستخدمين مسجلين في النظام
    </div>
}
else
{
    <div class="card">
        <div class="card-header bg-primary text-white">
            <i class="fas fa-database"></i>
            جميع المستخدمين المسجلين: @Model.Count مستخدم
        </div>
        <div class="card-body pt-2 pb-2">
            <div class="row g-2 mb-2 text-muted small border-bottom pb-2">
                <div class="col-md-4">
                    <i class="fas fa-info-circle"></i>
                    مجموع المستخدمين: @Model.Count
                </div>
                <div class="col-md-4">
                    <i class="fas fa-tachometer-alt"></i>
                    إجمالي مجموع السرعة: <strong>@totalSpeed</strong>
                </div>
                <div class="col-md-4 text-end">
                    <i class="fas fa-clock"></i>
                    آخر تحديث: @DateTime.Now.ToString("yyyy/MM/dd HH:mm:ss")
                </div>
            </div>

            <!-- أدوات التحكم في الأعمدة -->
            <div class="mb-2">
                <div class="btn-group btn-group-sm">
                    <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown">
                        <i class="fas fa-columns"></i> اختيار الأعمدة
                    </button>
                    <div class="dropdown-menu p-2">
                        <div class="form-check">
                            <input class="form-check-input allusers-col-toggle" type="checkbox" data-col="0" id="allusers-col-serial" checked>
                            <label class="form-check-label" for="allusers-col-serial">الترقيم</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input allusers-col-toggle" type="checkbox" data-col="1" id="allusers-col-name" checked>
                            <label class="form-check-label" for="allusers-col-name">الاسم الثلاثي</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input allusers-col-toggle" type="checkbox" data-col="2" id="allusers-col-username" checked>
                            <label class="form-check-label" for="allusers-col-username">اسم المستخدم</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input allusers-col-toggle" type="checkbox" data-col="3" id="allusers-col-phone" checked>
                            <label class="form-check-label" for="allusers-col-phone">الجوال</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input allusers-col-toggle" type="checkbox" data-col="4" id="allusers-col-speed" checked>
                            <label class="form-check-label" for="allusers-col-speed">السرعة</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input allusers-col-toggle" type="checkbox" data-col="5" id="allusers-col-service" checked>
                            <label class="form-check-label" for="allusers-col-service">الخدمة</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input allusers-col-toggle" type="checkbox" data-col="6" id="allusers-col-expiration" checked>
                            <label class="form-check-label" for="allusers-col-expiration">انتهاء الصلاحية</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input allusers-col-toggle" type="checkbox" data-col="7" id="allusers-col-db" checked>
                            <label class="form-check-label" for="allusers-col-db">قاعدة البيانات</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input allusers-col-toggle" type="checkbox" data-col="8" id="allusers-col-address" checked>
                            <label class="form-check-label" for="allusers-col-address">العنوان</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table id="allUsersTable" class="table table-striped table-hover table-sm mb-0 allusers-table-compact">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>الاسم الثلاثي</th>
                            <th>اسم المستخدم</th>
                            <th>الجوال</th>
                            <th>السرعة</th>
                            <th>الخدمة</th>
                            <th>انتهاء الصلاحية</th>
                            <th>قاعدة البيانات</th>
                            <th>العنوان</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int serial = 0; }
                        @foreach (var user in Model)
                        {
                            serial++;
                            var speedVal = GetSpeedFromProfile(user.ProfileName);
                            <tr>
                                <td data-order="@serial">@serial</td>
                                <td>@(string.IsNullOrEmpty(user.Name) ? "—" : user.Name)</td>
                                <td><strong>@user.UserName</strong></td>
                                <td>@(string.IsNullOrEmpty(user.PhoneNumber) ? "—" : user.PhoneNumber)</td>
                                <td data-order="@speedVal">@(speedVal > 0 ? speedVal.ToString() : "-")</td>
                                <td>@(user.Service ?? "—")</td>
                                <td data-order="@(user.AccountExpirationDate?.ToString("yyyyMMdd") ?? "99999999")">
                                    @if (user.AccountExpirationDate.HasValue)
                                    {
                                        var expirationDate = user.AccountExpirationDate.Value;
                                        var isExpired = expirationDate < DateTime.Now;
                                        var isExpiringSoon = expirationDate <= DateTime.Now.AddDays(7) && expirationDate >= DateTime.Now;
                                        <span class="badge @(isExpired ? "bg-danger" : isExpiringSoon ? "bg-warning" : "bg-info")">@expirationDate.ToString("yyyy/MM/dd")</span>
                                    }
                                    else { <span class="text-muted">—</span> }
                                </td>
                                <td data-order="@(user.IsInDatabase ? 1 : 0)">
                                    @if (user.IsInDatabase)
                                    { <span class="badge bg-success">موجود</span> }
                                    else
                                    { <span class="badge bg-warning">غير موجود</span> }
                                </td>
                                <td>@(string.IsNullOrEmpty(user.Address) ? "—" : user.Address)</td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <a asp-action="EditUser" asp-route-id="@ViewData["ServerId"]" asp-route-userName="@user.UserName" class="btn btn-outline-primary" title="تعديل"><i class="fas fa-edit"></i></a>
                                        @if (user.IsActive)
                                        {
                                            <form asp-action="FreezeUser" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="serverId" value="@ViewData["ServerId"]" />
                                                <input type="hidden" name="userName" value="@user.UserName" />
                                                <button type="submit" class="btn btn-outline-danger" onclick="return confirm('هل أنت متأكد من تجميد الحساب؟')" title="تجميد حساب"><i class="fas fa-snowflake"></i></button>
                                            </form>
                                        }
                                        else
                                        {
                                            <form asp-action="UnfreezeUser" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="serverId" value="@ViewData["ServerId"]" />
                                                <input type="hidden" name="userName" value="@user.UserName" />
                                                <button type="submit" class="btn btn-outline-success" onclick="return confirm('هل أنت متأكد من تفعيل الحساب؟')" title="تفعيل الحساب"><i class="fas fa-play"></i></button>
                                            </form>
                                        }
                                        @if (user.IsInDatabase && user.ClientId.HasValue)
                                        {
                                            <a asp-controller="Clients" asp-action="RenewSubscription" asp-route-id="@user.ClientId" class="btn btn-outline-warning" title="تمديد الاشتراك"><i class="fas fa-calendar-plus"></i></a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<style>
    .import-banner {
        border-radius: 14px;
    }

    .allusers-summary-cards .summary-card {
        border: 1px solid rgba(37, 99, 235, 0.12);
        border-radius: 16px;
        padding: 0.85rem 0.95rem;
        background: linear-gradient(135deg, #ffffff 0%, #f8fbff 100%);
        box-shadow: 0 8px 20px rgba(2, 6, 23, 0.06);
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .allusers-summary-cards .summary-icon {
        width: 36px;
        height: 36px;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 0.9rem;
        margin-bottom: 0.2rem;
    }

    .allusers-summary-cards .summary-label {
        font-size: 0.82rem;
        color: #64748b;
        font-weight: 600;
    }

    .allusers-summary-cards .summary-value {
        font-size: 1.35rem;
        line-height: 1.2;
        font-weight: 800;
        color: #0f172a;
    }

    .allusers-summary-cards .summary-card-primary .summary-icon { background: linear-gradient(135deg, #2563eb, #1d4ed8); }
    .allusers-summary-cards .summary-card-success .summary-icon { background: linear-gradient(135deg, #059669, #047857); }
    .allusers-summary-cards .summary-card-warning .summary-icon { background: linear-gradient(135deg, #d97706, #b45309); }
    .allusers-summary-cards .summary-card-neutral .summary-icon { background: linear-gradient(135deg, #334155, #1e293b); }

    .allusers-table-compact thead th,
    .allusers-table-compact tbody td {
        padding: 0.25rem 0.4rem;
        vertical-align: middle;
        font-size: 0.875rem;
    }
    .allusers-table-compact .btn-group .btn {
        padding: 0.2rem 0.35rem;
    }

    @@media (max-width: 991.98px) {
        .allusers-summary-cards .summary-value {
            font-size: 1.2rem;
        }
    }

    @@media (max-width: 767.98px) {
        .allusers-summary-cards .summary-card {
            border-radius: 14px;
            padding: 0.8rem;
        }

        .allusers-table-compact thead th,
        .allusers-table-compact tbody td {
            font-size: 0.8rem;
            padding: 0.24rem 0.32rem;
            white-space: nowrap;
        }
    }
</style>

@section Scripts {
    <script>
        function confirmAllUsersImport(btn) {
            const totalUsers = Number(btn.getAttribute('data-total-users') || 0);
            const importableUsers = Number(btn.getAttribute('data-importable-users') || 0);
            const missingProfiles = Number(btn.getAttribute('data-missing-profiles') || 0);
            const requiresProfiles = (btn.getAttribute('data-requires-profiles') || '').toLowerCase() === 'true';
            const unitPrice = Number(btn.getAttribute('data-unit-price') || 0);
            const totalCharge = Number(btn.getAttribute('data-total-charge') || 0);
            const walletBalance = Number(btn.getAttribute('data-wallet-balance') || 0);

            if (requiresProfiles || missingProfiles > 0) {
                alert(`لا يمكن الاستيراد قبل استيراد البروفايلات.\nيوجد ${missingProfiles} مشترك مرتبط ببروفايل غير مستورد.`);
                return false;
            }

            if (importableUsers <= 0) {
                alert('لا يوجد عملاء جدد قابلين للاستيراد من هذا السيرفر حالياً.');
                return false;
            }

            const message =
                `تنبيه واضح قبل الاستيراد:\n\n` +
                `عدد العملاء على السيرفر: ${totalUsers}\n` +
                `العملاء القابلون للاستيراد: ${importableUsers}\n` +
                `سعر استيراد كل عميل: ${unitPrice.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ل.س.ج\n` +
                `إجمالي مبلغ الاستيراد: ${totalCharge.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ل.س.ج\n` +
                `رصيد المحفظة الحالي: ${walletBalance.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} ل.س.ج\n\n` +
                `سيتم التحقق من الرصيد قبل التنفيذ الفعلي، وفي حال عدم الكفاية سيتم إلغاء العملية مع توضيح السبب.\n\n` +
                `هل تريد المتابعة؟`;

            return window.confirm(message);
        }

        $(function () {
            if ($('#allUsersTable').length && typeof $.fn.DataTable !== 'undefined') {
                var table = $('#allUsersTable').DataTable({
                    scrollX: true,
                    order: [[0, 'asc']],
                    pageLength: 25,
                    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "الكل"]],
                    language: {
                        search: "بحث:",
                        lengthMenu: "عرض _MENU_ صف",
                        info: "عرض _START_ إلى _END_ من _TOTAL_",
                        infoEmpty: "لا توجد بيانات",
                        infoFiltered: "(مصفى من _MAX_)",
                        zeroRecords: "لا توجد نتائج",
                        paginate: { first: "الأولى", last: "الأخيرة", next: "التالي", previous: "السابق" }
                    },
                    columnDefs: [{ targets: 9, orderable: false }]
                });

                // إظهار/إخفاء الأعمدة
                $('.allusers-col-toggle').on('change', function () {
                    var colIndex = $(this).data('col');
                    var col = table.column(colIndex);
                    col.visible(this.checked);
                });
            }
            setTimeout(function() { window.location.reload(); }, 60000);
        });
    </script>
}