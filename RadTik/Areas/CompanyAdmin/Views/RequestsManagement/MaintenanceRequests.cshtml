@model IEnumerable<RadTik.Models.MaintenanceRequest>
@using RadTik.Models
@using RadTik.Helpers
@{
    ViewData["Title"] = "طلبات الصيانة";
    var currentStatus = ViewBag.CurrentStatus as string;
    var pendingRequestsCount = (int?)ViewBag.PendingRequestsCount ?? 0;
}

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="fas fa-tools"></i>
            @ViewData["Title"]
        </h1>
        <div class="page-actions">
            <a asp-route="networkManager-requestsManagement" asp-route-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> العودة
            </a>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle alert-icon"></i>
        <div class="alert-content">@TempData["Success"]</div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle alert-icon"></i>
        <div class="alert-content">@TempData["Error"]</div>
    </div>
}

<div id="pendingMaintenanceAlert" class="alert alert-warning pending-alert" style="@(pendingRequestsCount > 0 ? "" : "display:none;")">
    <i class="fas fa-bell alert-icon"></i>
    <div class="alert-content">
        يوجد <strong id="pendingMaintenanceCount">@pendingRequestsCount</strong> <span id="pendingMaintenanceText">طلب @(pendingRequestsCount == 1 ? "صيانة" : "طلبات صيانة")</span> قيد الانتظار وتحتاج متابعة.
        @if (!string.Equals(currentStatus, "Pending", StringComparison.OrdinalIgnoreCase))
        {
            <a href="@Url.Action("MaintenanceRequests", new { status = "Pending" })" class="alert-link ms-2">
                عرض الطلبات المعلقة
            </a>
        }
    </div>
</div>

<div id="pendingToast" class="pending-toast" style="display:none;">
    <i class="fas fa-bell"></i>
    <span id="pendingToastText"></span>
</div>

<!-- فلتر الحالة -->
<div class="filter-bar">
    <a href="@Url.Action("MaintenanceRequests")" class="filter-btn @(string.IsNullOrEmpty(currentStatus) ? "active" : "")">
        الكل
    </a>
    <a href="@Url.Action("MaintenanceRequests", new { status = "Pending" })" class="filter-btn @(currentStatus == "Pending" ? "active" : "")">
        <i class="fas fa-clock"></i> في الانتظار
    </a>
    <a href="@Url.Action("MaintenanceRequests", new { status = "Accepted" })" class="filter-btn @(currentStatus == "Accepted" ? "active" : "")">
        <i class="fas fa-check"></i> مقبول
    </a>
    <a href="@Url.Action("MaintenanceRequests", new { status = "InProgress" })" class="filter-btn @(currentStatus == "InProgress" ? "active" : "")">
        <i class="fas fa-spinner"></i> قيد التنفيذ
    </a>
    <a href="@Url.Action("MaintenanceRequests", new { status = "Completed" })" class="filter-btn @(currentStatus == "Completed" ? "active" : "")">
        <i class="fas fa-check-double"></i> مكتمل
    </a>
    <a href="@Url.Action("MaintenanceRequests", new { status = "Rejected" })" class="filter-btn @(currentStatus == "Rejected" ? "active" : "")">
        <i class="fas fa-times"></i> مرفوض
    </a>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table" id="maintenanceTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>العميل</th>
                            <th>نوع المشكلة</th>
                            <th>الأولوية</th>
                            <th>الحالة</th>
                            <th>تاريخ الطلب</th>
                            <th>المسؤول</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model)
                        {
                            var statusClass = PricingDisplay.MaintenanceRequestStatusClass(request.Status);

                            var priorityClass = request.Priority switch
                            {
                                RequestPriority.High => "priority-high",
                                RequestPriority.Urgent => "priority-urgent",
                                _ => ""
                            };

                            <tr class="@(request.Status == MaintenanceRequestStatus.Pending ? "row-highlight" : "")">
                                <td>@request.Id</td>
                                <td>
                                    <div class="client-info">
                                        <div class="client-avatar">
                                            @(request.Client?.Name?.Substring(0, 1).ToUpper() ?? "?")
                                        </div>
                                        <div>
                                            <div class="client-name">@request.Client?.Name</div>
                                            <div class="client-phone">@request.Client?.PhoneNumber</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="type-badge">
                                        <i class="fas @GetTypeIcon(request.Type)"></i>
                                        @GetMaintenanceTypeName(request.Type)
                                    </span>
                                </td>
                                <td>
                                    <span class="priority-badge @priorityClass">
                                        @GetPriorityName(request.Priority)
                                    </span>
                                </td>
                                <td>
                                    <span class="status-badge @statusClass">
                                        @GetStatusName(request.Status)
                                    </span>
                                </td>
                                <td>
                                    <div class="date-info">
                                        <div>@request.RequestDate.ToString("yyyy/MM/dd")</div>
                                        <div class="time-ago">@request.RequestDate.ToString("HH:mm")</div>
                                    </div>
                                </td>
                                <td>
                                    @if (request.AssignedTo != null)
                                    {
                                        <span class="badge badge-info">@request.AssignedTo.FullName</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">غير معين</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="MaintenanceRequestDetails" asp-route-id="@request.Id" class="btn btn-sm btn-primary">
                                        <i class="fas fa-eye"></i> عرض
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-inbox"></i>
                </div>
                <h3>لا توجد طلبات</h3>
                <p>لا توجد طلبات صيانة @(string.IsNullOrEmpty(currentStatus) ? "" : "بهذه الحالة")</p>
            </div>
        }
    </div>
</div>

<style>
    .page-header {
        margin-bottom: var(--spacing-lg);
    }
    
    .page-header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .page-title {
        font-size: var(--font-2xl);
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-sm);
        padding: var(--spacing-md);
        background: var(--bg-card);
        border-radius: var(--radius);
        margin-bottom: var(--spacing-lg);
    }

    .filter-btn {
        padding: var(--spacing-sm) var(--spacing-md);
        border-radius: var(--radius-sm);
        text-decoration: none;
        color: var(--text-secondary);
        background: var(--bg-hover);
        font-size: var(--font-sm);
        display: flex;
        align-items: center;
        gap: var(--spacing-xs);
        transition: all var(--transition);
    }

    .filter-btn:hover, .filter-btn.active {
        background: var(--primary);
        color: white;
    }

    .card {
        background: var(--bg-card);
        border-radius: var(--radius);
        box-shadow: var(--shadow-sm);
    }

    .card-body {
        padding: var(--spacing-md);
    }

    .row-highlight {
        background: rgba(255, 152, 0, 0.05) !important;
    }

    .client-info {
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .client-avatar {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: var(--primary);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
        font-size: var(--font-sm);
    }

    .client-name {
        font-weight: 600;
        font-size: var(--font-sm);
    }

    .client-phone {
        font-size: var(--font-xs);
        color: var(--text-muted);
    }

    .type-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 4px 8px;
        background: var(--bg-hover);
        border-radius: var(--radius-sm);
        font-size: var(--font-xs);
    }


    .date-info {
        font-size: var(--font-sm);
    }

    .time-ago {
        font-size: var(--font-xs);
        color: var(--text-muted);
    }

    .empty-state {
        text-align: center;
        padding: var(--spacing-2xl);
    }

    .empty-icon {
        font-size: 4rem;
        color: var(--text-muted);
        margin-bottom: var(--spacing-md);
    }

    .pending-alert {
        border-right: 4px solid #f59e0b;
    }

    .pending-toast {
        position: fixed;
        top: 18px;
        left: 18px;
        z-index: 1080;
        background: #1f2937;
        color: #fff;
        padding: 10px 14px;
        border-radius: 10px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.25);
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-size: 0.9rem;
    }

</style>

@functions {
    string GetMaintenanceTypeName(MaintenanceType type) => MaintenanceCatalog.GetDisplayName(type);

    string GetTypeIcon(MaintenanceType type) => MaintenanceCatalog.GetIcon(type);

    string GetStatusName(MaintenanceRequestStatus status) => PricingDisplay.MaintenanceRequestStatusLabel(status);

    string GetPriorityName(RequestPriority priority) => PricingDisplay.RequestPriorityLabel(priority);
}

@section Scripts {
    <script>
        $(document).ready(function () {
            let currentPendingCount = @pendingRequestsCount;
            let toastTimer = null;
            const alertBox = document.getElementById('pendingMaintenanceAlert');
            const countEl = document.getElementById('pendingMaintenanceCount');
            const textEl = document.getElementById('pendingMaintenanceText');
            const toastEl = document.getElementById('pendingToast');
            const toastTextEl = document.getElementById('pendingToastText');

            function getLabel(value) {
                return value === 1 ? 'طلب صيانة' : 'طلبات صيانة';
            }

            function showToast(message) {
                if (!toastEl || !toastTextEl) return;
                toastTextEl.textContent = message;
                toastEl.style.display = 'inline-flex';
                if (toastTimer) {
                    clearTimeout(toastTimer);
                }
                toastTimer = setTimeout(() => {
                    toastEl.style.display = 'none';
                }, 3500);
            }

            function syncPendingUi(nextCount) {
                if (!alertBox || !countEl || !textEl) return;
                if (nextCount > 0) {
                    alertBox.style.display = '';
                    countEl.textContent = String(nextCount);
                    textEl.textContent = getLabel(nextCount);
                } else {
                    alertBox.style.display = 'none';
                }
            }

            async function refreshPendingCount() {
                try {
                    const response = await fetch('@Url.Action("GetPendingRequestsCount", "RequestsManagement")', {
                        method: 'GET',
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });
                    if (!response.ok) return;

                    const data = await response.json();
                    const nextCount = Number(data?.maintenance ?? 0);
                    if (!Number.isFinite(nextCount)) return;

                    if (nextCount > currentPendingCount) {
                        const delta = nextCount - currentPendingCount;
                        showToast(`يوجد ${delta} ${delta === 1 ? 'طلب جديد' : 'طلبات جديدة'} بانتظار المعالجة`);
                    }

                    currentPendingCount = nextCount;
                    syncPendingUi(nextCount);
                } catch {
                    // Ignore transient polling errors.
                }
            }

            $('#maintenanceTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/ar.json'
                },
                order: [[5, 'desc']],
                pageLength: 25
            });

            setInterval(refreshPendingCount, 60000);
        });
    </script>
}

