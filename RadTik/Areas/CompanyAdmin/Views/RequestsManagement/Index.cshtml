@using RadTik.Models
@{
    ViewData["Title"] = "إدارة الطلبات";
    
    var pendingMaintenance = ViewBag.PendingMaintenanceCount ?? 0;
    var inProgressMaintenance = ViewBag.InProgressMaintenanceCount ?? 0;
    var completedMaintenance = ViewBag.CompletedMaintenanceCount ?? 0;
    
    var pendingSpeedChange = ViewBag.PendingSpeedChangeCount ?? 0;
    var approvedSpeedChange = ViewBag.ApprovedSpeedChangeCount ?? 0;
    var implementedSpeedChange = ViewBag.ImplementedSpeedChangeCount ?? 0;

    var recentMaintenanceRequests = ViewBag.RecentMaintenanceRequests as List<MaintenanceRequest> ?? new List<MaintenanceRequest>();
    var recentSpeedChangeRequests = ViewBag.RecentSpeedChangeRequests as List<SpeedChangeRequest> ?? new List<SpeedChangeRequest>();
}

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="fas fa-tasks"></i>
            @ViewData["Title"]
        </h1>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle alert-icon"></i>
        <div class="alert-content">@TempData["Success"]</div>
    </div>
}

<!-- إحصائيات -->
<div class="stats-grid">
    <!-- طلبات الصيانة -->
    <div class="stats-section">
        <h3 class="stats-title"><i class="fas fa-tools"></i> طلبات الصيانة</h3>
        <div class="stats-row">
            <a href="@Url.RouteUrl("networkManager-requestsManagement", new { action = "MaintenanceRequests", status = "Pending" })" class="stat-card stat-warning clickable">
                <div class="stat-icon"><i class="fas fa-clock"></i></div>
                <div class="stat-info">
                    <span class="stat-number">@pendingMaintenance</span>
                    <span class="stat-label">في الانتظار</span>
                </div>
            </a>
            <a href="@Url.RouteUrl("networkManager-requestsManagement", new { action = "MaintenanceRequests", status = "InProgress" })" class="stat-card stat-info clickable">
                <div class="stat-icon"><i class="fas fa-spinner"></i></div>
                <div class="stat-info">
                    <span class="stat-number">@inProgressMaintenance</span>
                    <span class="stat-label">قيد التنفيذ</span>
                </div>
            </a>
            <a href="@Url.RouteUrl("networkManager-requestsManagement", new { action = "MaintenanceRequests", status = "Completed" })" class="stat-card stat-success clickable">
                <div class="stat-icon"><i class="fas fa-check"></i></div>
                <div class="stat-info">
                    <span class="stat-number">@completedMaintenance</span>
                    <span class="stat-label">مكتمل</span>
                </div>
            </a>
        </div>
    </div>

    <!-- طلبات تغيير السرعة -->
    <div class="stats-section">
        <h3 class="stats-title"><i class="fas fa-tachometer-alt"></i> طلبات تغيير السرعة</h3>
        <div class="stats-row">
            <a href="@Url.RouteUrl("networkManager-requestsManagement", new { action = "SpeedChangeRequests", status = "Pending" })" class="stat-card stat-warning clickable">
                <div class="stat-icon"><i class="fas fa-clock"></i></div>
                <div class="stat-info">
                    <span class="stat-number">@pendingSpeedChange</span>
                    <span class="stat-label">في الانتظار</span>
                </div>
            </a>
            <a href="@Url.RouteUrl("networkManager-requestsManagement", new { action = "SpeedChangeRequests", status = "Approved" })" class="stat-card stat-info clickable">
                <div class="stat-icon"><i class="fas fa-thumbs-up"></i></div>
                <div class="stat-info">
                    <span class="stat-number">@approvedSpeedChange</span>
                    <span class="stat-label">تمت الموافقة</span>
                </div>
            </a>
            <a href="@Url.RouteUrl("networkManager-requestsManagement", new { action = "SpeedChangeRequests", status = "Implemented" })" class="stat-card stat-success clickable">
                <div class="stat-icon"><i class="fas fa-check-double"></i></div>
                <div class="stat-info">
                    <span class="stat-number">@implementedSpeedChange</span>
                    <span class="stat-label">تم التنفيذ</span>
                </div>
            </a>
        </div>
    </div>
</div>

<!-- آخر الطلبات المعلقة -->
<div class="content-grid">
    <!-- طلبات الصيانة المعلقة -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-tools text-warning"></i>
                طلبات صيانة في الانتظار
            </h3>
            <a href="@Url.RouteUrl("networkManager-requestsManagement", new { action = "MaintenanceRequests" })" class="btn btn-sm btn-outline-primary">
                عرض الكل <i class="fas fa-arrow-left"></i>
            </a>
        </div>
        <div class="card-body">
            @if (recentMaintenanceRequests.Any())
            {
                <div class="requests-list">
                    @foreach (var request in recentMaintenanceRequests)
                    {
                        <a href="@Url.RouteUrl("networkManager-requestsManagement", new { action = "MaintenanceRequestDetails", id = request.Id })" class="request-item">
                            <div class="request-avatar">
                                @(request.Client?.Name?.Substring(0, 1).ToUpper() ?? "?")
                            </div>
                            <div class="request-info">
                                <div class="request-client">@request.Client?.Name</div>
                                <div class="request-type">@GetMaintenanceTypeName(request.Type)</div>
                            </div>
                            <div class="request-time">
                                @GetTimeAgo(request.RequestDate)
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="empty-mini">
                    <i class="fas fa-check-circle text-success"></i>
                    <span>لا توجد طلبات معلقة</span>
                </div>
            }
        </div>
    </div>

    <!-- طلبات تغيير السرعة المعلقة -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-tachometer-alt text-warning"></i>
                طلبات تغيير سرعة في الانتظار
            </h3>
            <a href="@Url.RouteUrl("networkManager-requestsManagement", new { action = "SpeedChangeRequests" })" class="btn btn-sm btn-outline-primary">
                عرض الكل <i class="fas fa-arrow-left"></i>
            </a>
        </div>
        <div class="card-body">
            @if (recentSpeedChangeRequests.Any())
            {
                <div class="requests-list">
                    @foreach (var request in recentSpeedChangeRequests)
                    {
                        <a href="@Url.RouteUrl("networkManager-requestsManagement", new { action = "SpeedChangeRequestDetails", id = request.Id })" class="request-item">
                            <div class="request-avatar speed">
                                <i class="fas fa-exchange-alt"></i>
                            </div>
                            <div class="request-info">
                                <div class="request-client">@request.Client?.Name</div>
                                <div class="request-type">
                                    @request.CurrentProfile?.Name → @request.RequestedProfile?.Name
                                </div>
                            </div>
                            <div class="request-time">
                                @GetTimeAgo(request.RequestDate)
                            </div>
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="empty-mini">
                    <i class="fas fa-check-circle text-success"></i>
                    <span>لا توجد طلبات معلقة</span>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .page-header {
        margin-bottom: var(--spacing-lg);
    }
    
    .page-title {
        font-size: var(--font-2xl);
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: var(--spacing-lg);
        margin-bottom: var(--spacing-lg);
    }

    .stats-section {
        background: var(--bg-card);
        border-radius: var(--radius);
        padding: var(--spacing-lg);
        box-shadow: var(--shadow-sm);
    }

    .stats-title {
        font-size: var(--font-lg);
        margin-bottom: var(--spacing-md);
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .stats-row {
        display: flex;
        gap: var(--spacing-md);
    }

    .stat-card {
        flex: 1;
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
        padding: var(--spacing-md);
        background: var(--bg-hover);
        border-radius: var(--radius);
        border-right: 3px solid;
        text-decoration: none;
        color: inherit;
        transition: all var(--transition);
    }

    .stat-card.clickable:hover {
        transform: translateY(-2px);
        box-shadow: var(--shadow-md);
    }

    .stat-warning { border-color: var(--warning); }
    .stat-info { border-color: var(--info); }
    .stat-success { border-color: var(--success); }

    .stat-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 1rem;
    }

    .stat-warning .stat-icon { background: var(--warning); }
    .stat-info .stat-icon { background: var(--info); }
    .stat-success .stat-icon { background: var(--success); }

    .stat-info-text {
        display: flex;
        flex-direction: column;
    }

    .stat-number {
        font-size: var(--font-xl);
        font-weight: 700;
        line-height: 1;
    }

    .stat-label {
        font-size: var(--font-xs);
        color: var(--text-muted);
    }

    .content-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
        gap: var(--spacing-lg);
    }

    .card {
        background: var(--bg-card);
        border-radius: var(--radius);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--spacing-md) var(--spacing-lg);
        background: var(--bg-hover);
        border-bottom: 1px solid var(--border-color);
    }

    .card-title {
        margin: 0;
        font-size: var(--font-md);
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .card-body {
        padding: var(--spacing-md);
    }

    .requests-list {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
    }

    .request-item {
        display: flex;
        align-items: center;
        gap: var(--spacing-md);
        padding: var(--spacing-sm) var(--spacing-md);
        border-radius: var(--radius-sm);
        text-decoration: none;
        color: inherit;
        transition: background var(--transition);
    }

    .request-item:hover {
        background: var(--bg-hover);
    }

    .request-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: var(--primary);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 600;
    }

    .request-avatar.speed {
        background: var(--info);
    }

    .request-info {
        flex: 1;
    }

    .request-client {
        font-weight: 600;
        font-size: var(--font-sm);
    }

    .request-type {
        font-size: var(--font-xs);
        color: var(--text-muted);
    }

    .request-time {
        font-size: var(--font-xs);
        color: var(--text-muted);
    }

    .empty-mini {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--spacing-sm);
        padding: var(--spacing-lg);
        color: var(--text-muted);
    }

    .empty-mini i {
        font-size: 1.5rem;
    }

    @@media (max-width: 768px) {
        .stats-grid, .content-grid {
            grid-template-columns: 1fr;
        }

        .stats-row {
            flex-direction: column;
        }
    }
</style>

@functions {
    string GetMaintenanceTypeName(MaintenanceType type) => MaintenanceCatalog.GetDisplayName(type);

    string GetTimeAgo(DateTime dateTime)
    {
        var timeSpan = DateTime.Now - dateTime;
        if (timeSpan.TotalMinutes < 1) return "الآن";
        if (timeSpan.TotalMinutes < 60) return $"منذ {(int)timeSpan.TotalMinutes} دقيقة";
        if (timeSpan.TotalHours < 24) return $"منذ {(int)timeSpan.TotalHours} ساعة";
        if (timeSpan.TotalDays < 7) return $"منذ {(int)timeSpan.TotalDays} يوم";
        return dateTime.ToString("yyyy/MM/dd");
    }
}

