@model IEnumerable<RadTik.Models.NetworkWalletTransaction>
@using RadTik.Models
@using RadTik.Helpers
@{
    ViewData["Title"] = ViewData["Title"] ?? "محفظة الموظف";
}

<div class="employee-wallet-page">
    <div class="page-header mb-3">
        <h1><i class="fas fa-wallet text-primary"></i> @ViewData["Title"]</h1>
        <p class="text-muted mb-0">عرض رصيد الشبكة التابعة للموظف وآخر الحركات المالية.</p>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">الشبكة</div>
                    <div class="fw-bold fs-5">@ViewBag.NetworkName</div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted small">الرصيد الحالي</div>
                    <div class="fw-bold fs-5 text-success">@(((decimal)ViewBag.NetworkBalance).ToString("N2")) ل.س.ج</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 employee-wallet-table-card">
        <div class="card-header bg-white">
            <strong>آخر الحركات</strong>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle mb-0 employee-wallet-table">
                    <thead>
                        <tr>
                            <th>التاريخ</th>
                            <th>النوع</th>
                            <th>المبلغ</th>
                            <th>الرصيد بعد الحركة</th>
                            <th>تفاصيل النوع</th>
                            <th>ملاحظات</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">لا توجد حركات حالياً.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var t in Model)
                        {
                            <tr>
                                <td data-label="التاريخ">@t.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                <td data-label="النوع">@NetworkWalletTransactionDisplayHelper.TypeLabel(t.Type)</td>
                                <td data-label="المبلغ" class="@(t.SignedAmount >= 0 ? "text-success" : "text-danger")">@t.SignedAmount.ToString("N2")</td>
                                <td data-label="الرصيد بعد الحركة">@t.NewBalance.ToString("N2")</td>
                                <td data-label="تفاصيل النوع">@NetworkWalletTransactionDisplayHelper.TypeDetails(t)</td>
                                <td data-label="ملاحظات">@(string.IsNullOrWhiteSpace(t.Notes) ? "—" : t.Notes)</td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
