@model RadTik.Models.Receiver

@{
    ViewData["Title"] = "إضافة مستقبل";
    var hasReceiverPricing = (bool?)(ViewBag.ReceiverCreateChargeHasPricing) == true;
    var receiverChargeAmount = (decimal?)(ViewBag.ReceiverCreateChargeAmount) ?? 0m;
    var receiverWalletBalance = (decimal?)(ViewBag.ReceiverCreateChargeWalletBalance) ?? 0m;
}

<div class="employee-receiver-hero card border-0 shadow-sm mb-3">
    <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h2 class="mb-1 hero-title">
                <i class="fas fa-plus-circle"></i>
                @ViewData["Title"]
            </h2>
            <p class="text-muted mb-0">إضافة مستقبل جديد ضمن القطاع المحدد مع بيانات الشبكة المطلوبة.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary action-btn">
            <i class="fas fa-arrow-right"></i> رجوع
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm receiver-form-card">
    <div class="card-body">
        <div class="alert alert-info mb-3">
            <i class="fas fa-user-check me-1"></i>
            سيتم إرسال الإضافة كطلب موافقة إلى مدير الشركة.
            @if (hasReceiverPricing)
            {
                <text>الحسم المتوقع بعد الاعتماد: <strong>@receiverChargeAmount.ToString("N2") ل.س.ج</strong> (الرصيد الحالي: @receiverWalletBalance.ToString("N2") ل.س.ج).</text>
            }
            else
            {
                <text>لا توجد تسعيرة فعّالة حالياً لإضافة المستقبل، لذلك لا يوجد حسم متوقع.</text>
            }
            <span class="d-block mt-1">لن يتم أي حسم الآن، وإنما بعد اعتماد مدير الشركة فقط.</span>
        </div>

        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">اسم المستقبل</label>
                    <input asp-for="Name" class="form-control elegant-input" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SectorId" class="form-label">القطاع</label>
                    <select asp-for="SectorId" class="form-select elegant-input" asp-items="@(ViewData["SectorId"] as SelectList)">
                        <option value="">-- اختر قطاع --</option>
                    </select>
                    <span asp-validation-for="SectorId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="IPAddress" class="form-label">IP</label>
                    <input asp-for="IPAddress" class="form-control elegant-input" value="@ViewBag.NextIP" />
                    <span asp-validation-for="IPAddress" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="NetworkMask" class="form-label">قناع الشبكة</label>
                    <input asp-for="NetworkMask" class="form-control elegant-input" value="@ViewBag.DefaultMask" />
                    <span asp-validation-for="NetworkMask" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="Latitude" class="form-label">Latitude</label>
                    <input asp-for="Latitude" class="form-control elegant-input" type="number" step="0.000001" />
                    <span asp-validation-for="Latitude" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Longitude" class="form-label">Longitude</label>
                    <input asp-for="Longitude" class="form-control elegant-input" type="number" step="0.000001" />
                    <span asp-validation-for="Longitude" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label asp-for="ElevationMeters" class="form-label">الارتفاع عن سطح البحر (م)</label>
                    <input asp-for="ElevationMeters" class="form-control elegant-input" type="number" step="0.1" placeholder="اختياري" />
                    <span asp-validation-for="ElevationMeters" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AntennaHeightAglMeters" class="form-label">ارتفاع الهوائي عن الأرض (م)</label>
                    <input asp-for="AntennaHeightAglMeters" class="form-control elegant-input" type="number" step="0.1" placeholder="6" />
                    <span asp-validation-for="AntennaHeightAglMeters" class="text-danger"></span>
                </div>

                <input asp-for="IsActive" type="hidden" value="false" />
            </div>

            <div class="mt-4 d-flex flex-wrap gap-2 align-items-start">
                <button type="submit" class="btn btn-success action-btn">
                    <i class="fas fa-save"></i> حفظ
                </button>
                <button type="button" class="btn btn-outline-primary action-btn" id="btnAnalyzeLosEmp" title="تحليل خط الرؤية (تضاريس + مبانٍ تقريبية)">
                    <i class="fas fa-mountain"></i> تحليل خط الرؤية
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary action-btn">إلغاء</a>
            </div>

            <div id="losResultPanelEmp" class="mt-3 p-3 border rounded bg-light d-none" role="region" aria-live="polite" style="border-color:#dbe4f0!important;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong><i class="fas fa-mountain"></i> نتيجة تحليل خط الرؤية</strong>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnLosResultCloseEmp">×</button>
                </div>
                <div id="losResultContentEmp" class="small"></div>
            </div>
        </form>
    </div>
</div>

<style>
    .employee-receiver-hero { background: linear-gradient(135deg, #f8fbff 0%, #eef5ff 100%); }
    .hero-title { color: #1b2a4b; font-weight: 700; }
    .action-btn { border-radius: 0.65rem; font-weight: 600; }
    .receiver-form-card { border-radius: 0.95rem; }
    .elegant-input { border-radius: 0.7rem; border-color: #dbe4f0; }
    .elegant-input:focus { border-color: #93c5fd; box-shadow: 0 0 0 .2rem rgba(37,99,235,.12); }
</style>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            var analyzeLosUrl = '@Url.Action("AnalyzeLineOfSight", "Receiver", new { area = "CompanyEmployee" })';
            function parseOpt(el) {
                if (!el || el.value === '' || el.value === null) return null;
                var v = parseFloat(el.value);
                return isFinite(v) ? v : null;
            }
            function runLos() {
                var sectorEl = document.querySelector('[name="SectorId"]');
                var latEl = document.querySelector('[name="Latitude"]');
                var lngEl = document.querySelector('[name="Longitude"]');
                var elevEl = document.querySelector('[name="ElevationMeters"]');
                var aglEl = document.querySelector('[name="AntennaHeightAglMeters"]');
                var sectorId = sectorEl && sectorEl.value ? parseInt(sectorEl.value, 10) : 0;
                if (!sectorId) {
                    alert('يرجى اختيار القطاع أولاً');
                    return;
                }
                var lat = latEl ? parseFloat(latEl.value) : NaN;
                var lng = lngEl ? parseFloat(lngEl.value) : NaN;
                if (!isFinite(lat) || !isFinite(lng)) {
                    alert('يرجى إدخال خطي العرض والطول');
                    return;
                }
                var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                var token = tokenInput ? tokenInput.value : '';
                var panel = document.getElementById('losResultPanelEmp');
                var content = document.getElementById('losResultContentEmp');
                var btn = document.getElementById('btnAnalyzeLosEmp');
                var prev = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                panel.classList.remove('d-none');
                content.textContent = 'جارٍ التحليل...';

                fetch(analyzeLosUrl, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'X-CSRF-TOKEN': token,
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({
                        sectorId: sectorId,
                        receiverLatitude: lat,
                        receiverLongitude: lng,
                        receiverElevationMeters: parseOpt(elevEl),
                        receiverAntennaHeightAglMeters: parseOpt(aglEl)
                    })
                })
                    .then(function (r) { if (!r.ok) throw new Error(); return r.json(); })
                    .then(function (data) {
                        if (!data || !data.success) {
                            content.innerHTML = '<span class="text-danger">' + (data && data.message ? data.message : 'فشل التحليل') + '</span>';
                            return;
                        }
                        var a = data.analysis;
                        var terrain = a.terrainClear ? 'مرجّح مقبول' : 'قد يوجد حجب';
                        content.innerHTML =
                            '<div>المسافة: ' + a.distanceMeters + ' م</div>' +
                            '<div>النتيجة: ' + terrain + '</div>' +
                            '<div class="text-muted mt-1">' + (a.terrainNote || '') + '</div>';
                    })
                    .catch(function () {
                        content.innerHTML = '<span class="text-danger">تعذر إكمال التحليل.</span>';
                    })
                    .finally(function () {
                        btn.disabled = false;
                        btn.innerHTML = prev;
                    });
            }
            var b = document.getElementById('btnAnalyzeLosEmp');
            if (b) b.addEventListener('click', runLos);
            var c = document.getElementById('btnLosResultCloseEmp');
            if (c) c.addEventListener('click', function () {
                document.getElementById('losResultPanelEmp').classList.add('d-none');
            });
        })();
    </script>
}

