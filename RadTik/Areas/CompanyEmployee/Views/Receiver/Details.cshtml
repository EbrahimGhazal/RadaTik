@model RadTik.Models.Receiver

@{
    ViewData["Title"] = "تفاصيل المستقبل";
    var canEdit = await PermissionService.HasPermissionAsync(User, "Receivers.Edit");
    var isPendingApproval = (bool?)ViewBag.IsPendingReceiverApproval == true;
}

<div class="employee-receiver-hero card border-0 shadow-sm mb-3">
    <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h2 class="mb-1 hero-title">
                <i class="fas fa-satellite-dish"></i>
                @ViewData["Title"]: @Model.Name
            </h2>
            <p class="text-muted mb-0">تفاصيل كاملة عن بيانات المستقبل والموقع والارتباط بالقطاع.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-outline-secondary action-btn">
            <i class="fas fa-arrow-right"></i> رجوع
        </a>
        @if (canEdit)
        {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning action-btn">
                <i class="fas fa-edit"></i> تعديل
            </a>
        }
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm receiver-detail-card">
            <div class="card-header receiver-detail-header"><strong>بيانات المستقبل</strong></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">الاسم</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">IP</dt>
                    <dd class="col-sm-8"><code>@Model.IPAddress</code></dd>

                    <dt class="col-sm-4">قناع الشبكة</dt>
                    <dd class="col-sm-8">@Model.NetworkMask</dd>

                    <dt class="col-sm-4">القطاع</dt>
                    <dd class="col-sm-8">@Model.Sector?.Name</dd>

                    <dt class="col-sm-4">الحالة</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">نشط</span>
                        }
                        else if (isPendingApproval)
                        {
                            <span class="badge bg-warning text-dark">بانتظار موافقة المدير</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">متوقف</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm receiver-detail-card">
            <div class="card-header receiver-detail-header"><strong>الموقع</strong></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Latitude</dt>
                    <dd class="col-sm-8">@Model.Latitude</dd>

                    <dt class="col-sm-4">Longitude</dt>
                    <dd class="col-sm-8">@Model.Longitude</dd>

                    <dt class="col-sm-4">العملاء</dt>
                    <dd class="col-sm-8">@Model.Clients?.Count</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<style>
    .employee-receiver-hero { background: linear-gradient(135deg, #f8fbff 0%, #eef5ff 100%); }
    .hero-title { color: #1b2a4b; font-weight: 700; }
    .action-btn { border-radius: 0.65rem; font-weight: 600; }
    .receiver-detail-card { border-radius: 0.95rem; overflow: hidden; }
    .receiver-detail-header { background: #f8fafc; border-bottom: 1px solid #dbe4f0; color: #344054; }
</style>

