@using RadTik.Security
@inject RadTik.Services.PermissionService PermissionService
@inject RadTik.Services.IFeatureAccessService FeatureAccess

@{
    // CompanyEmployee sidebar (CompanyEmployee/EmployeeLegacy).
    var isAuthenticated = (bool?)(ViewData["Layout_IsAuthenticated"]) == true;
    var userName = ViewData["Layout_UserName"] as string ?? (User.Identity?.Name ?? "مستخدم");
    var userInitials = ViewData["Layout_UserInitials"] as string ?? (userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "م");
    var userRole = ViewData["Layout_UserRole"] as string ?? "موظف";

    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<aside class="sidebar sidebar-pro" id="sidebar">
    <div class="sidebar-header">
        <div class="sidebar-logo">
            <i class="fas fa-briefcase"></i>
        </div>
        <div class="sidebar-brand">
            <span class="sidebar-brand-name">RadTik</span>
            <small class="sidebar-brand-sub">بوابة الموظف</small>
        </div>
    </div>

    <nav class="sidebar-nav" data-single-open="true">
        @if (!isAuthenticated)
        {
            <div class="nav-section">
                <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                    <i class="fas fa-bars"></i>
                    <span>القائمة</span>
                    <i class="fas fa-chevron-down nav-section-chevron"></i>
                </div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link" asp-route="reglog-login">
                            <span class="nav-icon"><i class="fas fa-sign-in-alt"></i></span>
                            <span>تسجيل الدخول</span>
                        </a>
                    </li>
                </ul>
            </div>
        }
        else
        {
            // Permission-based navigation (CompanyEmployee)
            var canUseMikroTikServers = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.MikroTikServers);
            var canUseSectors = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Sectors);
            var canUseReceivers = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Receivers);
            var canUseRequests = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Requests);

            var canViewMikroTikServers = canUseMikroTikServers && await PermissionService.HasPermissionAsync(User, "MikroTikServers.View");
            var canViewSectors = canUseSectors && await PermissionService.HasPermissionAsync(User, "Sectors.View");
            var canViewReceivers = canUseReceivers && await PermissionService.HasPermissionAsync(User, "Receivers.View");

            var canViewRequests = canUseRequests && await PermissionService.HasPermissionAsync(User, "Requests.View");
            var canManageMaintenance = canUseRequests && await PermissionService.HasPermissionAsync(User, "MaintenanceRequests.Manage");
            var canImplementSpeedChange = canUseRequests && await PermissionService.HasPermissionAsync(User, "SpeedChange.Implement");

            <div class="nav-section">
                <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                    <i class="fas fa-th-large"></i>
                    <span>الرئيسية</span>
                    <i class="fas fa-chevron-down nav-section-chevron"></i>
                </div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Dashboard" ? "active" : "")"
                           asp-route="employee-dashboard">
                            <span class="nav-icon"><i class="fas fa-tachometer-alt"></i></span>
                            <span>لوحة التحكم</span>
                        </a>
                    </li>
                </ul>
            </div>

            @if (canViewSectors || canViewReceivers || canViewMikroTikServers)
            {
                <div class="nav-section">
                    <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                        <i class="fas fa-network-wired"></i>
                        <span>إدارة الشبكة</span>
                        <i class="fas fa-chevron-down nav-section-chevron"></i>
                    </div>
                    <ul class="nav-list">
                        @if (canViewMikroTikServers)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controller == "MikroTikServers" ? "active" : "")"
                                   asp-area="CompanyEmployee" asp-controller="MikroTikServers" asp-action="Index">
                                    <span class="nav-icon"><i class="fas fa-server"></i></span>
                                    <span>المخدمات</span>
                                </a>
                            </li>
                        }
                        @if (canViewSectors)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Sector" ? "active" : "")"
                                   asp-area="CompanyEmployee" asp-controller="Sector" asp-action="Index">
                                    <span class="nav-icon"><i class="fas fa-broadcast-tower"></i></span>
                                    <span>المرسلات (القطاعات)</span>
                                </a>
                            </li>
                        }
                        @if (canViewReceivers)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controller == "Receiver" ? "active" : "")"
                                   asp-area="CompanyEmployee" asp-controller="Receiver" asp-action="Index">
                                    <span class="nav-icon"><i class="fas fa-satellite-dish"></i></span>
                                    <span>المستقبلات</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }

            @if (canViewRequests || canManageMaintenance || canImplementSpeedChange)
            {
                <div class="nav-section">
                    <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                        <i class="fas fa-tasks"></i>
                        <span>إدارة الطلبات</span>
                        <i class="fas fa-chevron-down nav-section-chevron"></i>
                    </div>
                    <ul class="nav-list">
                        @if (canViewRequests)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controller == "RequestsManagement" && action == "Index" ? "active" : "")"
                                   asp-route="employee-requestsManagement" asp-route-action="Index">
                                    <span class="nav-icon"><i class="fas fa-clipboard-list"></i></span>
                                    <span>لوحة الطلبات</span>
                                    <span class="nav-badge" id="pendingRequestsBadge" style="display: none;">0</span>
                                </a>
                            </li>
                        }
                        @if (canViewRequests || canManageMaintenance)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controller == "RequestsManagement" && action == "MaintenanceRequests" ? "active" : "")"
                                   asp-route="employee-requestsManagement" asp-route-action="MaintenanceRequests">
                                    <span class="nav-icon"><i class="fas fa-wrench"></i></span>
                                    <span>طلبات الصيانة</span>
                                </a>
                            </li>
                        }
                        @if (canViewRequests || canImplementSpeedChange)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(controller == "RequestsManagement" && action == "SpeedChangeRequests" ? "active" : "")"
                                   asp-route="employee-requestsManagement" asp-route-action="SpeedChangeRequests">
                                    <span class="nav-icon"><i class="fas fa-tachometer-alt"></i></span>
                                    <span>طلبات تغيير السرعة</span>
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <div class="nav-section">
                    <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                        <i class="fas fa-tasks"></i>
                        <span>إدارة الطلبات</span>
                        <i class="fas fa-chevron-down nav-section-chevron"></i>
                    </div>
                    <ul class="nav-list">
                        <li class="nav-item">
                            <div class="nav-link" style="opacity:.7; cursor: default;">
                                <i class="fas fa-lock"></i>
                                <span>لا توجد صلاحيات لعرض الطلبات</span>
                            </div>
                        </li>
                    </ul>
                </div>
            }
        }
    </nav>

</aside>

