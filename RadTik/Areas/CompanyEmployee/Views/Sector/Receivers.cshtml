@model IEnumerable<RadTik.Models.Receiver>

@{
    ViewData["Title"] = "مستقبلات القطاع";
    var sectorName = (string?)ViewBag.SectorName ?? "";
    var totalReceivers = Model?.Count() ?? 0;
    var activeReceivers = Model?.Count(r => r.IsActive) ?? 0;
    var inactiveReceivers = totalReceivers - activeReceivers;
    var clientsCount = Model?.Sum(r => r.Clients?.Count ?? 0) ?? 0;
}

<div class="employee-sector-hero card border-0 shadow-sm mb-3">
    <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h2 class="mb-1 hero-title">
                <i class="fas fa-satellite-dish"></i>
                @ViewData["Title"] @if (!string.IsNullOrWhiteSpace(sectorName)) { <text>: @sectorName</text> }
            </h2>
            <p class="text-muted mb-0">عرض منظم للمستقبلات المرتبطة بالقطاع المحدد.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary action-btn">
            <i class="fas fa-arrow-right"></i> رجوع للقطاعات
        </a>
    </div>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-3 col-6">
        <div class="card stat-card total h-100"><div class="card-body"><div class="stat-label">الإجمالي</div><div class="stat-value">@totalReceivers</div></div></div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card stat-card active h-100"><div class="card-body"><div class="stat-label">نشط</div><div class="stat-value">@activeReceivers</div></div></div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card stat-card inactive h-100"><div class="card-body"><div class="stat-label">متوقف</div><div class="stat-value">@inactiveReceivers</div></div></div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card stat-card clients h-100"><div class="card-body"><div class="stat-label">عملاء مرتبطون</div><div class="stat-value">@clientsCount</div></div></div>
    </div>
</div>

<div class="card border-0 shadow-sm table-card">
    <div class="card-body">
        <div class="table-responsive table-wrap">
            <table class="table table-hover align-middle section-table">
                <thead>
                    <tr>
                        <th>المستقبل</th>
                        <th>IP</th>
                        <th>عدد العملاء</th>
                        <th>الحالة</th>
                        <th style="width:160px;">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in (Model ?? Enumerable.Empty<RadTik.Models.Receiver>()))
                    {
                        <tr>
                            <td><strong>@r.Name</strong></td>
                            <td><code>@r.IPAddress</code></td>
                            <td>@(r.Clients?.Count ?? 0)</td>
                            <td>
                                @if (r.IsActive)
                                {
                                    <span class="badge bg-success">نشط</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">متوقف</span>
                                }
                            </td>
                            <td>
                                <a asp-area="CompanyEmployee" asp-controller="Receiver" asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-eye"></i> تفاصيل
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .employee-sector-hero { background: linear-gradient(135deg, #f8fbff 0%, #eef5ff 100%); }
    .hero-title { color: #1b2a4b; font-weight: 700; }
    .action-btn { border-radius: 0.65rem; font-weight: 600; }
    .stat-card { border: 1px solid #e9ecef; border-radius: 0.9rem; }
    .stat-label { color: #6c757d; font-size: 0.88rem; }
    .stat-value { margin-top: 0.2rem; font-weight: 700; font-size: 1.35rem; }
    .stat-card.total .stat-value { color: #0d6efd; }
    .stat-card.active .stat-value { color: #198754; }
    .stat-card.inactive .stat-value { color: #6c757d; }
    .stat-card.clients .stat-value { color: #0dcaf0; }
    .table-card { border-radius: 0.95rem; }
    .table-wrap { border: 1px solid #e6edf6; border-radius: 0.9rem; }
    .section-table thead th { background: #f8fafc; color: #344054; border-bottom: 1px solid #dbe4f0; font-weight: 700; }
    .section-table td, .section-table th { padding: 0.68rem 0.8rem; vertical-align: middle; white-space: nowrap; }
    .section-table tbody tr:hover { background: #f7fbff; }
</style>

