@model RadTik.Models.Sector

@{
    ViewData["Title"] = "حذف قطاع";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0 text-danger">
        <i class="fas fa-trash"></i>
        @ViewData["Title"]
    </h2>
    <a asp-action="Index" class="btn btn-secondary btn-sm">
        <i class="fas fa-arrow-right"></i> رجوع
    </a>
</div>

<div class="alert alert-warning">
    <i class="fas fa-exclamation-triangle"></i>
    هل أنت متأكد من حذف القطاع <strong>@Model.Name</strong>؟
</div>

<div class="card">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">الاسم</dt>
            <dd class="col-sm-9">@Model.Name</dd>

            <dt class="col-sm-3">IP</dt>
            <dd class="col-sm-9"><code>@Model.IPAddress</code></dd>
        </dl>

        <form asp-action="Delete" method="post" class="mt-3">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <button type="submit" class="btn btn-danger">
                <i class="fas fa-trash"></i> تأكيد الحذف
            </button>
            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
                إلغاء
            </a>
        </form>
    </div>
</div>

