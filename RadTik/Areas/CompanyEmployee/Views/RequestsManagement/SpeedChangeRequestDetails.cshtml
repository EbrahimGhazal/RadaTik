@model RadTik.Models.SpeedChangeRequest
@using RadTik.Models
@using RadTik.Helpers
@inject RadTik.Services.PermissionService PermissionService
@{
    ViewData["Title"] = $"طلب تغيير سرعة #{Model.Id}";
    
    var canApproveOrReject = await PermissionService.HasPermissionAsync(User, "SpeedChange.Approve");
    var canImplement = await PermissionService.HasPermissionAsync(User, "SpeedChange.Implement");
}

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="fas fa-tachometer-alt"></i>
            @ViewData["Title"]
        </h1>
        <a asp-route="employee-requestsManagement" asp-route-action="SpeedChangeRequests" class="btn btn-secondary">
            <i class="fas fa-arrow-right"></i> العودة للقائمة
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle alert-icon"></i>
        <div class="alert-content">@TempData["Success"]</div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle alert-icon"></i>
        <div class="alert-content">@TempData["Error"]</div>
    </div>
}

<!-- معلومات التغيير -->
<div class="speed-change-overview">
    <div class="profile-box current">
        <div class="profile-label">الباقة الحالية</div>
        <div class="profile-name">@Model.CurrentProfile?.Name</div>
        <div class="profile-speed">
            <i class="fas fa-download"></i> @Model.CurrentProfile?.DownloadSpeedDisplay
        </div>
        <div class="profile-price">@Model.CurrentProfile?.PriceWithVAT.ToString("N2") ر.س/شهر</div>
    </div>
    
    <div class="arrow-box">
        <i class="fas fa-long-arrow-alt-left"></i>
    </div>
    
    <div class="profile-box requested">
        <div class="profile-label">الباقة المطلوبة</div>
        <div class="profile-name">@Model.RequestedProfile?.Name</div>
        <div class="profile-speed">
            <i class="fas fa-download"></i> @Model.RequestedProfile?.DownloadSpeedDisplay
        </div>
        <div class="profile-price">@Model.RequestedProfile?.PriceWithVAT.ToString("N2") ر.س/شهر</div>
    </div>
</div>

@if (Model.PriceDifference.HasValue && Model.PriceDifference != 0)
{
    <div class="price-difference-box @(Model.PriceDifference > 0 ? "increase" : "decrease")">
        <i class="fas @(Model.PriceDifference > 0 ? "fa-arrow-up" : "fa-arrow-down")"></i>
        <span>فرق السعر: @(Model.PriceDifference > 0 ? "+" : "")@Model.PriceDifference?.ToString("N2") ر.س/شهر</span>
    </div>
}

<div class="details-grid">
    <!-- معلومات الطلب -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-info-circle"></i> تفاصيل الطلب</h3>
            <span class="status-badge @GetStatusClass(Model.Status)">@GetStatusName(Model.Status)</span>
        </div>
        <div class="card-body">
            <div class="info-grid">
                <div class="info-item">
                    <span class="info-label">تاريخ الطلب</span>
                    <span class="info-value">@Model.RequestDate.ToString("yyyy/MM/dd HH:mm")</span>
                </div>
                @if (Model.ProcessedDate.HasValue)
                {
                    <div class="info-item">
                        <span class="info-label">تاريخ المعالجة</span>
                        <span class="info-value">@Model.ProcessedDate?.ToString("yyyy/MM/dd HH:mm")</span>
                    </div>
                }
                @if (Model.ImplementedDate.HasValue)
                {
                    <div class="info-item">
                        <span class="info-label">تاريخ التنفيذ</span>
                        <span class="info-value">@Model.ImplementedDate?.ToString("yyyy/MM/dd HH:mm")</span>
                    </div>
                }
                @if (Model.ProcessedBy != null)
                {
                    <div class="info-item">
                        <span class="info-label">معالج بواسطة</span>
                        <span class="info-value">@Model.ProcessedBy.FullName</span>
                    </div>
                }
                @if (Model.ImplementedBy != null)
                {
                    <div class="info-item">
                        <span class="info-label">منفذ بواسطة</span>
                        <span class="info-value">@Model.ImplementedBy.FullName</span>
                    </div>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.Reason))
            {
                <div class="reason-section">
                    <h4>سبب التغيير</h4>
                    <p class="reason-text">@Model.Reason</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.AdminNotes))
            {
                <div class="notes-section">
                    <h4>ملاحظات المدير</h4>
                    <p class="notes-text">@Model.AdminNotes</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.RejectionReason))
            {
                <div class="rejection-section">
                    <h4>سبب الرفض</h4>
                    <p class="rejection-text">@Model.RejectionReason</p>
                </div>
            }
        </div>
    </div>

    <!-- معلومات العميل -->
    <div class="card">
        <div class="card-header">
            <h3 class="card-title"><i class="fas fa-user"></i> معلومات العميل</h3>
        </div>
        <div class="card-body">
            @if (Model.Client != null)
            {
                <div class="client-card">
                    <div class="client-avatar-lg">
                        @(Model.Client.Name?.Substring(0, 1).ToUpper() ?? "?")
                    </div>
                    <div class="client-details">
                        <h4>@Model.Client.Name</h4>
                        <p><i class="fas fa-user"></i> @Model.Client.UserName</p>
                        <p><i class="fas fa-phone"></i> @Model.Client.PhoneNumber</p>
                        @if (Model.Client.MikroTikServer != null)
                        {
                            <p><i class="fas fa-server"></i> @Model.Client.MikroTikServer.Name</p>
                        }
                    </div>
                </div>
                <div class="mt-3">
                    <a asp-area="CompanyEmployee" asp-controller="Clients" asp-action="Details" asp-route-id="@Model.ClientId" class="btn btn-outline-info btn-sm">
                        <i class="fas fa-external-link-alt"></i> عرض ملف العميل
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- إجراءات -->
@if (canApproveOrReject || canImplement)
{
    <div class="actions-card">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-cogs"></i> إجراءات</h3>
            </div>
            <div class="card-body">
                @if (Model.Status == SpeedChangeRequestStatus.Pending)
                {
                    @if (canApproveOrReject)
                    {
                        <div class="actions-grid">
                            <!-- الموافقة -->
                            <form asp-route="employee-requestsManagement" asp-route-action="ApproveSpeedChangeRequest" method="post" class="action-form">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <div class="form-group mb-3">
                                    <label class="form-label">ملاحظات (اختياري)</label>
                                    <textarea name="adminNotes" class="form-control" rows="2" placeholder="أضف ملاحظات..."></textarea>
                                </div>
                                <button type="submit" class="btn btn-success btn-lg w-100">
                                    <i class="fas fa-thumbs-up"></i> الموافقة على الطلب
                                </button>
                            </form>

                            <!-- الرفض -->
                            <form asp-route="employee-requestsManagement" asp-route-action="RejectSpeedChangeRequest" method="post" class="action-form" onsubmit="return validateRejection(this)">
                                <input type="hidden" name="id" value="@Model.Id" />
                                <div class="form-group mb-3">
                                    <label class="form-label">سبب الرفض</label>
                                    <textarea name="rejectionReason" class="form-control" rows="2" placeholder="اكتب سبب الرفض..."></textarea>
                                </div>
                                <button type="submit" class="btn btn-danger btn-lg w-100">
                                    <i class="fas fa-times"></i> رفض الطلب
                                </button>
                            </form>
                        </div>
                    }
                    else
                    {
                        <div class="text-center text-muted">
                            <i class="fas fa-lock"></i>
                            الموافقة والرفض تتطلب صلاحية «موافقة/رفض تغيير السرعة» (أو التنفيذ للحسابات القديمة)
                        </div>
                    }
                }
                else if (Model.Status == SpeedChangeRequestStatus.Approved)
                {
                    @if (canImplement)
                    {
                        <form asp-route="employee-requestsManagement" asp-route-action="ImplementSpeedChange" method="post" class="text-center" onsubmit="return confirm('هل أنت متأكد من تنفيذ تغيير السرعة؟ سيتم تحديث الباقة في المايكروتك.')">
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="alert alert-info mb-3">
                                <i class="fas fa-info-circle"></i>
                                سيتم تغيير باقة العميل من <strong>@Model.CurrentProfile?.Name</strong> إلى <strong>@Model.RequestedProfile?.Name</strong>
                            </div>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-check-double"></i> تنفيذ تغيير السرعة
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="text-center text-muted">
                            <i class="fas fa-lock"></i>
                            لا تملك صلاحية تنفيذ تغيير السرعة
                        </div>
                    }
                }
                else
                {
                    <div class="text-center text-muted">
                        <i class="fas fa-info-circle"></i>
                        لا توجد إجراءات متاحة لهذا الطلب
                    </div>
                }
            </div>
        </div>
    </div>
}

<style>
    .page-header {
        margin-bottom: var(--spacing-lg);
    }
    
    .page-header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .page-title {
        font-size: var(--font-2xl);
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .speed-change-overview {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--spacing-lg);
        padding: var(--spacing-xl);
        background: var(--bg-card);
        border-radius: var(--radius);
        margin-bottom: var(--spacing-lg);
    }

    .profile-box {
        text-align: center;
        padding: var(--spacing-lg);
        background: var(--bg-hover);
        border-radius: var(--radius);
        min-width: 200px;
    }

    .profile-box.current {
        border: 2px solid var(--text-muted);
    }

    .profile-box.requested {
        border: 2px solid var(--primary);
        background: rgba(103, 58, 183, 0.05);
    }

    .profile-label {
        font-size: var(--font-xs);
        color: var(--text-muted);
        text-transform: uppercase;
        margin-bottom: var(--spacing-xs);
    }

    .profile-name {
        font-size: var(--font-xl);
        font-weight: 700;
        margin-bottom: var(--spacing-sm);
    }

    .profile-box.requested .profile-name {
        color: var(--primary);
    }

    .profile-speed {
        font-size: var(--font-md);
        color: var(--text-secondary);
        margin-bottom: var(--spacing-xs);
    }

    .profile-price {
        font-size: var(--font-sm);
        color: var(--text-muted);
    }

    .arrow-box {
        font-size: 2rem;
        color: var(--primary);
    }

    .price-difference-box {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: var(--spacing-sm);
        padding: var(--spacing-md);
        border-radius: var(--radius);
        margin-bottom: var(--spacing-lg);
        font-weight: 600;
    }

    .price-difference-box.increase {
        background: rgba(244, 67, 54, 0.1);
        color: var(--danger);
    }

    .price-difference-box.decrease {
        background: rgba(76, 175, 80, 0.1);
        color: var(--success);
    }

    .details-grid {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: var(--spacing-lg);
        margin-bottom: var(--spacing-lg);
    }

    .card {
        background: var(--bg-card);
        border-radius: var(--radius);
        box-shadow: var(--shadow-sm);
    }

    .card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--spacing-md) var(--spacing-lg);
        background: var(--bg-hover);
        border-bottom: 1px solid var(--border-color);
    }

    .card-title {
        margin: 0;
        font-size: var(--font-md);
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .card-body {
        padding: var(--spacing-lg);
    }

    .info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--spacing-md);
    }

    .info-item {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
    }

    .info-label {
        font-size: var(--font-sm);
        color: var(--text-muted);
    }

    .info-value {
        font-weight: 600;
    }

    .reason-section, .notes-section, .rejection-section {
        margin-top: var(--spacing-lg);
        padding-top: var(--spacing-lg);
        border-top: 1px solid var(--border-color);
    }

    .reason-section h4, .notes-section h4, .rejection-section h4 {
        font-size: var(--font-md);
        margin-bottom: var(--spacing-sm);
    }

    .reason-text {
        background: var(--bg-hover);
        padding: var(--spacing-md);
        border-radius: var(--radius-sm);
    }

    .notes-text {
        background: rgba(76, 175, 80, 0.1);
        padding: var(--spacing-md);
        border-radius: var(--radius-sm);
        border-right: 3px solid var(--success);
    }

    .rejection-text {
        background: rgba(244, 67, 54, 0.1);
        padding: var(--spacing-md);
        border-radius: var(--radius-sm);
        border-right: 3px solid var(--danger);
    }

    .client-card {
        display: flex;
        align-items: center;
        gap: var(--spacing-lg);
    }

    .client-avatar-lg {
        width: 80px;
        height: 80px;
        border-radius: 50%;
        background: var(--primary);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        font-weight: 600;
    }

    .client-details h4 {
        margin: 0 0 var(--spacing-sm) 0;
    }

    .client-details p {
        margin: var(--spacing-xs) 0;
        color: var(--text-secondary);
        font-size: var(--font-sm);
    }

    .client-details i {
        width: 20px;
        color: var(--text-muted);
    }

    .actions-card {
        max-width: 600px;
    }

    .actions-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--spacing-lg);
    }

    .action-form {
        padding: var(--spacing-md);
        background: var(--bg-hover);
        border-radius: var(--radius);
    }

    @@media (max-width: 768px) {
        .speed-change-overview {
            flex-direction: column;
        }

        .arrow-box {
            transform: rotate(-90deg);
        }

        .details-grid {
            grid-template-columns: 1fr;
        }

        .actions-grid {
            grid-template-columns: 1fr;
        }

        .info-grid {
            grid-template-columns: 1fr;
        }

        .client-card {
            flex-direction: column;
            text-align: center;
        }
    }
</style>

@functions {
    string GetStatusName(SpeedChangeRequestStatus status) => PricingDisplay.SpeedChangeRequestStatusLabel(status);

    string GetStatusClass(SpeedChangeRequestStatus status) => PricingDisplay.SpeedChangeRequestStatusClass(status);
}

@section Scripts {
    <script>
        function validateRejection(form) {
            var reason = form.querySelector('textarea[name="rejectionReason"]').value;
            if (!reason.trim()) {
                alert('يجب تحديد سبب الرفض');
                return false;
            }
            return confirm('هل أنت متأكد من رفض هذا الطلب؟');
        }
    </script>
}
