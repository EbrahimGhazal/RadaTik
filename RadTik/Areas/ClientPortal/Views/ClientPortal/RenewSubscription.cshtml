@model RadTik.ViewModels.ClientPortal.RenewSubscriptionViewModel
@{
    ViewData["Title"] = "تجديد الاشتراك";
    var firstDueSubscription = Model.DueSubscriptions.FirstOrDefault();
    var isExpired = firstDueSubscription?.IsExpired ?? false;
    var isExpiringSoon = firstDueSubscription?.IsExpiringSoon ?? false;
    var priceWithVat = firstDueSubscription?.AmountDue ?? 0m;
    var basePrice = firstDueSubscription?.BasePrice ?? 0m;
    var vatAmount = firstDueSubscription?.VatAmount ?? 0m;
    var vatPercentage = firstDueSubscription?.VatPercentage ?? 0m;
    var canRenewFromWallet = firstDueSubscription?.CanRenewFromWallet ?? false;
}

<div class="client-portal">
    <div class="page-header mb-4">
        <h2><i class="fas fa-sync-alt text-primary"></i> تجديد الاشتراك</h2>
        <p class="text-muted mb-0">عرض الاشتراكات المستحقة وحالة كل اشتراك مع إمكانية التجديد المباشر من المحفظة</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i> @TempData["Success"]
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
        </div>
    }

    @if (Model.HasBlockingInvoices)
    {
        <div class="alert alert-warning">
            <strong>التجديد متوقف مؤقتاً:</strong>
            لا يمكن تنفيذ التجديد قبل تسديد فواتير الصيانة المستحقة. لديك @Model.BlockingInvoicesCount فاتورة بإجمالي @Model.BlockingInvoicesTotal.ToString("N0") ل.س.
            <a asp-action="MaintenanceInvoices" class="alert-link">عرض الفواتير وتسديدها</a>.
        </div>
    }

    @if (isExpired)
    {
        <div class="alert alert-danger">
            <strong>انتهى اشتراكك!</strong> يرجى تغذية رصيدك ثم التجديد من هذه الصفحة أو التواصل مع الإدارة.
        </div>
    }
    else if (isExpiringSoon)
    {
        <div class="alert alert-warning">
            <strong>اشتراكك ينتهي قريباً</strong> في @(firstDueSubscription?.ExpirationDate?.ToString("yyyy/MM/dd")). يمكنك التجديد من هذه الصفحة عند كفاية الرصيد.
        </div>
    }

    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h5 class="mb-0"><i class="fas fa-list-alt"></i> الاشتراكات الواجبة للتجديد</h5>
            <span class="wallet-balance">رصيد المحفظة: <strong>@(Model.WalletBalance.ToString("N0")) ل.س</strong></span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>الاشتراك</th>
                            <th>تاريخ الانتهاء</th>
                            <th>المبلغ المستحق</th>
                            <th>حالة الاشتراك</th>
                            <th>جاهزية السداد</th>
                            <th class="text-center">الإجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.DueSubscriptions.Any())
                        {
                            @foreach (var subscription in Model.DueSubscriptions)
                            {
                                <tr>
                                    <td>@subscription.SubscriptionName</td>
                                    <td>@(subscription.ExpirationDate.HasValue ? subscription.ExpirationDate.Value.ToString("yyyy/MM/dd") : "غير محدد")</td>
                                    <td>
                                        @if (subscription.AmountDue > 0)
                                        {
                                            <div>@subscription.AmountDue.ToString("N0") ل.س</div>
                                            <small class="text-muted">
                                                الأساسي: @subscription.BasePrice.ToString("N0")
                                                + الضريبة @subscription.VatPercentage.ToString("N2")%: @subscription.VatAmount.ToString("N0")
                                            </small>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge @GetSubscriptionStatusClass(subscription.IsExpired, subscription.IsExpiringSoon)">
                                            @subscription.SubscriptionStatus
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @GetPaymentStatusClass(subscription.CanRenewFromWallet, subscription.AmountDue)">
                                            @subscription.PaymentStatus
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (subscription.CanRenewFromWallet && subscription.IsPrimaryInternetSubscription && !Model.HasBlockingInvoices)
                                        {
                                            <form method="post" action="@Url.Action("SelfRenewSubscription")" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-success btn-sm">
                                                    <i class="fas fa-sync-alt"></i> تجديد الآن
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <a href="@(Model.HasBlockingInvoices ? Url.Action("MaintenanceInvoices") : Url.Action("RequestTopUp"))" class="btn btn-outline-primary btn-sm">
                                                <i class="fas @(Model.HasBlockingInvoices ? "fa-file-invoice-dollar" : "fa-wallet")"></i>
                                                @(Model.HasBlockingInvoices ? "عرض الفواتير" : "تغذية الرصيد")
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center text-muted py-4">لا توجد اشتراكات مستحقة للتجديد حالياً.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0"><i class="fas fa-info-circle"></i> ملاحظات التجديد</h5>
        </div>
        <div class="card-body">
            @if (canRenewFromWallet)
            {
                <p class="mb-1">رصيدك الحالي كافٍ للتجديد الشهري مباشرة.</p>
                <p class="mb-0">سيتم خصم <strong>@(priceWithVat.ToString("N0")) ل.س</strong> = الأساسي <strong>@basePrice.ToString("N0")</strong> + الضريبة <strong>@vatPercentage.ToString("N2")%</strong> بقيمة <strong>@vatAmount.ToString("N0")</strong>.</p>
            }
            else if (priceWithVat > 0)
            {
                <p class="mb-2">لتجديد الاشتراك يلزم رصيد لا يقل عن <strong>@(priceWithVat.ToString("N0")) ل.س</strong> = الأساسي <strong>@basePrice.ToString("N0")</strong> + الضريبة <strong>@vatPercentage.ToString("N2")%</strong> بقيمة <strong>@vatAmount.ToString("N0")</strong>.</p>
                <p class="mb-0 text-muted">رصيدك الحالي: <strong>@(Model.WalletBalance.ToString("N0")) ل.س</strong>. يمكنك طلب تغذية الرصيد ثم العودة لإتمام التجديد.</p>
            }
            else
            {
                <p class="mb-0 text-muted">لا يوجد سعر محدد للاشتراك الحالي، يرجى التواصل مع الإدارة لتحديث البيانات قبل التجديد.</p>
            }
        </div>
    </div>
</div>

<style>
    .client-portal { padding: var(--spacing-lg, 1.5rem); }
    .wallet-balance { color: #495057; font-size: 0.95rem; }
    .badge-danger-soft { background: #f8d7da; color: #842029; }
    .badge-warning-soft { background: #fff3cd; color: #664d03; }
    .badge-success-soft { background: #d1e7dd; color: #0f5132; }
    .badge-secondary-soft { background: #e2e3e5; color: #41464b; }
</style>

@functions {
    public string GetSubscriptionStatusClass(bool expired, bool expiringSoon)
    {
        return expired ? "badge-danger-soft" : (expiringSoon ? "badge-warning-soft" : "badge-success-soft");
    }

    public string GetPaymentStatusClass(bool canRenew, decimal amountDue)
    {
        if (amountDue <= 0) return "badge-secondary-soft";
        return canRenew ? "badge-success-soft" : "badge-warning-soft";
    }
}
