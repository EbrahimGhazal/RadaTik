@model List<RadTik.Models.MaintenanceInvoice>
@{
    ViewData["Title"] = "فواتير الصيانة";
    var clientBalance = ViewBag.ClientBalance as decimal? ?? 0m;
    var pendingTotal = Model
        .Where(i => i.Status == RadTik.Models.MaintenanceInvoiceStatus.Pending)
        .Sum(i => i.GrossAmount);
}

<div class="client-portal">
    <div class="page-header mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h2><i class="fas fa-file-invoice-dollar text-primary"></i> فواتير الصيانة</h2>
            <p class="text-muted mb-0">رصيدك الحالي: <strong>@clientBalance.ToString("N0") ل.س</strong></p>
            <p class="text-muted mb-0">إجمالي الفواتير المستحقة: <strong>@pendingTotal.ToString("N0") ل.س</strong></p>
        </div>
        <a asp-action="RenewSubscription" class="btn btn-outline-secondary">
            <i class="fas fa-sync-alt"></i> صفحة التجديد
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>تاريخ الإصدار</th>
                            <th>المبلغ</th>
                            <th>الحالة</th>
                            <th>إجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Any())
                        {
                            foreach (var invoice in Model)
                            {
                                <tr>
                                    <td>#@invoice.Id</td>
                                    <td>@invoice.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td>@invoice.GrossAmount.ToString("N0") ل.س</td>
                                    <td>
                                        @if (invoice.Status == RadTik.Models.MaintenanceInvoiceStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark">بانتظار السداد</span>
                                        }
                                        else if (invoice.Status == RadTik.Models.MaintenanceInvoiceStatus.Paid)
                                        {
                                            <span class="badge bg-success">مدفوعة بالكامل</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">ملغاة</span>
                                        }
                                    </td>
                                    <td>
                                        @if (invoice.Status == RadTik.Models.MaintenanceInvoiceStatus.Pending)
                                        {
                                            <form asp-action="PayMaintenanceInvoice" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@invoice.Id" />
                                                <button type="submit" class="btn btn-sm btn-primary">
                                                    <i class="fas fa-wallet"></i> تسديد الآن
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">لا توجد فواتير صيانة حالياً.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
