@model RadTik.Models.Client
@{
    ViewData["Title"] = "لوحة تحكم العميل";
    var pendingMaintenance = ViewBag.PendingMaintenanceRequests ?? 0;
    var pendingSpeedChange = ViewBag.PendingSpeedChangeRequests ?? 0;
    var hasLiveTraffic = ViewBag.HasLiveTraffic as bool? == true;
    var trafficNetworkId = ViewBag.TrafficNetworkId as int?;
    var trafficServerId = ViewBag.TrafficServerId as int?;
    
    var isExpired = Model.AccountExpirationDate.HasValue && Model.AccountExpirationDate.Value < DateTime.Now;
    var isExpiringSoon = Model.AccountExpirationDate.HasValue && 
                         Model.AccountExpirationDate.Value >= DateTime.Now && 
                         Model.AccountExpirationDate.Value <= DateTime.Now.AddDays(7);
    var priceWithVat = Model.Profile?.PriceWithVAT ?? 0m;
    var canRenewFromWallet = Model.Profile != null && priceWithVat > 0 && Model.Balance >= priceWithVat;
}

<div class="client-portal">
    <!-- ترحيب -->
    <div class="welcome-section">
        <div class="welcome-content">
            <div class="welcome-avatar">
                <i class="fas fa-user-circle"></i>
            </div>
            <div class="welcome-info">
                <h1>مرحباً، @Model.Name</h1>
                <p>مرحباً بك في بوابة العميل. يمكنك من هنا إدارة اشتراكك وتقديم الطلبات.</p>
            </div>
        </div>
    </div>

    <!-- تنبيهات -->
    @if (isExpired)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle alert-icon"></i>
            <div class="alert-content">
                <strong>انتهى اشتراكك!</strong> يرجى التواصل مع الإدارة لتجديد الاشتراك.
            </div>
        </div>
    }
    else if (isExpiringSoon)
    {
        <div class="alert alert-warning">
            <i class="fas fa-clock alert-icon"></i>
            <div class="alert-content">
                <strong>اشتراكك ينتهي قريباً!</strong> ينتهي اشتراكك في @(Model.AccountExpirationDate?.ToString("yyyy/MM/dd")). يرجى تجديد الاشتراك لتجنب انقطاع الخدمة.
            </div>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle alert-icon"></i>
            <div class="alert-content">@TempData["Success"]</div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle alert-icon"></i>
            <div class="alert-content">@TempData["Error"]</div>
        </div>
    }

    <!-- بطاقات الإحصائيات -->
    <div class="stats-grid">
        <div class="stat-card stat-primary">
            <div class="stat-icon">
                <i class="fas fa-wifi"></i>
            </div>
            <div class="stat-details">
                <span class="stat-label">الباقة الحالية</span>
                <span class="stat-value">@(Model.Profile?.Name ?? "غير محدد")</span>
                @if (Model.Profile != null)
                {
                    <span class="stat-sub">@Model.Profile.DownloadSpeedDisplay</span>
                }
            </div>
        </div>

        <div class="stat-card @(isExpired ? "stat-danger" : isExpiringSoon ? "stat-warning" : "stat-success")">
            <div class="stat-icon">
                <i class="fas fa-calendar-alt"></i>
            </div>
            <div class="stat-details">
                <span class="stat-label">انتهاء الاشتراك</span>
                <span class="stat-value">
                    @if (Model.AccountExpirationDate.HasValue)
                    {
                        @(Model.AccountExpirationDate.Value.ToString("yyyy/MM/dd"))
                    }
                    else
                    {
                        @:غير محدد
                    }
                </span>
                @if (isExpired)
                {
                    <span class="stat-sub text-danger">منتهي</span>
                }
                else if (isExpiringSoon)
                {
                    <span class="stat-sub text-warning">ينتهي قريباً</span>
                }
            </div>
        </div>

        <div class="stat-card stat-info">
            <div class="stat-icon">
                <i class="fas fa-tools"></i>
            </div>
            <div class="stat-details">
                <span class="stat-label">طلبات الصيانة المعلقة</span>
                <span class="stat-value">@pendingMaintenance</span>
            </div>
        </div>

        <div class="stat-card stat-secondary">
            <div class="stat-icon">
                <i class="fas fa-tachometer-alt"></i>
            </div>
            <div class="stat-details">
                <span class="stat-label">طلبات تغيير السرعة</span>
                <span class="stat-value">@pendingSpeedChange</span>
            </div>
        </div>

        <div class="stat-card stat-wallet">
            <div class="stat-icon">
                <i class="fas fa-wallet"></i>
            </div>
            <div class="stat-details">
                <span class="stat-label">رصيد المحفظة</span>
                <span class="stat-value">@(Model.Balance.ToString("N0")) ل.س</span>
            </div>
        </div>
    </div>

    @if (hasLiveTraffic && trafficNetworkId.HasValue && trafficServerId.HasValue)
    {
        <div class="portal-live-traffic mb-4">
            <div class="stat-card stat-live-traffic">
                <div class="stat-icon">
                    <i class="fas fa-bolt"></i>
                </div>
                <div class="stat-details flex-grow-1">
                    <span class="stat-label">اختبار المعدل المباشر</span>
                    <p class="text-muted small mb-2 mb-lg-0">يمكنك تشغيل اختبار لمدة 10 ثوانٍ مع حسم 50 ل.س جديدة، ويتكرر كل 4 ساعات.</p>
                    <a href="@Url.Action("MyTraffic", "ClientPortal", new { area = "ClientPortal" })" class="btn btn-sm btn-outline-primary mt-3 rounded-3">
                        <i class="fas fa-chart-line me-1"></i> فتح صفحة معدلي المباشر
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- معلومات الاشتراك -->
    <div class="content-grid">
        <div class="card subscription-card">
            <div class="card-header">
                <h3><i class="fas fa-id-card"></i> معلومات الاشتراك</h3>
            </div>
            <div class="card-body">
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">اسم المستخدم</span>
                        <span class="info-value"><code>@Model.UserName</code></span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">رقم الهاتف</span>
                        <span class="info-value">@(Model.PhoneNumber ?? "-")</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">المستقبل</span>
                        <span class="info-value">@(Model.Receiver?.Name ?? "-")</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">الحالة</span>
                        <span class="info-value">
                            @if (Model.IsActive)
                            {
                                <span class="badge badge-success"><i class="fas fa-check"></i> نشط</span>
                            }
                            else
                            {
                                <span class="badge badge-danger"><i class="fas fa-times"></i> معطل</span>
                            }
                        </span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">تاريخ الاشتراك</span>
                        <span class="info-value">@(Model.CreatedDate.ToString("yyyy/MM/dd"))</span>
                    </div>
                    @if (Model.Profile != null)
                    {
                        <div class="info-item">
                            <span class="info-label">سعر الباقة (شهرياً مع الضريبة)</span>
                            <span class="info-value">@(Model.Profile.PriceWithVAT.ToString("N0")) ل.س</span>
                        </div>
                    }
                </div>
                @if (canRenewFromWallet)
                {
                    <hr />
                    <div class="renew-section">
                        <p class="renew-desc">رصيدك كافٍ لتجديد الاشتراك شهراً واحداً. المبلغ الذي سيُخصم: <strong>@(priceWithVat.ToString("N0")) ل.س</strong></p>
                        <form method="post" action="@Url.Action("SelfRenewSubscription")" class="renew-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-renew">
                                <i class="fas fa-sync-alt"></i> تجديد الاشتراك من المحفظة
                            </button>
                        </form>
                    </div>
                }
                else if (Model.Profile != null && priceWithVat > 0 && Model.Balance < priceWithVat)
                {
                    <hr />
                    <p class="text-muted small mb-0">لتجديد الاشتراك من المحفظة يلزم أن يكون رصيدك على الأقل @(priceWithVat.ToString("N0")) ل.س. رصيدك الحالي: @(Model.Balance.ToString("N0")) ل.س.</p>
                }
            </div>
        </div>

        <!-- إجراءات سريعة -->
        <div class="card actions-card">
            <div class="card-header">
                <h3><i class="fas fa-bolt"></i> إجراءات سريعة</h3>
            </div>
            <div class="card-body">
                <div class="quick-actions">
                    <a href="@Url.Action("RequestTopUp")" class="action-btn action-wallet">
                        <i class="fas fa-wallet"></i>
                        <span>طلب تغذية رصيد</span>
                    </a>
                    <a href="@Url.Action("RenewSubscription")" class="action-btn action-renew">
                        <i class="fas fa-sync-alt"></i>
                        <span>تجديد الاشتراك</span>
                    </a>
                    <a href="@Url.Action("CreateMaintenanceRequest")" class="action-btn action-maintenance">
                        <i class="fas fa-tools"></i>
                        <span>طلب صيانة</span>
                    </a>
                    <a href="@Url.Action("AvailablePlans")" class="action-btn action-speed">
                        <i class="fas fa-tachometer-alt"></i>
                        <span>تغيير السرعة</span>
                    </a>
                    <a href="@Url.Action("AvailablePlans")" class="action-btn action-plans">
                        <i class="fas fa-list-alt"></i>
                        <span>عرض الباقات</span>
                    </a>
                    <a href="@Url.Action("MaintenanceRequests")" class="action-btn action-requests">
                        <i class="fas fa-clipboard-list"></i>
                        <span>طلباتي</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .client-portal {
        padding: var(--spacing-lg);
    }

    .welcome-section {
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
        border-radius: var(--radius-lg);
        padding: var(--spacing-xl);
        margin-bottom: var(--spacing-lg);
        color: white;
    }

    .welcome-content {
        display: flex;
        align-items: center;
        gap: var(--spacing-lg);
    }

    .welcome-avatar {
        font-size: 4rem;
        opacity: 0.9;
    }

    .welcome-info h1 {
        font-size: var(--font-2xl);
        margin-bottom: var(--spacing-xs);
    }

    .welcome-info p {
        opacity: 0.9;
        margin: 0;
    }

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: var(--spacing-md);
        margin-bottom: var(--spacing-lg);
    }

    .stat-card {
        background: var(--bg-card);
        border-radius: var(--radius);
        padding: var(--spacing-lg);
        display: flex;
        align-items: center;
        gap: var(--spacing-md);
        box-shadow: var(--shadow-sm);
        border-right: 4px solid;
    }

    .stat-primary { border-color: var(--primary); }
    .stat-success { border-color: var(--success); }
    .stat-warning { border-color: var(--warning); }
    .stat-danger { border-color: var(--danger); }
    .stat-info { border-color: var(--info); }
    .stat-secondary { border-color: var(--text-muted); }

    .stat-icon {
        width: 50px;
        height: 50px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        color: white;
    }

    .stat-primary .stat-icon { background: var(--primary); }
    .stat-success .stat-icon { background: var(--success); }
    .stat-warning .stat-icon { background: var(--warning); }
    .stat-danger .stat-icon { background: var(--danger); }
    .stat-info .stat-icon { background: var(--info); }
    .stat-secondary .stat-icon { background: var(--text-muted); }
    .stat-wallet { border-color: #17a2b8; }
    .stat-wallet .stat-icon { background: #17a2b8; }

    .stat-details {
        display: flex;
        flex-direction: column;
    }

    .stat-label {
        font-size: var(--font-sm);
        color: var(--text-muted);
    }

    .stat-value {
        font-size: var(--font-xl);
        font-weight: 700;
        color: var(--text-primary);
    }

    .stat-sub {
        font-size: var(--font-xs);
        color: var(--text-muted);
    }

    .content-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
        gap: var(--spacing-lg);
    }

    .card {
        background: var(--bg-card);
        border-radius: var(--radius);
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    .card-header {
        padding: var(--spacing-md) var(--spacing-lg);
        background: var(--bg-hover);
        border-bottom: 1px solid var(--border-color);
    }

    .card-header h3 {
        margin: 0;
        font-size: var(--font-lg);
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .card-body {
        padding: var(--spacing-lg);
    }

    .info-grid {
        display: grid;
        gap: var(--spacing-md);
    }

    .info-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--spacing-sm) 0;
        border-bottom: 1px solid var(--border-color);
    }

    .info-item:last-child {
        border-bottom: none;
    }

    .info-label {
        color: var(--text-muted);
        font-size: var(--font-sm);
    }

    .info-value {
        font-weight: 600;
    }

    .quick-actions {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--spacing-md);
    }

    .action-btn {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: var(--spacing-lg);
        border-radius: var(--radius);
        text-decoration: none;
        transition: all var(--transition);
        text-align: center;
    }

    .action-btn i {
        font-size: 2rem;
        margin-bottom: var(--spacing-sm);
    }

    .action-btn span {
        font-weight: 600;
        font-size: var(--font-sm);
    }

    .action-wallet {
        background: rgba(23, 162, 184, 0.15);
        color: #17a2b8;
    }
    .action-wallet:hover { background: #17a2b8; color: white; }
    .action-renew {
        background: rgba(40, 167, 69, 0.15);
        color: var(--success);
    }
    .action-renew:hover { background: var(--success); color: white; }
    .action-maintenance {
        background: rgba(255, 152, 0, 0.1);
        color: var(--warning);
    }

    .action-maintenance:hover {
        background: var(--warning);
        color: white;
    }

    .action-speed {
        background: rgba(33, 150, 243, 0.1);
        color: var(--info);
    }

    .action-speed:hover {
        background: var(--info);
        color: white;
    }

    .action-plans {
        background: rgba(76, 175, 80, 0.1);
        color: var(--success);
    }

    .action-plans:hover {
        background: var(--success);
        color: white;
    }

    .action-requests {
        background: rgba(156, 39, 176, 0.1);
        color: #9C27B0;
    }

    .action-requests:hover {
        background: #9C27B0;
        color: white;
    }

    .renew-section {
        margin-top: var(--spacing-md);
    }

    .renew-desc {
        margin-bottom: var(--spacing-sm);
        color: var(--text-muted);
        font-size: var(--font-sm);
    }

    .btn-renew {
        background: linear-gradient(135deg, var(--success) 0%, #2e7d32 100%);
        color: white;
        border: none;
        padding: var(--spacing-sm) var(--spacing-lg);
        border-radius: var(--radius);
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: var(--spacing-sm);
        cursor: pointer;
        transition: opacity 0.2s;
    }

    .btn-renew:hover {
        color: white;
        opacity: 0.9;
    }

    .stat-live-traffic {
        border-color: #f59e0b;
    }

    .stat-live-traffic .stat-icon {
        background: linear-gradient(135deg, #f59e0b 0%, #ea580c 100%);
    }

    .portal-live-numbers {
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
    }

    .portal-live-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
    }

    .portal-live-tag {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 0.15rem 0.5rem;
        border-radius: 6px;
        color: #fff;
    }

    .portal-live-tag.rx { background: #2563eb; }
    .portal-live-tag.tx { background: #ea580c; }

    .portal-live-num {
        font-size: 1.15rem;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        color: var(--text-primary);
    }

    @@media (max-width: 768px) {
        .welcome-content {
            flex-direction: column;
            text-align: center;
        }

        .content-grid {
            grid-template-columns: 1fr;
        }

        .quick-actions {
            grid-template-columns: 1fr;
        }
    }
</style>

@section Scripts {}
