@model RadTik.Models.MaintenanceRequest
@using RadTik.Models
@using RadTik.Helpers
@{
    ViewData["Title"] = $"تفاصيل طلب الصيانة #{Model.Id}";
}

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="fas fa-tools"></i>
            @ViewData["Title"]
        </h1>
        <a asp-action="MaintenanceRequests" class="btn btn-secondary">
            <i class="fas fa-arrow-right"></i> العودة للطلبات
        </a>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">
            <i class="fas fa-info-circle"></i> بيانات الطلب
        </h3>
        <span class="badge @GetStatusBadgeClass(Model.Status)">@GetStatusName(Model.Status)</span>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="text-muted small">نوع المشكلة</div>
                <div class="fw-bold d-flex align-items-center gap-2">
                    <i class="fas @GetTypeIcon(Model.Type)"></i>
                    <span>@GetMaintenanceTypeName(Model.Type)</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small">الأولوية</div>
                <div class="fw-bold">@GetPriorityName(Model.Priority)</div>
            </div>
            <div class="col-md-4">
                <div class="text-muted small">تاريخ الطلب</div>
                <div class="fw-bold">@Model.RequestDate.ToString("yyyy/MM/dd HH:mm")</div>
            </div>
        </div>

        <hr />

        <div class="mb-3">
            <div class="text-muted small mb-1">وصف المشكلة</div>
            <div class="request-box">@Model.Description</div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.TechnicianNotes))
        {
            <div class="mb-3">
                <div class="text-muted small mb-1">ملاحظات الفريق الفني</div>
                <div class="request-box">@Model.TechnicianNotes</div>
            </div>
        }

        @if (Model.ScheduledVisitDate.HasValue)
        {
            <div class="mb-2">
                <span class="text-muted">موعد الزيارة:</span>
                <strong>@Model.ScheduledVisitDate.Value.ToString("yyyy/MM/dd HH:mm")</strong>
            </div>
        }
        @if (Model.CompletedDate.HasValue)
        {
            <div class="mb-2">
                <span class="text-muted">تاريخ الإنجاز:</span>
                <strong>@Model.CompletedDate.Value.ToString("yyyy/MM/dd HH:mm")</strong>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
        {
            <div class="mb-2">
                <span class="text-muted">سبب الرفض:</span>
                <strong>@Model.RejectionReason</strong>
            </div>
        }
        @if (Model.AssignedTo != null)
        {
            <div class="mb-2">
                <span class="text-muted">الموظف المكلّف:</span>
                <strong>@(string.IsNullOrWhiteSpace(Model.AssignedTo.FullName) ? Model.AssignedTo.UserName : Model.AssignedTo.FullName)</strong>
            </div>
        }
    </div>
</div>

<style>
    .request-box {
        white-space: pre-wrap;
        background: var(--bg-hover);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
        padding: .75rem;
    }
</style>

@functions {
    string GetMaintenanceTypeName(MaintenanceType type) => MaintenanceCatalog.GetDisplayName(type);

    string GetTypeIcon(MaintenanceType type) => MaintenanceCatalog.GetIcon(type);

    string GetStatusName(MaintenanceRequestStatus status) => PricingDisplay.MaintenanceRequestStatusLabel(status);

    string GetPriorityName(RequestPriority priority) => PricingDisplay.RequestPriorityLabel(priority);

    string GetStatusBadgeClass(MaintenanceRequestStatus status) => PricingDisplay.MaintenanceRequestStatusBadgeClass(status);
}
