@model IEnumerable<RadTik.Models.SpeedChangeRequest>
@using RadTik.Models
@using RadTik.Helpers
@{
    ViewData["Title"] = "طلبات تغيير السرعة";
    var currentProfile = ViewBag.CurrentProfile as Profile;
}

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="fas fa-tachometer-alt"></i>
            @ViewData["Title"]
        </h1>
        <div class="page-actions">
            <a asp-action="AvailablePlans" class="btn btn-primary">
                <i class="fas fa-plus"></i> طلب تغيير السرعة
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> العودة
            </a>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle alert-icon"></i>
        <div class="alert-content">@TempData["Success"]</div>
    </div>
}

@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle alert-icon"></i>
        <div class="alert-content">@TempData["Warning"]</div>
    </div>
}

<!-- الباقة الحالية -->
@if (currentProfile != null)
{
    <div class="current-plan-card">
        <div class="current-plan-header">
            <i class="fas fa-wifi"></i>
            <span>باقتك الحالية</span>
        </div>
        <div class="current-plan-body">
            <div class="plan-name">@currentProfile.Name</div>
            <div class="plan-speed">
                <i class="fas fa-download"></i> @currentProfile.DownloadSpeedDisplay
                @if (currentProfile.UploadSpeed.HasValue)
                {
                    <span class="mx-2">|</span>
                    <i class="fas fa-upload"></i> @currentProfile.UploadSpeedDisplay 
                }
            </div>
            <div class="plan-price">@currentProfile.PriceWithVAT.ToString("N2") ر.س/شهر</div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-list"></i>
            سجل طلبات تغيير السرعة
        </h3>
    </div>
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="requests-list">
                @foreach (var request in Model)
                {
                    var statusClass = PricingDisplay.SpeedChangeRequestStatusClass(request.Status);

                    var isUpgrade = request.RequestedProfile?.Price > request.CurrentProfile?.Price;

                    <div class="request-card @statusClass">
                        <div class="request-icon @(isUpgrade ? "upgrade" : "downgrade")">
                            <i class="fas @(isUpgrade ? "fa-arrow-up" : "fa-arrow-down")"></i>
                        </div>
                        <div class="request-content">
                            <div class="request-header">
                                <div class="speed-change">
                                    <span class="from-speed">@request.CurrentProfile?.Name</span>
                                    <i class="fas fa-long-arrow-alt-left"></i>
                                    <span class="to-speed">@request.RequestedProfile?.Name</span>
                                </div>
                                <span class="request-status @statusClass">@GetStatusName(request.Status)</span>
                            </div>
                            <div class="request-details">
                                <span class="speed-detail">
                                    <i class="fas fa-download"></i>
                                    @request.CurrentProfile?.DownloadSpeedDisplay → @request.RequestedProfile?.DownloadSpeedDisplay
                                </span>
                                @if (request.PriceDifference.HasValue)
                                {
                                    <span class="price-diff @(request.PriceDifference > 0 ? "increase" : "decrease")">
                                        <i class="fas fa-coins"></i>
                                        @(request.PriceDifference > 0 ? "+" : "")@request.PriceDifference?.ToString("N2") ر.س
                                    </span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(request.Reason))
                            {
                                <p class="request-reason">@request.Reason</p>
                            }
                            <div class="request-meta">
                                <span><i class="fas fa-calendar"></i> @request.RequestDate.ToString("yyyy/MM/dd HH:mm")</span>
                            </div>
                        </div>
                        <div class="request-actions">
                            <a asp-action="SpeedChangeRequestDetails" asp-route-id="@request.Id" class="btn btn-sm btn-info">
                                <i class="fas fa-eye"></i> التفاصيل
                            </a>
                            @if (request.Status == SpeedChangeRequestStatus.Pending)
                            {
                                <button type="button" class="btn btn-sm btn-danger" onclick="cancelRequest(@request.Id, 'speed')">
                                    <i class="fas fa-times"></i> إلغاء
                                </button>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-exchange-alt"></i>
                </div>
                <h3>لا توجد طلبات تغيير سرعة</h3>
                <p>يمكنك طلب تغيير باقتك إلى باقة أخرى من الباقات المتاحة.</p>
                <a asp-action="AvailablePlans" class="btn btn-primary">
                    <i class="fas fa-plus"></i> طلب تغيير السرعة
                </a>
            </div>
        }
    </div>
</div>

<style>
    .page-header {
        margin-bottom: var(--spacing-lg);
    }
    
    .page-header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: var(--spacing-md);
    }
    
    .page-title {
        font-size: var(--font-2xl);
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .current-plan-card {
        background: linear-gradient(135deg, var(--primary) 0%, var(--primary-dark) 100%);
        border-radius: var(--radius);
        padding: var(--spacing-lg);
        color: white;
        margin-bottom: var(--spacing-lg);
    }

    .current-plan-header {
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
        font-size: var(--font-sm);
        opacity: 0.9;
        margin-bottom: var(--spacing-sm);
    }

    .plan-name {
        font-size: var(--font-xl);
        font-weight: 700;
    }

    .plan-speed {
        font-size: var(--font-md);
        opacity: 0.9;
        margin: var(--spacing-xs) 0;
    }

    .plan-price {
        font-size: var(--font-lg);
        font-weight: 600;
    }

    .requests-list {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
    }

    .request-card {
        display: flex;
        align-items: flex-start;
        gap: var(--spacing-md);
        padding: var(--spacing-lg);
        background: var(--bg-hover);
        border-radius: var(--radius);
        border-right: 4px solid var(--border-color);
    }

    .request-icon {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        color: white;
        flex-shrink: 0;
    }

    .request-icon.upgrade { background: var(--success); }
    .request-icon.downgrade { background: var(--warning); }

    .request-content {
        flex: 1;
    }

    .request-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--spacing-sm);
        margin-bottom: var(--spacing-sm);
    }

    .speed-change {
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
        font-weight: 600;
    }

    .from-speed {
        color: var(--text-muted);
    }

    .to-speed {
        color: var(--primary);
    }

    .request-details {
        display: flex;
        align-items: center;
        gap: var(--spacing-md);
        font-size: var(--font-sm);
        color: var(--text-secondary);
    }

    .price-diff.increase { color: var(--danger); }
    .price-diff.decrease { color: var(--success); }

    .request-reason {
        font-size: var(--font-sm);
        color: var(--text-muted);
        margin: var(--spacing-xs) 0;
    }

    .request-meta {
        font-size: var(--font-xs);
        color: var(--text-muted);
    }

    .request-actions {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
    }

    .empty-state {
        text-align: center;
        padding: var(--spacing-2xl);
    }

    .empty-icon {
        font-size: 4rem;
        color: var(--text-muted);
        margin-bottom: var(--spacing-md);
    }
</style>

@functions {
    string GetStatusName(SpeedChangeRequestStatus status) => PricingDisplay.SpeedChangeRequestStatusLabel(status);
}

@section Scripts {
    <script>
        function cancelRequest(id, type) {
            if (confirm('هل أنت متأكد من إلغاء هذا الطلب؟')) {
                fetch('@Url.Action("CancelSpeedChangeRequest")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    },
                    body: 'id=' + id
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        location.reload();
                    } else {
                        alert(data.message);
                    }
                });
            }
        }
    </script>
    @Html.AntiForgeryToken()
}
