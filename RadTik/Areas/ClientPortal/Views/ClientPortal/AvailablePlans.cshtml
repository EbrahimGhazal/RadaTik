@model IEnumerable<RadTik.Models.Profile>
@using RadTik.Models
@{
    ViewData["Title"] = "الباقات المتاحة";
    var currentClient = ViewBag.CurrentClient as Client;
    var currentProfileId = ViewBag.CurrentProfileId as int?;
}

<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="fas fa-list-alt"></i>
            @ViewData["Title"]
        </h1>
        @if (currentClient != null)
        {
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> العودة
            </a>
        }
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
    </div>
}
@if (TempData["Warning"] != null)
{
    <div class="alert alert-warning">
        <i class="fas fa-exclamation-triangle"></i> @TempData["Warning"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
    </div>
}

@if (currentClient != null && currentClient.Profile != null)
{
    <div class="current-plan-banner">
        <div class="current-plan-info">
            <i class="fas fa-check-circle"></i>
            <span>باقتك الحالية: <strong>@currentClient.Profile.Name</strong> - @currentClient.Profile.DownloadSpeedDisplay</span>
        </div>
        <a asp-action="SpeedChangeRequests" class="btn btn-light btn-sm">
            <i class="fas fa-list"></i> طلباتي
        </a>
    </div>
}

<div class="plans-container">
    @if (Model.Any())
    {
        <div class="plans-grid">
            @foreach (var profile in Model)
            {
                var isCurrentPlan = currentProfileId.HasValue && currentProfileId.Value == profile.Id;
                var isFeatured = profile.DisplayOrder == 1; // الباقة المميزة هي الأولى في الترتيب
                
                <div class="plan-card @(isCurrentPlan ? "current" : "") @(isFeatured ? "featured" : "")">
                    @if (isFeatured)
                    {
                        <div class="plan-ribbon">
                            <span>الأكثر طلباً</span>
                        </div>
                    }
                    
                    @if (isCurrentPlan)
                    {
                        <div class="current-badge">
                            <i class="fas fa-check"></i> باقتك الحالية
                        </div>
                    }
                    
                    <div class="plan-header">
                        <h3 class="plan-name">@profile.Name</h3>
                        @if (!string.IsNullOrEmpty(profile.Description))
                        {
                            <p class="plan-description">@profile.Description</p>
                        }
                    </div>
                    
                    <div class="plan-price">
                        <span class="price-amount">@profile.PriceWithVAT.ToString("N0")</span>
                        <span class="price-currency">ل.س.جديدة</span>
                        <span class="price-period">/ شهر</span>
                    </div>
                    
                    <div class="plan-speed">
                        <div class="speed-main">
                            <i class="fas fa-download"></i>
                            <span class="speed-value">@profile.DownloadSpeedDisplay</span>
                        </div>
                        @if (profile.UploadSpeed.HasValue)
                        {
                            <div class="speed-upload">
                                <i class="fas fa-upload"></i> @profile.UploadSpeedDisplay رفع
                            </div>
                        }
                    </div>
                    
                    <div class="plan-features">
                        <ul>
                            @if (profile.DataLimit.HasValue && profile.DataLimit > 0)
                            {
                                <li><i class="fas fa-database"></i> @profile.DataLimit GB حد البيانات</li>
                            }
                            else
                            {
                                <li><i class="fas fa-infinity"></i> استخدام غير محدود</li>
                            }
                            
                            @if (profile.IPTVDevices.HasValue && profile.IPTVDevices > 0)
                            {
                                <li><i class="fas fa-tv"></i> @profile.IPTVDevices أجهزة IPTV</li>
                            }

                            <li><i class="fas fa-headset"></i> دعم فني على مدار الساعة</li>
                            <li><i class="fas fa-shield-alt"></i> اتصال آمن ومستقر</li>

                            @if (profile.MinDevices >= 0)
                            {
                                <li><i class="fas fa-mobile-alt"></i> @profile.MinDevices الحد الأدنى للأجهزة</li>
                            }

                            @if (profile.MaxDevices > 0)
                            {
                                <li><i class="fas fa-laptop-house"></i> @profile.MaxDevices الحد الأعلى للأجهزة</li>
                            }

                            @if (profile.MaxUsers > 0)
                            {
                                <li><i class="fas fa-users"></i> @profile.MaxUsers عدد المستخدمين</li>
                            }
                            
                            @if (!string.IsNullOrEmpty(profile.Features))
                            {
                                @foreach (var feature in profile.Features.Split(','))
                                {
                                    <li><i class="fas fa-star"></i> @feature.Trim()</li>
                                }
                            }
                        </ul>
                    </div>
                    
                    <div class="plan-footer">
                        @if (isCurrentPlan)
                        {
                            <button class="btn btn-secondary w-100" disabled>
                                <i class="fas fa-check"></i> باقتك الحالية
                            </button>
                        }
                        else if (currentClient != null)
                        {
                            <button type="button"
                                    class="btn btn-primary w-100 open-change-plan-modal"
                                    data-profile-id="@profile.Id"
                                    data-profile-name="@profile.Name">
                                <i class="fas fa-exchange-alt"></i> طلب التغيير لهذه الباقة
                            </button>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Register" class="btn btn-primary w-100">
                                <i class="fas fa-user-plus"></i> اشترك الآن
                            </a>
                        }
                    </div>
                    
                    @if (profile.Type != ProfileType.Internet)
                    {
                        <div class="plan-type-badge">
                            @GetProfileTypeName(profile.Type)
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-icon">
                <i class="fas fa-box-open"></i>
            </div>
            <h3>لا توجد باقات متاحة حالياً</h3>
            <p>يرجى التواصل مع الإدارة للحصول على مزيد من المعلومات.</p>
        </div>
    }
</div>

@if (currentClient != null)
{
    <div id="changePlanModal" class="custom-modal-overlay" aria-hidden="true">
        <div class="custom-modal-card" role="dialog" aria-modal="true" aria-labelledby="changePlanModalTitle">
            <div class="custom-modal-header">
                <h4 id="changePlanModalTitle" class="mb-0"><i class="fas fa-exchange-alt"></i> طلب تغيير الباقة</h4>
                <button type="button" class="custom-modal-close" id="closeChangePlanModal" aria-label="إغلاق">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="custom-modal-body">
                <p class="mb-2">
                    سيتم إرسال طلب تغييرك إلى الباقة:
                    <strong id="selectedPlanName">-</strong>
                </p>
                <div class="form-group mb-0">
                    <label for="changePlanReason" class="form-label">سبب التغيير (اختياري)</label>
                    <textarea id="changePlanReason"
                              class="form-control"
                              rows="4"
                              placeholder="اكتب سبب طلب تغيير الباقة..."></textarea>
                </div>
            </div>
            <div class="custom-modal-footer">
                <button type="button" class="btn btn-light" id="cancelChangePlanModal">
                    إلغاء
                </button>
                <form asp-action="CreateSpeedChangeRequest" method="post" id="submitChangePlanForm" class="m-0">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="RequestedProfileId" id="selectedRequestedProfileId" />
                    <input type="hidden" name="Reason" id="selectedChangeReason" />
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane"></i> إرسال الطلب
                    </button>
                </form>
            </div>
        </div>
    </div>
}

<!-- معلومات إضافية -->
<div class="info-section">
    <div class="info-card">
        <div class="info-icon">
            <i class="fas fa-question-circle"></i>
        </div>
        <div class="info-content">
            <h4>كيف أختار الباقة المناسبة؟</h4>
            <p>اختر الباقة بناءً على عدد الأجهزة المتصلة ونوع الاستخدام. للاستخدام العادي (تصفح، سوشيال ميديا) يكفي 10-20 ميجا. للبث والألعاب ننصح بـ 50 ميجا أو أكثر.</p>
        </div>
    </div>
    
    <div class="info-card">
        <div class="info-icon">
            <i class="fas fa-sync-alt"></i>
        </div>
        <div class="info-content">
            <h4>هل يمكنني تغيير الباقة؟</h4>
            <p>نعم، يمكنك طلب تغيير الباقة في أي وقت. سيتم مراجعة طلبك وتنفيذه خلال 24 ساعة.</p>
        </div>
    </div>
    
    <div class="info-card">
        <div class="info-icon">
            <i class="fas fa-phone-alt"></i>
        </div>
        <div class="info-content">
            <h4>تحتاج مساعدة؟</h4>
            <p>تواصل معنا عبر الدعم الفني أو قدم طلب صيانة من خلال التطبيق.</p>
        </div>
    </div>
</div>

<style>
    .page-header {
        margin-bottom: var(--spacing-lg);
    }
    
    .page-header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .page-title {
        font-size: var(--font-2xl);
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .current-plan-banner {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: var(--spacing-md) var(--spacing-lg);
        background: linear-gradient(135deg, var(--success) 0%, #388E3C 100%);
        border-radius: var(--radius);
        color: white;
        margin-bottom: var(--spacing-lg);
    }

    .current-plan-info {
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .plans-container {
        margin-bottom: var(--spacing-xl);
    }

    .plans-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: var(--spacing-lg);
    }

    .plan-card {
        position: relative;
        background: var(--bg-card);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
        padding: var(--spacing-xl);
        display: flex;
        flex-direction: column;
        transition: all var(--transition);
        border: 2px solid transparent;
        overflow: hidden;
    }

    .plan-card:hover {
        transform: translateY(-5px);
        box-shadow: var(--shadow-lg);
    }

    .plan-card.featured {
        border-color: var(--primary);
    }

    .plan-card.current {
        border-color: var(--success);
        background: rgba(76, 175, 80, 0.05);
    }

    .plan-ribbon {
        position: absolute;
        top: 20px;
        left: -35px;
        background: var(--primary);
        color: white;
        padding: 5px 40px;
        font-size: var(--font-xs);
        font-weight: 600;
        transform: rotate(45deg);
    }

    .current-badge {
        position: absolute;
        top: var(--spacing-md);
        right: var(--spacing-md);
        background: var(--success);
        color: white;
        padding: 4px 12px;
        border-radius: 12px;
        font-size: var(--font-xs);
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .plan-header {
        text-align: center;
        margin-bottom: var(--spacing-lg);
    }

    .plan-name {
        font-size: var(--font-xl);
        font-weight: 700;
        margin-bottom: var(--spacing-xs);
        color: var(--text-primary);
    }

    .plan-description {
        font-size: var(--font-sm);
        color: var(--text-muted);
        margin: 0;
    }

    .plan-price {
        text-align: center;
        margin-bottom: var(--spacing-lg);
        padding: var(--spacing-md) 0;
        border-top: 1px solid var(--border-color);
        border-bottom: 1px solid var(--border-color);
    }

    .price-amount {
        font-size: 3rem;
        font-weight: 800;
        color: var(--primary);
    }

    .price-currency {
        font-size: var(--font-lg);
        font-weight: 600;
        color: var(--text-secondary);
    }

    .price-period {
        font-size: var(--font-sm);
        color: var(--text-muted);
    }

    .plan-speed {
        text-align: center;
        margin-bottom: var(--spacing-lg);
        padding: var(--spacing-md);
        background: var(--bg-hover);
        border-radius: var(--radius);
    }

    .speed-main {
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: var(--spacing-xs);
    }

    .speed-value {
        font-size: var(--font-2xl);
        font-weight: 700;
        color: var(--primary);
    }

    .speed-unit {
        font-size: var(--font-md);
        color: var(--text-muted);
    }

    .speed-upload {
        font-size: var(--font-sm);
        color: var(--text-muted);
        margin-top: var(--spacing-xs);
    }

    .plan-features {
        flex: 1;
        margin-bottom: var(--spacing-lg);
    }

    .plan-features ul {
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .plan-features li {
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
        padding: var(--spacing-sm) 0;
        font-size: var(--font-sm);
        color: var(--text-secondary);
        border-bottom: 1px solid var(--border-light);
    }

    .plan-features li:last-child {
        border-bottom: none;
    }

    .plan-features i {
        color: var(--success);
        width: 20px;
    }

    .plan-footer {
        margin-top: auto;
    }

    .plan-type-badge {
        position: absolute;
        bottom: var(--spacing-md);
        left: var(--spacing-md);
        background: var(--info);
        color: white;
        padding: 2px 8px;
        border-radius: 8px;
        font-size: var(--font-xs);
    }

    .info-section {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: var(--spacing-lg);
    }

    .info-card {
        display: flex;
        gap: var(--spacing-md);
        padding: var(--spacing-lg);
        background: var(--bg-card);
        border-radius: var(--radius);
        box-shadow: var(--shadow-sm);
    }

    .info-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: rgba(103, 58, 183, 0.1);
        color: var(--primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
        flex-shrink: 0;
    }

    .info-content h4 {
        font-size: var(--font-md);
        margin-bottom: var(--spacing-xs);
    }

    .info-content p {
        font-size: var(--font-sm);
        color: var(--text-muted);
        margin: 0;
    }

    .empty-state {
        text-align: center;
        padding: var(--spacing-2xl);
    }

    .empty-icon {
        font-size: 4rem;
        color: var(--text-muted);
        margin-bottom: var(--spacing-md);
    }

    .custom-modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.45);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 2000;
        padding: var(--spacing-md);
    }

    .custom-modal-overlay.show {
        display: flex;
    }

    .custom-modal-card {
        width: min(560px, 100%);
        background: var(--bg-card);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-lg);
        overflow: hidden;
    }

    .custom-modal-header,
    .custom-modal-footer {
        padding: var(--spacing-md) var(--spacing-lg);
        background: var(--bg-hover);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--spacing-sm);
    }

    .custom-modal-body {
        padding: var(--spacing-lg);
    }

    .custom-modal-close {
        border: none;
        background: transparent;
        color: var(--text-muted);
        font-size: 1rem;
        cursor: pointer;
    }

    @@media (max-width: 768px) {
        .plans-grid {
            grid-template-columns: 1fr;
        }

        .current-plan-banner {
            flex-direction: column;
            gap: var(--spacing-sm);
            text-align: center;
        }

        .price-amount {
            font-size: 2.5rem;
        }

        .custom-modal-footer {
            flex-direction: column;
            align-items: stretch;
        }

        #submitChangePlanForm .btn,
        #cancelChangePlanModal {
            width: 100%;
        }
    }
</style>

@functions {
    string GetProfileTypeName(ProfileType type) => type switch
    {
        ProfileType.Internet => "إنترنت",
        ProfileType.IPTV => "IPTV",
        ProfileType.VoIP => "VoIP",
        ProfileType.Bundle => "باقة مجمعة",
        ProfileType.Custom => "مخصص",
        _ => ""
    };
}

@section Scripts {
    <script>
        (function () {
            var modal = document.getElementById('changePlanModal');
            if (!modal) return;

            var selectedPlanName = document.getElementById('selectedPlanName');
            var selectedProfileIdInput = document.getElementById('selectedRequestedProfileId');
            var reasonTextArea = document.getElementById('changePlanReason');
            var reasonHiddenInput = document.getElementById('selectedChangeReason');
            var closeBtn = document.getElementById('closeChangePlanModal');
            var cancelBtn = document.getElementById('cancelChangePlanModal');
            var submitForm = document.getElementById('submitChangePlanForm');

            function openModal(profileId, profileName) {
                selectedProfileIdInput.value = profileId;
                selectedPlanName.textContent = profileName || '-';
                reasonTextArea.value = '';
                reasonHiddenInput.value = '';
                modal.classList.add('show');
                modal.setAttribute('aria-hidden', 'false');
                setTimeout(function () { reasonTextArea.focus(); }, 0);
            }

            function closeModal() {
                modal.classList.remove('show');
                modal.setAttribute('aria-hidden', 'true');
            }

            document.querySelectorAll('.open-change-plan-modal').forEach(function (button) {
                button.addEventListener('click', function () {
                    openModal(button.dataset.profileId, button.dataset.profileName);
                });
            });

            closeBtn.addEventListener('click', closeModal);
            cancelBtn.addEventListener('click', closeModal);
            modal.addEventListener('click', function (event) {
                if (event.target === modal) closeModal();
            });

            submitForm.addEventListener('submit', function () {
                reasonHiddenInput.value = (reasonTextArea.value || '').trim();
            });
        })();
    </script>
}
