@{
    // SystemAdmin sidebar (SystemAdministrator).
    var isAuthenticated = (bool?)(ViewData["Layout_IsAuthenticated"]) == true;
    var userName = ViewData["Layout_UserName"] as string ?? (User.Identity?.Name ?? "مستخدم");
    var userInitials = ViewData["Layout_UserInitials"] as string ?? (userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "م");
    var userRole = ViewData["Layout_UserRole"] as string ?? "مدير النظام";

    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var tab = ViewContext.HttpContext.Request.Query["tab"].ToString();
}

<aside class="sidebar sidebar-pro" id="sidebar">
    <div class="sidebar-header">
        <div class="rt-sysadmin-brand">
            @{
                ViewData["RtBrandVariant"] = "sidebar";
            }
            <partial name="_RadTikBrandLogo" />
            <small class="sidebar-brand-sub" dir="rtl">إدارة النظام</small>
        </div>
    </div>

    <nav class="sidebar-nav" data-single-open="true">
        @if (!isAuthenticated)
        {
            <div class="nav-section">
                <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                    <i class="fas fa-bars"></i>
                    <span>القائمة</span>
                    <i class="fas fa-chevron-down nav-section-chevron"></i>
                </div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link" asp-route="reglog-login">
                            <span class="nav-icon"><i class="fas fa-sign-in-alt"></i></span>
                            <span>تسجيل الدخول</span>
                        </a>
                    </li>
                </ul>
            </div>
        }
        else
        {
            <div class="nav-section">
                <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                    <i class="fas fa-th-large"></i>
                    <span>الرئيسية</span>
                    <i class="fas fa-chevron-down nav-section-chevron"></i>
                </div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "SystemAdmin" && (string.IsNullOrEmpty(tab) || tab == "dashboard") ? "active" : "")"
                           asp-route="systemAdmin-actions" asp-route-action="Index" asp-route-tab="dashboard">
                            <span class="nav-icon"><i class="fas fa-tachometer-alt"></i></span>
                            <span>لوحة التحكم</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="nav-section">
                <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                    <i class="fas fa-cogs"></i>
                    <span>الطلبات</span>
                    <span class="nav-badge" id="sysOpsSectionBadge" style="display:none;">0</span>
                    <i class="fas fa-chevron-down nav-section-chevron"></i>
                </div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "SystemAdmin" && tab == "maintenance" ? "active" : "")"
                           asp-route="systemAdmin-actions" asp-route-action="Index" asp-route-tab="maintenance">
                            <span class="nav-icon"><i class="fas fa-wrench"></i></span>
                            <span>طلبات الصيانة</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "ServiceRequests" ? "active" : "")"
                           asp-route="systemAdmin-serviceRequests">
                            <span class="nav-icon"><i class="fas fa-file-contract"></i></span>
                            <span>طلبات خدمات الشركات</span>
                            <span class="nav-badge" id="sysServiceRequestsBadge" style="display:none;">0</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "PasswordResetRequests" ? "active" : "")"
                           asp-route="systemAdmin-passwordResetRequests">
                            <span class="nav-icon"><i class="fas fa-key"></i></span>
                            <span>طلبات إعادة كلمة المرور</span>
                            <span class="nav-badge" id="sysPasswordResetRequestsBadge" style="display:none;">0</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.HttpContext.Request.Path.Value?.StartsWith("/systemAdmin/JoinRequests", StringComparison.OrdinalIgnoreCase) == true ? "active" : "")"
                           asp-route="systemAdmin-joinRequests">
                            <span class="nav-icon"><i class="fas fa-user-plus"></i></span>
                            <span>طلبات الانضمام</span>
                            <span class="nav-badge" id="sysJoinRequestsBadge" style="display:none;">0</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="nav-section">
                <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                    <i class="fas fa-building"></i>
                    <span>الكيانات</span>
                    <span class="nav-badge" id="sysCompaniesSectionBadge" style="display:none;">0</span>
                    <i class="fas fa-chevron-down nav-section-chevron"></i>
                </div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "SystemAdmin" && tab == "collectionpoints" ? "active" : "")"
                           asp-route="systemAdmin-actions" asp-route-action="Index" asp-route-tab="collectionpoints">
                            <span class="nav-icon"><i class="fas fa-map-marker-alt"></i></span>
                            <span>نقاط التحصيل</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "SystemAdmin" && action == "NetworksAndAdmins" ? "active" : "")"
                           asp-route="systemAdmin-actions" asp-route-action="NetworksAndAdmins">
                            <span class="nav-icon"><i class="fas fa-network-wired"></i></span>
                            <span>إدارة شبكات الشركات</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="nav-section">
                <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                    <i class="fas fa-tags"></i>
                    <span>الخدمات</span>
                    <span class="nav-badge" id="sysServicesSectionBadge" style="display:none;">0</span>
                    <i class="fas fa-chevron-down nav-section-chevron"></i>
                </div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "ServiceCatalog" ? "active" : "")"
                           asp-route="systemAdmin-serviceCatalog">
                            <span class="nav-icon"><i class="fas fa-layer-group"></i></span>
                            <span>كتالوج الخدمات</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="nav-section">
                <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                    <i class="fas fa-coins"></i>
                    <span>المالية</span>
                    <span class="nav-badge" id="sysFinanceSectionBadge" style="display:none;">0</span>
                    <i class="fas fa-chevron-down nav-section-chevron"></i>
                </div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "FundingRequests" ? "active" : "")"
                           asp-route="systemAdmin-fundingRequests">
                            <span class="nav-icon"><i class="fas fa-map-marker-alt"></i></span>
                            <span>طلبات تغذية الرصيد</span>
                            <span class="nav-badge" id="sysFundingRequestsBadge" style="display:none;">0</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Receipts" ? "active" : "")"
                           asp-route="systemAdmin-receipts">
                            <span class="nav-icon"><i class="fas fa-receipt"></i></span>
                            <span>سجل القبض المركزي</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "CashBox" ? "active" : "")"
                           asp-route="systemAdmin-cashbox">
                            <span class="nav-icon"><i class="fas fa-money-bill-wave"></i></span>
                            <span>الصندوق النقدي</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "PaymentMethods" ? "active" : "")"
                           asp-route="systemAdmin-paymentMethods">
                            <span class="nav-icon"><i class="fas fa-money-check-alt"></i></span>
                            <span>طرق الدفع</span>
                        </a>
                    </li>
                </ul>
            </div>

            <div class="nav-section nav-section-account">
                <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                    <i class="fas fa-user-cog"></i>
                    <span>الحساب</span>
                    <i class="fas fa-chevron-down nav-section-chevron"></i>
                </div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Account" && action == "Profile" ? "active" : "")"
                           asp-route="systemAdmin-account-profile">
                            <span class="nav-icon"><i class="fas fa-cog"></i></span>
                            <span>إعدادات الحساب</span>
                        </a>
                    </li>
                </ul>
            </div>
        }
    </nav>

</aside>

