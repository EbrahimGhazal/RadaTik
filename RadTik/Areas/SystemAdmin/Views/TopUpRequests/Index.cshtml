@using RadTik.Models
@using RadTik.Helpers
@{
    ViewData["Title"] = ViewData["Title"] ?? "طلبات تغذية رصيد الشركات";

    var items = ViewBag.Items as IEnumerable<NetworkTopUpRequest> ?? Enumerable.Empty<NetworkTopUpRequest>();
    var list = items.ToList();
    var pendingCount = (int?)ViewBag.PendingCount ?? 0;
}

<div class="page-header">
    <h1>
        <i class="fas fa-wallet"></i>
        @ViewData["Title"]
    </h1>
    <p class="text-muted mb-0">مراجعة طلبات تغذية رصيد الشركات.</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="content-grid">
    <div class="card">
        <div class="card-body d-flex flex-wrap gap-2 align-items-center justify-content-between">
            <div class="text-muted small">
                الطلبات المعلّقة: <strong>@pendingCount</strong>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a class="btn btn-outline-secondary btn-sm" asp-area="SystemAdmin" asp-controller="TopUpRequests" asp-action="Index">الكل</a>
                <a class="btn btn-outline-primary btn-sm" asp-area="SystemAdmin" asp-controller="TopUpRequests" asp-action="Index" asp-route-status="@NetworkTopUpRequestStatus.Pending">@PricingDisplay.NetworkTopUpRequestStatusLabel(NetworkTopUpRequestStatus.Pending)</a>
                <a class="btn btn-outline-success btn-sm" asp-area="SystemAdmin" asp-controller="TopUpRequests" asp-action="Index" asp-route-status="@NetworkTopUpRequestStatus.Approved">@PricingDisplay.NetworkTopUpRequestStatusLabel(NetworkTopUpRequestStatus.Approved)</a>
                <a class="btn btn-outline-danger btn-sm" asp-area="SystemAdmin" asp-controller="TopUpRequests" asp-action="Index" asp-route-status="@NetworkTopUpRequestStatus.Rejected">@PricingDisplay.NetworkTopUpRequestStatusLabel(NetworkTopUpRequestStatus.Rejected)</a>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-list"></i>
                القائمة
            </h3>
        </div>
        <div class="card-body">
            <div class="table-responsive sys-requests-shell">
                <table class="table align-middle sys-requests-table">
                    <thead>
                        <tr>
                            <th style="width: 160px;">التاريخ</th>
                            <th>الشركة</th>
                            <th class="text-center" style="width: 140px;">المبلغ</th>
                            <th style="width: 180px;">الطريقة/المرجع</th>
                            <th class="text-center" style="width: 90px;">صورة الإيصال</th>
                            <th style="width: 160px;">الطالب</th>
                            <th class="text-center" style="width: 120px;">الحالة</th>
                            <th style="width: 160px;">إجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (list.Any())
                        {
                            foreach (var r in list)
                            {
                                <tr>
                                    <td data-label="التاريخ">@r.RequestedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td data-label="الشركة">@(r.Network?.Name ?? $"#{r.NetworkId}")</td>
                                    <td class="text-center" data-label="المبلغ"><strong>@r.Amount.ToString("N2")</strong></td>
                                    <td class="text-muted" data-label="الطريقة/المرجع">
                                        @if (r.PaymentMethod != null)
                                        {
                                            <div>@r.PaymentMethod.Name</div>
                                        }
                                        else if (!string.IsNullOrWhiteSpace(r.Method))
                                        {
                                            <div>@r.Method</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(r.ReferenceNumber))
                                        {
                                            <div class="small">Ref: @r.ReferenceNumber</div>
                                        }
                                    </td>
                                    <td class="text-center" data-label="صورة الإيصال">
                                        @if (!string.IsNullOrWhiteSpace(r.ReceiptImagePath))
                                        {
                                            <a href="@r.ReceiptImagePath" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary" title="عرض صورة الإيصال"><i class="fas fa-receipt"></i> عرض</a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td data-label="الطالب">@(r.RequestedByUser?.FullName ?? r.RequestedByUser?.UserName ?? r.RequestedByUserId)</td>
                                    <td class="text-center" data-label="الحالة">
                                        @if (r.Status == NetworkTopUpRequestStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark">@PricingDisplay.NetworkTopUpRequestStatusLabel(r.Status)</span>
                                        }
                                        else if (r.Status == NetworkTopUpRequestStatus.Approved)
                                        {
                                            <span class="badge bg-success">@PricingDisplay.NetworkTopUpRequestStatusLabel(r.Status)</span>
                                        }
                                        else if (r.Status == NetworkTopUpRequestStatus.Rejected)
                                        {
                                            <span class="badge bg-danger">@PricingDisplay.NetworkTopUpRequestStatusLabel(r.Status)</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@PricingDisplay.NetworkTopUpRequestStatusLabel(r.Status)</span>
                                        }
                                    </td>
                                    <td data-label="إجراء">
                                        @if (r.Status == NetworkTopUpRequestStatus.Pending)
                                        {
                                            <div class="sys-requests-actions">
                                                <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#approveModal_@r.Id">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#rejectModal_@r.Id">
                                                    <i class="fas fa-xmark"></i>
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="8" class="text-center text-muted py-4">لا توجد طلبات</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@foreach (var r in list.Where(x => x.Status == NetworkTopUpRequestStatus.Pending))
{
    <div class="modal fade" id="approveModal_@r.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-area="SystemAdmin" asp-controller="TopUpRequests" asp-action="Approve">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@r.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title">موافقة على طلب #@r.Id</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-2">الشركة: <strong>@(r.Network?.Name ?? $"#{r.NetworkId}")</strong></div>
                        <div class="mb-2">المبلغ: <strong>@r.Amount.ToString("N2")</strong></div>
                        @if (!string.IsNullOrWhiteSpace(r.ReceiptImagePath))
                        {
                            <div class="mb-3">
                                <span class="form-label d-block">صورة الإيصال</span>
                                <a href="@r.ReceiptImagePath" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary me-2"><i class="fas fa-external-link-alt"></i> فتح الصورة</a>
                                <img src="@r.ReceiptImagePath" alt="صورة الإيصال" class="img-thumbnail mt-2" style="max-height: 180px; max-width: 100%;" />
                            </div>
                        }
                        <div class="mb-3">
                            <label class="form-label">ملاحظات (اختياري)</label>
                            <textarea name="notes" class="form-control" rows="3"></textarea>
                        </div>
                        <div class="alert alert-info mb-0">سيتم إضافة المبلغ إلى رصيد الشركة وتسجيل عملية بالمحفظة.</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-success">موافقة</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="rejectModal_@r.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-area="SystemAdmin" asp-controller="TopUpRequests" asp-action="Reject">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@r.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title">رفض طلب #@r.Id</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-2">الشركة: <strong>@(r.Network?.Name ?? $"#{r.NetworkId}")</strong></div>
                        <div class="mb-2">المبلغ: <strong>@r.Amount.ToString("N2")</strong></div>
                        @if (!string.IsNullOrWhiteSpace(r.ReceiptImagePath))
                        {
                            <div class="mb-3">
                                <span class="form-label d-block">صورة الإيصال</span>
                                <a href="@r.ReceiptImagePath" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary me-2"><i class="fas fa-external-link-alt"></i> فتح الصورة</a>
                                <img src="@r.ReceiptImagePath" alt="صورة الإيصال" class="img-thumbnail mt-2" style="max-height: 180px; max-width: 100%;" />
                            </div>
                        }
                        <div class="mb-3">
                            <label class="form-label">سبب الرفض (اختياري)</label>
                            <textarea name="notes" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-danger">رفض</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

