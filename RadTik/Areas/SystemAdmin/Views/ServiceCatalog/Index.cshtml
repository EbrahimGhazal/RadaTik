@model RadTik.Areas.SystemAdmin.ViewModels.ServiceCatalogPageViewModel
@using RadTik.Helpers
@using RadTik.Models
@{
    ViewData["Title"] = ViewData["Title"] ?? "كتالوج الخدمات";
    var list = Model.Items;
    var networkPricing = Model.NetworkPricing;
    var serverPricing = Model.ServerPricing;
    var sectorPricing = Model.SectorPricing;
    var receiverPricing = Model.ReceiverPricing;
    var clientPricing = Model.ClientPricing;
    var userPricing = Model.UserPricing;
    var speedProfilePricing = Model.SpeedProfilePricing;
    var reportPricing = Model.ReportPricing;
    var profilePriceTax = Model.ProfilePriceTax;
    var maintenanceCommission = Model.MaintenanceCommission;
    var renewalPeriods = Model.RenewalPeriods;
    var maintenanceCommissionModeLabel = Model.MaintenanceCommissionModeLabel;
    var maxFreeUnitsLimit = Model.MaxFreeUnitsLimit;
    var nonNegativeFreeUnitsMessage = Model.NonNegativeFreeUnitsMessage;
    var maxFreeUnitsExceededMessage = Model.MaxFreeUnitsExceededMessage;
    bool IsRecurringPriced(RadTik.Areas.SystemAdmin.ViewModels.ServicePricingCardViewModel pricing) =>
        pricing.HasInitialPricing || pricing.HasRenewalPricing || pricing.InitialPriceSyp > 0m || pricing.RenewalPricePerUnitSyp > 0m;
    bool isReportPriced = reportPricing.InitialPriceSyp > 0m;
    bool isProfileTaxPriced = profilePriceTax.Price > 0m;
    bool isMaintenanceCommissionPriced = maintenanceCommission.CommissionValue > 0m;
    var pricedCount = new[]
    {
        IsRecurringPriced(networkPricing),
        IsRecurringPriced(serverPricing),
        IsRecurringPriced(sectorPricing),
        IsRecurringPriced(receiverPricing),
        IsRecurringPriced(clientPricing),
        IsRecurringPriced(userPricing),
        IsRecurringPriced(speedProfilePricing),
        isReportPriced,
        isProfileTaxPriced,
        isMaintenanceCommissionPriced
    }.Count(v => v);
    var unpricedCount = 10 - pricedCount;
}

<div class="sys-hero mb-4">
    <div class="sys-hero-main">
        <div class="sys-hero-icon"><i class="fas fa-layer-group"></i></div>
        <div>
            <h1 class="sys-hero-title">@ViewData["Title"]</h1>
            <p class="sys-hero-subtitle">إدارة الخدمات المخصصة وقابليتها للعرض والتفعيل بشكل منظم.</p>
        </div>
    </div>
    <div class="sys-hero-chips">
        <span class="sys-hero-chip"><i class="fas fa-key"></i> مفاتيح بصيغة <code>CUSTOM:...</code></span>
        <span class="sys-hero-chip"><i class="fas fa-sliders"></i> تعديل سريع للحالة والوصف</span>
    </div>
</div>

<div class="service-catalog-toolbar mb-4">
    <div class="service-catalog-kpis">
        <div class="kpi-tile">
            <div class="kpi-value">@Model.PricedServiceCount</div>
            <div class="kpi-label">خدمات دورية رئيسية</div>
        </div>
        <div class="kpi-tile">
            <div class="kpi-value">@Model.ConfiguredRecurringCount</div>
            <div class="kpi-label">خدمات بدورات تجديد مضبوطة</div>
        </div>
        <div class="kpi-tile">
            <div class="kpi-value">@Model.ConfiguredOneTimeCount</div>
            <div class="kpi-label">أسعار إضافة/إنشاء مفعلة</div>
        </div>
    </div>
    <div class="service-catalog-sections-nav">
        <a href="#pricing-services" class="btn btn-sm btn-outline-primary">الخدمات الدورية</a>
        <a href="#independent-services" class="btn btn-sm btn-outline-primary">الخدمات المستقلة</a>
        <a href="#service-parameters" class="btn btn-sm btn-outline-primary">جداول المعلمات</a>
        <a href="#custom-services" class="btn btn-sm btn-outline-primary">الخدمات المخصصة</a>
    </div>
    <div class="service-catalog-search">
        <label for="serviceCatalogSearchInput" class="form-label mb-1">بحث سريع داخل الصفحة</label>
        <div class="input-group">
            <span class="input-group-text"><i class="fas fa-search"></i></span>
            <input id="serviceCatalogSearchInput"
                   type="search"
                   class="form-control"
                   placeholder="ابحث عن خدمة أو قسم... (مثال: الصيانة، التقارير، المشتركين)"
                   autocomplete="off" />
            <button id="serviceCatalogSearchClear" type="button" class="btn btn-outline-secondary">مسح</button>
        </div>
        <div class="service-catalog-search-meta">
            <div class="form-text">يتم تصفية البطاقات فورًا أثناء الكتابة.</div>
            <div id="serviceCatalogSearchCount" class="search-count-badge">كل الأقسام ظاهرة</div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="service-pricing-legend mb-3">
    <span class="legend-item legend-priced" id="recurringPricedLegend">
        <span class="legend-dot"></span>
        خدمة مسعّرة (@pricedCount)
    </span>
    <span class="legend-item legend-unpriced" id="recurringUnpricedLegend">
        <span class="legend-dot"></span>
        خدمة غير مسعّرة (@unpricedCount)
    </span>
</div>

<div class="content-grid">
    <section class="service-catalog-group" id="pricing-services">
        <div class="service-catalog-group-header">
            <h2><i class="fas fa-money-check-dollar"></i> خدمات دورية رئيسية</h2>
            <p>تجميع كل الخدمات التي تتضمن سعر إضافة + دورة تجديد وسعر تجديد لكل وحدة.</p>
        </div>
        <div class="service-catalog-group-body service-catalog-group-body--cards">
    <div class="card service-catalog-section-card @(IsRecurringPriced(networkPricing) ? "service-priced" : "service-unpriced")">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-money-check-dollar text-primary"></i>
                تسعير إنشاء الشبكات وتجديدها
            </h3>
        </div>
        <div class="card-body">
            <form method="post" asp-area="SystemAdmin" asp-controller="ServiceCatalog" asp-action="UpdateNetworkPricing" class="row g-3 service-catalog-form-horizontal">
                @Html.AntiForgeryToken()
                <div class="col-md-4 pricing-mode-block">
                    <label class="form-label">سعر إنشاء كل شبكة إضافية (ل.س.ج)</label>
                    <input type="number" min="0" step="0.01" name="initialPriceSyp" class="form-control" value="@networkPricing.InitialPriceSyp" required />
                </div>
                <div class="col-md-4 pricing-mode-block">
                    <label class="form-label">زمن التجديد الدوري</label>
                    <select name="renewalBillingPeriod" class="form-select" required>
                        @foreach (var p in renewalPeriods)
                        {
                            <option value="@p" selected="@(p == networkPricing.RenewalBillingPeriod ? "selected" : null)">@PricingDisplay.BillingPeriodLabel(p)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4 pricing-mode-block">
                    <label class="form-label">سعر التجديد لكل وحدة (ل.س.ج)</label>
                    <input type="number" min="0" step="0.01" name="renewalPricePerUnitSyp" class="form-control" value="@networkPricing.RenewalPricePerUnitSyp" required />
                </div>
                <div class="col-md-4 pricing-mode-block">
                    <label class="form-label">عدد مجاني قبل بدء التسعير</label>
                    <input type="number" min="0" max="@maxFreeUnitsLimit" step="1" name="freeInitialUnits" class="form-control" value="@networkPricing.FreeInitialUnits" />
                </div>
                <div class="col-md-4 pricing-mode-block">
                    <label class="form-label">عدد مجاني قبل بدء رسوم التجديد</label>
                    <input type="number" min="0" max="@maxFreeUnitsLimit" step="1" name="freeRenewalUnits" class="form-control" value="@networkPricing.FreeRenewalUnits" />
                </div>
                <div class="col-12 d-flex justify-content-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-floppy-disk"></i>
                        حفظ إعدادات التسعير والتجديد
                    </button>
                </div>
            </form>
        </div>
    </div>

