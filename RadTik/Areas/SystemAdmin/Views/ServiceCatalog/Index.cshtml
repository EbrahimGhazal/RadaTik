    <div class="card service-catalog-section-card @(IsRecurringPriced(speedProfilePricing) ? "service-priced" : "service-unpriced")">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-gauge-high text-primary"></i>
                تسعير إضافة السرعة/البروفايل وتجديده
            </h3>
        </div>
        <div class="card-body">
            <form method="post" asp-area="SystemAdmin" asp-controller="ServiceCatalog" asp-action="UpdateSpeedProfilePricing" class="row g-3 service-catalog-form-horizontal">
                @Html.AntiForgeryToken()
                <div class="col-md-4">
                    <label class="form-label">سعر إضافة/استيراد كل سرعة-بروفايل (ل.س.ج)</label>
