<script>
    (function () {
        const isRecurringFormPriced = (form) => {
            const initialPriceInput = form.querySelector('input[name="initialPriceSyp"]');
            const renewalPriceInput = form.querySelector('input[name="renewalPricePerUnitSyp"]');
            const initialPrice = initialPriceInput ? Number(initialPriceInput.value || 0) : 0;
            const renewalPrice = renewalPriceInput ? Number(renewalPriceInput.value || 0) : 0;
            return initialPrice > 0 || renewalPrice > 0;
        };

        const updateRecurringPricingSummary = () => {
            const recurringForms = document.querySelectorAll('form.service-catalog-form-horizontal');
            let pricedCount = 0;

            recurringForms.forEach((form) => {
                const card = form.closest('.service-catalog-section-card');
                const isPriced = isRecurringFormPriced(form);
                if (isPriced) {
                    pricedCount += 1;
                }
                if (card) {
                    card.classList.toggle('service-priced', isPriced);
                    card.classList.toggle('service-unpriced', !isPriced);
                }
            });

            const unpricedCount = recurringForms.length - pricedCount;
            const pricedLegend = document.getElementById('recurringPricedLegend');
            const unpricedLegend = document.getElementById('recurringUnpricedLegend');
            if (pricedLegend) {
                pricedLegend.innerHTML = `<span class="legend-dot"></span>خدمة مسعّرة (${pricedCount})`;
            }
            if (unpricedLegend) {
                unpricedLegend.innerHTML = `<span class="legend-dot"></span>خدمة غير مسعّرة (${unpricedCount})`;
            }
        };

        const forms = document.querySelectorAll('form.service-catalog-form-horizontal');
        forms.forEach((form) => {
            const initialPriceInput = form.querySelector('input[name="initialPriceSyp"]');
            const renewalPriceInput = form.querySelector('input[name="renewalPricePerUnitSyp"]');
            if (initialPriceInput) {
                initialPriceInput.addEventListener('input', updateRecurringPricingSummary);
            }
            if (renewalPriceInput) {
                renewalPriceInput.addEventListener('input', updateRecurringPricingSummary);
            }

            form.addEventListener('submit', (e) => {
                const freeInitialInput = form.querySelector('input[name="freeInitialUnits"]');
                const freeRenewalInput = form.querySelector('input[name="freeRenewalUnits"]');
                const freeInitialValue = freeInitialInput ? Number(freeInitialInput.value || 0) : 0;
                const freeRenewalValue = freeRenewalInput ? Number(freeRenewalInput.value || 0) : 0;
                const nonNegativeFreeUnitsMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(nonNegativeFreeUnitsMessage));
                const maxFreeUnitsExceededMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(maxFreeUnitsExceededMessage));

                if (freeInitialValue < 0 || freeRenewalValue < 0) {
                    e.preventDefault();
                    if (freeInitialValue < 0 && freeInitialInput) {
                        freeInitialInput.focus();
                    } else if (freeRenewalInput) {
                        freeRenewalInput.focus();
                    }
                    alert(nonNegativeFreeUnitsMessage);
                    return;
                }

                const maxFreeUnitsLimit = @maxFreeUnitsLimit;
                if (freeInitialValue > maxFreeUnitsLimit || freeRenewalValue > maxFreeUnitsLimit) {
                    e.preventDefault();
                    if (freeInitialValue > maxFreeUnitsLimit && freeInitialInput) {
                        freeInitialInput.focus();
                    } else if (freeRenewalInput) {
                        freeRenewalInput.focus();
                    }
                    alert(maxFreeUnitsExceededMessage);
                    return;
                }

            });
        });

        updateRecurringPricingSummary();
    })();
</script>

@foreach (var s in list)
{
    <div class="modal fade" id="editModal_@s.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-area="SystemAdmin" asp-controller="ServiceCatalog" asp-action="Update">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@s.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title">تعديل خدمة</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-2 text-muted small"><code>@s.Key</code></div>
                        <div class="mb-3">
                            <label class="form-label">اسم الخدمة</label>
                            <input type="text" name="displayName" class="form-control" value="@s.DisplayName" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">أيقونة</label>
                            <input type="text" name="iconClass" class="form-control" value="@s.IconClass" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">وصف</label>
                            <textarea name="description" class="form-control" rows="2">@s.Description</textarea>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="isActive" value="true" checked="@(s.IsActive ? "checked" : null)" />
                            <label class="form-check-label">نشط</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary">حفظ</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteModal_@s.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-area="SystemAdmin" asp-controller="ServiceCatalog" asp-action="Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@s.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title">تأكيد الحذف</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                    </div>
                    <div class="modal-body">
                        هل أنت متأكد من حذف الخدمة: <strong>@s.DisplayName</strong>؟
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-danger">حذف</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

