@using RadTik.Models
@using RadTik.Helpers
@{
    ViewData["Title"] = ViewData["Title"] ?? "طلبات تغذية رصيد نقاط التحصيل";
    var items = ViewBag.Items as IEnumerable<CollectionPointTopUpRequest> ?? Enumerable.Empty<CollectionPointTopUpRequest>();
    var selectedStatus = ViewBag.SelectedStatus as CollectionPointTopUpStatus?;
    var pendingCount = ViewBag.PendingCount as int? ?? 0;
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h1><i class="fas fa-map-marker-alt"></i> طلبات تغذية رصيد نقاط التحصيل (مدير النظام)</h1>
    @if (pendingCount > 0)
    {
        <span class="badge bg-warning text-dark">@pendingCount @PricingDisplay.CollectionPointTopUpStatusLabel(CollectionPointTopUpStatus.Pending)</span>
    }
</div>

<p class="text-muted mb-3">مراجعة طلبات تغذية الرصيد الموجهة لمدير النظام. عند الموافقة يتم إضافة المبلغ مباشرة إلى رصيد نقطة التحصيل.</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="mb-3">
    <a asp-area="SystemAdmin" asp-controller="CollectionPointTopUpRequests" asp-action="Index" asp-route-status="@((int?)null)" class="btn btn-outline-secondary btn-sm @(selectedStatus == null ? "active" : "")">الكل</a>
    <a asp-area="SystemAdmin" asp-controller="CollectionPointTopUpRequests" asp-action="Index" asp-route-status="@CollectionPointTopUpStatus.Pending" class="btn btn-outline-warning btn-sm @(selectedStatus == CollectionPointTopUpStatus.Pending ? "active" : "")">@PricingDisplay.CollectionPointTopUpStatusLabel(CollectionPointTopUpStatus.Pending)</a>
    <a asp-area="SystemAdmin" asp-controller="CollectionPointTopUpRequests" asp-action="Index" asp-route-status="@CollectionPointTopUpStatus.Approved" class="btn btn-outline-success btn-sm @(selectedStatus == CollectionPointTopUpStatus.Approved ? "active" : "")">@PricingDisplay.CollectionPointTopUpStatusLabel(CollectionPointTopUpStatus.Approved)</a>
    <a asp-area="SystemAdmin" asp-controller="CollectionPointTopUpRequests" asp-action="Index" asp-route-status="@CollectionPointTopUpStatus.Rejected" class="btn btn-outline-danger btn-sm @(selectedStatus == CollectionPointTopUpStatus.Rejected ? "active" : "")">@PricingDisplay.CollectionPointTopUpStatusLabel(CollectionPointTopUpStatus.Rejected)</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive sys-requests-shell">
            <table class="table table-hover align-middle mb-0 sys-requests-table">
                <thead>
                    <tr>
                        <th>التاريخ</th>
                        <th>نقطة التحصيل</th>
                        <th>الشبكة</th>
                        <th>طريقة الدفع</th>
                        <th>الإيصال</th>
                        <th>المبلغ</th>
                        <th>ملاحظات</th>
                        <th>الحالة</th>
                        <th style="width: 180px;">إجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @if (items.Any())
                    {
                        foreach (var r in items)
                        {
                            <tr>
                                <td data-label="التاريخ">@r.RequestedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                <td data-label="نقطة التحصيل">@(r.CollectionPointAccount?.User?.UserName ?? r.RequestedByUser?.UserName ?? "—")</td>
                                <td data-label="الشبكة">@(r.CollectionPointAccount?.Network?.Name ?? "—")</td>
                                <td data-label="طريقة الدفع">
                                    <div>@(r.PaymentMethod?.Name ?? r.Method ?? "—")</div>
                                    @if (!string.IsNullOrWhiteSpace(r.ReferenceNumber))
                                    {
                                        <small class="text-muted">مرجع: @r.ReferenceNumber</small>
                                    }
                                </td>
                                <td data-label="الإيصال">
                                    @if (!string.IsNullOrWhiteSpace(r.ReceiptImagePath))
                                    {
                                        <a class="btn btn-sm btn-outline-secondary" href="@r.ReceiptImagePath" target="_blank">
                                            <i class="fas fa-image"></i> عرض
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td data-label="المبلغ">@r.Amount.ToString("N0") ل.س</td>
                                <td data-label="ملاحظات">@(r.Notes ?? "—")</td>
                                <td data-label="الحالة">
                                    @switch (r.Status)
                                    {
                                        case CollectionPointTopUpStatus.Pending:
                                            <span class="badge bg-warning text-dark">@PricingDisplay.CollectionPointTopUpStatusLabel(r.Status)</span>
                                            break;
                                        case CollectionPointTopUpStatus.Approved:
                                            <span class="badge bg-success">@PricingDisplay.CollectionPointTopUpStatusLabel(r.Status)</span>
                                            break;
                                        case CollectionPointTopUpStatus.Rejected:
                                            <span class="badge bg-danger">@PricingDisplay.CollectionPointTopUpStatusLabel(r.Status)</span>
                                            break;
                                        case CollectionPointTopUpStatus.Cancelled:
                                            <span class="badge bg-secondary">@PricingDisplay.CollectionPointTopUpStatusLabel(r.Status)</span>
                                            break;
                                    }
                                </td>
                                <td data-label="إجراء">
                                    @if (r.Status == CollectionPointTopUpStatus.Pending)
                                    {
                                        <div class="sys-requests-actions">
                                            <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#approveModal_@r.Id">
                                                <i class="fas fa-check"></i> قبول
                                            </button>
                                            <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectModal_@r.Id">
                                                <i class="fas fa-xmark"></i> رفض
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">لا توجد طلبات</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@foreach (var r in items.Where(x => x.Status == CollectionPointTopUpStatus.Pending))
{
    <div class="modal fade" id="approveModal_@r.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-area="SystemAdmin" asp-controller="CollectionPointTopUpRequests" asp-action="Approve">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@r.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title">موافقة على طلب #@r.Id</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-2">نقطة التحصيل: <strong>@(r.CollectionPointAccount?.User?.UserName ?? r.RequestedByUser?.UserName ?? "—")</strong></div>
                        <div class="mb-2">الشبكة: <strong>@(r.CollectionPointAccount?.Network?.Name ?? "—")</strong></div>
                        <div class="mb-2">المبلغ: <strong>@r.Amount.ToString("N0") ل.س</strong></div>
                        <div class="mb-3">
                            <label class="form-label">ملاحظات (اختياري)</label>
                            <textarea name="adminNotes" class="form-control" rows="2"></textarea>
                        </div>
                        <div class="alert alert-info mb-0">سيتم إضافة المبلغ مباشرة إلى رصيد نقطة التحصيل.</div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-success">موافقة</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="rejectModal_@r.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-area="SystemAdmin" asp-controller="CollectionPointTopUpRequests" asp-action="Reject">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@r.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title">رفض طلب #@r.Id</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-2">نقطة التحصيل: <strong>@(r.CollectionPointAccount?.User?.UserName ?? r.RequestedByUser?.UserName ?? "—")</strong></div>
                        <div class="mb-2">المبلغ: <strong>@r.Amount.ToString("N0") ل.س</strong></div>
                        <div class="mb-3">
                            <label class="form-label">سبب الرفض (اختياري)</label>
                            <textarea name="adminNotes" class="form-control" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-danger">رفض</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
