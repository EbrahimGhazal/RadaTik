@model RadTik.ViewModels.SystemAdmin.FundingRequestsIndexViewModel
@using RadTik.Models
@using RadTik.ViewModels.SystemAdmin

@functions {
    private static string NormalizeReceiptUrl(string raw)
    {
        var p = (raw ?? string.Empty).Trim().Replace('\\', '/');
        if (string.IsNullOrWhiteSpace(p)) return string.Empty;

        if (p.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            p.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return p;
        }

        // "~/uploads/..." -> "/uploads/..."
        if (p.StartsWith("~/", StringComparison.Ordinal))
            p = p.Substring(1);

        // "uploads/..." -> "/uploads/..."
        if (!p.StartsWith("/", StringComparison.Ordinal))
            p = "/" + p;

        return p;
    }
}

@{
    ViewData["Title"] = ViewData["Title"] ?? "طلبات تغذية الرصيد";
    var totalPending = Model.PendingCompaniesCount + Model.PendingCollectionPointsCount;
}

<div id="sysFundingRoot" class="sys-funding">
    <div class="sys-funding-hero">
        <div class="sys-funding-hero-inner">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                <div>
                    <h1 class="sys-funding-title">
                        <span class="sys-funding-title-icon"><i class="fas fa-wallet"></i></span>
                        <span>@ViewData["Title"]</span>
                    </h1>
                    <div class="sys-funding-subtitle">مراجعة واعتماد طلبات تغذية الرصيد (شركات + نقاط تحصيل) مع الإيصال وطريقة الدفع.</div>
                </div>
                @if (totalPending > 0)
                {
                    <span class="sys-funding-pill sys-funding-pill-warning">
                        <i class="fas fa-clock"></i>
                        @totalPending قيد الانتظار
                    </span>
                }
            </div>

            <div class="sys-funding-hero-grid">
                <div class="sys-funding-stats">
                    <div class="sys-funding-stat">
                        <div class="k">المعلّقة (إجمالي)</div>
                        <div class="v">@totalPending</div>
                        <div class="i"><i class="fas fa-hourglass-half"></i></div>
                    </div>
                    <div class="sys-funding-stat">
                        <div class="k">الشركات</div>
                        <div class="v">@Model.PendingCompaniesCount</div>
                        <div class="i"><i class="fas fa-building"></i></div>
                    </div>
                    <div class="sys-funding-stat">
                        <div class="k">نقاط التحصيل</div>
                        <div class="v">@Model.PendingCollectionPointsCount</div>
                        <div class="i"><i class="fas fa-map-marker-alt"></i></div>
                    </div>
                </div>

                <div class="sys-funding-tabs">
                    <div class="text-muted small mb-2">التصنيف</div>
                    <ul class="nav nav-pills">
                        <li class="nav-item">
                            <a class="nav-link @(Model.ActiveTab == FundingRequestsTab.Companies ? "active" : "")"
                               asp-route="systemAdmin-fundingRequests" asp-route-tab="companies">
                                <i class="fas fa-building"></i>
                                الشركات
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(Model.ActiveTab == FundingRequestsTab.CollectionPoints ? "active" : "")"
                               asp-route="systemAdmin-fundingRequests" asp-route-tab="collectionPoints">
                                <i class="fas fa-map-marker-alt"></i>
                                نقاط التحصيل
                            </a>
                        </li>
                    </ul>
                    <div class="text-muted small mt-2">
                        يتم عرض جدول <strong>@(Model.ActiveTab == FundingRequestsTab.Companies ? "طلبات الشركات" : "طلبات نقاط التحصيل")</strong> حسب التبويب المحدد.
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

@if (Model.ActiveTab == FundingRequestsTab.Companies)
{
    <div class="sys-funding-toolbar card mb-3">
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="badge bg-light text-dark">الإجمالي: <strong>@Model.CompanyItems.Count</strong></span>
                    <span class="badge bg-warning text-dark">معلّقة: <strong>@Model.PendingCompaniesCount</strong></span>
                </div>

                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <div class="input-group input-group-sm sys-funding-search">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input id="companySearchInput" type="search" class="form-control" placeholder="بحث: الشركة / المرجع / الطريقة / الطالب..." autocomplete="off" />
                        <button id="companySearchClearBtn" class="btn btn-outline-secondary" type="button" title="مسح البحث">
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="sys-funding-filters mt-3">
                <a class="sys-funding-filter-pill @(Model.CompanyStatus == null ? "is-active" : "")"
                   asp-route="systemAdmin-fundingRequests" asp-route-tab="companies">
                    الكل
                </a>
                <a class="sys-funding-filter-pill is-warning @(Model.CompanyStatus == NetworkTopUpRequestStatus.Pending ? "is-active" : "")"
                   asp-route="systemAdmin-fundingRequests" asp-route-tab="companies" asp-route-companyStatus="@NetworkTopUpRequestStatus.Pending">
                    معلّقة
                </a>
                <a class="sys-funding-filter-pill is-success @(Model.CompanyStatus == NetworkTopUpRequestStatus.Approved ? "is-active" : "")"
                   asp-route="systemAdmin-fundingRequests" asp-route-tab="companies" asp-route-companyStatus="@NetworkTopUpRequestStatus.Approved">
                    مقبولة
                </a>
                <a class="sys-funding-filter-pill is-danger @(Model.CompanyStatus == NetworkTopUpRequestStatus.Rejected ? "is-active" : "")"
                   asp-route="systemAdmin-fundingRequests" asp-route-tab="companies" asp-route-companyStatus="@NetworkTopUpRequestStatus.Rejected">
                    مرفوضة
                </a>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h3 class="card-title mb-0"><i class="fas fa-building"></i> طلبات الشركات</h3>
            <div class="text-muted small" id="companyResultsHint"></div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive sys-funding-desktop">
                <table class="table table-hover table-striped align-middle mb-0" id="companyRequestsTable">
                    <thead>
                        <tr>
                            <th style="width: 160px;">التاريخ</th>
                            <th>الشركة</th>
                            <th class="text-center" style="width: 140px;">المبلغ</th>
                            <th style="width: 220px;">طريقة الدفع</th>
                            <th style="width: 190px;">المرجع</th>
                            <th class="text-center" style="width: 110px;">الإيصال</th>
                            <th style="width: 200px;">الطالب</th>
                            <th class="text-center" style="width: 120px;">الحالة</th>
                            <th class="text-center" style="width: 140px;">إجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.CompanyItems.Any())
                        {
                            foreach (var r in Model.CompanyItems)
                            {
                                var companyName = (r.Network?.Name ?? $"#{r.NetworkId}");
                                var methodName = (r.PaymentMethod?.Name ?? r.Method ?? "—");
                                var requesterName = (r.RequestedByUser?.FullName ?? r.RequestedByUser?.UserName ?? r.RequestedByUserId);
                                var searchable = $"{companyName} {r.NetworkId} {methodName} {r.ReferenceNumber} {requesterName} {r.Amount}";

                                <tr class="@(r.Status == NetworkTopUpRequestStatus.Pending ? "is-pending-row" : "")">
                                    <td class="text-nowrap" data-label="التاريخ">@r.RequestedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td data-search="@searchable" data-label="الشركة">
                                        <div class="fw-semibold">@companyName</div>
                                        <div class="text-muted small">#@r.NetworkId</div>
                                    </td>
                                    <td class="text-center" data-label="المبلغ">
                                        <div class="fw-bold">@r.Amount.ToString("N2")</div>
                                        <div class="text-muted small">ل.س.ج</div>
                                    </td>
                                    <td data-label="طريقة الدفع">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-semibold">@methodName</span>
                                            @if (r.PaymentMethod?.IsCash == true)
                                            {
                                                <span class="badge bg-primary">كاش</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-muted" data-label="المرجع">
                                        @if (!string.IsNullOrWhiteSpace(r.ReferenceNumber))
                                        {
                                            <span class="font-monospace">@r.ReferenceNumber</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center" data-label="الإيصال">
                                        @if (!string.IsNullOrWhiteSpace(r.ReceiptImagePath))
                                        {
                                            <a href="@NormalizeReceiptUrl(r.ReceiptImagePath)" target="_blank" rel="noopener" class="btn btn-sm btn-outline-secondary" title="عرض الإيصال">
                                                <i class="fas fa-image"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td data-label="الطالب">
                                        <div>@requesterName</div>
                                        <div class="text-muted small">@(r.RequestedByUserId ?? "")</div>
                                    </td>
                                    <td class="text-center" data-label="الحالة">
                                        @if (r.Status == NetworkTopUpRequestStatus.Pending)
                                        {
                                            <span class="badge bg-warning text-dark">معلّق</span>
                                        }
                                        else if (r.Status == NetworkTopUpRequestStatus.Approved)
                                        {
                                            <span class="badge bg-success">مقبول</span>
                                        }
                                        else if (r.Status == NetworkTopUpRequestStatus.Rejected)
                                        {
                                            <span class="badge bg-danger">مرفوض</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@r.Status</span>
                                        }
                                    </td>
                                    <td class="text-center sys-funding-action-cell" data-label="إجراء">
                                        @if (r.Status == NetworkTopUpRequestStatus.Pending)
                                        {
                                            <div class="sys-funding-action-inline">
                                                <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#approveCompany_@r.Id" title="قبول">
                                                    <i class="fas fa-check"></i>
                                                </button>
                                                <button type="button" class="btn btn-sm btn-danger" data-bs-toggle="modal" data-bs-target="#rejectCompany_@r.Id" title="رفض">
                                                    <i class="fas fa-xmark"></i>
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="9" class="text-center text-muted py-4">لا توجد طلبات</td></tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

    @foreach (var r in Model.CompanyItems.Where(x => x.Status == NetworkTopUpRequestStatus.Pending))
    {
        <div class="modal fade" id="approveCompany_@r.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form method="post" asp-area="SystemAdmin" asp-controller="TopUpRequests" asp-action="Approve">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@r.Id" />
                        <div class="modal-header">
                            <h5 class="modal-title">موافقة على طلب #@r.Id</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-2">الشركة: <strong>@(r.Network?.Name ?? $"#{r.NetworkId}")</strong></div>
                            <div class="mb-2">المبلغ: <strong>@r.Amount.ToString("N2")</strong></div>
                            @if (!string.IsNullOrWhiteSpace(r.ReceiptImagePath))
                            {
                                <div class="mb-3">
                                    <span class="form-label d-block">صورة الإيصال</span>
                                    <a href="@NormalizeReceiptUrl(r.ReceiptImagePath)" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary me-2"><i class="fas fa-external-link-alt"></i> فتح الصورة</a>
                                    <img src="@NormalizeReceiptUrl(r.ReceiptImagePath)" alt="صورة الإيصال" class="img-thumbnail mt-2" style="max-height: 180px; max-width: 100%;" />
                                </div>
                            }
                            <div class="mb-3">
                                <label class="form-label">ملاحظات (اختياري)</label>
                                <textarea name="notes" class="form-control" rows="3"></textarea>
                            </div>
                            <div class="alert alert-info mb-0">سيتم إضافة المبلغ إلى رصيد الشركة وتسجيل عملية بالمحفظة. وفي حال كانت الطريقة كاش سيتم إيداع المبلغ في الخزنة النقدية.</div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                            <button type="submit" class="btn btn-success">موافقة</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="modal fade" id="rejectCompany_@r.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form method="post" asp-area="SystemAdmin" asp-controller="TopUpRequests" asp-action="Reject">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@r.Id" />
                        <div class="modal-header">
                            <h5 class="modal-title">رفض طلب #@r.Id</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-2">الشركة: <strong>@(r.Network?.Name ?? $"#{r.NetworkId}")</strong></div>
                            <div class="mb-2">المبلغ: <strong>@r.Amount.ToString("N2")</strong></div>
                            @if (!string.IsNullOrWhiteSpace(r.ReceiptImagePath))
                            {
                                <div class="mb-3">
                                    <span class="form-label d-block">صورة الإيصال</span>
                                    <a href="@NormalizeReceiptUrl(r.ReceiptImagePath)" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary me-2"><i class="fas fa-external-link-alt"></i> فتح الصورة</a>
                                    <img src="@NormalizeReceiptUrl(r.ReceiptImagePath)" alt="صورة الإيصال" class="img-thumbnail mt-2" style="max-height: 180px; max-width: 100%;" />
                                </div>
                            }
                            <div class="mb-3">
                                <label class="form-label">سبب الرفض (اختياري)</label>
                                <textarea name="notes" class="form-control" rows="3"></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                            <button type="submit" class="btn btn-danger">رفض</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}
else
{
    <div class="sys-funding-toolbar card mb-3">
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between">
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <span class="badge bg-light text-dark">الإجمالي: <strong>@Model.CollectionPointItems.Count</strong></span>
                    <span class="badge bg-warning text-dark">معلّقة: <strong>@Model.PendingCollectionPointsCount</strong></span>
                </div>

                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <div class="input-group input-group-sm sys-funding-search">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input id="pointSearchInput" type="search" class="form-control" placeholder="بحث: نقطة التحصيل / المرجع / الطريقة..." autocomplete="off" />
                        <button id="pointSearchClearBtn" class="btn btn-outline-secondary" type="button" title="مسح البحث">
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="sys-funding-filters mt-3">
                <a class="sys-funding-filter-pill @(Model.CollectionPointStatus == null ? "is-active" : "")"
                   asp-route="systemAdmin-fundingRequests" asp-route-tab="collectionPoints">
                    الكل
                </a>
                <a class="sys-funding-filter-pill is-warning @(Model.CollectionPointStatus == CollectionPointTopUpStatus.Pending ? "is-active" : "")"
                   asp-route="systemAdmin-fundingRequests" asp-route-tab="collectionPoints" asp-route-collectionPointStatus="@CollectionPointTopUpStatus.Pending">
                    قيد الانتظار
                </a>
                <a class="sys-funding-filter-pill is-success @(Model.CollectionPointStatus == CollectionPointTopUpStatus.Approved ? "is-active" : "")"
                   asp-route="systemAdmin-fundingRequests" asp-route-tab="collectionPoints" asp-route-collectionPointStatus="@CollectionPointTopUpStatus.Approved">
                    مقبول
                </a>
                <a class="sys-funding-filter-pill is-danger @(Model.CollectionPointStatus == CollectionPointTopUpStatus.Rejected ? "is-active" : "")"
                   asp-route="systemAdmin-fundingRequests" asp-route-tab="collectionPoints" asp-route-collectionPointStatus="@CollectionPointTopUpStatus.Rejected">
                    مرفوض
                </a>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h3 class="card-title mb-0"><i class="fas fa-map-marker-alt"></i> طلبات نقاط التحصيل</h3>
            <div class="text-muted small" id="pointResultsHint"></div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive sys-funding-desktop">
                <table class="table table-hover table-striped align-middle mb-0" id="pointRequestsTable">
                    <thead>
                        <tr>
                            <th style="width: 160px;">التاريخ</th>
                            <th>نقطة التحصيل</th>
                            <th>الشبكة</th>
                            <th style="width: 220px;">طريقة الدفع</th>
                            <th style="width: 190px;">المرجع</th>
                            <th class="text-center" style="width: 110px;">الإيصال</th>
                            <th class="text-center" style="width: 140px;">المبلغ</th>
                            <th class="text-center" style="width: 120px;">الحالة</th>
                            <th class="text-center" style="width: 160px;">إجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.CollectionPointItems.Any())
                        {
                            foreach (var r in Model.CollectionPointItems)
                            {
                                var pointName = (r.CollectionPointAccount?.User?.UserName ?? r.RequestedByUser?.UserName ?? "—");
                                var networkName = (r.CollectionPointAccount?.Network?.Name ?? "—");
                                var methodName = (r.PaymentMethod?.Name ?? r.Method ?? "—");
                                var searchable = $"{pointName} {networkName} {methodName} {r.ReferenceNumber} {r.Amount}";

                                <tr class="@(r.Status == CollectionPointTopUpStatus.Pending ? "is-pending-row" : "")">
                                    <td class="text-nowrap" data-label="التاريخ">@r.RequestedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td data-search="@searchable" data-label="نقطة التحصيل">
                                        <div class="fw-semibold">@pointName</div>
                                    </td>
                                    <td data-label="الشبكة">@networkName</td>
                                    <td data-label="طريقة الدفع">
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fw-semibold">@methodName</span>
                                            @if (r.PaymentMethod?.IsCash == true)
                                            {
                                                <span class="badge bg-primary">كاش</span>
                                            }
                                        </div>
                                    </td>
                                    <td class="text-muted" data-label="المرجع">
                                        @if (!string.IsNullOrWhiteSpace(r.ReferenceNumber))
                                        {
                                            <span class="font-monospace">@r.ReferenceNumber</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="text-center" data-label="الإيصال">
                                        @if (!string.IsNullOrWhiteSpace(r.ReceiptImagePath))
                                        {
                                            <a class="btn btn-sm btn-outline-secondary" href="@NormalizeReceiptUrl(r.ReceiptImagePath)" target="_blank" title="عرض الإيصال">
                                                <i class="fas fa-image"></i>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td class="text-center" data-label="المبلغ">
                                        <div class="fw-bold">@r.Amount.ToString("N0")</div>
                                        <div class="text-muted small">ل.س</div>
                                    </td>
                                    <td class="text-center" data-label="الحالة">
                                        @switch (r.Status)
                                        {
                                            case CollectionPointTopUpStatus.Pending:
                                                <span class="badge bg-warning text-dark">قيد الانتظار</span>
                                                break;
                                            case CollectionPointTopUpStatus.Approved:
                                                <span class="badge bg-success">مقبول</span>
                                                break;
                                            case CollectionPointTopUpStatus.Rejected:
                                                <span class="badge bg-danger">مرفوض</span>
                                                break;
                                            case CollectionPointTopUpStatus.Cancelled:
                                                <span class="badge bg-secondary">ملغي</span>
                                                break;
                                        }
                                    </td>
                                    <td class="text-center sys-funding-action-cell" data-label="إجراء">
                                        @if (r.Status == CollectionPointTopUpStatus.Pending)
                                        {
                                            <div class="sys-funding-action-inline">
                                                <button type="button" class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#approvePoint_@r.Id">
                                                    <i class="fas fa-check"></i> قبول
                                                </button>
                                                <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#rejectPoint_@r.Id">
                                                    <i class="fas fa-xmark"></i> رفض
                                                </button>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center text-muted py-4">لا توجد طلبات</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>

    @foreach (var r in Model.CollectionPointItems.Where(x => x.Status == CollectionPointTopUpStatus.Pending))
    {
        <div class="modal fade" id="approvePoint_@r.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form method="post" asp-area="SystemAdmin" asp-controller="CollectionPointTopUpRequests" asp-action="Approve">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@r.Id" />
                        <div class="modal-header">
                            <h5 class="modal-title">موافقة على طلب #@r.Id</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-2">نقطة التحصيل: <strong>@(r.CollectionPointAccount?.User?.UserName ?? r.RequestedByUser?.UserName ?? "—")</strong></div>
                            <div class="mb-2">الشبكة: <strong>@(r.CollectionPointAccount?.Network?.Name ?? "—")</strong></div>
                            <div class="mb-2">المبلغ: <strong>@r.Amount.ToString("N0") ل.س</strong></div>
                            @if (!string.IsNullOrWhiteSpace(r.ReceiptImagePath))
                            {
                                <div class="mb-3">
                                    <span class="form-label d-block">صورة الإيصال</span>
                                    <a href="@NormalizeReceiptUrl(r.ReceiptImagePath)" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary me-2"><i class="fas fa-external-link-alt"></i> فتح الصورة</a>
                                    <img src="@NormalizeReceiptUrl(r.ReceiptImagePath)" alt="صورة الإيصال" class="img-thumbnail mt-2" style="max-height: 180px; max-width: 100%;" />
                                </div>
                            }
                            <div class="mb-3">
                                <label class="form-label">ملاحظات (اختياري)</label>
                                <textarea name="adminNotes" class="form-control" rows="2"></textarea>
                            </div>
                            <div class="alert alert-info mb-0">سيتم إضافة المبلغ مباشرة إلى رصيد نقطة التحصيل. وفي حال كانت الطريقة كاش سيتم إيداع المبلغ في الخزنة النقدية.</div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                            <button type="submit" class="btn btn-success">موافقة</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="modal fade" id="rejectPoint_@r.Id" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form method="post" asp-area="SystemAdmin" asp-controller="CollectionPointTopUpRequests" asp-action="Reject">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@r.Id" />
                        <div class="modal-header">
                            <h5 class="modal-title">رفض طلب #@r.Id</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                        </div>
                        <div class="modal-body">
                            <div class="mb-2">نقطة التحصيل: <strong>@(r.CollectionPointAccount?.User?.UserName ?? r.RequestedByUser?.UserName ?? "—")</strong></div>
                            <div class="mb-2">المبلغ: <strong>@r.Amount.ToString("N0") ل.س</strong></div>
                            @if (!string.IsNullOrWhiteSpace(r.ReceiptImagePath))
                            {
                                <div class="mb-3">
                                    <span class="form-label d-block">صورة الإيصال</span>
                                    <a href="@NormalizeReceiptUrl(r.ReceiptImagePath)" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary me-2"><i class="fas fa-external-link-alt"></i> فتح الصورة</a>
                                    <img src="@NormalizeReceiptUrl(r.ReceiptImagePath)" alt="صورة الإيصال" class="img-thumbnail mt-2" style="max-height: 180px; max-width: 100%;" />
                                </div>
                            }
                            <div class="mb-3">
                                <label class="form-label">سبب الرفض (اختياري)</label>
                                <textarea name="adminNotes" class="form-control" rows="2"></textarea>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                            <button type="submit" class="btn btn-danger">رفض</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

</div>

@section Scripts {
<script>
    (function () {
        function normalize(s) {
            return (s || '').toString().toLowerCase().trim();
        }

        const input = document.getElementById('companySearchInput');
        const clearBtn = document.getElementById('companySearchClearBtn');
        const hint = document.getElementById('companyResultsHint');
        const table = document.getElementById('companyRequestsTable');
        if (!input || !clearBtn || !table) return;
        const rows = Array.from(table.querySelectorAll('tbody tr'));

        function setHint(visible, total) {
            if (!hint) return;
            if (!total) { hint.textContent = ''; return; }
            hint.textContent = visible === total ? `عرض ${total} طلب` : `عرض ${visible} من أصل ${total}`;
        }

        function applyFilter() {
            const q = normalize(input.value);
            let visible = 0;

            const total = rows.length;

            rows.forEach(tr => {
                const cell = tr.querySelector('[data-search]');
                const hay = normalize(cell?.getAttribute('data-search') || tr.textContent);
                const ok = !q || hay.includes(q);
                tr.style.display = ok ? '' : 'none';
                if (ok) visible++;
            });

            setHint(visible, total);
        }

        clearBtn.addEventListener('click', function () {
            input.value = '';
            applyFilter();
            input.focus();
        });
        input.addEventListener('input', applyFilter);
        window.addEventListener('resize', applyFilter);
        input.value = '';
        applyFilter();
    })();

    (function () {
        function normalize(s) {
            return (s || '').toString().toLowerCase().trim();
        }

        const input = document.getElementById('pointSearchInput');
        const clearBtn = document.getElementById('pointSearchClearBtn');
