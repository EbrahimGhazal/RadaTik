@model IEnumerable<RadTik.Models.JoinRequest>

@{
    ViewData["Title"] = "طلبات الانضمام";
    ViewData["BodyClass"] = "sys-joinreq-page";
    var selectedStatus = ViewBag.SelectedStatus as RadTik.Models.JoinRequestStatus?;
    var selectedType = ViewBag.SelectedType as RadTik.Models.JoinRequestType?;
    int countPending = ViewBag.CountPending ?? 0;
    int countUnderReview = ViewBag.CountUnderReview ?? 0;
    int countApproved = ViewBag.CountApproved ?? 0;
    int countRejected = ViewBag.CountRejected ?? 0;
    var typeQuery = Context.Request.Query["type"].ToString();
    var baseRoute = new System.Collections.Generic.Dictionary<string, string?>();
    if (!string.IsNullOrWhiteSpace(typeQuery))
    {
        baseRoute["type"] = typeQuery;
    }

    string StatusText(RadTik.Models.JoinRequestStatus s) => s switch
    {
        RadTik.Models.JoinRequestStatus.Pending => "قيد الانتظار",
        RadTik.Models.JoinRequestStatus.UnderReview => "قيد المراجعة",
        RadTik.Models.JoinRequestStatus.Approved => "مقبول",
        RadTik.Models.JoinRequestStatus.Rejected => "مرفوض",
        _ => s.ToString()
    };

    string StatusBadgeClass(RadTik.Models.JoinRequestStatus s) => s switch
    {
        RadTik.Models.JoinRequestStatus.Pending => "bg-warning text-dark",
        RadTik.Models.JoinRequestStatus.UnderReview => "bg-info text-dark",
        RadTik.Models.JoinRequestStatus.Approved => "bg-success",
        RadTik.Models.JoinRequestStatus.Rejected => "bg-danger",
        _ => "bg-secondary"
    };
}

<div class="sys-joinreq">
    <div class="sys-hero mb-3">
        <div class="sys-hero-main">
            <div class="sys-hero-icon"><i class="fas fa-user-shield"></i></div>
            <div>
                <h1 class="sys-hero-title">@ViewData["Title"]</h1>
                <p class="sys-hero-subtitle">متابعة طلبات انضمام مدراء الشركات ونقاط التحصيل مع فرز ومراجعة أسرع.</p>
            </div>
        </div>
        <div class="sys-hero-chips">
            <span class="sys-hero-chip"><i class="fas fa-clock"></i> انتظار: @countPending</span>
            <span class="sys-hero-chip"><i class="fas fa-magnifying-glass"></i> مراجعة: @countUnderReview</span>
            <span class="sys-hero-chip"><i class="fas fa-check"></i> مقبول: @countApproved</span>
        </div>
    </div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-3 mb-3 sys-joinreq-stats">
    <div class="col-6 col-lg-3">
        <a class="card border-0 shadow-sm text-decoration-none sys-joinreq-stat-card @(selectedStatus == RadTik.Models.JoinRequestStatus.Pending ? "border border-2 border-warning" : "")"
           asp-route="systemAdmin-joinRequests" asp-all-route-data="baseRoute" asp-route-status="@((int)RadTik.Models.JoinRequestStatus.Pending)">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">قيد الانتظار</div>
                        <div class="fs-4 fw-bold">@countPending</div>
                    </div>
                    <i class="fas fa-clock text-warning fs-3"></i>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a class="card border-0 shadow-sm text-decoration-none sys-joinreq-stat-card @(selectedStatus == RadTik.Models.JoinRequestStatus.UnderReview ? "border border-2 border-info" : "")"
           asp-route="systemAdmin-joinRequests" asp-all-route-data="baseRoute" asp-route-status="@((int)RadTik.Models.JoinRequestStatus.UnderReview)">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">قيد المراجعة</div>
                        <div class="fs-4 fw-bold">@countUnderReview</div>
                    </div>
                    <i class="fas fa-search text-info fs-3"></i>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a class="card border-0 shadow-sm text-decoration-none sys-joinreq-stat-card @(selectedStatus == RadTik.Models.JoinRequestStatus.Approved ? "border border-2 border-success" : "")"
           asp-route="systemAdmin-joinRequests" asp-all-route-data="baseRoute" asp-route-status="@((int)RadTik.Models.JoinRequestStatus.Approved)">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">مقبول</div>
                        <div class="fs-4 fw-bold">@countApproved</div>
                    </div>
                    <i class="fas fa-check text-success fs-3"></i>
                </div>
            </div>
        </a>
    </div>
    <div class="col-6 col-lg-3">
        <a class="card border-0 shadow-sm text-decoration-none sys-joinreq-stat-card @(selectedStatus == RadTik.Models.JoinRequestStatus.Rejected ? "border border-2 border-danger" : "")"
           asp-route="systemAdmin-joinRequests" asp-all-route-data="baseRoute" asp-route-status="@((int)RadTik.Models.JoinRequestStatus.Rejected)">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small">مرفوض</div>
                        <div class="fs-4 fw-bold">@countRejected</div>
                    </div>
                    <i class="fas fa-times text-danger fs-3"></i>
                </div>
            </div>
        </a>
    </div>
</div>

<div class="sys-joinreq-subbar mb-2">
    <div class="text-muted small">
        تعرض هذه الصفحة طلبات إنشاء حساب <strong>مدير شركة</strong> و<strong>نقطة تحصيل</strong> (مرجعية: مدير النظام فقط).
    </div>
    <div class="sys-joinreq-actions">
        <div class="btn-group btn-group-sm" role="group">
            <a class="btn @(selectedType == null ? "btn-primary" : "btn-outline-primary")"
               asp-route="systemAdmin-joinRequests"
               asp-all-route-data="baseRoute">
                الكل
            </a>
            <a class="btn @(selectedType == RadTik.Models.JoinRequestType.NetworkAdministrator ? "btn-primary" : "btn-outline-primary")"
               asp-route="systemAdmin-joinRequests"
               asp-all-route-data="baseRoute"
               asp-route-type="@((int)RadTik.Models.JoinRequestType.NetworkAdministrator)">
                مدراء الشركات
            </a>
            <a class="btn @(selectedType == RadTik.Models.JoinRequestType.CollectionPoint ? "btn-primary" : "btn-outline-primary")"
               asp-route="systemAdmin-joinRequests"
               asp-all-route-data="baseRoute"
               asp-route-type="@((int)RadTik.Models.JoinRequestType.CollectionPoint)">
                نقاط التحصيل
            </a>
        </div>
        <div class="input-group input-group-sm sys-joinreq-search">
            <span class="input-group-text">
                <i class="fas fa-search"></i>
            </span>
            <input id="joinReqSearch"
                   type="text"
                   class="form-control"
                   placeholder="بحث بالاسم/البريد/الهاتف/رقم الطلب"
                   autocomplete="off" />
        </div>
        <a class="btn btn-outline-secondary btn-sm" asp-route="systemAdmin-joinRequests" asp-all-route-data="baseRoute">
            <i class="fas fa-list me-1"></i> عرض الكل
        </a>
    </div>
</div>

<div class="card border-0 shadow-sm sys-joinreq-table-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
            <tr>
                <th style="width:90px">#</th>
                <th>الاسم</th>
                <th class="d-none d-lg-table-cell">البريد</th>
                <th class="d-none d-xl-table-cell">الهاتف</th>
                <th class="d-none d-md-table-cell" style="width:180px">تاريخ الطلب</th>
                <th style="width:160px">الحالة</th>
                <th style="width:140px">إجراء</th>
            </tr>
            </thead>
            <tbody id="joinReqTableBody">
            @if (Model != null && Model.Any())
            {
                foreach (var r in Model)
                {
                    var typeText = r.RequestType == RadTik.Models.JoinRequestType.CollectionPoint ? "نقطة تحصيل" : "مدير شركة";
                    var search = string.Join(" ", new[]
                    {
                        r.Id.ToString(),
                        r.FullName ?? "",
                        r.Email ?? "",
                        r.PhoneNumber ?? "",
                        typeText
                    });
                    <tr data-joinreq-row="1" data-search="@search">
                        <td class="text-muted" data-label="#">#@r.Id</td>
                        <td data-label="الاسم">
                            <strong>@(r.FullName ?? "-")</strong>
                            <div class="small text-muted">@typeText</div>
                        </td>
                        <td data-label="البريد">@r.Email</td>
                        <td data-label="الهاتف">@r.PhoneNumber</td>
                        <td data-label="تاريخ الطلب">@r.CreatedDate.ToString("yyyy/MM/dd HH:mm")</td>
                        <td data-label="الحالة">
                            <span class="badge @StatusBadgeClass(r.Status)">@StatusText(r.Status)</span>
                        </td>
                        <td data-label="إجراء">
                            <a class="btn btn-sm btn-outline-primary"
                               asp-area="SystemAdmin" asp-controller="JoinRequests" asp-action="Details" asp-route-id="@r.Id">
                                <i class="fas fa-eye"></i> التفاصيل
                            </a>
                        </td>
                    </tr>
                }
            }
            <tr id="joinReqEmptyRow" class="@(Model != null && Model.Any() ? "d-none" : "")">
                <td colspan="7" class="text-center text-muted py-4">لا توجد طلبات انضمام ضمن التصفية الحالية.</td>
            </tr>
            </tbody>
        </table>
    </div>
</div>

<script>
    (function () {
        const input = document.getElementById('joinReqSearch');
        if (!input) return;

        const rows = Array.from(document.querySelectorAll('[data-joinreq-row="1"]'));
        const emptyRow = document.getElementById('joinReqEmptyRow');

        const normalize = (s) => (s || '').toString().toLowerCase();

        const apply = () => {
            const q = normalize(input.value).trim();

            let visibleRows = 0;
            for (const r of rows) {
                const hit = !q || normalize(r.dataset.search).includes(q);
                r.classList.toggle('d-none', !hit);
                if (hit) visibleRows++;
            }
            if (emptyRow) emptyRow.classList.toggle('d-none', visibleRows !== 0);

        };

        input.addEventListener('input', apply);
    })();
</script>
</div>

