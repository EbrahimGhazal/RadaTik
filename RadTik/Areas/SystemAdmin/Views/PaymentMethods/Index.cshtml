@using RadTik.Models
@{
    ViewData["Title"] = ViewData["Title"] ?? "طرق الدفع";
    var items = ViewBag.Items as IEnumerable<PaymentMethod> ?? Enumerable.Empty<PaymentMethod>();
    var list = items.ToList();
}

<div class="page-header">
    <h1>
        <i class="fas fa-money-check"></i>
        @ViewData["Title"]
    </h1>
    <p class="text-muted mb-0">إدارة طرق الدفع (إضافة/إلغاء/ترتيب) مثل: دفع مباشر، شام كاش، بنك بيمو، بنك البركة…</p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="content-grid">
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-plus-circle text-success"></i>
                إضافة طريقة دفع
            </h3>
        </div>
        <div class="card-body">
            <form method="post" asp-area="SystemAdmin" asp-controller="PaymentMethods" asp-action="Create" class="row g-3">
                @Html.AntiForgeryToken()
                <div class="col-md-6">
                    <label class="form-label">الاسم</label>
                    <input type="text" name="name" class="form-control" placeholder="مثال: شام كاش" required />
                </div>
                <div class="col-md-2">
                    <label class="form-label">الترتيب</label>
                    <input type="number" name="displayOrder" class="form-control" value="0" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="isActive" value="true" checked />
                        <label class="form-check-label">نشط</label>
                    </div>
                </div>
                <div class="col-md-2 d-flex align-items-end justify-content-end">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-plus"></i>
                        إضافة
                    </button>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="isCash" value="true" />
                        <label class="form-check-label">هذه الطريقة تعتبر كاش (تؤثر على الخزنة النقدية)</label>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-list"></i>
                القائمة
            </h3>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>الاسم</th>
                            <th class="text-center" style="width: 110px;">كاش</th>
                            <th class="text-center" style="width: 110px;">الترتيب</th>
                            <th class="text-center" style="width: 110px;">نشط</th>
                            <th style="width: 160px;">إجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (list.Any())
                        {
                            foreach (var m in list)
                            {
                                <tr>
                                    <td><strong>@m.Name</strong></td>
                                    <td class="text-center">
                                        @if (m.IsCash)
                                        {
                                            <span class="badge bg-primary">نعم</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark">لا</span>
                                        }
                                    </td>
                                    <td class="text-center">@m.DisplayOrder</td>
                                    <td class="text-center">
                                        @if (m.IsActive)
                                        {
                                            <span class="badge bg-success">نعم</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">لا</span>
                                        }
                                    </td>
                                    <td>
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editModal_@m.Id">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#deleteModal_@m.Id">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">لا توجد طرق دفع بعد</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@foreach (var m in list)
{
    <div class="modal fade" id="editModal_@m.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-area="SystemAdmin" asp-controller="PaymentMethods" asp-action="Update">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@m.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title">تعديل طريقة الدفع</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <label class="form-label">الاسم</label>
                            <input type="text" name="name" class="form-control" value="@m.Name" required />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">الترتيب</label>
                            <input type="number" name="displayOrder" class="form-control" value="@m.DisplayOrder" />
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" name="isActive" value="true" checked="@(m.IsActive ? "checked" : null)" />
                            <label class="form-check-label">نشط</label>
                        </div>
                        <div class="form-check mt-2">
                            <input class="form-check-input" type="checkbox" name="isCash" value="true" checked="@(m.IsCash ? "checked" : null)" />
                            <label class="form-check-label">كاش (يؤثر على الخزنة النقدية)</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary">حفظ</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteModal_@m.Id" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form method="post" asp-area="SystemAdmin" asp-controller="PaymentMethods" asp-action="Delete">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@m.Id" />
                    <div class="modal-header">
                        <h5 class="modal-title">تأكيد الحذف</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                    </div>
                    <div class="modal-body">
                        هل أنت متأكد من حذف طريقة الدفع: <strong>@m.Name</strong>؟
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-danger">حذف</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

