@{
    ViewData["Title"] = "الصفحة الرئيسية";
}

@section Styles {
<style>
    .rt-hero {
        min-height: 92vh;
        background: var(--rt-gradient);
        display: flex;
        align-items: center;
        position: relative;
        overflow: hidden;
        padding: 120px 0 80px;
    }

    .rt-hero::before {
        content: '';
        position: absolute;
        inset: 0;
        background:
            radial-gradient(circle at 20% 20%, rgba(6, 182, 212, 0.25), transparent 40%),
            radial-gradient(circle at 80% 70%, rgba(139, 92, 246, 0.22), transparent 35%);
    }

    .rt-hero-inner {
        position: relative;
        z-index: 1;
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px;
        display: grid;
        grid-template-columns: 1.2fr 0.8fr;
        gap: 48px;
        align-items: center;
    }

    .rt-hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 8px 14px;
        border-radius: 999px;
        background: rgba(255,255,255,0.1);
        border: 1px solid rgba(255,255,255,0.15);
        color: rgba(255,255,255,0.9);
        font-size: 14px;
        margin-bottom: 20px;
    }

    .rt-hero h1 {
        font-size: clamp(2rem, 4vw, 3.4rem);
        line-height: 1.25;
        color: #fff;
        font-weight: 800;
        margin-bottom: 18px;
    }

    .rt-hero p {
        color: rgba(255,255,255,0.82);
        font-size: 1.15rem;
        max-width: 620px;
        margin-bottom: 32px;
    }

    .rt-hero-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
    }

    .rt-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 14px 24px;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 700;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

    .rt-btn:hover { transform: translateY(-2px); }

    .rt-btn-primary {
        background: var(--rt-gradient-accent);
        color: #fff;
        box-shadow: 0 12px 28px rgba(37, 99, 235, 0.35);
    }

    .rt-btn-outline {
        border: 1px solid rgba(255,255,255,0.35);
        color: #fff;
        background: rgba(255,255,255,0.06);
    }

    .rt-hero-panel {
        background: rgba(255,255,255,0.08);
        border: 1px solid rgba(255,255,255,0.14);
        border-radius: 24px;
        padding: 28px;
        backdrop-filter: blur(12px);
    }

    .rt-stat-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .rt-stat {
        background: rgba(255,255,255,0.08);
        border-radius: 14px;
        padding: 18px;
        color: #fff;
    }

    .rt-stat strong {
        display: block;
        font-size: 1.6rem;
        margin-bottom: 4px;
    }

    .rt-stat span { font-size: 0.9rem; color: rgba(255,255,255,0.75); }

    .rt-section {
        padding: 90px 0;
    }

    .rt-section-inner {
        max-width: 1280px;
        margin: 0 auto;
        padding: 0 24px;
    }

    .rt-section-head {
        text-align: center;
        max-width: 760px;
        margin: 0 auto 48px;
    }

    .rt-section-head h2 {
        font-size: 2.2rem;
        margin-bottom: 12px;
        color: var(--rt-text);
    }

    .rt-section-head p { color: var(--rt-muted); font-size: 1.05rem; }

    .rt-feature-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 22px;
    }

    .rt-feature-card {
        background: var(--rt-surface);
        border: 1px solid var(--rt-border);
        border-radius: var(--rt-radius);
        padding: 28px;
        box-shadow: 0 8px 24px rgba(15, 23, 42, 0.05);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .rt-feature-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--rt-shadow);
    }

    .rt-feature-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(37, 99, 235, 0.1);
        color: var(--rt-primary);
        font-size: 22px;
        margin-bottom: 16px;
    }

    .rt-feature-card h3 {
        font-size: 1.15rem;
        margin-bottom: 10px;
    }

    .rt-feature-card p {
        color: var(--rt-muted);
        font-size: 0.95rem;
    }

    .rt-cta {
        background: var(--rt-gradient);
        border-radius: 24px;
        padding: 48px;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
    }

    .rt-cta h3 { font-size: 1.8rem; margin-bottom: 8px; }
    .rt-cta p { color: rgba(255,255,255,0.8); }

    @@media (max-width: 900px) {
        .rt-hero-inner { grid-template-columns: 1fr; }
        .rt-feature-grid { grid-template-columns: 1fr; }
    }
</style>
}

<section class="rt-hero">
    <div class="rt-hero-inner">
        <div>
            <div class="rt-hero-badge">
                <i class="fas fa-bolt"></i>
                <span>منصة SaaS لمزودي الإنترنت</span>
            </div>
            <h1>أدر شبكتك بالكامل من مكان واحد مع RadaTik</h1>
            <p>
                نظام متكامل لإدارة المشتركين، MikroTik، نقاط التحصيل، المحافظ، المخازن،
                الصيانة، الرواتب، والتقارير — مصمم لشركات ISP التي تريد نمواً منظماً.
            </p>
            <div class="rt-hero-actions">
                <a href="/Account/RegisterNetworkAdmin" class="rt-btn rt-btn-primary">
                    <i class="fas fa-building"></i>
                    ابدأ تسجيل شركتك
                </a>
                <a href="@Url.Action("Services", "Public", new { area = "RadaTik" })" class="rt-btn rt-btn-outline">
                    <i class="fas fa-layer-group"></i>
                    استكشف الخدمات
                </a>
            </div>
        </div>
        <div class="rt-hero-panel">
            <div class="rt-stat-grid">
                <div class="rt-stat"><strong>360°</strong><span>إدارة تشغيلية</span></div>
                <div class="rt-stat"><strong>MikroTik</strong><span>مزامنة وتفعيل</span></div>
                <div class="rt-stat"><strong>Multi</strong><span>شبكات فرعية</span></div>
                <div class="rt-stat"><strong>24/7</strong><span>بوابة للعملاء</span></div>
            </div>
        </div>
    </div>
</section>

<section class="rt-section">
    <div class="rt-section-inner">
        <div class="rt-section-head">
            <h2>لماذا RadaTik؟</h2>
            <p>منصة واحدة تجمع التشغيل اليومي، المالية، والخدمة — بدلاً من أدوات متفرقة.</p>
        </div>
        <div class="rt-feature-grid">
            <article class="rt-feature-card">
                <div class="rt-feature-icon"><i class="fas fa-users"></i></div>
                <h3>إدارة المشتركين</h3>
                <p>تسجيل، تجديد، تعليق، بوابة عميل، وطلبات السرعة من واجهة واحدة.</p>
            </article>
            <article class="rt-feature-card">
                <div class="rt-feature-icon"><i class="fas fa-server"></i></div>
                <h3>تكامل MikroTik</h3>
                <p>ربط الخوادم، PPPoE، البروفايلات، ومراقبة الاستهلاك لحظياً.</p>
            </article>
            <article class="rt-feature-card">
                <div class="rt-feature-icon"><i class="fas fa-wallet"></i></div>
                <h3>محافظ ونقاط تحصيل</h3>
                <p>محفظة الشركة، نقاط التحصيل، العمولات، والتسويات المالية.</p>
            </article>
            <article class="rt-feature-card">
                <div class="rt-feature-icon"><i class="fas fa-warehouse"></i></div>
                <h3>مخازن ومشتريات</h3>
                <p>أصناف، حركات، جرد، وفواتير مواد — مرتبطة بتشغيل الشبكة.</p>
            </article>
            <article class="rt-feature-card">
                <div class="rt-feature-icon"><i class="fas fa-chart-line"></i></div>
                <h3>تقارير وقرارات</h3>
                <p>لوحات تحكم، تقارير، وإحصائيات لمدير الشركة ومدير النظام.</p>
            </article>
            <article class="rt-feature-card">
                <div class="rt-feature-icon"><i class="fas fa-shield-halved"></i></div>
                <h3>أدوار وصلاحيات</h3>
                <p>فصل Areas للمدير، الموظف، نقطة التحصيل، والعميل مع عزل آمن.</p>
            </article>
        </div>
    </div>
</section>

<section class="rt-section" style="padding-top: 0;">
    <div class="rt-section-inner">
        <div class="rt-cta">
            <div>
                <h3>جاهز لتحويل إدارة شبكتك؟</h3>
                <p>سجّل شركتك وابدأ بإعداد الشبكة، الخدمات، والفريق خلال دقائق.</p>
            </div>
            <a href="@Url.Action("Contact", "Public", new { area = "RadaTik" })" class="rt-btn rt-btn-primary">
                <i class="fas fa-paper-plane"></i>
                تواصل معنا
            </a>
        </div>
    </div>
</section>
