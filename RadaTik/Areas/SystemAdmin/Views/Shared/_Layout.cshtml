@{
    // SystemAdmin Area layout.
    // Loads its own vendor assets + Area customizations.
    Layout = "~/Views/Shared/_Shell.cshtml";
}

@section Sidebar {
    <partial name="_Sidebar" />
}

@RenderBody()

@section VendorStyles {
    <!-- Bootstrap 5.3.8 (CDN primary, local fallback per Area) -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          asp-fallback-href="~/areas/SystemAdmin/lib/bootstrap/css/bootstrap.min.css"
          asp-fallback-test-class="d-none"
          asp-fallback-test-property="display"
          asp-fallback-test-value="none" />

    <!-- Leaflet CSS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/Leaflet.awesome-markers/2.0.2/leaflet.awesome-markers.css">

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css">

    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />
}

@section Styles {
    <!-- Shared CSS (base layout/components) -->
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <!-- SystemAdmin Area CSS -->
    <link rel="stylesheet" href="~/areas/SystemAdmin/css/area.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
}

@section VendorScripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>

    <!-- Bootstrap 5.3.8 bundle (CDN primary, local fallback per Area) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            asp-fallback-src="~/areas/SystemAdmin/lib/bootstrap/js/bootstrap.bundle.min.js"
            asp-fallback-test="window.bootstrap"></script>

    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Leaflet.awesome-markers/2.0.2/leaflet.awesome-markers.min.js"></script>
    <script src="https://unpkg.com/leaflet-semicircle@2.0.0/leaflet-semicircle.js"></script>

    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
}

@section Scripts {
    <!-- Shared JS -->
    <script src="~/js/common.js" asp-append-version="true"></script>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>

    <!-- SystemAdmin Area JS -->
    <script src="~/areas/SystemAdmin/js/area.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
}

