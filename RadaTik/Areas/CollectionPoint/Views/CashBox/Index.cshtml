@using RadaTik.Models
@{
    ViewData["Title"] = "الصندوق النقدي";
    ViewBag.PageHeroIcon = "fas fa-money-bill-wave";
    ViewBag.PageHeroSubtitle = "المبلغ النقدي الموجود باليد — إيداع وسحب وسجلات العمليات.";
    var cashBox = ViewBag.CashBox as CashBox;
    var ownerName = ViewBag.OwnerName as string ?? "نقطة التحصيل";
    var withdrawals = ViewBag.Withdrawals as List<CashBoxWithdrawal> ?? new List<CashBoxWithdrawal>();
    var deposits = ViewBag.Deposits as List<CashBoxDeposit> ?? new List<CashBoxDeposit>();
    var balance = cashBox?.Balance ?? 0m;
}

<div class="collection-point-finance-page">
<partial name="_CollectionPointFinanceNav" />
<partial name="_CrudPageHero" />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle"></i>
        @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle"></i>
        @TempData["Error"]
    </div>
}

<div class="row">
    <div class="col-lg-4">
        <div class="card mb-4 border-0">
            <div class="card-body cp-finance-balance">
                <div class="cp-finance-balance__label">رصيد الصندوق الحالي</div>
                <div class="cp-finance-balance__amount">@SyrianCurrencyHelper.FormatNew(balance) <span class="wallet-currency">ل.س.ج</span></div>
                @if (!string.IsNullOrEmpty(ownerName))
                {
                    <div class="text-muted small mt-2">@ownerName</div>
                }
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h6 class="card-title mb-0"><i class="fas fa-hand-holding-usd text-success"></i> إيداع في الصندوق</h6>
            </div>
            <div class="card-body">
                <form asp-area="CollectionPoint" asp-controller="CashBox" asp-action="Deposit" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="form-label">المبلغ (ل.س.ج)</label>
                        <input type="number" name="amount" class="form-control" min="0.01" step="0.01" required placeholder="0.00" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">ملاحظات (اختياري)</label>
                        <input type="text" name="notes" class="form-control" placeholder="سبب الإيداع" />
                    </div>
                    <button type="submit" class="btn btn-success w-100">
                        <i class="fas fa-plus"></i> إيداع
                    </button>
                </form>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">
                <h6 class="card-title mb-0"><i class="fas fa-minus-circle text-danger"></i> سحب من الصندوق</h6>
            </div>
            <div class="card-body">
                <form asp-area="CollectionPoint" asp-controller="CashBox" asp-action="Withdraw" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label class="form-label">المبلغ (ل.س.ج)</label>
                        <input type="number" name="amount" class="form-control" min="0.01" step="0.01" required placeholder="0.00" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label">ملاحظات / سبب السحب (اختياري)</label>
                        <input type="text" name="notes" class="form-control" placeholder="سبب السحب" />
                    </div>
                    <button type="submit" class="btn btn-danger w-100" @(balance < 0.01m ? "disabled" : "")>
                        <i class="fas fa-hand-holding"></i> سحب
                    </button>
                    @if (balance < 0.01m)
                    {
                        <small class="text-muted d-block mt-1">لا يوجد رصيد كافٍ للسحب.</small>
                    }
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="card mb-4">
            <div class="card-header">
                <h5 class="card-title mb-0"><i class="fas fa-history text-warning"></i> سجلات السحب</h5>
            </div>
            <div class="card-body p-0">
                @if (withdrawals.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 radtk-data-table radtk-data-table--cards cp-log-table">
                            <thead>
                                <tr>
                                    <th>التاريخ</th>
                                    <th>المبلغ</th>
                                    <th>الرصيد قبل</th>
                                    <th>الرصيد بعد</th>
                                    <th>من نفّذ</th>
                                    <th>ملاحظات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var w in withdrawals.Take(50))
                                {
                                    <tr>
                                        <td class="cp-cell--lead" data-label="التاريخ">@w.WithdrawnAt.ToString("yyyy/MM/dd HH:mm")</td>
                                        <td class="text-danger" data-label="المبلغ">-@SyrianCurrencyHelper.FormatNew(w.Amount)</td>
                                        <td data-label="الرصيد قبل">@SyrianCurrencyHelper.FormatNew(w.BalanceBefore)</td>
                                        <td data-label="الرصيد بعد">@SyrianCurrencyHelper.FormatNew(w.BalanceAfter)</td>
                                        <td data-label="من نفّذ">@(w.WithdrawnByUser?.FullName ?? w.WithdrawnByUser?.UserName ?? w.WithdrawnByUserId)</td>
                                        <td class="text-muted small" data-label="ملاحظات">@(w.Notes ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (withdrawals.Count > 50)
                    {
                        <div class="p-2 text-muted small">عرض آخر 50 عملية.</div>
                    }
                }
                else
                {
                    <p class="text-muted p-3 mb-0">لا توجد عمليات سحب حتى الآن.</p>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0"><i class="fas fa-piggy-bank text-success"></i> سجلات الإيداع</h5>
            </div>
            <div class="card-body p-0">
                @if (deposits.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 radtk-data-table radtk-data-table--cards cp-log-table">
                            <thead>
                                <tr>
                                    <th>التاريخ</th>
                                    <th>المبلغ</th>
                                    <th>الرصيد قبل</th>
                                    <th>الرصيد بعد</th>
                                    <th>من نفّذ</th>
                                    <th>ملاحظات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in deposits.Take(50))
                                {
                                    <tr>
                                        <td class="cp-cell--lead" data-label="التاريخ">@d.DepositedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                        <td class="text-success" data-label="المبلغ">+@SyrianCurrencyHelper.FormatNew(d.Amount)</td>
                                        <td data-label="الرصيد قبل">@SyrianCurrencyHelper.FormatNew(d.BalanceBefore)</td>
                                        <td data-label="الرصيد بعد">@SyrianCurrencyHelper.FormatNew(d.BalanceAfter)</td>
                                        <td data-label="من نفّذ">@(d.DepositedByUser?.FullName ?? d.DepositedByUser?.UserName ?? d.DepositedByUserId)</td>
                                        <td class="text-muted small" data-label="ملاحظات">@(d.Notes ?? "—")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (deposits.Count > 50)
                    {
                        <div class="p-2 text-muted small">عرض آخر 50 عملية.</div>
                    }
                }
                else
                {
                    <p class="text-muted p-3 mb-0">لا توجد عمليات إيداع حتى الآن.</p>
                }
            </div>
        </div>
    </div>
</div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/collection-point-finance-cards.css" asp-append-version="true" />
}
