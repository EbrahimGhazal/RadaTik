@model RadaTik.ViewModels.CollectionPoint.CollectionPointDashboardViewModel
@using RadaTik.ViewModels.UI
@{
    ViewData["Title"] = "لوحة التحصيل";
    var hero = new PageHeroViewModel
    {
        Title = ViewData["Title"] as string ?? "لوحة التحصيل",
        Subtitle = "اختر شبكة → ابحث عن مشترك → سدّد الفاتورة",
        IconClass = "fas fa-cash-register",
        Theme = "finance",
        Chips =
        [
            new PageHeroChipViewModel { IconClass = "fas fa-wallet", Text = $"رصيد النقطة: {Model.AccountBalance:N0} ل.س" }
        ],
        Actions =
        [
            new PageHeroActionViewModel
            {
                Text = "سجل التحصيل",
                Url = Url.Action("History") ?? "#",
                CssClass = "btn btn-outline-light btn-sm",
                IconClass = "fas fa-list"
            }
        ]
    };
}

<partial name="~/Views/Shared/_PageHero.cshtml" model="hero" />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="radtk-collect-flow mb-4">
    <p class="text-muted mb-2"><i class="fas fa-hand-pointer"></i> انقر على شركة/شبكة للبحث المباشر عن المشتركين</p>
    <div class="radtk-collect-network-grid">
        @if (Model.Networks != null && Model.Networks.Any())
        {
            @foreach (var net in Model.Networks)
            {
                <div class="radtk-collect-network-card network-card" data-network-id="@net.Id" data-network-name="@net.Name">
                    @if (!string.IsNullOrEmpty(net.LogoPath))
                    {
                        <img src="@net.LogoPath" alt="@net.Name" class="mb-2 radtk-collect-network-logo" />
                    }
                    else
                    {
                        <div class="radtk-collect-network-icon mb-2">
                            <i class="fas fa-building fa-2x"></i>
                        </div>
                    }
                    <h5 class="mb-1">@net.Name</h5>
                    @if (!string.IsNullOrEmpty(net.Phone))
                    {
                        <p class="text-muted small mb-0"><i class="fas fa-phone"></i> @net.Phone</p>
                    }
                    <span class="badge bg-primary mt-2">بحث وتسديد</span>
                </div>
            }
        }
        else
        {
            <div class="alert alert-info w-100">لا توجد شركات/شبكات متاحة. يرجى التواصل مع مدير النظام.</div>
        }
    </div>
</div>

<!-- Modal البحث عن المشتركين -->
<div class="modal fade" id="searchModal" tabindex="-1" aria-labelledby="searchModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="searchModalLabel">
                    <i class="fas fa-search"></i> البحث عن مشترك — <span id="modalNetworkName"></span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <div class="collect-search-bar mb-3">
                    <div class="input-group input-group-lg">
                        <input type="text" id="searchQuery" class="form-control" placeholder="اسم المستخدم، الاسم، رقم المشترك أو الجوال" autofocus />
                        <button type="button" id="btnSearch" class="btn btn-primary">
                            <i class="fas fa-search"></i> بحث
                        </button>
                    </div>
                </div>
                <div id="searchResults" class="collect-search-results">
                    <div class="collect-search-status">
                        <i class="fas fa-search"></i>
                        <span>أدخل كلمة البحث ثم اضغط بحث لعرض بطاقة المشترك</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal تأكيد تسديد الفاتورة -->
<div class="modal fade" id="confirmPayModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-check-circle"></i> تأكيد تسديد الفاتورة</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="confirmPayMessage"></p>
                <p class="text-muted small mb-0">سيتم حسم المبلغ من رصيد نقطة التحصيل وتجديد اشتراك المشترك لمدة شهر كامل.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <form id="confirmPayForm" method="post" asp-area="CollectionPoint" asp-controller="CollectionPoint" asp-action="PayBill" class="d-inline">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="clientId" id="confirmPayClientId" />
                    <button type="submit" class="btn btn-success btn-lg">تأكيد وتسديد</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="fas fa-history"></i> آخر عمليات التحصيل</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive radtk-data-table-wrap">
            <table class="table table-hover align-middle radtk-data-table radtk-data-table--cards">
                <thead>
                    <tr>
                        <th>التاريخ</th>
                        <th>نوع العملية</th>
                        <th>العميل</th>
                        <th>المبلغ</th>
                        <th>رصيد العميل بعد</th>
                        <th>رقم المرجع</th>
                        <th>ملاحظات</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentTransactions != null && Model.RecentTransactions.Any())
                    {
                        foreach (var t in Model.RecentTransactions)
                        {
                            <tr>
                                <td>@t.PaymentDate.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>
                                    @if (t.OperationType == "Renewal")
                                    {
                                        <span class="badge bg-success">تجديد</span>
                                    }
                                    else if (t.OperationType == "ClientTopUp")
                                    {
                                        <span class="badge bg-info">تغذية رصيد</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-primary">تحصيل</span>
                                    }
                                </td>
                                <td>@(t.Client?.Name ?? t.Client?.UserName ?? t.ClientId.ToString())</td>
                                <td>@t.Amount.ToString("N0") ل.س</td>
                                <td>@t.NewClientBalance.ToString("N0")</td>
                                <td class="small text-muted">@(string.IsNullOrWhiteSpace(t.ReferenceNumber) ? "—" : t.ReferenceNumber)</td>
                                <td class="text-muted">@t.Notes</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center text-muted">لا توجد عمليات بعد</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/collection-point-search-cards.css" asp-append-version="true" />
}

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        var currentNetworkId = null;
        var searchModal = new bootstrap.Modal(document.getElementById('searchModal'));
        var confirmPayModal = new bootstrap.Modal(document.getElementById('confirmPayModal'));
        var resultsEl = document.getElementById('searchResults');
        var detailsBaseUrl = '@Url.Action("ClientDetails", "CollectionPoint", new { area = "CollectionPoint" })';

        function escapeHtml(value) {
            return String(value == null ? '' : value)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function formatMoney(amount, unit, digits) {
            return Number(amount || 0).toLocaleString('en-US', {
                minimumFractionDigits: digits,
                maximumFractionDigits: digits
            }) + ' ' + unit;
        }

        function renderStatus(kind, icon, text) {
            var extra = kind ? ' collect-search-status--' + kind : '';
            resultsEl.innerHTML = '<div class="collect-search-status' + extra + '">' +
                '<i class="' + icon + '"></i>' +
                '<span>' + text + '</span>' +
                '</div>';
        }

        function firstLetter(text) {
            var value = String(text || '').trim();
            return value ? value.charAt(0) : 'م';
        }

        function renderClientCard(c) {
            var basePrice = parseFloat(c.basePrice || 0);
            var commissionAmount = parseFloat(c.commissionAmount || 0);
            var totalPrice = parseFloat(c.totalPrice || 0);
            var months = parseInt(c.pendingMonths || 1, 10);
            var totalDue = parseFloat(c.totalAmountDue || totalPrice);
            var isUsd = c.accountCurrency === 2;
            var unit = isUsd ? '$' : 'ل.س.ج';
            var pointDue = parseFloat(c.totalAmountDuePointChargeSyp || totalDue);
            var overdue = months > 1;
            var badgeClass = overdue ? 'badge bg-warning text-dark' : 'badge bg-success';
            var badgeText = overdue ? ('متأخر ' + months + ' أشهر') : 'تجديد شهر';
            var dueNote = overdue
                ? ('يشمل ' + months + ' أشهر مستحقة')
                : 'قيمة تجديد شهر واحد';
            if (isUsd) {
                dueNote += ' — يُخصم من النقطة ' + formatMoney(pointDue, 'ل.س.ج', 0);
            }
            var payConfirm = isUsd
                ? (formatMoney(totalDue, '$', 2) + ' (خصم ' + formatMoney(pointDue, 'ل.س.ج', 0) + ' من النقطة)')
                : formatMoney(totalDue, 'ل.س.ج', 2);
            var fullName = c.fullName || c.userName || 'مشترك';
            var phone = c.phoneNumber || '';
            var phoneHtml = phone
                ? ('<a href="tel:' + escapeHtml(phone.replace(/\s+/g, '')) + '">' + escapeHtml(phone) + '</a>')
                : '—';
            var speed = c.profileDownloadSpeedDisplay ? ' · ' + c.profileDownloadSpeedDisplay : '';

            return '<article class="collect-client-card' + (overdue ? ' collect-client-card--overdue' : '') + '">' +
                '<header class="collect-client-card__head">' +
                    '<div class="collect-client-card__avatar">' + escapeHtml(firstLetter(fullName)) + '</div>' +
                    '<div class="collect-client-card__identity">' +
                        '<h3 class="collect-client-card__name">' + escapeHtml(fullName) + '</h3>' +
                        '<p class="collect-client-card__username">@@' + escapeHtml(c.userName || '—') + '</p>' +
                    '</div>' +
                    '<span class="collect-client-card__badge ' + badgeClass + '">' + badgeText + '</span>' +
                '</header>' +
                '<dl class="collect-client-card__meta">' +
                    '<div><dt>رقم المشترك</dt><dd>' + escapeHtml(c.subscriberNumber || '—') + '</dd></div>' +
                    '<div><dt>الجوال</dt><dd>' + phoneHtml + '</dd></div>' +
                    '<div><dt>الباقة</dt><dd>' + escapeHtml((c.profileName || '—') + speed) + '</dd></div>' +
                    '<div><dt>سعر الشهر</dt><dd>' + escapeHtml(formatMoney(totalPrice, unit, 2)) + '</dd></div>' +
                '</dl>' +
                '<div class="collect-client-card__due">' +
                    '<div>' +
                        '<div class="collect-client-card__due-label">المبلغ المستحق</div>' +
                        '<div class="collect-client-card__due-amount">' + escapeHtml(formatMoney(totalDue, unit, 2)) + '</div>' +
                    '</div>' +
                    '<p class="collect-client-card__due-note">' + escapeHtml(dueNote) + '</p>' +
                '</div>' +
                '<div class="collect-client-card__prices">' +
                    '<span>أساسي: ' + escapeHtml(formatMoney(basePrice, unit, 2)) + '</span>' +
                    '<span>ضريبة: ' + escapeHtml(formatMoney(commissionAmount, unit, 2)) + '</span>' +
                '</div>' +
                '<div class="collect-client-card__actions">' +
                    '<button type="button" class="btn btn-success btn-pay" data-client-id="' + escapeHtml(c.id) +
                        '" data-user-name="' + escapeHtml(c.userName || fullName) +
                        '" data-pay-label="' + escapeHtml(payConfirm) +
                        '" data-months="' + months + '">' +
                        '<i class="fas fa-check-circle"></i> تسديد' +
                    '</button>' +
                    '<a class="btn btn-outline-primary" href="' + detailsBaseUrl + '/' + encodeURIComponent(c.id) + '">' +
                        '<i class="fas fa-eye"></i> تفاصيل' +
                    '</a>' +
                '</div>' +
            '</article>';
        }

        document.querySelectorAll('.network-card').forEach(function(card) {
            card.addEventListener('click', function() {
                currentNetworkId = parseInt(this.dataset.networkId, 10);
                document.getElementById('modalNetworkName').textContent = this.dataset.networkName || '';
                document.getElementById('searchQuery').value = '';
                renderStatus('', 'fas fa-search', 'أدخل كلمة البحث ثم اضغط بحث لعرض بطاقة المشترك');
                searchModal.show();
                setTimeout(function() { document.getElementById('searchQuery').focus(); }, 300);
            });
        });

        resultsEl.addEventListener('click', function(e) {
            var btn = e.target.closest('.btn-pay');
            if (!btn) return;
            var months = parseInt(btn.dataset.months || '1', 10);
            document.getElementById('confirmPayClientId').value = btn.dataset.clientId;
            var suffix = months > 1 ? (' (يشمل ' + months + ' أشهر متأخرة)') : '';
            document.getElementById('confirmPayMessage').textContent =
                'تسديد فاتورة المشترك ' + (btn.dataset.userName || '') + ' بمبلغ ' + (btn.dataset.payLabel || '') + '؟' + suffix;
            confirmPayModal.show();
        });

        function doSearch() {
            if (!currentNetworkId) return;
            var q = document.getElementById('searchQuery').value.trim();
            renderStatus('', 'fas fa-spinner fa-spin', 'جاري البحث...');

            var url = '@Url.Action("SearchClients", "CollectionPoint", new { area = "CollectionPoint" })'
                + '?networkId=' + encodeURIComponent(String(currentNetworkId))
                + (q ? '&q=' + encodeURIComponent(q) : '');
            fetch(url, { credentials: 'same-origin', headers: { 'Accept': 'application/json' } })
                .then(function(r) {
                    if (!r.ok) {
                        throw new Error('search-http-' + r.status);
                    }
                    return r.json();
                })
                .then(function(items) {
                    if (!Array.isArray(items) || items.length === 0) {
                        renderStatus('', 'fas fa-inbox', 'لا توجد نتائج مطابقة');
                        return;
                    }
                    resultsEl.innerHTML = items.map(renderClientCard).join('');
                })
                .catch(function() {
                    renderStatus('error', 'fas fa-exclamation-circle', 'حدث خطأ أثناء البحث');
                });
        }

        document.getElementById('btnSearch').addEventListener('click', doSearch);
        document.getElementById('searchQuery').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') { e.preventDefault(); doSearch(); }
        });
    });
</script>
}
