@using RadaTik.Helpers
@using RadaTik.Services.Company
@inject ICompanyClientPresenceService ClientPresence
@{
    var isAuthenticated = (bool?)(ViewData["Layout_IsAuthenticated"]) == true;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    var subscriptionOpen = action == "RenewSubscription" || action == "RequestTopUp" || action == "AvailablePlans" || action == "MaintenanceInvoices";
    var supportOpen = action == "MaintenanceRequests" || action == "SpeedChangeRequests";
    var presence = new CompanyClientPresenceSnapshot();
    if (isAuthenticated)
    {
        try
        {
            presence = await ClientPresence.GetForCurrentClientAsync(User);
        }
        catch
        {
            /* stable sidebar */
        }
    }
}

<aside class="sidebar sidebar-pro" id="sidebar">
    <div class="sidebar-header client-portal-sidebar-header">
        <div class="rt-sysadmin-brand client-portal-radatik-brand">
            @{
                ViewData["RtBrandVariant"] = "sidebar";
            }
            <partial name="_RadaTikBrandLogo" />
            <small class="sidebar-brand-sub" dir="rtl">بوابة العميل</small>
        </div>
        @if (isAuthenticated)
        {
            @await Component.InvokeAsync("ClientPortalNetworkBrand")
        }
    </div>

    <nav class="sidebar-nav" data-single-open="true">
        @if (!isAuthenticated)
        {
            <div class="nav-section">
                <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                    <i class="fas fa-bars"></i>
                    <span>القائمة</span>
                    <i class="fas fa-chevron-down nav-section-chevron"></i>
                </div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link" asp-route="reglog-login">
                            <span class="nav-icon"><i class="fas fa-sign-in-alt"></i></span>
                            <span>تسجيل الدخول</span>
                        </a>
                    </li>
                </ul>
            </div>
        }
        else
        {
            @* ——— 1. وصول سريع ——— *@
            <div class="nav-section nav-section-quick" data-section-key="quick-access">
                <div class="nav-section-title nav-section-static">
                    <i class="fas fa-bolt"></i>
                    <span>وصول سريع</span>
                </div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "ClientPortal" && action == "Index" ? "active" : "")"
                           asp-route="clientPortal-actions" asp-route-action="Index">
                            <span class="nav-icon"><i class="fas fa-gauge-high"></i></span>
                            <span>لوحة التحكم</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "ClientPortal" && action == "Notifications" ? "active" : "")"
                           asp-route="clientPortal-actions" asp-route-action="Notifications">
                            <span class="nav-icon"><i class="fas fa-bell"></i></span>
                            <span>الإشعارات</span>
                            <span id="clientPortalUnreadNotificationsBadge" class="nav-badge" style="display:none;">0</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "ClientPortal" && action == "MyTraffic" ? "active" : "")"
                           asp-route="clientPortal-actions" asp-route-action="MyTraffic">
                            <span class="nav-icon"><i class="fas fa-chart-line"></i></span>
                            <span>معدلي المباشر</span>
                        </a>
                    </li>
                </ul>
            </div>

            @* ——— 2. الاشتراك والفوترة ——— *@
            <div class="nav-section" data-section-key="subscription">
                <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                    <i class="fas fa-file-invoice-dollar"></i>
                    <span>الاشتراك والفوترة</span>
                    <i class="fas fa-chevron-down nav-section-chevron"></i>
                </div>
                <ul class="nav-list">
                    <li class="nav-item has-dropdown @(subscriptionOpen ? "open" : "")">
                        <div class="nav-link-toggle" role="button" tabindex="0">
                            <span class="nav-icon"><i class="fas fa-sync-alt"></i></span>
                            <span>إدارة الاشتراك</span>
                            <i class="fas fa-chevron-down nav-chevron"></i>
                        </div>
                        <ul class="nav-sublist">
                            <li class="nav-group-label">تجديد · رصيد · باقات</li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-sub @(action == "RenewSubscription" ? "active" : "")"
                                   asp-route="clientPortal-actions" asp-route-action="RenewSubscription">
                                    <i class="fas fa-sync-alt"></i>
                                    <span>تجديد الاشتراك</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-sub @(action == "RequestTopUp" ? "active" : "")"
                                   asp-route="clientPortal-actions" asp-route-action="RequestTopUp">
                                    <i class="fas fa-wallet"></i>
                                    <span>طلب تغذية رصيد</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-sub @(action == "AvailablePlans" ? "active" : "")"
                                   asp-route="clientPortal-actions" asp-route-action="AvailablePlans">
                                    <i class="fas fa-list-alt"></i>
                                    <span>الباقات المتاحة</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-sub @(action == "MaintenanceInvoices" ? "active" : "")"
                                   asp-route="clientPortal-actions" asp-route-action="MaintenanceInvoices">
                                    <i class="fas fa-file-invoice"></i>
                                    <span>فواتير الصيانة</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>

            @* ——— 3. الدعم والطلبات ——— *@
            <div class="nav-section" data-section-key="support">
                <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                    <i class="fas fa-headset"></i>
                    <span>الدعم والطلبات</span>
                    <i class="fas fa-chevron-down nav-section-chevron"></i>
                </div>
                <ul class="nav-list">
                    <li class="nav-item has-dropdown @(supportOpen ? "open" : "")">
                        <div class="nav-link-toggle" role="button" tabindex="0">
                            <span class="nav-icon"><i class="fas fa-wrench"></i></span>
                            <span>طلبات الخدمة</span>
                            <i class="fas fa-chevron-down nav-chevron"></i>
                        </div>
                        <ul class="nav-sublist">
                            <li class="nav-group-label">صيانة · سرعة</li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-sub @(action == "MaintenanceRequests" ? "active" : "")"
                                   asp-route="clientPortal-actions" asp-route-action="MaintenanceRequests">
                                    <i class="fas fa-tools"></i>
                                    <span>طلبات الصيانة</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-sub @(action == "SpeedChangeRequests" ? "active" : "")"
                                   asp-route="clientPortal-actions" asp-route-action="SpeedChangeRequests">
                                    <i class="fas fa-tachometer-alt"></i>
                                    <span>طلبات تغيير السرعة</span>
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>

            @* ——— 4. حسابي ——— *@
            <div class="nav-section nav-section-account" data-section-key="account">
                <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                    <i class="fas fa-user-circle"></i>
                    <span>حسابي</span>
                    <i class="fas fa-chevron-down nav-section-chevron"></i>
                </div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link @(action == "MyProfile" ? "active" : "")"
                           asp-route="clientPortal-actions" asp-route-action="MyProfile">
                            <span class="nav-icon"><i class="fas fa-user-edit"></i></span>
                            <span>الملف الشخصي</span>
                        </a>
                    </li>
                </ul>
            </div>

            @if (presence.HasComplaintContacts)
            {
                <div class="nav-section nav-section-complaints" data-section-key="complaints">
                    <ul class="nav-list">
                        <li class="nav-item">
                            <a class="nav-link @(action == "Complaints" ? "active" : "")"
                               asp-route="clientPortal-actions" asp-route-action="Complaints">
                                <span class="nav-icon"><i class="fas fa-phone-volume"></i></span>
                                <span>الشكاوى</span>
                            </a>
                        </li>
                    </ul>
                </div>
            }
        }
    </nav>
    @if (isAuthenticated && presence.HasSocialLinks)
    {
        <div class="client-portal-social" data-section-key="social">
            <span class="client-portal-social__title">كن من المعجبين بصفحاتنا على سوشال ميديا</span>
            <div class="client-portal-social__icons">
                @foreach (var link in presence.VisibleSocialLinks)
                {
                    var info = SocialMediaCatalog.Info(link.Platform);
                    <a class="client-portal-social__link"
                       href="@link.Url"
                       target="_blank"
                       rel="noopener noreferrer"
                       title="@link.DisplayName"
                       style="--brand:@info.BrandColor"
                       aria-label="@link.DisplayName">
                        <i class="@info.IconClass"></i>
                    </a>
                }
            </div>
        </div>
    }
</aside>
