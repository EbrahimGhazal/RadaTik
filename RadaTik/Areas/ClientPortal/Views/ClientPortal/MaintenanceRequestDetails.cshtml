@model RadaTik.Models.MaintenanceRequest
@using RadaTik.Models
@using RadaTik.Helpers
@{
    ViewData["Title"] = $"تفاصيل طلب الصيانة #{Model.Id}";
    ViewBag.PageHeroIcon = "fas fa-tools";
    ViewBag.PageHeroBackUrl = Url.Action("MaintenanceRequests");
    ViewBag.PageHeroBackText = "العودة للطلبات";
    var assignedName = Model.AssignedTo == null
        ? null
        : (string.IsNullOrWhiteSpace(Model.AssignedTo.FullName) ? Model.AssignedTo.UserName : Model.AssignedTo.FullName);
}
<div class="radtk-page--clientportal-views-clientportal-maintenancerequestdetails client-portal-ticket-page">

<partial name="_CrudPageHero" />

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="ticket-status-banner">
    <span class="badge @GetStatusBadgeClass(Model.Status)">@GetStatusName(Model.Status)</span>
    <span class="ticket-status-banner__id">طلب #@Model.Id</span>
</div>

<div class="ticket-facts">
    <article>
        <span>نوع المشكلة</span>
        <strong><i class="fas @GetTypeIcon(Model.Type)"></i> @GetMaintenanceTypeName(Model.Type)</strong>
    </article>
    <article>
        <span>الأولوية</span>
        <strong>@GetPriorityName(Model.Priority)</strong>
    </article>
    <article>
        <span>تاريخ الطلب</span>
        <strong>@Model.RequestDate.ToString("yyyy/MM/dd HH:mm")</strong>
    </article>
</div>

<section class="ticket-panel">
    <h3>وصف المشكلة</h3>
    <div class="request-box">@Model.Description</div>
</section>

<partial name="_SubscriberFaultDiagnosisReport" model="@(ViewBag.FaultDiagnosis as RadaTik.Services.Clients.SubscriberFaultDiagnosisDto)" />

@if (!string.IsNullOrWhiteSpace(Model.TechnicianNotes))
{
    <section class="ticket-panel">
        <h3>ملاحظات الفريق الفني</h3>
        <div class="request-box">@Model.TechnicianNotes</div>
    </section>
}

<section class="ticket-panel">
    <h3>بيانات الزيارة</h3>
    <dl class="ticket-meta">
        @if (Model.ScheduledVisitDate.HasValue)
        {
            <div>
                <dt>موعد الزيارة</dt>
                <dd>@Model.ScheduledVisitDate.Value.ToString("yyyy/MM/dd HH:mm")</dd>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(assignedName))
        {
            <div>
                <dt>الموظف المسند</dt>
                <dd>@assignedName</dd>
            </div>
        }
        else if (Model.Status == MaintenanceRequestStatus.Pending)
        {
            <div>
                <dt>الموظف المسند</dt>
                <dd class="text-muted">سيتم تحديده من المدير أو قسم الصيانة.</dd>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ContactPhone))
        {
            <div>
                <dt>هاتف التواصل</dt>
                <dd><a href="tel:@Model.ContactPhone">@Model.ContactPhone</a></dd>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.PreferredContactTime))
        {
            <div>
                <dt>أفضل وقت للتواصل</dt>
                <dd>@Model.PreferredContactTime</dd>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.Address))
        {
            <div>
                <dt>العنوان التفصيلي</dt>
                <dd class="ticket-address">@Model.Address</dd>
            </div>
        }
        @if (Model.CompletedDate.HasValue)
        {
            <div>
                <dt>تاريخ الإنجاز</dt>
                <dd>@Model.CompletedDate.Value.ToString("yyyy/MM/dd HH:mm")</dd>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
        {
            <div>
                <dt>سبب الرفض</dt>
                <dd>@Model.RejectionReason</dd>
            </div>
        }
    </dl>
</section>
@functions {
    string GetMaintenanceTypeName(MaintenanceType type) => MaintenanceCatalog.GetDisplayName(type);

    string GetTypeIcon(MaintenanceType type) => MaintenanceCatalog.GetIcon(type);

    string GetStatusName(MaintenanceRequestStatus status) => PricingDisplay.MaintenanceRequestStatusLabel(status);

    string GetPriorityName(RequestPriority priority) => PricingDisplay.RequestPriorityLabel(priority);

    string GetStatusBadgeClass(MaintenanceRequestStatus status) => PricingDisplay.MaintenanceRequestStatusBadgeClass(status);
}
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/client-portal-support-cards.css" asp-append-version="true" />
}
