@model RadaTik.Models.Client
@using RadaTik.ViewModels.UI
@using RadaTik.Services
@using RadaTik.ViewModels
@{
    ViewData["Title"] = "الرئيسية";
    int pendingMaintenance = ViewBag.PendingMaintenanceRequests ?? 0;
    bool hasLiveTraffic = ViewBag.HasLiveTraffic as bool? == true;
    var presenceActivity = ViewBag.PresenceActivity as SubscriberActivitySummary;
    var presenceWindow = ViewBag.PresenceWindow as SubscriberPresenceFilter.ResolvedWindow
        ?? SubscriberPresenceFilter.Resolve(SubscriberPresenceFilter.ModeMonth, null, null, null, null);

    bool isExpired = Model.AccountExpirationDate.HasValue && Model.AccountExpirationDate.Value < DateTime.Now;
    bool isExpiringSoon = Model.AccountExpirationDate.HasValue &&
                          Model.AccountExpirationDate.Value >= DateTime.Now &&
                          Model.AccountExpirationDate.Value <= DateTime.Now.AddDays(7);
    decimal priceWithVat = Model.Profile?.PriceWithVAT ?? 0m;
    bool canRenewFromWallet = Model.Profile != null && priceWithVat > 0 && Model.Balance >= priceWithVat;
    bool needsBalance = Model.Profile != null && priceWithVat > 0 && Model.Balance < priceWithVat;

    int? daysLeft = null;
    if (Model.AccountExpirationDate.HasValue)
    {
        daysLeft = (int)Math.Ceiling((Model.AccountExpirationDate.Value.Date - DateTime.Today).TotalDays);
    }

    string statusTitle = !Model.IsActive && !isExpired
        ? "الخدمة متوقفة حالياً"
        : isExpired
            ? "اشتراكك متوقف"
            : isExpiringSoon
                ? daysLeft == 0 ? "اشتراكك ينتهي اليوم" : daysLeft == 1 ? "اشتراكك ينتهي غداً" : $"اشتراكك ينتهي خلال {daysLeft} أيام"
                : "اشتراكك شغال";

    string statusDetail = Model.AccountExpirationDate.HasValue
        ? isExpired
            ? "جدّده ليعود الإنترنت."
            : $"حتى {Model.AccountExpirationDate.Value:yyyy/MM/dd}."
        : "تاريخ الانتهاء غير محدد. اسأل الشركة إذا انقطع الإنترنت.";

    var hero = new PageHeroViewModel
    {
        Title = string.IsNullOrWhiteSpace(Model.Name) ? "مرحباً" : $"مرحباً، {Model.Name}",
        Subtitle = "اختر ما تريده من الأزرار. لا حاجة لقائمة طويلة.",
        IconClass = "fas fa-house",
        Theme = "client",
        Chips = Model.IsVip
            ? [new PageHeroChipViewModel { IconClass = "fas fa-crown", Text = "مشترك مميز" }]
            : []
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/subscriber-presence.css" asp-append-version="true" />
}

<div class="radtk-page--clientportal-views-clientportal-index">

<div class="client-portal subscriber-home">
    <partial name="~/Views/Shared/_PageHero.cshtml" model="hero" />

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle alert-icon"></i>
            <div class="alert-content">@TempData["Success"]</div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle alert-icon"></i>
            <div class="alert-content">@TempData["Error"]</div>
        </div>
    }

    <section class="subscriber-status @(isExpired || !Model.IsActive ? "is-stopped" : isExpiringSoon ? "is-soon" : "is-ok")" aria-label="حالة الاشتراك">
        <p class="subscriber-status__kicker">حالة الإنترنت</p>
        <h2>@statusTitle</h2>
        <p class="subscriber-status__detail">@statusDetail</p>
        <ul class="subscriber-status__facts">
            <li>
                <span>الباقة</span>
                <strong>@(Model.Profile?.Name ?? "غير محددة")</strong>
            </li>
            @if (Model.Profile != null && !string.IsNullOrWhiteSpace(Model.Profile.DownloadSpeedDisplay))
            {
                <li>
                    <span>السرعة</span>
                    <strong>@Model.Profile.DownloadSpeedDisplay</strong>
                </li>
            }
            <li>
                <span>رصيدك</span>
                <strong>@Model.Balance.ToString("N0") ل.س</strong>
            </li>
            @if (priceWithVat > 0)
            {
                <li>
                    <span>سعر التجديد</span>
                    <strong>@priceWithVat.ToString("N0") ل.س</strong>
                </li>
            }
        </ul>

        @if (canRenewFromWallet)
        {
            <form method="post" action="@Url.Action("SelfRenewSubscription")" class="subscriber-status__action">
                @Html.AntiForgeryToken()
                <button type="submit" class="subscriber-go subscriber-go--primary">
                    جدّد الآن
                    <small>يُخصم @priceWithVat.ToString("N0") ل.س من رصيدك</small>
                </button>
            </form>
        }
        else if (needsBalance)
        {
            <a class="subscriber-go subscriber-go--primary" href="@Url.Action("RequestTopUp")">
                أضف رصيداً
                <small>ينقصك @((priceWithVat - Model.Balance).ToString("N0")) ل.س للتجديد</small>
            </a>
        }
        else
        {
            <a class="subscriber-go subscriber-go--primary" href="@Url.Action("RenewSubscription")">جدّد اشتراكي</a>
        }
    </section>

    @if (pendingMaintenance > 0)
    {
        <a class="subscriber-note" href="@Url.Action("MaintenanceRequests")">
            لديك @pendingMaintenance @(pendingMaintenance == 1 ? "طلب" : "طلبات") صيانة قيد المتابعة.
        </a>
    }

    <h3 class="subscriber-tasks__title">ماذا تريد أن تفعل؟</h3>
    <div class="subscriber-tasks">
        <a class="subscriber-task" href="@Url.Action("RenewSubscription")">
            <i class="fas fa-sync-alt" aria-hidden="true"></i>
            <span>
                <strong>جدّد اشتراكي</strong>
                <small>حتى يبقى الإنترنت شغال</small>
            </span>
        </a>
        <a class="subscriber-task" href="@Url.Action("RequestTopUp")">
            <i class="fas fa-wallet" aria-hidden="true"></i>
            <span>
                <strong>أضف رصيداً</strong>
                <small>ثم استخدمه للتجديد</small>
            </span>
        </a>
        <a class="subscriber-task" href="@Url.Action("SupportChat")">
            <i class="fas fa-comments" aria-hidden="true"></i>
            <span>
                <strong>الدعم المباشر</strong>
                <small>دردشة مع المساعد أو موظف الشركة</small>
            </span>
        </a>
        <a class="subscriber-task" href="@Url.Action("CreateMaintenanceRequest")">
            <i class="fas fa-wifi" aria-hidden="true"></i>
            <span>
                <strong>الإنترنت لا يعمل</strong>
                <small>أرسل طلباً وتتابعه الشركة</small>
            </span>
        </a>
        <a class="subscriber-task" href="@Url.Action("AvailablePlans")">
            <i class="fas fa-tachometer-alt" aria-hidden="true"></i>
            <span>
                <strong>غيّر الباقة</strong>
                <small>أسرع أو أوفر</small>
            </span>
        </a>
    </div>

    <nav class="subscriber-more" aria-label="روابط إضافية">
        <a href="@Url.Action("MaintenanceInvoices")">فواتير الصيانة</a>
        <a href="@Url.Action("Notifications")">التنبيهات</a>
        <a href="@Url.Action("MyProfile")">بياناتي</a>
        @if (hasLiveTraffic)
        {
            <a href="@Url.Action("MyTraffic")">سرعتي</a>
        }
        @if (presenceActivity != null)
        {
            <a href="#subscriber-presence">سجل اتصالك</a>
        }
    </nav>

    @if (presenceActivity != null)
    {
        var presencePanel = new SubscriberPresencePanelModel
        {
            Activity = presenceActivity,
            Window = presenceWindow,
            FormActionUrl = Url.Action("Index") ?? "#",
            Heading = "سجل اتصالك"
        };
        <div id="subscriber-presence" class="subscriber-presence-wrap">
            <partial name="~/Views/Shared/_SubscriberPresencePanel.cshtml" model="presencePanel" />
        </div>
    }
</div>
</div>
