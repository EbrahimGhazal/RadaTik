@model RadaTik.Models.Client
@using RadaTik.ViewModels.UI
@{
    ViewData["Title"] = "لوحة تحكم العميل";
    var pendingMaintenance = ViewBag.PendingMaintenanceRequests ?? 0;
    var pendingSpeedChange = ViewBag.PendingSpeedChangeRequests ?? 0;
    var hasLiveTraffic = ViewBag.HasLiveTraffic as bool? == true;
    var trafficNetworkId = ViewBag.TrafficNetworkId as int?;
    var trafficServerId = ViewBag.TrafficServerId as int?;
    
    var isExpired = Model.AccountExpirationDate.HasValue && Model.AccountExpirationDate.Value < DateTime.Now;
    var isExpiringSoon = Model.AccountExpirationDate.HasValue && 
                         Model.AccountExpirationDate.Value >= DateTime.Now && 
                         Model.AccountExpirationDate.Value <= DateTime.Now.AddDays(7);
    var priceWithVat = Model.Profile?.PriceWithVAT ?? 0m;
    var canRenewFromWallet = Model.Profile != null && priceWithVat > 0 && Model.Balance >= priceWithVat;

    var hero = new PageHeroViewModel
    {
        Title = $"مرحباً، {Model.Name}",
        Subtitle = "إدارة اشتراكك، تجديد الرصيد، وطلبات الدعم",
        IconClass = "fas fa-user-circle",
        Theme = "client",
        Chips = Model.IsVip
            ? [new PageHeroChipViewModel { IconClass = "fas fa-crown", Text = "VIP — مشترك مميز" }]
            : []
    };
}
<div class="radtk-page--clientportal-views-clientportal-index">

<div class="client-portal">
    <partial name="~/Views/Shared/_PageHero.cshtml" model="hero" />

    <!-- تنبيهات -->
    @if (isExpired)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-triangle alert-icon"></i>
            <div class="alert-content">
                <strong>انتهى اشتراكك!</strong> يرجى التواصل مع الإدارة لتجديد الاشتراك.
            </div>
        </div>
    }
    else if (isExpiringSoon)
    {
        <div class="alert alert-warning">
            <i class="fas fa-clock alert-icon"></i>
            <div class="alert-content">
                <strong>اشتراكك ينتهي قريباً!</strong> ينتهي اشتراكك في @(Model.AccountExpirationDate?.ToString("yyyy/MM/dd")). يرجى تجديد الاشتراك لتجنب انقطاع الخدمة.
            </div>
        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle alert-icon"></i>
            <div class="alert-content">@TempData["Success"]</div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle alert-icon"></i>
            <div class="alert-content">@TempData["Error"]</div>
        </div>
    }

    <!-- بطاقات الإحصائيات -->
    <div class="stats-grid">
        <div class="stat-card stat-primary">
            <div class="stat-icon">
                <i class="fas fa-wifi"></i>
            </div>
            <div class="stat-details">
                <span class="stat-label">الباقة الحالية</span>
                <span class="stat-value">
                    @(Model.Profile?.Name ?? "غير محدد")
                    @if (Model.IsVip)
                    {
                        <span class="badge clients-vip-badge" title="@(string.IsNullOrWhiteSpace(Model.VipNote) ? "مشترك مميز" : Model.VipNote)">
                            <i class="fas fa-crown"></i> VIP
                        </span>
                    }
                </span>
                @if (Model.Profile != null)
                {
                    <span class="stat-sub">@Model.Profile.DownloadSpeedDisplay</span>
                }
            </div>
        </div>

        <div class="stat-card @(isExpired ? "stat-danger" : isExpiringSoon ? "stat-warning" : "stat-success")">
            <div class="stat-icon">
                <i class="fas fa-calendar-alt"></i>
            </div>
            <div class="stat-details">
                <span class="stat-label">انتهاء الاشتراك</span>
                <span class="stat-value">
                    @if (Model.AccountExpirationDate.HasValue)
                    {
                        @(Model.AccountExpirationDate.Value.ToString("yyyy/MM/dd"))
                    }
                    else
                    {
                        @:غير محدد
                    }
                </span>
                @if (isExpired)
                {
                    <span class="stat-sub text-danger">منتهي</span>
                }
                else if (isExpiringSoon)
                {
                    <span class="stat-sub text-warning">ينتهي قريباً</span>
                }
            </div>
        </div>

        <div class="stat-card stat-info">
            <div class="stat-icon">
                <i class="fas fa-tools"></i>
            </div>
            <div class="stat-details">
                <span class="stat-label">طلبات الصيانة المعلقة</span>
                <span class="stat-value">@pendingMaintenance</span>
            </div>
        </div>

        <div class="stat-card stat-secondary">
            <div class="stat-icon">
                <i class="fas fa-tachometer-alt"></i>
            </div>
            <div class="stat-details">
                <span class="stat-label">طلبات تغيير السرعة</span>
                <span class="stat-value">@pendingSpeedChange</span>
            </div>
        </div>

        <div class="stat-card stat-wallet">
            <div class="stat-icon">
                <i class="fas fa-wallet"></i>
            </div>
            <div class="stat-details">
                <span class="stat-label">رصيد المحفظة</span>
                <span class="stat-value">@(Model.Balance.ToString("N0")) ل.س</span>
            </div>
        </div>
    </div>

    @if (hasLiveTraffic && trafficNetworkId.HasValue && trafficServerId.HasValue)
    {
        <div class="portal-live-traffic mb-4">
            <div class="stat-card stat-live-traffic">
                <div class="stat-icon">
                    <i class="fas fa-bolt"></i>
                </div>
                <div class="stat-details flex-grow-1">
                    <span class="stat-label">اختبار المعدل المباشر</span>
                    <p class="text-muted small mb-2 mb-lg-0">يمكنك تشغيل اختبار لمدة 10 ثوانٍ مع حسم 50 ل.س جديدة، ويتكرر كل 4 ساعات.</p>
                    <a href="@Url.Action("MyTraffic", "ClientPortal", new { area = "ClientPortal" })" class="btn btn-sm btn-outline-primary mt-3 rounded-3">
                        <i class="fas fa-chart-line me-1"></i> فتح صفحة معدلي المباشر
                    </a>
                </div>
            </div>
        </div>
    }

    <!-- معلومات الاشتراك -->
    <div class="content-grid">
        <div class="card subscription-card">
            <div class="card-header">
                <h3><i class="fas fa-id-card"></i> معلومات الاشتراك</h3>
            </div>
            <div class="card-body">
                <div class="info-grid">
                    <div class="info-item">
                        <span class="info-label">اسم المستخدم</span>
                        <span class="info-value"><code>@Model.UserName</code></span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">رقم الهاتف</span>
                        <span class="info-value">@(Model.PhoneNumber ?? "-")</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">المستقبل</span>
                        <span class="info-value">@(Model.Receiver?.Name ?? "-")</span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">الحالة</span>
                        <span class="info-value">
                            @if (Model.IsActive)
                            {
                                <span class="badge badge-success"><i class="fas fa-check"></i> نشط</span>
                            }
                            else
                            {
                                <span class="badge badge-danger"><i class="fas fa-times"></i> معطل</span>
                            }
                        </span>
                    </div>
                    <div class="info-item">
                        <span class="info-label">تاريخ الاشتراك</span>
                        <span class="info-value">@(Model.CreatedDate.ToString("yyyy/MM/dd"))</span>
                    </div>
                    @if (Model.Profile != null)
                    {
                        <div class="info-item">
                            <span class="info-label">سعر الباقة (شهرياً مع الضريبة)</span>
                            <span class="info-value">@(Model.Profile.PriceWithVAT.ToString("N0")) ل.س</span>
                        </div>
                    }
                </div>
                @if (canRenewFromWallet)
                {
                    <hr />
                    <div class="renew-section">
                        <p class="renew-desc">رصيدك كافٍ لتجديد الاشتراك شهراً واحداً. المبلغ الذي سيُخصم: <strong>@(priceWithVat.ToString("N0")) ل.س</strong></p>
                        <form method="post" action="@Url.Action("SelfRenewSubscription")" class="renew-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-renew">
                                <i class="fas fa-sync-alt"></i> تجديد الاشتراك من المحفظة
                            </button>
                        </form>
                    </div>
                }
                else if (Model.Profile != null && priceWithVat > 0 && Model.Balance < priceWithVat)
                {
                    <hr />
                    <p class="text-muted small mb-0">لتجديد الاشتراك من المحفظة يلزم أن يكون رصيدك على الأقل @(priceWithVat.ToString("N0")) ل.س. رصيدك الحالي: @(Model.Balance.ToString("N0")) ل.س.</p>
                }
            </div>
        </div>

        <!-- إجراءات سريعة -->
        <div class="card actions-card">
            <div class="card-header">
                <h3><i class="fas fa-bolt"></i> إجراءات سريعة</h3>
            </div>
            <div class="card-body">
                <div class="quick-actions">
                    <a href="@Url.Action("RequestTopUp")" class="action-btn action-wallet">
                        <i class="fas fa-wallet"></i>
                        <span>طلب تغذية رصيد</span>
                    </a>
                    <a href="@Url.Action("RenewSubscription")" class="action-btn action-renew">
                        <i class="fas fa-sync-alt"></i>
                        <span>تجديد الاشتراك</span>
                    </a>
                    <a href="@Url.Action("CreateMaintenanceRequest")" class="action-btn action-maintenance">
                        <i class="fas fa-tools"></i>
                        <span>طلب صيانة</span>
                    </a>
                    <a href="@Url.Action("AvailablePlans")" class="action-btn action-speed">
                        <i class="fas fa-tachometer-alt"></i>
                        <span>تغيير السرعة</span>
                    </a>
                    <a href="@Url.Action("AvailablePlans")" class="action-btn action-plans">
                        <i class="fas fa-list-alt"></i>
                        <span>عرض الباقات</span>
                    </a>
                    <a href="@Url.Action("MaintenanceRequests")" class="action-btn action-requests">
                        <i class="fas fa-clipboard-list"></i>
                        <span>طلباتي</span>
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {}
