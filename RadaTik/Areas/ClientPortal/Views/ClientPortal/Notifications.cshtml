@model List<RadaTik.Models.UserNotification>
@{
    ViewData["Title"] = "الإشعارات";
    var unreadOnly = ViewBag.UnreadOnly as bool? == true;
}

<div class="client-portal">
    <div class="page-header mb-4 d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h2><i class="fas fa-bell text-primary"></i> الإشعارات</h2>
            <p class="text-muted mb-0">كل التنبيهات الخاصة بحسابك تظهر هنا.</p>
        </div>
        <div class="btn-group" role="group" aria-label="notification-filters">
            <a asp-action="Notifications"
               asp-route-unreadOnly="false"
               class="btn @(unreadOnly ? "btn-outline-secondary" : "btn-primary")">
                الكل
            </a>
            <a asp-action="Notifications"
               asp-route-unreadOnly="true"
               class="btn @(unreadOnly ? "btn-primary" : "btn-outline-secondary")">
                غير المقروءة فقط
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>العنوان</th>
                            <th>الرسالة</th>
                            <th>التاريخ</th>
                            <th>الحالة</th>
                            <th>إجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr class="@(item.IsRead ? string.Empty : "table-warning")">
                                <td class="fw-semibold">@item.Title</td>
                                <td class="text-muted">@item.Message</td>
                                <td>@item.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>
                                    @if (item.IsRead)
                                    {
                                        <span class="badge bg-secondary">مقروء</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">غير مقروء</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="OpenNotification"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-primary">
                                        <i class="fas fa-external-link-alt"></i>
                                        الانتقال للعمل المطلوب
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">لا توجد إشعارات حالياً.</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
