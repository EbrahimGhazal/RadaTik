@model List<RadaTik.Models.UserNotification>
@{
    ViewData["Title"] = "الإشعارات";
    var unreadOnly = ViewBag.UnreadOnly as bool? == true;
}

<div class="client-portal client-portal-notify-page">
    <div class="support-page-head">
        <div>
            <h2><i class="fas fa-bell"></i> الإشعارات</h2>
            <p class="text-muted mb-0">كل التنبيهات الخاصة بحسابك تظهر هنا.</p>
        </div>
        <div class="support-filter" role="group" aria-label="تصفية الإشعارات">
            <a asp-action="Notifications"
               asp-route-unreadOnly="false"
               class="@(unreadOnly ? "" : "is-active")">الكل</a>
            <a asp-action="Notifications"
               asp-route-unreadOnly="true"
               class="@(unreadOnly ? "is-active" : "")">غير المقروءة</a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    @if (Model.Count == 0)
    {
        <div class="support-empty">
            <i class="fas fa-bell-slash"></i>
            <h3>لا توجد إشعارات حالياً</h3>
            <p>@(unreadOnly ? "لا يوجد تنبيه غير مقروء." : "ستظهر هنا تنبيهات التجديد والصيانة والمحفظة.")</p>
        </div>
    }
    else
    {
        <div class="support-card-list">
            @foreach (var item in Model)
            {
                <article class="support-card notify-card @(item.IsRead ? "is-read" : "is-unread")">
                    <header class="support-card__head">
                        <div>
                            <div class="support-card__kicker">@item.CreatedAt.ToString("yyyy/MM/dd HH:mm")</div>
                            <h3 class="support-card__title">@item.Title</h3>
                        </div>
                        @if (item.IsRead)
                        {
                            <span class="support-pill is-muted">مقروء</span>
                        }
                        else
                        {
                            <span class="support-pill is-alert">غير مقروء</span>
                        }
                    </header>
                    <p class="support-card__note">@item.Message</p>
                    <div class="support-card__actions">
                        <a asp-action="OpenNotification" asp-route-id="@item.Id" class="btn btn-primary">
                            <i class="fas fa-external-link-alt"></i>
                            الانتقال للعمل المطلوب
                        </a>
                    </div>
                </article>
            }
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/client-portal-support-cards.css" asp-append-version="true" />
}
