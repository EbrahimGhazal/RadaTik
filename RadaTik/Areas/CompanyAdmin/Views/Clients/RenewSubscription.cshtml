@{
    ViewData["Title"] = "تجديد الاشتراك";
    var clientId = ViewBag.ClientId;
    var clientName = ViewBag.ClientName;
    var currentExpirationDate = ViewBag.CurrentExpirationDate as DateTime?;
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>
            <i class="fas fa-sync-alt text-primary"></i>
            @ViewData["Title"]
        </h2>
        <a asp-action="Details" asp-route-id="@clientId" class="btn btn-secondary">
            <i class="fas fa-arrow-right"></i> العودة للتفاصيل
        </a>
    </div>

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-calendar-alt"></i> تجديد اشتراك العميل: @clientName
                    </h5>
                </div>
                <div class="card-body">
                    @if (currentExpirationDate.HasValue)
                    {
                        <div class="alert alert-info mb-4">
                            <strong>تاريخ انتهاء الصلاحية الحالي:</strong> @currentExpirationDate.Value.ToString("yyyy/MM/dd")
                        </div>
                    }

                    <form asp-action="RenewSubscription" method="post">
                        <input type="hidden" name="id" value="@clientId" />

                        <div class="mb-4">
                            <h5><i class="fas fa-calendar-check"></i> خيارات التجديد:</h5>
                        </div>

                        <!-- خيار 1: تجديد لمدة محددة بالأيام -->
                        <div class="card mb-3">
                            <div class="card-body">
                                <h6 class="card-title">
                                    <i class="fas fa-calendar-day"></i> تجديد لعدد أيام محدد
                                </h6>
                                <div class="row">
                                    <div class="col-md-8">
                                        <label for="renewDays" class="form-label">عدد الأيام للتجديد:</label>
                                        <input type="number" id="renewDays" name="renewDays" class="form-control" 
                                               min="1" max="365" placeholder="أدخل عدد الأيام (مثال: 30)">
                                        <small class="form-text text-muted">سيتم حساب تاريخ الانتهاء الجديد بناءً على اليوم الحالي</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- خيار 2: تجديد حتى تاريخ محدد -->
                        <div class="card mb-3">
                            <div class="card-body">
                                <h6 class="card-title">
                                    <i class="fas fa-calendar"></i> تجديد حتى تاريخ محدد
                                </h6>
                                <div class="row">
                                    <div class="col-md-8">
                                        <label for="expirationDate" class="form-label">تاريخ انتهاء الصلاحية الجديد:</label>
                                        <input type="date" id="expirationDate" name="expirationDate" class="form-control">
                                        <small class="form-text text-muted">اختر تاريخ انتهاء الصلاحية الجديد</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- خيار 3: تجديد حتى 8 من الشهر القادم -->
                        <div class="card mb-4" style="border: 2px solid #28a745;">
                            <div class="card-body">
                                <h6 class="card-title text-success">
                                    <i class="fas fa-calendar-week"></i> تجديد حتى تاريخ 8 من الشهر القادم
                                </h6>
                                <p class="text-muted">سيتم تمديد الاشتراك تلقائياً حتى تاريخ 8 من الشهر القادم</p>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="fas fa-sync-alt"></i> تجديد الاشتراك
                            </button>
                            <form asp-action="RenewTo8thNextMonth" method="post" class="d-inline">
                                <input type="hidden" name="id" value="@clientId" />
                                <button type="submit" class="btn btn-success btn-lg w-100" 
                                        onclick="return confirm('هل أنت متأكد من تجديد الاشتراك حتى تاريخ 8 من الشهر القادم؟')">
                                    <i class="fas fa-calendar-week"></i> تجديد حتى 8 من الشهر القادم
                                </button>
                            </form>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // التأكد من اختيار خيار واحد فقط
        document.getElementById('renewDays')?.addEventListener('input', function() {
            if (this.value) {
                document.getElementById('expirationDate').value = '';
            }
        });

        document.getElementById('expirationDate')?.addEventListener('input', function() {
            if (this.value) {
                document.getElementById('renewDays').value = '';
            }
        });
    </script>
}
