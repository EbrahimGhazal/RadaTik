@model IEnumerable<RadaTik.Models.Client>
@{
    ViewData["Title"] = "اشتراكات تنتهي خلال 3 أيام";
    var totalExpiring = ViewBag.TotalExpiring ?? 0;
    var expiringToday = ViewBag.ExpiringToday ?? 0;
    var expiringTomorrow = ViewBag.ExpiringTomorrow ?? 0;
    var expiringIn2Days = ViewBag.ExpiringIn2Days ?? 0;
    var expiringIn3Days = ViewBag.ExpiringIn3Days ?? 0;
    ViewBag.PageHeroIcon = "fas fa-clock";
    ViewBag.PageHeroTheme = "warning";
    ViewBag.PageHeroBackUrl = Url.Action("Index");
    ViewBag.PageHeroBackText = "العودة";
    ViewBag.PageHeroExtraActions = new[]
    {
        new RadaTik.ViewModels.UI.PageHeroActionViewModel { Text = "المنتهية", Url = Url.Action("ExpiredAccounts")!, CssClass = "btn btn-danger btn-sm", IconClass = "fas fa-exclamation-triangle" }
    };
}
<div class="radtk-page--companyadmin-views-clients-expiringin3days">

<partial name="_CrudPageHero" />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle alert-icon"></i>
        <div class="alert-content">@TempData["Success"]</div>
        <button class="alert-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle alert-icon"></i>
        <div class="alert-content">@TempData["Error"]</div>
        <button class="alert-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>
    </div>
}

<!-- Compact Statistics Bar -->
<div class="stats-bar">
    <div class="stat-item stat-warning">
        <div class="stat-icon-mini"><i class="fas fa-hourglass-half"></i></div>
        <div class="stat-data">
            <span class="stat-number">@totalExpiring</span>
            <span class="stat-label">إجمالي</span>
        </div>
    </div>
    
    <div class="stat-divider"></div>
    
    <div class="stat-item stat-danger">
        <div class="stat-icon-mini"><i class="fas fa-fire"></i></div>
        <div class="stat-data">
            <span class="stat-number">@expiringToday</span>
            <span class="stat-label">اليوم!</span>
        </div>
    </div>
    
    <div class="stat-item stat-orange">
        <div class="stat-icon-mini"><i class="fas fa-calendar-day"></i></div>
        <div class="stat-data">
            <span class="stat-number">@expiringTomorrow</span>
            <span class="stat-label">غداً</span>
        </div>
    </div>
    
    <div class="stat-item stat-yellow">
        <div class="stat-icon-mini"><i class="fas fa-calendar-week"></i></div>
        <div class="stat-data">
            <span class="stat-number">@expiringIn2Days</span>
            <span class="stat-label">بعد يومين</span>
        </div>
    </div>
    
    <div class="stat-item stat-info">
        <div class="stat-icon-mini"><i class="fas fa-calendar-alt"></i></div>
        <div class="stat-data">
            <span class="stat-number">@expiringIn3Days</span>
            <span class="stat-label">بعد 3 أيام</span>
        </div>
    </div>
</div>

<!-- Expiring Accounts Table -->
<div class="card">
    <div class="card-header" style="background: linear-gradient(135deg, var(--warning) 0%, #F57C00 100%); color: white;">
        <h3 class="card-title" style="color: white;">
            <i class="fas fa-list"></i>
            اشتراكات تحتاج تجديد عاجل
        </h3>
    </div>
    <div class="card-body" style="padding: 0;">
        @if (Model.Any())
        {
            <div class="table-container">
                <table class="table table-sm table-hover radtk-data-table radtk-data-table--cards" id="expiringTable">
                    <thead>
                        <tr>
                            <th>العميل</th>
                            <th>اسم المستخدم</th>
                            <th>الهاتف</th>
                            <th>تاريخ الانتهاء</th>
                            <th>متبقي</th>
                            <th>الباقة</th>
                            <th>إجراءات التمديد</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var client in Model)
                        {
                            var daysRemaining = (client.AccountExpirationDate!.Value.Date - DateTime.Now.Date).Days;
                            var urgencyClass = daysRemaining <= 0 ? "urgency-critical" : 
                                              daysRemaining == 1 ? "urgency-high" : 
                                              daysRemaining == 2 ? "urgency-medium" : "urgency-low";
                            <tr class="@urgencyClass">
                                <td>
                                    <div class="client-info">
                                        <div class="client-avatar @(daysRemaining <= 0 ? "critical" : daysRemaining == 1 ? "high" : "warning")">
                                            @(client.Name?.Substring(0, 1).ToUpper() ?? "?")
                                        </div>
                                        <div>
                                            <div class="client-name">@client.Name</div>
                                            @if (!string.IsNullOrEmpty(client.SID))
                                            {
                                                <div class="client-sid">#@client.SID</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td><code>@client.UserName</code></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(client.PhoneNumber))
                                    {
                                        <a href="tel:@client.PhoneNumber" class="phone-link">
                                            <i class="fas fa-phone"></i> @client.PhoneNumber
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(daysRemaining <= 0 ? "badge-danger" : "badge-warning")">
                                        @client.AccountExpirationDate.Value.ToString("yyyy/MM/dd")
                                    </span>
                                </td>
                                <td>
                                    @if (daysRemaining <= 0)
                                    {
                                        <span class="days-badge days-critical">
                                            <i class="fas fa-fire"></i> اليوم!
                                        </span>
                                    }
                                    else if (daysRemaining == 1)
                                    {
                                        <span class="days-badge days-high">
                                            <i class="fas fa-exclamation"></i> غداً
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="days-badge days-medium">
                                            <i class="fas fa-clock"></i> @daysRemaining أيام
                                        </span>
                                    }
                                </td>
                                <td>
                                    @if (client.Profile != null)
                                    {
                                        <span class="badge badge-info">@client.Profile.Name</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <div class="action-buttons">
                                        <a asp-action="Details" asp-route-id="@client.Id" class="btn btn-sm btn-icon btn-info" title="تفاصيل">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        @if (User.IsInRole("SystemAdministrator"))
                                        {
                                            <form asp-action="QuickExtend" method="post" style="display: inline;">
                                                <input type="hidden" name="id" value="@client.Id" />
                                                <input type="hidden" name="days" value="3" />
                                                <button type="submit" class="btn btn-sm btn-warning" title="تمديد 3 أيام"
                                                        onclick="return confirm('تمديد 3 أيام للعميل @client.Name؟')">
                                                    <i class="fas fa-plus"></i> 3 أيام
                                                </button>
                                            </form>
                                            <form asp-action="RenewTo8thNextMonth" method="post" style="display: inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@client.Id" />
                                                <button type="submit" class="btn btn-sm btn-success" title="تمديد لـ 8 الشهر القادم"
                                                        onclick="return confirm('تمديد للعميل @client.Name حتى 8 الشهر القادم؟')">
                                                    <i class="fas fa-calendar-check"></i> 8 الشهر
                                                </button>
                                            </form>
                                            <a asp-action="RenewSubscription" asp-route-id="@client.Id" class="btn btn-sm btn-primary" title="تجديد مخصص">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon text-success">
                    <i class="fas fa-check-circle"></i>
                </div>
                <h3>لا توجد اشتراكات تنتهي قريباً</h3>
                <p class="text-muted">جميع الاشتراكات لديها أكثر من 3 أيام متبقية</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#expiringTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/ar.json'
                },
                order: [[4, 'asc']],
                pageLength: 25
            });
        });
    </script>
}
