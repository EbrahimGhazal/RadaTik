@model List<RadaTik.Models.MikroTikServer>
@{
    ViewData["Title"] = "استيراد المشتركين من سيرفر";
    ViewBag.PageHeroIcon = "fas fa-download";
    ViewBag.PageHeroSubtitle = "استورد العملاء الجدد أو أعد مزامنة التعديلات الطارئة التي تمت مباشرةً على السيرفر إلى قاعدة البيانات.";
    ViewBag.PageHeroBackUrl = Url.Action("Index", "Clients");
    ViewBag.PageHeroBackText = "قائمة العملاء";
    var importPreviewByServer = ViewBag.ImportPreviewByServer as Dictionary<int, RadaTik.Services.ImportUsersPreviewResult>;
    var importChargeByServer = ViewBag.ImportChargeByServer as Dictionary<int, RadaTik.Services.UsageImportChargeEstimate>;
    var clientImportUnitPrice = (decimal?)(ViewBag.ClientImportUnitPrice) ?? 0m;

    int totalImportable = 0;
    int totalUsers = 0;
    decimal totalCharge = 0m;
    decimal walletBalance = 0m;
    if (Model.Any() && importPreviewByServer != null && importChargeByServer != null)
    {
        foreach (var server in Model)
        {
            if (importPreviewByServer.TryGetValue(server.Id, out var p))
            {
                totalUsers += p.TotalUsersOnServer;
                if (!p.HasConnectionError)
                {
                    totalImportable += p.ImportableUsersCount;
                }
            }
            if (importChargeByServer.TryGetValue(server.Id, out var c))
            {
                walletBalance = c.WalletBalance;
                if (importPreviewByServer.TryGetValue(server.Id, out var p2) && !p2.HasConnectionError && p2.ImportableUsersCount > 0)
                {
                    totalCharge += c.RequiredAmountSyp;
                }
            }
        }
    }
}
<div class="radtk-page-clients-import">

<partial name="_CrudPageHero" />

@Html.AntiForgeryToken()

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">
        <i class="fas fa-exclamation-triangle"></i> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="card border-0 shadow-sm mb-3 border-start border-4 border-primary">
    <div class="card-body py-2">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="rounded-circle bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center" style="width:34px;height:34px;">
                    <i class="fas fa-users"></i>
                </span>
                <div>
                    <div class="small text-muted mb-1">التسعير الفعّال قبل اختيار السيرفر</div>
                    <div class="fw-semibold">سعر الوحدة المعتمد لاستيراد كل عميل</div>
                </div>
            </div>
            <div class="fw-bold text-primary">@SyrianCurrencyHelper.FormatNew(clientImportUnitPrice) ل.س.ج</div>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle"></i>
        لا يوجد خوادم MikroTik في الشبكة الحالية. أضف خادماً من قسم <a asp-route="networkManager-mikrotikservers" asp-route-action="Index" asp-route-id="">خوادم MikroTik</a> أولاً.
    </div>
}
else
{
    <div class="card mb-3">
        <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span><i class="fas fa-server"></i> اختر السيرفر لمزامنة العملاء الجدد والتعديلات، أو استخدم «مزامنة الكل»</span>
            <button type="button"
                    id="btnImportAllClients"
                    class="btn btn-dark btn-sm"
                    @(totalImportable <= 0 && !Model.Any(s =>
                        importPreviewByServer != null &&
                        importPreviewByServer.TryGetValue(s.Id, out var p) &&
                        p.UpdatableUsersCount > 0) ? "disabled" : null)
                    data-total-users="@totalUsers"
                    data-importable-users="@totalImportable"
                    data-unit-price="@clientImportUnitPrice.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                    data-total-charge="@totalCharge.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                    data-wallet-balance="@walletBalance.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)">
                <i class="fas fa-sync-alt"></i> مزامنة الكل
            </button>
        </div>
        <div class="card-body">
            <div class="small text-muted mb-3" id="clientsImportSummaryHint">
                الخوادم: <strong>@Model.Count</strong> |
                العملاء على السيرفرات: <strong>@totalUsers</strong> |
                القابلون للاستيراد: <strong>@totalImportable</strong> |
                التعديلات القابلة للمزامنة: <strong>@Model.Sum(s => importPreviewByServer != null && importPreviewByServer.TryGetValue(s.Id, out var p) ? p.UpdatableUsersCount : 0)</strong> |
                التكلفة الكلية المتوقعة: <strong>@SyrianCurrencyHelper.FormatNew(totalCharge)</strong> ل.س.ج
            </div>
            <div class="list-group list-group-flush">
                @foreach (var server in Model)
                {
                    RadaTik.Services.ImportUsersPreviewResult preview;
                    if (importPreviewByServer != null && importPreviewByServer.TryGetValue(server.Id, out var previewItem))
                    {
                        preview = previewItem;
                    }
                    else
                    {
                        preview = new RadaTik.Services.ImportUsersPreviewResult();
                    }

                    RadaTik.Services.UsageImportChargeEstimate charge;
                    if (importChargeByServer != null && importChargeByServer.TryGetValue(server.Id, out var chargeItem))
                    {
                        charge = chargeItem;
                    }
                    else
                    {
                        charge = new RadaTik.Services.UsageImportChargeEstimate();
                    }
                    var canImport = !preview.HasConnectionError
                        && (preview.ImportableUsersCount > 0 ||
                            preview.RelinkableUsersCount > 0 ||
                            preview.UpdatableUsersCount > 0);
                    <div class="list-group-item d-flex justify-content-between align-items-center flex-wrap gap-2"
                         data-server-row
                         data-server-id="@server.Id"
                         data-server-name="@server.Name"
                         data-total-users="@preview.TotalUsersOnServer"
                         data-importable-users="@preview.ImportableUsersCount"
                         data-unit-price="@charge.UnitPriceSyp.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                         data-total-charge="@charge.RequiredAmountSyp.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                         data-wallet-balance="@charge.WalletBalance.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                         data-can-import="@(canImport ? "1" : "0")">
                        <div>
                            <strong>@server.Name</strong>
                            <span class="text-muted small">(@server.Host:@server.Port)</span>
                            <div class="small text-muted mt-1">
                                على السيرفر: <strong>@preview.TotalUsersOnServer</strong> |
                                قابل للاستيراد: <strong>@preview.ImportableUsersCount</strong> |
                                موجود مسبقاً: <strong>@preview.ExistingUsersCount</strong>
                                @if (preview.UpdatableUsersCount > 0)
                                {
                                    <span class="text-primary">| تعديلات ستُزامن: <strong>@preview.UpdatableUsersCount</strong></span>
                                }
                                @if (preview.RelinkableUsersCount > 0)
                                {
                                    <span class="text-info">| سيُربط بالسيرفر: <strong>@preview.RelinkableUsersCount</strong></span>
                                }
                                @if (preview.DuplicateUsersCount > 0)
                                {
                                    <span class="text-warning">| مكرر عبر السيرفرات: <strong>@preview.DuplicateUsersCount</strong></span>
                                }
                                @if (preview.MissingProfileCount > 0)
                                {
                                    <span class="text-secondary">| بروفايل سيُنشأ تلقائياً: <strong>@preview.MissingProfileCount</strong></span>
                                }
                                |
                                سعر كل عميل: <strong>@SyrianCurrencyHelper.FormatNew(charge.UnitPriceSyp)</strong> ل.س.ج |
                                الإجمالي المتوقع: <strong>@SyrianCurrencyHelper.FormatNew(charge.RequiredAmountSyp)</strong> ل.س.ج |
                                الرصيد الحالي: <strong>@SyrianCurrencyHelper.FormatNew(charge.WalletBalance)</strong> ل.س.ج
                            </div>
                            @if (preview.HasConnectionError && !string.IsNullOrWhiteSpace(preview.PreviewNote))
                            {
                                <div class="alert alert-danger py-2 px-3 mt-2 mb-0 small">
                                    <i class="fas fa-exclamation-triangle"></i> @preview.PreviewNote
                                    <div class="mt-1">
                                        <a asp-route="networkManager-mikrotikservers" asp-route-action="Edit" asp-route-id="@server.Id" class="alert-link">
                                            تعديل بيانات الاتصال للسيرفر
                                        </a>
                                    </div>
                                </div>
                            }
                            else if (!preview.HasConnectionError && !string.IsNullOrWhiteSpace(preview.PreviewNote))
                            {
                                <div class="alert alert-info py-2 px-3 mt-2 mb-0 small">
                                    <i class="fas fa-info-circle"></i> @preview.PreviewNote
                                </div>
                            }
                        </div>
                        <button type="button"
                                class="btn btn-warning btn-sm btn-import-one-server"
                                @(canImport ? null : "disabled")>
                            <i class="fas fa-sync-alt"></i> مزامنة هذا السيرفر
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-right"></i> العودة لقائمة المشتركين
    </a>
</div>

<!-- Import progress overlay (same UX as Profile) -->
<div id="profileImportProgressOverlay" class="profile-import-overlay" hidden aria-live="polite">
    <div class="profile-import-dialog" role="dialog" aria-modal="true" aria-labelledby="profileImportProgressTitle">
        <div class="profile-import-dialog__icon">
            <i class="fas fa-cloud-download-alt fa-spin"></i>
        </div>
        <h5 id="profileImportProgressTitle" class="profile-import-dialog__title">جاري استيراد المشتركين من MikroTik</h5>
        <p id="profileImportProgressStatus" class="profile-import-dialog__status">تحضير العملية...</p>
        <div class="profile-import-progress">
            <div id="profileImportProgressBar" class="profile-import-progress__bar" style="width: 0%"></div>
        </div>
        <div class="profile-import-meta">
            <span id="profileImportProgressPercent">0%</span>
            <span id="profileImportProgressCountdown">الوقت المتبقي: --</span>
        </div>
        <ul id="profileImportProgressLog" class="profile-import-log"></ul>
    </div>
</div>

</div>

@section Scripts {
    <script>
        const clientsImportJsonUrl = '@Url.Action("ImportFromServerJson", "Clients")';
        const clientsIndexUrl = '@Url.Action("Index", "Clients")';

        function getAntiForgeryToken() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        function money(n) {
            return Number(n || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        function getImportableServers() {
            return Array.from(document.querySelectorAll('[data-server-row][data-can-import="1"]')).map(function (el) {
                return {
                    id: el.getAttribute('data-server-id'),
                    name: el.getAttribute('data-server-name') || 'غير معروف',
                    totalUsers: Number(el.getAttribute('data-total-users') || 0),
                    importableUsers: Number(el.getAttribute('data-importable-users') || 0),
                    unitPrice: Number(el.getAttribute('data-unit-price') || 0),
                    totalCharge: Number(el.getAttribute('data-total-charge') || 0),
                    walletBalance: Number(el.getAttribute('data-wallet-balance') || 0)
                };
            });
        }

        function confirmImportMessage(servers) {
            const importableUsers = servers.reduce(function (s, x) { return s + x.importableUsers; }, 0);
            const totalUsers = servers.reduce(function (s, x) { return s + x.totalUsers; }, 0);
            const totalCharge = servers.reduce(function (s, x) { return s + x.totalCharge; }, 0);
            const unitPrice = servers[0] ? servers[0].unitPrice : 0;
            const walletBalance = servers[0] ? servers[0].walletBalance : 0;
            const names = servers.map(function (x) { return x.name; }).join('، ');

            return (
                `تنبيه واضح قبل الاستيراد:\n\n` +
                `عدد الخوادم: ${servers.length}\n` +
                `الخوادم: ${names}\n` +
                `عدد العملاء على السيرفرات: ${totalUsers}\n` +
                `العملاء القابلون للاستيراد: ${importableUsers}\n` +
                `سعر استيراد كل عميل: ${money(unitPrice)} ل.س.ج\n` +
                `إجمالي مبلغ الاستيراد: ${money(totalCharge)} ل.س.ج\n` +
                `رصيد المحفظة الحالي: ${money(walletBalance)} ل.س.ج\n\n` +
                `سيتم التحقق من الرصيد قبل التنفيذ الفعلي، وفي حال عدم الكفاية سيتم إلغاء العملية مع توضيح السبب.\n\n` +
                `هل تريد المتابعة؟`
            );
        }

        function estimateImportSeconds(servers) {
            const importable = servers.reduce(function (s, x) { return s + Number(x.importableUsers || 0); }, 0);
            const seconds = (servers.length * 12) + (importable * 0.25);
            return Math.max(10, Math.round(seconds));
        }

        function formatCountdown(totalSeconds) {
            const s = Math.max(0, Math.floor(totalSeconds));
            const m = Math.floor(s / 60);
            const r = s % 60;
            if (m > 0) {
                return `${m}:${String(r).padStart(2, '0')}`;
            }
            return `${r} ث`;
        }

        function setImportProgressUi(percent, statusText, remainingSeconds) {
            const bar = document.getElementById('profileImportProgressBar');
            const pct = document.getElementById('profileImportProgressPercent');
            const status = document.getElementById('profileImportProgressStatus');
            const countdown = document.getElementById('profileImportProgressCountdown');
            const safePercent = Math.max(0, Math.min(100, Math.round(percent)));
            if (bar) bar.style.width = safePercent + '%';
            if (pct) pct.textContent = safePercent + '%';
            if (status && statusText) status.textContent = statusText;
            if (countdown && typeof remainingSeconds === 'number') {
                countdown.textContent = 'الوقت المتبقي التقريبي: ' + formatCountdown(remainingSeconds);
            }
        }

        function appendImportLog(text, kind) {
            const log = document.getElementById('profileImportProgressLog');
            if (!log) return;
            const li = document.createElement('li');
            li.className = 'profile-import-log__item' + (kind ? ' profile-import-log__item--' + kind : '');
            li.textContent = text;
            log.appendChild(li);
            log.scrollTop = log.scrollHeight;
        }

        function showImportProgressOverlay(show) {
            const overlay = document.getElementById('profileImportProgressOverlay');
            if (!overlay) return;
            overlay.hidden = !show;
            document.body.classList.toggle('profile-import-busy', show);
        }

        async function importOneServer(server) {
            const token = getAntiForgeryToken();
            const body = new URLSearchParams();
            body.set('serverId', server.id);
            body.set('__RequestVerificationToken', token);

            const response = await fetch(clientsImportJsonUrl, {
                method: 'POST',
                credentials: 'same-origin',
                headers: {
                    'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                    'X-CSRF-TOKEN': token,
                    'X-Requested-With': 'XMLHttpRequest',
                    'Accept': 'application/json'
                },
                body: body.toString()
            });

            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }

            return await response.json();
        }

        async function runClientsImportWithProgress(servers) {
            const total = servers.length;
            let remainingEstimate = estimateImportSeconds(servers);
            const initialEstimate = remainingEstimate;
            let countdownTimer = null;
            const startedAt = Date.now();
            const successLines = [];
            const infoLines = [];
            const errorLines = [];

            showImportProgressOverlay(true);
            const log = document.getElementById('profileImportProgressLog');
            if (log) log.innerHTML = '';
            setImportProgressUi(2, 'بدء جلب البيانات من MikroTik...', remainingEstimate);
            appendImportLog(`التقدير الأولي للمدة: حوالي ${formatCountdown(initialEstimate)} لـ ${total} خادم(ات).`, 'info');

            countdownTimer = setInterval(function () {
                remainingEstimate = Math.max(0, remainingEstimate - 1);
                const elapsedRatio = Math.min(0.92, (Date.now() - startedAt) / (initialEstimate * 1000));
                const softPercent = Math.max(2, Math.floor(elapsedRatio * 90));
                const bar = document.getElementById('profileImportProgressBar');
                const current = bar ? parseInt(bar.style.width, 10) || 0 : 0;
                if (softPercent > current && softPercent < 95) {
                    setImportProgressUi(softPercent, null, remainingEstimate);
                } else {
                    const countdown = document.getElementById('profileImportProgressCountdown');
                    if (countdown) countdown.textContent = 'الوقت المتبقي التقريبي: ' + formatCountdown(remainingEstimate);
                }
            }, 1000);

            try {
                for (let i = 0; i < servers.length; i++) {
                    const server = servers[i];
                    const stepBase = (i / total) * 100;
                    setImportProgressUi(Math.max(stepBase, 5), `جاري الاستيراد من: ${server.name} (${i + 1}/${total})...`, remainingEstimate);
                    appendImportLog(`بدء الاستيراد من «${server.name}»...`, 'info');

                    try {
                        const result = await importOneServer(server);
                        const leftServers = total - (i + 1);
                        const avgSoFar = ((Date.now() - startedAt) / 1000) / (i + 1);
                        remainingEstimate = Math.max(0, Math.round(avgSoFar * leftServers));

                        const line = `${server.name}: ${result.message || (result.success ? 'تم' : 'فشل')}`;
                        if (result.success) {
                            successLines.push(line);
                            appendImportLog(line, 'ok');
                            if (Number(result.duplicateCount || 0) > 0) {
                                appendImportLog(`${server.name}: تم تعليم ${result.duplicateCount} حساب كمكرر عبر السيرفرات.`, 'info');
                            }
                            if (result.warnings) {
                                appendImportLog(`${server.name}: ${result.warnings}`, 'info');
                            }
                        } else {
                            errorLines.push(line);
                            appendImportLog(line, 'err');
                        }
                    } catch (err) {
                        const line = `${server.name}: تعذر الاتصال أثناء الاستيراد`;
                        errorLines.push(line);
                        appendImportLog(line, 'err');
                        const leftServers = total - (i + 1);
                        remainingEstimate = Math.max(0, Math.round(remainingEstimate * (leftServers / Math.max(1, total - i))));
                    }

                    setImportProgressUi(((i + 1) / total) * 100, `اكتمل ${i + 1} من ${total}`, remainingEstimate);
                }

                setImportProgressUi(100, 'اكتمل الاستيراد', 0);
                appendImportLog('انتهت عملية الاستيراد.', successLines.length ? 'ok' : 'info');
                await new Promise(function (resolve) { setTimeout(resolve, 900); });

                let summary = '';
                if (successLines.length) summary += 'نجاح:\n' + successLines.join('\n') + '\n\n';
                if (infoLines.length) summary += 'ملاحظات:\n' + infoLines.join('\n') + '\n\n';
                if (errorLines.length) summary += 'أخطاء:\n' + errorLines.join('\n');
                if (summary.trim()) {
                    alert(summary.trim());
                }
                window.location.href = clientsIndexUrl;
            } finally {
                if (countdownTimer) clearInterval(countdownTimer);
            }
        }

        document.addEventListener('click', function (e) {
            const oneBtn = e.target.closest('.btn-import-one-server');
            if (oneBtn) {
                e.preventDefault();
                const row = oneBtn.closest('[data-server-row]');
                if (!row || row.getAttribute('data-can-import') !== '1') return;
                const servers = [{
                    id: row.getAttribute('data-server-id'),
                    name: row.getAttribute('data-server-name') || 'غير معروف',
                    totalUsers: Number(row.getAttribute('data-total-users') || 0),
                    importableUsers: Number(row.getAttribute('data-importable-users') || 0),
                    unitPrice: Number(row.getAttribute('data-unit-price') || 0),
                    totalCharge: Number(row.getAttribute('data-total-charge') || 0),
                    walletBalance: Number(row.getAttribute('data-wallet-balance') || 0)
                }];
                if (!window.confirm(confirmImportMessage(servers))) return;
                runClientsImportWithProgress(servers);
                return;
            }
        });

        const importAllBtn = document.getElementById('btnImportAllClients');
        if (importAllBtn) {
            importAllBtn.addEventListener('click', function () {
                const servers = getImportableServers();
                if (!servers.length) {
                    alert('لا توجد إضافات أو تعديلات من السيرفرات لمزامنتها حالياً.');
                    return;
                }
                if (!window.confirm(confirmImportMessage(servers))) return;
                runClientsImportWithProgress(servers);
            });
        }
    </script>
}
