                        + ' | موجود مسبقاً: ' + (result.skippedExistingCount || 0)
                        + ' | حُذف من القديم: ' + (result.removedFromOldCount || 0)
                        + ' | حُدّث في القاعدة: ' + (result.reassignedCount || 0)
                        + ' | نُسخ في القاعدة: ' + (result.clonedCount || 0)
                        + ' | فشل: ' + (result.failedCount || 0),
                        'info');
                }
                if (Array.isArray(result.errors)) {
                    result.errors.slice(0, 15).forEach(function (err) {
                        appendImportLog(err, 'err');
