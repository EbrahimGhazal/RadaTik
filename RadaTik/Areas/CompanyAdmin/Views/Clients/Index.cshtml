                }
            });

            const openBtn = document.getElementById('btnOpenBulkExpiration');
            const confirmBtn = document.getElementById('btnConfirmBulkExpiration');
            const modalEl = document.getElementById('bulkExpirationModal');

            if (openBtn && modalEl && typeof bootstrap !== 'undefined') {
                openBtn.addEventListener('click', function () {
                    updateBulkSelectedHint();
                    const dateInput = document.getElementById('bulkExpirationDate');
                    if (dateInput && !dateInput.value) {
                        const d = new Date();
                        d.setMonth(d.getMonth() + 1);
                        dateInput.value = d.toISOString().slice(0, 10);
                    }
                    bootstrap.Modal.getOrCreateInstance(modalEl).show();
                });
            }

            if (confirmBtn) {
                confirmBtn.addEventListener('click', function () {
                    const dateInput = document.getElementById('bulkExpirationDate');
                    const expirationDate = dateInput ? dateInput.value : '';
                    if (!expirationDate) {
                        alert('الرجاء اختيار تاريخ انتهاء الصلاحية.');
                        return;
                    }

                    const scope = (document.querySelector('input[name="bulkExpirationScope"]:checked') || {}).value || 'selected';
                    const clients = scope === 'all' ? getAllClientRows() : getSelectedClientRows();
                    if (!clients.length) {
                        alert(scope === 'all'
                            ? 'لا يوجد مشتركين لتحديثهم.'
                            : 'الرجاء تحديد مشترك واحد على الأقل، أو اختر «جميع المشتركين».');
                        return;
                    }

                    const scopeLabel = scope === 'all' ? 'جميع المشتركين' : ('المحددين (' + clients.length + ')');
                    if (!confirm('سيتم تعيين تاريخ الانتهاء إلى ' + expirationDate + ' لـ ' + scopeLabel + '.\nهل تريد المتابعة؟')) {
                        return;
                    }

                    if (modalEl && typeof bootstrap !== 'undefined') {
                        bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                    }
                    runBulkExpirationUpdate(clients, expirationDate, scope === 'all');
                });
            }

            const openTopUpBtn = document.getElementById('btnOpenBulkTopUp');
            const confirmTopUpBtn = document.getElementById('btnConfirmBulkTopUp');
            const topUpModalEl = document.getElementById('bulkTopUpModal');

            const openInfoImportBtn = document.getElementById('btnOpenClientInfoImport');
            const infoImportModalEl = document.getElementById('clientInfoImportModal');
            if (openInfoImportBtn && infoImportModalEl && typeof bootstrap !== 'undefined') {
                openInfoImportBtn.addEventListener('click', function () {
                    bootstrap.Modal.getOrCreateInstance(infoImportModalEl).show();
                });
            }

            if (openTopUpBtn && topUpModalEl && typeof bootstrap !== 'undefined') {
                openTopUpBtn.addEventListener('click', function () {
                    updateBulkSelectedHint();
                    syncBulkTopUpValueLabel();
                    bootstrap.Modal.getOrCreateInstance(topUpModalEl).show();
                });
            }

            document.querySelectorAll('input[name="bulkTopUpMode"], input[name="bulkTopUpScope"]').forEach(function (el) {
                el.addEventListener('change', function () {
                    syncBulkTopUpValueLabel();
                });
            });
            const topUpValueInput = document.getElementById('bulkTopUpValue');
            if (topUpValueInput) {
                topUpValueInput.addEventListener('input', updateBulkTopUpEstimate);
            }

            if (confirmTopUpBtn) {
                confirmTopUpBtn.addEventListener('click', function () {
                    const mode = (document.querySelector('input[name="bulkTopUpMode"]:checked') || {}).value || 'fixed';
                    const scope = (document.querySelector('input[name="bulkTopUpScope"]:checked') || {}).value || 'selected';
                    const valueInput = document.getElementById('bulkTopUpValue');
                    const value = valueInput ? Number(valueInput.value) : 0;
                    const notesInput = document.getElementById('bulkTopUpNotes');
                    const notes = notesInput ? (notesInput.value || '').trim() : '';

                    if (!value || value <= 0) {
                        alert(mode === 'percent' ? 'الرجاء إدخال نسبة صحيحة.' : 'الرجاء إدخال مبلغ صحيح.');
                        return;
                    }
                    if (mode === 'percent' && value > 100) {
                        alert('النسبة المئوية يجب ألا تتجاوز 100.');
                        return;
                    }

                    const clients = scope === 'all' ? getAllClientRows() : getSelectedClientRows();
                    if (!clients.length) {
                        alert(scope === 'all'
                            ? 'لا يوجد مشتركين لشحنهم.'
                            : 'الرجاء تحديد مشترك واحد على الأقل، أو اختر «جميع المشتركين».');
                        return;
                    }

                    const scopeLabel = scope === 'all' ? 'جميع المشتركين' : ('المحددين (' + clients.length + ')');
                    const modeLabel = mode === 'percent' ? ('نسبة ' + value + '% من سعر الباقة') : ('مبلغ ثابت ' + value + ' ل.س');
                    if (!confirm('سيتم شحن رصيد ' + scopeLabel + ' بـ ' + modeLabel + '.\nيُخصم الإجمالي من محفظة الشبكة وفق القواعد المالية.\nهل تريد المتابعة؟')) {
                        return;
                    }

                    if (topUpModalEl && typeof bootstrap !== 'undefined') {
                        bootstrap.Modal.getOrCreateInstance(topUpModalEl).hide();
                    }
                    runBulkTopUp(clients, mode, value, scope === 'all', notes);
                });
            }

            const openCopyBtn = document.getElementById('btnOpenCopyToTower');
            const openDuplicateBtn = document.getElementById('btnOpenDuplicateToTower');
            const confirmCopyBtn = document.getElementById('btnConfirmCopyToTower');
            const copyModalEl = document.getElementById('copyToTowerModal');

            function applyCopyToTowerMode(mode) {
                const isCopy = mode === 'copy';
                if (copyModalEl) copyModalEl.setAttribute('data-mode', isCopy ? 'copy' : 'move');
                const titleText = document.getElementById('copyToTowerModalTitleText');
                const help = document.getElementById('copyToTowerModalHelp');
                const warning = document.getElementById('copyToTowerModeWarning');
                const confirmText = document.getElementById('btnConfirmCopyToTowerText');
                const confirmIcon = document.getElementById('btnConfirmCopyToTowerIcon');
                if (titleText) titleText.textContent = isCopy ? 'نسخ الحسابات إلى برج جديد' : 'نقل الحسابات إلى برج جديد';
                if (help) {
                    help.textContent = isCopy
                        ? 'تُقرأ بيانات الحسابات من قاعدة البيانات وتُضاف إلى البرج الجديد، مع الإبقاء على المشتركين في البرج القديم دون حذف. يجب أن يكون البروفايل منشوراً على البرج الجديد مسبقاً.'
                        : 'تُقرأ بيانات الحسابات من قاعدة البيانات وتُضاف إلى البرج الجديد، ثم يُحدَّث سيرفر المشترك في قاعدة البيانات، ويُحذف الحساب من البرج القديم إن وُجد. يجب أن يكون البروفايل منشوراً على البرج الجديد مسبقاً.';
                }
                if (warning) {
                    warning.className = isCopy ? 'alert alert-info small mb-0' : 'alert alert-warning small mb-0';
                    warning.innerHTML = isCopy
                        ? '<i class="fas fa-copy"></i> هذا نسخ وليس نقلاً: الحساب يُضاف إلى البرج الجديد ويبقى المشترك في البرج القديم.'
                        : '<i class="fas fa-exclamation-triangle"></i> هذا نقل وليس نسخاً: الحساب ينتقل إلى البرج الجديد ويُحذف من القديم.';
                }
                if (confirmText) confirmText.textContent = isCopy ? 'نسخ إلى البرج' : 'نقل إلى البرج';
                if (confirmIcon) confirmIcon.className = isCopy ? 'fas fa-copy' : 'fas fa-exchange-alt';
                if (confirmCopyBtn) {
                    confirmCopyBtn.className = isCopy ? 'btn btn-primary' : 'btn btn-info text-white';
                }
            }

            function openCopyToTowerModal(mode) {
                applyCopyToTowerMode(mode);
                updateBulkSelectedHint();
                if (copyModalEl && typeof bootstrap !== 'undefined') {
                    bootstrap.Modal.getOrCreateInstance(copyModalEl).show();
                }
            }

            if (openCopyBtn) {
                openCopyBtn.addEventListener('click', function () { openCopyToTowerModal('move'); });
            }
            if (openDuplicateBtn) {
                openDuplicateBtn.addEventListener('click', function () { openCopyToTowerModal('copy'); });
            }
            if (confirmCopyBtn) {
                confirmCopyBtn.addEventListener('click', function () {
                    const isCopy = copyModalEl && copyModalEl.getAttribute('data-mode') === 'copy';
                    const serverSelect = document.getElementById('copyToTowerServerId');
                    const serverId = serverSelect ? Number(serverSelect.value) : 0;
                    const serverLabel = serverSelect && serverSelect.selectedIndex >= 0
                        ? (serverSelect.options[serverSelect.selectedIndex].text || '')
                        : '';
                    if (!serverId) {
                        alert('الرجاء اختيار البرج / السيرفر.');
                        return;
                    }

                    const scope = (document.querySelector('input[name="copyToTowerScope"]:checked') || {}).value || 'selected';
                    const clients = scope === 'all' ? getAllClientRows() : getSelectedClientRows();
                    if (!clients.length) {
                        alert(scope === 'all'
                            ? (isCopy ? 'لا يوجد مشتركين لنسخ حساباتهم.' : 'لا يوجد مشتركين لنقل حساباتهم.')
                            : 'الرجاء تحديد مشترك واحد على الأقل، أو اختر «جميع المشتركين».');
                        return;
                    }

                    const scopeLabel = scope === 'all' ? 'جميع المشتركين' : ('المحددين (' + clients.length + ')');
                    const confirmText = isCopy
                        ? 'سيتم نسخ حسابات ' + scopeLabel + ' إلى «' + serverLabel + '».\nيبقى المشترك في البرج القديم ولا يُحذف.\nهل تريد المتابعة؟'
                        : 'سيتم نقل حسابات ' + scopeLabel + ' إلى «' + serverLabel + '».\nيُحدَّث السيرفر في قاعدة البيانات ويُحذف الحساب من البرج القديم.\nهل تريد المتابعة؟';
                    if (!confirm(confirmText)) {
                        return;
                    }

                    if (copyModalEl && typeof bootstrap !== 'undefined') {
                        bootstrap.Modal.getOrCreateInstance(copyModalEl).hide();
                    }
                    runCopyAccountsToTower(clients, serverId, serverLabel, scope === 'all', !isCopy);
                });
            }

            updateBulkSelectedHint();
        });
    </script>
}
