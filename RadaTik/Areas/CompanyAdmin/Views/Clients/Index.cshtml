<div class="radtk-page-clients-index">
@model IEnumerable<RadaTik.Models.Client>
@using RadaTik.Services.Clients

@{
    ViewData["Title"] = "قائمة العملاء";

    // حساب الإحصائيات
    var totalClients = Model.Count();
    var activeClients = Model.Count(c => c.IsActive);
    var inactiveClients = Model.Count(c => !c.IsActive);
    var duplicateClients = Model.Count(c => c.IsCrossServerDuplicate);
    var vipClients = Model.Count(c => c.IsVip);

    // حساب مجموع السرعات (بالميجابت) — تنزيل ورفع (الرفع الناقص = التنزيل)
    var totalDownloadSpeed = 0m;
    var totalUploadSpeed = 0m;
    var activeSpeed = 0m;
    var inactiveSpeed = 0m;
    var connectedDownloadSpeed = 0m;
    var connectedUploadSpeed = 0m;
    var disconnectedSpeed = 0m;

    var connectedClients = ViewBag.ConnectedClientIds as ISet<int> ?? new HashSet<int>();
    var connectionsReady = ViewBag.ConnectionsReady as bool? ?? false;

    foreach (var item in Model)
    {
        decimal downloadSpeed = 0;
        decimal uploadSpeed = 0;
        if (item.Profile != null)
        {
            downloadSpeed = item.Profile.DownloadSpeedMbps;
            uploadSpeed = item.Profile.EffectiveUploadSpeedMbps;
        }
        else if (!string.IsNullOrEmpty(item.ProfileName))
        {
            var numbers = System.Text.RegularExpressions.Regex.Match(item.ProfileName, @"\d+");
            if (numbers.Success && int.TryParse(numbers.Value, out var parsedSpeed))
            {
                downloadSpeed = parsedSpeed;
                uploadSpeed = parsedSpeed;
            }
        }

        if (downloadSpeed > 0 || uploadSpeed > 0)
        {
            totalDownloadSpeed += downloadSpeed;
            totalUploadSpeed += uploadSpeed;
            if (item.IsActive)
            {
                activeSpeed += downloadSpeed;
                if (connectedClients.Contains(item.Id))
                {
                    connectedDownloadSpeed += downloadSpeed;
                    connectedUploadSpeed += uploadSpeed;
                }
                else
                {
                    disconnectedSpeed += downloadSpeed;
                }
            }
            else
            {
                inactiveSpeed += downloadSpeed;
                if (connectedClients.Contains(item.Id))
                {
                    connectedDownloadSpeed += downloadSpeed;
                    connectedUploadSpeed += uploadSpeed;
                }
            }
        }
    }

    var disconnectedActiveClients = Model.Count(c => c.IsActive && !connectedClients.Contains(c.Id));
    var connectedActiveClients = Model.Count(c => connectedClients.Contains(c.Id));
    var averageDownloadSpeed = totalClients > 0 ? Math.Round((double)totalDownloadSpeed / totalClients, 1) : 0;
    var averageUploadSpeed = totalClients > 0 ? Math.Round((double)totalUploadSpeed / totalClients, 1) : 0;
    var activePercent = totalClients > 0 ? Math.Round((double)activeClients / totalClients * 100, 0) : 0;
    var connectedPercent = totalClients > 0 ? Math.Round((double)connectedActiveClients / totalClients * 100, 0) : 0;
    var dbAccountMap = ViewBag.DbAccountMap as IDictionary<int, string> ?? new Dictionary<int, string>();
    var pendingClientIds = ViewBag.PendingClientIds as ISet<int> ?? new HashSet<int>();
    var copyTargetServers = ViewBag.CopyTargetServers as IReadOnlyList<RadaTik.Services.Clients.ClientCopyTargetServerItem>
        ?? Array.Empty<RadaTik.Services.Clients.ClientCopyTargetServerItem>();
}

<!-- Page Header -->
<div class="operational-page clients-list-page">
    @{
        ViewBag.OperationalHeroIcon = "fas fa-users";
        ViewBag.OperationalHeroSubtitle = $"إجمالي {totalClients} مشترك — نشط {activeClients} — مكرر {duplicateClients} — VIP {vipClients}";
    }
    <partial name="_OperationalSysHero" />
    <div class="page-actions-toolbar clients-page-toolbar d-flex flex-wrap gap-2 mb-3 justify-content-end">
            @if (User.IsInRole("SystemAdministrator") || User.IsInRole("Employee"))
            {
                <a asp-action="ExpiringIn3Days" class="btn btn-sm" style="background: var(--warning); color: white;" title="تنتهي قريباً">
                    <i class="fas fa-clock"></i> <span class="clients-toolbar-label">تنتهي قريباً</span>
                </a>
                <a asp-action="ExpiredAccounts" class="btn btn-danger btn-sm" title="المنتهية">
                    <i class="fas fa-exclamation-triangle"></i> <span class="clients-toolbar-label">المنتهية</span>
                </a>
            }
            @if (User.IsInRole("SystemAdministrator"))
            {
                <a asp-action="CheckExpiredAccounts" class="btn btn-sm" style="background: var(--info); color: white;" title="فحص"
                   onclick="return confirm('هل تريد التحقق من الحسابات المنتهية؟')">
                    <i class="fas fa-sync-alt"></i> <span class="clients-toolbar-label">فحص</span>
                </a>
            }
            @if (User.IsInRole("NetworkAdministrator") || User.IsInRole("Employee"))
            {
                <a asp-action="ImportFromServer" class="btn btn-warning btn-sm" title="استيراد من سيرفر">
                    <i class="fas fa-download"></i> <span class="clients-toolbar-label">استيراد من سيرفر</span>
                </a>
            }
            @if (User.IsInRole("NetworkAdministrator") || User.IsInRole("CompanyEmployee") || User.IsInRole("Employee") || User.IsInRole("EmployeeLegacy"))
            {
                <button type="button" class="btn btn-outline-primary btn-sm" id="btnOpenClientInfoImport" title="تحديث بيانات المشتركين الموجودين في قاعدة البيانات من ملف — لا يُضاف مشتركون جدد">
                    <i class="fas fa-file-excel"></i> <span class="clients-toolbar-label">استيراد معلومات المشتركين من ملف</span>
                </button>
            }
            @if (User.IsInRole("NetworkAdministrator") ||
                 User.IsInRole("SystemAdministrator") ||
                 User.IsInRole("CompanyEmployee") ||
                 User.IsInRole("Employee") ||
                 User.IsInRole("EmployeeLegacy"))
            {
                <a asp-route="networkManager-new-subscriber-wizard" asp-route-action="Index" asp-route-id="" class="btn btn-success btn-sm" title="إضافة مشترك جديد">
                    <i class="fas fa-user-plus"></i> <span class="clients-toolbar-label">إضافة مشترك جديد</span>
                </a>
            }
    </div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle alert-icon"></i>
        <div class="alert-content">@TempData["Success"]</div>
        <button class="alert-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>
    </div>
}

@if (TempData["Info"] != null)
{
    <div class="alert alert-info">
        <i class="fas fa-info-circle alert-icon"></i>
        <div class="alert-content">@TempData["Info"]</div>
        <button class="alert-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-triangle alert-icon"></i>
        <div class="alert-content">@TempData["Error"]</div>
        <button class="alert-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>
    </div>
}

@if (TempData["ClientInfoImportDetails"] is string importDetails && !string.IsNullOrWhiteSpace(importDetails))
{
    <div class="alert alert-warning">
        <i class="fas fa-list alert-icon"></i>
        <div class="alert-content">
            <div class="fw-semibold mb-1">تفاصيل استيراد معلومات المشتركين من الملف:</div>
            <div class="small">@importDetails</div>
        </div>
        <button class="alert-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>
    </div>
}

@if (TempData["ImportFailedUsersDetails"] is string failedUsersJson && !string.IsNullOrWhiteSpace(failedUsersJson))
{
    var failedUsers = System.Text.Json.JsonSerializer.Deserialize<List<string>>(failedUsersJson) ?? new List<string>();
    if (failedUsers.Any())
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-circle alert-icon"></i>
            <div class="alert-content">
                <div class="fw-semibold mb-1">تعذر إنشاء حسابات لبعض المستخدمين:</div>
                <ul class="mb-0 ps-3">
                    @foreach (var item in failedUsers)
                    {
                        <li>@item</li>
                    }
                </ul>
            </div>
            <button class="alert-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>
        </div>
    }
}

<!-- Compact Statistics Bar -->
<div class="stats-bar">
    <button type="button" class="stat-item stat-primary is-filter active" data-filter="all" onclick="filterByStatus('all')" title="جميع الحسابات على جميع سيرفرات الشركة">
        <div class="stat-icon-mini"><i class="fas fa-users"></i></div>
        <div class="stat-data">
            <span class="stat-number">@totalClients</span>
            <span class="stat-label">الكل</span>
        </div>
    </button>
    
    <button type="button" class="stat-item stat-success is-filter" data-filter="active" onclick="filterByStatus('active')" title="المشتركون الذين حسابهم ليس معطّلاً">
        <div class="stat-icon-mini"><i class="fas fa-user-check"></i></div>
        <div class="stat-data">
            <span class="stat-number">@activeClients</span>
            <span class="stat-label">نشط (@activePercent%)</span>
        </div>
    </button>
    
    <button type="button" class="stat-item stat-info is-filter" data-filter="connected" onclick="filterByStatus('connected')" title="المشتركون الموجودون حالياً في PPP Active Connections على سيرفرات MikroTik">
        <div class="stat-icon-mini"><i class="fas fa-wifi"></i></div>
        <div class="stat-data">
            <span class="stat-number" id="statConnectedCount">@(connectionsReady ? connectedActiveClients.ToString() : "…")</span>
            <span class="stat-label">متصل <span id="statConnectedPercent">@(connectionsReady ? $"({connectedPercent}%)" : "")</span></span>
        </div>
    </button>
    
    <button type="button" class="stat-item stat-warning is-filter" data-filter="disconnected" onclick="filterByStatus('disconnected')" title="المشتركون غير المعطّلين وغير المتصلين حالياً بالإنترنت">
        <div class="stat-icon-mini"><i class="fas fa-user-clock"></i></div>
        <div class="stat-data">
            <span class="stat-number" id="statDisconnectedCount">@(connectionsReady ? disconnectedActiveClients.ToString() : "…")</span>
            <span class="stat-label">غير متصل</span>
        </div>
    </button>
    
    <button type="button" class="stat-item stat-danger is-filter" data-filter="inactive" onclick="filterByStatus('inactive')" title="المشتركون الذين حسابهم معطّل لأي سبب">
        <div class="stat-icon-mini"><i class="fas fa-user-times"></i></div>
        <div class="stat-data">
            <span class="stat-number">@inactiveClients</span>
            <span class="stat-label">معطل</span>
        </div>
    </button>

    <button type="button" class="stat-item stat-duplicate is-filter" data-filter="duplicate" onclick="filterByStatus('duplicate')" title="الحسابات المكررة عبر سيرفرات MikroTik ضمن الشبكة">
        <div class="stat-icon-mini"><i class="fas fa-clone"></i></div>
        <div class="stat-data">
            <span class="stat-number">@duplicateClients</span>
            <span class="stat-label">مكرر</span>
        </div>
    </button>

    <button type="button" class="stat-item stat-vip is-filter" data-filter="vip" onclick="filterByStatus('vip')" title="المشتركون المميزون (VIP)">
        <div class="stat-icon-mini"><i class="fas fa-crown"></i></div>
        <div class="stat-data">
            <span class="stat-number">@vipClients</span>
            <span class="stat-label">VIP</span>
        </div>
    </button>
    
    <div class="stat-divider"></div>
    
    <div class="stat-item stat-speed" title="مجموع سرعات التنزيل لجميع المشتركين">
        <div class="stat-icon-mini"><i class="fas fa-download"></i></div>
        <div class="stat-data">
            <span class="stat-number">@totalDownloadSpeed.ToString("0.##")</span>
            <span class="stat-label">Mbps تنزيل</span>
        </div>
    </div>

    <div class="stat-item stat-speed-upload" title="مجموع سرعات الرفع (إن لم تُحدد في البروفايل تُحسب = التنزيل)">
        <div class="stat-icon-mini"><i class="fas fa-upload"></i></div>
        <div class="stat-data">
            <span class="stat-number">@totalUploadSpeed.ToString("0.##")</span>
            <span class="stat-label">Mbps رفع</span>
        </div>
    </div>
    
    <div class="stat-item stat-speed-active" title="مجموع السرعات للمشتركين المتصلين حالياً">
        <div class="stat-icon-mini"><i class="fas fa-tachometer-alt"></i></div>
        <div class="stat-data">
            <span class="stat-number" id="statConnectedSpeed">@(connectionsReady ? $"{connectedDownloadSpeed.ToString("0.##")}↓/{connectedUploadSpeed.ToString("0.##")}↑" : "…")</span>
            <span class="stat-label">Mbps متصل تنزيل/رفع</span>
        </div>
    </div>
    
    <div class="stat-item stat-avg" title="متوسط سرعة التنزيل / الرفع لكل مشترك">
        <div class="stat-icon-mini"><i class="fas fa-chart-line"></i></div>
        <div class="stat-data">
            <span class="stat-number">@averageDownloadSpeed↓/@averageUploadSpeed↑</span>
            <span class="stat-label">Mbps متوسط</span>
        </div>
    </div>
</div>

<!-- Clients Table -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-list"></i>
            قائمة العملاء
        </h3>
        <div class="card-actions">
            <div class="filter-buttons">
                <button class="filter-btn filter-btn--all active" onclick="filterByStatus('all')" data-filter="all" title="جميع الحسابات على جميع سيرفرات الشركة">
                    <span class="filter-btn__label">الكل</span>
                    <span class="filter-count">@totalClients</span>
                </button>
                <button class="filter-btn filter-btn--active" onclick="filterByStatus('active')" data-filter="active" title="المشتركون الذين حسابهم ليس معطّلاً">
                    <span class="filter-btn__label">نشط</span>
                    <span class="filter-count">@activeClients</span>
                </button>
                <button class="filter-btn filter-btn--connected" onclick="filterByStatus('connected')" data-filter="connected" title="المشتركون غير المعطّلين والمتصلون حالياً بالإنترنت">
                    <span class="filter-btn__label">متصل</span>
                    <span class="filter-count" id="filterConnectedCount">@(connectionsReady ? connectedActiveClients.ToString() : "…")</span>
                </button>
                <button class="filter-btn filter-btn--disconnected" onclick="filterByStatus('disconnected')" data-filter="disconnected" title="المشتركون غير المعطّلين وغير المتصلين حالياً بالإنترنت">
                    <span class="filter-btn__label">غير متصل</span>
                    <span class="filter-count" id="filterDisconnectedCount">@(connectionsReady ? disconnectedActiveClients.ToString() : "…")</span>
                </button>
                <button class="filter-btn filter-btn--inactive" onclick="filterByStatus('inactive')" data-filter="inactive" title="المشتركون الذين حسابهم معطّل لأي سبب">
                    <span class="filter-btn__label">معطل</span>
                    <span class="filter-count">@inactiveClients</span>
                </button>
                <button class="filter-btn filter-btn--duplicate" onclick="filterByStatus('duplicate')" data-filter="duplicate" title="الحسابات المكررة عبر سيرفرات MikroTik ضمن الشبكة">
                    <span class="filter-btn__label">مكرر</span>
                    <span class="filter-count">@duplicateClients</span>
                </button>
                <button class="filter-btn filter-btn--vip" onclick="filterByStatus('vip')" data-filter="vip" title="المشتركون المميزون (VIP)">
                    <span class="filter-btn__label">VIP</span>
                    <span class="filter-count">@vipClients</span>
                </button>
            </div>
            <div class="clients-bulk-actions">
            @if (User.IsInRole("NetworkAdministrator") || User.IsInRole("CompanyEmployee") || User.IsInRole("Employee") || User.IsInRole("EmployeeLegacy"))
            {
                <button type="button" class="btn btn-sm btn-outline-primary" id="btnOpenBulkExpiration" title="تعديل تاريخ انتهاء الصلاحية">
                    <i class="fas fa-calendar-alt"></i> تعديل تاريخ الانتهاء
                </button>
            }
            @if (User.IsInRole("SystemAdministrator") || User.IsInRole("NetworkAdministrator"))
            {
                <button type="button" class="btn btn-sm btn-outline-success" id="btnOpenBulkTopUp" title="شحن رصيد للمشتركين">
                    <i class="fas fa-wallet"></i> شحن رصيد
                </button>
                <button type="button" class="btn btn-sm btn-outline-info" id="btnOpenCopyToTower" title="نقل الحسابات المحددة إلى برج جديد وحذفها من القديم">
                    <i class="fas fa-exchange-alt"></i> نقل المحدد إلى برج
                </button>
                <button type="button" class="btn btn-sm btn-outline-primary" id="btnOpenDuplicateToTower" title="نسخ الحسابات المحددة إلى برج جديد مع الإبقاء على المشتركين في البرج القديم">
                    <i class="fas fa-copy"></i> نسخ المحدد إلى برج
                </button>
                <button type="button" class="btn btn-sm btn-outline-danger" id="btnOpenBulkDeleteSelected" title="حذف المشتركين المحددين من قاعدة البيانات ومن سيرفر MikroTik">
                    <i class="fas fa-trash-alt"></i> حذف المحدد
                </button>
            }
            </div>
            <div class="clients-card-tools">
            <div class="dropdown clients-column-picker">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                    <i class="fas fa-columns"></i> الحقول
                </button>
                <div class="dropdown-menu dropdown-menu-end p-2 column-picker-menu" onclick="event.stopPropagation()">
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="fullName" checked /> الاسم الكامل</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="phone" checked /> الجوال</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="receiver" /> المستقبل</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="sender" /> المرسل</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="speed" checked /> السرعة</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="server" checked /> السيرفر</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="serverAccount" checked /> الحساب في السيرفر</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="duplicate" checked /> مكرر</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="dbAccount" /> الحساب في قاعدة البيانات</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="startDate" /> تاريخ بدء الصلاحية</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="endDate" checked /> تاريخ انتهاء الصلاحية</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="remainingDays" checked /> الأيام المتبقية</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="lastRenewal" /> آخر تجديد</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="location" /> الموقع</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="powerSource" /> مصدر الكهرباء</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="building" /> البناء</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="floor" /> الطابق</label>
                </div>
            </div>
            <button class="btn btn-sm btn-icon" onclick="refreshConnections()" title="تحديث">
                <i class="fas fa-sync"></i>
            </button>
            </div>
        </div>
    </div>
    <div class="card-body clients-table-wrap">
        <div class="clients-mobile-search" id="clientsMobileSearchBar">
            <label class="visually-hidden" for="clientsMobileSearchInput">بحث في العملاء</label>
            <div class="clients-mobile-search__toolbar">
                <label class="clients-mobile-search__select-all" title="تحديد الظاهر">
                    <input type="checkbox" id="clientsSelectAllMobile" class="form-check-input" />
                    <span>الكل</span>
                </label>
                <div class="clients-mobile-search__field">
                    <i class="fas fa-search clients-mobile-search__icon" aria-hidden="true"></i>
                    <input type="search"
                           class="form-control"
                           id="clientsMobileSearchInput"
                           placeholder="بحث بالاسم أو الجوال أو الحساب..."
                           autocomplete="off"
                           inputmode="search"
                           enterkeyhint="search" />
                    <button type="button" class="clients-mobile-search__clear" id="clientsMobileSearchClear" title="مسح البحث" aria-label="مسح البحث" hidden>
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
        </div>
        <div class="clients-table-meta">
            <div class="clients-table-counts">
                <span class="clients-count-chip clients-count-chip--records" title="عدد السجلات الظاهرة في الجدول بعد الفلتر والبحث">
                    <i class="fas fa-list-ol"></i>
                    السجلات
                    <strong id="clientsVisibleCount">@totalClients</strong>
                </span>
                <span class="clients-count-chip clients-count-chip--selected" id="clientsSelectedCountChip" hidden title="عدد المشتركين المحددين">
                    <i class="fas fa-check-square"></i>
                    المحدد
                    <strong id="clientsSelectedCount">0</strong>
                </span>
            </div>
        </div>
        <div class="table-container table-responsive">
            <table class="table table-sm table-compact radtk-data-table radtk-data-table--cards" id="clientsTable">
                <thead>
                    <tr>
                        <th class="no-sort clients-select-col" style="width:2.5rem;">
                            <input type="checkbox" id="clientsSelectAll" class="form-check-input" title="تحديد الكل" />
                        </th>
                        <th data-col="fullName">الاسم الكامل</th>
                        <th data-col="phone">الجوال</th>
                        <th data-col="receiver">المستقبل</th>
                        <th data-col="sender">المرسل</th>
                        <th data-col="speed">السرعة</th>
                        <th data-col="server">السيرفر</th>
                        <th data-col="serverAccount">الحساب في السيرفر</th>
                        <th data-col="duplicate">مكرر</th>
                        <th data-col="dbAccount">الحساب في قاعدة البيانات</th>
                        <th data-col="startDate">تاريخ بدء الصلاحية</th>
                        <th data-col="endDate">تاريخ انتهاء الصلاحية</th>
                        <th data-col="remainingDays">عدد الأيام المتبقية</th>
                        <th data-col="lastRenewal">تاريخ آخر تجديد</th>
                        <th data-col="location">الموقع</th>
                        <th data-col="powerSource">مصدر الكهرباء</th>
                        <th data-col="building">البناء</th>
                        <th data-col="floor">الطابق</th>
                        <th data-label="الحالة">الحالة</th>
                        <th data-label="الاتصال">الاتصال</th>
                        <th data-label="تاريخ الإضافة">تاريخ الإضافة</th>
                        <th class="no-sort clients-actions-col">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var downloadSpeed = 0m;
                        var uploadSpeed = 0m;
                        var profileName = item.Profile?.Name ?? item.ProfileName;
                        var uploadInferred = false;
                        if (item.Profile != null)
                        {
                            downloadSpeed = item.Profile.DownloadSpeedMbps;
                            uploadSpeed = item.Profile.EffectiveUploadSpeedMbps;
                            uploadInferred = !item.Profile.UploadSpeed.HasValue;
                        }
                        else if (!string.IsNullOrEmpty(item.ProfileName))
                        {
                            var numbers = System.Text.RegularExpressions.Regex.Match(item.ProfileName, @"\d+");
                            if (numbers.Success && int.TryParse(numbers.Value, out var parsedSpeed))
                            {
                                downloadSpeed = parsedSpeed;
                                uploadSpeed = parsedSpeed;
                                uploadInferred = true;
                            }
                        }

                        var isConnected = connectionsReady && connectedClients.Contains(item.Id);
                        var isPendingApproval = pendingClientIds.Contains(item.Id) ||
                            string.Equals(item.ConnectionStatus, "معلق بانتظار موافقة مدير الشركة", StringComparison.OrdinalIgnoreCase);
                        var senderName = item.Receiver?.Sector?.Name ?? "-";
                        var dbAccount = dbAccountMap.TryGetValue(item.Id, out var dbUser) ? dbUser : "-";
                        var remainingDays = item.AccountExpirationDate.HasValue
                            ? (item.AccountExpirationDate.Value.Date - DateTime.Now.Date).Days
                            : (int?)null;

                        <tr class="client-row"
                            data-client-id="@item.Id"
                            data-client-name="@(item.Name ?? item.UserName ?? ("#" + item.Id))"
                            data-search="@($"{item.Name} {item.PhoneNumber} {item.UserName} {dbAccount} {item.SID} {item.MikroTikServer?.Name} {item.Receiver?.Name} {senderName} {profileName}".Trim())"
                            data-active="@item.IsActive.ToString().ToLower()"
                            data-pending="@isPendingApproval.ToString().ToLower()"
                            data-duplicate="@item.IsCrossServerDuplicate.ToString().ToLower()"
                            data-vip="@item.IsVip.ToString().ToLower()"
                            data-connected="@isConnected.ToString().ToLower()"
                            data-speed="@downloadSpeed.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-upload-speed="@uploadSpeed.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-speed-display="@(item.Profile != null ? $"{item.Profile.DownloadSpeedDisplay} / {item.Profile.EffectiveUploadSpeedDisplay}" : downloadSpeed.ToString())"
                            data-profile-price="@((item.Profile?.Price ?? 0m).ToString(System.Globalization.CultureInfo.InvariantCulture))">
                            <td class="clients-select-cell" data-label="">
                                <label class="clients-select-hit">
                                    <input type="checkbox" class="form-check-input client-select-check" value="@item.Id" />
                                    <span class="visually-hidden">تحديد</span>
                                </label>
                            </td>
                            <td data-col="fullName" data-label="الاسم الكامل">
                                <div class="client-info">
                                    <div class="client-avatar js-client-avatar @(isConnected ? "online" : (item.IsActive ? "away" : "offline"))">
                                        @(item.Name?.Substring(0, 1).ToUpper() ?? "?")
                                    </div>
                                    <div>
                                        <div class="client-name">
                                            @item.Name
                                            @if (item.IsVip)
                                            {
                                                <span class="badge clients-vip-badge" title="@(string.IsNullOrWhiteSpace(item.VipNote) ? ClientVipBenefitDisplay.DetailsText(item, 0m) : item.VipNote)">
                                                    <i class="fas fa-crown"></i> @ClientVipBenefitDisplay.BadgeText(item)
                                                </span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(item.SID))
                                        {
                                            <div class="client-sid">#@item.SID</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td data-col="phone" data-label="الجوال">
                                <span class="text-muted">
                                    <i class="fas fa-phone"></i> @item.PhoneNumber
                                </span>
                            </td>
                            <td data-col="receiver" data-label="المستقبل">
                                @if (item.Receiver != null)
                                {
                                    <span class="badge badge-info">@item.Receiver.Name</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td data-col="sender" data-label="المرسل">
                                <span class="badge badge-light">@senderName</span>
                            </td>
                            <td data-col="speed" data-label="السرعة">
                                <div class="profile-info">
                                    <span class="badge @(item.IsActive ? "badge-success" : "badge-secondary")">
                                        @(profileName ?? "غير محدد")
                                    </span>
                                    <small class="speed-value" title="@(uploadInferred ? "الرفع غير محدد في البروفايل — اعتُبر مساوياً للتنزيل" : "تنزيل / رفع")">
                                        ↓@downloadSpeed.ToString("0.##") / ↑@uploadSpeed.ToString("0.##") Mbps
                                        @if (uploadInferred && downloadSpeed > 0)
                                        {
                                            <span class="text-muted">(رفع=تنزيل)</span>
                                        }
                                    </small>
                                </div>
                            </td>
                            <td data-col="server" data-label="السيرفر">
                                @if (item.MikroTikServer != null)
                                {
                                    <span class="badge badge-primary" title="@item.MikroTikServer.Host">
                                        <i class="fas fa-server"></i> @item.MikroTikServer.Name
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td data-col="serverAccount" data-label="الحساب في السيرفر">
                                <code class="text-nowrap">@item.UserName</code>
                            </td>
                            <td data-col="duplicate" data-label="مكرر" class="@(item.IsCrossServerDuplicate ? null : "clients-card-hide-empty")" data-order="@(item.IsCrossServerDuplicate ? 1 : 0)">
                                @if (item.IsCrossServerDuplicate)
                                {
                                    <span class="badge bg-warning text-dark" title="نفس الحساب موجود على سيرفر MikroTik آخر ضمن الشبكة">
                                        <i class="fas fa-clone"></i> مكرر
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td data-col="dbAccount" data-label="الحساب في قاعدة البيانات"><code class="text-nowrap">@dbAccount</code></td>
                            <td data-col="startDate" data-label="تاريخ بدء الصلاحية">
                                @(item.ServiceStartDate?.ToString("yyyy/MM/dd") ?? "-")
                            </td>
                            <td data-col="endDate" data-label="تاريخ انتهاء الصلاحية">
                                @(item.AccountExpirationDate?.ToString("yyyy/MM/dd") ?? "-")
                            </td>
                            <td data-col="remainingDays" data-label="الأيام المتبقية">
                                @if (remainingDays.HasValue)
                                {
                                    <span class="badge @(remainingDays.Value < 0 ? "badge-danger" : remainingDays.Value <= 3 ? "badge-warning" : "badge-success")">
                                        @remainingDays يوم
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td data-col="lastRenewal" data-label="آخر تجديد">
                                @(item.LastRenewalDate?.ToString("yyyy/MM/dd") ?? "-")
                            </td>
                            <td data-col="location" data-label="الموقع">
                                <span title="@item.ResidenceAddress">@(string.IsNullOrWhiteSpace(item.ResidenceAddress) ? "-" : item.ResidenceAddress)</span>
                                @if (item.Latitude.HasValue && item.Longitude.HasValue)
                                {
                                    <small class="text-muted d-block">@item.Latitude.Value.ToString("F4"), @item.Longitude.Value.ToString("F4")</small>
                                }
                            </td>
                            <td data-col="powerSource" data-label="مصدر الكهرباء">@(string.IsNullOrWhiteSpace(item.PowerSource) ? "-" : item.PowerSource)</td>
                            <td data-col="building" data-label="البناء">@(string.IsNullOrWhiteSpace(item.Building) ? "-" : item.Building)</td>
                            <td data-col="floor" data-label="الطابق">@(string.IsNullOrWhiteSpace(item.Floor) ? "-" : item.Floor)</td>
                            <td data-label="الحالة">
                                @if (item.IsActive)
                                {
                                    <span class="status-badge status-active">
                                        <i class="fas fa-check-circle"></i> مفعل
                                    </span>
                                }
                                else if (isPendingApproval)
                                {
                                    <span class="status-badge status-awaiting">
                                        <i class="fas fa-hourglass-half"></i> بانتظار موافقة المدير
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-inactive">
                                        <i class="fas fa-times-circle"></i> معطل
                                    </span>
                                }
                            </td>
                            <td data-label="الاتصال">
                                @if (isPendingApproval)
                                {
                                    <span class="js-client-connection status-badge status-awaiting">
                                        <i class="fas fa-user-clock"></i> قيد الاعتماد
                                    </span>
                                }
                                else if (isConnected)
                                {
                                    <span class="js-client-connection status-badge status-online">
                                        <i class="fas fa-wifi"></i> متصل
                                    </span>
                                }
                                else if (item.IsActive)
                                {
                                    if (!connectionsReady)
                                    {
                                        <span class="js-client-connection status-badge status-away">
                                            <i class="fas fa-spinner fa-spin"></i> جاري التحقق
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="js-client-connection status-badge status-away">
                                            <i class="fas fa-wifi-slash"></i> غير متصل
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="js-client-connection text-muted">-</span>
                                }
                            </td>
                            <td data-label="تاريخ الإضافة">
                                <span class="text-muted text-sm">@item.CreatedDate.ToString("yyyy/MM/dd")</span>
                            </td>
                            <td class="clients-actions-cell radtk-col-actions" data-label="إجراءات">
                                <div class="action-buttons">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-info" title="تفاصيل">
                                        <i class="fas fa-eye"></i>
                                    </a>

                                    @if (User.IsInRole("NetworkAdministrator") || User.IsInRole("CompanyEmployee") || User.IsInRole("Employee") || User.IsInRole("EmployeeLegacy"))
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-warning" title="تعديل">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    }

                                    @if (User.IsInRole("NetworkAdministrator"))
                                    {
                                        @if (item.MikroTikServerId.HasValue && !string.IsNullOrEmpty(item.UserName))
                                        {
                                            <form asp-action="SyncWithMikroTik" method="post" class="clients-action-form">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@item.Id" />
                                                <button type="submit" class="btn btn-sm btn-icon btn-outline-info" title="مزامنة مع مايكروتك (إضافة إلى مايكروتك): إضافة المشترك إن لم يكن موجوداً، أو تحديث كلمة المرور والسرعة من قاعدة البيانات"
                                                        onclick="return confirm('سيتم إضافة المشترك إلى MikroTik إن لم يكن موجوداً، أو تحديث كلمة المرور والبروفايل (السرعة) من بيانات النظام. متابعة؟');">
                                                    <i class="fas fa-cloud-upload-alt"></i>
                                                </button>
                                            </form>
                                        }

                                        <form asp-action="Freeze" method="post" class="clients-action-form">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-icon btn-secondary" title="تجميد الإنترنت في MikroTik"
                                                    onclick="return confirm('سيتم تجميد الإنترنت لهذا المشترك على المايكروتك فقط، هل تريد المتابعة؟');">
                                                <i class="fas fa-pause"></i>
                                            </button>
                                        </form>

                                        <form asp-action="Delete" method="post" class="clients-action-form"
                                              onsubmit="return confirm('تأكيد الحذف: سيتم حذف العميل نهائياً من قاعدة البيانات ومن خادم MikroTik. هل تريد المتابعة؟');">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-icon btn-danger" title="حذف العميل من قاعدة البيانات وMikroTik">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </form>

                                        <form asp-action="RenewOneMonth" method="post" class="clients-action-form">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-icon btn-success" title="تجديد اشتراك شهر"
                                                    onclick="return confirm('سيتم تجديد الاشتراك لمدة شهر من تاريخ الانتهاء الحالي، متابعة؟');">
                                                <i class="fas fa-sync-alt"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer">
        <div class="footer-stats">
            <span class="footer-stat">
                <i class="fas fa-bolt text-warning"></i>
                <span id="currentSpeedLabel">المجموع:</span>
                <strong id="currentSpeedValue">↓@totalDownloadSpeed.ToString("0.##") / ↑@totalUploadSpeed.ToString("0.##") Mbps</strong>
            </span>
            <span class="footer-stat">
                <i class="fas fa-wifi text-success"></i>
                <span id="currentConnectedCount">@connectedClients.Count متصل</span>
            </span>
            <span class="footer-stat">
                <i class="fas fa-clock text-muted"></i>
                @DateTime.Now.ToString("HH:mm:ss")
            </span>
        </div>
    </div>
</div>
</div>
</div>

@Html.AntiForgeryToken()

<!-- Bulk expiration modal -->
<div class="modal fade" id="bulkExpirationModal" tabindex="-1" aria-labelledby="bulkExpirationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bulkExpirationModalLabel">
                    <i class="fas fa-calendar-alt text-primary"></i>
                    تعديل تاريخ انتهاء الصلاحية
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold" for="bulkExpirationDate">تاريخ انتهاء الصلاحية الجديد</label>
                    <input type="date" class="form-control" id="bulkExpirationDate" required />
                </div>
                <div class="mb-2 fw-semibold">تطبيق على:</div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="bulkExpirationScope" id="bulkScopeSelected" value="selected" checked>
                    <label class="form-check-label" for="bulkScopeSelected">
                        المشتركين المحددين
                        <span class="text-muted" id="bulkSelectedCountHint">(0 محدد)</span>
                    </label>
                </div>
                <div class="form-check">
                    <input class="form-check-input" type="radio" name="bulkExpirationScope" id="bulkScopeAll" value="all">
                    <label class="form-check-label" for="bulkScopeAll">
                        جميع المشتركين في الشبكة الحالية
                        <span class="text-muted">(@totalClients)</span>
                    </label>
                </div>
                <div class="alert alert-info small mt-3 mb-0">
                    <i class="fas fa-bolt"></i>
                    التحديث سريع على قاعدة البيانات دفعة واحدة. إيقاف الحسابات المنتهية يتم لاحقاً عبر فحص النظام المعتاد.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                <button type="button" class="btn btn-primary" id="btnConfirmBulkExpiration">
                    <i class="fas fa-check"></i> تنفيذ
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Client info file import modal -->
<div class="modal fade" id="clientInfoImportModal" tabindex="-1" aria-labelledby="clientInfoImportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="ImportClientInfoFromFile" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="clientInfoImportModalLabel">
                        <i class="fas fa-file-excel text-success"></i>
                        استيراد معلومات المشتركين من ملف
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-2">
                        لا يُضاف مشتركون جدد. يُحدَّث فقط من يوجد حسابه مسبقاً في قاعدة البيانات.
                        يتم البحث عن مطابقة <strong>الحساب</strong> في الشبكة الحالية.
                        عند التطابق تُنقل الحقول المتوفرة:
                        <strong>الاسم الكامل، الجوال، آخر تجديد، البناء، تاريخ الإضافة</strong>.
                        إذا كان الحساب أو الاسم الكامل مكرراً في قاعدة البيانات تُدخل نفس المعلومات في كل التكرارات.
                        إذا كان <strong>آخر تجديد</strong> خلال 30 يوماً من تاريخ الاستعادة يُجدَّد الاشتراك حتى يوم <strong>10</strong> من الشهر التالي.
                    </p>
                    <div class="alert alert-info small py-2 mb-3">
                        <i class="fas fa-info-circle"></i>
                        <strong>ملاحظة:</strong> إذا احتوى ملف Excel على أكثر من ورقة (Sheet)،
                        يُبحث تلقائياً عن الورقة التي يحتوي اسمها على
                        «<strong>مشتركين كامل</strong>» وتُستخدم هي فقط للاستيراد.
                        الحقول الفارغة في الصف تُتجاهل ولا تُمسح البيانات الحالية.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="clientInfoImportFile">ملف Excel أو CSV</label>
                        <input type="file" class="form-control" id="clientInfoImportFile" name="file"
                               accept=".xlsx,.xlsm,.csv,.txt" required />
                    </div>
                    <a asp-action="DownloadClientInfoImportTemplate" class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-download"></i> تنزيل قالب Excel
                    </a>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-upload"></i> استيراد
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Bulk top-up modal -->
<div class="modal fade" id="bulkTopUpModal" tabindex="-1" aria-labelledby="bulkTopUpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bulkTopUpModalLabel">
                    <i class="fas fa-wallet text-success"></i>
                    شحن رصيد للمشتركين
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <div class="mb-2 fw-semibold">تطبيق على:</div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="bulkTopUpScope" id="bulkTopUpScopeSelected" value="selected" checked>
                    <label class="form-check-label" for="bulkTopUpScopeSelected">
                        المشتركين المحددين
                        <span class="text-muted" id="bulkTopUpSelectedCountHint">(0 محدد)</span>
                    </label>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="radio" name="bulkTopUpScope" id="bulkTopUpScopeAll" value="all">
                    <label class="form-check-label" for="bulkTopUpScopeAll">
                        جميع المشتركين في الشبكة الحالية
                        <span class="text-muted">(@totalClients)</span>
                    </label>
                </div>

                <div class="mb-2 fw-semibold">نوع القيمة:</div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="radio" name="bulkTopUpMode" id="bulkTopUpModeFixed" value="fixed" checked>
                    <label class="form-check-label" for="bulkTopUpModeFixed">مبلغ ثابت لكل مشترك</label>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="radio" name="bulkTopUpMode" id="bulkTopUpModePercent" value="percent">
                    <label class="form-check-label" for="bulkTopUpModePercent">نسبة مئوية من سعر باقة كل مشترك</label>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="bulkTopUpValue" id="bulkTopUpValueLabel">المبلغ (ل.س)</label>
                    <input type="number" class="form-control" id="bulkTopUpValue" min="0.01" step="0.01" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" for="bulkTopUpNotes">ملاحظات (اختياري)</label>
                    <input type="text" class="form-control" id="bulkTopUpNotes" maxlength="250" />
                </div>

                <div class="alert alert-secondary small mb-0" id="bulkTopUpEstimateHint">
                    <i class="fas fa-info-circle"></i>
                    <span id="bulkTopUpEstimateText">حدد النطاق والقيمة لعرض تقدير الإجمالي.</span>
                </div>
                <div class="alert alert-warning small mt-2 mb-0">
                    <i class="fas fa-balance-scale"></i>
                    يُطبَّق نفس مسار الشحن الفردي: إضافة لرصيد المشترك وخصم من محفظة الشبكة مع تسجيل القيود المالية.
