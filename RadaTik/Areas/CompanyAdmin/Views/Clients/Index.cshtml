@section Scripts {
    <script>
        let currentFilter = 'all';
        let clientsStatusFilterRegistered = false;
        let clientsCardSearchQuery = '';

        function rowMatchesStatusFilter(rowNode, filterType) {
            const isActive = rowNode.getAttribute('data-active') === 'true';
            const isConnected = rowNode.getAttribute('data-connected') === 'true';
            const isDuplicate = rowNode.getAttribute('data-duplicate') === 'true';
            const isVip = rowNode.getAttribute('data-vip') === 'true';
            switch (filterType) {
                case 'active':
                    return isActive;
                case 'inactive':
                    return !isActive;
                case 'connected':
                    return isConnected;
                case 'disconnected':
                    return isActive && !isConnected;
                case 'duplicate':
                    return isDuplicate;
                case 'vip':
                    return isVip;
                default:
                    return true;
            }
        }

        function normalizeClientSearchText(value) {
            return String(value || '')
                .toLowerCase()
                .replace(/[أإآٱ]/g, 'ا')
                .replace(/ى/g, 'ي')
                .replace(/ة/g, 'ه')
                .replace(/ـ/g, '')
                .replace(/\s+/g, ' ')
                .trim();
        }

        function rowMatchesCardSearch(rowNode) {
            const q = normalizeClientSearchText(clientsCardSearchQuery);
            if (!q) {
                return true;
            }
            const hay = normalizeClientSearchText(
                rowNode.getAttribute('data-search')
                || rowNode.getAttribute('data-client-name')
                || rowNode.textContent
                || ''
            );
            return hay.indexOf(q) !== -1;
        }

        function syncClientsMobileSearchUi() {
            const clearBtn = document.getElementById('clientsMobileSearchClear');
            if (clearBtn) {
                clearBtn.hidden = !(clientsCardSearchQuery || '').trim();
            }
        }

        function ensureClientsStatusDataTableFilter() {
            if (clientsStatusFilterRegistered || typeof $.fn.dataTable === 'undefined') {
                return;
            }
            clientsStatusFilterRegistered = true;
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                if (!settings.nTable || settings.nTable.id !== 'clientsTable') {
                    return true;
                }
                const api = new $.fn.dataTable.Api(settings);
                const rowNode = api.row(dataIndex).node();
                if (!rowNode || !rowNode.classList.contains('client-row')) {
                    return true;
                }
                return rowMatchesStatusFilter(rowNode, currentFilter) && rowMatchesCardSearch(rowNode);
            });
        }

        function updateFilterFooterStats(visibleDownloadSpeed, visibleUploadSpeed, visibleConnectedCount, filterType) {
            const speedValue = document.getElementById('currentSpeedValue');
            const connectedCount = document.getElementById('currentConnectedCount');
            const speedLabel = document.getElementById('currentSpeedLabel');
            if (speedValue) {
                const dl = Number(visibleDownloadSpeed || 0);
                const ul = Number(visibleUploadSpeed || 0);
                speedValue.textContent = '↓' + formatMbps(dl) + ' / ↑' + formatMbps(ul) + ' Mbps';
            }
            if (connectedCount) {
                connectedCount.textContent = visibleConnectedCount + ' متصل';
            }
            const labels = {
                'all': 'المجموع:',
                'active': 'النشطين:',
                'inactive': 'المعطلين:',
                'connected': 'المتصلين:',
                'disconnected': 'غير المتصلين:',
                'duplicate': 'المكررين:',
                'vip': 'VIP:'
            };
            if (speedLabel) {
                speedLabel.textContent = labels[filterType] || labels.all;
            }
        }

        function formatMbps(n) {
            const v = Number(n || 0);
            if (!isFinite(v)) return '0';
            return (Math.round(v * 100) / 100).toString();
        }

        function rowDownloadSpeed(row) {
            return parseFloat(row.getAttribute('data-speed')) || 0;
        }

        function rowUploadSpeed(row) {
            const raw = row.getAttribute('data-upload-speed');
            if (raw === null || raw === '') {
                return rowDownloadSpeed(row);
            }
            return parseFloat(raw) || 0;
        }

        function isClientRowCardHidden(row) {
            return !!(row && (row.classList.contains('is-card-hidden') || row.hasAttribute('hidden')));
        }

        function setClientRowCardVisible(row, visible) {
            if (!row) {
                return;
            }
            row.classList.toggle('is-card-hidden', !visible);
            if (visible) {
                row.removeAttribute('hidden');
                row.style.removeProperty('display');
            } else {
                row.setAttribute('hidden', '');
                row.style.display = 'none';
            }
        }

        function filterByStatus(filterType) {
            currentFilter = filterType;
            let visibleDownloadSpeed = 0;
            let visibleUploadSpeed = 0;
            let visibleConnectedCount = 0;

            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.toggle('active', btn.getAttribute('data-filter') === filterType);
            });
            document.querySelectorAll('.stat-item.is-filter').forEach(card => {
                card.classList.toggle('active', card.getAttribute('data-filter') === filterType);
            });

            const usingDataTable = typeof window.jQuery !== 'undefined' &&
                typeof $.fn !== 'undefined' &&
                typeof $.fn.DataTable !== 'undefined' &&
                $.fn.DataTable.isDataTable('#clientsTable');

            document.querySelectorAll('.client-row').forEach(row => {
                const shouldShow = rowMatchesStatusFilter(row, filterType) && rowMatchesCardSearch(row);
                setClientRowCardVisible(row, shouldShow);
                if (shouldShow) {
                    visibleDownloadSpeed += rowDownloadSpeed(row);
                    visibleUploadSpeed += rowUploadSpeed(row);
                    if (row.getAttribute('data-connected') === 'true') {
                        visibleConnectedCount++;
                    }
                }
            });

            if (usingDataTable) {
                ensureClientsStatusDataTableFilter();
                $('#clientsTable').DataTable().draw(false);
            }

            updateFilterFooterStats(visibleDownloadSpeed, visibleUploadSpeed, visibleConnectedCount, filterType);
            updateVisibleRecordsCount();
        }

        function refreshConnections() {
            loadConnectionStatus(true);
        }

        function applyConnectedIds(connectedIds) {
            const connectedSet = new Set((connectedIds || []).map(String));
            let connectedCount = 0;
            let disconnectedCount = 0;
            let connectedDownloadSpeed = 0;
            let connectedUploadSpeed = 0;

            document.querySelectorAll('.client-row').forEach(row => {
                const id = row.getAttribute('data-client-id');
                const isActive = row.getAttribute('data-active') === 'true';
                const isPending = row.getAttribute('data-pending') === 'true';
                const downloadSpeed = rowDownloadSpeed(row);
                const uploadSpeed = rowUploadSpeed(row);
                const isConnected = connectedSet.has(String(id));
                row.setAttribute('data-connected', isConnected ? 'true' : 'false');

                const avatar = row.querySelector('.js-client-avatar');
                if (avatar) {
                    avatar.classList.remove('online', 'away', 'offline');
                    if (isConnected) {
                        avatar.classList.add('online');
                    } else if (isActive) {
                        avatar.classList.add('away');
                    } else {
                        avatar.classList.add('offline');
                    }
                }

                const badge = row.querySelector('.js-client-connection');
                if (badge && !isPending) {
                    if (isConnected) {
                        badge.className = 'js-client-connection status-badge status-online';
                        badge.innerHTML = '<i class="fas fa-wifi"></i> متصل';
                    } else if (isActive) {
                        badge.className = 'js-client-connection status-badge status-away';
                        badge.innerHTML = '<i class="fas fa-wifi-slash"></i> غير متصل';
                    }
                }

                if (isConnected) {
                    connectedCount++;
                    connectedDownloadSpeed += downloadSpeed;
                    connectedUploadSpeed += uploadSpeed;
                } else if (isActive) {
                    disconnectedCount++;
                }
            });

            const totalRows = document.querySelectorAll('.client-row').length;
            const connectedPercent = totalRows > 0
                ? Math.round((connectedCount / totalRows) * 100)
                : 0;

            const setText = (id, value) => {
                const el = document.getElementById(id);
                if (el) el.textContent = value;
            };

            setText('statConnectedCount', String(connectedCount));
            setText('statDisconnectedCount', String(disconnectedCount));
            setText('statConnectedSpeed', formatMbps(connectedDownloadSpeed) + '↓/' + formatMbps(connectedUploadSpeed) + '↑');
            setText('filterConnectedCount', String(connectedCount));
            setText('filterDisconnectedCount', String(disconnectedCount));
            const percentEl = document.getElementById('statConnectedPercent');
            if (percentEl) {
                percentEl.textContent = '(' + connectedPercent + '%)';
            }

            if (currentFilter === 'connected' || currentFilter === 'disconnected' || currentFilter === 'active') {
                filterByStatus(currentFilter);
            }
        }

        let connectionStatusLoading = false;
        function loadConnectionStatus(forceRefresh) {
            if (connectionStatusLoading) {
                return;
            }
            connectionStatusLoading = true;
            const btn = document.querySelector('[onclick="refreshConnections()"]');
            if (btn) {
                btn.classList.add('disabled');
                btn.setAttribute('aria-busy', 'true');
            }

            const url = '@Url.Action("ConnectionStatusJson", "Clients")' +
                (forceRefresh ? '?forceRefresh=true' : '');

            fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
                .then(r => {
                    if (!r.ok) throw new Error('HTTP ' + r.status);
                    return r.json();
                })
                .then(data => {
                    if (data && data.success) {
                        applyConnectedIds(data.connectedIds || []);
                    }
                })
                .catch(() => {
                    // اترك شارات «جاري التحقق» أو الحالة السابقة
                })
                .finally(() => {
                    connectionStatusLoading = false;
                    if (btn) {
                        btn.classList.remove('disabled');
                        btn.removeAttribute('aria-busy');
                    }
                });
        }

        const CLIENTS_COLUMNS_STORAGE_KEY = 'clients.columns.visible.v2';
        const CLIENTS_DEFAULT_VISIBLE_COLS = {
            fullName: true,
            phone: true,
            receiver: false,
            sender: false,
            speed: true,
            server: true,
            serverAccount: true,
            duplicate: true,
            dbAccount: false,
            startDate: false,
            endDate: true,
            remainingDays: true,
            lastRenewal: false,
            location: false,
            powerSource: false,
            building: false,
            floor: false
        };

        function isClientsMobileViewport() {
            return window.matchMedia('(max-width: 1199.98px)').matches;
        }

        function clearInlineColumnDisplay() {
            document.querySelectorAll('#clientsTable [data-col]').forEach(function (el) {
                el.style.removeProperty('display');
            });
        }

        function findDataTableColumnIndex(api, key) {
            let found = -1;
            api.columns().every(function (idx) {
                if (found >= 0) {
                    return;
                }
                const header = this.header();
                if (header && header.getAttribute('data-col') === key) {
                    found = idx;
                }
            });
            return found;
        }

        function applyInlineColumnDisplay(key, visible) {
            // CSS hide-col-* يستخدم !important ويتفوّق على تخطيط البطاقات.
            // على سطح المكتب نضبط display فوراً. بعد إظهار العمود في DataTables تُعاد الخلايا
            // التي أُرفقت سابقاً مع style.display=none، لذلك نعيد المسح بعد كل مزامنة.
            const useInlineHide = !isClientsMobileViewport();
            document.querySelectorAll('#clientsTable [data-col="' + CSS.escape(key) + '"]').forEach(function (el) {
                if (!useInlineHide || visible) {
                    el.style.removeProperty('display');
                    return;
                }
                el.style.display = 'none';
            });
        }

        function setColumnVisible(key, visible, options) {
            if (!key) {
                return;
            }
            const skipDraw = !!(options && options.skipDraw);
            const table = document.getElementById('clientsTable');
            if (table) {
                table.classList.toggle('hide-col-' + key, !visible);
            }

            applyInlineColumnDisplay(key, visible);

            if (typeof $.fn.DataTable === 'undefined' || !$.fn.DataTable.isDataTable('#clientsTable')) {
                return;
            }
            const api = $('#clientsTable').DataTable();
            const colIdx = findDataTableColumnIndex(api, key);
            if (colIdx >= 0 && api.column(colIdx).visible() !== visible) {
                api.column(colIdx).visible(visible, false);
            }
            applyInlineColumnDisplay(key, visible);
            if (!skipDraw) {
                api.columns.adjust().draw(false);
                applyInlineColumnDisplay(key, visible);
            }
        }

        function applyColumnVisibility() {
            let saved = null;
            try {
                saved = JSON.parse(localStorage.getItem(CLIENTS_COLUMNS_STORAGE_KEY) || 'null');
            } catch (e) {
                saved = null;
            }
            const selected = Object.assign({}, CLIENTS_DEFAULT_VISIBLE_COLS, saved && typeof saved === 'object' ? saved : {});

            document.querySelectorAll('.column-toggle').forEach(function (chk) {
                const key = chk.getAttribute('data-col');
                const visible = Object.prototype.hasOwnProperty.call(selected, key)
                    ? !!selected[key]
                    : !!CLIENTS_DEFAULT_VISIBLE_COLS[key];
                chk.checked = visible;
                setColumnVisible(key, visible, { skipDraw: true });
            });

            if (typeof $.fn.DataTable !== 'undefined' && $.fn.DataTable.isDataTable('#clientsTable')) {
                $('#clientsTable').DataTable().columns.adjust().draw(false);
            }
        }

        function persistColumnVisibility() {
            const data = {};
            document.querySelectorAll('.column-toggle').forEach(chk => {
                data[chk.getAttribute('data-col')] = chk.checked;
            });
            localStorage.setItem(CLIENTS_COLUMNS_STORAGE_KEY, JSON.stringify(data));
        }

        const CLIENTS_PAGE_LENGTH_KEY = 'clients.admin.pageLength';
        const CLIENTS_PAGE_LENGTH_DEFAULT = -1;
        const CLIENTS_PAGE_LENGTHS = [10, 25, 50, 100, 200, 500, -1];

        function readSavedClientsPageLength() {
            try {
                const raw = localStorage.getItem(CLIENTS_PAGE_LENGTH_KEY);
                if (raw === null || raw === '') {
                    return CLIENTS_PAGE_LENGTH_DEFAULT;
                }
                const n = parseInt(raw, 10);
                if (CLIENTS_PAGE_LENGTHS.indexOf(n) >= 0) {
                    return n;
                }
            } catch (e) { }
            return CLIENTS_PAGE_LENGTH_DEFAULT;
        }

        function persistClientsPageLength(len) {
            try {
                localStorage.setItem(CLIENTS_PAGE_LENGTH_KEY, String(len));
            } catch (e) { }
        }

        function initClientsTableIfDesktop() {
            if (!$('#clientsTable').length || typeof $.fn.DataTable === 'undefined') {
                return;
            }

            const isCompact = window.matchMedia('(max-width: 1199.98px)').matches;
            const already = $.fn.DataTable.isDataTable('#clientsTable');

            if (isCompact) {
                if (already) {
                    $('#clientsTable').DataTable().destroy();
                    $('#clientsTable').removeAttr('style');
                }
                document.body.classList.add('clients-cards-mode');
                applyColumnVisibility();
                filterByStatus(currentFilter);
                return;
            }

            document.body.classList.remove('clients-cards-mode');
            document.querySelectorAll('.client-row').forEach(function (row) {
                setClientRowCardVisible(row, true);
            });
            if (!already) {
                ensureClientsStatusDataTableFilter();
                const savedPageLength = readSavedClientsPageLength();
                $('#clientsTable').DataTable({
                    language: {
                        url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/ar.json'
                    },
                    order: [[20, 'desc']],
                    responsive: false,
                    autoWidth: false,
                    scrollX: false,
                    pageLength: savedPageLength,
                    lengthMenu: [
                        [10, 25, 50, 100, 200, 500, -1],
                        [10, 25, 50, 100, 200, 500, 'الكل']
                    ],
                    columnDefs: [
                        { orderable: false, targets: [0, 21] }
                    ],
                    initComplete: function () {
                        applyColumnVisibility();
                        const api = this.api();
                        const desired = readSavedClientsPageLength();
                        if (api.page.len() !== desired) {
                            api.page.len(desired).draw(false);
                        }
                    }
                });
                $('#clientsTable').on('length.dt', function (e, settings, len) {
                    persistClientsPageLength(len);
                });
            } else {
                applyColumnVisibility();
            }
        }

        function getAntiForgeryToken() {
            const el = document.querySelector('input[name="__RequestVerificationToken"]');
            return el ? el.value : '';
        }

        function getSelectedClientRows() {
            return Array.from(document.querySelectorAll('.client-select-check:checked')).map(function (chk) {
                const row = chk.closest('.client-row');
                return {
                    id: chk.value,
                    name: row ? (row.getAttribute('data-client-name') || ('#' + chk.value)) : ('#' + chk.value),
                    profilePrice: row ? Number(row.getAttribute('data-profile-price') || 0) : 0
                };
            });
        }

        function getAllClientRows() {
            return Array.from(document.querySelectorAll('.client-row[data-client-id]')).map(function (row) {
                return {
                    id: row.getAttribute('data-client-id'),
                    name: row.getAttribute('data-client-name') || ('#' + row.getAttribute('data-client-id')),
                    profilePrice: Number(row.getAttribute('data-profile-price') || 0)
                };
            });
        }

        function updateVisibleRecordsCount() {
            const visible = Array.from(document.querySelectorAll('#clientsTable tbody tr.client-row'))
                .filter(function (row) { return !isClientRowCardHidden(row); })
                .length;
            const el = document.getElementById('clientsVisibleCount');
            if (el) {
                el.textContent = String(visible);
            }
        }

        function updateBulkSelectedHint() {
            const count = getSelectedClientRows().length;
            const selectedEl = document.getElementById('clientsSelectedCount');
            const selectedChip = document.getElementById('clientsSelectedCountChip');
            if (selectedEl) {
                selectedEl.textContent = String(count);
            }
            if (selectedChip) {
                selectedChip.hidden = count <= 0;
            }
            const hint = document.getElementById('bulkSelectedCountHint');
            if (hint) {
                hint.textContent = '(' + count + ' محدد)';
            }
            const topUpHint = document.getElementById('bulkTopUpSelectedCountHint');
            if (topUpHint) {
                topUpHint.textContent = '(' + count + ' محدد)';
            }
            const copyHint = document.getElementById('copyToTowerSelectedCountHint');
            if (copyHint) {
                copyHint.textContent = '(' + count + ' محدد)';
            }
            const deleteHint = document.getElementById('bulkDeleteSelectedCountHint');
            if (deleteHint) {
                deleteHint.textContent = String(count);
            }
            updateBulkTopUpEstimate();
        }

        function ceilMoney(n) {
            return Math.ceil(Number(n || 0) * 100) / 100;
        }

        function updateBulkTopUpEstimate() {
            const estimateEl = document.getElementById('bulkTopUpEstimateText');
            if (!estimateEl) return;

            const scope = (document.querySelector('input[name="bulkTopUpScope"]:checked') || {}).value || 'selected';
            const mode = (document.querySelector('input[name="bulkTopUpMode"]:checked') || {}).value || 'fixed';
            const valueInput = document.getElementById('bulkTopUpValue');
            const value = valueInput ? Number(valueInput.value) : 0;
            const clients = scope === 'all' ? getAllClientRows() : getSelectedClientRows();

            if (!clients.length) {
                estimateEl.textContent = 'لا يوجد مشتركين في النطاق المحدد.';
                return;
            }
            if (!value || value <= 0) {
                estimateEl.textContent = 'عدد المستهدفين: ' + clients.length + ' — أدخل القيمة لعرض تقدير الإجمالي.';
                return;
            }

            let total = 0;
            let billable = 0;
            let skipped = 0;
            clients.forEach(function (c) {
                if (mode === 'percent') {
                    if (!c.profilePrice || c.profilePrice <= 0) {
                        skipped++;
                        return;
                    }
                    total += ceilMoney(c.profilePrice * value / 100);
                    billable++;
                } else {
                    total += ceilMoney(value);
                    billable++;
                }
            });

            let text = 'المستهدفون: ' + clients.length + ' | سيُشحن: ' + billable;
            if (skipped > 0) {
                text += ' | بلا سعر باقة: ' + skipped;
            }
            text += ' | إجمالي تقديري: ' + total.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 }) + ' ل.س';
            estimateEl.textContent = text;
        }

        function syncBulkTopUpValueLabel() {
            const mode = (document.querySelector('input[name="bulkTopUpMode"]:checked') || {}).value || 'fixed';
            const label = document.getElementById('bulkTopUpValueLabel');
            const input = document.getElementById('bulkTopUpValue');
            if (label) {
                label.textContent = mode === 'percent' ? 'النسبة المئوية (%)' : 'المبلغ (ل.س)';
            }
            if (input) {
                input.max = mode === 'percent' ? '100' : '';
                input.placeholder = mode === 'percent' ? 'مثال: 10' : 'مثال: 5000';
            }
            updateBulkTopUpEstimate();
        }

        async function runBulkTopUp(clients, mode, value, applyToAll, notes) {
            showImportProgressOverlay(true);
            const title = document.getElementById('profileImportProgressTitle');
            if (title) title.textContent = 'جاري شحن أرصدة المشتركين';
            const log = document.getElementById('profileImportProgressLog');
            if (log) log.innerHTML = '';
            setImportProgressUi(20, 'التحقق من رصيد الشبكة وتنفيذ الشحن...', 8);
            appendImportLog(mode === 'percent'
                ? ('الوضع: نسبة ' + value + '% من سعر الباقة')
                : ('الوضع: مبلغ ثابت ' + value + ' ل.س'), 'info');
            appendImportLog(applyToAll
                ? 'النطاق: جميع المشتركين في الشبكة'
                : ('النطاق: المحددون (' + clients.length + ')'), 'info');

            try {
                const token = getAntiForgeryToken();
                const body = new URLSearchParams();
                body.set('mode', mode);
                body.set('value', String(value));
                body.set('applyToAll', applyToAll ? 'true' : 'false');
                body.set('__RequestVerificationToken', token);
                if (notes) body.set('notes', notes);
                if (!applyToAll) {
                    clients.forEach(function (c) {
                        body.append('clientIds', c.id);
                    });
                }

                setImportProgressUi(60, 'تنفيذ الشحن المالي...', 4);
                const response = await fetch('@Url.Action("BulkTopUpBalanceJson", "Clients")', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                        'X-CSRF-TOKEN': token,
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    },
                    body: body.toString()
                });

                if (!response.ok) {
                    throw new Error('HTTP ' + response.status);
                }

                const result = await response.json();
                setImportProgressUi(100, result.success ? 'اكتمل الشحن' : 'فشل الشحن', 0);
                appendImportLog(result.message || (result.success ? 'تم' : 'فشل'), result.success ? 'ok' : 'err');
                if (result.succeededCount != null) {
                    appendImportLog('نجاح: ' + result.succeededCount + ' | تخطي: ' + (result.skippedCount || 0) + ' | فشل: ' + (result.failedCount || 0), 'info');
                }

                await new Promise(function (resolve) { setTimeout(resolve, 500); });
                alert(result.message || (result.success ? 'تم الشحن بنجاح' : 'فشل الشحن'));
                if (result.success) {
                    window.location.reload();
                } else {
                    showImportProgressOverlay(false);
                }
            } catch (err) {
                setImportProgressUi(100, 'فشل الاتصال', 0);
                appendImportLog('تعذر تنفيذ الشحن الجماعي', 'err');
                alert('تعذر تنفيذ الشحن الجماعي. حاول مرة أخرى.');
                showImportProgressOverlay(false);
            }
        }

        function formatCountdown(totalSeconds) {
            const s = Math.max(0, Math.floor(totalSeconds));
            const m = Math.floor(s / 60);
            const r = s % 60;
            return m > 0 ? (m + ':' + String(r).padStart(2, '0')) : (r + ' ث');
        }

        function setImportProgressUi(percent, statusText, remainingSeconds) {
            const bar = document.getElementById('profileImportProgressBar');
            const pct = document.getElementById('profileImportProgressPercent');
            const status = document.getElementById('profileImportProgressStatus');
            const countdown = document.getElementById('profileImportProgressCountdown');
            const safePercent = Math.max(0, Math.min(100, Math.round(percent)));
            if (bar) bar.style.width = safePercent + '%';
            if (pct) pct.textContent = safePercent + '%';
            if (status && statusText) status.textContent = statusText;
            if (countdown && typeof remainingSeconds === 'number') {
                countdown.textContent = 'الوقت المتبقي التقريبي: ' + formatCountdown(remainingSeconds);
            }
        }

        function appendImportLog(text, kind) {
            const log = document.getElementById('profileImportProgressLog');
            if (!log) return;
            const li = document.createElement('li');
            li.className = 'profile-import-log__item' + (kind ? ' profile-import-log__item--' + kind : '');
            li.textContent = text;
            log.appendChild(li);
            log.scrollTop = log.scrollHeight;
        }

        function showImportProgressOverlay(show) {
            const overlay = document.getElementById('profileImportProgressOverlay');
            if (!overlay) return;
            overlay.hidden = !show;
