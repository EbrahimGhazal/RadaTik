        function updateBulkSelectedHint() {
            const count = getSelectedClientRows().length;
            const hint = document.getElementById('bulkSelectedCountHint');
            if (hint) {
                hint.textContent = '(' + count + ' محدد)';
            }
            const topUpHint = document.getElementById('bulkTopUpSelectedCountHint');
            if (topUpHint) {
