                        }
                        chk.checked = selectAll.checked;
                    });
                    const other = selectAll.id === 'clientsSelectAll'
                        ? document.getElementById('clientsSelectAllMobile')
                        : document.getElementById('clientsSelectAll');
                    if (other && other !== selectAll) {
                        other.checked = selectAll.checked;
                    }
                    updateBulkSelectedHint();
                });
