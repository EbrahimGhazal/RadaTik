        async function runCopyAccountsToTower(clients, serverId, serverLabel, applyToAll, removeFromSource) {
            const isMove = removeFromSource !== false;
            showImportProgressOverlay(true);
            const title = document.getElementById('profileImportProgressTitle');
            if (title) title.textContent = isMove ? 'جاري نقل الحسابات إلى البرج الجديد' : 'جاري نسخ الحسابات إلى البرج الجديد';
            const log = document.getElementById('profileImportProgressLog');
            if (log) log.innerHTML = '';
            setImportProgressUi(18, isMove ? 'إضافة الحسابات على البرج الجديد...' : 'نسخ الحسابات إلى البرج الجديد...', 20);
            appendImportLog('الهدف: ' + (serverLabel || ('سيرفر #' + serverId)), 'info');
            appendImportLog(applyToAll
                ? 'النطاق: جميع المشتركين في الشبكة'
                : ('النطاق: المحددون (' + clients.length + ')'), 'info');
            appendImportLog(isMove
                ? 'سيتم تحديث السيرفر في قاعدة البيانات وحذف الحساب من البرج القديم.'
                : 'سيتم الإبقاء على المشتركين في البرج القديم دون حذف.', 'info');

            try {
                const token = getAntiForgeryToken();
                const body = new URLSearchParams();
                body.set('targetServerId', String(serverId));
                body.set('applyToAll', applyToAll ? 'true' : 'false');
                body.set('removeFromSource', isMove ? 'true' : 'false');
                body.set('__RequestVerificationToken', token);
                if (!applyToAll) {
                    clients.forEach(function (c) {
                        body.append('clientIds', c.id);
                    });
                }

                setImportProgressUi(55, isMove ? 'نقل الحسابات وتحديث قاعدة البيانات...' : 'نسخ الحسابات دون حذف الأصل...', 12);
                const response = await fetch('@Url.Action("BulkCopyAccountsToServerJson", "Clients")', {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                        'X-CSRF-TOKEN': token,
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    },
                    body: body.toString()
                });

                if (!response.ok) {
                    throw new Error('HTTP ' + response.status);
                }

                const result = await response.json();
                setImportProgressUi(100, result.success ? (isMove ? 'اكتمل النقل' : 'اكتمل النسخ') : (isMove ? 'فشل النقل' : 'فشل النسخ'), 0);
