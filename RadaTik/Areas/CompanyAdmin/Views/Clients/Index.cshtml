                    warning.innerHTML = isCopy
                        ? '<i class="fas fa-copy"></i> هذا نسخ وليس نقلاً: الحساب يُضاف إلى البرج الجديد ويبقى المشترك في البرج القديم.'
                        : '<i class="fas fa-exclamation-triangle"></i> هذا نقل وليس نسخاً: الحساب ينتقل إلى البرج الجديد ويُحذف من القديم.';
                }
                if (confirmText) confirmText.textContent = isCopy ? 'نسخ إلى البرج' : 'نقل إلى البرج';
                if (confirmIcon) confirmIcon.className = isCopy ? 'fas fa-copy' : 'fas fa-exchange-alt';
                if (confirmCopyBtn) {
                    confirmCopyBtn.className = isCopy ? 'btn btn-primary' : 'btn btn-info text-white';
                }
            }

            function openCopyToTowerModal(mode) {
                applyCopyToTowerMode(mode);
                updateBulkSelectedHint();
                if (copyModalEl && typeof bootstrap !== 'undefined') {
                    bootstrap.Modal.getOrCreateInstance(copyModalEl).show();
                }
            }

            if (openCopyBtn) {
                openCopyBtn.addEventListener('click', function () { openCopyToTowerModal('move'); });
            }
            if (openDuplicateBtn) {
                openDuplicateBtn.addEventListener('click', function () { openCopyToTowerModal('copy'); });
            }
            const openBulkDeleteBtn = document.getElementById('btnOpenBulkDeleteSelected');
            const confirmBulkDeleteBtn = document.getElementById('btnConfirmBulkDeleteSelected');
            const bulkDeleteModalEl = document.getElementById('bulkDeleteSelectedModal');
            const bulkDeleteConfirmInput = document.getElementById('bulkDeleteConfirmInput');
            const bulkDeleteConfirmHint = document.getElementById('bulkDeleteConfirmHint');
            const deleteConfirmKeyword = 'حذف';

            function syncBulkDeleteConfirmState() {
                const typed = (bulkDeleteConfirmInput && bulkDeleteConfirmInput.value || '').trim();
                const isValid = typed === deleteConfirmKeyword;
                if (confirmBulkDeleteBtn) {
                    confirmBulkDeleteBtn.disabled = !isValid;
                }
                if (bulkDeleteConfirmHint) {
                    bulkDeleteConfirmHint.classList.toggle('text-success', isValid);
                    bulkDeleteConfirmHint.classList.toggle('text-danger', !isValid && typed.length > 0);
                    bulkDeleteConfirmHint.textContent = isValid
                        ? 'تم التأكيد. يمكنك المتابعة بالحذف.'
                        : 'لن يُفعَّل زر الحذف إلا بعد كتابة الكلمة حرفياً.';
                }
            }

            function fillBulkDeletePreview() {
                const clients = getSelectedClientRows();
                const names = document.getElementById('bulkDeleteSelectedNames');
                if (names) {
                    names.innerHTML = '';
                    clients.slice(0, 8).forEach(function (c) {
                        const li = document.createElement('li');
                        li.textContent = c.name;
                        names.appendChild(li);
                    });
                    if (clients.length > 8) {
                        const more = document.createElement('li');
                        more.textContent = 'و ' + (clients.length - 8) + ' آخرين';
                        names.appendChild(more);
                    }
                }
                updateBulkSelectedHint();
                if (bulkDeleteConfirmInput) {
                    bulkDeleteConfirmInput.value = '';
                }
                syncBulkDeleteConfirmState();
            }

            async function runBulkDeleteSelected(clients) {
                showImportProgressOverlay(true);
                const title = document.getElementById('profileImportProgressTitle');
                if (title) title.textContent = 'جاري حذف المشتركين المحددين';
                const log = document.getElementById('profileImportProgressLog');
                if (log) log.innerHTML = '';
                setImportProgressUi(20, 'حذف الحسابات من قاعدة البيانات وسيرفر MikroTik...', 18);
                appendImportLog('عدد المحدد: ' + clients.length, 'info');
                appendImportLog('سيُحذف كل حساب من قاعدة البيانات ومن السيرفر.', 'info');

                try {
                    const token = getAntiForgeryToken();
                    const body = new URLSearchParams();
                    body.set('__RequestVerificationToken', token);
                    clients.forEach(function (c) {
                        body.append('clientIds', c.id);
                    });

                    setImportProgressUi(60, 'تنفيذ الحذف...', 10);
                    const response = await fetch('@Url.Action("BulkDeleteSelectedJson", "Clients")', {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded;charset=UTF-8',
                            'X-CSRF-TOKEN': token,
                            'X-Requested-With': 'XMLHttpRequest',
                            'Accept': 'application/json'
                        },
                        body: body.toString()
                    });

                    if (!response.ok) {
                        throw new Error('HTTP ' + response.status);
                    }

                    const result = await response.json();
                    setImportProgressUi(100, result.success ? 'اكتمل الحذف' : 'فشل الحذف', 0);
                    appendImportLog(result.message || (result.success ? 'تم الحذف' : 'فشل الحذف'), result.success ? 'ok' : 'err');
                    if (result.deletedCount != null) {
                        appendImportLog(
                            'حُذف: ' + result.deletedCount
                            + ' | فشل: ' + (result.failedCount || 0)
                            + ' | تحذير MikroTik: ' + (result.mikroTikWarningCount || 0),
                            'info');
                    }
                    if (Array.isArray(result.errors)) {
                        result.errors.slice(0, 15).forEach(function (err) {
                            appendImportLog(err, 'err');
                        });
                    }

                    await new Promise(function (resolve) { setTimeout(resolve, 600); });
                    alert(result.message || (result.success ? 'تم الحذف بنجاح' : 'فشل الحذف'));
                    if (result.success) {
                        window.location.reload();
                    } else {
                        showImportProgressOverlay(false);
                    }
                } catch (err) {
                    setImportProgressUi(100, 'فشل الاتصال', 0);
                    appendImportLog('تعذر تنفيذ حذف المحدد', 'err');
                    alert('تعذر تنفيذ حذف المحدد. حاول مرة أخرى.');
                    showImportProgressOverlay(false);
                }
            }

            if (openBulkDeleteBtn) {
                openBulkDeleteBtn.addEventListener('click', function () {
                    const clients = getSelectedClientRows();
                    if (!clients.length) {
                        alert('الرجاء تحديد مشترك واحد على الأقل.');
                        return;
                    }
                    fillBulkDeletePreview();
                    if (bulkDeleteModalEl && typeof bootstrap !== 'undefined') {
                        bootstrap.Modal.getOrCreateInstance(bulkDeleteModalEl).show();
                    }
                });
            }
            if (bulkDeleteConfirmInput) {
                bulkDeleteConfirmInput.addEventListener('input', syncBulkDeleteConfirmState);
            }
            if (bulkDeleteModalEl) {
                bulkDeleteModalEl.addEventListener('hidden.bs.modal', function () {
                    if (bulkDeleteConfirmInput) bulkDeleteConfirmInput.value = '';
                    syncBulkDeleteConfirmState();
                });
            }
            if (confirmBulkDeleteBtn) {
                confirmBulkDeleteBtn.addEventListener('click', function () {
                    const typed = (bulkDeleteConfirmInput && bulkDeleteConfirmInput.value || '').trim();
                    if (typed !== deleteConfirmKeyword) {
                        alert('للتأكيد اكتب كلمة حذف.');
                        if (bulkDeleteConfirmInput) bulkDeleteConfirmInput.focus();
                        return;
                    }

                    const clients = getSelectedClientRows();
                    if (!clients.length) {
                        alert('الرجاء تحديد مشترك واحد على الأقل.');
                        return;
                    }

                    if (bulkDeleteModalEl && typeof bootstrap !== 'undefined') {
                        bootstrap.Modal.getOrCreateInstance(bulkDeleteModalEl).hide();
                    }
                    runBulkDeleteSelected(clients);
                });
            }

            if (confirmCopyBtn) {
                confirmCopyBtn.addEventListener('click', function () {
                    const isCopy = copyModalEl && copyModalEl.getAttribute('data-mode') === 'copy';
                    const serverSelect = document.getElementById('copyToTowerServerId');
                    const serverId = serverSelect ? Number(serverSelect.value) : 0;
                    const serverLabel = serverSelect && serverSelect.selectedIndex >= 0
                        ? (serverSelect.options[serverSelect.selectedIndex].text || '')
                        : '';
                    if (!serverId) {
                        alert('الرجاء اختيار البرج / السيرفر.');
                        return;
                    }

                    const scope = (document.querySelector('input[name="copyToTowerScope"]:checked') || {}).value || 'selected';
                    const clients = scope === 'all' ? getAllClientRows() : getSelectedClientRows();
                    if (!clients.length) {
                        alert(scope === 'all'
                            ? (isCopy ? 'لا يوجد مشتركين لنسخ حساباتهم.' : 'لا يوجد مشتركين لنقل حساباتهم.')
                            : 'الرجاء تحديد مشترك واحد على الأقل، أو اختر «جميع المشتركين».');
                        return;
                    }

                    const scopeLabel = scope === 'all' ? 'جميع المشتركين' : ('المحددين (' + clients.length + ')');
                    const confirmText = isCopy
                        ? 'سيتم نسخ حسابات ' + scopeLabel + ' إلى «' + serverLabel + '».\nيبقى المشترك في البرج القديم ولا يُحذف.\nهل تريد المتابعة؟'
                        : 'سيتم نقل حسابات ' + scopeLabel + ' إلى «' + serverLabel + '».\nيُحدَّث السيرفر في قاعدة البيانات ويُحذف الحساب من البرج القديم.\nهل تريد المتابعة؟';
                    if (!confirm(confirmText)) {
                        return;
                    }

                    if (copyModalEl && typeof bootstrap !== 'undefined') {
                        bootstrap.Modal.getOrCreateInstance(copyModalEl).hide();
                    }
                    runCopyAccountsToTower(clients, serverId, serverLabel, scope === 'all', !isCopy);
                });
            }

            updateBulkSelectedHint();
            updateVisibleRecordsCount();
        });
    </script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/clients-index-cards.css" asp-append-version="true" />
}
