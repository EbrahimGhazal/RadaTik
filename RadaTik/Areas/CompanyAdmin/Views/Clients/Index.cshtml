            bindSelectAll(document.getElementById('clientsSelectAll'));
            bindSelectAll(document.getElementById('clientsSelectAllMobile'));

            document.addEventListener('change', function (e) {
                if (e.target && e.target.classList && e.target.classList.contains('client-select-check')) {
                    updateBulkSelectedHint();
