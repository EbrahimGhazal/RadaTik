@model RadaTik.Models.Client
@{
    Layout = null;
    var contractDate = (DateTime?)ViewBag.ContractDate ?? DateTime.Now;
    var contractTitle = (string?)ViewBag.ContractTitle ?? "عقد انضمام";
    var recordNumber = (string?)ViewBag.ContractRecordNumber ?? "-";
    var licenseNumber = (string?)ViewBag.ContractLicenseNumber ?? "-";
    var contractBodyHtml = (string?)ViewBag.ContractBodyHtml ?? string.Empty;
    var documentChrome = ViewBag.DocumentChrome as RadaTik.Services.Documents.CompanyDocumentChrome;
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@contractTitle</title>
    <link rel="stylesheet" href="~/css/company-document-chrome.css" asp-append-version="true" />
    <style>
        body {
            margin: 0;
            font-family: "Tahoma", "Segoe UI", sans-serif;
            background: #f7f7f7;
            color: #1f2937;
        }

        .page {
            max-width: 900px;
            margin: 20px auto;
            background: #fff;
            border: 1px solid #d1d5db;
            padding: 24px 30px 40px;
        }

        .actions {
            margin-bottom: 12px;
            display: flex;
            justify-content: flex-end;
            gap: 8px;
        }

        .btn {
            border: 1px solid #111827;
            background: #111827;
            color: #fff;
            padding: 8px 14px;
            font-size: 14px;
            cursor: pointer;
        }

        .btn-secondary {
            background: #fff;
            color: #111827;
        }

        .contract-header {
            border: 1px solid #374151;
            padding: 14px;
            margin-bottom: 18px;
        }

        .header-grid {
            display: grid;
            grid-template-columns: 1fr 140px 1fr;
            align-items: center;
            gap: 14px;
        }

        .logo-wrap {
            text-align: center;
        }

        .logo-wrap img {
            max-width: 120px;
            max-height: 80px;
            object-fit: contain;
        }

        .meta-list {
            font-size: 14px;
            line-height: 1.9;
        }

        .contract-title {
            text-align: center;
            font-size: 22px;
            margin: 16px 0;
            font-weight: 700;
        }

        .contract-body {
            border: 1px solid #e5e7eb;
            padding: 16px;
            font-size: 15px;
            line-height: 2;
        }

        .contract-body p {
            margin: 0 0 10px;
        }

        .signature-area {
            margin-top: 28px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
        }

        .signature-box {
            border-top: 1px solid #111827;
            padding-top: 10px;
            text-align: center;
            min-height: 70px;
            font-size: 14px;
        }

        @@media print {
            body {
                background: #fff;
            }

            .page {
                margin: 0;
                border: none;
                box-shadow: none;
                max-width: none;
                padding: 0;
            }

            .actions {
                display: none;
            }
        }
    </style>
</head>
<body>
    <div class="page">
        <div class="actions">
            <button class="btn" onclick="window.print()"><i class="fas fa-print"></i> طباعة</button>
            <button class="btn btn-secondary" onclick="window.close()">إغلاق</button>
        </div>

        @if (documentChrome != null)
        {
            <partial name="_CompanyDocumentChromeStart" model="documentChrome" />
        }
        else
        {
        <div class="contract-header">
            <div class="header-grid">
                <div class="meta-list">
                    <div><strong>تاريخ العقد:</strong> @contractDate.ToString("yyyy/MM/dd")</div>
                    <div><strong>رقم السجل:</strong> @recordNumber</div>
                    <div><strong>رقم الترخيص:</strong> @licenseNumber</div>
                </div>

                <div class="logo-wrap">
                    @if (!string.IsNullOrWhiteSpace(Model.Network?.LogoPath))
                    {
                        <img src="@Model.Network!.LogoPath" alt="شعار الشبكة" />
                    }
                    else
                    {
                        <div style="font-size:12px;color:#6b7280;">شعار الشبكة</div>
                    }
                </div>

                <div class="meta-list">
                    <div><strong>عنوان العقد:</strong> @contractTitle</div>
                    <div><strong>رقم المشترك:</strong> @(Model.SID ?? "-")</div>
                    <div><strong>اسم الشبكة:</strong> @(Model.Network?.Name ?? "-")</div>
                </div>
            </div>
        </div>
        }

        @if (documentChrome != null)
        {
            <div class="meta-list" style="margin-bottom:16px;font-size:14px;line-height:1.9;">
                <div><strong>تاريخ العقد:</strong> @contractDate.ToString("yyyy/MM/dd")</div>
                <div><strong>رقم السجل:</strong> @recordNumber</div>
                <div><strong>رقم الترخيص:</strong> @licenseNumber</div>
                <div><strong>رقم المشترك:</strong> @(Model.SID ?? "-")</div>
            </div>
        }

        <h1 class="contract-title">@contractTitle</h1>

        <div class="contract-body">
            @Html.Raw(contractBodyHtml)
        </div>

        <div class="signature-area">
            <div class="signature-box">
                توقيع وختم الشركة
            </div>
            <div class="signature-box">
                توقيع المشترك
            </div>
        </div>
        @if (documentChrome != null)
        {
            <partial name="_CompanyDocumentChromeEnd" model="documentChrome" />
        }
    </div>
</body>
</html>
