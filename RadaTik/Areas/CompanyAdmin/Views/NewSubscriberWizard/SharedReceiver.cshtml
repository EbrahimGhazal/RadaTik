@model RadaTik.Areas.CompanyAdmin.ViewModels.NewSubscriberWizardSharedReceiverViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-users text-info"></i> @ViewData["Title"]</h2>
    <a asp-action="Start" class="btn btn-outline-secondary"><i class="fas fa-arrow-right"></i> رجوع</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-header bg-info text-white">تحديد اللاقط المشترك (سيرفر → مرسل → لاقط)</div>
    <div class="card-body">
        <form asp-action="SharedReceiver" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">اسم السيرفر</label>
                    <select asp-for="MikroTikServerId" class="form-select" asp-items="Model.Servers" id="serverSelect">
                        <option value="">— الكل —</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">اسم المرسل</label>
                    <select asp-for="SectorId" class="form-select" asp-items="Model.Sectors" id="sectorSelect">
                        <option value="">— الكل —</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">اسم اللاقط <span class="text-danger">*</span></label>
                    <select name="receiverId" class="form-select" id="receiverSelect" required>
                        <option value="">— اختر —</option>
                        @foreach (var r in Model.Receivers)
                        {
                            <option value="@r.Id" selected="@(Model.ReceiverId == r.Id)">@r.Name — @r.ServerName / @r.SectorName</option>
                        }
                    </select>
                </div>
            </div>
            <button type="submit" class="btn btn-info mt-3"><i class="fas fa-arrow-left"></i> متابعة لبيانات المشترك</button>
        </form>
    </div>
</div>

@section Scripts {
<script>
$('#serverSelect').on('change', function () {
    const serverId = $(this).val();
    $('#sectorSelect').html('<option value="">— الكل —</option>');
    $('#receiverSelect').html('<option value="">— اختر —</option>');
    if (!serverId) return;
    $.get('@Url.Action("GetSectorsByServer")', { serverId }, function (data) {
        data.forEach(s => $('#sectorSelect').append(`<option value="${s.id}">${s.name}</option>`));
    });
    loadReceivers();
});
$('#sectorSelect').on('change', loadReceivers);
function loadReceivers() {
    $.get('@Url.Action("SearchSharedReceivers")', {
        serverId: $('#serverSelect').val() || null,
        sectorId: $('#sectorSelect').val() || null
    }, function (data) {
        const sel = $('#receiverSelect');
        sel.html('<option value="">— اختر —</option>');
        data.forEach(r => sel.append(`<option value="${r.id}">${r.name} — ${r.serverName} / ${r.sectorName}</option>`));
    });
}
</script>
}
