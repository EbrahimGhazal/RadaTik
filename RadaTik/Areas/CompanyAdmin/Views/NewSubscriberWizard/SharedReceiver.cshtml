@model RadaTik.Areas.CompanyAdmin.ViewModels.NewSubscriberWizardSharedReceiverViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-users text-info"></i> @ViewData["Title"]</h2>
    <a asp-route="@ViewData["WizardRoute"]" asp-route-action="Start" class="btn btn-outline-secondary"><i class="fas fa-arrow-right"></i> رجوع</a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-header bg-info text-white">تحديد اللاقط المشترك (سيرفر → مرسل → لاقط)</div>
    <div class="card-body">
        <form asp-route="@ViewData["WizardRoute"]" asp-route-action="SharedReceiver" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3" id="sharedReceiverLookups"
                 data-sectors-url="@Url.RouteUrl((string)ViewData["WizardRoute"]!, new { action = "GetSectorsByServer" })"
                 data-receivers-url="@Url.RouteUrl((string)ViewData["WizardRoute"]!, new { action = "SearchSharedReceivers" })">
                <div class="col-md-4">
                    <label class="form-label" for="serverSelect">اسم السيرفر</label>
                    <select asp-for="MikroTikServerId" class="form-select" asp-items="Model.Servers" id="serverSelect">
                        <option value="">— الكل —</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="sectorSelect">اسم المرسل</label>
                    <select asp-for="SectorId" class="form-select" asp-items="Model.Sectors" id="sectorSelect">
                        <option value="">— الكل —</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="receiverSelect">اسم اللاقط <span class="text-danger">*</span></label>
                    <select name="receiverId" class="form-select" id="receiverSelect" required>
                        <option value="">— اختر —</option>
                        @foreach (var r in Model.Receivers)
                        {
                            <option value="@r.Id" selected="@(Model.ReceiverId == r.Id)">@r.Name — @r.ServerName / @r.SectorName</option>
                        }
                    </select>
                    <div class="form-text text-muted" id="receiverLookupHint"></div>
                </div>
            </div>
            <button type="submit" class="btn btn-info mt-3"><i class="fas fa-arrow-left"></i> متابعة لبيانات المشترك</button>
        </form>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const lookups = document.getElementById('sharedReceiverLookups');
    const sectorsUrl = lookups && lookups.getAttribute('data-sectors-url');
    const receiversUrl = lookups && lookups.getAttribute('data-receivers-url');
    const $server = $('#serverSelect');
    const $sector = $('#sectorSelect');
    const $receiver = $('#receiverSelect');
    const hint = document.getElementById('receiverLookupHint');

    function pick(item, camel, pascal) {
        if (!item) return '';
        const value = item[camel];
        return value == null || value === '' ? (item[pascal] == null ? '' : item[pascal]) : value;
    }

    function refreshSelect($el) {
        if (!$el.length) return;
        if ($el.hasClass('select2-hidden-accessible')) {
            $el.trigger('change.select2');
        }
    }

    function replaceOptions($el, html) {
        const selected = $el.val();
        $el.html(html);
        if (selected && $el.find('option[value="' + selected + '"]').length) {
            $el.val(selected);
        }
        refreshSelect($el);
    }

    function setHint(text) {
        if (hint) hint.textContent = text || '';
    }

    function loadSectors() {
        if (!sectorsUrl) return;
        const serverId = $server.val() || '';
        $.get(sectorsUrl, serverId ? { serverId: serverId } : {})
            .done(function (data) {
                const rows = Array.isArray(data) ? data : [];
                let html = '<option value="">— الكل —</option>';
                rows.forEach(function (s) {
                    const id = pick(s, 'id', 'Id');
                    const name = pick(s, 'name', 'Name') || ('#' + id);
                    html += '<option value="' + id + '">' + name + '</option>';
                });
                replaceOptions($sector, html);
            })
            .fail(function () {
                setHint('تعذر تحميل المرسلين. أعد المحاولة.');
            });
    }

    function loadReceivers() {
        if (!receiversUrl) {
            setHint('تعذر تحديد مسار البحث عن اللواقط.');
            return;
        }
        setHint('جاري تحميل اللواقط...');
        $.get(receiversUrl, {
            serverId: $server.val() || '',
            sectorId: $sector.val() || ''
        })
            .done(function (data) {
                const rows = Array.isArray(data) ? data : [];
                let html = '<option value="">— اختر —</option>';
                rows.forEach(function (r) {
                    const id = pick(r, 'id', 'Id');
                    const name = pick(r, 'name', 'Name') || ('#' + id);
                    const serverName = pick(r, 'serverName', 'ServerName') || '—';
                    const sectorName = pick(r, 'sectorName', 'SectorName') || '—';
                    html += '<option value="' + id + '">' + name + ' — ' + serverName + ' / ' + sectorName + '</option>';
                });
                replaceOptions($receiver, html);
                if (rows.length === 0) {
                    setHint($sector.val()
                        ? 'لا يوجد لاقط مشترك على هذا المرسل.'
                        : 'لا توجد لواقط مشتركة ضمن التصفية الحالية.');
                } else {
                    setHint(rows.length === 1 ? 'لاقط واحد متاح.' : (rows.length + ' لواقط متاحة.'));
                }
            })
            .fail(function () {
                setHint('تعذر تحميل اللواقط. أعد المحاولة.');
            });
    }

    $server.on('change', function () {
        loadSectors();
        loadReceivers();
    });
    $sector.on('change', loadReceivers);
})();
</script>
}
