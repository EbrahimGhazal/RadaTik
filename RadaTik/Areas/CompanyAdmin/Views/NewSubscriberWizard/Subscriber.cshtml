@model RadaTik.Areas.CompanyAdmin.ViewModels.NewSubscriberWizardSubscriberFormModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-user-plus text-success"></i> @ViewData["Title"]</h2>
    <a asp-action="Start" class="btn btn-outline-secondary"><i class="fas fa-arrow-right"></i> رجوع</a>
</div>

<div class="alert alert-secondary mb-3">
    <i class="fas fa-info-circle"></i> المسار: <strong>@ViewBag.WizardPathLabel</strong>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-header bg-success text-white">الخطوة 2 — بيانات المشترك</div>
    <div class="card-body">
        <form asp-action="Subscriber" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Path" />
            <input type="hidden" asp-for="ReceiverId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="SID" class="form-label"></label>
                    <input asp-for="SID" class="form-control" />
                    <span asp-validation-for="SID" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="UserName" class="form-label"></label>
                    <input asp-for="UserName" class="form-control" />
                    <span asp-validation-for="UserName" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Password" class="form-label"></label>
                    <input asp-for="Password" type="password" class="form-control" />
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    @{
                        bool requireMikroTikServer = ViewBag.RequireMikroTikServer == true;
                        bool lockMikroTikServer = ViewBag.LockMikroTikServer == true;
                        bool profileSelectEnabled = ViewBag.ProfileSelectEnabled == true;
                    }
                    <label asp-for="MikroTikServerId" class="form-label">
                        خادم MikroTik
                        <span class="text-danger">*</span>
                    </label>
                    <select asp-for="MikroTikServerId" class="form-select" asp-items="ViewBag.MikroTikServers"
                            id="MikroTikServerId"
                            required="@requireMikroTikServer"
                            disabled="@lockMikroTikServer">
                        @if (!lockMikroTikServer)
                        {
                            <option value="">— اختر —</option>
                        }
                    </select>
                    @if (lockMikroTikServer)
                    {
                        <input type="hidden" name="MikroTikServerId" value="@Model.MikroTikServerId" />
                    }
                    <span asp-validation-for="MikroTikServerId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ProfileId" class="form-label">
                        البروفايل
                        <span class="text-danger">*</span>
                    </label>
                    <div class="input-group">
                        <select asp-for="ProfileId" class="form-select" asp-items="ViewBag.Profiles" id="ProfileId"
                                required="@profileSelectEnabled"
                                disabled="@(!profileSelectEnabled)">
                            <option value="">@(profileSelectEnabled ? "— اختر —" : "اختر خادم MikroTik أولاً")</option>
                        </select>
                        <button type="button" class="btn btn-outline-secondary" id="btnRefreshProfiles" title="تحديث القائمة من قاعدة البيانات" disabled="@(!profileSelectEnabled)">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                    </div>
                    <div class="d-flex flex-wrap gap-2 mt-1 small">
                        <a class="text-decoration-none" id="linkCreateProfile" href="#" target="_blank" rel="noopener" style="display:none;">
                            <i class="fas fa-plus-circle"></i> إضافة بروفايل للسيرفر
                        </a>
                        <span class="text-muted" id="profileLoadHint"></span>
                    </div>
                    <span asp-validation-for="ProfileId" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="PhoneNumber" class="form-label"></label>
                    <input asp-for="PhoneNumber" class="form-control" />
                    <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="ResidenceAddress" class="form-label">الموقع</label>
                    <input asp-for="ResidenceAddress" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="Occupation" class="form-label"></label>
                    <input asp-for="Occupation" class="form-control" placeholder="موظف، تاجر، طالب..." />
                    <span asp-validation-for="Occupation" class="text-danger small"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Workplace" class="form-label"></label>
                    <input asp-for="Workplace" class="form-control" placeholder="اسم الشركة أو الجهة" />
                    <span asp-validation-for="Workplace" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="ServiceStartDate" class="form-label"></label>
                    <input asp-for="ServiceStartDate" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="AccountExpirationDate" class="form-label"></label>
                    <input asp-for="AccountExpirationDate" type="date" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label asp-for="DbUserName" class="form-label">حساب النظام (اختياري)</label>
                    <input asp-for="DbUserName" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="DbPassword" class="form-label">كلمة مرور النظام (اختياري)</label>
                    <input asp-for="DbPassword" type="password" class="form-control" />
                </div>
                <div class="col-12">
                    <div class="border rounded p-3">
                        <div class="form-check form-switch radtk-switch-left-label mb-2" dir="ltr">
                            <label asp-for="IsVip" class="form-check-label">مشترك مميز (VIP)</label>
                            <input asp-for="IsVip" class="form-check-input" />
                        </div>
                        <div class="form-group mb-0">
                            <label asp-for="VipNote" class="form-label"></label>
                            <input asp-for="VipNote" class="form-control" placeholder="شريك، موظف، عائلة..." maxlength="200" />
                            <span asp-validation-for="VipNote" class="text-danger small"></span>
                        </div>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch radtk-switch-left-label mb-3" dir="ltr">
                        <label asp-for="IsActive" class="form-check-label">تفعيل المشترك</label>
                        <input asp-for="IsActive" class="form-check-input" />
                    </div>
                </div>
            </div>

            <button type="submit" class="btn btn-success mt-3">
                <i class="fas fa-save"></i> حفظ والانتقال للفاتورة
            </button>
        </form>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
    <script>
        $(function () {
            const $server = $('#MikroTikServerId');
            const $profile = $('#ProfileId');
            const $refresh = $('#btnRefreshProfiles');
            const $create = $('#linkCreateProfile');
            const $hint = $('#profileLoadHint');
            const profilesUrl = '@Url.Action("GetProfilesByServer", "NewSubscriberWizard", new { area = ViewContext.RouteData.Values["area"] })';
            const profileCreateBase = '@Url.Action("Create", "Profile")';

            if (!$server.length || !$profile.length) {
                return;
            }

            function rebuildSelect2($el) {
                if ($el.hasClass('select2-hidden-accessible')) {
                    $el.select2('destroy');
                }
                if (window.CommonUtils && typeof CommonUtils.initSelect2 === 'function') {
                    CommonUtils.initSelect2();
                }
            }

            function setHint(text, isError) {
                $hint.text(text || '')
                    .toggleClass('text-danger', !!isError)
                    .toggleClass('text-muted', !isError);
            }

            function setCreateLink(serverId) {
                if (!$create.length) return;
                if (!serverId) {
                    $create.hide();
                    return;
                }
                $create.show().attr('href', profileCreateBase + '?serverId=' + encodeURIComponent(serverId));
            }

            function setProfileEnabled(enabled) {
                $profile.prop('disabled', !enabled);
                $profile.prop('required', enabled);
                $refresh.prop('disabled', !enabled);
            }

            function fillProfileOptions(placeholder, profiles, selectedId) {
                $profile.empty().append($('<option>', { value: '', text: placeholder }));
                if (profiles && profiles.length) {
                    $.each(profiles, function (_, profile) {
                        const id = profile.id ?? profile.Id;
                        $profile.append($('<option>', {
                            value: id,
                            text: profile.name ?? profile.Name ?? '',
                            selected: selectedId && String(id) === String(selectedId)
                        }));
                    });
                }
                rebuildSelect2($profile);
            }

            function loadProfilesFromDatabase() {
                const serverId = $server.val();
                setCreateLink(serverId);

                if (!serverId) {
                    fillProfileOptions('اختر خادم MikroTik أولاً', [], null);
                    setProfileEnabled(false);
                    rebuildSelect2($profile);
                    setHint('حدد خادم MikroTik لعرض بروفايلاته من قاعدة البيانات.');
                    return;
                }

                const selectedId = $profile.val();
                setProfileEnabled(true);
                fillProfileOptions('جاري تحميل البروفايلات...', [], null);
                setHint('جاري الاستعلام من قاعدة البيانات...');

                $.ajax({
                    url: profilesUrl,
                    type: 'GET',
                    cache: false,
                    dataType: 'json',
                    data: { serverId: serverId },
                    success: function (profiles) {
                        if (!profiles || !profiles.length) {
                            fillProfileOptions('لا توجد بروفايلات لهذا السيرفر', [], null);
                            setHint('لا بروفايلات لهذا الخادم في قاعدة البيانات. أضف بروفايلاً ثم حدّث القائمة.', true);
                            return;
                        }

                        fillProfileOptions('— اختر —', profiles, selectedId);
                        setHint(profiles.length + ' بروفايل من قاعدة البيانات لهذا الخادم.');
                    },
                    error: function () {
                        fillProfileOptions('تعذر تحميل البروفايلات', [], null);
                        setHint('تعذر التحميل من قاعدة البيانات. جرّب تحديث الصفحة.', true);
                    }
                });
            }

            $server.on('change', loadProfilesFromDatabase);
            $refresh.on('click', loadProfilesFromDatabase);

            if ($server.val()) {
                loadProfilesFromDatabase();
            } else {
                setProfileEnabled(false);
                setHint('حدد خادم MikroTik لعرض بروفايلاته من قاعدة البيانات.');
            }
        });
    </script>
}

