@model RadaTik.Areas.CompanyAdmin.ViewModels.NewSubscriberWizardCompleteViewModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? "CompanyAdmin";
    var isCompanyAdmin = string.Equals(area, "CompanyAdmin", StringComparison.OrdinalIgnoreCase);
}

<div class="text-center py-4">
    <div class="display-4 text-success mb-3"><i class="fas fa-check-circle"></i></div>
    <h2>@ViewData["Title"]</h2>
    <p class="lead">@Model.ClientName</p>

    @if (Model.RequiresManagerApproval)
    {
        <div class="alert alert-warning mx-auto" style="max-width: 560px;">
            المشترك بانتظار <strong>موافقة مدير الشركة</strong>. بعد الاعتماد يُنشأ الحساب على سيرفر MikroTik مباشرة، ثم أصدر فاتورة التجهيز وحصّل المبلغ.
        </div>
    }
    else if (Model.InvoiceFinalized && Model.PaymentRecorded)
    {
        <div class="alert alert-success mx-auto" style="max-width: 560px;">
            تم إصدار الفاتورة، خصم المستودع، وتسجيل التحصيل في حساب المشترك.
        </div>
    }
    else if (Model.InvoiceFinalized)
    {
        <div class="alert alert-info mx-auto" style="max-width: 560px;">
            تم إصدار الفاتورة وخصم المستودع. يمكنك تحصيل المبلغ لاحقاً من فاتورة التجهيز.
        </div>
    }

    <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
        @if (isCompanyAdmin)
        {
            <a asp-route="networkManager-clients" asp-route-action="Details" asp-route-id="@Model.ClientId" class="btn btn-primary">
                <i class="fas fa-user"></i> ملف المشترك
            </a>
            <a asp-route="networkManager-subscriber-installation-invoices" asp-route-action="Details" asp-route-id="@Model.InvoiceId" class="btn btn-outline-primary">
                <i class="fas fa-file-invoice"></i> فاتورة التجهيز
            </a>
            <a asp-route="networkManager-clients" asp-route-action="Index" asp-route-id="" class="btn btn-secondary">
                قائمة المشتركين
            </a>
            <a asp-route="networkManager-new-subscriber-wizard" asp-route-action="Index" asp-route-id="" class="btn btn-success">
                <i class="fas fa-user-plus"></i> مشترك آخر
            </a>
        }
        else
        {
            <a asp-area="@area" asp-controller="Clients" asp-action="Details" asp-route-id="@Model.ClientId" class="btn btn-primary">
                <i class="fas fa-user"></i> ملف المشترك
            </a>
            <a asp-route="networkManager-subscriber-installation-invoices" asp-route-action="Details" asp-route-id="@Model.InvoiceId" class="btn btn-outline-primary">
                <i class="fas fa-file-invoice"></i> فاتورة التجهيز
            </a>
            <a asp-area="@area" asp-controller="Clients" asp-action="Index" class="btn btn-secondary">
                قائمة المشتركين
            </a>
            <a asp-route="employee-new-subscriber-wizard" asp-route-action="Index" asp-route-id="" class="btn btn-success">
                <i class="fas fa-user-plus"></i> مشترك آخر
            </a>
        }
    </div>
</div>
