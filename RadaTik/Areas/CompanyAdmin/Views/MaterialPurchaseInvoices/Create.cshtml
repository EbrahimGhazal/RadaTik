@using RadaTik.Areas.CompanyAdmin.ViewModels
@using RadaTik.Helpers
@using RadaTik.Models
@using RadaTik.Models.Business
@using System.Globalization
@model MaterialPurchaseInvoiceFormViewModel
@{
    ViewData["Title"] = "فاتورة شراء مواد";
    var companyName = ViewBag.CompanyName as string ?? "";
    var items = Model.WarehouseItems;
    var requireExplicitChoice = true;
    var cashSyp = ViewBag.CashBoxBalanceSyp as decimal? ?? 0m;
    var cashUsd = ViewBag.CashBoxBalanceUsd as decimal? ?? 0m;
    var showCashShortfall = ViewBag.ShowCashShortfallConfirm as bool? ?? false;
    var cashShortfallMessage = ViewBag.CashShortfallMessage as string;
    var cashRequired = ViewBag.CashShortfallRequired as decimal?;
    var cashAvailable = ViewBag.CashShortfallAvailable as decimal?;
    var cashCurrency = ViewBag.CashShortfallCurrency as PricingCurrency? ?? Model.Currency ?? PricingCurrency.SYP_New;
    var indexUrl = Url.Action("Index") ?? "";
}

<div class="financial-page financial-hub-page material-invoice-page material-invoice-page--purchase material-invoice-page--create">
    <partial name="_WarehouseSubNav" />

    <div class="sys-hero material-invoice-hero mb-3">
        <div class="sys-hero-main">
            <div class="sys-hero-icon"><i class="fas fa-cart-plus"></i></div>
            <div>
                <h1 class="sys-hero-title mb-1">@ViewData["Title"]</h1>
                <p class="sys-hero-subtitle mb-0">@companyName</p>
            </div>
        </div>
        <div class="sys-hero-chips">
            <span class="sys-hero-chip"><i class="fas fa-warehouse"></i> شراء / إدخال</span>
        </div>
    </div>

    @if (TempData["Error"] != null) { <div class="alert alert-danger mb-3">@TempData["Error"]</div> }
    @if (showCashShortfall)
    {
        <div class="alert alert-warning material-invoice-cash-shortfall mb-3" role="alert">
            <h2 class="h6 mb-2"><i class="fas fa-triangle-exclamation me-1"></i> قيمة الفاتورة أكبر من رصيد الصندوق</h2>
            <p class="mb-2">@(cashShortfallMessage ?? "لا يكفي رصيد الصندوق لتسجيل الفاتورة كمدفوعة.")</p>
            @if (cashRequired.HasValue && cashAvailable.HasValue)
            {
                <p class="mb-3 small mb-0">
                    المطلوب: <strong>@CurrencyHelper.FormatAmount(cashRequired.Value, cashCurrency)</strong>
                    — المتوفر في الصندوق: <strong>@CurrencyHelper.FormatAmount(cashAvailable.Value, cashCurrency)</strong>
                </p>
            }
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="button" class="btn btn-warning" data-cash-shortfall-save-unpaid>
                    <i class="fas fa-file-invoice-dollar me-1"></i> حفظ كغير مدفوعة
                </button>
                <a class="btn btn-outline-secondary" href="@indexUrl">
                    <i class="fas fa-ban me-1"></i> إلغاء الفاتورة
                </a>
            </div>
        </div>
    }

    <details class="material-invoice-help mb-3">
        <summary class="material-invoice-help__summary"><i class="fas fa-circle-info"></i> مساعدة وإرشادات</summary>
        <div class="material-invoice-help__body">
            <partial name="_BusinessModuleGuide" />
            <partial name="_WarehouseUsageHints" />
            @{ ViewData["SypNoteText"] = "حقول الجملة والمفرق (ل.س.ج) بالليرة السورية الجديدة."; }
            <partial name="_SypCurrencyPageNote" />
        </div>
    </details>

    <form method="post" id="purchase-form" class="material-invoice-form" data-syp-page-amount-note="true"
          data-cash-syp="@cashSyp.ToString(CultureInfo.InvariantCulture)"
          data-cash-usd="@cashUsd.ToString(CultureInfo.InvariantCulture)"
          data-usd-currency="@((int)PricingCurrency.USD)"
          data-index-url="@indexUrl">
        @Html.AntiForgeryToken()
        <input type="hidden" name="cashShortfallAction" id="cashShortfallAction" value="" />

        <div class="card material-invoice-section material-invoice-section--meta border-0 shadow-sm mb-3">
            <div class="card-header material-invoice-section__header py-2">
                <h2 class="h6 mb-0"><i class="fas fa-file-invoice me-1"></i> بيانات الفاتورة</h2>
            </div>
            <div class="card-body py-3">
                <div class="row g-2 g-md-3 material-invoice-meta-row">
                    <div class="col-12 col-sm-6 col-lg-3">
                        <label class="form-label form-label-sm mb-1">تاريخ الفاتورة</label>
                        <input type="date" name="invoiceDate" class="form-control form-control-sm" value="@Model.InvoiceDate.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-12 col-sm-6 col-lg-4">
                        <label class="form-label form-label-sm mb-1">مورد ERP</label>
                        @{
                            var erpSuppliers = ViewBag.ErpSuppliers as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
                        }
                        <select name="erpSupplierId" class="form-select form-select-sm mb-1">
                            <option value="">— اختر من سجل ERP —</option>
                            @foreach (var s in erpSuppliers)
                            {
                                <option value="@s.Value" selected="@(Model.ErpSupplierId?.ToString() == s.Value)">@s.Text</option>
                            }
                        </select>
                        <label class="form-label form-label-sm mb-1 text-muted">أو اسم حر</label>
                        <input name="supplierName" class="form-control form-control-sm" value="@Model.SupplierName" maxlength="120" placeholder="اسم المورد" />
                    </div>
                    <div class="col-12 col-lg-5">
                        <label class="form-label form-label-sm mb-1">ملاحظات</label>
                        <input name="notes" class="form-control form-control-sm" value="@Model.Notes" maxlength="500" placeholder="اختياري" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card material-invoice-section material-invoice-section--choices border-0 shadow-sm mb-3">
            <div class="card-body p-3">
                <div class="row g-3 material-invoice-choice-row">
                    <div class="col-12 col-lg-6">
                        @{
                            ViewData["MaterialInvoiceRequireExplicitChoice"] = requireExplicitChoice;
                            ViewData["CurrencySelected"] = Model.Currency;
                        }
                        <partial name="_MaterialInvoiceCurrencyPanel" />
                    </div>
                    <div class="col-12 col-lg-6">
                        @{
                            ViewData["MaterialInvoiceRequireExplicitChoice"] = requireExplicitChoice;
                            ViewData["PaymentStatus"] = Model.PaymentStatus;
                            ViewData["MaterialInvoiceKind"] = "purchase";
                        }
                        <partial name="_MaterialInvoicePaymentPanel" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card material-invoice-section material-invoice-section--lines border-0 shadow-sm mb-3">
            <div class="card-header material-invoice-section__header py-2 d-flex justify-content-between align-items-center flex-wrap gap-2">
                <h2 class="h6 mb-0"><i class="fas fa-list me-1"></i> بنود الشراء</h2>
                <button type="button" class="btn btn-sm btn-primary" id="add-line"><i class="fas fa-plus"></i> بند</button>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive material-invoice-lines-shell">
                    <table class="table table-sm mb-0 material-invoice-lines-table material-invoice-lines-table--compact" id="lines-table">
                        <colgroup>
                            <col class="mat-col-wh" />
                            <col class="mat-col-name" />
                            <col class="mat-col-model" />
                            <col class="mat-col-unit" />
                            <col class="mat-col-per" />
                            <col class="mat-col-qty" />
                            <col class="mat-col-price" />
                            <col class="mat-col-wholesale" />
                            <col class="mat-col-retail" />
                            <col class="mat-col-actions" />
                        </colgroup>
                        <thead>
                            <tr class="material-invoice-lines-table__groups">
                                <th colspan="4" class="mat-th-group">الصنف</th>
                                <th colspan="2" class="mat-th-group">الكميات</th>
                                <th colspan="3" class="mat-th-group">التسعير</th>
                                <th class="mat-th-group mat-th-group--actions"></th>
                            </tr>
                            <tr class="material-invoice-lines-table__cols">
                                <th title="من المستودع أو مادة جديدة">المستودع</th>
                                <th title="يُعبَّأ تلقائياً عند اختيار صنف">الاسم</th>
                                <th>الموديل</th>
                                <th>الوحدة</th>
                                <th title="قطع داخل الكرتونة/العلبة">قطع/وحدة</th>
                                <th title="عدد الكرتونات أو العلب أو القطع">العدد</th>
                                <th title="سعر وحدة الشراء">سعر الشراء</th>
                                <th title="سعر الجملة للقطعة">جملة</th>
                                <th title="سعر المفرق للقطعة">مفرق</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody id="lines-body"></tbody>
                    </table>
                </div>
                <div class="px-3 py-2 border-top material-invoice-lines-formula small text-muted">
                    <i class="fas fa-calculator me-1"></i>
                    قطع المخزون = العدد × قطع/وحدة
                    <span class="text-muted">(قطعة: قطع/وحدة = 1)</span>
                </div>
            </div>
        </div>

        <div class="material-invoice-actions">
            <button type="submit" class="btn btn-primary btn-lg micro-btn"><i class="fas fa-save"></i> حفظ وإدخال للمستودع</button>
            <a class="btn btn-outline-secondary btn-lg micro-btn" asp-action="Index">إلغاء</a>
        </div>
    </form>
</div>

<div class="modal fade" id="cashShortfallModal" tabindex="-1" aria-labelledby="cashShortfallModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title h5" id="cashShortfallModalLabel">قيمة الفاتورة أكبر من رصيد الصندوق</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">لا يمكن تسجيل الفاتورة كـ <strong>مدفوعة</strong> لأن مبلغها أكبر من الرصيد الحالي للصندوق.</p>
                <ul class="mb-0">
                    <li>المطلوب: <strong data-cash-shortfall-required>—</strong></li>
                    <li>رصيد الصندوق: <strong data-cash-shortfall-available>—</strong></li>
                </ul>
                <p class="text-muted small mt-3 mb-0">يمكنك حفظ الفاتورة كغير مدفوعة (بدون خصم من الصندوق) أو إلغاء حفظها.</p>
            </div>
            <div class="modal-footer justify-content-between flex-wrap gap-2">
                <button type="button" class="btn btn-outline-secondary" data-cash-shortfall-abort>
                    <i class="fas fa-ban me-1"></i> إلغاء الفاتورة
                </button>
                <button type="button" class="btn btn-warning" data-cash-shortfall-save-unpaid>
                    <i class="fas fa-file-invoice-dollar me-1"></i> حفظ كغير مدفوعة
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<partial name="_MaterialInvoiceChoicePanelsScript" />
<script>
(function () {
    const items = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(items.Select(i => new {
        id = i.Id,
        name = i.Name,
        modelNumber = i.ModelNumber,
        wholesalePrice = i.WholesalePrice,
        retailPrice = i.RetailPrice
    })));
    const postedLines = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model.Lines ?? []).Select(l => new {
        warehouseItemId = l.WarehouseItemId,
        itemName = l.ItemName,
        modelNumber = l.ModelNumber,
        packageUnit = (int)l.PackageUnit,
        unitsPerPackage = l.UnitsPerPackage,
        packageQuantity = l.PackageQuantity,
        unitPrice = l.UnitPrice,
        wholesalePrice = l.WholesalePrice,
        retailPrice = l.RetailPrice
    })));
    const showCashShortfall = @(showCashShortfall ? "true" : "false");
    let lineIndex = 0;
    const body = document.getElementById('lines-body');

    function unitOptions(selected) {
        const units = [
            { v: 0, t: 'قطعة' },
            { v: 1, t: 'علبة' },
            { v: 2, t: 'كرتونة' },
            { v: 3, t: 'ربطة' }
        ];
        return units.map(u => `<option value="${u.v}" ${u.v === selected ? 'selected' : ''}>${u.t}</option>`).join('');
    }

    function itemOptions(selectedId) {
        let html = '<option value="">— مادة جديدة —</option>';
        items.forEach(i => {
            html += `<option value="${i.id}" ${i.id === selectedId ? 'selected' : ''}>${i.name}${i.modelNumber ? ' (' + i.modelNumber + ')' : ''}</option>`;
        });
        return html;
    }

    const unitPricePlaceholders = {
        '0': 'سعر القطعة الواحدة',
        '1': 'سعر العلبة',
        '2': 'سعر الكرتونة',
        '3': 'سعر الربطة'
    };
    const unitQtyPlaceholders = {
        '0': 'عدد القطع',
        '1': 'عدد العلب',
        '2': 'عدد الكرتونات',
        '3': 'عدد الربطات'
    };

    function syncLineUi(tr) {
        if (!tr) return;
        syncPerPackageForRow(tr);

        const unitSelect = tr.querySelector('.unit-select');
        const unitVal = unitSelect?.value ?? '0';
        const isPiece = unitVal === '0';
        const perPkgInput = tr.querySelector('[data-units-per-package-input]') || tr.querySelector('.per-pkg');
        const qtyInput = tr.querySelector('.pkg-qty');
        const unitPriceInput = tr.querySelector('.unit-price');
        const whSelect = tr.querySelector('.wh-select');
        const nameHint = tr.querySelector('.material-line-name-hint');
        const stockPreview = tr.querySelector('.material-line-stock-preview');

        if (unitPriceInput) {
            unitPriceInput.placeholder = unitPricePlaceholders[unitVal] || 'سعر وحدة الشراء';
        }
        if (qtyInput) {
            qtyInput.placeholder = unitQtyPlaceholders[unitVal] || 'عدد الوحدات';
        }

        const perPkg = isPiece ? 1 : (parseInt(perPkgInput?.value || '0', 10) || 0);
        const qty = parseFloat(qtyInput?.value || '0');
        let pieces = 0;
        if (qty > 0) {
            pieces = isPiece ? qty : (perPkg > 0 ? qty * perPkg : 0);
        }
        if (stockPreview) {
            if (pieces > 0) {
                const shown = pieces % 1 === 0 ? pieces : pieces.toFixed(3).replace(/\.?0+$/, '');
                stockPreview.textContent = '≈ ' + shown + ' قطعة';
                stockPreview.classList.remove('d-none');
            } else {
                stockPreview.textContent = '';
                stockPreview.classList.add('d-none');
            }
        }

        const isExisting = !!(whSelect?.value);
        if (nameHint) {
            nameHint.textContent = isExisting ? 'من المستودع' : 'مطلوب';
            nameHint.classList.toggle('text-primary', !isExisting);
            nameHint.classList.toggle('text-muted', isExisting);
        }
    }

    function addLine(seed) {
        const idx = lineIndex++;
        const selectedWh = seed && seed.warehouseItemId ? seed.warehouseItemId : null;
        const selectedUnit = seed && seed.packageUnit != null ? seed.packageUnit : 0;
        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td data-label="المستودع" class="mat-cell-wh">
                <select name="lines[${idx}].WarehouseItemId" class="form-select form-select-sm wh-select" title="صنف مسجّل أو مادة جديدة">${itemOptions(selectedWh)}</select>
            </td>
            <td data-label="الاسم" class="mat-cell-name">
                <input name="lines[${idx}].ItemName" class="form-control form-control-sm name-input" required maxlength="120" placeholder="اسم المادة" />
                <small class="material-line-name-hint text-muted">مطلوب</small>
            </td>
            <td data-label="الموديل" class="mat-cell-model">
                <input name="lines[${idx}].ModelNumber" class="form-control form-control-sm model-input" maxlength="60" placeholder="—" />
            </td>
            <td data-label="الوحدة" class="mat-cell-unit">
                <select name="lines[${idx}].PackageUnit" class="form-select form-select-sm unit-select">${unitOptions(selectedUnit)}</select>
            </td>
            <td data-label="قطع/وحدة" class="material-per-pkg-cell mat-cell-per" data-units-per-package-cell>
                <input name="lines[${idx}].UnitsPerPackage" type="number" min="1" step="1" value="1"
                       class="form-control form-control-sm per-pkg" data-units-per-package-input
                       data-syp-skip-format="true" title="قطع داخل الوحدة" />
            </td>
            <td data-label="العدد" class="mat-cell-qty">
                <div class="mat-qty-wrap">
                    <input name="lines[${idx}].PackageQuantity" type="number" step="0.001" min="0.001" required
                           class="form-control form-control-sm pkg-qty" data-syp-skip-format="true" placeholder="العدد" />
                    <span class="material-line-stock-preview badge text-bg-success-subtle border border-success-subtle d-none" aria-live="polite"></span>
                </div>
            </td>
            <td data-label="سعر الشراء" class="mat-cell-price">
                <input name="lines[${idx}].UnitPrice" type="number" step="0.01" min="0" required
                       class="form-control form-control-sm unit-price" placeholder="السعر" />
            </td>
            <td data-label="جملة" class="mat-cell-wholesale">
                <input name="lines[${idx}].WholesalePrice" type="number" step="0.01" min="0" class="form-control form-control-sm wh-price" placeholder="—" />
            </td>
            <td data-label="مفرق" class="mat-cell-retail">
                <input name="lines[${idx}].RetailPrice" type="number" step="0.01" min="0" class="form-control form-control-sm rt-price" placeholder="—" />
            </td>
            <td data-label="" class="mat-cell-actions text-center">
                <button type="button" class="btn btn-sm btn-outline-danger remove-line px-2" title="حذف">&times;</button>
            </td>`;
        body.appendChild(tr);

        const whSelect = tr.querySelector('.wh-select');
        const unitSelect = tr.querySelector('.unit-select');

        function syncFromWarehouse() {
            const id = parseInt(whSelect.value || '0', 10);
            const found = items.find(x => x.id === id);
            const nameInput = tr.querySelector('.name-input');
            const modelInput = tr.querySelector('.model-input');
            if (found) {
                nameInput.value = found.name;
                nameInput.readOnly = true;
                modelInput.value = found.modelNumber || '';
                modelInput.readOnly = true;
                if (found.wholesalePrice) tr.querySelector('.wh-price').value = found.wholesalePrice;
                if (found.retailPrice) tr.querySelector('.rt-price').value = found.retailPrice;
            } else {
                nameInput.value = '';
                nameInput.readOnly = false;
                modelInput.value = '';
                modelInput.readOnly = false;
            }
            syncLineUi(tr);
        }

        if (seed) {
            if (seed.itemName) tr.querySelector('.name-input').value = seed.itemName;
            if (seed.modelNumber) tr.querySelector('.model-input').value = seed.modelNumber;
            if (seed.warehouseItemId) {
                tr.querySelector('.name-input').readOnly = true;
                tr.querySelector('.model-input').readOnly = true;
            }
            if (seed.unitsPerPackage) tr.querySelector('.per-pkg').value = seed.unitsPerPackage;
            if (seed.packageQuantity) tr.querySelector('.pkg-qty').value = seed.packageQuantity;
            if (seed.unitPrice != null) tr.querySelector('.unit-price').value = seed.unitPrice;
            if (seed.wholesalePrice) tr.querySelector('.wh-price').value = seed.wholesalePrice;
            if (seed.retailPrice) tr.querySelector('.rt-price').value = seed.retailPrice;
        }

        whSelect.addEventListener('change', syncFromWarehouse);
        unitSelect.addEventListener('change', () => syncLineUi(tr));
        tr.querySelector('.pkg-qty')?.addEventListener('input', () => syncLineUi(tr));
        tr.querySelector('[data-units-per-package-input]')?.addEventListener('input', () => syncLineUi(tr));
        tr.querySelector('.per-pkg')?.addEventListener('input', () => syncLineUi(tr));
        tr.querySelector('.remove-line').addEventListener('click', () => tr.remove());
        syncLineUi(tr);
    }

    function syncPerPackageForRow(tr) {
        if (!tr) return;
        const unitSelect = tr.querySelector('.unit-select');
        const cell = tr.querySelector('[data-units-per-package-cell]');
        const isPiece = !unitSelect || unitSelect.value === '0' || unitSelect.value === '';

        const native = cell?.querySelector('input[data-units-per-package-input]')
            || cell?.querySelector('input.per-pkg[type="number"]');
        const display = cell?.querySelector('.fmt-number-display');
        const hidden = cell?.querySelector('.fmt-number-value[name*="UnitsPerPackage"]');
        const editors = [native, display].filter(Boolean);

        if (isPiece) {
            cell?.classList.add('material-per-pkg--locked');
            editors.forEach(el => {
                el.readOnly = true;
                el.removeAttribute('disabled');
                el.setAttribute('aria-disabled', 'true');
            });
            if (native) native.value = '1';
            if (display) display.value = '1';
            if (hidden) hidden.value = '1';
            if (cell) cell.title = 'عند «قطعة» يكون العدد 1 دائماً';
        } else {
            cell?.classList.remove('material-per-pkg--locked');
            editors.forEach(el => {
                el.readOnly = false;
                el.removeAttribute('disabled');
                el.removeAttribute('aria-disabled');
            });
            if (cell) cell.title = 'عدد القطع داخل العلبة أو الكرتونة (مثال: 16)';
        }
    }

    document.getElementById('lines-body').addEventListener('change', function (e) {
        const tr = e.target.closest('tr');
        if (!tr) return;
        if (e.target.classList.contains('unit-select') || e.target.classList.contains('wh-select')) {
            syncLineUi(tr);
        }
    });
    document.getElementById('lines-body').addEventListener('input', function (e) {
        const tr = e.target.closest('tr');
        if (!tr) return;
        if (e.target.classList.contains('pkg-qty') || e.target.classList.contains('per-pkg')
            || e.target.hasAttribute('data-units-per-package-input')) {
            syncLineUi(tr);
        }
    });

    document.getElementById('add-line').addEventListener('click', function () { addLine(); });
    if (postedLines && postedLines.length) {
        postedLines.forEach(function (line) { addLine(line); });
    } else {
        addLine();
    }

    setTimeout(function () {
        document.querySelectorAll('#lines-body tr').forEach(syncLineUi);
    }, 400);

    const form = document.getElementById('purchase-form');
    const modalEl = document.getElementById('cashShortfallModal');

    function parseNum(el) {
        if (!el) return NaN;
        const wrap = el.closest('.syp-amount-field');
        const hidden = wrap && wrap.querySelector('.syp-amount-value');
        const raw = (hidden && hidden.value) || el.value || '';
        return parseFloat(String(raw).replace(/,/g, ''));
    }

    function invoiceTotal() {
        let total = 0;
        document.querySelectorAll('#lines-body tr').forEach(function (tr) {
            const qty = parseNum(tr.querySelector('.pkg-qty'));
            const price = parseNum(tr.querySelector('.unit-price'));
            if (isFinite(qty) && isFinite(price) && qty > 0 && price >= 0) {
                total += qty * price;
            }
        });
        return total;
    }

    function isUsdCurrency() {
        const usdVal = form.dataset.usdCurrency || '2';
        const checked = form.querySelector('input[name="currency"]:checked');
        return !!(checked && checked.value === usdVal);
    }

    function cashBalance() {
        return isUsdCurrency()
            ? parseFloat(form.dataset.cashUsd || '0')
            : parseFloat(form.dataset.cashSyp || '0');
    }

    function formatAmt(n, usd) {
        if (!isFinite(n)) return '—';
        const parts = n.toFixed(2).split('.');
        parts[0] = parts[0].replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        return parts.join('.') + (usd ? ' $' : ' ل.س.ج');
    }

    function saveAsUnpaid() {
        const unpaid = form.querySelector('input[name="paymentStatus"][value="unpaid"]');
        if (unpaid) {
            unpaid.checked = true;
            unpaid.dispatchEvent(new Event('change', { bubbles: true }));
        }
        const action = document.getElementById('cashShortfallAction');
        if (action) action.value = 'saveUnpaid';
        form.dataset.cashGuardBypass = '1';
        if (modalEl && window.bootstrap) {
            bootstrap.Modal.getOrCreateInstance(modalEl).hide();
        }
        form.requestSubmit();
    }

    function abortInvoice() {
        const url = form.dataset.indexUrl;
        if (url) window.location.href = url;
    }

    form.addEventListener('submit', function (e) {
        if (e.defaultPrevented || form.dataset.cashGuardBypass === '1') return;
        const paid = form.querySelector('input[name="paymentStatus"][value="paid"]:checked');
        if (!paid) return;
        const total = invoiceTotal();
        const cash = cashBalance();
        if (!(isFinite(total) && isFinite(cash) && total > cash)) return;
        e.preventDefault();
        const usd = isUsdCurrency();
        if (modalEl) {
            const req = modalEl.querySelector('[data-cash-shortfall-required]');
            const avail = modalEl.querySelector('[data-cash-shortfall-available]');
            if (req) req.textContent = formatAmt(total, usd);
            if (avail) avail.textContent = formatAmt(cash, usd);
            if (window.bootstrap) bootstrap.Modal.getOrCreateInstance(modalEl).show();
        }
    });

    document.querySelectorAll('[data-cash-shortfall-save-unpaid]').forEach(function (btn) {
        btn.addEventListener('click', saveAsUnpaid);
    });
    document.querySelectorAll('[data-cash-shortfall-abort]').forEach(function (btn) {
        btn.addEventListener('click', abortInvoice);
    });

    if (showCashShortfall && modalEl && window.bootstrap) {
        const usd = isUsdCurrency();
        const req = modalEl.querySelector('[data-cash-shortfall-required]');
        const avail = modalEl.querySelector('[data-cash-shortfall-available]');
        if (req) req.textContent = formatAmt(invoiceTotal(), usd);
        if (avail) avail.textContent = formatAmt(cashBalance(), usd);
        bootstrap.Modal.getOrCreateInstance(modalEl).show();
    }
})();
</script>
}
