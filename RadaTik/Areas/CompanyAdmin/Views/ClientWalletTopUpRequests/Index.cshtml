@model IEnumerable<RadaTik.Models.ClientWalletTopUpRequest>
@using RadaTik.Helpers
@using RadaTik.Models
@{
    ViewData["Title"] = "طلبات تغذية رصيد للمشتركين";
    var companyName = ViewBag.CompanyName as string ?? "";
    var selectedStatus = ViewBag.SelectedStatus as ClientWalletTopUpRequestStatus?;
    var pendingCount = ViewBag.PendingCount as int? ?? 0;
}

<div class="financial-page financial-hub-page">
    @{
        ViewBag.FinancialNavShowWarehouse = false;
        ViewBag.FinancialNavCurrent = "client-topups";
    }
    <partial name="_FinancialQuickNav" />
    @{
        ViewBag.FinancialHeroIcon = "fas fa-user-check";
        ViewBag.FinancialHeroTheme = "wallet";
        ViewBag.FinancialHeroSubtitle = companyName + " — طلبات تغذية رصيد من بوابة المشترك";
        ViewBag.FinancialHeroActions = @"<a class=""btn btn-outline-secondary micro-btn"" href=""" + Url.RouteUrl("networkManager-wallet-index") + @"""><i class=""fas fa-wallet""></i> المحفظة</a>
<a class=""btn btn-outline-primary micro-btn"" href=""" + Url.RouteUrl("networkManager-clients", new { action = "Index", id = "" }) + @"""><i class=""fas fa-users""></i> المشتركين</a>";
    }
    <partial name="_FinancialSysHero" />

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    <div class="btn-group mb-3 flex-wrap" role="group">
        <a class="btn btn-sm @(selectedStatus == null ? "btn-primary" : "btn-outline-primary")" asp-action="Index">الكل</a>
        <a class="btn btn-sm @(selectedStatus == ClientWalletTopUpRequestStatus.Pending ? "btn-primary" : "btn-outline-primary")" asp-action="Index" asp-route-status="@ClientWalletTopUpRequestStatus.Pending">معلّقة (@pendingCount)</a>
        <a class="btn btn-sm @(selectedStatus == ClientWalletTopUpRequestStatus.Approved ? "btn-primary" : "btn-outline-primary")" asp-action="Index" asp-route-status="@ClientWalletTopUpRequestStatus.Approved">مقبولة</a>
        <a class="btn btn-sm @(selectedStatus == ClientWalletTopUpRequestStatus.Rejected ? "btn-primary" : "btn-outline-primary")" asp-action="Index" asp-route-status="@ClientWalletTopUpRequestStatus.Rejected">مرفوضة</a>
    </div>

    <div class="card financial-table-card">
        <div class="table-responsive">
            <table class="table align-middle mb-0 financial-table radtk-data-table radtk-data-table--cards">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>المشترك</th>
                        <th>المبلغ</th>
                        <th>طريقة الدفع</th>
                        <th>المرجع</th>
                        <th>الحالة</th>
                        <th>التاريخ</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Any())
                {
                    foreach (var r in Model)
                    {
                        var clientLabel = r.Client?.Name ?? r.Client?.UserName ?? $"#{r.ClientId}";
                        <tr>
                            <td>@r.Id</td>
                            <td>@clientLabel</td>
                            <td>@SyrianCurrencyHelper.FormatNew(r.Amount) ل.س.ج</td>
                            <td>@(r.PaymentMethod?.Name ?? "—")</td>
                            <td>@(r.ReferenceNumber ?? "—")</td>
                            <td>@PricingDisplay.ClientWalletTopUpRequestStatusLabel(r.Status)</td>
                            <td>@r.RequestedAt.ToString("yyyy/MM/dd HH:mm")</td>
                            <td class="text-nowrap">
                                @if (!string.IsNullOrWhiteSpace(r.ReceiptImagePath))
                                {
                                    <a class="btn btn-sm btn-outline-secondary micro-btn" href="@r.ReceiptImagePath" target="_blank" rel="noopener"><i class="fas fa-receipt"></i></a>
                                }
                                @if (r.Status == ClientWalletTopUpRequestStatus.Pending)
                                {
                                    <form asp-action="Approve" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="btn btn-sm btn-success micro-btn" onclick="return confirm('تأكيد الموافقة وإضافة الرصيد للمشترك؟');"><i class="fas fa-check"></i></button>
                                    </form>
                                    <form asp-action="Reject" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger micro-btn" onclick="return confirm('تأكيد رفض الطلب؟');"><i class="fas fa-times"></i></button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center text-muted py-4">لا توجد طلبات.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
