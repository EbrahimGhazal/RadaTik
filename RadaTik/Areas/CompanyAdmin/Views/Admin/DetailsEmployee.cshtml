<div class="radtk-page--companyadmin-views-admin-detailsemployee">
<div class="radtk-page--companyadmin-views-admin-detailsemployee">
@model RadaTik.ViewModels.Admin.DeleteEmployeeViewModel

@{
    ViewData["Title"] = "تفاصيل المستخدم";
    var returnUrl = Model?.ReturnUrl;
    var vm = Model ?? new RadaTik.ViewModels.Admin.DeleteEmployeeViewModel();
    var roles = ViewBag.Roles as IEnumerable<string> ?? Enumerable.Empty<string>();
    var hasPayroll = (bool?)ViewBag.HasPayrollRecord == true;
    var payrollEmployeeId = (int?)ViewBag.PayrollEmployeeId;
}

<div class="employee-details-hero card border-0 shadow-sm mb-3">
    <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h1 class="h4 mb-1 employee-details-title"><i class="fas fa-id-card me-2"></i>@ViewData["Title"]</h1>
            <p class="text-muted mb-0">عرض تفصيلي لبيانات المستخدم وصلاحياته الحالية.</p>
        </div>
        @if (!string.IsNullOrWhiteSpace(returnUrl))
        {
            <a class="btn btn-outline-secondary" href="@returnUrl">
                <i class="fas fa-arrow-right"></i> العودة
            </a>
        }
        else
        {
            <a class="btn btn-outline-secondary" asp-route="networkManager-users-employees">
                <i class="fas fa-arrow-right"></i> العودة
            </a>
        }
    </div>
</div>

<div class="alert alert-info border-0 shadow-sm employee-details-note" role="alert">
    <i class="fas fa-circle-info me-2"></i>
    ملاحظة: هذه الصفحة للعرض من قاعدة البيانات فقط، ولا تنفذ أي إجراء مباشر على MikroTik.
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-light">
        <h6 class="mb-0"><i class="fas fa-money-check-alt"></i> التكامل مع الرواتب</h6>
    </div>
    <div class="card-body">
        @if (hasPayroll && payrollEmployeeId.HasValue)
        {
            <p class="mb-2 text-muted small">مرتبط بسجل رواتب #@payrollEmployeeId</p>
            <a asp-area="CompanyAdmin" asp-controller="Payroll" asp-action="EmployeeDetails" asp-route-id="@payrollEmployeeId"
               class="btn btn-sm btn-outline-primary">
                <i class="fas fa-user-tie"></i> فتح ملف الرواتب
            </a>
        }
        else
        {
            <p class="text-muted small mb-2">لا يوجد سجل رواتب مرتبط بهذا الحساب.</p>
            <form asp-action="EnsurePayrollForEmployee" method="post" class="d-flex flex-wrap gap-2 align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@vm.Id" />
                <div class="mb-0">
                    <label class="form-label small">الراتب الشهري الابتدائي (اختياري)</label>
                    <input type="number" name="monthlySalary" class="form-control form-control-sm" step="0.01" min="0" placeholder="0" style="width:8rem" />
                </div>
                <button type="submit" class="btn btn-sm btn-primary">إنشاء سجل رواتب</button>
            </form>
        }
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label text-muted">اسم المستخدم</label>
                <div class="fw-semibold">@vm.UserName</div>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted">الاسم الكامل</label>
                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(vm.FullName) ? "-" : vm.FullName)</div>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted">رقم الجوال</label>
                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(vm.PhoneNumber) ? "-" : vm.PhoneNumber)</div>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted">البريد الإلكتروني</label>
                <div class="fw-semibold">@(string.IsNullOrWhiteSpace(vm.Email) ? "-" : vm.Email)</div>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted">قسم الموظف</label>
                <div class="fw-semibold">@((ViewBag.EmployeeDepartmentName as string) ?? "غير محدد")</div>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted">الدور</label>
                <div>
                    @if (roles.Any())
                    {
                        foreach (var role in roles)
                        {
                            <span class="badge text-bg-light border me-1 employee-role-badge">@role</span>
                        }
                    }
                    else
                    {
                        <span>-</span>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label text-muted">الحالة</label>
                <div>
                    @if (vm.IsActive)
                    {
                        <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">نشط</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">مجمّد</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
