<div class="radtk-page-receiver-index">
<div class="radtk-page-receiver-index">
@model IEnumerable<RadaTik.Models.Receiver>

@{
    ViewData["Title"] = "المستقبلات";
    var receivers = Model ?? Enumerable.Empty<RadaTik.Models.Receiver>();
    var pendingReceiverIds = ViewBag.PendingReceiverIds as ISet<int> ?? new HashSet<int>();
    var totalReceivers = receivers.Count();
    var activeReceivers = receivers.Count(r => r.IsActive);
    var totalUsers = receivers.Sum(r => r.UserCount);
    var mikrotikServers = receivers
        .Where(r => r.Sector != null && r.Sector.MikroTikServer != null)
        .Select(r => r.Sector!.MikroTikServer!.Name ?? string.Empty)
        .Distinct()
        .OrderBy(name => name)
        .ToList();
}

<!-- Page Header -->
<div class="operational-page receiver-index-page">
    @{
        ViewBag.OperationalHeroIcon = "fas fa-wifi";
        ViewBag.OperationalHeroSubtitle = $"إجمالي {totalReceivers} — نشط {activeReceivers} — {totalUsers} مستخدم";
    }
    <partial name="_OperationalSysHero" />
    <div class="page-actions-toolbar d-flex flex-wrap gap-2 mb-3 justify-content-end align-items-center">
            <button type="button" class="btn btn-sm btn-icon" id="btnRefresh" title="تحديث">
                <i class="fas fa-sync-alt"></i>
            </button>
            <button type="button" class="btn btn-sm btn-icon" id="btnFilter" title="تصفية">
                <i class="fas fa-filter"></i>
            </button>
            <a asp-action="ExportToExcel" class="btn btn-outline-success btn-sm" title="تصدير بيانات المستقبلات إلى Excel">
                <i class="fas fa-file-export"></i> تصدير إلى Excel
            </a>
            <button type="button" class="btn btn-outline-success btn-sm" id="btnOpenReceiverExcelImport"
                    title="استيراد مستقبلات من ملف Excel">
                <i class="fas fa-file-excel"></i> استيراد من Excel
            </button>
            <a asp-action="Create" class="btn btn-success btn-sm">
                <i class="fas fa-plus"></i> إضافة مستقبل
            </a>
    </div>

@if (TempData["ImportReceiverWarnings"] is string importWarnings && !string.IsNullOrWhiteSpace(importWarnings))
{
    <div class="alert alert-warning mb-3">
        <i class="fas fa-exclamation-triangle me-1"></i>
        @importWarnings
    </div>
}

<div class="modal fade" id="receiverExcelImportModal" tabindex="-1" aria-labelledby="receiverExcelImportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form asp-action="ImportFromExcel" method="post" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="receiverExcelImportModalLabel">
                        <i class="fas fa-file-excel text-success"></i>
                        استيراد المستقبلات من ملف Excel
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
                <div class="modal-body">
                    <p class="small text-muted mb-2">
                        يُضاف مستقبل جديد لكل صف صالح. يجب أن يكون <strong>اسم المرسل</strong> مطابقاً لمرسل موجود في الشبكة الحالية.
                        المستقبل الموجود مسبقاً بنفس الاسم أو عنوان IP يُتخطى.
                    </p>
                    <div class="alert alert-info small py-2 mb-3">
                        الأعمدة المطلوبة:
                        <strong>اسم المستقبل، اسم المرسل، عنوان IP، خط الطول، خط العرض، ارتفاع الهوائي</strong>.
                        قناع الشبكة الافتراضي هو <code>255.255.255.0</code> ويمكن كتابته مع العنوان بصيغة CIDR مثل <code>10.1.1.20/24</code>.
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold" for="receiverExcelImportFile">ملف Excel أو CSV</label>
                        <input type="file" class="form-control" id="receiverExcelImportFile" name="file"
                               accept=".xlsx,.xlsm,.csv,.txt" required />
                    </div>
                    <a asp-action="DownloadReceiverExcelImportTemplate" class="btn btn-sm btn-outline-secondary">
                        <i class="fas fa-download"></i> تنزيل قالب Excel
                    </a>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-upload"></i> استيراد
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Compact Statistics Bar -->
<div class="stats-bar">
    <div class="stat-item stat-primary">
        <div class="stat-icon-mini"><i class="fas fa-wifi"></i></div>
        <div class="stat-data">
            <span class="stat-number">@totalReceivers</span>
            <span class="stat-label">إجمالي</span>
        </div>
    </div>
    
    <div class="stat-item stat-success">
        <div class="stat-icon-mini"><i class="fas fa-check-circle"></i></div>
        <div class="stat-data">
            <span class="stat-number">@activeReceivers</span>
            <span class="stat-label">نشط</span>
        </div>
    </div>
    
    <div class="stat-item stat-warning">
        <div class="stat-icon-mini"><i class="fas fa-users"></i></div>
        <div class="stat-data">
            <span class="stat-number">@totalUsers</span>
            <span class="stat-label">مستخدمين</span>
        </div>
    </div>
    
    <div class="stat-item stat-info">
        <div class="stat-icon-mini"><i class="fas fa-server"></i></div>
        <div class="stat-data">
            <span class="stat-number">@mikrotikServers.Count</span>
            <span class="stat-label">خوادم</span>
        </div>
    </div>
</div>

<!-- Filter Card -->
<div class="card filter-card" id="filterCard" style="display: none;">
    <div class="card-body">
        <div class="filter-row">
            <div class="filter-group">
                <label class="filter-label"><i class="fas fa-server"></i> خادم MikroTik</label>
                <select class="form-control" id="mikrotikFilter">
                    <option value="">جميع الخوادم</option>
                    @foreach (var serverName in mikrotikServers)
                    {
                        <option value="@serverName">@serverName</option>
                    }
                </select>
            </div>
            <button type="button" class="btn btn-secondary" id="btnClearFilter">
                <i class="fas fa-times"></i> إلغاء التصفية
            </button>
        </div>
    </div>
</div>

<!-- خريطة تفاعلية لجميع المرسلات والمستقبلات (لمدير الشركة فقط) -->
@if (User.IsInRole("NetworkAdministrator"))
{
    <div class="card mb-4">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-map-marked-alt"></i>
                خريطة المرسلات (القطاعات) والمستقبلات
            </h3>
        </div>
        <div class="card-body" style="padding: 0;">
            <div id="receiversMap" style="width: 100%; height: 480px; border-radius: var(--radius); overflow: hidden;"></div>
        </div>
    </div>
}

<!-- Receivers Table -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-list"></i>
            قائمة المستقبلات
        </h3>
        <span class="badge badge-primary">@totalReceivers مستقبل</span>
    </div>
    <div class="card-body" style="padding: 0;">
        <div class="table-container">
            <table class="table table-sm table-hover radtk-data-table radtk-data-table--cards" id="receiversTable">
                <thead>
                    <tr>
                        <th>المستقبل</th>
                        <th>القطاع</th>
                        <th>السيرفر</th>
                        <th>IP</th>
                        <th>الموقع</th>
                        <th>المستخدمين</th>
                        <th>البروفايلات</th>
                        <th>الحالة</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in receivers)
                    {
                        var isPendingApproval = pendingReceiverIds.Contains(item.Id);
                        <tr data-mikrotik="@(item.Sector?.MikroTikServer?.Name ?? "غير محدد")">
                            <td>
                                <div class="receiver-info">
                                    <div class="receiver-icon @(item.IsActive ? "active" : "inactive")">
                                        <i class="fas fa-wifi"></i>
                                    </div>
                                    <div>
                                        <div class="receiver-name">@item.Name</div>
                                        <div class="receiver-mask">@item.NetworkMask</div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                @if (item.Sector != null)
                                {
                                    <div class="sector-link">
                                        <a asp-controller="Sector" asp-action="Details" asp-route-id="@item.Sector.Id" class="sector-name-link">
                                            <i class="fas fa-broadcast-tower text-info"></i>
                                            @item.Sector.Name
                                        </a>
                                        <small class="text-muted">@item.Sector.IPAddress</small>
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">غير مرتبط</span>
                                }
                            </td>
                            <td>
                                @if (item.Sector?.MikroTikServer != null)
                                {
                                    <span class="badge badge-primary" title="@item.Sector.MikroTikServer.Host">
                                        <i class="fas fa-server"></i> @item.Sector.MikroTikServer.Name
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">غير محدد</span>
                                }
                            </td>
                            <td><code>@item.IPAddress</code></td>
                            <td>
                                <div class="location-info">
                                    <span><i class="fas fa-map-marker-alt text-danger"></i> @item.Latitude.ToString("F4")</span>
                                    <span>@item.Longitude.ToString("F4")</span>
                                </div>
                            </td>
                            <td>
                                <a href="@Url.Action("Index", "Clients", new { receiverId = item.Id })" class="count-badge count-warning" title="عرض المستخدمين">
                                    <i class="fas fa-users"></i>
                                    <span>@item.UserCount</span>
                                </a>
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(item.ProfileNames))
                                {
                                    var profileCount = item.ProfileNames.Split(',').Length;
                                    <span class="badge badge-info" title="@item.ProfileNames">
                                        <i class="fas fa-list"></i> @profileCount نوع
                                    </span>
                                }
                                else
                                {
                                    <span class="badge badge-secondary">لا يوجد</span>
                                }
                            </td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="status-badge status-active">
                                        <i class="fas fa-check-circle"></i> نشط
                                    </span>
                                }
                                else if (isPendingApproval)
                                {
                                    <span class="status-badge status-awaiting">
                                        <i class="fas fa-hourglass-half"></i> بانتظار موافقة المدير
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-inactive">
                                        <i class="fas fa-times-circle"></i> متوقف
                                    </span>
                                }
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-info" title="تفاصيل">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-warning" title="تعديل">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-danger" title="حذف">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                    @if (item.Sector?.MikroTikServer != null)
                                    {
                                        <a asp-route="networkManager-mikrotikservers"
                                           asp-route-action="Details"
                                           asp-route-id="@item.Sector.MikroTikServer.Id"
                                           class="btn btn-sm btn-icon btn-secondary" title="عرض الخادم">
                                            <i class="fas fa-server"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
</div>


@section Scripts {
    <script src="~/js/receiver-map.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            var mapDataJson = '@Html.Raw(ViewBag.MapDataJson ?? "[]")';
            if (typeof initReceiverMap === 'function') {
                initReceiverMap('receiversMap', mapDataJson);
            }

            var table = $('#receiversTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/ar.json'
                },
                columnDefs: [{ orderable: false, targets: [8] }],
                order: [[0, 'asc']],
                pageLength: 25,
                responsive: true
            });

            // Toggle filter
            $('#btnFilter').click(function () {
                $('#filterCard').slideToggle();
            });

            // Filter by MikroTik
            $('#mikrotikFilter').change(function () {
                var selectedServer = $(this).val();
                if (selectedServer === "") {
                    table.columns().search('').draw();
                } else {
                    $.fn.dataTable.ext.search.push(function(settings, data, dataIndex) {
                        var row = table.row(dataIndex).node();
                        return $(row).data('mikrotik') === selectedServer;
                    });
                    table.draw();
                    $.fn.dataTable.ext.search.pop();
                }
            });

            // Clear filter
            $('#btnClearFilter').click(function () {
                $('#mikrotikFilter').val('');
                table.columns().search('').draw();
                $('#filterCard').slideUp();
            });

            // Refresh
            $('#btnRefresh').click(function () {
                $(this).find('i').addClass('fa-spin');
                setTimeout(function() { location.reload(); }, 500);
            });

            const excelImportBtn = document.getElementById('btnOpenReceiverExcelImport');
            const excelImportModalEl = document.getElementById('receiverExcelImportModal');
            if (excelImportBtn && excelImportModalEl && typeof bootstrap !== 'undefined') {
                excelImportBtn.addEventListener('click', function () {
                    bootstrap.Modal.getOrCreateInstance(excelImportModalEl).show();
                });
            }
        });
    </script>
}
