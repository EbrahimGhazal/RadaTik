@model RadaTik.Models.Receiver
@using RadaTik.ViewModels

@{
    ViewData["Title"] = "إضافة مستقبل جديد";
    var isEmployeeActor = User.IsInRole("CompanyEmployee") || User.IsInRole("Employee") || User.IsInRole("EmployeeLegacy");
    var pendingSectorApprovalsCount = (int?)(ViewBag.PendingSectorApprovalsCount) ?? 0;
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString() ?? "CompanyAdmin";
    var createSectors = ViewBag.ReceiverCreateSectors as IList<ReceiverCreateSectorOption>
        ?? Array.Empty<ReceiverCreateSectorOption>();
    var filterServers = ViewBag.MikroTikServersForFilter as IList<ReceiverCreateServerOption>
        ?? Array.Empty<ReceiverCreateServerOption>();
    string? wizardReturnUrl = ViewBag.WizardReturnUrl as string;
}

<div class="receiver-create-page radtk-page--companyadmin-views-receiver-create">
<!-- Page Header -->
<div class="page-header">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="fas fa-plus-circle"></i>
            @ViewData["Title"]
        </h1>
        <div class="page-actions">
            <a asp-action="Index" class="btn btn-secondary btn-sm">
                <i class="fas fa-arrow-right"></i> رجوع للقائمة
            </a>
        </div>
    </div>
</div>

@if (isEmployeeActor)
{
    <div class="alert alert-info mb-3">
        <i class="fas fa-circle-info me-1"></i>
        طلب الإضافة سيُرسل إلى مدير الشركة للموافقة قبل تفعيل المستقبل.
    </div>
}
else if (pendingSectorApprovalsCount > 0)
{
    <div class="alert alert-warning mb-3">
        <i class="fas fa-clock me-1"></i>
        لا توجد قطاعات مفعلة متاحة حالياً. يوجد <strong>@pendingSectorApprovalsCount</strong> طلب قطاع معلّق بانتظار الموافقة.
        <a asp-route="networkManager-employee-approvals" asp-route-action="Index" asp-route-id="" class="alert-link">انتقل لصفحة الموافقات</a>.
    </div>
}

<div class="card">
    <div class="card-header card-header-success">
        <h3 class="card-title">
            <i class="fas fa-wifi"></i>
            بيانات المستقبل الجديد
        </h3>
    </div>
    <div class="card-body">
        <form asp-action="Create" id="receiverForm" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            @if (!string.IsNullOrWhiteSpace(wizardReturnUrl))
            {
                <input type="hidden" name="returnUrl" value="@wizardReturnUrl" />
            }

            <div class="form-grid">
                <!-- القسم الأول: المعلومات الأساسية -->
                <div class="form-section">
                    <h4 class="form-section-title">
                        <i class="fas fa-info-circle"></i> المعلومات الأساسية
                    </h4>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Name" class="form-label required" for="Name">اسم المستقبل</label>
                            <input asp-for="Name" class="form-control" id="Name" placeholder="أدخل اسم المستقبل" autocomplete="off" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label" for="sectorServerFilter">فلترة حسب خادم MikroTik</label>
                            <select id="sectorServerFilter" class="form-control no-select2" autocomplete="off">
                                <option value="">كل الخوادم</option>
                                @foreach (var server in filterServers)
                                {
                                    <option value="@server.Id">@server.Name</option>
                                }
                            </select>
                            <small class="form-hint">يضيّق قائمة القطاعات ثم يمكنك البحث بالاسم داخل القائمة</small>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group" style="grid-column: 1 / -1;">
                            <label asp-for="SectorId" class="form-label required" for="sectorSelect">القطاع التابع له (المرسل)</label>
                            <select asp-for="SectorId" class="form-control" id="sectorSelect" name="SectorId" autocomplete="off"
                                    data-placeholder="ابحث عن القطاع...">
                                <option value="">-- اختر القطاع --</option>
                                @foreach (var sector in createSectors)
                                {
                                    if (Model.SectorId == sector.Id)
                                    {
                                        <option value="@sector.Id"
                                                data-server-id="@sector.MikroTikServerId"
                                                data-network-mask="@(sector.NetworkMask ?? "")"
                                                data-ip="@(sector.IPAddress ?? "")"
                                                selected="selected">@sector.Name</option>
                                    }
                                    else
                                    {
                                        <option value="@sector.Id"
                                                data-server-id="@sector.MikroTikServerId"
                                                data-network-mask="@(sector.NetworkMask ?? "")"
                                                data-ip="@(sector.IPAddress ?? "")">@sector.Name</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="SectorId" class="text-danger"></span>
                            <small class="form-hint">اكتب للبحث/فلترة القطاع بالاسم</small>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="IPAddress" class="form-label required" for="ipAddressInput">عنوان IP</label>
                            <div class="input-with-btn">
                                <input asp-for="IPAddress" class="form-control" id="ipAddressInput" name="IPAddress" value="@(Model.IPAddress ?? ViewBag.NextIP)" placeholder="xxx.xxx.xxx.xxx" autocomplete="off" />
                                <button type="button" class="btn btn-secondary" id="btnGenerateIP" title="توليد IP تلقائي">
                                    <i class="fas fa-sync-alt"></i>
                                </button>
                            </div>
                            <span asp-validation-for="IPAddress" class="text-danger"></span>
                            <small class="form-hint">يُحدَّد تلقائياً بحسب آخر واقط مُدخل على نفس القطاع</small>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="NetworkMask" class="form-label" for="networkMaskInput">قناع الشبكة</label>
                            <input asp-for="NetworkMask" class="form-control" id="networkMaskInput" name="NetworkMask" value="@(Model.NetworkMask ?? ViewBag.DefaultMask)" placeholder="255.255.255.0" autocomplete="off" readonly />
                            <span asp-validation-for="NetworkMask" class="text-danger"></span>
                            <small class="form-hint">يطابق قناع الشبكة للقطاع المحدد (غير قابل للتعديل)</small>
                        </div>
                    </div>
                </div>

                <!-- القسم الثاني: الموقع -->
                <div class="form-section">
                    <h4 class="form-section-title">
                        <i class="fas fa-map-marked-alt"></i> موقع المستقبل
                    </h4>
                    
                    <partial name="_ReceiverCreateMap" />

                    <div class="form-row form-row-3">
                        <div class="form-group">
                            <label asp-for="Latitude" class="form-label" for="latitudeInput">خط العرض (موقع المستقبل)</label>
                            <div class="input-with-btn">
                                <input asp-for="Latitude" class="form-control" id="latitudeInput" name="Latitude" type="number" step="0.000001" readonly autocomplete="off" />
                                <button type="button" class="btn btn-secondary btn-copy" data-copy="latitudeInput" title="نسخ">
                                    <i class="fas fa-copy"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Latitude" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="Longitude" class="form-label" for="longitudeInput">خط الطول (موقع المستقبل)</label>
                            <div class="input-with-btn">
                                <input asp-for="Longitude" class="form-control" id="longitudeInput" name="Longitude" type="number" step="0.000001" readonly autocomplete="off" />
                                <button type="button" class="btn btn-secondary btn-copy" data-copy="longitudeInput" title="نسخ">
                                    <i class="fas fa-copy"></i>
                                </button>
                            </div>
                            <span asp-validation-for="Longitude" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group">
                            <label class="form-label" for="distanceFromSector">المسافة من القطاع</label>
                            <div class="input-with-addon">
                                <input type="text" class="form-control" id="distanceFromSector" name="distanceFromSector" readonly value="غير محدد" autocomplete="off" aria-readonly="true" />
                                <span class="input-addon">كم</span>
                            </div>
                            <small class="form-hint" id="distanceStatus"></small>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="ElevationMeters" class="form-label" for="receiverElevationInput">الارتفاع عن سطح البحر عند المستقبل (م)</label>
                            <input asp-for="ElevationMeters" class="form-control" id="receiverElevationInput" type="number" step="0.1" placeholder="يُملأ عند النقر على الخريطة" />
                            <span asp-validation-for="ElevationMeters" class="text-danger"></span>
                            <small class="form-hint" id="receiverElevationHint">يُحدَّد تلقائياً عند اختيار موقع المستقبل على الخريطة (قابل للتعديل).</small>
                        </div>
                        <div class="form-group">
                            <label asp-for="AntennaHeightAglMeters" class="form-label" for="receiverAntennaAglInput">ارتفاع هوائي المستقبل عن الأرض (م)</label>
                            <input asp-for="AntennaHeightAglMeters" class="form-control" id="receiverAntennaAglInput" type="number" step="0.1" placeholder="6" />
                            <span asp-validation-for="AntennaHeightAglMeters" class="text-danger"></span>
                            <small class="form-hint">القيمة الافتراضية 6 م وتُعبَّأ تلقائياً مع موقع الخريطة (قابل للتعديل).</small>
                        </div>
                    </div>

                    <details class="los-static-notes" id="losStaticNotes">
                        <summary class="los-notes-title"><i class="fas fa-info-circle"></i> ملاحظات مهمة — اقرأ قبل الاعتماد على التحليل</summary>
                        <ul class="los-notes-list">
                            <li><strong>ما الذي يُحسب؟</strong> مسار تقريبي مستقيم في المستوى بين موقع القطاع (المرسل) وموقع المستقبل، مع مقارنة ارتفاع خط الرؤية بين الهوائيات مع: ارتفاع التضاريس (نموذج خارجي)، ثم المبانٍ المسجّلة في خريطة الشارع المفتوحة إن وُجدت.</li>
                            <li><strong>دقة النتيجة:</strong> النتيجة <strong>تقديرية</strong> وليست مسحاً ميدانياً. التضاريس من خدمة ارتفاعات عامة؛ المبانٍ قد تكون ناقصة أو بارتفاع غير دقيق؛ لا يُغني عن المعاينة أو قياسات مهنية عند الحاجة.</li>
                            <li><strong>عند فشل جلب المبانٍ:</strong> يُعرض تحذير في النتيجة، والتحليل يبقى مفيداً لتضاريس المسار فقط.</li>
                            <li><strong>الخريطة بعد الضغط على «تحليل خط الرؤية»:</strong> خط برتقالي = مسار التحليل؛ دوائر حمراء = مبانٍ يُرجّح أنها أعلى من خط الرؤية عند ذلك الموضع؛ دائرة صفراء = أضيق نقطة تضاريس على المسار (يظهر فقط إذا كان الهامش أقل من حدّ معيّن).</li>
                        </ul>
                    </details>

                    <div id="losResultPanel" class="los-result-panel d-none" role="region" aria-live="polite">
                        <div class="los-result-header">
                            <h4 class="los-result-title"><i class="fas fa-mountain"></i> نتيجة تحليل خط الرؤية</h4>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="btnLosResultClose" title="إخفاء النتيجة">×</button>
                        </div>
                        <div id="losResultContent" class="los-result-content"></div>
                    </div>
                </div>

                <!-- القسم الثالث: معلومات إضافية -->
                <div class="form-section">
                    <div class="info-grid">
                        <div class="form-check-wrapper">
                            <input asp-for="IsActive" class="form-check-input" id="isActiveCheck" checked />
                            <label asp-for="IsActive" class="form-check-label" for="isActiveCheck">
                                <span class="check-text">تفعيل المستقبل</span>
                                <small class="check-hint">المستقبل سيكون نشطاً ويمكن إضافة مستخدمين له</small>
                            </label>
                        </div>

                        <div class="quick-info-box">
                            <h6><i class="fas fa-chart-bar"></i> معلومات القطاع</h6>
                            <div class="info-row">
                                <span>عدد المستقبلات:</span>
                                <strong id="receiversCount">0</strong>
                            </div>
                            <div class="info-row">
                                <span>نطاق IP:</span>
                                <strong id="sectorIPRange">غير محدد</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="form-actions receiver-create-actions">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save"></i> حفظ المستقبل
                </button>
                <button type="button" class="btn btn-outline-primary" id="btnAnalyzeLos" title="تحليل المسار فوق التضاريس والمباني (بيانات خارجية)">
                    <i class="fas fa-mountain"></i> تحليل خط الرؤية
                </button>
                <button type="button" class="btn btn-info" id="btnCheckConnection" title="فحص اتصال المستقبل">
                    <i class="fas fa-wifi"></i> فحص الاتصال
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-times"></i> إلغاء
                </a>
            </div>
        </form>
    </div>
    </div>
</div>

<style>
    .page-header {
        margin-bottom: var(--spacing-lg);
    }
    
    .page-header-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }
    
    .page-title {
        font-size: var(--font-2xl);
        font-weight: 700;
        margin: 0;
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }
    
    .page-title i {
        color: var(--success);
    }
    
    .card-header-success {
        background: linear-gradient(135deg, var(--success), #00a854) !important;
        color: white !important;
    }

    .form-grid {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xl);
    }

    .form-section {
        background: var(--bg-hover);
        padding: var(--spacing-lg);
        border-radius: var(--radius);
    }

    .form-section-title {
        font-size: var(--font-lg);
        font-weight: 600;
        margin-bottom: var(--spacing-lg);
        padding-bottom: var(--spacing-sm);
        border-bottom: 2px solid var(--primary);
        display: flex;
        align-items: center;
        gap: var(--spacing-sm);
    }

    .form-section-title i {
        color: var(--primary);
    }

    .form-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: var(--spacing-lg);
        margin-bottom: var(--spacing-md);
    }

    .form-row-3 {
        grid-template-columns: repeat(3, 1fr);
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
    }

    .form-label {
        font-weight: 500;
        font-size: var(--font-sm);
        color: var(--text-secondary);
    }

    .form-label.required::after {
        content: ' *';
        color: var(--danger);
    }

    .form-hint {
        font-size: 11px;
        color: var(--text-muted);
    }

    .input-with-btn {
        display: flex;
        gap: var(--spacing-xs);
    }

    .input-with-btn .form-control {
        flex: 1;
    }

    .input-with-addon {
        display: flex;
        align-items: stretch;
    }

    .input-with-addon .form-control {
        border-radius: var(--radius-sm) 0 0 var(--radius-sm);
    }

    .input-addon {
        display: flex;
        align-items: center;
        padding: 0 12px;
        background: var(--bg-hover);
        border: 1px solid var(--border-light);
        border-right: none;
        border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
        font-size: var(--font-sm);
        color: var(--text-muted);
    }

    .receiver-create-page {
        --receiver-map-height: 420px;
    }

    .receiver-map-block {
        display: flex;
        flex-direction: column;
        gap: 0;
        margin-bottom: var(--spacing-md);
    }

    .map-container-form,
    .receiver-map-wrap {
        position: relative;
        height: auto;
        border-radius: var(--radius) var(--radius) 0 0;
        overflow: hidden;
        margin-bottom: 0;
        border: 1px solid var(--border-light);
        background: #dbe4ee;
    }

    .map-container-form #map,
    .receiver-create-page .receiver-map {
        width: 100%;
        height: var(--receiver-map-height);
        min-height: 280px;
        display: block;
    }

    .receiver-create-page .map-container-form .leaflet-container {
        width: 100%;
        height: 100%;
        font-family: inherit;
    }

    .receiver-map-tap-hint {
        position: absolute;
        left: 50%;
        bottom: 12px;
        transform: translateX(-50%);
        z-index: 500;
        margin: 0;
        max-width: calc(100% - 24px);
        padding: 0.4rem 0.75rem;
        border-radius: 999px;
        background: rgba(15, 23, 42, 0.78);
        color: #fff;
        font-size: 12px;
        line-height: 1.4;
        text-align: center;
        pointer-events: none;
        box-shadow: 0 4px 14px rgba(15, 23, 42, 0.28);
    }

    .receiver-map-tap-hint.is-hidden {
        display: none;
    }

    .receiver-map-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 0.5rem;
        padding: 0.5rem 0.65rem;
        background: var(--bg-card);
        border: 1px solid var(--border-light);
        border-top: 0;
    }

    .receiver-map-type-group,
    .map-type-controls {
        display: flex;
        gap: 2px;
        background: var(--bg-hover);
        border-radius: var(--radius-sm);
        padding: 2px;
    }

    .map-type-btn {
        padding: 6px 10px;
        border: none;
        background: transparent;
        border-radius: var(--radius-sm);
        font-size: var(--font-xs);
        cursor: pointer;
        transition: all 0.2s;
        color: var(--text-secondary);
        min-height: 36px;
    }

    .map-type-btn:hover {
        background: var(--bg-card);
    }

    .map-type-btn.active {
        background: var(--primary);
        color: white;
    }

    .receiver-map-locate {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        min-height: 36px;
    }

    .receiver-map-info {
        background: var(--bg-card);
        padding: 0.65rem 0.75rem;
        border: 1px solid var(--border-light);
        border-top: 0;
        border-radius: 0 0 var(--radius) var(--radius);
        font-size: var(--font-xs);
    }

    .receiver-map-info small {
        display: block;
        margin-bottom: 2px;
    }

    .receiver-map-hint {
        margin: 0.55rem 0 0;
    }

    .info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--spacing-lg);
    }

    .form-check-wrapper {
        display: flex;
        align-items: flex-start;
        gap: var(--spacing-sm);
        padding: var(--spacing-md);
        background: var(--bg-card);
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-light);
    }

    .form-check-input {
        width: 20px;
        height: 20px;
        margin-top: 2px;
        cursor: pointer;
    }

    .form-check-label {
        cursor: pointer;
    }

    .check-text {
        display: block;
        font-weight: 600;
        margin-bottom: 2px;
    }

    .check-hint {
        display: block;
        font-size: 12px;
        color: var(--text-muted);
    }

    .quick-info-box {
        background: var(--bg-card);
        padding: var(--spacing-md);
        border-radius: var(--radius-sm);
        border: 1px solid var(--border-light);
    }

    .quick-info-box h6 {
        margin-bottom: var(--spacing-sm);
        color: var(--text-secondary);
    }

    .info-row {
        display: flex;
        justify-content: space-between;
        font-size: var(--font-sm);
        margin-bottom: 4px;
    }

    .form-actions {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-sm);
        margin-top: var(--spacing-xl);
        padding-top: var(--spacing-lg);
        border-top: 1px solid var(--border-light);
    }

    .los-result-panel {
        margin-top: var(--spacing-md);
        padding: var(--spacing-md);
        border: 1px solid var(--border-light);
        border-radius: var(--radius);
        background: var(--bg-card);
    }

    .los-result-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--spacing-sm);
    }

    .los-result-title {
        margin: 0;
        font-size: var(--font-md);
        font-weight: 600;
    }

    .los-result-content {
        font-size: var(--font-sm);
        line-height: 1.6;
    }

    .los-result-content table {
        width: 100%;
        border-collapse: collapse;
        margin-top: var(--spacing-sm);
    }

    .los-result-content th,
    .los-result-content td {
        border: 1px solid var(--border-light);
        padding: 6px 8px;
        text-align: right;
    }

    .los-result-content .badge-ok { color: var(--success); font-weight: 600; }
    .los-result-content .badge-warn { color: var(--danger); font-weight: 600; }

    .los-static-notes {
        margin-top: var(--spacing-md);
        padding: var(--spacing-md);
        border-radius: var(--radius);
        border: 1px solid rgba(13, 110, 253, 0.35);
        background: rgba(13, 110, 253, 0.06);
    }

    .los-notes-title {
        margin: 0 0 var(--spacing-sm) 0;
        font-size: var(--font-md);
        font-weight: 700;
        color: var(--text-primary);
        cursor: pointer;
        list-style: none;
    }

    .los-static-notes .los-notes-title::-webkit-details-marker {
        display: none;
    }

    .los-notes-list {
        margin: 0;
