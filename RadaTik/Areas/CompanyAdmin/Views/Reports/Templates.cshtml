@using RadaTik.ViewModels.CompanyAdmin
@{
    ViewData["Title"] = "قوالب التقارير";
    var existing = ViewBag.ExistingKinds as IReadOnlyDictionary<CompanyReportKind, DateTime>;
}

<div class="financial-page financial-hub-page">
    @{
        ViewBag.FinancialNavCurrent = "reports";
        ViewBag.FinancialNavShowWarehouse = false;
    }
    <partial name="_FinancialQuickNav" />
    @{
        ViewBag.FinancialHeroIcon = "fas fa-file-code";
        ViewBag.FinancialHeroTheme = "wallet";
        ViewBag.FinancialHeroSubtitle = "ثوابت ومتغيرات قوالب التقارير";
        ViewBag.FinancialHeroActions = @"<a class=""btn btn-outline-primary btn-sm micro-btn"" href=""" + Url.Action("DocumentAppearance") + @"""><i class=""fas fa-stamp""></i> هوية المستندات</a> <a class=""btn btn-outline-secondary btn-sm micro-btn"" href=""" + Url.RouteUrl("networkManager-reports", new { action = "Index", id = "" }) + @"""><i class=""fas fa-arrow-right""></i> التقارير</a>";
    }
    <partial name="_FinancialSysHero" />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card">
    <div class="card-body">
        <p class="text-muted">
            لكل نوع تقرير يمكنك كتابة نصوص وثوابت وتنسيق HTML، بينما تُستبدل المتغيرات مثل <code>{{CompanyName}}</code> تلقائياً من التطبيق.
            ضع <code>{{DATA_TABLE}}</code> حيث تريد إدراج <strong>جدول بيانات</strong> (صفوف = السجلات، أعمدة = الحقول) يُولَّد من النظام كـ HTML.
        </p>
        <p class="alert alert-light border">
            ترويسة الشعار والعلامة المائية وألوان الجدول هي <strong>هوية شركتك الخاصة</strong> وتُطبَّق على كل التقارير والعقود.
            <a asp-action="DocumentAppearance">تعديل هوية المستندات</a>
        </p>
        <div class="table-responsive">
            <table class="table align-middle radtk-data-table radtk-data-table--cards">
                <thead>
                    <tr>
                        <th>نوع التقرير</th>
                        <th>آخر تحديث</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (CompanyReportKind k in Enum.GetValues<CompanyReportKind>())
                    {
                        var title = RadaTik.Services.Reports.ReportTemplateFormatter.GetReportTitleDisplay(k);
                        DateTime? updatedAt = existing != null && existing.TryGetValue(k, out var u) ? u : null;
                        <tr>
                            <td><strong>@title</strong></td>
                            <td>@(updatedAt.HasValue ? updatedAt.Value.ToLocalTime().ToString("yyyy/MM/dd HH:mm") : "—")</td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-primary" asp-action="EditTemplate" asp-route-kind="@((int)k)">تعديل القالب</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
</div>
