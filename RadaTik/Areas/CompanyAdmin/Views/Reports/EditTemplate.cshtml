@using System.Text.Json
@using RadaTik.ViewModels.CompanyAdmin
@{
    ViewData["Title"] = "تعديل قالب التقرير";
    var kind = (CompanyReportKind)(int)(ViewBag.Kind ?? 1);
    var kindTitle = ViewBag.KindTitle as string ?? "";
    var body = ViewBag.BodyContent as string ?? "";
    var sample = ViewBag.DefaultSample as string ?? "";
    var bodyJson = JsonSerializer.Serialize(body);
    var sampleJson = JsonSerializer.Serialize(sample);
}
<div class="radtk-page--companyadmin-views-reports-edittemplate">

<div class="financial-page financial-hub-page">
    @{
        ViewBag.FinancialNavCurrent = "reports";
        ViewBag.FinancialNavShowWarehouse = false;
    }
    <partial name="_FinancialQuickNav" />
    @{
        ViewBag.FinancialHeroIcon = "fas fa-edit";
        ViewBag.FinancialHeroTheme = "wallet";
        ViewBag.FinancialHeroSubtitle = kindTitle;
        ViewBag.FinancialHeroActions = @"<a class=""btn btn-outline-secondary btn-sm micro-btn"" href=""" + Url.RouteUrl("networkManager-reports", new { action = "Templates" }) + @"""><i class=""fas fa-arrow-right""></i> القوالب</a>";
    }
    <partial name="_FinancialSysHero" />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title mb-0">محتوى القالب</h3>
            </div>
            <div class="card-body">
                <form asp-action="SaveTemplate" method="post" id="reportTemplateForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="Kind" value="@((int)kind)" />
                    <div class="mb-3">
                        <label class="form-label" for="reportTemplateBody">نص القالب (محرّر مرئي)</label>
                        <textarea id="reportTemplateBody" name="BodyContent" class="form-control" rows="16" dir="rtl" placeholder="اتركه فارغاً لاستخدام العرض الافتراضي."></textarea>
                        <div class="form-text mt-2">
                            <strong>ملاحظة:</strong> التحرير يشبه معالج النصوص (خط عريض، ألوان، قوائم…). المحفوظ هو تنسيق HTML يُستخدم عند طباعة التقرير.
                            اتركه <strong>فارغاً</strong> إذا أردت الاعتماد على تنسيق النظام الافتراضي فقط.
                        </div>
                    </div>
                    <div class="d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-success"><i class="fas fa-save"></i> حفظ</button>
                        <button type="button" class="btn btn-outline-secondary" id="btnLoadSample">تحميل مثال جاهز</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title mb-0 small">متغيرات من التطبيق</h3>
            </div>
            <div class="card-body small">
                <p class="text-muted">اكتبها في المحرّر أو انسخها:</p>
                <ul class="list-unstyled mb-0" style="line-height:2">
                    <li><code>{{CompanyName}}</code> — اسم الشركة</li>
                    <li><code>{{NetworkName}}</code> — الشبكة المحددة حالياً</li>
                    <li><code>{{ReportTitle}}</code> — عنوان نوع التقرير</li>
                    <li><code>{{PeriodFrom}}</code> / <code>{{PeriodTo}}</code></li>
                    <li><code>{{PeriodFromDate}}</code> / <code>{{PeriodToDate}}</code></li>
                    <li><code>{{RowCount}}</code> — عدد صفوف الجدول</li>
                    <li><code>{{GeneratedAt}}</code> — وقت التوليد</li>
                    <li><code>{{ManagerName}}</code> — اسم مدير الشركة</li>
                    <li><code>{{ManagerEmail}}</code> / <code>{{ManagerUserName}}</code></li>
                </ul>
                <hr />
                <p class="mb-1"><strong>جدول البيانات</strong></p>
                <p class="mb-0 small">
                    <code>{{DATA_TABLE}}</code> — يُستبدل داخل القالب بـ<strong>جدول HTML</strong> حقيقي
                    (<code>&lt;table&gt;</code> مع صف رأس للأعمدة وصفوف للسجلات). ضَع العلامة في الموضع المطلوب بعد استبدال بقية المتغيرات.
                </p>
            </div>
        </div>
    </div>
</div>
</div>

<script type="application/json" id="reportTemplateInitialJson">@Html.Raw(bodyJson)</script>
<script type="application/json" id="reportTemplateSampleJson">@Html.Raw(sampleJson)</script>

@section Styles {
}


</div>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/tinymce@7.6.1/tinymce.min.js" referrerpolicy="origin"></script>
    <script>
        (function () {
            var form = document.getElementById('reportTemplateForm');

            function readJsonScript(id) {
                var el = document.getElementById(id);
                if (!el) {
                    return '';
                }
                try {
                    return JSON.parse(el.textContent || '""');
                } catch (e) {
                    return '';
                }
            }

            var initialHtml = readJsonScript('reportTemplateInitialJson');
            var sampleHtml = readJsonScript('reportTemplateSampleJson');

            tinymce.init({
                selector: '#reportTemplateBody',
                height: 440,
                menubar: false,
                branding: false,
                promotion: false,
                license_key: 'gpl',
                directionality: 'rtl',
                language: 'ar',
                language_url: 'https://cdn.jsdelivr.net/npm/tinymce-i18n@25.11.17/langs7/ar.js',
                plugins: 'lists link table autoresize wordcount',
                toolbar: 'undo redo | blocks | bold italic underline strikethrough | forecolor backcolor | alignright aligncenter alignleft alignjustify | bullist numlist | outdent indent | link table | removeformat',
                content_style: 'body { font-family: system-ui, "Segoe UI", Tahoma, Arial, sans-serif; font-size: 15px; direction: rtl; line-height: 1.6; } p { margin: 0.4em 0; }',
                convert_urls: false,
                paste_data_images: false,
                autoresize_bottom_margin: 24,
                setup: function (editor) {
                    editor.on('init', function () {
                        editor.setContent(initialHtml || '');
                    });
                }
            });

            if (form) {
                form.addEventListener('submit', function () {
                    if (typeof tinymce !== 'undefined') {
                        tinymce.triggerSave();
                    }
                });
            }

            document.getElementById('btnLoadSample')?.addEventListener('click', function () {
                var ed = tinymce.get('reportTemplateBody');
                if (ed) {
                    ed.setContent(sampleHtml || '');
                }
            });
        })();
    </script>
}
