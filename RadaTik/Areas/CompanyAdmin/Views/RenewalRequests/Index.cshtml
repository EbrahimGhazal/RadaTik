@model List<RadaTik.Models.CollectionPointRenewalRequest>
@using RadaTik.Models
@using RadaTik.Helpers
@{
    ViewData["Title"] = "طلبات تجديد الاشتراك من نقاط التحصيل";
    var status = ViewBag.Status as CollectionPointRenewalStatus?;
    var pendingCount = ViewBag.PendingCount as int? ?? 0;
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <h1><i class="fas fa-sync-alt"></i> طلبات تجديد الاشتراك من نقاط التحصيل</h1>
    @if (pendingCount > 0)
    {
        <span class="badge bg-warning text-dark">@pendingCount @PricingDisplay.CollectionPointRenewalStatusLabel(CollectionPointRenewalStatus.Pending)</span>
    }
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="mb-3">
    <a asp-route="networkManager-renewalRequests" asp-route-action="Index" asp-route-status="@null" class="btn btn-outline-secondary btn-sm @(status == null ? "active" : "")">الكل</a>
    <a asp-route="networkManager-renewalRequests" asp-route-action="Index" asp-route-status="@CollectionPointRenewalStatus.Pending" class="btn btn-outline-warning btn-sm @(status == CollectionPointRenewalStatus.Pending ? "active" : "")">@PricingDisplay.CollectionPointRenewalStatusLabel(CollectionPointRenewalStatus.Pending)</a>
    <a asp-route="networkManager-renewalRequests" asp-route-action="Index" asp-route-status="@CollectionPointRenewalStatus.Approved" class="btn btn-outline-success btn-sm @(status == CollectionPointRenewalStatus.Approved ? "active" : "")">@PricingDisplay.CollectionPointRenewalStatusLabel(CollectionPointRenewalStatus.Approved)</a>
    <a asp-route="networkManager-renewalRequests" asp-route-action="Index" asp-route-status="@CollectionPointRenewalStatus.Rejected" class="btn btn-outline-danger btn-sm @(status == CollectionPointRenewalStatus.Rejected ? "active" : "")">@PricingDisplay.CollectionPointRenewalStatusLabel(CollectionPointRenewalStatus.Rejected)</a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>التاريخ</th>
                        <th>العميل</th>
                        <th>المبلغ</th>
                        <th>نقطة التحصيل</th>
                        <th>الحالة</th>
                        <th style="width: 200px;">إجراء</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var r in Model)
                        {
                            <tr>
                                <td>@r.RequestedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>@(r.Client?.Name ?? "—") (@(r.Client?.UserName ?? "—"))</td>
                                <td>@r.Amount.ToString("0.##")</td>
                                <td>@(r.RequestedByUser?.UserName ?? r.RequestedByUserId)</td>
                                <td>
                                    @switch (r.Status)
                                    {
                                        case CollectionPointRenewalStatus.Pending:
                                            <span class="badge bg-warning text-dark">@PricingDisplay.CollectionPointRenewalStatusLabel(r.Status)</span>
                                            break;
                                        case CollectionPointRenewalStatus.Approved:
                                            <span class="badge bg-success">@PricingDisplay.CollectionPointRenewalStatusLabel(r.Status)</span>
                                            @if (r.NewExpirationDate.HasValue)
                                            {
                                                <small class="text-muted d-block">حتى @r.NewExpirationDate.Value.ToString("yyyy/MM/dd")</small>
                                            }
                                            break;
                                        case CollectionPointRenewalStatus.Rejected:
                                            <span class="badge bg-danger">@PricingDisplay.CollectionPointRenewalStatusLabel(r.Status)</span>
                                            break;
                                    }
                                </td>
                                <td>
                                    @if (r.Status == CollectionPointRenewalStatus.Pending)
                                    {
                                        <form asp-action="Approve" method="post" class="d-inline" onsubmit="return confirm('قبول الطلب وتمديد اشتراك العميل؟');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <input type="hidden" name="renewDays" value="30" />
                                            <button type="submit" class="btn btn-success btn-sm">قبول (تمديد 30 يوم)</button>
                                        </form>
                                        <form asp-action="Reject" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@r.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm">رفض</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">لا توجد طلبات</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
