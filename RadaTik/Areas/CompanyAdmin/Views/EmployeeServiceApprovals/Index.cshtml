@using RadaTik.Models
@using RadaTik.Helpers
@using RadaTik.ViewModels.UI
@model IReadOnlyList<NetworkServiceRequest>

@{
    ViewData["Title"] = "طلبات موافقات الموظفين";
    int? focusRequestId = (int?)ViewBag.FocusRequestId;
    var hero = new PageHeroViewModel
    {
        Title = ViewData["Title"] as string ?? "طلبات موافقات الموظفين",
        Subtitle = "راجع طلبات الموظفين المعلّقة واعتمدها أو ارفضها من مكان واحد",
        IconClass = "fas fa-user-check",
        Theme = "warning",
        Chips =
        [
            new PageHeroChipViewModel
            {
                IconClass = "fas fa-clock",
                Text = Model.Count == 0 ? "لا توجد طلبات معلّقة" : $"{Model.Count} طلب معلّق"
            }
        ]
    };
}

<div class="radtk-page-emp-approvals employee-approvals-page">
    <partial name="~/Views/Shared/_PageHero.cshtml" model="hero" />

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle alert-icon"></i>
            <div class="alert-content">@TempData["Success"]</div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="fas fa-exclamation-circle alert-icon"></i>
            <div class="alert-content">@TempData["Error"]</div>
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle alert-icon"></i>
            <div class="alert-content">@TempData["Info"]</div>
        </div>
    }

    @if (Model.Count == 0)
    {
        <div class="emp-approvals-empty">
            <div class="emp-approvals-empty__icon" aria-hidden="true">
                <i class="fas fa-inbox"></i>
            </div>
            <h2 class="emp-approvals-empty__title">لا توجد طلبات معلّقة حالياً</h2>
            <p class="emp-approvals-empty__text">عند إرسال الموظف طلب إضافة أو تعديل سيظهر هنا لاتخاذ القرار.</p>
        </div>
    }
    else
    {
        <div class="emp-approvals-list">
            @foreach (var item in Model)
            {
                EmployeeApprovalRequestHelper.TryParse(item.Notes, out var kind, out var entityId, out var payloadJson);
                if (entityId <= 0 &&
                    string.Equals(item.FeatureKey, FeatureKeys.Sectors, StringComparison.OrdinalIgnoreCase))
                {
                    RadaTik.Services.PricingPolicies.SenderPricingOrchestrator.TryParsePendingSectorMeta(item.Notes, out entityId);
                }

                var isSector = string.Equals(item.FeatureKey, FeatureKeys.Sectors, StringComparison.OrdinalIgnoreCase);
                var actionLabel = kind switch
                {
                    EmployeeApprovalRequestKind.ReceiverCreate => "إضافة مستقبل",
                    EmployeeApprovalRequestKind.ReceiverEdit => "تعديل مستقبل",
                    EmployeeApprovalRequestKind.ClientCreate => "إضافة مشترك",
                    EmployeeApprovalRequestKind.ClientEdit => "تعديل مشترك",
                    _ when isSector => "إضافة مرسل",
                    _ => item.FeatureKey
                };
                var kindClass = kind switch
                {
                    EmployeeApprovalRequestKind.ReceiverCreate => "receiver-create",
                    EmployeeApprovalRequestKind.ReceiverEdit => "receiver-edit",
                    EmployeeApprovalRequestKind.ClientCreate => "client-create",
                    EmployeeApprovalRequestKind.ClientEdit => "client-edit",
                    _ when isSector => "sector",
                    _ => "unknown"
                };
                var kindIcon = kind switch
                {
                    EmployeeApprovalRequestKind.ReceiverCreate => "fas fa-satellite-dish",
                    EmployeeApprovalRequestKind.ReceiverEdit => "fas fa-pen-to-square",
                    EmployeeApprovalRequestKind.ClientCreate => "fas fa-user-plus",
                    EmployeeApprovalRequestKind.ClientEdit => "fas fa-user-pen",
                    _ when isSector => "fas fa-broadcast-tower",
                    _ => "fas fa-clipboard-check"
                };
                var employeeName = item.RequestedByUser?.FullName ?? item.RequestedByUser?.UserName ?? item.RequestedByUserId;
                var isClient = kind is EmployeeApprovalRequestKind.ClientCreate or EmployeeApprovalRequestKind.ClientEdit;
                var isReceiver = kind is EmployeeApprovalRequestKind.ReceiverCreate or EmployeeApprovalRequestKind.ReceiverEdit;
                string? entityTitle = null;
                if (isClient)
                {
                    var clientPayload = EmployeeApprovalRequestHelper.DeserializePayload<ClientApprovalPayload>(payloadJson);
                    entityTitle = clientPayload?.Name ?? clientPayload?.UserName ?? clientPayload?.SID;
                }
                else if (isReceiver)
                {
                    var receiverPayload = EmployeeApprovalRequestHelper.DeserializePayload<ReceiverEditApprovalPayload>(payloadJson);
                    entityTitle = receiverPayload?.Name ?? receiverPayload?.IPAddress;
                }

                var isFocused = focusRequestId.HasValue && item.Id == focusRequestId.Value;
                <article id="approval-request-@item.Id"
                         class="emp-approval-card emp-approval-card--@kindClass@(isFocused ? " emp-approval-card--focused table-warning" : string.Empty)">
                    <header class="emp-approval-card__head">
                        <div class="emp-approval-card__icon" aria-hidden="true">
                            <i class="@kindIcon"></i>
                        </div>
                        <div class="emp-approval-card__title-wrap">
                            <h2 class="emp-approval-card__title">@actionLabel</h2>
                            <p class="emp-approval-card__meta">
                                <span><i class="fas fa-user-tie"></i> @(employeeName ?? "موظف")</span>
                                <span><i class="far fa-clock"></i> @item.RequestedAt.ToString("yyyy/MM/dd HH:mm")</span>
                            </p>
                        </div>
                        <span class="emp-approval-card__status">معلّق</span>
                    </header>

                    <div class="emp-approval-card__facts">
                        <div class="emp-approval-fact">
                            <span class="emp-approval-fact__label">المرجع</span>
                            <span class="emp-approval-fact__value">
                                <code>#@entityId</code>
                                @if (!string.IsNullOrWhiteSpace(entityTitle))
                                {
                                    <span class="emp-approval-fact__name">@entityTitle</span>
                                }
                            </span>
                        </div>
                        <div class="emp-approval-fact">
                            <span class="emp-approval-fact__label">الحسم المتوقع</span>
                            <span class="emp-approval-fact__value">
                                @if (item.AmountSYP > 0m)
                                {
                                    <span class="emp-approval-charge emp-approval-charge--yes">
                                        <i class="fas fa-wallet"></i>
                                        @SyrianCurrencyHelper.FormatNew(item.AmountSYP) ل.س.ج
                                    </span>
                                }
                                else
                                {
                                    <span class="emp-approval-charge emp-approval-charge--no">
                                        <i class="fas fa-minus-circle"></i>
                                        لا يوجد
                                    </span>
                                }
                            </span>
                        </div>
                        @if (entityId > 0 && (isClient || isReceiver))
                        {
                            <div class="emp-approval-fact emp-approval-fact--link">
                                <span class="emp-approval-fact__label">الملف</span>
                                <span class="emp-approval-fact__value">
                                    @if (isClient)
                                    {
                                        <a asp-area="CompanyAdmin" asp-controller="Clients" asp-action="Details" asp-route-id="@entityId"
                                           class="btn btn-sm btn-outline-primary emp-approval-file-btn" title="ملف العميل">
                                            <i class="fas fa-user"></i> العميل
                                        </a>
                                    }
                                    else
                                    {
                                        <a asp-area="CompanyAdmin" asp-controller="Receiver" asp-action="Details" asp-route-id="@entityId"
                                           class="btn btn-sm btn-outline-primary emp-approval-file-btn" title="ملف المستقبل">
                                            <i class="fas fa-satellite-dish"></i> المستقبل
                                        </a>
                                    }
                                </span>
                            </div>
                        }
                    </div>

                    <div class="emp-approval-card__actions">
                        <form asp-area="CompanyAdmin" asp-controller="EmployeeServiceApprovals" asp-action="Approve" method="post" class="emp-approval-form emp-approval-form--approve">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="text" name="notes" class="form-control form-control-sm" placeholder="ملاحظة اعتماد (اختياري)" />
                            <button type="submit" class="btn btn-success">
                                <i class="fas fa-check"></i> اعتماد
                            </button>
                        </form>
                        <form asp-area="CompanyAdmin" asp-controller="EmployeeServiceApprovals" asp-action="Reject" method="post" class="emp-approval-form emp-approval-form--reject">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@item.Id" />
                            <input type="text" name="notes" class="form-control form-control-sm" placeholder="سبب الرفض (اختياري)" />
                            <button type="submit" class="btn btn-outline-danger">
                                <i class="fas fa-times"></i> رفض
                            </button>
                        </form>
                    </div>
                </article>
            }
        </div>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/employee-service-approvals-cards.css" asp-append-version="true" />
}

@section Scripts {
    @if (focusRequestId.HasValue)
    {
        <script>
            (function () {
                var card = document.getElementById('approval-request-@focusRequestId.Value');
                if (!card) return;
                card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                card.classList.add('emp-approval-card--focused', 'table-warning');
            })();
        </script>
    }
}
