@using RadaTik.Areas.CompanyAdmin.ViewModels
@using RadaTik.Services
@{
    Layout = null;
    var items = ViewBag.Items as List<WarehouseItemRowViewModel> ?? new List<WarehouseItemRowViewModel>();
    var companyName = ViewBag.CompanyName as string ?? "";
    var printDate = ViewBag.PrintDate as string ?? DateTime.Today.ToString("yyyy-MM-dd");
    var activeCount = items.Count(i => i.IsActive);
    var lowCount = items.Count(i => i.IsActive && i.OnHand <= 0);
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>جرد المستودع — @companyName</title>
    <style>
        body { font-family: Tahoma, "Segoe UI", sans-serif; margin: 24px; color: #1e293b; }
        h1 { font-size: 1.35rem; margin: 0 0 0.25rem; }
        .meta { color: #64748b; font-size: 0.9rem; margin-bottom: 1rem; }
        .summary { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; font-size: 0.85rem; }
        .summary span { padding: 0.35rem 0.65rem; background: #f1f5f9; border-radius: 6px; }
        table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
        th, td { border: 1px solid #cbd5e1; padding: 8px 10px; text-align: right; }
        th { background: #e2e8f0; font-weight: 700; }
        tr.warn td { background: #fef3c7; }
        tr.inactive td { color: #94a3b8; }
        .qty { font-weight: 700; }
        .no-print { margin-bottom: 16px; }
        .no-print button { padding: 8px 16px; cursor: pointer; font-family: inherit; }
        @@media print {
            .no-print { display: none; }
            body { margin: 12px; }
        }
    </style>
</head>
<body>
    <div class="no-print">
        <button type="button" onclick="window.print()">طباعة</button>
        <button type="button" onclick="window.close()" style="margin-right:8px;">إغلاق</button>
    </div>
    <h1>جرد المستودع</h1>
    <p class="meta">@companyName — @printDate</p>
    <div class="summary">
        <span>إجمالي الأصناف: <strong>@items.Count</strong></span>
        <span>نشطة: <strong>@activeCount</strong></span>
        <span>نفدت/سالبة: <strong>@lowCount</strong></span>
    </div>
    <table>
        <thead>
            <tr>
                <th>#</th>
                <th>الصنف</th>
                <th>SKU</th>
                <th>الموديل</th>
                <th>الكمية</th>
                <th>الوحدة</th>
                <th>الحالة</th>
            </tr>
        </thead>
        <tbody>
        @{
            var n = 0;
        }
        @foreach (var i in items)
        {
            n++;
            var rowClass = !i.IsActive ? "inactive" : i.OnHand <= 0 ? "warn" : "";
            <tr class="@rowClass">
                <td>@n</td>
                <td>@i.Name</td>
                <td>@(i.Sku ?? "—")</td>
                <td>@(i.ModelNumber ?? "—")</td>
                <td class="qty">@WarehouseMaterialQuantityHelper.FormatQuantity(i.OnHand)</td>
                <td>@(i.Unit ?? "قطعة")</td>
                <td>@(i.IsActive ? "نشط" : "موقوف")</td>
            </tr>
        }
        </tbody>
    </table>
</body>
</html>
