@using RadaTik.Areas.CompanyAdmin.ViewModels
@using RadaTik.Helpers
@using RadaTik.Models
@using RadaTik.Models.Business
@using RadaTik.Services
@{
    ViewData["Title"] = "المستودع";
    var items = ViewBag.Items as List<WarehouseItemRowViewModel> ?? new List<WarehouseItemRowViewModel>();
    var movements = ViewBag.RecentMovements as List<WarehouseMovement> ?? new List<WarehouseMovement>();
    var companyName = ViewBag.CompanyName as string ?? "";
    var lowStock = (int)(ViewBag.LowStockCount ?? 0);
    var activeCount = items.Count(i => i.IsActive);
    var prefillMovementType = ViewBag.PrefillMovementType as int?;
    var prefillNotes = ViewBag.PrefillNotes as string ?? "";
    var prefillIn = prefillMovementType == (int)WarehouseMovementType.In;
    var prefillOut = prefillMovementType == (int)WarehouseMovementType.Out;
    var prefillAdj = prefillMovementType == (int)WarehouseMovementType.Adjustment;
    var prefillWarehouseItemId = ViewBag.PrefillWarehouseItemId as int?;
}

<div class="financial-page financial-hub-page warehouse-page">
    <partial name="_WarehouseSubNav" />
    @{
        ViewBag.FinancialHeroIcon = "fas fa-warehouse";
        ViewBag.FinancialHeroTheme = "default";
        ViewBag.FinancialHeroSubtitle = companyName + " — الكميات بالقطعة";
        ViewBag.FinancialHeroActions = @"<a class=""btn btn-outline-secondary micro-btn"" href=""" + Url.Action("Print") + @""" target=""_blank""><i class=""fas fa-print""></i> طباعة</a>
<a class=""btn btn-outline-success micro-btn"" href=""" + Url.Action("ExportExcel") + @"""><i class=""fas fa-file-excel""></i> Excel</a>";
    }
    <partial name="_FinancialSysHero" />

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
    @if (prefillMovementType.HasValue || !string.IsNullOrEmpty(prefillNotes) || prefillWarehouseItemId.HasValue)
    {
        <div class="alert alert-info">النموذج مُعبّأ مسبقاً — أكمل الكمية ثم احفظ.</div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="warehouse-stat-pill">
                <div class="warehouse-stat-pill__label">إجمالي الأصناف</div>
                <div class="warehouse-stat-pill__value" data-fmt-number="@items.Count">@items.Count</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="warehouse-stat-pill warehouse-stat-pill--ok">
                <div class="warehouse-stat-pill__label">أصناف نشطة</div>
                <div class="warehouse-stat-pill__value" data-fmt-number="@activeCount">@activeCount</div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="warehouse-stat-pill @(lowStock > 0 ? "warehouse-stat-pill--warn" : "")">
                <div class="warehouse-stat-pill__label">نفدت أو سالبة</div>
                <div class="warehouse-stat-pill__value @(lowStock > 0 ? "text-danger" : "text-success")" data-fmt-number="@lowStock">@lowStock</div>
            </div>
        </div>
    </div>

    <div class="row g-4 align-items-start">
        <div class="col-lg-4">
            <div class="card warehouse-panel-card shadow-sm mb-3" id="warehouse-movement-card">
                <div class="card-header warehouse-panel-card__header warehouse-panel-card__header--move">
                    <h2 class="h6 mb-0"><i class="fas fa-exchange-alt"></i> حركة مخزون يدوية</h2>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-3">للتعديل دون فاتورة. الكمية دائماً <strong>بالقطعة</strong>. الشراء/البيع يُحدّث المخزون تلقائياً.</p>
                    <form asp-action="AddMovement" method="post">
                        @Html.AntiForgeryToken()
                        <div class="mb-3">
                            <label class="form-label fw-semibold">نوع الحركة</label>
                            <div class="btn-group w-100 warehouse-movement-type" role="group">
                                <input type="radio" class="btn-check" name="movementType" id="mv-in" value="@((int)WarehouseMovementType.In)" @(prefillIn || !prefillOut && !prefillAdj ? "checked" : "") autocomplete="off" />
                                <label class="btn btn-outline-success" for="mv-in">وارد</label>
                                <input type="radio" class="btn-check" name="movementType" id="mv-out" value="@((int)WarehouseMovementType.Out)" @(prefillOut ? "checked" : "") autocomplete="off" />
                                <label class="btn btn-outline-danger" for="mv-out">صادر</label>
                                <input type="radio" class="btn-check" name="movementType" id="mv-adj" value="@((int)WarehouseMovementType.Adjustment)" @(prefillAdj ? "checked" : "") autocomplete="off" />
                                <label class="btn btn-outline-warning" for="mv-adj">تصحيح</label>
                            </div>
                            <small class="text-muted d-block mt-1">تصحيح: سالب للنقص (مثال −2)</small>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">الصنف</label>
                            <select name="warehouseItemId" class="form-select" required>
                                <option value="">— اختر صنفاً —</option>
                                @foreach (var i in items.Where(x => x.IsActive))
                                {
                                    <option value="@i.Id">@i.Name (@WarehouseMaterialQuantityHelper.FormatQuantity(i.OnHand) @(i.Unit ?? "قطعة"))</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">الكمية (قطعة)</label>
                            <input name="quantity" type="number" step="0.001" min="0.001" class="form-control" required placeholder="64" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">التاريخ</label>
                            <input name="movementDate" type="date" class="form-control" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">ملاحظات</label>
                            <input name="notes" class="form-control" maxlength="500" value="@prefillNotes" placeholder="اختياري" />
                        </div>
                        <button type="submit" class="btn btn-primary w-100 micro-btn">تسجيل الحركة</button>
                    </form>
                </div>
            </div>

            <div class="accordion warehouse-accordion" id="warehouseSideAccordion">
                <div class="accordion-item border-0 shadow-sm">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#wh-new-item">
                            <i class="fas fa-plus-circle me-2 text-muted"></i> إضافة صنف (اختياري)
                        </button>
                    </h2>
                    <div id="wh-new-item" class="accordion-collapse collapse" data-bs-parent="#warehouseSideAccordion">
                        <div class="accordion-body">
                            <p class="small text-muted">
                                الأفضل: <a asp-area="CompanyAdmin" asp-controller="MaterialPurchaseInvoices" asp-action="Create">فاتورة شراء مواد</a>
                                — يُنشأ الصنف تلقائياً مع الكمية.
                            </p>
                            <form asp-action="CreateItem" method="post">
                                @Html.AntiForgeryToken()
                                <div class="mb-2">
                                    <label class="form-label">اسم الصنف</label>
                                    <input name="name" class="form-control" required maxlength="120" placeholder="راوتر Wi-Fi 5" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label">الوحدة</label>
                                    <input name="unit" class="form-control" value="قطعة" maxlength="40" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label">رقم الموديل</label>
                                    <input name="modelNumber" class="form-control" maxlength="60" />
                                </div>
                                <div class="mb-2">
                                    <label class="form-label">SKU</label>
                                    <input name="sku" class="form-control" maxlength="60" />
                                </div>
                                <button type="submit" class="btn btn-outline-primary w-100 btn-sm">إضافة الصنف</button>
                            </form>
                        </div>
                    </div>
                </div>
                <div class="accordion-item border-0 shadow-sm mt-2">
                    <h2 class="accordion-header">
                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#wh-help">
                            <i class="fas fa-lightbulb me-2 text-warning"></i> تلميحات سريعة
                        </button>
                    </h2>
                    <div id="wh-help" class="accordion-collapse collapse" data-bs-parent="#warehouseSideAccordion">
                        <div class="accordion-body small text-muted">
                            <p class="mb-2"><strong>كرتونة:</strong> 4 × 16 قطعة = 64 في فاتورة الشراء (وحدة كرتونة، عدد/وحدة 16، كمية 4).</p>
                            <p class="mb-2"><strong>وارد/صادر:</strong> بالقطعة فقط في الحركة اليدوية.</p>
                            <p class="mb-0">لا تكرر حركة فاتورة شراء/بيع يدوياً — تُسجَّل تلقائياً.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <ul class="nav nav-tabs warehouse-log-tabs mb-3" role="tablist">
                <li class="nav-item">
                    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-items" type="button">
                        الأصناف <span class="badge bg-primary ms-1">@items.Count</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-movements" type="button">
                        آخر الحركات <span class="badge bg-secondary ms-1">@movements.Count</span>
                    </button>
                </li>
            </ul>

            <div class="tab-content">
                <div class="tab-pane fade show active" id="tab-items">
                    <div class="card warehouse-panel-card shadow-sm">
                        <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center bg-transparent">
                            <span class="fw-semibold">الأصناف والكميات</span>
                            <input type="search" id="warehouse-item-search" class="form-control form-control-sm warehouse-search-input" placeholder="بحث بالاسم أو SKU..." autocomplete="off" />
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover mb-0 align-middle radtk-data-table radtk-data-table--cards" id="warehouse-items-table">
                                <thead>
                                    <tr>
                                        <th>الصنف</th>
                                        <th>الكمية</th>
                                        <th>الوحدة</th>
                                        <th class="d-none d-xl-table-cell">أسعار</th>
                                        <th>الحالة</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                @if (!items.Any())
                                {
                                    <tr class="warehouse-empty-row">
                                        <td colspan="6" class="text-center text-muted py-5">
                                            لا توجد أصناف —
                                            <a asp-area="CompanyAdmin" asp-controller="MaterialPurchaseInvoices" asp-action="Create">فاتورة شراء مواد</a>
                                            أو أضف صنفاً من الجانب.
                                        </td>
                                    </tr>
                                }
                                @foreach (var i in items)
                                {
                                    var pc = i.PurchaseCurrency ?? PricingCurrency.SYP_New;
                                    var searchText = $"{i.Name} {i.Sku} {i.ModelNumber}".ToLowerInvariant();
                                    <tr class="warehouse-item-row @(!i.IsActive ? "table-secondary" : i.OnHand <= 0 ? "table-warning" : "")"
                                        data-search="@searchText">
                                        <td>
                                            <a asp-action="ItemHistory" asp-route-id="@i.Id" class="text-decoration-none fw-semibold">@i.Name</a>
                                            @if (!string.IsNullOrWhiteSpace(i.ModelNumber)) { <small class="text-muted d-block">@i.ModelNumber</small> }
                                            @if (!string.IsNullOrWhiteSpace(i.Sku)) { <small class="text-muted d-block">SKU: @i.Sku</small> }
                                        </td>
                                        <td>
                                            <span class="warehouse-qty @(i.OnHand <= 0 ? "text-danger" : "text-success")">
                                                @WarehouseMaterialQuantityHelper.FormatQuantity(i.OnHand)
                                            </span>
                                        </td>
                                        <td>@(i.Unit ?? "قطعة")</td>
                                        <td class="d-none d-xl-table-cell small">
                                            <a asp-action="ItemHistory" asp-route-id="@i.Id" class="text-decoration-none">
                                                <span class="d-block text-muted">ج: @CurrencyHelper.FormatAmount(i.WholesalePrice, pc)</span>
                                                <span class="d-block text-muted">م: @CurrencyHelper.FormatAmount(i.RetailPrice, pc)</span>
                                            </a>
                                        </td>
                                        <td>
                                            @if (i.IsActive)
                                            {
                                                <span class="badge bg-success-subtle text-success border">نشط</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">موقوف</span>
                                            }
                                        </td>
                                        <td class="text-nowrap">
                                            <a class="btn btn-sm btn-outline-primary" asp-action="ItemHistory" asp-route-id="@i.Id" title="السجل"><i class="fas fa-history"></i></a>
                                            <form asp-action="ToggleItem" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@i.Id" />
                                                <input type="hidden" name="isActive" value="@(!i.IsActive ? "true" : "false")" />
                                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="@(i.IsActive ? "إيقاف" : "تفعيل")">
                                                    <i class="fas @(i.IsActive ? "fa-pause" : "fa-play")"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                        <div id="warehouse-no-match" class="text-center text-muted py-3 d-none">لا توجد نتائج للبحث.</div>
                    </div>
                </div>

                <div class="tab-pane fade" id="tab-movements">
                    <div class="card warehouse-panel-card shadow-sm">
                        <div class="card-body p-0">
                            @if (movements.Any())
                            {
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0 radtk-data-table radtk-data-table--cards">
                                        <thead>
                                            <tr>
                                                <th>التاريخ</th>
                                                <th>الصنف</th>
                                                <th>النوع</th>
                                                <th>الكمية</th>
                                                <th>ملاحظات</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                        @foreach (var m in movements)
                                        {
                                            var (typeLabel, badgeClass) = m.MovementType switch
                                            {
                                                WarehouseMovementType.In => ("وارد", "bg-success"),
                                                WarehouseMovementType.Out => ("صادر", "bg-danger"),
                                                _ => ("تصحيح", "bg-warning text-dark")
                                            };
                                            <tr>
                                                <td class="small">@m.MovementDate.ToString("yyyy-MM-dd")</td>
                                                <td>@(m.WarehouseItem?.Name ?? "—")</td>
                                                <td><span class="badge @badgeClass">@typeLabel</span></td>
                                                <td class="fw-semibold">@WarehouseMaterialQuantityHelper.FormatQuantity(m.Quantity)</td>
                                                <td class="small text-muted">@(m.Notes ?? "—")</td>
                                            </tr>
                                        }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <p class="text-muted p-4 mb-0 text-center">لا توجد حركات مسجّلة بعد.</p>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var search = document.getElementById('warehouse-item-search');
    var rows = document.querySelectorAll('.warehouse-item-row');
    var noMatch = document.getElementById('warehouse-no-match');
    if (search && rows.length) {
        search.addEventListener('input', function () {
            var q = (search.value || '').trim().toLowerCase();
            var visible = 0;
            rows.forEach(function (row) {
                var text = row.getAttribute('data-search') || '';
                var show = !q || text.indexOf(q) >= 0;
                row.classList.toggle('d-none', !show);
                if (show) visible++;
            });
            if (noMatch) noMatch.classList.toggle('d-none', visible > 0 || !q);
        });
    }

    @if (prefillWarehouseItemId.HasValue)
    {
    <text>
    var itemSelect = document.querySelector('#warehouse-movement-card select[name="warehouseItemId"]');
    if (itemSelect) itemSelect.value = '@prefillWarehouseItemId.Value';
    </text>
    }
    @if (prefillMovementType.HasValue || !string.IsNullOrEmpty(prefillNotes) || prefillWarehouseItemId.HasValue)
    {
    <text>
    var card = document.getElementById('warehouse-movement-card');
    if (card) {
        card.scrollIntoView({ behavior: 'smooth', block: 'start' });
        var qty = card.querySelector('input[name="quantity"]');
        if (qty) qty.focus();
    }
    </text>
    }
})();
</script>
}
