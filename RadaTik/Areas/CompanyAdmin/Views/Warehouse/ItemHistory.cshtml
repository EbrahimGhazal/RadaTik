@using RadaTik.Helpers
@using RadaTik.Models
@using RadaTik.Models.Business
@using RadaTik.Services
@{
    var item = ViewBag.Item as WarehouseItem;
    var movements = ViewBag.Movements as List<WarehouseMovement> ?? new List<WarehouseMovement>();
    var onHand = (decimal)(ViewBag.OnHand ?? 0m);
    var companyName = ViewBag.CompanyName as string ?? "";
    var priceCurrency = item?.PurchaseCurrency ?? PricingCurrency.SYP_New;
    var inCount = movements.Count(m => m.MovementType == WarehouseMovementType.In);
    var outCount = movements.Count(m => m.MovementType == WarehouseMovementType.Out);
}

<div class="financial-page financial-hub-page warehouse-item-page">
    <partial name="_WarehouseSubNav" />
    @{
        ViewBag.FinancialHeroIcon = "fas fa-box";
        ViewBag.FinancialHeroTheme = "warehouse";
        ViewBag.FinancialHeroSubtitle = companyName + (item != null ? $" — {item.Name}" : "");
    }
    <partial name="_FinancialSysHero" />

    @if (!string.IsNullOrWhiteSpace(item?.Sku) || !string.IsNullOrWhiteSpace(item?.ModelNumber))
    {
        <p class="small text-muted mb-3">
            @if (!string.IsNullOrWhiteSpace(item?.ModelNumber)) { <span>موديل: @item.ModelNumber</span> }
            @if (!string.IsNullOrWhiteSpace(item?.Sku)) { <span class="ms-2">SKU: @item.Sku</span> }
        </p>
    }
    <div class="d-flex flex-wrap gap-2 mb-3">
            <a class="btn btn-outline-primary micro-btn"
               asp-action="Index"
               asp-route-warehouseItemId="@item?.Id"
               asp-route-movementType="@((int)WarehouseMovementType.In)"
               asp-route-prefillNotes="@($"حركة يدوية — {item?.Name}")">
                <i class="fas fa-plus"></i> حركة مخزون
            </a>
            <a class="btn btn-outline-secondary micro-btn" asp-action="Index">
                <i class="fas fa-arrow-right"></i> المستودع
            </a>
    </div>

    <partial name="_WarehouseQuickNav" />

    @if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="warehouse-stat-pill warehouse-stat-pill--ok">
                <div class="warehouse-stat-pill__label">الكمية الحالية</div>
                <div class="warehouse-stat-pill__value warehouse-qty @(onHand <= 0 ? "text-danger" : "text-success")">
                    @WarehouseMaterialQuantityHelper.FormatQuantity(onHand)
                </div>
                <div class="small text-muted">@(item?.Unit ?? "قطعة")</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="warehouse-stat-pill">
                <div class="warehouse-stat-pill__label">حركات واردة</div>
                <div class="warehouse-stat-pill__value text-success" data-fmt-number="@inCount">@inCount</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="warehouse-stat-pill">
                <div class="warehouse-stat-pill__label">حركات صادرة</div>
                <div class="warehouse-stat-pill__value text-danger" data-fmt-number="@outCount">@outCount</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="warehouse-stat-pill">
                <div class="warehouse-stat-pill__label">الحالة</div>
                <div class="warehouse-stat-pill__value" style="font-size:1.1rem;">
                    @if (item?.IsActive == true)
                    {
                        <span class="badge bg-success-subtle text-success border">نشط</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">موقوف</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 align-items-start">
        <div class="col-lg-4">
            <div class="card warehouse-panel-card shadow-sm mb-3">
                <div class="card-header warehouse-panel-card__header">
                    <h2 class="h6 mb-0"><i class="fas fa-tags"></i> أسعار المرجع (للبيع)</h2>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-3">
                        عملة الشراء: <strong>@CurrencyHelper.GetSymbol(priceCurrency)</strong>
                        — تُستخدم في فاتورة البيع (جملة/مفرق/مخصص).
                    </p>
                    <dl class="row small mb-3 warehouse-price-dl">
                        <dt class="col-5">شراء</dt>
                        <dd class="col-7">@CurrencyHelper.FormatAmount(item?.PurchasePrice, priceCurrency)</dd>
                        <dt class="col-5">جملة</dt>
                        <dd class="col-7">@CurrencyHelper.FormatAmount(item?.WholesalePrice, priceCurrency)</dd>
                        <dt class="col-5">مفرق</dt>
                        <dd class="col-7">@CurrencyHelper.FormatAmount(item?.RetailPrice, priceCurrency)</dd>
                    </dl>
                    <form asp-action="UpdateItemPrices" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item?.Id" />
                        <div class="mb-2">
                            <label class="form-label">رقم الموديل</label>
                            <input name="modelNumber" class="form-control form-control-sm" value="@item?.ModelNumber" maxlength="60" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">سعر الشراء</label>
                            <input name="purchasePrice" type="number" step="0.01" min="0" class="form-control form-control-sm"
                                   value="@(item?.PurchasePrice?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                        </div>
                        <div class="mb-2">
                            <label class="form-label">سعر الجملة</label>
                            <input name="wholesalePrice" type="number" step="0.01" min="0" class="form-control form-control-sm"
                                   value="@(item?.WholesalePrice?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">سعر المفرق</label>
                            <input name="retailPrice" type="number" step="0.01" min="0" class="form-control form-control-sm"
                                   value="@(item?.RetailPrice?.ToString(System.Globalization.CultureInfo.InvariantCulture))" />
                        </div>
                        <button type="submit" class="btn btn-primary w-100 btn-sm micro-btn">حفظ الأسعار</button>
                    </form>
                </div>
            </div>

            <div class="card warehouse-panel-card shadow-sm">
                <div class="card-body small">
                    <p class="mb-2"><i class="fas fa-cart-plus text-primary"></i>
                        <a asp-area="CompanyAdmin" asp-controller="MaterialPurchaseInvoices" asp-action="Create">شراء مواد</a>
                        يحدّث المخزون تلقائياً.</p>
                    <p class="mb-0"><i class="fas fa-receipt text-success"></i>
                        <a asp-area="CompanyAdmin" asp-controller="MaterialSalesInvoices" asp-action="Create">بيع مواد</a>
                        يخصم من هذا الصنف.</p>
                </div>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card warehouse-panel-card shadow-sm">
                <div class="card-header d-flex flex-wrap gap-2 justify-content-between align-items-center bg-transparent">
                    <span class="fw-semibold"><i class="fas fa-history"></i> سجل الحركات</span>
                    <input type="search" id="item-movement-search" class="form-control form-control-sm warehouse-search-input"
                           placeholder="بحث في الملاحظات..." autocomplete="off" />
                </div>
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle radtk-data-table radtk-data-table--cards" id="item-movements-table">
                        <thead>
                            <tr>
                                <th>التاريخ</th>
                                <th>النوع</th>
                                <th>الكمية</th>
                                <th>ملاحظات</th>
                                <th>بواسطة</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (!movements.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-5">لا توجد حركات لهذا الصنف.</td>
                            </tr>
                        }
                        @foreach (var m in movements)
                        {
                            var (typeLabel, badgeClass) = m.MovementType switch
                            {
                                WarehouseMovementType.In => ("وارد", "bg-success"),
                                WarehouseMovementType.Out => ("صادر", "bg-danger"),
                                _ => ("تصحيح", "bg-warning text-dark")
                            };
                            var searchNote = (m.Notes ?? "").ToLowerInvariant();
                            <tr class="item-movement-row" data-search="@searchNote">
                                <td class="small text-nowrap">@m.MovementDate.ToString("yyyy-MM-dd")</td>
                                <td><span class="badge @badgeClass">@typeLabel</span></td>
                                <td class="fw-semibold warehouse-qty">@WarehouseMaterialQuantityHelper.FormatQuantity(m.Quantity)</td>
                                <td class="small text-muted">@(m.Notes ?? "—")</td>
                                <td class="small">@(m.CreatedByUser?.FullName ?? m.CreatedByUser?.UserName ?? "—")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <div id="item-movement-no-match" class="text-center text-muted py-3 d-none">لا توجد نتائج للبحث.</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var search = document.getElementById('item-movement-search');
    var rows = document.querySelectorAll('.item-movement-row');
    var noMatch = document.getElementById('item-movement-no-match');
    if (!search || !rows.length) return;
    search.addEventListener('input', function () {
        var q = (search.value || '').trim().toLowerCase();
        var visible = 0;
        rows.forEach(function (row) {
            var text = row.getAttribute('data-search') || '';
            var show = !q || text.indexOf(q) >= 0;
            row.classList.toggle('d-none', !show);
            if (show) visible++;
        });
        if (noMatch) noMatch.classList.toggle('d-none', visible > 0 || !q);
    });
})();
</script>
}
