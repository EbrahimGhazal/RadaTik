@{
    var title = ViewData["SypNoteTitle"] as string ?? "ملاحظة عامة — العملة";
    var text = ViewData["SypNoteText"] as string
        ?? "حقول الأسعار والمبالغ في هذه الصفحة بالليرة السورية (ل.س.ج).";
}
<aside class="service-catalog-currency-note mb-4" role="note" aria-label="ملاحظة العملة">
    <div class="service-catalog-currency-note__inner">
        <div class="service-catalog-currency-note__icon" aria-hidden="true">
            <i class="fas fa-coins"></i>
        </div>
        <div class="service-catalog-currency-note__content">
            <h2 class="service-catalog-currency-note__title">@title</h2>
            <p class="service-catalog-currency-note__text mb-0">@text</p>
        </div>
    </div>
</aside>
