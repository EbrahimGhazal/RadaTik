@{
    if (ViewBag.FinancialNavCurrent == null)
    {
        var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        ViewBag.FinancialNavCurrent = ctrl switch
        {
            "CashBox" => "cashbox",
            "MoneyDiary" => "diary",
            "Wallet" => "wallet",
            "ClientWalletTopUpRequests" => "client-topups",
            "EmployeeWalletTopUpRequests" => "employee-topups",
            "Receipts" => "receipts",
            "FinancialReconciliation" => "reconciliation",
            "CompanyBusiness" => "business",
            "Payroll" => "payroll",
            "MaintenanceInvoices" => "maintenance",
            "CollectionPoints" => "collection",
            "SubscriberInstallationPricing" or "SubscriberInstallationInvoices" => "installation",
            "Reports" => "reports",
            "Warehouse" => "warehouse",
            "MaterialPurchaseInvoices" => "purchase",
            "MaterialSalesInvoices" => "sales",
            "WarehouseStocktake" when ViewContext.RouteData.Values["action"]?.ToString() == "Report" => "report",
            "WarehouseStocktake" => "stocktake",
            _ => ""
        };
    }
    var current = ViewBag.FinancialNavCurrent as string ?? "";
    var showWarehouse = ViewBag.FinancialNavShowWarehouse as bool? ?? true;
}
<link rel="stylesheet" href="~/css/financial-quick-nav.css" asp-append-version="true" />
<nav class="financial-quick-nav mb-3" aria-label="وحدات المالية">
    <a class="financial-quick-nav__item @(current == "cashbox" ? "is-current" : "")" asp-route="networkManager-cashbox" asp-route-action="Index" asp-route-id=""><i class="fas fa-cash-register"></i> الصندوق</a>
    <a class="financial-quick-nav__item @(current == "diary" ? "is-current" : "")" asp-route="networkManager-money-diary" asp-route-action="Index" asp-route-id=""><i class="fas fa-book"></i> الدفتر</a>
    <a class="financial-quick-nav__item @(current == "wallet" || current == "client-topups" || current == "employee-topups" ? "is-current" : "")" asp-route="networkManager-wallet-index"><i class="fas fa-wallet"></i> المحفظة</a>
    <a class="financial-quick-nav__item @(current == "client-topups" ? "is-current" : "")" asp-route="networkManager-client-wallet-topups" asp-route-action="Index" asp-route-id=""><i class="fas fa-user-check"></i> تغذية مشترك</a>
    <a class="financial-quick-nav__item @(current == "employee-topups" ? "is-current" : "")" asp-route="networkManager-employee-wallet-topups" asp-route-action="Index" asp-route-id=""><i class="fas fa-users-cog"></i> تغذية موظف</a>
    <a class="financial-quick-nav__item @(current == "receipts" ? "is-current" : "")" asp-route="networkManager-receipts" asp-route-action="Index" asp-route-id=""><i class="fas fa-receipt"></i> القبض</a>
    @if (showWarehouse)
    {
        <span class="financial-quick-nav__sep" aria-hidden="true"></span>
        <a class="financial-quick-nav__item @(current == "warehouse" ? "is-current" : "")" asp-route="networkManager-warehouse" asp-route-action="Index" asp-route-id=""><i class="fas fa-warehouse"></i> المستودع</a>
        <a class="financial-quick-nav__item @(current == "purchase" ? "is-current" : "")" asp-route="networkManager-material-purchase" asp-route-action="Index" asp-route-id=""><i class="fas fa-cart-plus"></i> شراء</a>
        <a class="financial-quick-nav__item @(current == "sales" ? "is-current" : "")" asp-route="networkManager-material-sales" asp-route-action="Index" asp-route-id=""><i class="fas fa-cash-register"></i> بيع</a>
        <a class="financial-quick-nav__item @(current == "stocktake" ? "is-current" : "")" asp-route="networkManager-warehouse-stocktake" asp-route-action="Index" asp-route-id=""><i class="fas fa-clipboard-check"></i> جرد</a>
        <a class="financial-quick-nav__item @(current == "report" ? "is-current" : "")" asp-route="networkManager-warehouse-stocktake" asp-route-action="Report" asp-route-id=""><i class="fas fa-chart-line"></i> تقرير</a>
    }
    <span class="financial-quick-nav__sep" aria-hidden="true"></span>
    <a class="financial-quick-nav__item @(current == "business" ? "is-current" : "")" asp-route="networkManager-company-business" asp-route-action="Index" asp-route-id=""><i class="fas fa-building"></i> أعمال الشركة</a>
    <a class="financial-quick-nav__item @(current == "payroll" ? "is-current" : "")" asp-route="networkManager-payroll" asp-route-action="Index" asp-route-id=""><i class="fas fa-users"></i> الرواتب</a>
    <a class="financial-quick-nav__item @(current == "collection" ? "is-current" : "")" asp-route="networkManager-users-collectionPoints"><i class="fas fa-store"></i> نقاط التحصيل</a>
    <a class="financial-quick-nav__item @(current == "installation" ? "is-current" : "")" asp-route="networkManager-subscriber-installation-pricing" asp-route-action="Index" asp-route-id=""><i class="fas fa-plug"></i> تجهيز مشترك</a>
    <a class="financial-quick-nav__item @(current == "maintenance" ? "is-current" : "")" asp-route="networkManager-maintenance-invoices" asp-route-action="Index" asp-route-id=""><i class="fas fa-tools"></i> صيانة</a>
    <a class="financial-quick-nav__item @(current == "reports" ? "is-current" : "")" asp-route="networkManager-reports" asp-route-action="Index" asp-route-id=""><i class="fas fa-file-alt"></i> تقارير</a>
    <a class="financial-quick-nav__item @(current == "reconciliation" ? "is-current" : "")" asp-route="networkManager-financial-reconciliation" asp-route-action="Index" asp-route-id=""><i class="fas fa-balance-scale"></i> جرد مالي</a>
</nav>
