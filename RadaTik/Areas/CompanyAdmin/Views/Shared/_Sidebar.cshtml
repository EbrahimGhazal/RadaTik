@using RadaTik.Navigation
@using RadaTik.Security
@{
    var isAuthenticated = (bool?)(ViewData["Layout_IsAuthenticated"]) == true;
    bool employeePortal = User.IsInRole(RoleNames.CompanyEmployee) || User.IsInRole(RoleNames.EmployeeLegacy);
    bool companyManager = User.IsInRole(RoleNames.NetworkAdministrator) || User.IsInRole(RoleNames.SystemAdministrator);
    bool showEmployeeNav = employeePortal && !companyManager;
}

<aside class="sidebar sidebar-pro" id="sidebar">
    <div class="sidebar-header">
        <div class="rt-sysadmin-brand">
            @{
                ViewData["RtBrandVariant"] = "sidebar";
            }
            <partial name="_RadaTikBrandLogo" />
            <small class="sidebar-brand-sub" dir="rtl">@(showEmployeeNav ? "بوابة الموظف" : "مدير الشركة")</small>
        </div>
    </div>

    <nav class="sidebar-nav" data-single-open="true">
        @if (!isAuthenticated)
        {
            <div class="nav-section">
                <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                    <i class="fas fa-bars"></i>
                    <span>القائمة</span>
                    <i class="fas fa-chevron-down nav-section-chevron"></i>
                </div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link" asp-route="reglog-login">
                            <span class="nav-icon"><i class="fas fa-sign-in-alt"></i></span>
                            <span>تسجيل الدخول</span>
                        </a>
                    </li>
                </ul>
            </div>
        }
        else
        {
            @if (showEmployeeNav)
            {
                @await Component.InvokeAsync("CompanySidebarNav", new { role = CompanySidebarRole.Employee })
            }
            else
            {
                <partial name="_SidebarWalletBalance" />
                @await Component.InvokeAsync("CompanySidebarNav", new { role = CompanySidebarRole.Admin })
            }
        }
    </nav>

</aside>
