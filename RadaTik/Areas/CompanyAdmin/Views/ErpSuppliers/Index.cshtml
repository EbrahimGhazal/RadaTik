@model IEnumerable<RadaTik.Models.Business.ErpSupplier>
@{
    ViewData["Title"] = "موردو ERP";
    var query = ViewBag.Query as string;
}

<div class="financial-page financial-hub-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h4 mb-0"><i class="fas fa-truck me-1"></i> موردو ERP</h1>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" asp-route="networkManager-erp">ERP</a>
            <a class="btn btn-primary btn-sm" asp-action="Create"><i class="fas fa-plus"></i> إضافة</a>
        </div>
    </div>

    <form method="get" class="row g-2 mb-3">
        <div class="col-auto"><input type="text" name="q" value="@query" class="form-control form-control-sm" placeholder="بحث..." /></div>
        <div class="col-auto"><button type="submit" class="btn btn-sm btn-outline-primary">بحث</button></div>
    </form>

    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr><th>الاسم</th><th>الهاتف</th><th>البريد</th><th>الحالة</th><th></th></tr>
            </thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Name</td>
                    <td>@s.Phone</td>
                    <td>@s.Email</td>
                    <td><span class="badge @(s.IsActive ? "bg-success" : "bg-secondary")">@(s.IsActive ? "نشط" : "موقوف")</span></td>
                    <td><a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline-primary">تعديل</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
