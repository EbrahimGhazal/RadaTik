@model RadaTik.ViewModels.CollectionPoints.CreateCollectionPointViewModel

@{
    ViewData["Title"] = "إضافة نقطة تحصيل جديدة";
}

<div class="financial-page financial-hub-page">
    @{
        ViewBag.FinancialNavShowWarehouse = false;
        ViewBag.FinancialNavCurrent = "collection";
    }
    <partial name="_FinancialQuickNav" />
    @{
        ViewBag.FinancialHeroIcon = "fas fa-store";
        ViewBag.FinancialHeroTheme = "default";
        ViewBag.FinancialHeroSubtitle = "إرسال طلب إنشاء حساب نقطة تحصيل لمدير النظام";
    }
    <partial name="_FinancialSysHero" />

<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-user-plus"></i>
            بيانات نقطة التحصيل
        </h3>
    </div>
    <div class="card-body">
        <div class="alert alert-info d-flex align-items-start gap-2" role="alert">
            <i class="fas fa-circle-info mt-1"></i>
            <div>
                سيتم إرسال الطلب إلى <strong>مدير النظام</strong> ضمن شاشة <strong>طلبات الانضمام</strong>.
                عند الموافقة يتم إنشاء حساب نقطة التحصيل وتطبيق الرصيد الابتدائي تلقائياً.
            </div>
        </div>

        <form asp-action="Create" method="post" class="radtk-form">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label"></label>
                        <input asp-for="FullName" class="form-control" />
                        <span asp-validation-for="FullName" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label"></label>
                        <input asp-for="UserName" class="form-control" />
                        <span asp-validation-for="UserName" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="PhoneNumber" class="form-label"></label>
                        <input asp-for="PhoneNumber" class="form-control" />
                        <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Address" class="form-label"></label>
                        <input asp-for="Address" class="form-control" />
                        <span asp-validation-for="Address" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="mb-3">
                        <label asp-for="InitialBalance" class="form-label"></label>
                        <input asp-for="InitialBalance" class="form-control" min="0" step="0.01" />
                        <span class="form-text text-muted">في حال الموافقة على الطلب سيتم تطبيق الرصيد الابتدائي عند إنشاء الحساب.</span>
                        <span asp-validation-for="InitialBalance" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label"></label>
                        <input asp-for="Password" class="form-control" />
                        <span asp-validation-for="Password" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label"></label>
                        <input asp-for="ConfirmPassword" class="form-control" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="mt-3">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-paper-plane"></i> إرسال طلب إنشاء نقطة التحصيل
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-arrow-right"></i> رجوع للقائمة
                </a>
            </div>
        </form>
    </div>
</div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

