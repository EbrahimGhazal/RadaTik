@model RadaTik.ViewModels.CollectionPoints.EditCollectionPointViewModel

@{
    ViewData["Title"] = "تعديل رصيد نقطة التحصيل";
}

<div class="financial-page financial-hub-page">
    @{
        ViewBag.FinancialNavShowWarehouse = false;
        ViewBag.FinancialNavCurrent = "collection";
    }
    <partial name="_FinancialQuickNav" />
    @{
        ViewBag.FinancialHeroIcon = "fas fa-edit";
        ViewBag.FinancialHeroTheme = "default";
        ViewBag.FinancialHeroSubtitle = "تعديل رصيد نقطة التحصيل فقط";
    }
    <partial name="_FinancialSysHero" />

<div class="card">
    <div class="card-body">
        <form asp-action="Edit" method="post" class="radtk-form">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <div class="mb-3">
                <label class="form-label">اسم نقطة التحصيل</label>
                <input class="form-control" value="@Model.UserName" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="CurrentBalance" class="form-label"></label>
                <input asp-for="CurrentBalance" class="form-control" readonly />
            </div>

            <div class="mb-3">
                <label asp-for="NewBalance" class="form-label"></label>
                <input asp-for="NewBalance" class="form-control" min="0" step="0.01" />
                <span class="form-text text-muted">أدخل الرصيد الجديد (صفر أو قيمة موجبة فقط).</span>
                <span asp-validation-for="NewBalance" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save"></i> حفظ التعديلات
            </button>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-right"></i> رجوع للقائمة
            </a>
        </form>
    </div>
</div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

