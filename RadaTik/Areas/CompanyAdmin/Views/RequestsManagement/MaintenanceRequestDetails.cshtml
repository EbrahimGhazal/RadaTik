@model RadaTik.Models.MaintenanceRequest
@using RadaTik.Models
@inject RadaTik.Services.IFeatureAccessService FeatureAccess
@using RadaTik.Security
@{
    ViewData["Title"] = $"طلب صيانة #{Model.Id}";
    ViewBag.PageHeroIcon = "fas fa-tools";
    ViewBag.PageHeroSubtitle = Model.Client?.Name;
    ViewBag.PageHeroBackUrl = Url.RouteUrl("networkManager-requestsManagement", new { action = "MaintenanceRequests" });
    ViewBag.PageHeroBackText = "العودة للقائمة";
    ViewBag.MaintenanceRouteName = "networkManager-requestsManagement";
    ViewBag.ClientProfileUrl = Url.RouteUrl("networkManager-clients", new { action = "Details", id = Model.ClientId });
    ViewBag.ShowInvoiceLedgerLinks = true;
    ViewBag.CanMoneyDiary = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.MoneyDiary);
    ViewBag.CanWarehouse = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Warehouse);
}
<div class="radtk-page--companyadmin-views-requestsmanagement-maintenancerequestdetails radtk-page-maint-details maint-request-details-page">

<partial name="_CrudPageHero" />
<partial name="_MaintenanceRequestDetailsBody" />

</div>
@section Styles {
    <link rel="stylesheet" href="~/css/maintenance-request-details-cards.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/form-once-submit.js" asp-append-version="true"></script>
    <script src="~/js/maintenance-request-details.js" asp-append-version="true"></script>
}
