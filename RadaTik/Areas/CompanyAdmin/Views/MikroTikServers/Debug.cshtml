@model RadaTik.Models.MikroTikServer

@{
    ViewData["Title"] = "تصحيح الأخطاء - الخادم";
}

<h2>
    <i class="fas fa-bug"></i>
    تصحيح الأخطاء للخادم
</h2>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-info text-white">
                <h5 class="card-title mb-0">معلومات الخادم</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">المعرف:</dt>
                    <dd class="col-sm-8">@Model.Id</dd>

                    <dt class="col-sm-4">الخادم:</dt>
                    <dd class="col-sm-8">@Model.Host:@Model.Port</dd>

                    <dt class="col-sm-4">المستخدم:</dt>
                    <dd class="col-sm-8">@Model.User</dd>

                    <dt class="col-sm-4">ملاحظات:</dt>
                    <dd class="col-sm-8">@(string.IsNullOrEmpty(Model.Notes) ? "لا توجد ملاحظات" : Model.Notes)</dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-header bg-warning text-dark">
                <h5 class="card-title mb-0">اختبارات سريعة</h5>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="@Url.Action("TestConnection", new { id = Model.Id })" class="btn btn-primary">
                        <i class="fas fa-plug"></i> اختبار الاتصال
                    </a>
                    <span class="text-muted small">- يوجه لصفحة التفاصيل مع رسالة</span>

                    <a href="@Url.Action("ActiveUsers", new { id = Model.Id })" class="btn btn-success mt-2">
                        <i class="fas fa-bolt"></i> المستخدمين النشطين
                    </a>
                    <span class="text-muted small">- يجب أن يفتح صفحة جديدة</span>

                    <a href="@Url.Action("AllUsers", new { id = Model.Id })" class="btn btn-info mt-2">
                        <i class="fas fa-list"></i> جميع المستخدمين
                    </a>
                    <span class="text-muted small">- يجب أن يفتح صفحة جديدة</span>
                </div>
            </div>
        </div>
    </div>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mt-3">
        <h5><i class="fas fa-exclamation-triangle"></i> خطأ:</h5>
        @TempData["Error"]
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success mt-3">
        <h5><i class="fas fa-check-circle"></i> نجاح:</h5>
        @TempData["Success"]
    </div>
}

<div class="mt-4">
    <div class="card">
        <div class="card-header bg-secondary text-white">
            <h5 class="card-title mb-0">نصائح استكشاف الأخطاء</h5>
        </div>
        <div class="card-body">
            <ul>
                <li>افتح نافذة <strong>Output</strong> في Visual Studio لمشاهدة السجلات</li>
                <li>تحقق من أن خادم المايكروتك يعمل ومفعل</li>
                <li>تأكد من صحة بيانات الاتصال (IP, Port, Username, Password)</li>
                <li>تحقق من أن خدمة API مفعلة في المايكروتك</li>
                <li>تأكد من أن الجدار الناري يسمح بالاتصال</li>
            </ul>
        </div>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">
        <i class="fas fa-arrow-right"></i> العودة للتفاصيل
    </a>
</div>