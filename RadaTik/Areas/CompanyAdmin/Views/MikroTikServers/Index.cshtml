@model IEnumerable<RadaTik.Models.MikroTikServer>
@using RadaTik.Security
@using RadaTik.Models

@{
    ViewData["Title"] = "خوادم مايكروتك";
    var hasRenewalPricing = (ViewBag.ServerRenewalHasPricing as bool?) ?? false;
    var renewalPeriodLabel = ViewBag.ServerRenewalPeriodLabel as string ?? "غير محدد";
    var activeServers = (ViewBag.ServerRenewalActiveServers as int?) ?? 0;
    var additionalServers = (ViewBag.ServerRenewalAdditionalServers as int?) ?? 0;
    var renewalUnitPrice = (ViewBag.ServerRenewalUnitPriceSyp as decimal?) ?? 0m;
    var renewalEstimate = (ViewBag.ServerRenewalEstimatedAmountSyp as decimal?) ?? 0m;
    var showAllNetworks = (ViewBag.ShowAllNetworks as bool?) ?? false;
    var isAllNetworksSelection = (ViewBag.IsAllNetworksSelection as bool?) ?? false;
    var selectedNetworkId = (ViewBag.SelectedNetworkId as int?) ?? 0;
    var networks = ViewBag.Networks as IEnumerable<Network> ?? Enumerable.Empty<Network>();
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="radtk-page-mikrotik-servers mikrotik-servers-page">
<div class="sys-hero mikrotik-servers-hero mb-3">
    <div class="sys-hero-main">
        <div class="sys-hero-icon"><i class="fas fa-server"></i></div>
        <div>
            <h1 class="sys-hero-title mb-1">@ViewData["Title"]</h1>
            <p class="sys-hero-subtitle mb-0">
                إدارة اتصالات RouterOS — العناوين، المنافذ، الحالة، والمستخدمين.
            </p>
        </div>
    </div>
    <div class="sys-hero-actions mikrotik-servers-hero__actions d-flex flex-wrap gap-2">
        @if (User.IsInRole(RoleNames.NetworkAdministrator))
        {
            <a asp-route="networkManager-mikrotik-traffic"
               class="btn btn-outline-info">
                <i class="fas fa-chart-area"></i>
                <span class="mikrotik-servers-hero__btn-text">مراقبة الترافك المباشر</span>
            </a>
        }
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i>
            <span class="mikrotik-servers-hero__btn-text">إضافة خادم جديد</span>
        </a>
        <a asp-action="CreateBulk" class="btn btn-outline-primary">
            <i class="fas fa-layer-group"></i>
            <span class="mikrotik-servers-hero__btn-text">إضافة مجموعة سيرفرات</span>
        </a>
    </div>
</div>

@if (isAllNetworksSelection)
{
    <div class="alert alert-secondary mb-4">
        <i class="fas fa-layer-group me-1"></i>
        تم اختيار <strong>كل الشبكات</strong>. ملخص التجديد الدوري يظهر عند اختيار شبكة محددة.
    </div>
}
else
{
    <div class="alert @(hasRenewalPricing ? "alert-info" : "alert-warning") mb-4 mikrotik-servers-renewal">
        <div class="d-flex flex-wrap gap-3 align-items-center justify-content-between">
            <div class="mikrotik-servers-renewal__copy">
                <i class="fas fa-calendar-check me-1"></i>
                <strong>ملخص التجديد الدوري لخدمة السيرفرات</strong>
                <div class="small mt-1">
                    @(hasRenewalPricing
                        ? $"الدورة: {renewalPeriodLabel} | سعر التجديد للوحدة: {renewalUnitPrice:N2} ل.س.ج"
                        : "لم يتم تعريف سياسة تجديد السيرفرات بعد من مدير النظام.")
                </div>
            </div>
            @if (hasRenewalPricing)
            {
                <div class="d-flex flex-wrap gap-2 mikrotik-servers-renewal__badges">
                    <span class="badge bg-light text-dark border">إجمالي السيرفرات: @activeServers</span>
                    <span class="badge bg-warning text-dark">سيرفرات إضافية: @additionalServers</span>
                    <span class="badge bg-primary">تقدير التجديد القادم: @SyrianCurrencyHelper.FormatNew(renewalEstimate) ل.س.ج</span>
                </div>
            }
        </div>
    </div>
}

<div class="card border-0 shadow-sm mikrotik-servers-card">
    <div class="card-body">
        <form asp-action="Index" method="get" class="row g-2 align-items-end mb-3 mikrotik-servers-filter">
            <div class="col-12 col-md-6 col-lg-4">
                <label for="selectedNetworkId" class="form-label">تصفية حسب الشبكة</label>
                <select id="selectedNetworkId" name="selectedNetworkId" class="form-select">
                    @if (selectedNetworkId == 0)
                    {
                        <option value="0" selected>كل الشبكات</option>
                    }
                    else
                    {
                        <option value="0">كل الشبكات</option>
                    }
                    @foreach (var network in networks)
                    {
                        if (selectedNetworkId == network.Id)
                        {
                            <option value="@network.Id" selected>@network.Name</option>
                        }
                        else
                        {
                            <option value="@network.Id">@network.Name</option>
                        }
                    }
                </select>
            </div>
            <div class="col-6 col-md-auto">
                <button type="submit" class="btn btn-outline-primary w-100">
                    <i class="fas fa-filter"></i> تطبيق
                </button>
            </div>
            <div class="col-6 col-md-auto">
                <a asp-action="Index" class="btn btn-outline-secondary w-100">
                    <i class="fas fa-undo"></i> إعادة الضبط
                </a>
            </div>
        </form>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <i class="fas fa-server fa-3x text-muted mb-3"></i>
                <h4>لا توجد خوادم مضافة</h4>
                <p class="text-muted">ابدأ بإضافة خادم مايكروتك جديد.</p>
                <a asp-action="Create" class="btn btn-primary">
                    <i class="fas fa-plus"></i> إضافة خادم جديد
                </a>
            </div>
        }
        else
        {
            <div class="table-responsive mikrotik-servers-shell">
                <table id="mikrotikServersTable" class="table table-hover mikrotik-servers-table mb-0 radtk-data-table radtk-data-table--cards">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" class="text-center" style="width: 3.5rem;">#</th>
                            @if (showAllNetworks)
                            {
                                <th>الشبكة</th>
                            }
                            <th>اسم الخادم</th>
                            <th>المضيف</th>
                            <th>المنفذ</th>
                            <th>اسم المستخدم</th>
                            <th>الحالة</th>
                            <th>تاريخ الإنشاء</th>
                            <th>الإجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var rowNumber = 0;
                        }
                        @foreach (var item in Model)
                        {
                            rowNumber++;
                            <tr class="@(item.IsActive ? "" : "mikrotik-servers-row--inactive")">
                                <td class="text-center text-muted" data-label="#">@rowNumber</td>
                                @if (showAllNetworks)
                                {
                                    <td data-label="الشبكة">@(item.Network?.Name ?? "-")</td>
                                }
                                <td class="mikrotik-servers-cell--lead" data-label="اسم الخادم">
                                    <strong>@item.Name</strong>
                                    @if (!string.IsNullOrEmpty(item.UserID))
                                    {
                                        <br />
                                        <small class="text-muted text-break">@item.UserID</small>
                                    }
                                </td>
                                <td data-label="المضيف"><code class="small text-break">@item.Host</code></td>
                                <td data-label="المنفذ" dir="ltr" class="text-end text-md-start" data-syp-skip-format="true">@item.Port</td>
                                <td data-label="اسم المستخدم" class="text-break">@item.User</td>
                                <td data-label="الحالة">
                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">نشط</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">غير نشط</span>
                                    }
                                </td>
                                <td data-label="تاريخ الإنشاء">@item.CreatedAt.ToString("yyyy-MM-dd")</td>
                                <td class="mikrotik-servers-action-cell radtk-col-actions" data-label="الإجراءات">
                                    <div class="mikrotik-servers-actions" role="group" aria-label="إجراءات الخادم">
                                        <a asp-action="Details" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-info" title="تفاصيل">
                                            <i class="fas fa-eye"></i>
                                            <span class="mikrotik-servers-actions__label">تفاصيل</span>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-warning" title="تعديل">
                                            <i class="fas fa-edit"></i>
                                            <span class="mikrotik-servers-actions__label">تعديل</span>
                                        </a>
                                        <a asp-action="TestConnection" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-primary" title="اختبار الاتصال">
                                            <i class="fas fa-wifi"></i>
                                            <span class="mikrotik-servers-actions__label">اختبار</span>
                                        </a>
                                        <a asp-action="AllUsers" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-success" title="المستخدمين">
                                            <i class="fas fa-users"></i>
                                            <span class="mikrotik-servers-actions__label">مستخدمين</span>
                                        </a>
                                        @if (User.IsInRole(RoleNames.NetworkAdministrator))
                                        {
                                            <a asp-route="networkManager-mikrotik-traffic"
                                               asp-route-serverId="@item.Id"
                                               class="btn btn-sm btn-outline-secondary" title="ترافك الواجهات">
                                                <i class="fas fa-chart-line"></i>
                                                <span class="mikrotik-servers-actions__label">ترافك</span>
                                            </a>
                                        }
                                        <a asp-action="Delete" asp-route-id="@item.Id"
                                           class="btn btn-sm btn-outline-danger" title="حذف">
                                            <i class="fas fa-trash"></i>
                                            <span class="mikrotik-servers-actions__label">حذف</span>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
    @if (Model.Any())
    {
        <div class="card-footer text-muted mikrotik-servers-footer">
            <div class="row g-2 align-items-center">
                <div class="col-12 col-md-6">
                    <i class="fas fa-info-circle"></i>
                    <small>إجمالي الخوادم: @Model.Count()</small>
                </div>
                <div class="col-12 col-md-6 text-md-end">
                    <small>
                        <i class="far fa-clock"></i>
                        آخر تحديث: @DateTime.Now.ToString("yyyy-MM-dd HH:mm")
                    </small>
                </div>
            </div>
        </div>
    }
</div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/mikrotik-servers-cards.css" asp-append-version="true" />
}
