@using RadaTik.Areas.CompanyAdmin.ViewModels
@using RadaTik.Models.Business
@{
    ViewData["Title"] = "المستودع";
    var items = ViewBag.Items as List<WarehouseItemRowViewModel> ?? new List<WarehouseItemRowViewModel>();
    var movements = ViewBag.RecentMovements as List<WarehouseMovement> ?? new List<WarehouseMovement>();
    var companyName = ViewBag.CompanyName as string ?? "";
    var lowStock = (int)(ViewBag.LowStockCount ?? 0);
}

<div class="page-header mb-3">
    <h1 class="page-title"><i class="fas fa-warehouse"></i> @ViewData["Title"]</h1>
    <p class="text-muted mb-0">@companyName — عرض الأصناف والحركات</p>
</div>

@if (lowStock > 0)
{
    <div class="alert alert-warning"><i class="fas fa-exclamation-triangle"></i> @lowStock صنف بكمية صفر أو أقل.</div>
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white"><h6 class="mb-0">الأصناف</h6></div>
    <div class="table-responsive">
        <table class="table table-sm mb-0 radtk-data-table radtk-data-table--cards">
            <thead><tr><th>الصنف</th><th>SKU</th><th>الكمية</th><th>الوحدة</th><th>الحالة</th></tr></thead>
            <tbody>
            @if (!items.Any()) { <tr><td colspan="5" class="text-center text-muted py-3">لا توجد أصناف.</td></tr> }
            @foreach (var i in items)
            {
                <tr class="@(i.IsActive && i.OnHand <= 0 ? "table-warning" : "")">
                    <td>@i.Name</td>
                    <td>@(i.Sku ?? "—")</td>
                    <td class="fw-bold">@i.OnHand.ToString("N2")</td>
                    <td>@(i.Unit ?? "قطعة")</td>
                    <td>@(i.IsActive ? "نشط" : "موقوف")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white"><h6 class="mb-0">آخر الحركات</h6></div>
    <div class="table-responsive">
        <table class="table table-sm mb-0 radtk-data-table radtk-data-table--cards">
            <thead><tr><th>التاريخ</th><th>الصنف</th><th>النوع</th><th>الكمية</th></tr></thead>
            <tbody>
            @if (!movements.Any()) { <tr><td colspan="4" class="text-center text-muted py-3">لا توجد حركات.</td></tr> }
            @foreach (var m in movements)
            {
                <tr>
                    <td>@m.MovementDate.ToString("yyyy-MM-dd")</td>
                    <td>@(m.WarehouseItem?.Name ?? "—")</td>
                    <td>@m.MovementType</td>
                    <td>@m.Quantity.ToString("N2")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
