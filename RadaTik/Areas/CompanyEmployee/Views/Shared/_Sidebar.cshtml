@using RadaTik.Security

@inject RadaTik.Services.IPermissionService PermissionService
@inject RadaTik.Services.IFeatureAccessService FeatureAccess

@{
    var isAuthenticated = (bool?)(ViewData["Layout_IsAuthenticated"]) == true;
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
}

<aside class="sidebar sidebar-pro sidebar-employee" id="sidebar">
    <div class="sidebar-header">
        <div class="sidebar-logo">
            <i class="fas fa-briefcase"></i>
        </div>
        <div class="sidebar-brand">
            <span class="sidebar-brand-name">RadaTik</span>
            <small class="sidebar-brand-sub">بوابة الموظف</small>
        </div>
    </div>

    <nav class="sidebar-nav" data-single-open="true">
        @if (!isAuthenticated)
        {
            <div class="nav-section">
                <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                    <i class="fas fa-bars"></i>
                    <span>القائمة</span>
                    <i class="fas fa-chevron-down nav-section-chevron"></i>
                </div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link" asp-route="reglog-login">
                            <span class="nav-icon"><i class="fas fa-sign-in-alt"></i></span>
                            <span>تسجيل الدخول</span>
                        </a>
                    </li>
                </ul>
            </div>
        }
        else
        {
            var canUseMikroTikServers = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.MikroTikServers);
            var canUseSectors = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Sectors);
            var canUseReceivers = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Receivers);
            var canUseRequests = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Requests);
            var canUseClients = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Clients);
            var canUseWarehouse = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Warehouse);
            var canUseMoneyDiary = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.MoneyDiary);
            var canUsePayroll = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Payroll);
            var canUseErp = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Erp);

            var canViewMikroTikServers = canUseMikroTikServers && await PermissionService.HasPermissionAsync(User, "MikroTikServers.View");
            var canViewSectors = canUseSectors && await PermissionService.HasPermissionAsync(User, "Sectors.View");
            var canViewReceivers = canUseReceivers && await PermissionService.HasPermissionAsync(User, "Receivers.View");
            var canViewClients = canUseClients && await PermissionService.HasPermissionAsync(User, "Clients.View");
            var canCreateClients = canUseClients && await PermissionService.HasPermissionAsync(User, "Clients.Create");
            var canImportClients = canUseClients && await PermissionService.HasPermissionAsync(User, "Clients.ImportFromServer");

            var canViewRequests = canUseRequests && await PermissionService.HasPermissionAsync(User, "Requests.View");
            var canManageMaintenance = canUseRequests && await PermissionService.HasPermissionAsync(User, "MaintenanceRequests.Manage");
            var canImplementSpeedChange = canUseRequests && await PermissionService.HasPermissionAsync(User, "SpeedChange.Implement");

            var canViewWarehouse = canUseWarehouse && await PermissionService.HasPermissionAsync(User, "Warehouse.View");
            var canStocktake = canUseWarehouse && await PermissionService.HasPermissionAsync(User, "WarehouseStocktake.Manage");
            var canViewMaterialPurchase = canUseWarehouse && await PermissionService.HasPermissionAsync(User, "MaterialPurchase.View");
            var canViewMaterialSales = canUseWarehouse && await PermissionService.HasPermissionAsync(User, "MaterialSales.View");
            var canViewMoneyDiary = canUseMoneyDiary && await PermissionService.HasPermissionAsync(User, "MoneyDiary.View");
            var canViewReconciliation = canUseMoneyDiary && await PermissionService.HasPermissionAsync(User, "FinancialReconciliation.View");
            var canViewCompanyPayroll = canUsePayroll && await PermissionService.HasPermissionAsync(User, "Payroll.View");

            var showMyPayroll = canUsePayroll;
            var showMyErpTasks = canUseErp;
            var showCompanyFinance = canViewCompanyPayroll || canViewMoneyDiary || canViewReconciliation;
            var showAnyWarehouse = canViewWarehouse || canStocktake || canViewMaterialPurchase || canViewMaterialSales;
            var showRequestTasks = canViewRequests || canManageMaintenance || canImplementSpeedChange;
            var showNetwork = canViewSectors || canViewReceivers || canViewMikroTikServers;
            var showAnyWork = canViewClients || showRequestTasks || showNetwork || showCompanyFinance || showAnyWarehouse;

            var requestsOpen = controller == "RequestsManagement";
            var clientsOpen = controller == "Clients" || controller == "NewSubscriberWizard";
            var networkOpen = controller == "MikroTikServers" || controller == "Sector" || controller == "Receiver";
            var accountOpen = controller == "Account" || controller == "MyPayroll";

            @* ——— 1. البداية ——— *@
            <div class="nav-section nav-section-quick" data-section-key="quick-access">
                <div class="nav-section-title nav-section-static">
                    <i class="fas fa-gauge-high"></i>
                    <span>البداية</span>
                </div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Dashboard" ? "active" : "")" asp-route="employee-dashboard">
                            <span class="nav-icon"><i class="fas fa-home"></i></span>
                            <span>لوحة التحكم</span>
                        </a>
                    </li>
                    @if (canViewRequests)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(controller == "RequestsManagement" && action == "Index" ? "active" : "")"
                               asp-route="employee-requestsManagement" asp-route-action="Index">
                                <span class="nav-icon"><i class="fas fa-clipboard-list"></i></span>
                                <span>لوحة الطلبات</span>
                                <span class="nav-badge" id="pendingRequestsBadge" style="display: none;">0</span>
                            </a>
                        </li>
                    }
                    @if (showMyErpTasks)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(controller == "MyEmployeeTasks" ? "active" : "")"
                               asp-route="employee-my-tasks">
                                <span class="nav-icon"><i class="fas fa-tasks"></i></span>
                                <span>مهامي (ERP)</span>
                            </a>
                        </li>
                    }
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Notifications" ? "active" : "")"
                           asp-route="employee-notifications">
                            <span class="nav-icon"><i class="fas fa-bell"></i></span>
                            <span>التنبيهات</span>
                            <span class="nav-badge" id="employeeNotificationsUnreadBadge" style="display: none;">0</span>
                        </a>
                    </li>
                </ul>
            </div>

            @* ——— 2. مهامي وصلاحياتي (عمل الشركة) ——— *@
            @if (showAnyWork)
            {
                <div class="nav-section nav-section-heading" aria-hidden="true">
                    <div class="nav-section-title nav-section-static">
                        <i class="fas fa-briefcase"></i>
                        <span>مهامي وصلاحياتي</span>
                    </div>
                </div>

                @if (canViewClients)
                {
                    <div class="nav-section" data-section-key="clients">
                        <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                            <i class="fas fa-users"></i>
                            <span>العملاء</span>
                            <i class="fas fa-chevron-down nav-section-chevron"></i>
                        </div>
                        <ul class="nav-list">
                            <li class="nav-item has-dropdown @(clientsOpen ? "open" : "")">
                                <div class="nav-link-toggle" role="button" tabindex="0">
                                    <span class="nav-icon"><i class="fas fa-user-circle"></i></span>
                                    <span>المشتركون</span>
                                    <i class="fas fa-chevron-down nav-chevron"></i>
                                </div>
                                <ul class="nav-sublist">
                                    <li class="nav-item">
                                        <a class="nav-link nav-link-sub @(controller == "Clients" && action == "Index" ? "active" : "")"
                                           asp-area="CompanyEmployee" asp-controller="Clients" asp-action="Index">
                                            <i class="fas fa-list"></i>
                                            <span>قائمة العملاء</span>
                                        </a>
                                    </li>
                                    @if (canCreateClients)
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link nav-link-sub @(controller == "Clients" && action == "Create" ? "active" : "")"
                                               asp-area="CompanyEmployee" asp-controller="Clients" asp-action="Create">
                                                <i class="fas fa-user-plus"></i>
                                                <span>إضافة عميل</span>
                                            </a>
                                        </li>
                                    }
                                    @if (canImportClients)
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link nav-link-sub @(controller == "Clients" && action == "ImportFromServer" ? "active" : "")"
                                               asp-area="CompanyEmployee" asp-controller="Clients" asp-action="ImportFromServer">
                                                <i class="fas fa-cloud-download-alt"></i>
                                                <span>استيراد من السيرفر</span>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        </ul>
                    </div>
                }

                @if (showRequestTasks)
                {
                    <div class="nav-section" data-section-key="requests">
                        <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                            <i class="fas fa-headset"></i>
                            <span>الطلبات والصيانة</span>
                            <i class="fas fa-chevron-down nav-section-chevron"></i>
                        </div>
                        <ul class="nav-list">
                            <li class="nav-item has-dropdown @(requestsOpen ? "open" : "")">
                                <div class="nav-link-toggle" role="button" tabindex="0">
                                    <span class="nav-icon"><i class="fas fa-tasks"></i></span>
                                    <span>إدارة الطلبات</span>
                                    <i class="fas fa-chevron-down nav-chevron"></i>
                                </div>
                                <ul class="nav-sublist">
                                    <li class="nav-group-label">صيانة · سرعة</li>
                                    @if (canViewRequests || canManageMaintenance)
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link nav-link-sub @(controller == "RequestsManagement" && action == "MaintenanceRequests" ? "active" : "")"
                                               asp-route="employee-requestsManagement" asp-route-action="MaintenanceRequests">
                                                <i class="fas fa-wrench"></i>
                                                <span>طلبات الصيانة</span>
                                            </a>
                                        </li>
                                    }
                                    @if (canViewRequests || canImplementSpeedChange)
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link nav-link-sub @(controller == "RequestsManagement" && action == "SpeedChangeRequests" ? "active" : "")"
                                               asp-route="employee-requestsManagement" asp-route-action="SpeedChangeRequests">
                                                <i class="fas fa-tachometer-alt"></i>
                                                <span>طلبات تغيير السرعة</span>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        </ul>
                    </div>
                }

                @if (showNetwork)
                {
                    <div class="nav-section" data-section-key="network">
                        <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                            <i class="fas fa-network-wired"></i>
                            <span>إدارة الشبكة</span>
                            <i class="fas fa-chevron-down nav-section-chevron"></i>
                        </div>
                        <ul class="nav-list">
                            <li class="nav-item has-dropdown @(networkOpen ? "open" : "")">
                                <div class="nav-link-toggle" role="button" tabindex="0">
                                    <span class="nav-icon"><i class="fas fa-server"></i></span>
                                    <span>البنية التحتية</span>
                                    <i class="fas fa-chevron-down nav-chevron"></i>
                                </div>
                                <ul class="nav-sublist">
                                    <li class="nav-group-label">خوادم · مرسلات · مستقبلات</li>
                                    @if (canViewMikroTikServers)
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link nav-link-sub @(controller == "MikroTikServers" ? "active" : "")"
                                               asp-area="CompanyEmployee" asp-controller="MikroTikServers" asp-action="Index">
                                                <i class="fas fa-server"></i>
                                                <span>المخدمات</span>
                                            </a>
                                        </li>
                                    }
                                    @if (canViewSectors)
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link nav-link-sub @(controller == "Sector" ? "active" : "")"
                                               asp-area="CompanyEmployee" asp-controller="Sector" asp-action="Index">
                                                <i class="fas fa-broadcast-tower"></i>
                                                <span>المرسلات (القطاعات)</span>
                                            </a>
                                        </li>
                                    }
                                    @if (canViewReceivers)
                                    {
                                        <li class="nav-item">
                                            <a class="nav-link nav-link-sub @(controller == "Receiver" ? "active" : "")"
                                               asp-area="CompanyEmployee" asp-controller="Receiver" asp-action="Index">
                                                <i class="fas fa-satellite-dish"></i>
                                                <span>المستقبلات</span>
                                            </a>
                                        </li>
                                    }
                                </ul>
                            </li>
                        </ul>
                    </div>
                }

                @if (showCompanyFinance)
                {
                    <div class="nav-section" data-section-key="company-finance">
                        <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                            <i class="fas fa-building-columns"></i>
                            <span>مالية الشركة</span>
                            <i class="fas fa-chevron-down nav-section-chevron"></i>
                        </div>
                        <ul class="nav-list">
                            @if (canViewCompanyPayroll)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(controller == "CompanyPayroll" ? "active" : "")"
                                       asp-area="CompanyEmployee" asp-controller="CompanyPayroll" asp-action="Index">
                                        <span class="nav-icon"><i class="fas fa-money-check-alt"></i></span>
                                        <span>رواتب الشركة</span>
                                    </a>
                                </li>
                            }
                            @if (canViewMoneyDiary)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(controller == "MoneyDiary" && action == "Index" ? "active" : "")"
                                       asp-area="CompanyEmployee" asp-controller="MoneyDiary" asp-action="Index">
                                        <span class="nav-icon"><i class="fas fa-book"></i></span>
                                        <span>دفتر الإيراد والمصروف</span>
                                    </a>
                                </li>
                            }
                            @if (canViewReconciliation)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(controller == "MoneyDiary" && action == "Reconciliation" ? "active" : "")"
                                       asp-area="CompanyEmployee" asp-controller="MoneyDiary" asp-action="Reconciliation">
                                        <span class="nav-icon"><i class="fas fa-balance-scale"></i></span>
                                        <span>الجرد المالي</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }

                @if (showAnyWarehouse)
                {
                    <div class="nav-section" data-section-key="warehouse">
                        <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                            <i class="fas fa-warehouse"></i>
                            <span>المستودع والمواد</span>
                            <i class="fas fa-chevron-down nav-section-chevron"></i>
                        </div>
                        <ul class="nav-list">
                            @if (canViewWarehouse)
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-sub @(controller == "Warehouse" && action == "Index" ? "active" : "")"
                                       asp-area="CompanyEmployee" asp-controller="Warehouse" asp-action="Index">
                                        <span class="nav-icon"><i class="fas fa-boxes"></i></span>
                                        <span>المستودع</span>
                                    </a>
                                </li>
                            }
                            @if (canStocktake)
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-sub @(controller == "WarehouseStocktake" ? "active" : "")"
                                       asp-area="CompanyEmployee" asp-controller="WarehouseStocktake" asp-action="Index">
                                        <span class="nav-icon"><i class="fas fa-clipboard-check"></i></span>
                                        <span>جرد المستودع</span>
                                    </a>
                                </li>
                            }
                            @if (canViewMaterialPurchase)
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-sub @(controller == "MaterialPurchaseInvoices" ? "active" : "")"
                                       asp-area="CompanyEmployee" asp-controller="MaterialPurchaseInvoices" asp-action="Index">
                                        <span class="nav-icon"><i class="fas fa-file-invoice"></i></span>
                                        <span>فواتير الشراء</span>
                                    </a>
                                </li>
                            }
                            @if (canViewMaterialSales)
                            {
                                <li class="nav-item">
                                    <a class="nav-link nav-link-sub @(controller == "MaterialSalesInvoices" ? "active" : "")"
                                       asp-area="CompanyEmployee" asp-controller="MaterialSalesInvoices" asp-action="Index">
                                        <span class="nav-icon"><i class="fas fa-receipt"></i></span>
                                        <span>فواتير البيع</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
            else if (!showMyPayroll)
            {
                <div class="nav-section nav-section-empty-work">
                    <p class="nav-empty-hint">
                        <i class="fas fa-info-circle"></i>
                        لا توجد مهام عمل مُفعّلة بعد. راجع مدير الشبكة لتعيين الصلاحيات.
                    </p>
                </div>
            }

            @* ——— 3. حسابي الشخصي (بروفايل · راتب · محفظة) ——— *@
            <div class="nav-section nav-section-account @(accountOpen ? "section-has-active" : "")" data-section-key="account">
                <div class="nav-section-title nav-section-static">
                    <i class="fas fa-user-circle"></i>
                    <span>حسابي الشخصي</span>
                </div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Account" ? "active" : "")" asp-route="employee-profile">
                            <span class="nav-icon"><i class="fas fa-id-card"></i></span>
                            <span>بروفايلي</span>
                            <small class="nav-link-hint">الاسم · البريد · كلمة المرور</small>
                        </a>
                    </li>
                    @if (showMyPayroll)
                    {
                        <li class="nav-item">
                            <a class="nav-link nav-link-personal-wallet @(controller == "MyPayroll" ? "active" : "")" asp-route="employee-my-payroll">
                                <span class="nav-icon"><i class="fas fa-wallet"></i></span>
                                <span>راتبي ومحفظتي</span>
                                <small class="nav-link-hint">مستحقات · مكافآت · خصومات</small>
                            </a>
                        </li>
                    }
                </ul>
            </div>
        }
    </nav>
</aside>
