<div class="radtk-page-emp-clients-index">
<div class="radtk-page-emp-clients-index">
@model IEnumerable<RadaTik.Models.Client>
@using RadaTik.Services.Clients

@{
    ViewData["Title"] = "قائمة العملاء";

    var canView = await PermissionService.HasPermissionAsync(User, "Clients.View");
    var canCreate = await PermissionService.HasPermissionAsync(User, "Clients.Create");
    var canEdit = await PermissionService.HasPermissionAsync(User, "Clients.Edit");
    var canImportFromServer = await PermissionService.HasPermissionAsync(User, "Clients.ImportFromServer");
    var canFreeze = canEdit;
    var canRenew = canEdit;
    var canDetails = canView;

    // حساب الإحصائيات
    var totalClients = Model.Count();
    var activeClients = Model.Count(c => c.IsActive);
    var inactiveClients = Model.Count(c => !c.IsActive);
    var duplicateClients = Model.Count(c => c.IsCrossServerDuplicate);
    var vipClients = Model.Count(c => c.IsVip);

    // حساب مجموع السرعات (بالميجابت) — تنزيل ورفع (الرفع الناقص = التنزيل)
    var totalDownloadSpeed = 0m;
    var totalUploadSpeed = 0m;
    var activeSpeed = 0m;
    var inactiveSpeed = 0m;
    var connectedDownloadSpeed = 0m;
    var connectedUploadSpeed = 0m;
    var disconnectedSpeed = 0m;

    var connectedClients = ViewBag.ConnectedClientIds as ISet<int> ?? new HashSet<int>();
    var connectionsReady = ViewBag.ConnectionsReady as bool? ?? false;
    foreach (var item in Model)
    {
        decimal downloadSpeed = 0;
        decimal uploadSpeed = 0;
        if (item.Profile != null)
        {
            downloadSpeed = item.Profile.DownloadSpeedMbps;
            uploadSpeed = item.Profile.EffectiveUploadSpeedMbps;
        }
        else if (!string.IsNullOrEmpty(item.ProfileName))
        {
            var numbers = System.Text.RegularExpressions.Regex.Match(item.ProfileName, @"\d+");
            if (numbers.Success && int.TryParse(numbers.Value, out var parsedSpeed))
            {
                downloadSpeed = parsedSpeed;
                uploadSpeed = parsedSpeed;
            }
        }

        if (downloadSpeed > 0 || uploadSpeed > 0)
        {
            totalDownloadSpeed += downloadSpeed;
            totalUploadSpeed += uploadSpeed;
            if (item.IsActive)
            {
                activeSpeed += downloadSpeed;
                if (connectedClients.Contains(item.Id))
                {
                    connectedDownloadSpeed += downloadSpeed;
                    connectedUploadSpeed += uploadSpeed;
                }
                else
                {
                    disconnectedSpeed += downloadSpeed;
                }
            }
            else
            {
                inactiveSpeed += downloadSpeed;
                if (connectedClients.Contains(item.Id))
                {
                    connectedDownloadSpeed += downloadSpeed;
                    connectedUploadSpeed += uploadSpeed;
                }
            }
        }
    }

    var disconnectedActiveClients = Model.Count(c => c.IsActive && !connectedClients.Contains(c.Id));
    var connectedActiveClients = Model.Count(c => connectedClients.Contains(c.Id));
    var averageDownloadSpeed = totalClients > 0 ? Math.Round((double)totalDownloadSpeed / totalClients, 1) : 0;
    var averageUploadSpeed = totalClients > 0 ? Math.Round((double)totalUploadSpeed / totalClients, 1) : 0;
    var activePercent = totalClients > 0 ? Math.Round((double)activeClients / totalClients * 100, 0) : 0;
    var connectedPercent = totalClients > 0 ? Math.Round((double)connectedActiveClients / totalClients * 100, 0) : 0;
    var dbAccountMap = ViewBag.DbAccountMap as IDictionary<int, string> ?? new Dictionary<int, string>();
    var pendingClientIds = ViewBag.PendingClientIds as ISet<int> ?? new HashSet<int>();
    var heroActions = new List<RadaTik.ViewModels.UI.PageHeroActionViewModel>();
    if (canView)
    {
        heroActions.Add(new() { Text = "تنتهي قريباً", Url = Url.Action("ExpiringIn3Days")!, CssClass = "btn btn-warning btn-sm", IconClass = "fas fa-clock" });
        heroActions.Add(new() { Text = "المنتهية", Url = Url.Action("ExpiredAccounts")!, CssClass = "btn btn-danger btn-sm", IconClass = "fas fa-exclamation-triangle" });
    }
    if (canImportFromServer)
    {
        heroActions.Add(new() { Text = "استيراد من سيرفر", Url = Url.Action("ImportFromServer")!, CssClass = "btn btn-outline-warning btn-sm", IconClass = "fas fa-download" });
    }
    if (canCreate)
    {
        heroActions.Add(new() { Text = "إضافة مشترك جديد", Url = Url.RouteUrl("employee-new-subscriber-wizard")!, CssClass = "btn btn-success btn-sm", IconClass = "fas fa-user-plus" });
    }
    ViewBag.PageHeroIcon = "fas fa-users";
    ViewBag.PageHeroExtraActions = heroActions;
}

<partial name="_CrudPageHero" />

@if (canEdit)
{
    <div class="mb-3">
        <button type="button" class="btn btn-outline-primary btn-sm" id="btnOpenClientInfoImport" data-bs-toggle="modal" data-bs-target="#clientInfoImportModal" title="تحديث بيانات المشتركين الموجودين في قاعدة البيانات من ملف — لا يُضاف مشتركون جدد">
            <i class="fas fa-file-excel"></i> استيراد معلومات المشتركين من ملف
        </button>
    </div>
    <div class="modal fade" id="clientInfoImportModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <form asp-action="ImportClientInfoFromFile" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <div class="modal-header">
                        <h5 class="modal-title">استيراد معلومات المشتركين من ملف</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="small text-muted">
                            لا يُضاف مشتركون جدد. يُحدَّث فقط من يوجد حسابه مسبقاً في قاعدة البيانات.
                            المطابقة عبر <strong>الحساب</strong>. عند التطابق تُحدَّث:
                            الاسم الكامل، الجوال، آخر تجديد، البناء.
                            والتكرارات لنفس الحساب/الاسم تُحدَّث كلها بنفس المعلومات.
                            وإذا كان آخر تجديد خلال 30 يوماً من الاستعادة يُجدَّد الاشتراك حتى يوم 10 من الشهر التالي.
                        </p>
                        <div class="alert alert-info small py-2">
                            <strong>ملاحظة:</strong> عند وجود أكثر من ورقة في Excel تُختار الورقة التي يحتوي اسمها على «مشتركين كامل».
                        </div>
                        <input type="file" class="form-control mb-2" name="file" accept=".xlsx,.xlsm,.csv,.txt" required />
                        <a asp-action="DownloadClientInfoImportTemplate" class="btn btn-sm btn-outline-secondary">تنزيل القالب</a>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">إلغاء</button>
                        <button type="submit" class="btn btn-primary">استيراد</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle alert-icon"></i>
        <div class="alert-content">@TempData["Success"]</div>
        <button class="alert-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>
    </div>
}

@if (TempData["ImportFailedUsersDetails"] is string failedUsersJson && !string.IsNullOrWhiteSpace(failedUsersJson))
{
    var failedUsers = System.Text.Json.JsonSerializer.Deserialize<List<string>>(failedUsersJson) ?? new List<string>();
    if (failedUsers.Any())
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-circle alert-icon"></i>
            <div class="alert-content">
                <div class="fw-semibold mb-1">تعذر إنشاء حسابات لبعض المستخدمين:</div>
                <ul class="mb-0 ps-3">
                    @foreach (var failedItem in failedUsers)
                    {
                        <li>@failedItem</li>
                    }
                </ul>
            </div>
            <button class="alert-close" onclick="this.parentElement.remove()"><i class="fas fa-times"></i></button>
        </div>
    }
}

<div class="alert alert-info mb-3">
    <i class="fas fa-info-circle me-1"></i>
    <strong>ملاحظة:</strong> إجراء <strong>تجميد</strong> يجمّد الإنترنت على MikroTik فقط ولا يعطّل حساب المشترك داخل النظام.
    وتجديد الاشتراك يتم لمدة شهر من <strong>تاريخ انتهاء الاشتراك الحالي</strong>.
</div>

<!-- Compact Statistics Bar -->
<div class="stats-bar">
    <button type="button" class="stat-item stat-primary is-filter active" data-filter="all" onclick="filterByStatus('all')" title="جميع الحسابات على جميع سيرفرات الشركة">
        <div class="stat-icon-mini"><i class="fas fa-users"></i></div>
        <div class="stat-data">
            <span class="stat-number">@totalClients</span>
            <span class="stat-label">الكل</span>
        </div>
    </button>
    
    <button type="button" class="stat-item stat-success is-filter" data-filter="active" onclick="filterByStatus('active')" title="المشتركون الذين حسابهم ليس معطّلاً">
        <div class="stat-icon-mini"><i class="fas fa-user-check"></i></div>
        <div class="stat-data">
            <span class="stat-number">@activeClients</span>
            <span class="stat-label">نشط (@activePercent%)</span>
        </div>
    </button>
    
    <button type="button" class="stat-item stat-info is-filter" data-filter="connected" onclick="filterByStatus('connected')" title="المشتركون الموجودون حالياً في PPP Active Connections على سيرفرات MikroTik">
        <div class="stat-icon-mini"><i class="fas fa-wifi"></i></div>
        <div class="stat-data">
            <span class="stat-number" id="statConnectedCount">@(connectionsReady ? connectedActiveClients.ToString() : "…")</span>
            <span class="stat-label">متصل <span id="statConnectedPercent">@(connectionsReady ? $"({connectedPercent}%)" : "")</span></span>
        </div>
    </button>
    
    <button type="button" class="stat-item stat-warning is-filter" data-filter="disconnected" onclick="filterByStatus('disconnected')" title="المشتركون غير المعطّلين وغير المتصلين حالياً بالإنترنت">
        <div class="stat-icon-mini"><i class="fas fa-user-clock"></i></div>
        <div class="stat-data">
            <span class="stat-number" id="statDisconnectedCount">@(connectionsReady ? disconnectedActiveClients.ToString() : "…")</span>
            <span class="stat-label">غير متصل</span>
        </div>
    </button>
    
    <button type="button" class="stat-item stat-danger is-filter" data-filter="inactive" onclick="filterByStatus('inactive')" title="المشتركون الذين حسابهم معطّل لأي سبب">
        <div class="stat-icon-mini"><i class="fas fa-user-times"></i></div>
        <div class="stat-data">
            <span class="stat-number">@inactiveClients</span>
            <span class="stat-label">معطل</span>
        </div>
    </button>

    <button type="button" class="stat-item stat-duplicate is-filter" data-filter="duplicate" onclick="filterByStatus('duplicate')" title="الحسابات المكررة عبر سيرفرات MikroTik ضمن الشبكة">
        <div class="stat-icon-mini"><i class="fas fa-clone"></i></div>
        <div class="stat-data">
            <span class="stat-number">@duplicateClients</span>
            <span class="stat-label">مكرر</span>
        </div>
    </button>

    <button type="button" class="stat-item stat-vip is-filter" data-filter="vip" onclick="filterByStatus('vip')" title="المشتركون المميزون (VIP)">
        <div class="stat-icon-mini"><i class="fas fa-crown"></i></div>
        <div class="stat-data">
            <span class="stat-number">@vipClients</span>
            <span class="stat-label">VIP</span>
        </div>
    </button>
    
    <div class="stat-divider"></div>
    
    <div class="stat-item stat-speed" title="مجموع سرعات التنزيل لجميع المشتركين">
        <div class="stat-icon-mini"><i class="fas fa-download"></i></div>
        <div class="stat-data">
            <span class="stat-number">@totalDownloadSpeed.ToString("0.##")</span>
            <span class="stat-label">Mbps تنزيل</span>
        </div>
    </div>

    <div class="stat-item stat-speed-upload" title="مجموع سرعات الرفع (إن لم تُحدد في البروفايل تُحسب = التنزيل)">
        <div class="stat-icon-mini"><i class="fas fa-upload"></i></div>
        <div class="stat-data">
            <span class="stat-number">@totalUploadSpeed.ToString("0.##")</span>
            <span class="stat-label">Mbps رفع</span>
        </div>
    </div>
    
    <div class="stat-item stat-speed-active" title="مجموع السرعات للمشتركين المتصلين حالياً">
        <div class="stat-icon-mini"><i class="fas fa-tachometer-alt"></i></div>
        <div class="stat-data">
            <span class="stat-number" id="statConnectedSpeed">@(connectionsReady ? $"{connectedDownloadSpeed.ToString("0.##")}↓/{connectedUploadSpeed.ToString("0.##")}↑" : "…")</span>
            <span class="stat-label">Mbps متصل تنزيل/رفع</span>
        </div>
    </div>
    
    <div class="stat-item stat-avg" title="متوسط سرعة التنزيل / الرفع لكل مشترك">
        <div class="stat-icon-mini"><i class="fas fa-chart-line"></i></div>
        <div class="stat-data">
            <span class="stat-number">@averageDownloadSpeed↓/@averageUploadSpeed↑</span>
            <span class="stat-label">Mbps متوسط</span>
        </div>
    </div>
</div>

<!-- Clients Table -->
<div class="card">
    <div class="card-header">
        <h3 class="card-title">
            <i class="fas fa-list"></i>
            قائمة العملاء
        </h3>
        <div class="card-actions">
            <div class="filter-buttons">
                <button class="filter-btn active" onclick="filterByStatus('all')" data-filter="all" title="جميع الحسابات على جميع سيرفرات الشركة">
                    الكل <span class="filter-count">@totalClients</span>
                </button>
                <button class="filter-btn" onclick="filterByStatus('active')" data-filter="active" title="المشتركون الذين حسابهم ليس معطّلاً">
                    نشط <span class="filter-count">@activeClients</span>
                </button>
                <button class="filter-btn" onclick="filterByStatus('connected')" data-filter="connected" title="المشتركون غير المعطّلين والمتصلون حالياً بالإنترنت">
                    متصل <span class="filter-count" id="filterConnectedCount">@(connectionsReady ? connectedActiveClients.ToString() : "…")</span>
                </button>
                <button class="filter-btn" onclick="filterByStatus('disconnected')" data-filter="disconnected" title="المشتركون غير المعطّلين وغير المتصلين حالياً بالإنترنت">
                    غير متصل <span class="filter-count" id="filterDisconnectedCount">@(connectionsReady ? disconnectedActiveClients.ToString() : "…")</span>
                </button>
                <button class="filter-btn" onclick="filterByStatus('inactive')" data-filter="inactive" title="المشتركون الذين حسابهم معطّل لأي سبب">
                    معطل <span class="filter-count">@inactiveClients</span>
                </button>
                <button class="filter-btn" onclick="filterByStatus('duplicate')" data-filter="duplicate" title="الحسابات المكررة عبر سيرفرات MikroTik ضمن الشبكة">
                    مكرر <span class="filter-count">@duplicateClients</span>
                </button>
                <button class="filter-btn" onclick="filterByStatus('vip')" data-filter="vip" title="المشتركون المميزون (VIP)">
                    VIP <span class="filter-count">@vipClients</span>
                </button>
            </div>
            <div class="dropdown clients-column-picker">
                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                    <i class="fas fa-columns"></i> الحقول
                </button>
                <div class="dropdown-menu dropdown-menu-end p-2 column-picker-menu" onclick="event.stopPropagation()">
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="fullName" checked /> الاسم الكامل</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="phone" checked /> الجوال</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="receiver" checked /> المستقبل</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="sender" checked /> المرسل</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="speed" checked /> السرعة</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="server" checked /> السيرفر</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="serverAccount" checked /> الحساب في السيرفر</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="duplicate" checked /> مكرر</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="dbAccount" checked /> الحساب في قاعدة البيانات</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="startDate" checked /> تاريخ بدء الصلاحية</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="endDate" checked /> تاريخ انتهاء الصلاحية</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="remainingDays" checked /> الأيام المتبقية</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="lastRenewal" checked /> آخر تجديد</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="location" checked /> الموقع</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="powerSource" checked /> مصدر الكهرباء</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="building" checked /> البناء</label>
                    <label class="dropdown-item"><input type="checkbox" class="column-toggle" data-col="floor" checked /> الطابق</label>
                </div>
            </div>
            <button class="btn btn-sm btn-icon" onclick="refreshConnections()" title="تحديث">
                <i class="fas fa-sync"></i>
            </button>
        </div>
    </div>
    <div class="card-body clients-table-wrap">
        <div class="clients-table-meta">
            <div class="clients-table-counts">
                <span class="clients-count-chip clients-count-chip--records" title="عدد السجلات الظاهرة في الجدول بعد الفلتر">
                    <i class="fas fa-list-ol"></i>
                    السجلات
                    <strong id="clientsVisibleCount">@totalClients</strong>
                </span>
                <span class="clients-count-chip clients-count-chip--selected" id="clientsSelectedCountChip" hidden title="عدد المشتركين المحددين">
                    <i class="fas fa-check-square"></i>
                    المحدد
                    <strong id="clientsSelectedCount">0</strong>
                </span>
            </div>
        </div>
        <div class="table-container table-responsive">
            <table class="table table-sm table-compact radtk-data-table radtk-data-table--cards" id="clientsTable">
                <thead>
                    <tr>
                        <th data-col="fullName">الاسم الكامل</th>
                        <th data-col="phone">الجوال</th>
                        <th data-col="receiver">المستقبل</th>
                        <th data-col="sender">المرسل</th>
                        <th data-col="speed">السرعة</th>
                        <th data-col="server">السيرفر</th>
                        <th data-col="serverAccount">الحساب في السيرفر</th>
                        <th data-col="duplicate">مكرر</th>
                        <th data-col="dbAccount">الحساب في قاعدة البيانات</th>
                        <th data-col="startDate">تاريخ بدء الصلاحية</th>
                        <th data-col="endDate">تاريخ انتهاء الصلاحية</th>
                        <th data-col="remainingDays">عدد الأيام المتبقية</th>
                        <th data-col="lastRenewal">تاريخ آخر تجديد</th>
                        <th data-col="location">الموقع</th>
                        <th data-col="powerSource">مصدر الكهرباء</th>
                        <th data-col="building">البناء</th>
                        <th data-col="floor">الطابق</th>
                        <th>الحالة</th>
                        <th>الاتصال</th>
                        <th>تاريخ الإضافة</th>
                        <th class="no-sort">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var downloadSpeed = 0m;
                        var uploadSpeed = 0m;
                        var profileName = item.Profile?.Name ?? item.ProfileName;
                        var uploadInferred = false;
                        if (item.Profile != null)
                        {
                            downloadSpeed = item.Profile.DownloadSpeedMbps;
                            uploadSpeed = item.Profile.EffectiveUploadSpeedMbps;
                            uploadInferred = !item.Profile.UploadSpeed.HasValue;
                        }
                        else if (!string.IsNullOrEmpty(item.ProfileName))
                        {
                            var numbers = System.Text.RegularExpressions.Regex.Match(item.ProfileName, @"\d+");
                            if (numbers.Success && int.TryParse(numbers.Value, out var parsedSpeed))
                            {
                                downloadSpeed = parsedSpeed;
                                uploadSpeed = parsedSpeed;
                                uploadInferred = true;
                            }
                        }

                        var isConnected = connectionsReady && connectedClients.Contains(item.Id);
                        var isPendingApproval = pendingClientIds.Contains(item.Id) ||
                            string.Equals(item.ConnectionStatus, "معلق بانتظار موافقة مدير الشركة", StringComparison.OrdinalIgnoreCase);
                        var senderName = item.Receiver?.Sector?.Name ?? "-";
                        var dbAccount = dbAccountMap.TryGetValue(item.Id, out var dbUser) ? dbUser : "-";
                        var remainingDays = item.AccountExpirationDate.HasValue
                            ? (item.AccountExpirationDate.Value.Date - DateTime.Now.Date).Days
                            : (int?)null;

                        <tr class="client-row"
                            data-client-id="@item.Id"
                            data-active="@item.IsActive.ToString().ToLower()"
                            data-pending="@isPendingApproval.ToString().ToLower()"
                            data-duplicate="@item.IsCrossServerDuplicate.ToString().ToLower()"
                            data-vip="@item.IsVip.ToString().ToLower()"
                            data-connected="@isConnected.ToString().ToLower()"
                            data-speed="@downloadSpeed.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-upload-speed="@uploadSpeed.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                            data-speed-display="@(item.Profile != null ? $"{item.Profile.DownloadSpeedDisplay} / {item.Profile.EffectiveUploadSpeedDisplay}" : downloadSpeed.ToString())">
                            <td data-col="fullName">
                                <div class="client-info">
                                    <div class="client-avatar js-client-avatar @(isConnected ? "online" : (item.IsActive ? "away" : "offline"))">
                                        @(item.Name?.Substring(0, 1).ToUpper() ?? "?")
                                    </div>
                                    <div>
                                        <div class="client-name">
                                            @item.Name
                                            @if (item.IsVip)
                                            {
                                                <span class="badge clients-vip-badge" title="@(string.IsNullOrWhiteSpace(item.VipNote) ? ClientVipBenefitDisplay.DetailsText(item, 0m) : item.VipNote)">
                                                    <i class="fas fa-crown"></i> @ClientVipBenefitDisplay.BadgeText(item)
                                                </span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(item.SID))
                                        {
                                            <div class="client-sid">#@item.SID</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td data-col="phone">
                                <span class="text-muted">
                                    <i class="fas fa-phone"></i> @item.PhoneNumber
                                </span>
                            </td>
                            <td data-col="receiver">
                                @if (item.Receiver != null)
                                {
                                    <span class="badge badge-info">@item.Receiver.Name</span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td data-col="sender">
                                <span class="badge badge-light">@senderName</span>
                            </td>
                            <td data-col="speed">
                                <div class="profile-info">
                                    <span class="badge @(item.IsActive ? "badge-success" : "badge-secondary")">
                                        @(profileName ?? "غير محدد")
                                    </span>
                                    <small class="speed-value" title="@(uploadInferred ? "الرفع غير محدد في البروفايل — اعتُبر مساوياً للتنزيل" : "تنزيل / رفع")">
                                        ↓@downloadSpeed.ToString("0.##") / ↑@uploadSpeed.ToString("0.##") Mbps
                                        @if (uploadInferred && downloadSpeed > 0)
                                        {
                                            <span class="text-muted">(رفع=تنزيل)</span>
                                        }
                                    </small>
                                </div>
                            </td>
                            <td data-col="server">
                                @if (item.MikroTikServer != null)
                                {
                                    <span class="badge badge-primary" title="@item.MikroTikServer.Host">
                                        <i class="fas fa-server"></i> @item.MikroTikServer.Name
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td data-col="serverAccount">
                                <code class="text-nowrap">@item.UserName</code>
                            </td>
                            <td data-col="duplicate" data-label="مكرر" data-order="@(item.IsCrossServerDuplicate ? 1 : 0)">
                                @if (item.IsCrossServerDuplicate)
                                {
                                    <span class="badge bg-warning text-dark" title="نفس الحساب موجود على سيرفر MikroTik آخر ضمن الشبكة">
                                        <i class="fas fa-clone"></i> مكرر
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td data-col="dbAccount"><code class="text-nowrap">@dbAccount</code></td>
                            <td data-col="startDate">
                                @(item.ServiceStartDate?.ToString("yyyy/MM/dd") ?? "-")
                            </td>
                            <td data-col="endDate">
                                @(item.AccountExpirationDate?.ToString("yyyy/MM/dd") ?? "-")
                            </td>
                            <td data-col="remainingDays">
                                @if (remainingDays.HasValue)
                                {
                                    <span class="badge @(remainingDays.Value < 0 ? "badge-danger" : remainingDays.Value <= 3 ? "badge-warning" : "badge-success")">
                                        @remainingDays يوم
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td data-col="lastRenewal">@(item.LastRenewalDate?.ToString("yyyy/MM/dd") ?? "-")</td>
                            <td data-col="location">
                                <span title="@item.ResidenceAddress">@(string.IsNullOrWhiteSpace(item.ResidenceAddress) ? "-" : item.ResidenceAddress)</span>
                                @if (item.Latitude.HasValue && item.Longitude.HasValue)
                                {
                                    <small class="text-muted d-block">@item.Latitude.Value.ToString("F4"), @item.Longitude.Value.ToString("F4")</small>
                                }
                            </td>
                            <td data-col="powerSource">@(string.IsNullOrWhiteSpace(item.PowerSource) ? "-" : item.PowerSource)</td>
                            <td data-col="building">@(string.IsNullOrWhiteSpace(item.Building) ? "-" : item.Building)</td>
                            <td data-col="floor">@(string.IsNullOrWhiteSpace(item.Floor) ? "-" : item.Floor)</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="status-badge status-active">
                                        <i class="fas fa-check-circle"></i> مفعل
                                    </span>
                                }
                                else if (isPendingApproval)
                                {
                                    <span class="status-badge status-awaiting">
                                        <i class="fas fa-hourglass-half"></i> بانتظار موافقة المدير
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-inactive">
                                        <i class="fas fa-times-circle"></i> معطل
                                    </span>
                                }
                            </td>
                            <td>
                                @if (isPendingApproval)
                                {
                                    <span class="js-client-connection status-badge status-awaiting">
                                        <i class="fas fa-user-clock"></i> قيد الاعتماد
                                    </span>
                                }
                                else if (isConnected)
                                {
                                    <span class="js-client-connection status-badge status-online">
                                        <i class="fas fa-wifi"></i> متصل
                                    </span>
                                }
                                else if (item.IsActive)
                                {
                                    if (!connectionsReady)
                                    {
                                        <span class="js-client-connection status-badge status-away">
                                            <i class="fas fa-spinner fa-spin"></i> جاري التحقق
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="js-client-connection status-badge status-away">
                                            <i class="fas fa-wifi-slash"></i> غير متصل
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span class="js-client-connection text-muted">-</span>
                                }
                            </td>
                            <td>
                                <span class="text-muted text-sm">@item.CreatedDate.ToString("yyyy/MM/dd")</span>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    @if (canDetails)
                                    {
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-info" title="تفاصيل">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                    }
                                    @if (canEdit)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-icon btn-warning" title="تعديل">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    }
                                    @if (canEdit && item.MikroTikServerId.HasValue && !string.IsNullOrEmpty(item.UserName))
                                    {
                                        <form asp-action="SyncWithMikroTik" method="post" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-icon btn-outline-info"
                                                    title="مزامنة مع مايكروتك (إضافة إلى مايكروتك): إضافة المشترك إن لم يكن موجوداً، أو تحديث كلمة المرور والسرعة من قاعدة البيانات"
                                                    onclick="return confirm('سيتم إضافة المشترك إلى MikroTik إن لم يكن موجوداً، أو تحديث كلمة المرور والبروفايل (السرعة) من بيانات النظام. متابعة؟');">
                                                <i class="fas fa-cloud-upload-alt"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (canFreeze)
                                    {
                                        <form asp-action="Freeze" method="post" style="display:inline;">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-icon btn-secondary"
                                                    title="تجميد الإنترنت في MikroTik"
                                                    onclick="return confirm('سيتم تجميد الإنترنت لهذا المشترك على المايكروتك فقط، هل تريد المتابعة؟');">
                                                <i class="fas fa-pause"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (canRenew)
                                    {
                                        <form asp-action="RenewOneMonth" method="post" style="display:inline;">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit"
                                                    class="btn btn-sm btn-icon btn-success"
                                                    title="تجديد اشتراك شهر"
                                                    onclick="return confirm('سيتم تجديد الاشتراك لمدة شهر من تاريخ الانتهاء الحالي، متابعة؟');">
                                                <i class="fas fa-sync-alt"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (!canDetails && !canEdit && !canFreeze && !canRenew)
                                    {
                                        <span class="text-muted small">لا توجد صلاحيات</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="card-footer">
        <div class="footer-stats">
            <span class="footer-stat">
                <i class="fas fa-bolt text-warning"></i>
                <span id="currentSpeedLabel">المجموع:</span>
                <strong id="currentSpeedValue">↓@totalDownloadSpeed.ToString("0.##") / ↑@totalUploadSpeed.ToString("0.##") Mbps</strong>
            </span>
            <span class="footer-stat">
                <i class="fas fa-wifi text-success"></i>
                <span id="currentConnectedCount">@connectedClients.Count متصل</span>
            </span>
            <span class="footer-stat">
                <i class="fas fa-clock text-muted"></i>
                @DateTime.Now.ToString("HH:mm:ss")
            </span>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let currentFilter = 'all';
        let clientsStatusFilterRegistered = false;

        function rowMatchesStatusFilter(rowNode, filterType) {
            const isActive = rowNode.getAttribute('data-active') === 'true';
            const isConnected = rowNode.getAttribute('data-connected') === 'true';
            const isDuplicate = rowNode.getAttribute('data-duplicate') === 'true';
            const isVip = rowNode.getAttribute('data-vip') === 'true';
            switch (filterType) {
                case 'active':
                    return isActive;
                case 'inactive':
                    return !isActive;
                case 'connected':
                    return isConnected;
                case 'disconnected':
                    return isActive && !isConnected;
                case 'duplicate':
                    return isDuplicate;
                case 'vip':
                    return isVip;
                default:
                    return true;
            }
        }

        function ensureClientsStatusDataTableFilter() {
            if (clientsStatusFilterRegistered || typeof $.fn.dataTable === 'undefined') {
                return;
            }
            clientsStatusFilterRegistered = true;
            $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                if (!settings.nTable || settings.nTable.id !== 'clientsTable') {
                    return true;
                }
                const api = new $.fn.dataTable.Api(settings);
                const rowNode = api.row(dataIndex).node();
                if (!rowNode || !rowNode.classList.contains('client-row')) {
                    return true;
                }
                return rowMatchesStatusFilter(rowNode, currentFilter);
            });
        }

        function updateFilterFooterStats(visibleDownloadSpeed, visibleUploadSpeed, visibleConnectedCount, filterType) {
            const speedValue = document.getElementById('currentSpeedValue');
            const connectedCount = document.getElementById('currentConnectedCount');
            const speedLabel = document.getElementById('currentSpeedLabel');
            if (speedValue) {
                const dl = Number(visibleDownloadSpeed || 0);
                const ul = Number(visibleUploadSpeed || 0);
                speedValue.textContent = '↓' + formatMbps(dl) + ' / ↑' + formatMbps(ul) + ' Mbps';
            }
            if (connectedCount) {
                connectedCount.textContent = visibleConnectedCount + ' متصل';
            }
            const labels = {
                'all': 'المجموع:',
                'active': 'النشطين:',
                'inactive': 'المعطلين:',
                'connected': 'المتصلين:',
                'disconnected': 'غير المتصلين:',
                'duplicate': 'المكررين:',
                'vip': 'VIP:'
            };
            if (speedLabel) {
                speedLabel.textContent = labels[filterType] || labels.all;
            }
        }

        function formatMbps(n) {
            const v = Number(n || 0);
            if (!isFinite(v)) return '0';
            return (Math.round(v * 100) / 100).toString();
        }

        function rowDownloadSpeed(row) {
            return parseFloat(row.getAttribute('data-speed')) || 0;
        }

        function rowUploadSpeed(row) {
            const raw = row.getAttribute('data-upload-speed');
            if (raw === null || raw === '') {
                return rowDownloadSpeed(row);
            }
            return parseFloat(raw) || 0;
        }

        function filterByStatus(filterType) {
            currentFilter = filterType;
            let visibleDownloadSpeed = 0;
            let visibleUploadSpeed = 0;
            let visibleConnectedCount = 0;

            document.querySelectorAll('.filter-btn').forEach(btn => {
                btn.classList.toggle('active', btn.getAttribute('data-filter') === filterType);
            });
            document.querySelectorAll('.stat-item.is-filter').forEach(card => {
                card.classList.toggle('active', card.getAttribute('data-filter') === filterType);
            });

            const usingDataTable = typeof $.fn.DataTable !== 'undefined' &&
                $.fn.DataTable.isDataTable('#clientsTable');

            if (usingDataTable) {
                ensureClientsStatusDataTableFilter();
                document.querySelectorAll('.client-row').forEach(row => {
                    row.style.display = '';
                });
                const api = $('#clientsTable').DataTable();
                api.draw();
                api.rows({ search: 'applied' }).every(function () {
                    const row = this.node();
                    if (!row) {
                        return;
                    }
                    visibleDownloadSpeed += rowDownloadSpeed(row);
                    visibleUploadSpeed += rowUploadSpeed(row);
                    if (row.getAttribute('data-connected') === 'true') {
                        visibleConnectedCount++;
                    }
                });
            } else {
                document.querySelectorAll('.client-row').forEach(row => {
                    const isConnected = row.getAttribute('data-connected') === 'true';
                    const shouldShow = rowMatchesStatusFilter(row, filterType);

                    if (shouldShow) {
                        row.style.display = '';
                        visibleDownloadSpeed += rowDownloadSpeed(row);
                        visibleUploadSpeed += rowUploadSpeed(row);
                        if (isConnected) {
                            visibleConnectedCount++;
                        }
                    } else {
                        row.style.display = 'none';
                    }
                });
            }

            updateFilterFooterStats(visibleDownloadSpeed, visibleUploadSpeed, visibleConnectedCount, filterType);
            const visibleCountEl = document.getElementById('clientsVisibleCount');
            if (visibleCountEl) {
                const visibleRows = usingDataTable
                    ? $('#clientsTable').DataTable().rows({ search: 'applied' }).count()
                    : document.querySelectorAll('.client-row:not([style*="display: none"])').length;
                visibleCountEl.textContent = String(visibleRows);
            }
        }

        function refreshConnections() {
            loadConnectionStatus(true);
        }

        function applyConnectedIds(connectedIds) {
            const connectedSet = new Set((connectedIds || []).map(String));
            let connectedCount = 0;
            let disconnectedCount = 0;
            let connectedDownloadSpeed = 0;
            let connectedUploadSpeed = 0;

            document.querySelectorAll('.client-row').forEach(row => {
                const id = row.getAttribute('data-client-id');
                const isActive = row.getAttribute('data-active') === 'true';
                const isPending = row.getAttribute('data-pending') === 'true';
                const downloadSpeed = rowDownloadSpeed(row);
                const uploadSpeed = rowUploadSpeed(row);
                const isConnected = connectedSet.has(String(id));
                row.setAttribute('data-connected', isConnected ? 'true' : 'false');

                const avatar = row.querySelector('.js-client-avatar');
                if (avatar) {
                    avatar.classList.remove('online', 'away', 'offline');
                    if (isConnected) {
                        avatar.classList.add('online');
                    } else if (isActive) {
                        avatar.classList.add('away');
                    } else {
                        avatar.classList.add('offline');
                    }
                }

                const badge = row.querySelector('.js-client-connection');
                if (badge && !isPending) {
                    if (isConnected) {
                        badge.className = 'js-client-connection status-badge status-online';
                        badge.innerHTML = '<i class="fas fa-wifi"></i> متصل';
                    } else if (isActive) {
                        badge.className = 'js-client-connection status-badge status-away';
                        badge.innerHTML = '<i class="fas fa-wifi-slash"></i> غير متصل';
                    }
                }

                if (isConnected) {
                    connectedCount++;
                    connectedDownloadSpeed += downloadSpeed;
                    connectedUploadSpeed += uploadSpeed;
                } else if (isActive) {
                    disconnectedCount++;
                }
            });

            const totalRows = document.querySelectorAll('.client-row').length;
            const connectedPercent = totalRows > 0
                ? Math.round((connectedCount / totalRows) * 100)
                : 0;

            const setText = (id, value) => {
                const el = document.getElementById(id);
                if (el) el.textContent = value;
            };

            setText('statConnectedCount', String(connectedCount));
            setText('statDisconnectedCount', String(disconnectedCount));
            setText('statConnectedSpeed', formatMbps(connectedDownloadSpeed) + '↓/' + formatMbps(connectedUploadSpeed) + '↑');
            setText('filterConnectedCount', String(connectedCount));
            setText('filterDisconnectedCount', String(disconnectedCount));
            const percentEl = document.getElementById('statConnectedPercent');
            if (percentEl) {
                percentEl.textContent = '(' + connectedPercent + '%)';
            }

            if (currentFilter === 'connected' || currentFilter === 'disconnected' || currentFilter === 'active') {
                filterByStatus(currentFilter);
            }
        }

        let connectionStatusLoading = false;
        function loadConnectionStatus(forceRefresh) {
            if (connectionStatusLoading) return;
            connectionStatusLoading = true;
            const url = '@Url.Action("ConnectionStatusJson", "Clients")' +
                (forceRefresh ? '?forceRefresh=true' : '');
            fetch(url, { headers: { 'Accept': 'application/json' }, credentials: 'same-origin' })
                .then(r => {
                    if (!r.ok) throw new Error('HTTP ' + r.status);
                    return r.json();
                })
                .then(data => {
                    if (data && data.success) {
                        applyConnectedIds(data.connectedIds || []);
                    }
                })
                .catch(() => { })
                .finally(() => { connectionStatusLoading = false; });
        }

        function applyInlineColumnDisplay(key, visible) {
            document.querySelectorAll('#clientsTable [data-col="' + CSS.escape(key) + '"]').forEach(function (el) {
                if (visible) {
                    el.style.removeProperty('display');
                } else {
                    el.style.display = 'none';
                }
            });
        }

        function setColumnVisible(key, visible, options) {
            if (!key) return;
            const skipDraw = !!(options && options.skipDraw);
            const table = document.getElementById('clientsTable');
            if (table) {
                table.classList.toggle('hide-col-' + key, !visible);
            }
            applyInlineColumnDisplay(key, visible);
            if (typeof $.fn.DataTable === 'undefined' || !$.fn.DataTable.isDataTable('#clientsTable')) {
                return;
            }
            const api = $('#clientsTable').DataTable();
            let colIdx = -1;
            api.columns().every(function (idx) {
                if (colIdx >= 0) return;
                const header = this.header();
                if (header && header.getAttribute('data-col') === key) {
                    colIdx = idx;
                }
            });
            if (colIdx >= 0 && api.column(colIdx).visible() !== visible) {
                api.column(colIdx).visible(visible, false);
            }
            applyInlineColumnDisplay(key, visible);
            if (!skipDraw) {
                api.columns.adjust().draw(false);
                applyInlineColumnDisplay(key, visible);
            }
        }

        function applyColumnVisibility() {
            const selected = JSON.parse(localStorage.getItem('clients.employee.columns.visible') || '{}');
            document.querySelectorAll('.column-toggle').forEach(function (chk) {
                const key = chk.getAttribute('data-col');
                const visible = Object.prototype.hasOwnProperty.call(selected, key) ? !!selected[key] : true;
                chk.checked = visible;
                setColumnVisible(key, visible, { skipDraw: true });
            });
            if (typeof $.fn.DataTable !== 'undefined' && $.fn.DataTable.isDataTable('#clientsTable')) {
                $('#clientsTable').DataTable().columns.adjust().draw(false);
            }
        }

        function persistColumnVisibility() {
            const data = {};
            document.querySelectorAll('.column-toggle').forEach(chk => {
                data[chk.getAttribute('data-col')] = chk.checked;
            });
            localStorage.setItem('clients.employee.columns.visible', JSON.stringify(data));
        }

        const CLIENTS_PAGE_LENGTH_KEY = 'clients.employee.pageLength';
        const CLIENTS_PAGE_LENGTH_DEFAULT = -1;
        const CLIENTS_PAGE_LENGTHS = [10, 25, 50, 100, 200, 500, -1];

        function readSavedClientsPageLength() {
            try {
                const raw = localStorage.getItem(CLIENTS_PAGE_LENGTH_KEY);
                if (raw === null || raw === '') {
                    return CLIENTS_PAGE_LENGTH_DEFAULT;
                }
                const n = parseInt(raw, 10);
                if (CLIENTS_PAGE_LENGTHS.indexOf(n) >= 0) {
                    return n;
                }
            } catch (e) { }
            return CLIENTS_PAGE_LENGTH_DEFAULT;
        }

        function persistClientsPageLength(len) {
            try {
                localStorage.setItem(CLIENTS_PAGE_LENGTH_KEY, String(len));
            } catch (e) { }
        }

        $(document).ready(function () {
            applyColumnVisibility();
            document.querySelectorAll('.column-toggle').forEach(function (chk) {
                chk.addEventListener('click', function (e) { e.stopPropagation(); });
                chk.addEventListener('change', function (e) {
                    e.stopPropagation();
                    persistColumnVisibility();
                    setColumnVisible(this.getAttribute('data-col'), !!this.checked);
                });
            });

            ensureClientsStatusDataTableFilter();
            const savedPageLength = readSavedClientsPageLength();
            $('#clientsTable').DataTable({
                language: {
                    url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/ar.json'
                },
                order: [[19, 'desc']],
                responsive: true,
                pageLength: savedPageLength,
                lengthMenu: [
                    [10, 25, 50, 100, 200, 500, -1],
                    [10, 25, 50, 100, 200, 500, 'الكل']
                ],
                columnDefs: [
                    { orderable: false, targets: 20 }
                ],
                initComplete: function () {
                    applyColumnVisibility();
                    const api = this.api();
                    const desired = readSavedClientsPageLength();
                    if (api.page.len() !== desired) {
                        api.page.len(desired).draw(false);
                    }
                }
            });
            $('#clientsTable').on('length.dt', function (e, settings, len) {
                persistClientsPageLength(len);
            });
            loadConnectionStatus(false);
        });
    </script>
}

@section Styles {
    <link rel="stylesheet" href="~/css/clients-index-cards.css" asp-append-version="true" />
}

