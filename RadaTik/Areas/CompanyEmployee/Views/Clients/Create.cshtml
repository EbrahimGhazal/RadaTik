@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function() {
                // عند تغيير خادم المايكروتك - تصفية البروفايلات والمستقبلات حسب الخادم
            $('#mikrotikServerSelect').change(function() {
                var serverId = $(this).val();
                var profileSelect = $('#profileSelect');
                    var receiverSelect = $('#receiverSelect');

                if (serverId) {
                    // إظهار رسالة تحميل
                    profileSelect.html('<option value="">جاري تحميل البروفايلات...</option>');
                        receiverSelect.html('<option value="">جاري تحميل المستقبلات...</option>');

                    $.ajax({
                        url: '@Url.Action("GetProfilesByServer", "Clients")',
                        type: 'GET',
                        data: { serverId: serverId },
                        success: function(data) {
                            if (data && data.length > 0) {
                                profileSelect.empty();
                                profileSelect.append('<option value="">اختر البروفايل</option>');
                                $.each(data, function(index, profile) {
                                    profileSelect.append('<option value="' + profile.id + '">' + profile.name + '</option>');
                                });
                            } else {
                                profileSelect.empty();
                                profileSelect.append('<option value="">لا توجد بروفايلات في هذا الخادم</option>');
                            }
                        },
                        error: function(xhr, status, error) {
                            console.error('خطأ في جلب البروفايلات:', error);
                            profileSelect.empty();
                            profileSelect.append('<option value="">خطأ في جلب البروفايلات</option>');
                        }
                    });

                    $.ajax({
                        url: '@Url.Action("GetReceiversByServer", "Clients")',
                        type: 'GET',
                        data: { serverId: serverId },
                        success: function(data) {
                            receiverSelect.empty();
                            receiverSelect.append('<option value="">اختر المستقبل</option>');
                            if (data && data.length > 0) {
                                $.each(data, function(index, receiver) {
                                    receiverSelect.append('<option value="' + receiver.id + '">' + receiver.name + ' - ' + (receiver.sectorName || '-') + '</option>');
                                });
                            }
                        },
                        error: function() {
                            receiverSelect.empty();
                            receiverSelect.append('<option value="">خطأ في جلب المستقبلات</option>');
                        }
                    });
                } else {
                    // إعادة تحميل جميع البروفايلات من ViewBag
                    profileSelect.empty();
                    profileSelect.append('<option value="">اختر البروفايل</option>');
                    $('#receiverSelect').empty().append('<option value="">اختر المستقبل</option>');
                    @if (ViewBag.ProfileId != null)
                    {
                        <text>
                        var allProfiles = @Html.Raw(Json.Serialize((ViewBag.ProfileId as SelectList)?.Select(x => new { id = x.Value, name = x.Text })));
                        if (allProfiles) {
                            $.each(allProfiles, function(index, profile) {
                                profileSelect.append('<option value="' + profile.id + '">' + profile.name + '</option>');
                            });
                        }
                        </text>
                    }
                }
            });
        });
    </script>
}
