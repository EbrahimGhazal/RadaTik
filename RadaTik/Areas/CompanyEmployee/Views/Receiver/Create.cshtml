@model RadaTik.Models.Receiver
@using RadaTik.ViewModels

@{
    ViewData["Title"] = "إضافة مستقبل";
    ViewBag.PageHeroIcon = "fas fa-plus-circle";
    ViewBag.PageHeroSubtitle = "إضافة مستقبل جديد ضمن القطاع المحدد مع بيانات الشبكة المطلوبة.";
    ViewBag.PageHeroBackUrl = Url.Action("Index");
    var hasReceiverPricing = (bool?)(ViewBag.ReceiverCreateChargeHasPricing) == true;
    var receiverChargeAmount = (decimal?)(ViewBag.ReceiverCreateChargeAmount) ?? 0m;
    var receiverWalletBalance = (decimal?)(ViewBag.ReceiverCreateChargeWalletBalance) ?? 0m;
    string? wizardReturnUrl = ViewBag.WizardReturnUrl as string;
    var createSectors = ViewBag.ReceiverCreateSectors as IList<ReceiverCreateSectorOption>
        ?? Array.Empty<ReceiverCreateSectorOption>();
    var filterServers = ViewBag.MikroTikServersForFilter as IList<ReceiverCreateServerOption>
        ?? Array.Empty<ReceiverCreateServerOption>();
}

<div class="receiver-create-page employee-receiver-page radtk-page--companyemployee-views-receiver-create">
<partial name="_CrudPageHero" />

<div class="card radtk-section-card border-0 shadow-sm">
    <div class="card-body">
        <div class="alert alert-info mb-3">
            <i class="fas fa-user-check me-1"></i>
            سيتم إرسال الإضافة كطلب موافقة إلى مدير الشركة.
            @if (hasReceiverPricing)
            {
                <text>الحسم المتوقع بعد الاعتماد: <strong>@SyrianCurrencyHelper.FormatNew(receiverChargeAmount) ل.س.ج</strong> (الرصيد الحالي: @SyrianCurrencyHelper.FormatNew(receiverWalletBalance) ل.س.ج).</text>
            }
            else
            {
                <text>لا توجد تسعيرة فعّالة حالياً لإضافة المستقبل، لذلك لا يوجد حسم متوقع.</text>
            }
            <span class="d-block mt-1">لن يتم أي حسم الآن، وإنما بعد اعتماد مدير الشركة فقط.</span>
        </div>

        <form asp-action="Create" method="post" class="radtk-form" id="receiverForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            @if (!string.IsNullOrWhiteSpace(wizardReturnUrl))
            {
                <input type="hidden" name="returnUrl" value="@wizardReturnUrl" />
            }

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="Name" class="form-label">اسم المستقبل</label>
                    <input asp-for="Name" class="form-control elegant-input" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="sectorServerFilter">فلترة حسب خادم MikroTik</label>
                    <select id="sectorServerFilter" class="form-select elegant-input no-select2">
                        <option value="">كل الخوادم</option>
                        @foreach (var server in filterServers)
                        {
                            <option value="@server.Id">@server.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-12">
                    <label asp-for="SectorId" class="form-label">القطاع (المرسل)</label>
                    <select asp-for="SectorId" class="form-select elegant-input" id="sectorSelect" name="SectorId"
                            data-placeholder="ابحث عن القطاع...">
                        <option value="">-- اختر قطاع --</option>
                        @foreach (var sector in createSectors)
                        {
                            if (Model.SectorId == sector.Id)
                            {
                                <option value="@sector.Id"
                                        data-server-id="@sector.MikroTikServerId"
                                        data-network-mask="@(sector.NetworkMask ?? "")"
                                        data-ip="@(sector.IPAddress ?? "")"
                                        selected="selected">@sector.Name</option>
                            }
                            else
                            {
                                <option value="@sector.Id"
                                        data-server-id="@sector.MikroTikServerId"
                                        data-network-mask="@(sector.NetworkMask ?? "")"
                                        data-ip="@(sector.IPAddress ?? "")">@sector.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="SectorId" class="text-danger"></span>
                    <small class="text-muted">اكتب للبحث/فلترة القطاع. يُحدَّد IP والقناع تلقائياً عند الاختيار.</small>
                </div>

                <div class="col-md-6">
                    <label asp-for="IPAddress" class="form-label">IP</label>
                    <div class="input-group">
                        <input asp-for="IPAddress" class="form-control elegant-input" id="ipAddressInput" value="@(Model.IPAddress ?? ViewBag.NextIP)" />
                        <button type="button" class="btn btn-outline-secondary" id="btnGenerateIP" title="توليد IP">
                            <i class="fas fa-sync-alt"></i>
                        </button>
                    </div>
                    <span asp-validation-for="IPAddress" class="text-danger"></span>
                    <small class="text-muted">بحسب آخر واقط على نفس القطاع</small>
                </div>
                <div class="col-md-6">
                    <label asp-for="NetworkMask" class="form-label">قناع الشبكة</label>
                    <input asp-for="NetworkMask" class="form-control elegant-input" id="networkMaskInput" value="@(Model.NetworkMask ?? ViewBag.DefaultMask)" readonly />
                    <span asp-validation-for="NetworkMask" class="text-danger"></span>
                    <small class="text-muted">يطابق قناع القطاع</small>
                </div>

                <div class="col-12">
                    <h6 class="mb-2"><i class="fas fa-map-marked-alt me-1"></i> موقع المستقبل</h6>
                    <partial name="_ReceiverCreateMap" />
                </div>

                <div class="col-md-4">
                    <label asp-for="Latitude" class="form-label">خط العرض</label>
                    <input asp-for="Latitude" class="form-control elegant-input" id="latitudeInput" type="number" step="0.000001" readonly />
                    <span asp-validation-for="Latitude" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Longitude" class="form-label">خط الطول</label>
                    <input asp-for="Longitude" class="form-control elegant-input" id="longitudeInput" type="number" step="0.000001" readonly />
                    <span asp-validation-for="Longitude" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="distanceFromSector">المسافة من القطاع</label>
                    <div class="input-group">
                        <input type="text" class="form-control elegant-input" id="distanceFromSector" readonly value="غير محدد" />
                        <span class="input-group-text">كم</span>
                    </div>
                    <small class="text-muted" id="distanceStatus"></small>
                </div>

                <div class="col-md-6">
                    <label asp-for="ElevationMeters" class="form-label">الارتفاع عن سطح البحر (م)</label>
                    <input asp-for="ElevationMeters" class="form-control elegant-input" id="receiverElevationInput" type="number" step="0.1" placeholder="يُملأ عند النقر على الخريطة" />
                    <span asp-validation-for="ElevationMeters" class="text-danger"></span>
                    <small class="text-muted" id="receiverElevationHint">يُحدَّد تلقائياً عند اختيار موقع المستقبل على الخريطة (قابل للتعديل).</small>
                </div>
                <div class="col-md-6">
                    <label asp-for="AntennaHeightAglMeters" class="form-label">ارتفاع الهوائي عن الأرض (م)</label>
                    <input asp-for="AntennaHeightAglMeters" class="form-control elegant-input" id="receiverAntennaAglInput" type="number" step="0.1" placeholder="6" />
                    <span asp-validation-for="AntennaHeightAglMeters" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <div class="alert alert-secondary py-2 px-3 mb-0" role="note">
                        <div class="fw-bold mb-1"><i class="fas fa-calculator me-1"></i> كيف تحدد ارتفاع الهوائي عن سطح الأرض؟</div>
                        <ul class="mb-1 pe-3">
                            <li>ارتفاع البناء = <strong>10 × 2.90</strong> = <strong>29م</strong></li>
                            <li>ارتفاع الهوائي فوق السطح = <strong>3م</strong></li>
                            <li>إذن ارتفاع الهوائي عن سطح الأرض (HAGL) = <strong>29 + 3 = 32م</strong></li>
                        </ul>
                        <div class="small text-muted">
                            <strong>مهم:</strong> ارتفاع سطح البحر يُجلب تلقائياً من الخريطة، أما هذه الخانة فهي لارتفاع الهوائي عن الأرض/سطح البناء المحلي.
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="quick-info-box border rounded p-3">
                        <h6 class="mb-2"><i class="fas fa-chart-bar"></i> معلومات القطاع</h6>
                        <div class="d-flex justify-content-between small mb-1">
                            <span>عدد المستقبلات:</span>
                            <strong id="receiversCount">0</strong>
                        </div>
                        <div class="d-flex justify-content-between small">
                            <span>نطاق IP:</span>
                            <strong id="sectorIPRange">غير محدد</strong>
                        </div>
                    </div>
                </div>

                <input asp-for="IsActive" type="hidden" value="false" />
            </div>

            <div class="mt-4 d-flex flex-wrap gap-2 align-items-start receiver-create-actions">
                <button type="submit" class="btn btn-success action-btn">
                    <i class="fas fa-save"></i> حفظ
                </button>
                <button type="button" class="btn btn-outline-primary action-btn" id="btnAnalyzeLos" title="تحليل خط الرؤية (تضاريس + مبانٍ تقريبية)">
                    <i class="fas fa-mountain"></i> تحليل خط الرؤية
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary action-btn">إلغاء</a>
            </div>

            <div id="losResultPanel" class="mt-3 p-3 border rounded bg-light d-none" role="region" aria-live="polite" style="border-color:#dbe4f0!important;">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <strong><i class="fas fa-mountain"></i> نتيجة تحليل خط الرؤية</strong>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="btnLosResultClose">×</button>
                </div>
                <div id="losResultContent" class="small"></div>
            </div>
        </form>
    </div>
</div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <partial name="_ReceiverCreateMapScripts" />
}
