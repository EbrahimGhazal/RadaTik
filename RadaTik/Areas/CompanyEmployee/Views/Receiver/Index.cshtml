@model IEnumerable<RadaTik.Models.Receiver>

@{
    ViewData["Title"] = "المستقبلات";
    var pendingReceiverIds = ViewBag.PendingReceiverIds as ISet<int> ?? new HashSet<int>();

    var canCreate = await PermissionService.HasPermissionAsync(User, "Receivers.Create");
    var canEdit = await PermissionService.HasPermissionAsync(User, "Receivers.Edit");

    var total = Model.Count();
    var active = Model.Count(r => r.IsActive);
}

<div class="page-header employee-receiver-hero card border-0 shadow-sm">
    <div class="page-header-content">
        <h1 class="page-title">
            <i class="fas fa-satellite-dish"></i>
            @ViewData["Title"]
        </h1>
        <div class="page-actions">
            @if (canCreate)
            {
                <a asp-action="Create" class="btn btn-success btn-sm receiver-action-btn">
                    <i class="fas fa-plus"></i> إضافة مستقبل
                </a>
            }
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle alert-icon"></i>
        <div class="alert-content">@TempData["Success"]</div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle alert-icon"></i>
        <div class="alert-content">@TempData["Error"]</div>
    </div>
}

<div class="row g-2 mb-3">
    <div class="col-md-4 col-6">
        <div class="card receiver-stat-card total h-100"><div class="card-body"><div class="receiver-stat-label">الإجمالي</div><div class="receiver-stat-value">@total</div></div></div>
    </div>
    <div class="col-md-4 col-6">
        <div class="card receiver-stat-card active h-100"><div class="card-body"><div class="receiver-stat-label">نشط</div><div class="receiver-stat-value">@active</div></div></div>
    </div>
    <div class="col-md-4 col-12">
        <div class="card receiver-stat-card inactive h-100"><div class="card-body"><div class="receiver-stat-label">متوقف</div><div class="receiver-stat-value">@(total - active)</div></div></div>
    </div>
</div>

<div class="card mb-3 border-0 shadow-sm receiver-map-card">
    <div class="card-header">
        <h3 class="card-title mb-0">
            <i class="fas fa-map-marked-alt"></i>
            خريطة القطاعات والمستقبلات
        </h3>
    </div>
    <div class="card-body p-0">
        <div id="receiversMap" style="width: 100%; height: 420px;"></div>
    </div>
</div>

<div class="card border-0 shadow-sm receiver-table-card">
    <div class="card-body">
        <div class="table-responsive receiver-table-wrap">
            <table class="table table-hover align-middle receiver-table">
                <thead>
                    <tr>
                        <th>المستقبل</th>
                        <th>القطاع</th>
                        <th>IP</th>
                        <th>العملاء</th>
                        <th>الحالة</th>
                        <th style="width:220px;">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model)
                    {
                        var isPendingApproval = pendingReceiverIds.Contains(r.Id);
                        <tr>
                            <td><strong>@r.Name</strong></td>
                            <td>@(r.Sector?.Name ?? "-")</td>
                            <td><code>@r.IPAddress</code></td>
                            <td>@(r.Clients?.Count ?? 0)</td>
                            <td>
                                @if (r.IsActive)
                                {
                                    <span class="badge bg-success">نشط</span>
                                }
                                else if (isPendingApproval)
                                {
                                    <span class="badge bg-warning text-dark">بانتظار موافقة المدير</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">متوقف</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-eye"></i> تفاصيل
                                </a>
                                @if (canEdit)
                                {
                                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-sm btn-warning">
                                        <i class="fas fa-edit"></i> تعديل
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .employee-receiver-hero { background: linear-gradient(135deg, #f8fbff 0%, #eef5ff 100%); margin-bottom: 1rem; }
    .employee-receiver-hero .page-header-content { padding: 1rem 1.2rem; }
    .employee-receiver-hero .page-title { margin: 0; color: #1b2a4b; font-weight: 700; }
    .receiver-action-btn { border-radius: 0.65rem; font-weight: 600; }
    .receiver-stat-card { border: 1px solid #e9ecef; border-radius: 0.9rem; }
    .receiver-stat-label { color: #6c757d; font-size: 0.88rem; }
    .receiver-stat-value { margin-top: .2rem; font-size: 1.35rem; font-weight: 700; }
    .receiver-stat-card.total .receiver-stat-value { color: #0d6efd; }
    .receiver-stat-card.active .receiver-stat-value { color: #198754; }
    .receiver-stat-card.inactive .receiver-stat-value { color: #6c757d; }
    .receiver-map-card, .receiver-table-card { border-radius: .95rem; }
    .receiver-table-wrap { border: 1px solid #e6edf6; border-radius: .9rem; }
    .receiver-table thead th { background: #f8fafc; color: #344054; border-bottom: 1px solid #dbe4f0; font-weight: 700; }
    .receiver-table td, .receiver-table th { padding: .68rem .8rem; vertical-align: middle; white-space: nowrap; }
    .receiver-table tbody tr:hover { background: #f7fbff; }
</style>

@section Scripts {
    <script src="~/js/receiver-map.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            var mapDataJson = '@Html.Raw(ViewBag.MapDataJson ?? "[]")';
            if (typeof initReceiverMap === 'function') {
                initReceiverMap('receiversMap', mapDataJson);
            }
        });
    </script>
}
