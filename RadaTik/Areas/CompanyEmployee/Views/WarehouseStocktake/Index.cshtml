@using RadaTik.Models.Business
@{
    ViewData["Title"] = "جرد المستودع";
    var stocktakes = ViewBag.Stocktakes as List<WarehouseStocktake> ?? new();
    var companyName = ViewBag.CompanyName as string ?? "";
}

<div class="page-header mb-3">
    <h1 class="page-title"><i class="fas fa-clipboard-check"></i> @ViewData["Title"]</h1>
    <p class="text-muted mb-0">@companyName</p>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-sm mb-0 radtk-data-table radtk-data-table--cards">
            <thead><tr><th>#</th><th>التاريخ</th><th>ملاحظات</th></tr></thead>
            <tbody>
            @if (!stocktakes.Any()) { <tr><td colspan="3" class="text-center text-muted py-3">لا توجد عمليات جرد.</td></tr> }
            @foreach (var s in stocktakes)
            {
                <tr>
                    <td>@s.Id</td>
                    <td>@s.StocktakeDate.ToString("yyyy-MM-dd")</td>
                    <td class="small">@(s.Notes ?? "—")</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
