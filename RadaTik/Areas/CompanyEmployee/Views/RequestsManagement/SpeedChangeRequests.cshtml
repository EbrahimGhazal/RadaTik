<div class="radtk-page-emp-speed-req">
<div class="radtk-page-emp-speed-req">
@model IEnumerable<RadaTik.Models.SpeedChangeRequest>
@using RadaTik.Models
@using RadaTik.Helpers
@{
    ViewData["Title"] = "طلبات تغيير السرعة";
    var currentStatus = ViewBag.CurrentStatus as string;
    ViewBag.PageHeroIcon = "fas fa-tachometer-alt";
    ViewBag.PageHeroBackUrl = Url.RouteUrl("employee-requestsManagement", new { action = "Index" });
    ViewBag.PageHeroBackText = "العودة";
}

<partial name="_CrudPageHero" />

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fas fa-check-circle alert-icon"></i>
        <div class="alert-content">@TempData["Success"]</div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        <i class="fas fa-exclamation-circle alert-icon"></i>
        <div class="alert-content">@TempData["Error"]</div>
    </div>
}

<!-- فلتر الحالة -->
<div class="filter-bar">
    <a href="@Url.RouteUrl("employee-requestsManagement", new { action = "SpeedChangeRequests" })" class="filter-btn @(string.IsNullOrEmpty(currentStatus) ? "active" : "")">
        الكل
    </a>
    <a href="@Url.RouteUrl("employee-requestsManagement", new { action = "SpeedChangeRequests", status = "Pending" })" class="filter-btn @(currentStatus == "Pending" ? "active" : "")">
        <i class="fas fa-clock"></i> في الانتظار
    </a>
    <a href="@Url.RouteUrl("employee-requestsManagement", new { action = "SpeedChangeRequests", status = "Approved" })" class="filter-btn @(currentStatus == "Approved" ? "active" : "")">
        <i class="fas fa-thumbs-up"></i> تمت الموافقة
    </a>
    <a href="@Url.RouteUrl("employee-requestsManagement", new { action = "SpeedChangeRequests", status = "Implemented" })" class="filter-btn @(currentStatus == "Implemented" ? "active" : "")">
        <i class="fas fa-check-double"></i> تم التنفيذ
    </a>
    <a href="@Url.RouteUrl("employee-requestsManagement", new { action = "SpeedChangeRequests", status = "Rejected" })" class="filter-btn @(currentStatus == "Rejected" ? "active" : "")">
        <i class="fas fa-times"></i> مرفوض
    </a>
</div>

<div class="card">
    <div class="card-body">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-sm table-hover radtk-data-table radtk-data-table--cards" id="speedChangeTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>العميل</th>
                            <th>من باقة</th>
                            <th>إلى باقة</th>
                            <th>فرق السعر</th>
                            <th>الحالة</th>
                            <th>تاريخ الطلب</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model)
                        {
                            var statusClass = PricingDisplay.SpeedChangeRequestStatusClass(request.Status);

                            var isUpgrade = request.RequestedProfile?.Price > request.CurrentProfile?.Price;

                            <tr class="@(request.Status == SpeedChangeRequestStatus.Pending ? "row-highlight" : "")">
                                <td data-label="#">@request.Id</td>
                                <td data-label="العميل">
                                    <div class="client-info">
                                        <div class="client-avatar">
                                            @(request.Client?.Name?.Substring(0, 1).ToUpper() ?? "?")
                                        </div>
                                        <div>
                                            <div class="client-name">@request.Client?.Name</div>
                                            <div class="client-phone">@request.Client?.PhoneNumber</div>
                                        </div>
                                    </div>
                                </td>
                                <td data-label="من باقة">
                                    <div class="profile-info">
                                        <span class="profile-name">@request.CurrentProfile?.Name</span>
                                        <span class="profile-speed">@request.CurrentProfile?.DownloadSpeedDisplay</span>
                                    </div>
                                </td>
                                <td data-label="إلى باقة">
                                    <div class="profile-info new">
                                        <span class="profile-name">@request.RequestedProfile?.Name</span>
                                        <span class="profile-speed">@request.RequestedProfile?.DownloadSpeedDisplay</span>
                                    </div>
                                </td>
                                <td data-label="فرق السعر">
                                    @if (request.PriceDifference.HasValue)
                                    {
                                        <span class="price-diff @(request.PriceDifference > 0 ? "increase" : "decrease")">
                                            @(request.PriceDifference > 0 ? "+" : "")@SyrianCurrencyHelper.FormatNew(request.PriceDifference.Value) ر.س
                                        </span>
                                    }
                                </td>
                                <td data-label="الحالة">
                                    <span class="status-badge @statusClass">
                                        @GetStatusName(request.Status)
                                    </span>
                                </td>
                                <td data-label="تاريخ الطلب">
                                    <div class="date-info">
                                        <div>@request.RequestDate.ToString("yyyy/MM/dd")</div>
                                        <div class="time-ago">@request.RequestDate.ToString("HH:mm")</div>
                                    </div>
                                </td>
                                <td data-label="إجراءات">
                                    <a asp-route="employee-requestsManagement" asp-route-action="SpeedChangeRequestDetails" asp-route-id="@request.Id" class="btn btn-sm btn-primary">
                                        <i class="fas fa-eye"></i> عرض
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <div class="empty-icon">
                    <i class="fas fa-inbox"></i>
                </div>
                <h3>لا توجد طلبات</h3>
                <p>لا توجد طلبات تغيير سرعة @(string.IsNullOrEmpty(currentStatus) ? "" : "بهذه الحالة")</p>
            </div>
        }
    </div>
</div>
@functions {
    string GetStatusName(SpeedChangeRequestStatus status) => PricingDisplay.SpeedChangeRequestStatusLabel(status);
}


</div>
@section Styles {
    <link rel="stylesheet" href="~/css/speed-change-requests-cards.css" asp-append-version="true" />
}

@section Scripts {
    <script>
        function initSpeedChangeTableIfDesktop() {
            if (!$('#speedChangeTable').length || typeof $.fn.DataTable === 'undefined') {
                return;
            }

            const isCompact = window.matchMedia('(max-width: 1199.98px)').matches;
            const already = $.fn.DataTable.isDataTable('#speedChangeTable');

            if (isCompact) {
                if (already) {
                    $('#speedChangeTable').DataTable().destroy();
                    $('#speedChangeTable').removeAttr('style');
                }
                return;
            }

            if (!already) {
                $('#speedChangeTable').DataTable({
                    language: {
                        url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/ar.json'
                    },
                    order: [[6, 'desc']],
                    pageLength: 25,
                    autoWidth: false,
                    scrollX: false
                });
            }
        }

        $(document).ready(function () {
            initSpeedChangeTableIfDesktop();
            let resizeTimer = null;
            $(window).on('resize', function () {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(initSpeedChangeTableIfDesktop, 180);
            });
        });
    </script>
}
