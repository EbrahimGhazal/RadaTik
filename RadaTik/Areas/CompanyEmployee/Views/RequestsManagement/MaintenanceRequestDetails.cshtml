@model RadaTik.Models.MaintenanceRequest
@using RadaTik.Models
@{
    ViewData["Title"] = $"طلب صيانة #{Model.Id}";
    ViewBag.PageHeroIcon = "fas fa-tools";
    ViewBag.PageHeroSubtitle = Model.Client?.Name;
    ViewBag.PageHeroBackUrl = Url.RouteUrl("employee-requestsManagement", new { action = "MaintenanceRequests" });
    ViewBag.PageHeroBackText = "العودة للقائمة";
    ViewBag.MaintenanceRouteName = "employee-requestsManagement";
    ViewBag.ClientProfileUrl = Url.Action("Details", "Clients", new { area = "CompanyEmployee", id = Model.ClientId });
}
<div class="radtk-page--companyemployee-views-requestsmanagement-maintenancerequestdetails radtk-page-maint-details maint-request-details-page">

<partial name="_CrudPageHero" />
<partial name="_MaintenanceRequestDetailsBody" />

</div>
@section Styles {
    <link rel="stylesheet" href="~/css/maintenance-request-details-cards.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/form-once-submit.js" asp-append-version="true"></script>
    <script src="~/js/maintenance-request-details.js" asp-append-version="true"></script>
}
