@model RadaTik.Areas.ClientPortal.ViewModels.Setup.ClientPortalRequiredPasswordViewModel
@using RadaTik.Security
@{
    Layout = "~/Areas/ClientPortal/Views/Shared/_SetupLayout.cshtml";
    ViewData["Title"] = ViewData["Title"] ?? "تعيين كلمة مرور البوابة";
}

@section Styles {
    <partial name="_StrongPasswordRulesStyles" />
}

<div class="card client-portal-setup-card border-0">
    <div class="card-body p-4 p-md-5">
        <h1 class="h4 mb-2"><i class="fas fa-shield-halved text-primary me-2"></i>@ViewData["Title"]</h1>
        <p class="text-muted mb-4">
            لأسباب أمنية، يجب تعيين كلمة مرور جديدة لدخول بوابة المشترك قبل متابعة الاستخدام.
            <strong>لن يتم تغيير كلمة مرور الإنترنت (PPPoE) على المايكروتك</strong> — فقط كلمة دخول التطبيق.
        </p>

        <partial name="_TempDataAlerts" />

        <form method="post" asp-action="RequiredPassword" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="NewPassword" class="form-label"></label>
                <div class="sp-password-field-wrap">
                    <span class="sp-password-field-icon" aria-hidden="true"><i class="fas fa-lock"></i></span>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" minlength="@ClientPasswordRules.MinimumLength" />
                    <button type="button" class="sp-password-toggle" data-sp-toggle-password="NewPassword" aria-label="إظهار كلمة المرور" aria-pressed="false">
                        <i class="fas fa-eye" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="ConfirmNewPassword" class="form-label"></label>
                <div class="sp-password-field-wrap">
                    <span class="sp-password-field-icon" aria-hidden="true"><i class="fas fa-lock"></i></span>
                    <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" minlength="@ClientPasswordRules.MinimumLength" />
                    <button type="button" class="sp-password-toggle" data-sp-toggle-password="ConfirmNewPassword" aria-label="إظهار تأكيد كلمة المرور" aria-pressed="false">
                        <i class="fas fa-eye" aria-hidden="true"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
            </div>

            @{
                ViewData["SpRulesMinLength"] = ClientPasswordRules.MinimumLength;
                ViewData["SpRulesPasswordFieldId"] = "NewPassword";
                ViewData["SpRulesInteractive"] = true;
                ViewData["SpRulesPanelId"] = "clientPortalSetupPasswordRules";
            }
            <partial name="_ClientPasswordRulesPanel" />

            <button type="submit" class="btn btn-primary w-100 mt-4">
                <i class="fas fa-check me-1"></i> حفظ والمتابعة
            </button>
        </form>

        <form method="post" asp-route="reglog-logout" class="mt-3 text-center">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-link text-muted btn-sm">تسجيل الخروج</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="_StrongPasswordRulesScripts" />
}
