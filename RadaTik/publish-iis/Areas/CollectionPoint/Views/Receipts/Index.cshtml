@model RadaTik.ViewModels.Receipts.ReceiptsIndexViewModel
@using RadaTik.ViewModels.Receipts

@{
    ViewData["Title"] = Model.Title;
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1 class="mb-1"><i class="fas fa-receipt"></i> @Model.Title</h1>
        <div class="text-muted">تقرير قبض على نطاق نقطة التحصيل فقط (حسب طريقة الدفع) ضمن الفترة المحددة.</div>
    </div>
</div>

<div class="mb-3 d-print-none">
    <button type="button" class="btn btn-outline-primary" onclick="window.print();">
        <i class="fas fa-print"></i> طباعة
    </button>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-sm-4 col-md-3">
                <label class="form-label">من</label>
                <input type="date" name="from" class="form-control" value="@(Model.From?.ToString("yyyy-MM-dd") ?? "")" />
            </div>
            <div class="col-sm-4 col-md-3">
                <label class="form-label">إلى</label>
                <input type="date" name="to" class="form-control" value="@(Model.To?.ToString("yyyy-MM-dd") ?? "")" />
            </div>
            <div class="col-sm-4 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1">
                    <i class="fas fa-filter"></i>
                    تطبيق
                </button>
                <a class="btn btn-outline-secondary" asp-route="collectionPoint-receipts">
                    تفريغ
                </a>
            </div>
        </form>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card h-100 border-primary">
            <div class="card-body">
                <div class="text-muted">عدد العمليات</div>
                <div class="fs-4 fw-bold">@Model.TotalCount</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">الإجمالي (ل.س)</div>
                <div class="fs-4 fw-bold">@Model.TotalSYP.ToString("N0")</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100">
            <div class="card-body">
                <div class="text-muted">الإجمالي ($)</div>
                <div class="fs-4 fw-bold">@Model.TotalUSD.ToString("N2")</div>
                <div class="text-muted small">* حالياً هذا التقرير يركز على الليرة.</div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="fas fa-chart-pie text-success"></i> الإجمالي حسب طريقة الدفع</h5>
    </div>
    <div class="card-body p-0">
        @if (Model.ByMethod.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>طريقة الدفع</th>
                            <th>عدد العمليات</th>
                            <th>الإجمالي (ل.س)</th>
                            <th>الإجمالي ($)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.ByMethod)
                        {
                            <tr>
                                <td><strong>@m.Method</strong></td>
                                <td>@m.Count</td>
                                <td>@m.TotalSYP.ToString("N0")</td>
                                <td>@m.TotalUSD.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-3 text-muted">لا توجد بيانات ضمن الفترة المحددة.</div>
        }
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="card-title mb-0"><i class="fas fa-list text-primary"></i> تفاصيل العمليات</h5>
        <span class="text-muted small">عرض آخر @Model.Items.Count عملية ضمن الفلتر.</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Items.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>تاريخ الاعتماد</th>
                            <th>نوع المصدر</th>
                            <th>رقم الطلب</th>
                            <th>طريقة الدفع</th>
                            <th>المبلغ (ل.س)</th>
                            <th>مرجع</th>
                            <th>الإيصال</th>
                            <th>الموافق</th>
                            <th>ملاحظات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model.Items.Take(500))
                        {
                            <tr>
                                <td>@r.ApprovedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>
                                    @if (r.SourceType == ReceiptSourceType.CollectionPointTopUp)
                                    {
                                        <span class="badge bg-secondary">تغذية نقطة</span>
                                    }
                                    else if (r.SourceType == ReceiptSourceType.CollectionPointOperation)
                                    {
                                        <span class="badge bg-primary">عملية تحصيل</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-dark">أخرى</span>
                                    }
                                </td>
                                <td class="text-muted">#@r.SourceId</td>
                                <td>@r.PaymentMethod</td>
                                <td class="fw-bold">@r.AmountSYP.ToString("N0")</td>
                                <td class="text-muted small">@(string.IsNullOrWhiteSpace(r.ReferenceNumber) ? "—" : r.ReferenceNumber)</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(r.ReceiptImagePath))
                                    {
                                        <a class="btn btn-sm btn-outline-secondary" href="@r.ReceiptImagePath" target="_blank">
                                            <i class="fas fa-image"></i>
                                            عرض
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">—</span>
                                    }
                                </td>
                                <td class="text-muted small">@(string.IsNullOrWhiteSpace(r.ApprovedBy) ? "—" : r.ApprovedBy)</td>
                                <td class="text-muted small">@(string.IsNullOrWhiteSpace(r.Notes) ? "—" : r.Notes)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-3 text-muted">لا توجد عمليات قبض ضمن الفترة المحددة.</div>
        }
    </div>
</div>

