@model RadaTik.ViewModels.CollectionPoint.ClientDetailsForCollectionPointViewModel
@using RadaTik.Helpers
@using RadaTik.Models

@{
    ViewData["Title"] = "تفاصيل العميل - نقطة التحصيل";
    var hasBlockingInvoices = (ViewBag.HasBlockingInvoices as bool?) ?? false;
    var blockingInvoicesCount = (ViewBag.BlockingInvoicesCount as int?) ?? 0;
    var blockingInvoicesTotal = (ViewBag.BlockingInvoicesTotal as decimal?) ?? 0m;
    bool usdAccount = Model.RequiresExchange;
    string balanceDisplay = CurrencyHelper.FormatAmount(Model.ClientBalance, Model.AccountCurrency);
    string dueAccountDisplay = CurrencyHelper.FormatAmount(Model.AmountDueAccount, Model.AccountCurrency);
}

<div class="page-header d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div>
        <h1><i class="fas fa-user"></i> تفاصيل العميل</h1>
        <p class="text-muted mb-0">@Model.ClientName (@Model.ClientUserName)</p>
        @if (usdAccount)
        {
            <p class="text-info small mb-0"><i class="fas fa-dollar-sign"></i> حساب المشترك بالدولار — الأسعار والرصيد بـ $ والخصم من النقطة بالليرة.</p>
        }
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-right"></i> رجوع للقائمة
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (hasBlockingInvoices)
{
    <div class="alert alert-warning">
        لا يمكن تنفيذ التجديد قبل تسديد فواتير الصيانة المستحقة على المشترك
        (عدد الفواتير: @blockingInvoicesCount - إجمالي المستحقات: @blockingInvoicesTotal.ToString("N0") ل.س).
    </div>
}

<div class="row">
    <div class="col-lg-6 mb-3">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title mb-0"><i class="fas fa-id-card"></i> بيانات المشترك</h5>
            </div>
            <div class="card-body">
                <p class="mb-1"><strong>اسم المستخدم:</strong> @(Model.ClientUserName ?? "—")</p>
                <p class="mb-1"><strong>الاسم الثلاثي:</strong> @(Model.ClientName ?? "—")</p>
                <p class="mb-1"><strong>رقم الجوال:</strong> @(Model.PhoneNumber ?? "—")</p>
                <p class="mb-1"><strong>مكان السكن:</strong> @(Model.ResidenceAddress ?? "—")</p>
                <p class="mb-1"><strong>اسم الشركة:</strong> @(Model.CompanyName ?? "—")</p>
                <p class="mb-0"><strong>الشبكة التابعة لها:</strong> @(Model.NetworkName ?? "—")</p>
            </div>
        </div>
    </div>
    <div class="col-lg-6 mb-3">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title mb-0"><i class="fas fa-wallet"></i> الرصيد والمبلغ الواجب</h5>
            </div>
            <div class="card-body">
                <p class="mb-1"><strong>رصيد العميل:</strong> <span class="text-info fw-bold">@balanceDisplay</span></p>
                <p class="mb-1"><strong>رصيد نقطة التحصيل:</strong> <span class="text-success">@SyrianCurrencyHelper.FormatNew(Model.CollectionPointBalance) ل.س.ج</span></p>
                <p class="mb-1"><strong>السعر الأساسي (شهر):</strong> <span>@CurrencyHelper.FormatAmount(Model.CurrentBasePrice, Model.AccountCurrency)</span></p>
                <p class="mb-1"><strong>الضريبة (شهر):</strong> <span>@CurrencyHelper.FormatAmount(Model.CurrentCommissionAmount, Model.AccountCurrency)</span></p>
                <p class="mb-1"><strong>المبلغ النهائي للتجديد:</strong> <span class="text-primary fs-5">@dueAccountDisplay</span>
                    @if (Model.PendingRenewalMonths > 1)
                    {
                        <span class="text-muted small">(@Model.PendingRenewalMonths أشهر)</span>
                    }
                </p>
                @if (usdAccount)
                {
                    <p class="mb-1"><strong>يُخصم من النقطة:</strong> <span class="fw-bold">@SyrianCurrencyHelper.FormatNew(Model.AmountDuePointChargeSyp) ل.س.ج</span>
                        @if (Model.DefaultExchangeRate.HasValue)
                        {
                            <span class="text-muted small">(سعر @Model.DefaultExchangeRate.Value.ToString("0.####") ل.س.ج / $)</span>
                        }
                    </p>
                }
                <p class="mb-1 small text-muted">المعادلة (شهر): @CurrencyHelper.FormatAmount(Model.CurrentBasePrice, Model.AccountCurrency) + @CurrencyHelper.FormatAmount(Model.CurrentCommissionAmount, Model.AccountCurrency) = @CurrencyHelper.FormatAmount(Model.CurrentProfilePrice, Model.AccountCurrency)</p>
                @if (Model.AccountExpirationDate.HasValue)
                {
                    <p class="mb-0 text-muted small">انتهاء الاشتراك: @Model.AccountExpirationDate.Value.ToString("yyyy/MM/dd")</p>
                }
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header">
        <h5 class="card-title mb-0"><i class="fas fa-list"></i> أسعار الباقات المحددة من مدير الشبكة</h5>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-sm table-bordered radtk-data-table radtk-data-table--cards">
                <thead>
                    <tr>
                        <th>الباقة</th>
                        <th>السرعة</th>
                        <th>حجم البيانات</th>
                        <th>السعر</th>
                        <th>الضريبة</th>
                        <th>الإجمالي</th>
                        <th>الحالية للمشترك</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model.ProfilePrices)
                    {
                        <tr class="@(p.ProfileId == Model.CurrentProfileId ? "table-primary" : "")">
                            <td>@p.Name</td>
                            <td>@p.SpeedDisplay</td>
                            <td>@p.DataLimitDisplay</td>
                            <td>@CurrencyHelper.FormatAmount(p.Price, Model.AccountCurrency)</td>
                            <td>@CurrencyHelper.FormatAmount(p.CommissionAmount, Model.AccountCurrency)</td>
                            <td>@CurrencyHelper.FormatAmount(p.PriceWithVAT, Model.AccountCurrency)</td>
                            <td>@(p.ProfileId == Model.CurrentProfileId ? "✓ الباقة الحالية" : "—")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <p class="mb-0 small text-muted">
            <strong>الباقة المحددة حالياً للمشترك:</strong> @(Model.CurrentProfileName ?? "—") — السعر: @CurrencyHelper.FormatAmount(Model.CurrentProfilePrice, Model.AccountCurrency)
        </p>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header bg-info text-white">
        <h5 class="card-title mb-0"><i class="fas fa-coins"></i> تغذية الرصيد (من نقطة التحصيل)</h5>
    </div>
    <div class="card-body">
        <p class="text-muted mb-3">يُخصم المبلغ من رصيد نقطة التحصيل (ل.س.ج) ويُضاف لرصيد المشترك @(usdAccount ? "بالدولار" : "بالليرة").</p>
        <form asp-action="TopUpClientBalance" method="post" class="row g-2 align-items-end" id="topUpForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="clientId" value="@Model.ClientId" />
            @if (usdAccount && Model.DefaultExchangeRate.HasValue)
            {
                <input type="hidden" name="exchangeRate" value="@Model.DefaultExchangeRate.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
            }
            <div class="col-md-2">
                <label class="form-label">المبلغ @(usdAccount ? "(ل.س.ج من النقطة)" : "(ل.س.ج)")</label>
                <input type="number" name="amount" id="topUpAmount" class="form-control" min="0.01" step="0.01" required placeholder="0" />
            </div>
            @if (usdAccount)
            {
                <div class="col-md-3">
                    <label class="form-label">يُضاف للمشترك</label>
                    <div class="form-control bg-light" id="topUpAccountPreview">—</div>
                </div>
            }
            <div class="col-md-3">
                <label class="form-label">ملاحظات (اختياري)</label>
                <input type="text" name="notes" class="form-control" placeholder="ملاحظات" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-info w-100" onclick="return confirm('تأكيد تغذية الرصيد؟');">
                    <i class="fas fa-plus-circle"></i> تغذية الرصيد
                </button>
            </div>
        </form>
        @{
            var recentTopUps = ViewBag.RecentTopUps as IEnumerable<RadaTik.Models.ClientTopUpTransaction> ?? Enumerable.Empty<RadaTik.Models.ClientTopUpTransaction>();
        }
        @if (recentTopUps.Any())
        {
            <h6 class="mt-3 mb-2">آخر عمليات التغذية</h6>
            <div class="table-responsive">
                <table class="table table-sm radtk-data-table radtk-data-table--cards">
                    <thead><tr><th>التاريخ</th><th>المبلغ</th><th>المصدر</th><th>بواسطة</th></tr></thead>
                    <tbody>
                        @foreach (var t in recentTopUps)
                        {
                            <tr>
                                <td>@t.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                <td>+@CurrencyHelper.FormatAmount(t.Amount, Model.AccountCurrency)</td>
                                <td>@(t.SourceType == ClientTopUpSource.CollectionPoint ? "نقطة التحصيل" : t.SourceType == ClientTopUpSource.SystemAdmin ? "مدير النظام" : "مدير الشبكة")</td>
                                <td>@(t.CreatedByUser?.UserName ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="card border-success">
    <div class="card-header bg-success text-white">
        <h5 class="card-title mb-0"><i class="fas fa-hand-holding-usd"></i> تسديد المبلغ وتجديد الاشتراك</h5>
    </div>
    <div class="card-body">
        <p class="text-muted">
            يُخصم من رصيد نقطة التحصيل ويُجدّد الاشتراك مباشرة.
            @if (Model.PendingRenewalMonths > 1)
            {
                <text> يشمل <strong>@Model.PendingRenewalMonths</strong> أشهر متأخرة.</text>
            }
        </p>
        <form asp-action="PayAndRequestRenewal" method="post" class="row g-2 align-items-end">
            @Html.AntiForgeryToken()
            <input type="hidden" name="clientId" value="@Model.ClientId" />
            <input type="hidden" name="amount" value="@Model.AmountDueAccount.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture)" />
            <div class="col-md-4">
                <label class="form-label">المستحق على المشترك</label>
                <input class="form-control" value="@dueAccountDisplay" readonly />
                @if (usdAccount)
                {
                    <small class="text-muted d-block mt-1">خصم من النقطة: @SyrianCurrencyHelper.FormatNew(Model.AmountDuePointChargeSyp) ل.س.ج</small>
                }
            </div>
            <div class="col-md-4">
                <label class="form-label">ملاحظات (اختياري)</label>
                <input type="text" name="notes" class="form-control" placeholder="ملاحظات" />
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-success w-100" @(hasBlockingInvoices ? "disabled" : null)>
                    <i class="fas fa-check-circle"></i> تسديد المبلغ
                </button>
            </div>
        </form>
        <div class="mt-2">
            <a asp-action="ReceivePayment" asp-route-id="@Model.ClientId" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-money-bill-wave"></i> تحصيل مبلغ آخر (إيداع برصيد العميل)
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @if (usdAccount && Model.DefaultExchangeRate.HasValue)
    {
        <script>
            (function () {
                const rate = parseFloat('@Model.DefaultExchangeRate.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)');
                const input = document.getElementById('topUpAmount');
                const preview = document.getElementById('topUpAccountPreview');
                function recalc() {
                    const pay = parseFloat(input?.value || '0');
                    if (!rate || !pay) { if (preview) preview.textContent = '—'; return; }
                    const usd = Math.round((pay / rate) * 100) / 100;
                    if (preview) preview.textContent = usd.toFixed(2) + ' $';
                }
                input?.addEventListener('input', recalc);
            })();
        </script>
    }
}
