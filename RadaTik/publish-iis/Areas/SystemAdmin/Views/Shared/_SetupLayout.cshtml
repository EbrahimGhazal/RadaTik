@{
    Layout = "~/Views/Shared/_Shell.cshtml";
    ViewData["BodyClass"] = "system-admin-setup-page";
}

@section VendorStyles {
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          asp-fallback-href="~/areas/SystemAdmin/lib/bootstrap/css/bootstrap.min.css"
          asp-fallback-test-class="d-none"
          asp-fallback-test-property="display"
          asp-fallback-test-value="none" />
}

@section Styles {
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/areas/SystemAdmin/css/area.css" asp-append-version="true" />
    <style>
        .system-admin-setup-wrap {
            max-width: 720px;
            margin: 2rem auto;
            padding: 0 1rem 3rem;
        }
        .system-admin-setup-card {
            border-radius: 16px;
            box-shadow: 0 8px 32px rgba(15, 23, 42, 0.08);
        }
        .system-admin-setup-brand {
            text-align: center;
            margin-bottom: 1.5rem;
        }
    </style>
    @await RenderSectionAsync("Styles", required: false)
}

<div class="system-admin-setup-wrap">
    <div class="system-admin-setup-brand">
        @{
            ViewData["RtBrandVariant"] = "compact";
        }
        <partial name="_RadaTikBrandLogo" />
        <p class="text-muted small mt-2 mb-0">تهيئة حساب مدير النظام</p>
    </div>
    @RenderBody()
</div>

@section VendorScripts {
    <script src="https://code.jquery.com/jquery-3.7.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
            asp-fallback-src="~/areas/SystemAdmin/lib/bootstrap/js/bootstrap.bundle.min.js"
            asp-fallback-test="window.bootstrap"></script>
}

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
