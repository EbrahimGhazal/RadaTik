@model RadaTik.Areas.CompanyAdmin.ViewModels.MoneyDiaryIndexViewModel
@using RadaTik.Helpers
@using RadaTik.Models
@using RadaTik.Models.Business
@{
    Layout = null;
    var monthNames = new[] { "", "يناير", "فبراير", "مارس", "أبريل", "مايو", "يونيو", "يوليو", "أغسطس", "سبتمبر", "أكتوبر", "نوفمبر", "ديسمبر" };
    var companyName = ViewBag.CompanyName as string ?? "";
}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <title>دفتر الإيراد والمصروف</title>
    <style>
        body { font-family: Tahoma, sans-serif; margin: 24px; }
        table { width: 100%; border-collapse: collapse; }
        th, td { border: 1px solid #ccc; padding: 6px; text-align: right; }
        th { background: #f0f4f8; }
        .no-print { margin-bottom: 12px; }
        @@media print { .no-print { display: none; } }
    </style>
</head>
<body>
    <div class="no-print">
        <button type="button" onclick="window.print()">طباعة</button>
    </div>
    <h1>دفتر الإيراد والمصروف</h1>
    <p>@companyName — @monthNames[Model.Month] @Model.Year</p>
    <p>
        <strong>ل.س.ج:</strong> إيراد @CurrencyHelper.FormatAmount(Model.TotalIncomeSyp, PricingCurrency.SYP_New)
        | مصروف @CurrencyHelper.FormatAmount(Model.TotalExpenseSyp, PricingCurrency.SYP_New)
        | صافي @CurrencyHelper.FormatAmount(Model.NetSyp, PricingCurrency.SYP_New)
    </p>
    <p>
        <strong>$:</strong> إيراد @CurrencyHelper.FormatAmount(Model.TotalIncomeUsd, PricingCurrency.USD)
        | مصروف @CurrencyHelper.FormatAmount(Model.TotalExpenseUsd, PricingCurrency.USD)
        | صافي @CurrencyHelper.FormatAmount(Model.NetUsd, PricingCurrency.USD)
    </p>
    <table>
        <thead>
            <tr><th>التاريخ</th><th>النوع</th><th>التصنيف</th><th>العملة</th><th>المبلغ</th><th>الوصف</th></tr>
        </thead>
        <tbody>
        @foreach (var e in Model.Entries.OrderBy(x => x.EntryDate))
        {
            <tr>
                <td>@e.EntryDate.ToString("yyyy-MM-dd")</td>
                <td>@(e.EntryType == MoneyDiaryEntryType.Income ? "إيراد" : "مصروف")</td>
                <td>@MoneyDiaryCategories.GetLabel(e.CategoryKey)</td>
                <td>@CurrencyHelper.GetSymbol(e.Currency)</td>
                <td>@CurrencyHelper.FormatAmount(e.Amount, e.Currency)</td>
                <td>@(e.Description ?? "")</td>
            </tr>
        }
        </tbody>
    </table>
</body>
</html>
