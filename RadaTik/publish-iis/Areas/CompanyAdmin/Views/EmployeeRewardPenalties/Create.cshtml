@model RadaTik.Models.Business.EmployeeRewardPenalty
@{
    ViewData["Title"] = "إضافة مكافأة أو عقوبة";
    var payrollEmployees = ViewBag.PayrollEmployees as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<div class="financial-page financial-hub-page col-lg-8">
    <h1 class="h4 mb-3">إضافة مكافأة أو عقوبة</h1>
    <form asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label asp-for="PayrollEmployeeId" class="form-label">الموظف</label>
            <select asp-for="PayrollEmployeeId" class="form-select" asp-items="payrollEmployees" required>
                <option value="">— اختر —</option>
            </select>
        </div>
        <div class="mb-3">
            <label asp-for="Type" class="form-label">النوع</label>
            <select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<RadaTik.Models.Business.EmployeeRewardPenaltyType>()"></select>
        </div>
        <div class="mb-3">
            <label asp-for="Amount" class="form-label">المبلغ</label>
            <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" required />
        </div>
        <div class="mb-3">
            <label asp-for="Reason" class="form-label">السبب</label>
            <textarea asp-for="Reason" class="form-control" rows="2" required></textarea>
        </div>
        <button type="submit" class="btn btn-primary">تسجيل</button>
        <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
    </form>
</div>
