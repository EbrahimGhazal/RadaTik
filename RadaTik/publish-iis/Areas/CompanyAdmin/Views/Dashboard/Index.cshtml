<div class="radtk-page-dashboard nm-dashboard-v2">
@using RadaTik.Areas.CompanyAdmin.ViewModels
@using RadaTik.ViewModels.Onboarding
@{
    ViewData["Title"] = "لوحة تحكم مدير الشركة";

    int totalClients = ViewBag.TotalClients ?? 0;
    int activeClients = ViewBag.ActiveClients ?? 0;
    int inactiveClients = ViewBag.InactiveClients ?? 0;

    int totalSectors = ViewBag.TotalSectors ?? 0;
    int activeSectors = ViewBag.ActiveSectors ?? 0;

    int totalReceivers = ViewBag.TotalReceivers ?? 0;
    int activeReceivers = ViewBag.ActiveReceivers ?? 0;

    int totalServers = ViewBag.TotalServers ?? 0;
    int activeServers = ViewBag.ActiveServers ?? 0;

    int expiredSubscriptions = ViewBag.ExpiredSubscriptions ?? 0;
    int expiringInWeek = ViewBag.ExpiringInWeek ?? 0;

    var recentClients = ViewBag.RecentClients as IEnumerable<CompanyAdminDashboardRecentClient> ?? Enumerable.Empty<CompanyAdminDashboardRecentClient>();
    var profileStats = ViewBag.ProfileStats as IEnumerable<CompanyAdminDashboardProfileStat> ?? Enumerable.Empty<CompanyAdminDashboardProfileStat>();
    int newClientsThisMonth = ViewBag.NewClientsThisMonth ?? 0;
    double clientsChangePercent = ViewBag.ClientsChangePercent ?? 0.0;
    var activeRate = totalClients > 0 ? (int)Math.Round(activeClients * 100.0 / totalClients) : 0;
}

<div class="operational-page company-dashboard-page">
    @{
        ViewBag.OperationalHeroIcon = "fas fa-gauge-high";
        ViewBag.OperationalHeroSubtitle = "نظرة عامة على الشبكة والمشتركين والبنية التحتية";
        ViewBag.OperationalHeroTheme = "dashboard";
    }
    <partial name="_OperationalSysHero" />

    <nav class="nm-quick-actions" aria-label="إجراءات سريعة">
        <a class="nm-quick-action nm-quick-action--primary" asp-route="networkManager-operations-hub">
            <i class="fas fa-bolt" aria-hidden="true"></i>
            <span>مركز العمليات</span>
        </a>
        <a class="nm-quick-action" asp-route="networkManager-new-subscriber-wizard" asp-route-action="Index" asp-route-id="">
            <i class="fas fa-user-plus" aria-hidden="true"></i>
            <span>مشترك جديد</span>
        </a>
        <a class="nm-quick-action" asp-route="networkManager-wallet-index">
            <i class="fas fa-wallet" aria-hidden="true"></i>
            <span>المحفظة</span>
        </a>
        <a class="nm-quick-action" asp-route="networkManager-reports" asp-route-action="Index" asp-route-id="">
            <i class="fas fa-chart-pie" aria-hidden="true"></i>
            <span>التقارير</span>
        </a>
        <a class="nm-quick-action" asp-route="networkManager-clients" asp-route-action="Index" asp-route-id="">
            <i class="fas fa-users" aria-hidden="true"></i>
            <span>العملاء</span>
        </a>
    </nav>

@if (ViewBag.OnboardingChecklist is OnboardingChecklistViewModel onboardingChecklist)
{
    <partial name="_OnboardingChecklist" model="onboardingChecklist" />
}

<section class="nm-kpi-bento" aria-label="مؤشرات الشبكة">
    <article class="nm-kpi-card nm-kpi-card--featured">
        <div class="nm-kpi-card__head">
            <span class="nm-kpi-card__icon"><i class="fas fa-users" aria-hidden="true"></i></span>
            <span class="nm-kpi-card__badge">@activeRate% نشط</span>
        </div>
        <div class="nm-kpi-card__value">@totalClients</div>
        <div class="nm-kpi-card__label">إجمالي العملاء</div>
        <div class="nm-kpi-card__meta">@activeClients نشط · @inactiveClients غير نشط</div>
    </article>

    <div class="nm-kpi-cluster">
        <article class="nm-kpi-card">
            <span class="nm-kpi-card__icon tone-success"><i class="fas fa-server" aria-hidden="true"></i></span>
            <div class="nm-kpi-card__value">@totalServers</div>
            <div class="nm-kpi-card__label">الخوادم</div>
            <div class="nm-kpi-card__meta">@activeServers نشطة</div>
        </article>
        <article class="nm-kpi-card">
            <span class="nm-kpi-card__icon tone-accent"><i class="fas fa-broadcast-tower" aria-hidden="true"></i></span>
            <div class="nm-kpi-card__value">@totalSectors</div>
            <div class="nm-kpi-card__label">المرسلات</div>
            <div class="nm-kpi-card__meta">@activeSectors نشطة</div>
        </article>
        <article class="nm-kpi-card">
            <span class="nm-kpi-card__icon tone-violet"><i class="fas fa-satellite-dish" aria-hidden="true"></i></span>
            <div class="nm-kpi-card__value">@totalReceivers</div>
            <div class="nm-kpi-card__label">المستقبلات</div>
            <div class="nm-kpi-card__meta">@activeReceivers نشطة</div>
        </article>
    </div>
</section>

<section class="nm-subscription-strip" aria-label="حالة الاشتراكات">
    <article class="nm-sub-pill @(expiredSubscriptions > 0 ? "nm-sub-pill--alert" : "")">
        <i class="fas fa-exclamation-circle" aria-hidden="true"></i>
        <div>
            <strong>@expiredSubscriptions</strong>
            <span>اشتراكات منتهية</span>
        </div>
    </article>
    <article class="nm-sub-pill @(expiringInWeek > 0 ? "nm-sub-pill--warn" : "")">
        <i class="fas fa-hourglass-half" aria-hidden="true"></i>
        <div>
            <strong>@expiringInWeek</strong>
            <span>تنتهي خلال 7 أيام</span>
        </div>
    </article>
    <article class="nm-sub-pill nm-sub-pill--growth">
        <i class="fas fa-chart-line" aria-hidden="true"></i>
        <div>
            <strong>@newClientsThisMonth</strong>
            <span>عملاء جدد هذا الشهر (@clientsChangePercent%)</span>
        </div>
    </article>
</section>

<partial name="_CompanyBusinessSummary" />

<section class="nm-section">
    <header class="nm-section__head">
        <h2 class="nm-section__title"><i class="fas fa-chart-area" aria-hidden="true"></i> التحليلات</h2>
    </header>
<div class="dashboard-viz-grid mb-4">
    <div class="card nm-panel">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-chart-line nm-panel__icon" aria-hidden="true"></i>
                إضافات العملاء اليومية
            </h3>
            <span class="nm-panel__badge">آخر 30 يومًا</span>
        </div>
        <div class="card-body">
            <p class="small text-muted mb-2">عدد العملاء المسجّلين في الشبكة الحالية لكل يوم (تفاعلي).</p>
            <div class="nm-dash-chart-wrap">
                <canvas id="nmChartDaily" aria-label="مخطط يومي"></canvas>
            </div>
        </div>
    </div>
    <div class="card nm-panel">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-chart-bar nm-panel__icon nm-panel__icon--secondary" aria-hidden="true"></i>
                نمو العملاء الشهري
            </h3>
            <span class="nm-panel__badge nm-panel__badge--secondary">12 شهرًا</span>
        </div>
        <div class="card-body">
            <p class="small text-muted mb-2">إجمالي عملاء جدد مسجّلين كل شهر في الشبكة الحالية.</p>
            <div class="nm-dash-chart-wrap">
                <canvas id="nmChartMonthly" aria-label="مخطط شهري"></canvas>
            </div>
        </div>
    </div>
</div>
</section>

<section class="nm-section">
    <header class="nm-section__head">
        <h2 class="nm-section__title"><i class="fas fa-map-marked-alt" aria-hidden="true"></i> التغطية والنشاط</h2>
    </header>
<div class="dashboard-map-row mb-4">
    <div class="card nm-panel nm-map-card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-map-marked-alt nm-panel__icon nm-panel__icon--success" aria-hidden="true"></i>
                خريطة التغطية
            </h3>
            <span class="nm-panel__hint" id="nmMapLegend">المرسلات، المستقبلات، العملاء</span>
        </div>
        <div class="card-body p-0">
            <div id="nmCoverageMap" class="nm-dash-map" role="region" aria-label="خريطة الشبكة"></div>
        </div>
    </div>
    <div class="card nm-panel">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-bolt nm-panel__icon nm-panel__icon--accent" aria-hidden="true"></i>
                النشاط الأخير
            </h3>
        </div>
        <div class="card-body">
            <ul class="nm-activity-feed list-unstyled mb-0" id="nmActivityFeed">
                <li class="text-muted small">جاري التحميل…</li>
            </ul>
        </div>
    </div>
</div>
</section>

<section class="nm-section">
    <header class="nm-section__head">
        <h2 class="nm-section__title"><i class="fas fa-clock-rotate-left" aria-hidden="true"></i> آخر التحديثات</h2>
    </header>
<div class="content-grid">
    <div class="card nm-panel">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-user-clock nm-panel__icon" aria-hidden="true"></i>
                آخر العملاء المضافين
            </h3>
        </div>
        <div class="card-body">
            @if (recentClients.Any())
            {
                <div class="requests-list">
                    @foreach (var c in recentClients)
                    {
                        var avatarSource = (c.Name ?? c.UserName)?.Trim();
                        var avatarLetter = string.IsNullOrWhiteSpace(avatarSource) ? "?" : avatarSource[..1].ToUpperInvariant();
                        <div class="request-item">
                            <div class="request-avatar">
                                @avatarLetter
                            </div>
                            <div class="request-info">
                                <div class="request-client">@c.Name (@c.UserName)</div>
                                <div class="request-type text-muted">
                                    أضيف في @c.CreatedDate.ToString("yyyy/MM/dd HH:mm")
                                </div>
                            </div>
                            <div class="request-time">
                                @(c.IsActive ? "نشط" : "غير نشط")
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-mini">
                    <i class="fas fa-info-circle text-muted"></i>
                    <span>لا يوجد عملاء مضافون مؤخراً</span>
                </div>
            }
        </div>
    </div>

    <div class="card nm-panel">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fas fa-tags nm-panel__icon nm-panel__icon--success" aria-hidden="true"></i>
                أكثر الباقات استخداماً
            </h3>
        </div>
        <div class="card-body">
            @if (profileStats.Any())
            {
                <div class="requests-list">
                    @foreach (var p in profileStats)
                    {
                        <div class="request-item">
                            <div class="request-avatar speed">
                                <i class="fas fa-tachometer-alt"></i>
                            </div>
                            <div class="request-info">
                                <div class="request-client">@p.Name</div>
                                <div class="request-type text-muted">
                                    عدد العملاء: @p.ClientCount
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty-mini">
                    <i class="fas fa-info-circle text-muted"></i>
                    <span>لا توجد بيانات للباقات حالياً</span>
                </div>
            }
        </div>
    </div>
</div>
</section>

</div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js" crossorigin="anonymous"></script>
    <script>
        (function () {
            var insightsUrl = @Html.Raw(Json.Serialize(Url.Action("InsightsData", "Dashboard", new { area = "CompanyAdmin" })));
            var nmMap = null;
            var nmTileLayer = null;
            var nmSectorFansLayer = null;
            var nmMarkersLayer = null;
            var lineChart = null;
            var barChart = null;
            var lastPayload = null;

            function chartColors() {
                var st = getComputedStyle(document.documentElement);
                return {
                    text: (st.getPropertyValue('--rtk-neutral-mid').trim() || '#64748b'),
                    textStrong: (st.getPropertyValue('--rtk-neutral-text').trim() || '#334155'),
                    grid: (st.getPropertyValue('--rtk-card-border').trim() || 'rgba(148, 163, 184, 0.35)'),
                    primary: (st.getPropertyValue('--rtk-primary').trim() || '#2563eb'),
                    secondary: (st.getPropertyValue('--rtk-secondary').trim() || '#06b6d4'),
                    surface: (st.getPropertyValue('--rtk-card').trim() || '#ffffff')
                };
            }

            function cssColorToRgba(color, alpha) {
                if (!color) return 'rgba(59, 130, 246,' + alpha + ')';
                color = String(color).trim();
                if (color.charAt(0) === '#') {
                    var h = color.slice(1);
                    if (h.length === 3) {
                        h = h.split('').map(function (ch) { return ch + ch; }).join('');
                    }
                    if (h.length !== 6) return 'rgba(59, 130, 246,' + alpha + ')';
                    var r = parseInt(h.slice(0, 2), 16), g = parseInt(h.slice(2, 4), 16), b = parseInt(h.slice(4, 6), 16);
                    return 'rgba(' + r + ',' + g + ',' + b + ',' + alpha + ')';
                }
                var m = color.match(/^rgba?\((\d+),\s*(\d+),\s*(\d+)/);
                if (m) return 'rgba(' + m[1] + ',' + m[2] + ',' + m[3] + ',' + alpha + ')';
                return color;
            }

            function commonScaleOpts(c) {
                return {
                    ticks: { color: c.text, maxRotation: 0, autoSkip: true },
                    grid: { color: c.grid }
                };
            }

            function buildCharts(payload) {
                if (typeof Chart === 'undefined') return;
                var c = chartColors();
                var daily = payload.dailySignups || [];
                var monthly = payload.monthlySignups || [];

                if (lineChart) { lineChart.destroy(); lineChart = null; }
                if (barChart) { barChart.destroy(); barChart = null; }

                var ctxL = document.getElementById('nmChartDaily');
                var ctxB = document.getElementById('nmChartMonthly');
                if (!ctxL || !ctxB) return;

                lineChart = new Chart(ctxL, {
                    type: 'line',
                    data: {
                        labels: daily.map(function (x) { return x.t; }),
                        datasets: [{
                            label: 'عملاء جدد',
                            data: daily.map(function (x) { return x.count; }),
                            borderColor: c.primary,
                            backgroundColor: cssColorToRgba(c.primary, 0.15),
                            fill: true,
                            tension: 0.25,
                            pointRadius: 0,
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: c.surface,
                                titleColor: c.textStrong,
                                bodyColor: c.textStrong,
                                borderColor: c.grid,
                                borderWidth: 1
                            }
                        },
                        scales: {
                            x: commonScaleOpts(c),
                            y: { beginAtZero: true, ticks: { color: c.text, precision: 0 }, grid: { color: c.grid } }
                        }
                    }
                });

                barChart = new Chart(ctxB, {
                    type: 'bar',
                    data: {
                        labels: monthly.map(function (x) { return x.m; }),
                        datasets: [{
                            label: 'عملاء جدد',
                            data: monthly.map(function (x) { return x.users; }),
                            backgroundColor: cssColorToRgba(c.secondary, 0.85),
                            borderRadius: 6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: c.surface,
                                titleColor: c.textStrong,
                                bodyColor: c.textStrong,
                                borderColor: c.grid,
                                borderWidth: 1
                            }
                        },
                        scales: {
                            x: commonScaleOpts(c),
                            y: { beginAtZero: true, ticks: { color: c.text, precision: 0 }, grid: { color: c.grid } }
                        }
                    }
                });
            }

            function tileLayerForTheme() {
                var dark = document.documentElement.getAttribute('data-theme') === 'dark';
                if (dark) {
                    return L.tileLayer('https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png', {
                        attribution: '&copy; OSM &copy; CARTO',
                        subdomains: 'abcd',
                        maxZoom: 20
                    });
                }
                return L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; OpenStreetMap'
                });
            }

            /** نقطة على مسافة واتجاه (درجات، 0 = الشمال) من (lat,lng) — dist كم */
            function nmDestinationLatLng(lat, lng, bearingDeg, distanceKm) {
                var R = 6371;
                var brng = bearingDeg * Math.PI / 180;
                var d = distanceKm / R;
                var φ1 = lat * Math.PI / 180;
                var λ1 = lng * Math.PI / 180;
                var φ2 = Math.asin(Math.sin(φ1) * Math.cos(d) + Math.cos(φ1) * Math.sin(d) * Math.cos(brng));
                var λ2 = λ1 + Math.atan2(Math.sin(brng) * Math.sin(d) * Math.cos(φ1), Math.cos(d) - Math.sin(φ1) * Math.sin(φ2));
                var lat2 = φ2 * 180 / Math.PI;
                var lng2 = λ2 * 180 / Math.PI;
                if (lng2 > 180) lng2 -= 360;
                if (lng2 < -180) lng2 += 360;
                return [lat2, lng2];
            }

            /** حلقة مضلع قطاع التغطية (مركز + قوس) */
            function nmSectorRingLatLngs(lat, lng, directionDeg, spanDeg, rangeKm) {
                var steps = 36;
                if (!rangeKm || rangeKm <= 0 || !spanDeg || spanDeg <= 0) return null;
                if (spanDeg >= 359.5) {
                    return null;
                }
                var start = (directionDeg - spanDeg / 2 + 360) % 360;
                var ring = [[lat, lng]];
                for (var i = 0; i <= steps; i++) {
                    var b = (start + (spanDeg * i / steps) + 360) % 360;
                    ring.push(nmDestinationLatLng(lat, lng, b, rangeKm));
                }
                ring.push([lat, lng]);
                return ring;
            }

            function nmSectorTooltipHtml(s) {
                var name = (s.name || 'مرسل').replace(/</g, '&lt;');
                var pr = (s.packagesTotal != null) ? Number(s.packagesTotal) : 0;
                var dir = (s.direction != null) ? Math.round(Number(s.direction) * 10) / 10 : '—';
                var ang = (s.coverageAngle != null) ? Math.round(Number(s.coverageAngle) * 10) / 10 : '—';
                var rng = (s.coverageRange != null) ? Math.round(Number(s.coverageRange) * 100) / 100 : '—';
                return '<div class="nm-map-tip text-end" dir="rtl">' +
                    '<strong>' + name + '</strong><br/>' +
                    'الاتجاه: ' + dir + '° — زاوية التغطية: ' + ang + '° — مدى الانتشار: ' + rng + ' كم<br/>' +
                    'المستقبلات: ' + (s.receiverCount || 0) + ' — المشتركون: ' + (s.subscriberCount || 0) + '<br/>' +
                    'مجموع قيمة الباقات (مع الضريبة): ' + pr.toLocaleString('ar-SY', { maximumFractionDigits: 0 }) + ' ل.س' +
                    '</div>';
            }

            function nmBindSectorNavigate(layer, url) {
                if (!url) return;
                layer.on('click', function (e) {
                    if (e.originalEvent) {
                        L.DomEvent.stopPropagation(e.originalEvent);
                    }
                    window.location.href = url;
                });
            }

            function buildMap(payload) {
                var sectors = payload.sectors || [];
                var receivers = payload.receivers || [];
                var clients = payload.clients || [];
                var wrap = document.getElementById('nmCoverageMap');
                if (!wrap || typeof L === 'undefined') return;

                var latlngs = [];
                sectors.forEach(function (s) {
                    latlngs.push([s.lat, s.lng]);
                });
                receivers.forEach(function (r) {
                    latlngs.push([r.latitude, r.longitude]);
                });
                clients.forEach(function (c) {
                    latlngs.push([c.lat, c.lng]);
                });

                var center = [33.5138, 36.2765];
                var zoom = 10;
                if (latlngs.length) {
                    center = latlngs[0];
                    zoom = 12;
                }

                if (!nmMap) {
                    nmMap = L.map('nmCoverageMap', { scrollWheelZoom: true });
                    nmTileLayer = tileLayerForTheme();
                    nmTileLayer.addTo(nmMap);
                    nmSectorFansLayer = L.layerGroup().addTo(nmMap);
                    nmMarkersLayer = L.layerGroup().addTo(nmMap);
                } else {
                    if (nmTileLayer) { nmMap.removeLayer(nmTileLayer); }
                    nmTileLayer = tileLayerForTheme();
                    nmTileLayer.addTo(nmMap);
                    nmSectorFansLayer.clearLayers();
                    nmMarkersLayer.clearLayers();
                }

                nmMap.setView(center, zoom);

                var sectorOrange = '#f97316';
                var cc = chartColors();

                sectors.forEach(function (s) {
                    var url = s.detailsUrl || '';
                    var span = s.coverageAngle;
                    var rangeKm = s.coverageRange;
                    if (span >= 359.5 && rangeKm > 0) {
                        var radiusM = Math.max(80, rangeKm * 1000);
                        var circle = L.circle([s.lat, s.lng], {
                            radius: radiusM,
                            color: sectorOrange,
                            weight: 1,
                            fillColor: sectorOrange,
                            fillOpacity: 0.12
                        });
                        nmBindSectorNavigate(circle, url);
                        circle.bindTooltip(nmSectorTooltipHtml(s), { sticky: true, direction: 'top', opacity: 0.98, className: 'nm-sector-tooltip' });
                        nmSectorFansLayer.addLayer(circle);
                    } else {
                        var ring = nmSectorRingLatLngs(s.lat, s.lng, s.direction, span, rangeKm);
                        if (ring) {
                            var poly = L.polygon(ring, {
                                color: sectorOrange,
                                weight: 1,
                                fillColor: sectorOrange,
                                fillOpacity: 0.14
                            });
                            nmBindSectorNavigate(poly, url);
                            poly.bindTooltip(nmSectorTooltipHtml(s), { sticky: true, direction: 'top', opacity: 0.98, className: 'nm-sector-tooltip' });
                            nmSectorFansLayer.addLayer(poly);
                        }
                    }
                });

                receivers.forEach(function (r) {
                    var marker = L.marker([r.latitude, r.longitude], {
                        title: r.name
                    });
                    marker.bindPopup('<strong>مستقبل</strong><br>' + (r.name || '') + '<br>العملاء: ' + (r.clients || 0));
                    nmMarkersLayer.addLayer(marker);
                });

                clients.forEach(function (c) {
                    var marker = L.circleMarker([c.lat, c.lng], {
                        radius: 5,
                        color: cc.primary,
                        fillColor: cc.secondary,
                        fillOpacity: 0.65,
                        weight: 1
                    });
                    marker.bindPopup((c.name || '') + '');
                    nmMarkersLayer.addLayer(marker);
                });

                sectors.forEach(function (s) {
                    var url = s.detailsUrl || '';
                    var divIcon = L.divIcon({
                        className: 'nm-sector-marker-wrap',
                        html: '<div class="nm-sector-marker-dot"></div>',
                        iconSize: [26, 26],
                        iconAnchor: [13, 13]
                    });
                    var marker = L.marker([s.lat, s.lng], { icon: divIcon, title: s.name || '', zIndexOffset: 600 });
                    marker.bindTooltip(nmSectorTooltipHtml(s), { sticky: true, direction: 'top', opacity: 0.98, className: 'nm-sector-tooltip' });
                    nmBindSectorNavigate(marker, url);
                    nmMarkersLayer.addLayer(marker);
                });

                if (latlngs.length > 1) {
                    try {
                        nmMap.fitBounds(L.latLngBounds(latlngs), { padding: [28, 28], maxZoom: 14 });
                    } catch (e) { /* ignore */ }
                }

                setTimeout(function () { nmMap.invalidateSize(); }, 200);
            }

            function renderActivity(payload) {
                var ul = document.getElementById('nmActivityFeed');
                if (!ul) return;
                var items = payload.activity || [];
                if (!items.length) {
                    ul.innerHTML = '<li class="text-muted small border-0 bg-transparent">لا يوجد نشاط مسجّل حديثًا.</li>';
                    return;
                }
                ul.innerHTML = '';
                items.forEach(function (a) {
                    var li = document.createElement('li');
                    li.textContent = a.title;
                    var time = document.createElement('div');
                    time.className = 'nm-act-time';
                    time.textContent = new Date(a.at).toLocaleString('ar-SY');
                    li.appendChild(time);
                    ul.appendChild(li);
                });
            }

            function refreshFromTheme() {
                if (lastPayload) {
                    buildCharts(lastPayload);
                    buildMap(lastPayload);
                }
            }

            function loadInsights() {
                fetch(insightsUrl, { headers: { 'Accept': 'application/json' } })
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data.error) return;
                        lastPayload = data;
                        buildCharts(data);
                        buildMap(data);
                        renderActivity(data);
                        var leg = document.getElementById('nmMapLegend');
                        if (leg) {
                            var ns = (data.sectors && data.sectors.length) ? data.sectors.length : 0;
                            var nr = (data.receivers && data.receivers.length) ? data.receivers.length : 0;
                            var nc = (data.clients && data.clients.length) ? data.clients.length : 0;
                            leg.textContent = 'على الخريطة: ' + ns + ' مرسل، ' + nr + ' مستقبل، ' + nc + ' عميل';
                        }
                    })
                    .catch(function () {
                        var ul = document.getElementById('nmActivityFeed');
                        if (ul) ul.innerHTML = '<li class="text-danger small">تعذر تحميل بيانات اللوحة.</li>';
                    });
            }

            document.addEventListener('DOMContentLoaded', function () {
                loadInsights();
                var obs = new MutationObserver(function () {
                    refreshFromTheme();
                });
                obs.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
            });
        })();
    </script>
}

