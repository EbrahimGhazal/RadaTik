@model RadaTik.ViewModels.Sector.RadioEngineeringStudyViewModel

@{
    ViewData["Title"] = "الدراسة الهندسية للتحكم الراديوي";
}

<div class="radio-study-page">
    <div class="sys-hero mb-3">
        <div class="sys-hero-main">
            <h1 class="h4 mb-2"><i class="fas fa-tower-broadcast me-2 text-primary"></i>@ViewData["Title"]</h1>
            <p class="text-muted mb-0">تحليل جاهزية المشروع لتطبيق مراقبة/تحكم القطاعات عبر سيناريوهات تشغيلية آمنة.</p>
        </div>
        <div class="sys-hero-actions d-flex gap-2">
            <a asp-route="networkManager-sector" asp-route-action="RadioMonitoring" class="btn btn-outline-primary btn-sm">
                <i class="fas fa-wave-square"></i> فتح المراقبة
            </a>
            <a asp-route="networkManager-sector" asp-route-action="Index" class="btn btn-outline-secondary btn-sm">
                <i class="fas fa-arrow-right"></i> العودة للقطاعات
            </a>
        </div>
    </div>

    <div class="row g-2 mb-3">
        <div class="col-6 col-lg-2">
            <div class="card rs-stat h-100"><div class="card-body"><small>إجمالي القطاعات</small><div class="v">@Model.TotalSectors</div></div></div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="card rs-stat h-100"><div class="card-body"><small>القطاعات النشطة</small><div class="v text-success">@Model.ActiveSectors</div></div></div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="card rs-stat h-100"><div class="card-body"><small>جاهزية أولية</small><div class="v text-primary">@Model.ReadySectors</div></div></div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="card rs-stat h-100"><div class="card-body"><small>بدون IP إدارة</small><div class="v text-warning">@Model.MissingIpSectors</div></div></div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="card rs-stat h-100"><div class="card-body"><small>بدون سيرفر</small><div class="v text-danger">@Model.MissingServerSectors</div></div></div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="card rs-stat h-100"><div class="card-body"><small>سيرفر غير نشط</small><div class="v text-danger">@Model.InactiveServersLinkedSectors</div></div></div>
        </div>
    </div>

    <div class="row g-3 mb-3">
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header"><strong>توزيع عائلات السيرفرات</strong></div>
                <div class="card-body">
                    @if (Model.ServerProfiles.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var s in Model.ServerProfiles)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@s.Name</span><span class="badge bg-primary-subtle text-primary-emphasis">@s.Count</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-muted">لا توجد بيانات.</div>
                    }
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header"><strong>توزيع عائلات القطاعات</strong></div>
                <div class="card-body">
                    @if (Model.SectorFamilies.Any())
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var s in Model.SectorFamilies)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@s.Name</span><span class="badge bg-info-subtle text-info-emphasis">@s.Count</span>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-muted">لا توجد بيانات.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header"><strong>السيناريوهات التشغيلية المقترحة</strong></div>
        <div class="card-body">
            <div class="row g-3">
                @foreach (var s in Model.Scenarios)
                {
                    <div class="col-12 col-lg-4">
                        <div class="rs-scenario h-100">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="mb-0">@s.Name</h6>
                                <span class="badge @(s.RiskLevel == "مرتفع" ? "bg-danger" : s.RiskLevel == "متوسط" ? "bg-warning text-dark" : "bg-success")">@s.RiskLevel</span>
                            </div>
                            <p class="mb-1"><strong>الهدف:</strong> @s.Goal</p>
                            <p class="mb-1"><strong>المتطلبات:</strong> @s.Preconditions</p>
                            <p class="mb-1"><strong>التدفق:</strong> @s.ExecutionFlow</p>
                            <p class="mb-0"><strong>KPI:</strong> @s.SuccessKpi</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header"><strong>خارطة التنفيذ المرحلية</strong></div>
        <div class="card-body">
            @foreach (var p in Model.Phases)
            {
                <div class="rs-phase mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="mb-0">@p.Name</h6>
                        <span class="badge bg-secondary">@p.TimeEstimate</span>
                    </div>
                    <ul class="mb-2">
                        @foreach (var t in p.Tasks)
                        {
                            <li>@t</li>
                        }
                    </ul>
                    <div class="small text-muted"><strong>المخرج:</strong> @p.Output</div>
                </div>
            }
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header"><strong>ضوابط المخاطر الإلزامية</strong></div>
                <div class="card-body">
                    <ul class="mb-0">
                        @foreach (var r in Model.RiskControls)
                        {
                            <li>@r</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header"><strong>إرشادات الأداء</strong></div>
                <div class="card-body">
                    <ul class="mb-0">
                        @foreach (var g in Model.PerformanceGuidelines)
                        {
                            <li>@g</li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
