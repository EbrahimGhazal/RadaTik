@using RadaTik.Services
@{
    ViewData["Title"] = "تقارير ERP";
    var reports = ViewBag.Reports as ErpReportsData;
    var fromDate = ViewBag.FromDate as string ?? "";
    var toDate = ViewBag.ToDate as string ?? "";
}

<div class="financial-page financial-hub-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h4 mb-0"><i class="fas fa-chart-bar me-1"></i> تقارير ERP</h1>
        <a class="btn btn-outline-secondary btn-sm" asp-route="networkManager-erp">لوحة ERP</a>
    </div>

    <form method="get" class="row g-2 align-items-end mb-4">
        <div class="col-auto">
            <label class="form-label small mb-0">من</label>
            <input type="date" name="fromDate" class="form-control form-control-sm" value="@fromDate" />
        </div>
        <div class="col-auto">
            <label class="form-label small mb-0">إلى</label>
            <input type="date" name="toDate" class="form-control form-control-sm" value="@toDate" />
        </div>
        <div class="col-auto">
            <button type="submit" class="btn btn-primary btn-sm"><i class="fas fa-filter"></i> تطبيق</button>
        </div>
    </form>

    @if (reports != null)
    {
        <section class="mb-4">
            <h2 class="h6 text-muted mb-2"><i class="fas fa-handshake me-1"></i> المبيعات حسب عميل ERP</h2>
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>العميل</th>
                            <th>عدد الفواتير</th>
                            <th>إجمالي المبيعات</th>
                            <th>غير مسدّد</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (reports.SalesByCustomer.Count == 0)
                    {
                        <tr><td colspan="4" class="text-muted text-center">لا توجد مبيعات في الفترة المحددة</td></tr>
                    }
                    @foreach (var row in reports.SalesByCustomer)
                    {
                        <tr>
                            <td>@row.CustomerName</td>
                            <td>@row.InvoiceCount</td>
                            <td>@row.TotalAmount.ToString("N0")</td>
                            <td class="@(row.UnpaidAmount > 0 ? "text-danger" : "")">@row.UnpaidAmount.ToString("N0")</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h2 class="h6 text-muted mb-0"><i class="fas fa-file-invoice-dollar me-1"></i> ذمم مدينة (فواتير بيع غير مسدّدة)</h2>
                <span class="badge bg-danger">@reports.UnpaidSalesGrandTotal.ToString("N0") إجمالي</span>
            </div>
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>التاريخ</th>
                            <th>العميل</th>
                            <th>المبلغ</th>
                            <th>أيام التأخير</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (reports.UnpaidSales.Count == 0)
                    {
                        <tr><td colspan="5" class="text-muted text-center">لا توجد فواتير غير مسدّدة</td></tr>
                    }
                    @foreach (var row in reports.UnpaidSales)
                    {
                        <tr>
                            <td>@row.InvoiceId</td>
                            <td>@row.InvoiceDate.ToString("yyyy-MM-dd")</td>
                            <td>@row.CustomerName</td>
                            <td>@row.TotalAmount.ToString("N0") @row.Currency</td>
                            <td>
                                @if (row.DaysOutstanding > 30)
                                {
                                    <span class="badge bg-danger">@row.DaysOutstanding</span>
                                }
                                else if (row.DaysOutstanding > 7)
                                {
                                    <span class="badge bg-warning text-dark">@row.DaysOutstanding</span>
                                }
                                else
                                {
                                    @row.DaysOutstanding
                                }
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>

        <section>
            <h2 class="h6 text-muted mb-2"><i class="fas fa-user-check me-1"></i> أداء الموظفين (مهام ومكافآت)</h2>
            <div class="table-responsive">
                <table class="table table-sm table-hover">
                    <thead class="table-light">
                        <tr>
                            <th>الموظف</th>
                            <th>إجمالي المهام</th>
                            <th>مكتملة</th>
                            <th>مفتوحة</th>
                            <th>متأخرة</th>
                            <th>مكافآت</th>
                            <th>عقوبات</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (reports.EmployeePerformance.Count == 0)
                    {
                        <tr><td colspan="7" class="text-muted text-center">لا توجد مهام مسجّلة</td></tr>
                    }
                    @foreach (var row in reports.EmployeePerformance)
                    {
                        <tr>
                            <td>@row.EmployeeName</td>
                            <td>@row.TotalTasks</td>
                            <td>@row.CompletedTasks</td>
                            <td>@row.OpenTasks</td>
                            <td>
                                @if (row.OverdueTasks > 0)
                                {
                                    <span class="badge bg-danger">@row.OverdueTasks</span>
                                }
                                else
                                {
                                    @row.OverdueTasks
                                }
                            </td>
                            <td>@row.RewardsCount</td>
                            <td>@row.PenaltiesCount</td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>
