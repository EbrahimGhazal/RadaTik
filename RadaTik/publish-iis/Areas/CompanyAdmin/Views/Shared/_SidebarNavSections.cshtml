@using RadaTik.Security
@using RadaTik.Helpers
@using RadaTik.Data
@using RadaTik.Models
@using Microsoft.EntityFrameworkCore
@inject RadaTik.Services.IFeatureAccessService FeatureAccess
@inject ApplicationDbContext Db
@inject Microsoft.AspNetCore.Identity.UserManager<ApplicationUser> UserManager
@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var currentType = ViewContext.HttpContext.Request.Query["type"].ToString();
    if (string.IsNullOrWhiteSpace(currentType))
    {
        currentType = ViewContext.RouteData.Values["type"]?.ToString() ?? "";
    }

    var canUseNetworks = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Networks);
    var canUseMikroTikServers = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.MikroTikServers);
    var canUseProfiles = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Profiles);
    var canUseUsers = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Users);
    var canUseClients = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Clients);
    var canUseSectors = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Sectors);
    var canUseReceivers = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Receivers);
    var canUseRequests = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Requests);
    var canUseReports = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Reports);
    var canUseWarehouse = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Warehouse);
    var canUseMoneyDiary = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.MoneyDiary);
    var canUsePayroll = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Payroll);
    var canUseErp = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Erp);

    var pendingEmployeeApprovalsCount = 0;
    try
    {
        var currentUser = await UserManager.GetUserAsync(User);
        var selectedNetworkId = NetworkHelper.GetCurrentNetworkId(ViewContext.HttpContext, Db, currentUser);
        if (selectedNetworkId.HasValue)
        {
            var selectedNetwork = await Db.Networks.AsNoTracking()
                .Where(n => n.Id == selectedNetworkId.Value)
                .Select(n => new { n.ParentNetworkId })
                .FirstOrDefaultAsync();
            var companyNetworkId = selectedNetwork?.ParentNetworkId ?? selectedNetworkId.Value;
            var companyScope = await PricingChargeHelper.GetCompanyScopeNetworkIdsAsync(Db, companyNetworkId);
            pendingEmployeeApprovalsCount = await Db.NetworkServiceRequests.AsNoTracking()
                .Where(r => companyScope.Contains(r.NetworkId) &&
                            r.Status == NetworkServiceRequestStatus.Pending &&
                            ((r.Notes != null && r.Notes.StartsWith("EMP_REQ:")) ||
                             (r.Notes != null && r.Notes.Contains("SECTOR_CREATE_PENDING:"))))
                .CountAsync();
        }
    }
    catch { /* stable sidebar */ }

    var customServicesMenu = new List<SystemService>();
    try
    {
        customServicesMenu = await Db.SystemServices.AsNoTracking()
            .Where(s => s.IsActive && s.Key.StartsWith("CUSTOM:"))
            .OrderBy(s => s.DisplayName)
            .ToListAsync();
    }
    catch { /* stable sidebar */ }

    var hasCompanyBooks = canUseWarehouse || canUseMoneyDiary || canUsePayroll;
    var hasInfrastructure = canUseNetworks || canUseProfiles || canUseMikroTikServers || canUseSectors || canUseReceivers;

    var subscribersOpen = controller is "Clients" or "NewSubscriberWizard"
        or "SubscriberInstallationPricing" or "SubscriberInstallationInvoices" or "PrivateSubscriberSetup";
    var supportOpen = controller is "RequestsManagement" or "EmployeeServiceApprovals" or "MaintenanceInvoices" or "MaintenancePricing";
    var infraOpen = controller is "Network" or "Profile" or "MikroTikServers" or "MikroTikTraffic" or "Sector" or "Receiver";
    var mikrotikOpen = controller is "MikroTikServers" or "MikroTikTraffic";
    var sectorsOpen = controller == "Sector";
    var financeOpen = controller is "Wallet" or "ClientWalletTopUpRequests" or "CashBox" or "Receipts"
        or "CompanyBusiness" or "Warehouse" or "MaterialPurchaseInvoices" or "MaterialSalesInvoices"
        or "WarehouseStocktake" or "MoneyDiary" or "Payroll" or "FinancialReconciliation" or "RenewalRequests";
    var financeWalletOpen = controller is "Wallet" or "ClientWalletTopUpRequests";
    var financeCashOpen = controller is "CashBox" or "Receipts";
    var financeBooksOpen = controller is "CompanyBusiness" or "Warehouse" or "MaterialPurchaseInvoices"
        or "MaterialSalesInvoices" or "WarehouseStocktake" or "MoneyDiary" or "Payroll" or "FinancialReconciliation";
    var erpOpen = controller is "ErpHub" or "ErpCustomers" or "ErpSuppliers" or "CompanyEmployeeTasks"
        or "EmployeeRewardPenalties" or "CompanyAccounting" or "ErpReports";
    var maintenanceOpen = controller == "MaintenanceInvoices" || (controller == "RequestsManagement" && action == "MaintenanceRequests") || controller == "MaintenancePricing";
    var teamOpen = controller == "Admin";
}

