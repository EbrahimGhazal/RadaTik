@using RadaTik.Models.Business
@model IEnumerable<CompanyEmployeeTask>
@{
    ViewData["Title"] = "مهام الموظفين";
    var statusFilter = ViewBag.StatusFilter as CompanyEmployeeTaskStatus?;
    string StatusLabel(CompanyEmployeeTaskStatus s) => s switch
    {
        CompanyEmployeeTaskStatus.Pending => "معلّقة",
        CompanyEmployeeTaskStatus.InProgress => "قيد التنفيذ",
        CompanyEmployeeTaskStatus.Completed => "مكتملة",
        CompanyEmployeeTaskStatus.Cancelled => "ملغاة",
        _ => s.ToString()
    };
}

<div class="financial-page financial-hub-page">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h4 mb-0"><i class="fas fa-tasks me-1"></i> مهام الموظفين</h1>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary btn-sm" asp-route="networkManager-erp">ERP</a>
            <a class="btn btn-primary btn-sm" asp-action="Create"><i class="fas fa-plus"></i> مهمة جديدة</a>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>المهمة</th>
                    <th>الموظف</th>
                    <th>الأولوية</th>
                    <th>الحالة</th>
                    <th>الاستحقاق</th>
                    <th>إجراء</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var t in Model)
            {
                <tr>
                    <td>@t.Title</td>
                    <td>@(t.AssignedToUser?.FullName ?? t.AssignedToUser?.UserName)</td>
                    <td>@t.Priority</td>
                    <td>@StatusLabel(t.Status)</td>
                    <td>@(t.DueDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                    <td>
                        @if (t.Status != CompanyEmployeeTaskStatus.Completed && t.Status != CompanyEmployeeTaskStatus.Cancelled)
                        {
                            <form asp-action="UpdateStatus" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@t.Id" />
                                <input type="hidden" name="status" value="@((int)CompanyEmployeeTaskStatus.Completed)" />
                                <button type="submit" class="btn btn-sm btn-success">إنجاز</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
