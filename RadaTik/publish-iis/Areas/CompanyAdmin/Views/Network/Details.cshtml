<div class="radtk-page--companyadmin-views-network-details">
<div class="radtk-page--companyadmin-views-network-details">
@model RadaTik.Models.Network

@{
    ViewData["Title"] = "تفاصيل الشبكة";
    var isSysAdmin = (bool)(ViewBag.IsSystemAdmin ?? false);
    var managerName = ViewBag.ManagerName as string ?? "-";
    var mainBalance = (decimal)(ViewBag.MainBalance ?? 0m);
    var mainNetworkId = Model.ParentNetworkId ?? Model.Id;

    if (isSysAdmin)
    {
        Layout = "~/Areas/SystemAdmin/Views/Shared/_Layout.cshtml";
    }
    ViewBag.PageHeroIcon = "fas fa-info-circle";
    ViewBag.PageHeroSubtitle = Model.Name;
    ViewBag.PageHeroBackUrl = Url.Action("Index");
}

<partial name="_CrudPageHero" />

<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">معلومات الشبكة</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-4">اسم الشبكة:</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">المحافظات:</dt>
                    <dd class="col-sm-8">
                        @if (!string.IsNullOrEmpty(Model.Governorates))
                        {
                            <div style="white-space: pre-line;">@Model.Governorates</div>
                        }
                        else
                        {
                            <span class="text-muted">غير محدد</span>
                        }
                    </dd>

                    <dt class="col-sm-4">تاريخ الإنشاء:</dt>
                    <dd class="col-sm-8">@Model.CreationDate.ToString("yyyy/MM/dd HH:mm")</dd>

                    <dt class="col-sm-4">حالة الشبكة:</dt>
                    <dd class="col-sm-8">
                        @if (Model.Status == NetworkStatus.Active)
                        {
                            <span class="badge bg-success">نشط</span>
                        }
                        else if (Model.Status == NetworkStatus.Inactive)
                        {
                            <span class="badge bg-danger">@(isSysAdmin ? "مجمد" : "معطل")</span>
                        }
                        else
                        {
                            <span class="badge bg-warning">قيد الإنشاء</span>
                        }
                    </dd>

                    @if (isSysAdmin)
                    {
                        <dt class="col-sm-4">مدير الشركة:</dt>
                        <dd class="col-sm-8">@managerName</dd>
                        <dt class="col-sm-4">رصيد الشبكة:</dt>
                        <dd class="col-sm-8"><strong class="text-primary">@SyrianCurrencyHelper.FormatNew(mainBalance)</strong></dd>
                    }

                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <dt class="col-sm-4">ملاحظات:</dt>
                        <dd class="col-sm-8">
                            <div style="white-space: pre-line;">@Model.Notes</div>
                        </dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">شعار الشبكة</h5>
            </div>
            <div class="card-body text-center">
                @if (!string.IsNullOrEmpty(Model.LogoPath))
                {
                    <img src="@Model.LogoPath" alt="شعار الشبكة" class="img-fluid rounded" style="max-height: 200px;" />
                }
                else
                {
                    <div class="text-muted">
                        <i class="fas fa-image fa-3x mb-3"></i>
                        <p>لا يوجد شعار</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h5 class="card-title mb-0">
                    <i class="fas fa-chart-bar"></i>
                    إحصائيات الشبكة
                </h5>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-3 mb-3">
                        <div class="stat-card">
                            <div class="stat-icon bg-primary">
                                <i class="fas fa-server"></i>
                            </div>
                            <div class="stat-value">@ViewBag.TotalServers</div>
                            <div class="stat-label">إجمالي المخدمات</div>
                            <small class="text-success">@ViewBag.ActiveServers نشط</small>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="stat-card">
                            <div class="stat-icon bg-info">
                                <i class="fas fa-broadcast-tower"></i>
                            </div>
                            <div class="stat-value">@ViewBag.TotalSectors</div>
                            <div class="stat-label">إجمالي القطاعات</div>
                            <small class="text-success">@ViewBag.ActiveSectors نشط</small>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="stat-card">
                            <div class="stat-icon bg-warning">
                                <i class="fas fa-satellite-dish"></i>
                            </div>
                            <div class="stat-value">@ViewBag.TotalReceivers</div>
                            <div class="stat-label">إجمالي المستقبلات</div>
                            <small class="text-success">@ViewBag.ActiveReceivers نشط</small>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="stat-card">
                            <div class="stat-icon bg-success">
                                <i class="fas fa-users"></i>
                            </div>
                            <div class="stat-value">@ViewBag.TotalClients</div>
                            <div class="stat-label">إجمالي العملاء</div>
                            <small class="text-success">@ViewBag.ActiveClients نشط</small>
                        </div>
                    </div>
                    <div class="col-md-3 mb-3">
                        <div class="stat-card">
                            <div class="stat-icon bg-secondary">
                                <i class="fas fa-tags"></i>
                            </div>
                            <div class="stat-value">@ViewBag.TotalProfiles</div>
                            <div class="stat-label">إجمالي البروفايلات</div>
                            <small class="text-success">@ViewBag.ActiveProfiles نشط</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="mt-4 d-flex flex-wrap gap-2">
    @if (!isSysAdmin)
    {
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
            <i class="fas fa-edit"></i>
            تعديل الشبكة
        </a>
    }
    @if (isSysAdmin)
    {
        <a asp-action="AddBalance" asp-route-id="@mainNetworkId" class="btn btn-success">
            <i class="fas fa-plus-circle"></i>
            إضافة رصيد
        </a>
    }
    <a asp-action="Index" class="btn btn-secondary">
        <i class="fas fa-arrow-right"></i>
        العودة
    </a>
</div>
