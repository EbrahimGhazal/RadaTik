@model RadaTik.ViewModels.Admin.DeleteEmployeeViewModel

@{
    ViewData["Title"] = "حذف موظف";
}

<div class="employee-delete-hero card border-0 shadow-sm mb-3">
    <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h1 class="mb-1 employee-delete-title">
                <i class="fas fa-user-times"></i>
                @ViewData["Title"]
            </h1>
            <p class="text-muted mb-0">هذا الإجراء لا يمكن التراجع عنه.</p>
        </div>
        <div class="d-flex gap-2">
            <a class="btn btn-outline-secondary"
               href="@(string.IsNullOrWhiteSpace(Model.ReturnUrl) ? (Url.RouteUrl("networkManager-users-employees") ?? "/networkManager/Users/Employee") : Model.ReturnUrl)">
                <i class="fas fa-arrow-right"></i> رجوع
            </a>
        </div>
    </div>
</div>

<div class="alert alert-warning border-0 shadow-sm employee-delete-note" role="alert">
    <i class="fas fa-triangle-exclamation me-2"></i>
    سيتم حذف حساب المستخدم وصلاحياته من قاعدة البيانات فقط، بدون تنفيذ أي إجراء مباشر على MikroTik.
</div>

<div class="card border-0 shadow-sm employee-delete-card">
    <div class="card-body">
        <div class="alert alert-warning border-0 employee-delete-warning">
            <div class="fw-bold mb-1">تأكيد حذف الموظف</div>
            <div>سيتم حذف حساب الموظف نهائياً مع صلاحياته.</div>
        </div>

        <dl class="row mb-0">
            <dt class="col-sm-3">اسم المستخدم</dt>
            <dd class="col-sm-9">@Model.UserName</dd>

            <dt class="col-sm-3">الاسم الكامل</dt>
            <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.FullName) ? Model.FullName : "-")</dd>

            <dt class="col-sm-3">البريد الإلكتروني</dt>
            <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.Email) ? Model.Email : "-")</dd>

            <dt class="col-sm-3">رقم الجوال</dt>
            <dd class="col-sm-9">@(!string.IsNullOrWhiteSpace(Model.PhoneNumber) ? Model.PhoneNumber : "-")</dd>

            <dt class="col-sm-3">الحالة</dt>
            <dd class="col-sm-9">
                @if (Model.IsActive)
                {
                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">نشط</span>
                }
                else
                {
                    <span class="badge bg-secondary-subtle text-secondary-emphasis border border-secondary-subtle">مجمّد</span>
                }
            </dd>
        </dl>

        <hr />

        <form asp-area="CompanyAdmin" asp-controller="Admin" asp-action="DeleteEmployeeConfirmed" method="post" class="d-flex gap-2 justify-content-end">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="ReturnUrl" />

            <a class="btn btn-outline-secondary"
               href="@(string.IsNullOrWhiteSpace(Model.ReturnUrl) ? (Url.RouteUrl("networkManager-users-employees") ?? "/networkManager/Users/Employee") : Model.ReturnUrl)">
                إلغاء
            </a>
            <button type="submit" class="btn btn-danger employee-delete-btn"
                    onclick="return confirm('تأكيد نهائي: هل تريد حذف الموظف نهائياً؟');">
                <i class="fas fa-trash"></i> حذف نهائي
            </button>
        </form>
    </div>
</div>

<style>
    .employee-delete-hero {
        background: linear-gradient(135deg, #fff7f7 0%, #fff1f2 100%);
    }

    .employee-delete-title {
        color: #b42318;
        font-weight: 700;
    }

    .employee-delete-note {
        background: linear-gradient(135deg, #fff7ed 0%, #fffbeb 100%);
        color: #7c2d12;
    }

    .employee-delete-card {
        border: 1px solid #ffe4e6;
    }

    .employee-delete-warning {
        background: #fff7ed;
        color: #9a3412;
    }

    .employee-delete-btn {
        border-radius: 0.65rem;
        font-weight: 600;
    }
</style>

