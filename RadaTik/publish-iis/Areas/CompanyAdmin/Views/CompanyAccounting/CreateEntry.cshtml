@model RadaTik.Models.Business.JournalEntry
@{
    ViewData["Title"] = "قيد محاسبي جديد";
    var accountsSelect = ViewBag.AccountsSelect as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}

<div class="financial-page financial-hub-page col-lg-10">
    <h1 class="h4 mb-3">قيد محاسبي جديد</h1>
    <form asp-action="CreateEntry" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger"></div>
        <div class="row g-3 mb-3">
            <div class="col-md-4">
                <label asp-for="EntryDate" class="form-label">التاريخ</label>
                <input asp-for="EntryDate" type="date" class="form-control" required />
            </div>
            <div class="col-md-8">
                <label asp-for="Description" class="form-label">الوصف</label>
                <input asp-for="Description" class="form-control" required />
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="ReferenceNumber" class="form-label">رقم مرجعي</label>
            <input asp-for="ReferenceNumber" class="form-control" />
        </div>

        <h2 class="h6">سطور القيد (مدين / دائن)</h2>
        @for (int i = 0; i < 4; i++)
        {
            <div class="row g-2 mb-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label small">الحساب</label>
                    <select name="accountIds" class="form-select form-select-sm">
                        <option value="0">—</option>
                        @foreach (var opt in accountsSelect)
                        {
                            <option value="@opt.Value">@opt.Text</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small">مدين</label>
                    <input name="debits" type="number" step="0.01" min="0" class="form-control form-control-sm" value="0" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small">دائن</label>
                    <input name="credits" type="number" step="0.01" min="0" class="form-control form-control-sm" value="0" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">ملاحظة</label>
                    <input name="lineDescriptions" type="text" class="form-control form-control-sm" />
                </div>
            </div>
        }

        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary">حفظ مسودة</button>
            <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
        </div>
    </form>
</div>
