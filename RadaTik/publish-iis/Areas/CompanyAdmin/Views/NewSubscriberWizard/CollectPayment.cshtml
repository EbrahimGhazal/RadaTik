@using RadaTik.Models
@model RadaTik.Areas.CompanyAdmin.ViewModels.NewSubscriberWizardCollectPaymentViewModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? "CompanyAdmin";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fas fa-hand-holding-usd text-primary"></i> @ViewData["Title"]</h2>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="card mb-3">
    <div class="card-body">
        <div><strong>المشترك:</strong> @Model.ClientName</div>
        <div class="row g-2 mt-2">
            <div class="col-md-4"><span class="text-muted small">إجمالي الفاتورة</span><div class="fw-semibold d-block">@Model.TotalAmount.ToString("N0") ل.س</div></div>
            <div class="col-md-4"><span class="text-muted small">المتبقي</span><div class="fw-semibold text-danger d-block">@Model.RemainingAmount.ToString("N0") ل.س</div></div>
            <div class="col-md-4"><span class="text-muted small">رصيد محفظة المشترك</span><div class="fw-semibold d-block">@Model.ClientWalletBalance.ToString("N0") ل.س</div></div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header">الخطوة 4 — تحصيل المبلغ</div>
    <div class="card-body">
        <form asp-action="CollectPayment" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="invoiceId" value="@Model.InvoiceId" />
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label">المبلغ</label>
                    <input type="number" step="0.01" min="0.01" name="amount" class="form-control" required
                           value="@Model.RemainingAmount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)"
                           max="@Model.RemainingAmount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">طريقة التحصيل</label>
                    <select name="paymentMethod" class="form-select">
                        <option value="@((int)SubscriberInstallationPaymentMethod.Wallet)">محفظة التطبيق</option>
                        <option value="@((int)SubscriberInstallationPaymentMethod.Cash)">نقدي (دفتر إيراد)</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">ملاحظات</label>
                    <input type="text" name="notes" class="form-control" maxlength="500" />
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">تسجيل التحصيل</button>
                </div>
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Complete" asp-route-invoiceId="@Model.InvoiceId" asp-route-paymentRecorded="false" class="btn btn-outline-secondary">
        تخطي التحصيل الآن
    </a>
</div>
