@model RadaTik.ViewModels.CompanyAdmin.CompanyServicesIndexViewModel
@using RadaTik.Helpers
@{
    ViewData["Title"] = ViewData["Title"] ?? "الخدمات والاشتراكات";

    var services = Model.Services ?? new List<RadaTik.ViewModels.CompanyAdmin.CompanyServiceItemViewModel>();
    var categories = services
        .Select(s => s.Category ?? "")
        .Where(s => !string.IsNullOrWhiteSpace(s))
        .Distinct()
        .OrderBy(s => s)
        .ToList();

    var countActive = services.Count(s => s.HasActiveSubscription);
    var countPending = services.Count(s => s.HasPendingRequest && !s.HasActiveSubscription);
    var countInactive = services.Count(s => !s.HasActiveSubscription && !s.HasPendingRequest);
    var highlightedFeatureKey = (Context.Request.Query["highlight"].ToString() ?? "").Trim();

    string CategoryIcon(string? category) => (category ?? "").Trim() switch
    {
        "الأمان" => "fas fa-shield-halved",
        "المالية" => "fas fa-wallet",
        "طلبات" => "fas fa-file-circle-check",
        "المشتركين" => "fas fa-users",
        "القطاعات" => "fas fa-sitemap",
        "اللاقطات" => "fas fa-satellite-dish",
        "الخوادم" => "fas fa-server",
        "إدارة الشركة" => "fas fa-building",
        "خدمات مخصصة" => "fas fa-star",
        _ => "fas fa-puzzle-piece"
    };
}

<div class="company-features features-hub">
    <div class="sys-hero features-hub-hero mb-3">
        <div class="sys-hero-main">
            <div class="sys-hero-icon"><i class="fas fa-layer-group"></i></div>
            <div>
                <h1 class="sys-hero-title">@ViewData["Title"]</h1>
                <p class="sys-hero-subtitle mb-0">
                    اطلب تفعيل الخدمات من الخطط المعتمدة. يُخصم المبلغ من محفظة الشركة بانتظار موافقة مدير النظام،
                    ويُسترد تلقائياً عند الرفض.
                </p>
            </div>
        </div>
        <div class="sys-hero-chips">
            <span class="sys-hero-chip"><i class="fas fa-bolt"></i> إجمالي الخدمات: @services.Count</span>
            <span class="sys-hero-chip"><i class="fas fa-circle-check"></i> مفعّلة: @countActive</span>
            <span class="sys-hero-chip"><i class="fas fa-hourglass-half"></i> معلّقة: @countPending</span>
            <span class="sys-hero-chip"><i class="fas fa-wallet"></i> الرصيد: @Model.CompanyBalance.ToString("N0") ل.س.ج</span>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle ms-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-triangle-exclamation ms-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
        </div>
    }
    @if (TempData["Info"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="fas fa-circle-info ms-2"></i>@TempData["Info"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
        </div>
    }

    <div class="row g-3 mb-3 features-hub-stats">
        <div class="col-6 col-lg-4">
            <button type="button" class="card features-hub-stat-card p-3" data-hub-status="active" aria-label="تصفية المفعّلة">
                <div class="d-flex justify-content-between align-items-center gap-2">
                    <div>
                        <div class="text-muted small">مفعّلة</div>
                        <div class="fs-4 fw-bold text-body">@countActive</div>
                    </div>
                    <div class="stat-icon"><i class="fas fa-circle-check"></i></div>
                </div>
            </button>
        </div>
        <div class="col-6 col-lg-4">
            <button type="button" class="card features-hub-stat-card p-3" data-hub-status="pending" aria-label="تصفية المعلّقة">
                <div class="d-flex justify-content-between align-items-center gap-2">
                    <div>
                        <div class="text-muted small">بانتظار الموافقة</div>
                        <div class="fs-4 fw-bold text-body">@countPending</div>
                    </div>
                    <div class="stat-icon"><i class="fas fa-hourglass-half"></i></div>
                </div>
            </button>
        </div>
        <div class="col-6 col-lg-4">
            <button type="button" class="card features-hub-stat-card p-3" data-hub-status="inactive" aria-label="تصفية غير المفعّلة">
                <div class="d-flex justify-content-between align-items-center gap-2">
                    <div>
                        <div class="text-muted small">غير مفعّلة</div>
                        <div class="fs-4 fw-bold text-body">@countInactive</div>
                    </div>
                    <div class="stat-icon"><i class="fas fa-lock"></i></div>
                </div>
            </button>
        </div>
    </div>

    <div class="card features-hub-context border-0 shadow-sm mb-3">
        <div class="card-body p-3 p-md-4">
            <div class="row g-4 align-items-center">
                <div class="col-lg-8">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="features-hub-context-item">
                                <div class="features-hub-context-icon"><i class="fas fa-network-wired"></i></div>
                                <div>
                                    <div class="text-muted small mb-1">الشبكة المحددة</div>
                                    <div class="fw-bold">@Model.SelectedNetworkName <span class="text-muted fw-normal">(#@Model.SelectedNetworkId)</span></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="features-hub-context-item">
                                <div class="features-hub-context-icon"><i class="fas fa-building"></i></div>
                                <div>
                                    <div class="text-muted small mb-1">مصدر الخدمات (الشركة)</div>
                                    <div class="fw-bold">@Model.EffectiveCompanyNetworkName <span class="text-muted fw-normal">(#@Model.EffectiveCompanyNetworkId)</span></div>
                                    @if (Model.SelectedNetworkId != Model.EffectiveCompanyNetworkId)
                                    {
                                        <div class="text-muted small mt-1">الشبكات الفرعية ترث خدمات الشركة الرئيسية.</div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <div class="text-muted small mb-1">رصيد المحفظة</div>
                    <div class="fs-5 fw-bold text-primary mb-1">@Model.CompanyBalance.ToString("N0") ل.س.ج</div>
                    <a asp-area="CompanyAdmin" asp-controller="Wallet" asp-action="TopUp" class="btn btn-sm btn-outline-primary">تعبئة الرصيد</a>
                </div>
            </div>
        </div>
    </div>

    <div class="card features-hub-services-card border-0 shadow-sm">
        <div class="card-header company-features-toolbar py-3">
            <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3 w-100">
                <h3 class="card-title mb-0">
                    <i class="fas fa-list-check text-primary ms-2"></i>
                    قائمة الخدمات
                </h3>
                <div class="company-features-toolbar-actions">
                    <div class="company-features-filters">
                        <button type="button" class="company-filter-pill is-active" data-status="all">
                            الكل <span class="count">@services.Count</span>
                        </button>
                        <button type="button" class="company-filter-pill" data-status="active">
                            مفعّلة <span class="count">@countActive</span>
                        </button>
                        <button type="button" class="company-filter-pill" data-status="pending">
                            معلّقة <span class="count">@countPending</span>
                        </button>
                        <button type="button" class="company-filter-pill" data-status="inactive">
                            غير مفعّلة <span class="count">@countInactive</span>
                        </button>
                    </div>

                    <select id="companyFeaturesCategory" class="form-select form-select-sm company-features-category">
                        <option value="">كل التصنيفات</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c">@c</option>
                        }
                    </select>

                    <select id="companyFeaturesSort" class="form-select form-select-sm company-features-sort">
                        <option value="nameAsc">ترتيب: الاسم (أ-ي)</option>
                        <option value="nameDesc">ترتيب: الاسم (ي-أ)</option>
                        <option value="status">ترتيب: الحالة</option>
                    </select>

                    <div class="input-group input-group-sm company-features-search">
                        <span class="input-group-text"><i class="fas fa-search"></i></span>
                        <input id="companyFeaturesSearch" type="text" class="form-control"
                               placeholder="بحث: اسم الخدمة / المفتاح / الوصف / التصنيف" autocomplete="off" />
                        <button class="btn btn-outline-secondary" type="button" id="companyFeaturesSearchClear" title="مسح">
                            <i class="fas fa-xmark"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <div class="card-body pt-2">
            <div class="company-features-grid" id="companyFeaturesGrid">
                @if (services == null || !services.Any())
                {
                    <div class="company-features-empty text-muted">
                        لا توجد خدمات للعرض.
                    </div>
                }
                else
                {
                    foreach (var s in services)
                    {
                        string statusText;
                        string statusClass;
                        string statusKey;
                        string statusBadgeClass;

                        if (s.HasActiveSubscription)
                        {
                            statusText = "مفعّلة";
                            statusClass = "is-active";
                            statusKey = "active";
                            statusBadgeClass = "bg-success";
                        }
                        else if (s.HasPendingRequest)
                        {
                            statusText = "بانتظار الموافقة";
                            statusClass = "is-pending";
                            statusKey = "pending";
                            statusBadgeClass = "bg-warning text-dark";
                        }
                        else
                        {
                            statusText = "غير مفعّلة";
                            statusClass = "is-inactive";
                            statusKey = "inactive";
                            statusBadgeClass = "bg-secondary";
                        }

                        var search = string.Join(" ", new[]
                        {
                            s.DisplayName ?? "",
                            s.FeatureKey ?? "",
                            s.Category ?? "",
                            s.Description ?? "",
                            statusText
                        });
                        var icon = CategoryIcon(s.Category);
                        var safeKey = new string((s.FeatureKey ?? "").Select(ch => char.IsLetterOrDigit(ch) ? ch : '_').ToArray());
                        var isHighlighted = !string.IsNullOrWhiteSpace(highlightedFeatureKey) &&
                            string.Equals(s.FeatureKey, highlightedFeatureKey, StringComparison.OrdinalIgnoreCase);

                        <div id="feature_@safeKey" class="company-feature-card @statusClass @(isHighlighted ? "is-target" : "")"
                             data-search="@search"
                             data-status="@statusKey"
                             data-category="@(s.Category ?? "")"
                             data-name="@(s.DisplayName ?? "")"
                             data-feature-key="@(s.FeatureKey ?? "")">
                            <div class="company-feature-card-header">
                                <div class="company-feature-card-title">
                                    <div class="company-feature-icon">
                                        <i class="@icon"></i>
                                    </div>
                                    <div>
                                        <div class="company-feature-name">@s.DisplayName</div>
                                        <div class="company-feature-key text-muted small"><code>@s.FeatureKey</code></div>
                                    </div>
                                </div>
                                <div class="company-feature-status">
                                    <span class="badge @statusBadgeClass">@statusText</span>
                                </div>
                            </div>

                            <div class="company-feature-card-meta">
                                <span class="badge bg-light text-dark company-feature-category">@s.Category</span>
                                @if (s.HasActiveSubscription && s.ExpiresAt.HasValue)
                                {
                                    <span class="company-feature-price text-muted small">
                                        تنتهي: @s.ExpiresAt.Value.ToString("yyyy/MM/dd")
                                    </span>
                                }
                                else if (s.PricingOptions.Any())
                                {
                                    var minCharge = s.PricingOptions.Min(o => o.EstimatedChargeSyp);
                                    <span class="company-feature-price text-primary small">
                                        من @minCharge.ToString("N0") ل.س.ج
                                    </span>
                                }
                            </div>

                            <div class="company-feature-card-body">
                                <div class="company-feature-desc text-muted">
                                    @(string.IsNullOrWhiteSpace(s.Description) ? "—" : s.Description)
                                </div>
                            </div>

                            <div class="company-feature-card-footer">
                                <div class="d-flex flex-wrap gap-2 align-items-center justify-content-between w-100">
                                    @if (s.HasActiveSubscription)
                                    {
                                        <div class="text-success small">الخدمة مفعّلة — تظهر في القائمة الجانبية.</div>
                                    }
                                    else if (s.HasPendingRequest)
                                    {
                                        <div class="text-warning small">طلبك #@s.PendingRequestId بانتظار موافقة مدير النظام.</div>
                                    }
                                    else if (!string.IsNullOrWhiteSpace(s.InactiveReason))
                                    {
                                        <div class="text-muted small"><i class="fas fa-circle-info ms-1"></i>@s.InactiveReason</div>
                                    }
                                    else if (!s.PricingOptions.Any())
                                    {
                                        <div class="text-muted small">لم يُعرّف تسعير لهذه الخدمة بعد.</div>
                                    }
                                    else
                                    {
                                        <div class="text-muted small">اختر خطة من «عرض التفاصيل» لطلب التفعيل.</div>
                                    }
                                    <button type="button"
                                            class="btn features-hub-detail-btn"
                                            data-bs-toggle="offcanvas"
                                            data-bs-target="#featureDetailOffcanvas_@safeKey"
                                            aria-controls="featureDetailOffcanvas_@safeKey">
                                        <i class="fas fa-circle-info ms-1"></i>
                                        عرض التفاصيل
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>

            <div id="companyFeaturesNoResults" class="company-features-empty text-muted d-none">
                لا توجد نتائج مطابقة للبحث.
            </div>
        </div>
    </div>

    @foreach (var s in services!)
    {
        var safeKey = new string((s.FeatureKey ?? "").Select(ch => char.IsLetterOrDigit(ch) ? ch : '_').ToArray());
        var icon = CategoryIcon(s.Category);
        string statusText = s.HasActiveSubscription ? "مفعّلة" : s.HasPendingRequest ? "بانتظار الموافقة" : "غير مفعّلة";
        string statusBadgeClass = s.HasActiveSubscription ? "bg-success" : s.HasPendingRequest ? "bg-warning text-dark" : "bg-secondary";

        <div class="offcanvas offcanvas-start feature-detail-offcanvas"
             tabindex="-1"
             id="featureDetailOffcanvas_@safeKey"
             aria-labelledby="featureDetailOffcanvasLabel_@safeKey">
            <div class="offcanvas-header feature-detail-offcanvas-header flex-wrap gap-2">
                <div class="d-flex gap-3 flex-grow-1 min-w-0">
                    <div class="feature-detail-hero-icon flex-shrink-0">
                        <i class="@icon" aria-hidden="true"></i>
                    </div>
                    <div class="min-w-0">
                        <h5 id="featureDetailOffcanvasLabel_@safeKey" class="offcanvas-title mb-1 text-white text-truncate">@s.DisplayName</h5>
                        <div class="small text-white-50 mb-2"><code class="text-white-50">@s.FeatureKey</code></div>
                        <span class="badge @statusBadgeClass">@statusText</span>
                    </div>
                </div>
                <button type="button" class="btn-close btn-close-white flex-shrink-0" data-bs-dismiss="offcanvas" aria-label="إغلاق"></button>
            </div>
            <div class="offcanvas-body d-flex flex-column p-0">
                <div class="flex-grow-1 overflow-auto p-3">
                    <div class="feature-detail-section">
                        <div class="feature-detail-section-head">
                            <i class="fas fa-circle-info"></i>
                            عن الخدمة
                        </div>
                        <div class="feature-detail-section-body feature-rich text-body">
                            @if (!string.IsNullOrWhiteSpace(s.DetailHtml))
                            {
                                @Html.Raw(s.DetailHtml)
                            }
                            else
                            {
                                <p class="text-muted mb-0">@(string.IsNullOrWhiteSpace(s.Description) ? "لم يُضف مدير النظام وصفاً تفصيلياً بعد." : s.Description)</p>
                            }
                        </div>
                    </div>

                    <div class="feature-detail-section">
                        <div class="feature-detail-section-head">
                            <i class="fas fa-tags"></i>
                            سياسة التسعير
                        </div>
                        <div class="feature-detail-section-body feature-rich">
                            @Html.Raw(s.PricingPolicyHtml)
                        </div>
                    </div>

                    <div class="feature-detail-section">
                        <div class="feature-detail-section-head">
                            <i class="fas fa-rotate"></i>
                            سياسة التجديد
                        </div>
                        <div class="feature-detail-section-body feature-rich">
                            @Html.Raw(s.RenewalPolicyHtml ?? "<p class=\"text-muted mb-0\">لم يُعرّف مدير النظام سياسة تجديد بعد.</p>")
                        </div>
                    </div>

                    @if (!s.HasActiveSubscription && !string.IsNullOrWhiteSpace(s.InactiveReason))
                    {
                        <div class="alert alert-secondary mb-3 py-2 small mb-0">
                            <strong>سبب عدم التفعيل:</strong> @s.InactiveReason
                        </div>
                    }

                    @if (s.HasActiveSubscription)
                    {
                        <div class="feature-detail-section">
                            <div class="feature-detail-section-head">
                                <i class="fas fa-calendar-check"></i>
                                الاشتراك الحالي
                            </div>
                            <div class="feature-detail-section-body">
                                @if (s.StartAt.HasValue)
                                {
                                    <p class="mb-1 small text-muted">بدء: @s.StartAt.Value.ToString("yyyy/MM/dd")</p>
                                }
                                @if (s.ExpiresAt.HasValue)
                                {
                                    <p class="mb-0 small">ينتهي: <strong>@s.ExpiresAt.Value.ToString("yyyy/MM/dd")</strong></p>
                                }
                            </div>
                        </div>
                    }
                    else if (!s.HasPendingRequest && s.PricingOptions.Any())
                    {
                        <div class="feature-detail-section">
                            <div class="feature-detail-section-head">
                                <i class="fas fa-cart-plus"></i>
                                خطط التفعيل
                            </div>
                            <div class="feature-detail-section-body">
                                @foreach (var plan in s.PricingOptions)
                                {
                                    <form asp-action="RequestSubscription" method="post" class="border rounded-3 p-3 mb-2">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="pricingId" value="@plan.PricingId" />
                                        <div class="fw-bold mb-1">@plan.DisplayText</div>
                                        <div class="text-muted small mb-2">
                                            المبلغ المقدّر عند الطلب:
                                            <strong class="text-primary">@plan.EstimatedChargeSyp.ToString("N0") ل.س.ج</strong>
                                        </div>
                                        <button type="submit" class="btn btn-sm features-hub-detail-btn w-100"
                                                @(plan.EstimatedChargeSyp > Model.CompanyBalance ? "disabled" : null)>
                                            <i class="fas fa-paper-plane ms-1"></i>
                                            طلب التفعيل
                                        </button>
                                        @if (plan.EstimatedChargeSyp > Model.CompanyBalance)
                                        {
                                            <div class="text-danger small mt-1">الرصيد غير كافٍ — عبّئ المحفظة أولاً.</div>
                                        }
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="feature-detail-actions mt-auto">
                    <div class="d-flex flex-wrap gap-2 justify-content-end">
                        <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="offcanvas">إغلاق</button>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<script>
    (function () {
        const input = document.getElementById('companyFeaturesSearch');
        const clearBtn = document.getElementById('companyFeaturesSearchClear');
        const grid = document.getElementById('companyFeaturesGrid');
        const empty = document.getElementById('companyFeaturesNoResults');
        const categorySelect = document.getElementById('companyFeaturesCategory');
        const sortSelect = document.getElementById('companyFeaturesSort');
        const filterPills = Array.from(document.querySelectorAll('.company-filter-pill'));
        const statCards = Array.from(document.querySelectorAll('.features-hub-stat-card'));
        if (!input || !grid) return;

        const cards = Array.from(grid.querySelectorAll('.company-feature-card'));
        const normalize = (s) => (s || '').toString().toLowerCase();
        let activeStatus = 'all';

        const syncStatCards = () => {
            for (const sc of statCards) {
                const st = sc.getAttribute('data-hub-status') || '';
                sc.classList.toggle('is-active-filter', activeStatus !== 'all' && st === activeStatus);
            }
        };

        const sortCards = () => {
            const mode = (sortSelect && sortSelect.value) ? sortSelect.value : 'nameAsc';
            const collator = new Intl.Collator('ar', { numeric: true, sensitivity: 'base' });

            const scoreStatus = (s) => s === 'active' ? 0 : s === 'pending' ? 1 : 2;

            const sorted = [...cards].sort((a, b) => {
                if (mode === 'status') {
                    const sa = scoreStatus(a.dataset.status);
                    const sb = scoreStatus(b.dataset.status);
                    if (sa !== sb) return sa - sb;
                }

                const na = a.dataset.name || '';
                const nb = b.dataset.name || '';
                const cmp = collator.compare(na, nb);
                if (mode === 'nameDesc') return -cmp;
                return cmp;
            });

            for (const c of sorted) grid.appendChild(c);
        };

        const apply = () => {
            const q = normalize(input.value).trim();
            const selectedCategory = categorySelect ? (categorySelect.value || '') : '';
            let visible = 0;
            for (const c of cards) {
                const hitText = !q || normalize(c.dataset.search).includes(q);
                const hitStatus = activeStatus === 'all' || c.dataset.status === activeStatus;
                const hitCategory = !selectedCategory || (c.dataset.category === selectedCategory);
                const hit = hitText && hitStatus && hitCategory;
                c.classList.toggle('d-none', !hit);
                if (hit) visible++;
            }
            if (empty) empty.classList.toggle('d-none', visible !== 0);
            if (clearBtn) clearBtn.disabled = !input.value;
            syncStatCards();
        };

        input.addEventListener('input', apply);
        if (categorySelect) categorySelect.addEventListener('change', apply);
        if (sortSelect) sortSelect.addEventListener('change', function () { sortCards(); apply(); });

        for (const b of filterPills) {
            b.addEventListener('click', function () {
                activeStatus = this.dataset.status || 'all';
                for (const x of filterPills) x.classList.toggle('is-active', x === this);
                apply();
            });
        }

        for (const sc of statCards) {
            sc.addEventListener('click', function () {
                const st = this.getAttribute('data-hub-status');
                if (!st) return;
                const pill = filterPills.find((p) => (p.dataset.status || '') === st);
                if (pill) pill.click();
            });
        }

        if (clearBtn) {
            clearBtn.addEventListener('click', function () {
                input.value = '';
                input.focus();
                apply();
            });
            clearBtn.disabled = true;
        }

        sortCards();
        apply();
        syncStatCards();

        const targetCard = grid.querySelector('.company-feature-card.is-target');
        if (targetCard && !targetCard.classList.contains('d-none')) {
            targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
            targetCard.classList.add('is-target-pulse');
            window.setTimeout(() => targetCard.classList.remove('is-target-pulse'), 2600);
        }

    })();
</script>
