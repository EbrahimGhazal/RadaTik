@model IEnumerable<RadaTik.Models.Client>
@{
    ViewData["Title"] = "اشتراكات تنتهي خلال 3 أيام";
    var totalExpiring = ViewBag.TotalExpiring ?? 0;
    var expiringToday = ViewBag.ExpiringToday ?? 0;
    var expiringTomorrow = ViewBag.ExpiringTomorrow ?? 0;
    var expiringIn2Days = ViewBag.ExpiringIn2Days ?? 0;
    var expiringIn3Days = ViewBag.ExpiringIn3Days ?? 0;
}

<style>
    .btn {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
    }

    .btn i {
        width: 1rem;
        font-size: .9rem;
        line-height: 1;
        text-align: center;
    }

    .btn.btn-sm {
        min-height: 32px;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="mb-0">
        <i class="fas fa-clock text-warning"></i>
        @ViewData["Title"]
    </h2>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="ExpiredAccounts" class="btn btn-danger">
            <i class="fas fa-exclamation-triangle"></i> المنتهية
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-right"></i> العودة
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-md-2 col-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">الإجمالي</div>
                <div class="h5 mb-0 text-warning">@totalExpiring</div>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">اليوم</div>
                <div class="h5 mb-0 text-danger">@expiringToday</div>
            </div>
        </div>
    </div>
    <div class="col-md-2 col-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">غداً</div>
                <div class="h5 mb-0 text-warning">@expiringTomorrow</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">بعد يومين</div>
                <div class="h5 mb-0 text-info">@expiringIn2Days</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">بعد 3 أيام</div>
                <div class="h5 mb-0 text-primary">@expiringIn3Days</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-warning text-dark">
        <h5 class="card-title mb-0">
            <i class="fas fa-list"></i> اشتراكات تحتاج متابعة
        </h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle" id="expiringTable">
                    <thead class="table-light">
                        <tr>
                            <th>العميل</th>
                            <th>اسم المستخدم</th>
                            <th>الهاتف</th>
                            <th>تاريخ الانتهاء</th>
                            <th>متبقي</th>
                            <th>الباقة</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var client in Model)
                        {
                            var daysRemaining = (client.AccountExpirationDate!.Value.Date - DateTime.Now.Date).Days;
                            var rowClass = daysRemaining <= 0 ? "table-danger" :
                                           daysRemaining == 1 ? "table-warning" : string.Empty;
                            <tr class="@rowClass">
                                <td>
                                    <div class="fw-semibold">@client.Name</div>
                                    @if (!string.IsNullOrEmpty(client.SID))
                                    {
                                        <small class="text-muted">#@client.SID</small>
                                    }
                                </td>
                                <td><code>@client.UserName</code></td>
                                <td>
                                    @if (!string.IsNullOrEmpty(client.PhoneNumber))
                                    {
                                        <a href="tel:@client.PhoneNumber">@client.PhoneNumber</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <span class="badge @(daysRemaining <= 0 ? "bg-danger" : "bg-warning text-dark")">
                                        @client.AccountExpirationDate.Value.ToString("yyyy/MM/dd")
                                    </span>
                                </td>
                                <td>
                                    @if (daysRemaining <= 0)
                                    {
                                        <span class="badge bg-danger">اليوم</span>
                                    }
                                    else if (daysRemaining == 1)
                                    {
                                        <span class="badge bg-warning text-dark">غداً</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark">@daysRemaining أيام</span>
                                    }
                                </td>
                                <td>
                                    @if (client.Profile != null)
                                    {
                                        <span class="badge bg-info text-dark">@client.Profile.Name</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@client.Id" class="btn btn-sm btn-outline-info">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center">
                <i class="fas fa-check-circle text-success fs-1"></i>
                <h5 class="mt-3 mb-1">لا توجد اشتراكات تنتهي قريباً</h5>
                <p class="text-muted mb-0">جميع الاشتراكات لديها أكثر من 3 أيام متبقية</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#expiringTable').DataTable({
                language: { url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/ar.json' },
                order: [[4, 'asc']],
                pageLength: 25
            });
        });
    </script>
}
