@model IEnumerable<RadaTik.Models.Client>
@{
    ViewData["Title"] = "الاشتراكات المنتهية";
    var totalExpired = ViewBag.TotalExpired ?? 0;
    var activeExpired = ViewBag.ActiveExpired ?? 0;
    var disabledExpired = ViewBag.DisabledExpired ?? 0;
}

<style>
    .btn {
        min-height: 38px;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
    }

    .btn i {
        width: 1rem;
        font-size: .9rem;
        line-height: 1;
        text-align: center;
    }

    .btn.btn-sm {
        min-height: 32px;
    }
</style>

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <h2 class="mb-0">
        <i class="fas fa-exclamation-triangle text-danger"></i>
        @ViewData["Title"]
    </h2>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-action="ExpiringIn3Days" class="btn btn-warning">
            <i class="fas fa-clock"></i> تنتهي خلال 3 أيام
        </a>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-right"></i> العودة
        </a>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">إجمالي المنتهية</div>
                <div class="h4 mb-0 text-danger">@totalExpired</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">منتهية ونشطة</div>
                <div class="h4 mb-0 text-warning">@activeExpired</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">منتهية ومعطلة</div>
                <div class="h4 mb-0 text-secondary">@disabledExpired</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-danger text-white">
        <h5 class="card-title mb-0">
            <i class="fas fa-list"></i> قائمة الاشتراكات المنتهية
        </h5>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle" id="expiredTable">
                    <thead class="table-light">
                        <tr>
                            <th>العميل</th>
                            <th>اسم المستخدم</th>
                            <th>تاريخ الانتهاء</th>
                            <th>منتهي منذ</th>
                            <th>الحالة</th>
                            <th>الباقة</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var client in Model)
                        {
                            var daysExpired = (DateTime.Now - client.AccountExpirationDate!.Value).Days;
                            <tr class="@(client.IsActive ? "table-danger" : string.Empty)">
                                <td>
                                    <div class="fw-semibold">@client.Name</div>
                                    @if (!string.IsNullOrEmpty(client.PhoneNumber))
                                    {
                                        <small class="text-muted">@client.PhoneNumber</small>
                                    }
                                </td>
                                <td><code>@client.UserName</code></td>
                                <td><span class="badge bg-danger">@client.AccountExpirationDate.Value.ToString("yyyy/MM/dd")</span></td>
                                <td><span class="badge bg-light text-danger">@daysExpired يوم</span></td>
                                <td>
                                    @if (client.IsActive)
                                    {
                                        <span class="badge bg-warning text-dark">نشط</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">معطل</span>
                                    }
                                </td>
                                <td>
                                    @if (client.Profile != null)
                                    {
                                        <span class="badge bg-info text-dark">@client.Profile.Name</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@client.Id" class="btn btn-sm btn-outline-info">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="p-5 text-center">
                <i class="fas fa-check-circle text-success fs-1"></i>
                <h5 class="mt-3 mb-1">لا توجد اشتراكات منتهية</h5>
                <p class="text-muted mb-0">جميع الاشتراكات سارية المفعول</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#expiredTable').DataTable({
                language: { url: '//cdn.datatables.net/plug-ins/1.11.5/i18n/ar.json' },
                order: [[3, 'desc']],
                pageLength: 25
            });
        });
    </script>
}
