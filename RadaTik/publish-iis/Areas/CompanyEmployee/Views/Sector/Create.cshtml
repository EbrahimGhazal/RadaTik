@model RadaTik.Models.Sector

@{
    ViewData["Title"] = "إضافة قطاع جديد";
    ViewBag.PageHeroIcon = "fas fa-plus-circle";
    ViewBag.PageHeroSubtitle = "يُرسل الطلب لمدير الشركة للموافقة";
    ViewBag.PageHeroBackUrl = Url.Action("Index");
}

<partial name="_CrudPageHero" />

<div class="card radtk-section-card">
    <div class="card-header radtk-section-card__header">
        <h3 class="card-title h6 mb-0">
            <i class="fas fa-broadcast-tower"></i>
            بيانات القطاع الجديد
        </h3>
    </div>
    <div class="card-body">
        <div class="alert alert-info mb-3">
            <i class="fas fa-user-check me-1"></i>
            عند الحفظ من حساب الموظف سيتم إرسال الطلب إلى مدير الشركة للموافقة. لن يتم تفعيل القطاع ولن يتم الحسم من المحفظة إلا بعد الاعتماد.
        </div>

        <form asp-action="Create" id="sectorForm" class="radtk-form">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="form-grid">
                <!-- القسم الأول: المعلومات الأساسية -->
                <div class="form-section">
                    <h4 class="form-section-title">
                        <i class="fas fa-info-circle"></i> المعلومات الأساسية
                    </h4>
                    
                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="Name" class="form-label required">اسم القطاع</label>
                            <input asp-for="Name" class="form-control form-control-sm" placeholder="أدخل اسم القطاع" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="MikroTikServerId" class="form-label required">
                                <i class="fas fa-server me-1"></i>
                                خادم MikroTik
                            </label>
                            <select asp-for="MikroTikServerId" class="form-select form-select-sm" asp-items="ViewBag.MikroTikServers" id="mikroTikSelect">
                                <option value="">-- اختر خادم --</option>
                            </select>
                            <span asp-validation-for="MikroTikServerId" class="text-danger"></span>
                            <small class="form-hint">اختر خادم MikroTik المرتبط بهذا القطاع</small>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="IPAddress" class="form-label required">عنوان IP</label>
                            <div class="input-with-btn">
                                <input asp-for="IPAddress" class="form-control form-control-sm" id="ipAddressInput" value="@ViewBag.NextIP" />
                                <button type="button" class="btn btn-secondary" id="btnGenerateIP" title="توليد IP تلقائي">
                                    <i class="fas fa-sync-alt"></i>
                                </button>
                            </div>
                            <span asp-validation-for="IPAddress" class="text-danger"></span>
                            <small class="form-hint">يتم توليده تلقائياً بناءً على الخادم المحدد</small>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="NetworkMask" class="form-label">قناع الشبكة</label>
                            <input asp-for="NetworkMask" class="form-control form-control-sm" value="255.255.255.0" />
                            <span asp-validation-for="NetworkMask" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="RadioInterfaceName" class="form-label">واجهة المراقبة الراديوية</label>
                            <input asp-for="RadioInterfaceName" class="form-control form-control-sm" placeholder="wlan1 (اختياري)" />
                            <span asp-validation-for="RadioInterfaceName" class="text-danger"></span>
                            <small class="form-hint">عند تعبئتها سيتم اعتمادها مباشرة بدل اختيار أول واجهة لاسلكية.</small>
                        </div>
                        <div class="form-group">
                            <label class="form-label">عتبات التنبيه</label>
                            <div class="row g-2">
                                <div class="col-4">
                                    <input asp-for="NoiseAlertThresholdDbm" class="form-control form-control-sm" type="number" placeholder="-90" />
                                    <small class="form-hint">Noise dBm</small>
                                </div>
                                <div class="col-4">
                                    <input asp-for="SnrAlertMinDb" class="form-control form-control-sm" type="number" placeholder="20" />
                                    <small class="form-hint">SNR dB</small>
                                </div>
                                <div class="col-4">
                                    <input asp-for="CcqAlertMinPercent" class="form-control form-control-sm" type="number" placeholder="70" />
                                    <small class="form-hint">CCQ %</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- القسم الثاني: الموقع والتغطية -->
                <div class="form-section">
                    <h4 class="form-section-title">
                        <i class="fas fa-map-marked-alt"></i> الموقع ونطاق التغطية
                    </h4>
                    
                    <div class="map-container-form radtk-map-wrap">
                        <div id="map"></div>
                        <div class="map-controls-overlay">
                            <div class="map-type-controls">
                                <button type="button" class="map-type-btn active" data-map-type="streets">شوارع</button>
                                <button type="button" class="map-type-btn" data-map-type="satellite">قمر صناعي</button>
                                <button type="button" class="map-type-btn" data-map-type="terrain">تضاريس</button>
                            </div>
                        </div>
                        <div class="coverage-legend">
                            <div class="legend-title">مفتاح التغطية</div>
                            <div class="legend-item"><span class="legend-color" style="background: #00ff00;"></span> ممتازة</div>
                            <div class="legend-item"><span class="legend-color" style="background: #ffff00;"></span> جيدة</div>
                            <div class="legend-item"><span class="legend-color" style="background: #ff0000;"></span> ضعيفة</div>
                        </div>
                    </div>
                    <small class="form-hint">انقر على الخريطة لتحديد موقع القطاع</small>

                    <div class="form-row form-row-4">
                        <div class="form-group">
                            <label asp-for="Latitude" class="form-label">خط العرض</label>
                            <input asp-for="Latitude" class="form-control form-control-sm" id="latitudeInput" type="number" step="0.000001" />
                            <span asp-validation-for="Latitude" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="Longitude" class="form-label">خط الطول</label>
                            <input asp-for="Longitude" class="form-control form-control-sm" id="longitudeInput" type="number" step="0.000001" />
                            <span asp-validation-for="Longitude" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="Direction" class="form-label">الاتجاه</label>
                            <div class="input-with-addon">
                                <input asp-for="Direction" class="form-control form-control-sm" id="directionInput" type="number" min="0" max="360" value="0" step="1" />
                                <span class="input-addon">°</span>
                            </div>
                            <span asp-validation-for="Direction" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="ElevationMeters" class="form-label">الارتفاع عن سطح البحر</label>
                            <div class="input-with-btn">
                                <div class="input-with-addon">
                                    <input asp-for="ElevationMeters" class="form-control form-control-sm" id="elevationInput" type="number" step="0.01" readonly />
                                    <span class="input-addon">م</span>
                                </div>
                                <button type="button" class="btn btn-secondary" id="btnGetElevation" title="جلب الارتفاع">
                                    <i class="fas fa-mountain"></i>
                                </button>
                            </div>
                            <small class="form-hint" id="elevationStatus">يتم تحديث الارتفاع تلقائياً عند اختيار الموقع على الخريطة</small>
                            <span asp-validation-for="ElevationMeters" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="AntennaHeightAglMeters" class="form-label">الارتفاع عن سطح الأرض</label>
                            <div class="input-with-addon">
                                <input asp-for="AntennaHeightAglMeters"
                                       class="form-control form-control-sm"
                                       id="antennaHeightAglInput"
                                       type="number"
                                       min="0"
                                       max="500"
                                       step="0.01"
                                       placeholder="مثال: 6" />
                                <span class="input-addon">م</span>
                            </div>
                            <small class="form-hint">ارتفاع الهوائي فوق سطح الأرض (AGL) ويُستخدم لتحسين دقة التحليل.</small>
                            <span asp-validation-for="AntennaHeightAglMeters" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            <label asp-for="CoverageAngle" class="form-label">زاوية الانتشار</label>
                            <div class="input-with-addon">
                                <input asp-for="CoverageAngle" class="form-control form-control-sm" id="angleInput" type="number" min="1" max="360" value="60" step="1" />
                                <span class="input-addon">°</span>
                            </div>
                            <span asp-validation-for="CoverageAngle" class="text-danger"></span>
                        </div>
                        
                        <div class="form-group">
                            <label asp-for="CoverageRange" class="form-label">مدى الانتشار</label>
                            <div class="input-with-addon">
                                <input asp-for="CoverageRange" class="form-control form-control-sm" id="rangeInput" type="number" min="0.1" step="0.1" value="5" />
                                <span class="input-addon">كم</span>
                            </div>
                            <span asp-validation-for="CoverageRange" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <input asp-for="IsActive" type="hidden" value="false" />
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-success">
                    <i class="fas fa-save"></i> حفظ القطاع
                </button>
                <a asp-action="Index" class="btn btn-secondary">
                    <i class="fas fa-times"></i> إلغاء
                </a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        const getNextIpUrl = '@Url.Action("GetNextIP", "Sector")';
        const getElevationUrl = '@Url.Action("GetElevation", "Sector")';
        let elevationFetchTimer = null;

        // Wait for all libraries to load
        $(document).ready(function() {
            // Check if Leaflet is loaded
            if (typeof L === 'undefined') {
                console.error('Leaflet library is not loaded');
                $('#map').html('<div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--text-muted);padding:20px;text-align:center;"><div><i class="fas fa-exclamation-triangle" style="font-size:48px;margin-bottom:10px;color:var(--warning);"></i><br>خطأ في تحميل مكتبة الخريطة</div></div>');
            } else {
                // Initialize Map after a short delay to ensure DOM is ready
                setTimeout(function() {
                    initializeMap();
                }, 100);
            }

            // Initialize Select2 for MikroTik Server dropdown
            $('#mikroTikSelect').select2({
                theme: 'bootstrap-5',
                dir: 'rtl',
                language: {
                    noResults: function() {
                        return "لا توجد نتائج";
                    },
                    searching: function() {
                        return "جاري البحث...";
                    },
                    inputTooShort: function() {
                        return "أدخل حرفاً واحداً على الأقل";
                    }
                },
                width: '100%',
                placeholder: '-- اختر خادم --',
                allowClear: true,
                minimumResultsForSearch: 3,
                dropdownParent: $('#mikroTikSelect').parent()
            });
            
            // Handle change event
            $('#mikroTikSelect').on('change', function() {
                var value = $(this).val();
                if (value) {
                    generateIPForMikroTik(value);
                }
            });

            // Generate IP button
            $('#btnGenerateIP').on('click', function() {
                var mikrotikId = $('#mikroTikSelect').val();
                if (mikrotikId) {
                    generateIPForMikroTik(mikrotikId);
                } else {
                    alert('يرجى اختيار خادم MikroTik أولاً');
                }
            });

            // Check if there's an initial value after Select2 is initialized
            setTimeout(function() {
                var initialMikroTik = $('#mikroTikSelect').val();
                if (initialMikroTik) {
                    generateIPForMikroTik(initialMikroTik);
                }
            }, 200);

            $('#btnGetElevation').on('click', function() {
                requestElevationFromCurrentInputs(true);
            });

            $('#sectorForm').on('submit', function () {
                var message = 'تأكيد: هل تريد إرسال طلب تثبيت هذا المرسل إلى مدير الشركة؟\n\nلن يتم التفعيل ولا الحسم إلا بعد الموافقة.';
                return window.confirm(message);
            });
        });

        function generateIPForMikroTik(mikrotikId) {
            if (!mikrotikId) return;

            var btn = document.getElementById('btnGenerateIP');
            var originalHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            btn.disabled = true;

            fetch(`${getNextIpUrl}?mikrotikServerId=${mikrotikId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('ipAddressInput').value = data.nextIP;
                    } else {
                        alert('حدث خطأ في توليد IP: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('حدث خطأ في الاتصال بالخادم');
                })
                .finally(() => {
                    btn.innerHTML = originalHtml;
                    btn.disabled = false;
                });
        }

        function setElevationStatus(message, statusClass) {
            var statusElement = document.getElementById('elevationStatus');
            if (!statusElement) return;

            statusElement.textContent = message;
            statusElement.classList.remove('text-success', 'text-danger', 'text-muted');

            if (statusClass === 'success') {
                statusElement.classList.add('text-success');
            } else if (statusClass === 'error') {
                statusElement.classList.add('text-danger');
            } else {
                statusElement.classList.add('text-muted');
            }
        }

        function requestElevationFromCurrentInputs(manualTrigger) {
            var lat = parseFloat(document.getElementById('latitudeInput').value);
            var lng = parseFloat(document.getElementById('longitudeInput').value);

            if (isNaN(lat) || isNaN(lng)) {
                setElevationStatus('يرجى إدخال إحداثيات صحيحة أولاً.', 'error');
                return;
            }

            fetchElevationForLocation(lat, lng, manualTrigger);
        }

        function fetchElevationForLocation(lat, lng, manualTrigger) {
            var elevationInput = document.getElementById('elevationInput');
            var btn = document.getElementById('btnGetElevation');
            var originalHtml = btn.innerHTML;

            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
            setElevationStatus('جاري جلب الارتفاع من خدمة التضاريس...', null);

            fetch(`${getElevationUrl}?lat=${lat}&lng=${lng}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        elevationInput.value = Number(data.elevation).toFixed(2);
                        var sourceText = manualTrigger ? 'تم تحديث الارتفاع بنجاح.' : 'تم تحديث الارتفاع تلقائياً.';
                        setElevationStatus(`${sourceText} القيمة: ${elevationInput.value} متر`, 'success');
                    } else {
                        setElevationStatus(data.message || 'تعذر جلب الارتفاع حالياً.', 'error');
                    }
                })
                .catch(() => {
                    setElevationStatus('تعذر الاتصال بخدمة الارتفاع حالياً.', 'error');
                })
                .finally(() => {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                });
        }

        function queueAutoElevationFetch(lat, lng) {
            if (elevationFetchTimer) {
                clearTimeout(elevationFetchTimer);
            }

            elevationFetchTimer = setTimeout(function() {
                fetchElevationForLocation(lat, lng, false);
            }, 400);
        }

        var mapInstance = null;
        var markerInstance = null;
        var coverageLayersInstance = [];

        function initializeMap() {
            // Check if map already exists
            if (mapInstance) {
                mapInstance.remove();
                mapInstance = null;
            }

            var defaultLat = 35.5200;
            var defaultLng = 35.7800;

            // Check if Leaflet is available
            if (typeof L === 'undefined') {
                console.error('Leaflet is not loaded');
                document.getElementById('map').innerHTML = 
                    '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--text-muted);padding:20px;text-align:center;">' +
                    '<div><i class="fas fa-exclamation-triangle" style="font-size:48px;margin-bottom:10px;color:var(--warning);"></i><br>خطأ في تحميل مكتبة الخريطة</div></div>';
                return;
            }

            try {
                mapInstance = L.map('map', {
                    zoomControl: true,
                    attributionControl: true
                }).setView([defaultLat, defaultLng], 15);

                var streetLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    attribution: '© OpenStreetMap',
                    maxZoom: 19
                });

                var satelliteLayer = L.tileLayer('https://{s}.google.com/vt/lyrs=s&x={x}&y={y}&z={z}', {
                    maxZoom: 20,
                    subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
                });

                var terrainLayer = L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', {
                    maxZoom: 17
                });

                streetLayer.addTo(mapInstance);

                var wifiIcon = L.AwesomeMarkers.icon({
                    icon: 'wifi',
                    markerColor: 'blue',
                    prefix: 'fa',
                    iconColor: 'white'
                });

                markerInstance = L.marker([defaultLat, defaultLng], {icon: wifiIcon}).addTo(mapInstance)
                    .bindPopup('موقع القطاع الجديد')
                    .openPopup();

                var latInput = document.getElementById('latitudeInput');
                var lngInput = document.getElementById('longitudeInput');
                
                if (latInput) latInput.value = defaultLat;
                if (lngInput) lngInput.value = defaultLng;
                queueAutoElevationFetch(defaultLat, defaultLng);
                
                drawCoverageArea(defaultLat, defaultLng);

                mapInstance.on('click', function(e) {
                    var lat = e.latlng.lat;
                    var lng = e.latlng.lng;

                    if (latInput) latInput.value = lat.toFixed(6);
                    if (lngInput) lngInput.value = lng.toFixed(6);

                    if (markerInstance && mapInstance.hasLayer(markerInstance)) {
                        mapInstance.removeLayer(markerInstance);
                    }
                    clearCoverageLayers();

                    markerInstance = L.marker([lat, lng], {icon: wifiIcon}).addTo(mapInstance)
                        .bindPopup('موقع القطاع الجديد')
                        .openPopup();

                    drawCoverageArea(lat, lng);
                    queueAutoElevationFetch(lat, lng);
                });

                document.querySelectorAll('.map-type-btn').forEach(button => {
                    button.addEventListener('click', function() {
                        document.querySelectorAll('.map-type-btn').forEach(btn => btn.classList.remove('active'));
                        this.classList.add('active');
                        changeMapType(this.getAttribute('data-map-type'));
                    });
                });

                function changeMapType(type) {
                    if (!mapInstance) return;
                    
                    mapInstance.removeLayer(streetLayer);
                    mapInstance.removeLayer(satelliteLayer);
                    mapInstance.removeLayer(terrainLayer);

                    switch(type) {
                        case 'satellite': satelliteLayer.addTo(mapInstance); break;
                        case 'terrain': terrainLayer.addTo(mapInstance); break;
                        default: streetLayer.addTo(mapInstance);
                    }
                }

                ['directionInput', 'angleInput', 'rangeInput', 'latitudeInput', 'longitudeInput'].forEach(id => {
                    document.getElementById(id).addEventListener('input', updateCoverageArea);
                });

                function updateCoverageArea() {
                    if (!mapInstance) return;
                    
                    var lat = parseFloat(document.getElementById('latitudeInput').value);
                    var lng = parseFloat(document.getElementById('longitudeInput').value);

                    if (!isNaN(lat) && !isNaN(lng)) {
                        if (markerInstance && mapInstance.hasLayer(markerInstance)) {
                            mapInstance.removeLayer(markerInstance);
                        }
                        markerInstance = L.marker([lat, lng], {icon: wifiIcon}).addTo(mapInstance);
                        clearCoverageLayers();
                        drawCoverageArea(lat, lng);
                        queueAutoElevationFetch(lat, lng);
                    }
                }

                function clearCoverageLayers() {
                    if (!mapInstance) return;
                    
                    coverageLayersInstance.forEach(layer => {
                        if (layer && mapInstance.hasLayer(layer)) {
                            mapInstance.removeLayer(layer);
                        }
                    });
                    coverageLayersInstance = [];
                }

                function drawCoverageArea(lat, lng) {
                    var direction = parseFloat(document.getElementById('directionInput').value) || 0;
                    var angle = parseFloat(document.getElementById('angleInput').value) || 60;
                    var range = parseFloat(document.getElementById('rangeInput').value) || 5;

                    var layersCount = 10;
                    var startAngleRad = (direction - angle/2) * Math.PI / 180;
                    var endAngleRad = (direction + angle/2) * Math.PI / 180;

                    for (var i = 0; i < layersCount; i++) {
                        var innerRadius = (i / layersCount) * range * 1000;
                        var outerRadius = ((i + 1) / layersCount) * range * 1000;

                        var colorRatio = i / (layersCount - 1);
                        var color = 'rgb(' + Math.floor(255 * colorRatio) + ',' + Math.floor(255 * (1 - colorRatio)) + ',0)';

                        var sector = createSector([lat, lng], innerRadius, outerRadius, startAngleRad, endAngleRad, color);
                        coverageLayersInstance.push(sector);
                        if (mapInstance) {
                            sector.addTo(mapInstance);
                        }
                    }
                }

                function createSector(center, innerRadius, outerRadius, startAngle, endAngle, color) {
                    var points = [];
                    for (var i = 0; i <= 20; i++) {
                        var angle = startAngle + (endAngle - startAngle) * i / 20;
                        points.push(calculatePoint(center, innerRadius, angle));
                    }
                    for (var i = 20; i >= 0; i--) {
                        var angle = startAngle + (endAngle - startAngle) * i / 20;
                        points.push(calculatePoint(center, outerRadius, angle));
                    }
                    points.push(points[0]);
                    return L.polygon(points, { color: color, fillColor: color, fillOpacity: 0.3, weight: 1 });
                }

                /** 0 = الشمال، باتجاه عقارب الساعة — يطابق خريطة لوحة التحكم */
                function calculatePoint(center, radius, bearingRad) {
                    var lat = center[0] + (radius / 111320) * Math.cos(bearingRad);
                    var lng = center[1] + (radius / (111320 * Math.cos(center[0] * Math.PI / 180))) * Math.sin(bearingRad);
                    return [lat, lng];
                }

            } catch (error) {
                console.error('حدث خطأ في تهيئة الخريطة:', error);
                var mapElement = document.getElementById('map');
                if (mapElement) {
                    mapElement.innerHTML =
                        '<div style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--text-muted);padding:20px;text-align:center;">' +
                        '<div><i class="fas fa-exclamation-triangle" style="font-size:48px;margin-bottom:10px;color:var(--warning);"></i><br>خطأ في تحميل الخريطة: ' + error.message + '</div></div>';
                }
            }
        }
    </script>
}
