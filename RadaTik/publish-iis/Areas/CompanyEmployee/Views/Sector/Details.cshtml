@model RadaTik.Models.Sector

@{
    ViewData["Title"] = "تفاصيل القطاع";
    var canEdit = await PermissionService.HasPermissionAsync(User, "Sectors.Edit");
    var canDelete = await PermissionService.HasPermissionAsync(User, "Sectors.Delete");
}

<div class="employee-sector-hero card border-0 shadow-sm mb-3">
    <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h2 class="mb-1 hero-title">
                <i class="fas fa-info-circle"></i>
                @ViewData["Title"]: @Model.Name
            </h2>
            <p class="text-muted mb-0">ملف تفصيلي لمعلومات القطاع والربط مع الخادم والتغطية.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-action="Index" class="btn btn-outline-secondary action-btn">
            <i class="fas fa-arrow-right"></i> رجوع
        </a>
            <a asp-action="Receivers" asp-route-id="@Model.Id" class="btn btn-outline-info action-btn">
            <i class="fas fa-satellite-dish"></i> المستقبلات (@Model.ReceiverCount)
        </a>
            <a asp-action="Users" asp-route-id="@Model.Id" class="btn btn-outline-primary action-btn">
            <i class="fas fa-users"></i> المستخدمين (@Model.UserCount)
        </a>
        @if (canEdit)
        {
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning action-btn">
                <i class="fas fa-edit"></i> تعديل
            </a>
        }
        @if (canDelete)
        {
                <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger action-btn">
                <i class="fas fa-trash"></i> حذف
            </a>
        }
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm detail-card">
            <div class="card-header detail-card-header">
                <strong>معلومات أساسية</strong>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">اسم القطاع</dt>
                    <dd class="col-sm-8">@Model.Name</dd>

                    <dt class="col-sm-4">IP</dt>
                    <dd class="col-sm-8"><code>@Model.IPAddress</code></dd>

                    <dt class="col-sm-4">قناع الشبكة</dt>
                    <dd class="col-sm-8">@Model.NetworkMask</dd>

                    <dt class="col-sm-4">الخادم</dt>
                    <dd class="col-sm-8">
                        @if (Model.MikroTikServer != null)
                        {
                            <span class="badge bg-secondary">@Model.MikroTikServer.Host:@Model.MikroTikServer.Port</span>
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </dd>

                    <dt class="col-sm-4">الحالة</dt>
                    <dd class="col-sm-8">
                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">نشط</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">متوقف</span>
                        }
                    </dd>
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm detail-card">
            <div class="card-header detail-card-header">
                <strong>الموقع والتغطية</strong>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Latitude</dt>
                    <dd class="col-sm-8">@Model.Latitude</dd>

                    <dt class="col-sm-4">Longitude</dt>
                    <dd class="col-sm-8">@Model.Longitude</dd>

                    <dt class="col-sm-4">Direction</dt>
                    <dd class="col-sm-8">@Model.Direction°</dd>

                    <dt class="col-sm-4">CoverageAngle</dt>
                    <dd class="col-sm-8">@Model.CoverageAngle°</dd>

                    <dt class="col-sm-4">CoverageRange</dt>
                    <dd class="col-sm-8">@Model.CoverageRange كم</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<style>
    .employee-sector-hero { background: linear-gradient(135deg, #f8fbff 0%, #eef5ff 100%); }
    .hero-title { color: #1b2a4b; font-weight: 700; }
    .action-btn { border-radius: 0.65rem; font-weight: 600; }
    .detail-card { border-radius: 0.95rem; overflow: hidden; }
    .detail-card-header {
        background: #f8fafc;
        border-bottom: 1px solid #dbe4f0;
        color: #344054;
    }
</style>

