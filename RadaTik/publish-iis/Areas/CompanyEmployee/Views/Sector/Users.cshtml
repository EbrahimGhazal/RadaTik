<div class="radtk-page-emp-sector-users">
<div class="radtk-page-emp-sector-users">
@model IEnumerable<RadaTik.Models.Client>

@{
    ViewData["Title"] = "مستخدمين القطاع";
    var sectorName = (string?)ViewBag.SectorName ?? "";
    var totalUsers = Model?.Count() ?? 0;
    var activeUsers = Model?.Count(c => c.IsActive) ?? 0;
    var inactiveUsers = totalUsers - activeUsers;
}

<div class="employee-sector-hero card border-0 shadow-sm mb-3">
    <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h2 class="mb-1 hero-title">
                <i class="fas fa-users"></i>
                @ViewData["Title"] @if (!string.IsNullOrWhiteSpace(sectorName)) { <text>: @sectorName</text> }
            </h2>
            <p class="text-muted mb-0">عرض المشتركين المرتبطين بهذا القطاع بشكل واضح وسريع.</p>
        </div>
        <a asp-action="Index" class="btn btn-outline-secondary action-btn">
            <i class="fas fa-arrow-right"></i> رجوع للقطاعات
        </a>
    </div>
</div>

<div class="row g-2 mb-3">
    <div class="col-md-4 col-6">
        <div class="card stat-card total h-100"><div class="card-body"><div class="stat-label">إجمالي المستخدمين</div><div class="stat-value">@totalUsers</div></div></div>
    </div>
    <div class="col-md-4 col-6">
        <div class="card stat-card active h-100"><div class="card-body"><div class="stat-label">مفعل</div><div class="stat-value">@activeUsers</div></div></div>
    </div>
    <div class="col-md-4 col-12">
        <div class="card stat-card inactive h-100"><div class="card-body"><div class="stat-label">معطل</div><div class="stat-value">@inactiveUsers</div></div></div>
    </div>
</div>

<div class="card border-0 shadow-sm table-card">
    <div class="card-body">
        <div class="table-responsive table-wrap">
            <table class="table table-hover align-middle section-table radtk-data-table radtk-data-table--cards">
                <thead>
                    <tr>
                        <th>العميل</th>
                        <th>اسم المستخدم</th>
                        <th>الهاتف</th>
                        <th>الحالة</th>
                        <th style="width:160px;">إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in (Model ?? Enumerable.Empty<RadaTik.Models.Client>()))
                    {
                        <tr>
                            <td><strong>@c.Name</strong></td>
                            <td><code>@c.UserName</code></td>
                            <td>@c.PhoneNumber</td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="badge bg-success">مفعل</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">معطل</span>
                                }
                            </td>
                            <td>
                                <a asp-area="CompanyEmployee" asp-controller="Clients" asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-secondary">
                                    <i class="fas fa-eye"></i> تفاصيل
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

</div>
