@{
    ViewData["Title"] = "جرد مالي";
    var companyName = ViewBag.CompanyName as string ?? "";
    var snapshot = ViewBag.Snapshot;
}

<div class="page-header mb-3">
    <h1 class="page-title"><i class="fas fa-balance-scale"></i> @ViewData["Title"]</h1>
    <p class="text-muted mb-0">@companyName</p>
</div>

<div class="alert alert-info">
    ملخص الجرد المالي للشركة — للاطلاع. التفاصيل الكاملة متاحة لمدير الشركة من لوحة الإدارة.
</div>

@if (snapshot != null)
{
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <pre class="small mb-0" style="white-space: pre-wrap; direction: ltr; text-align: left;">@System.Text.Json.JsonSerializer.Serialize(snapshot, new System.Text.Json.JsonSerializerOptions { WriteIndented = true })</pre>
        </div>
    </div>
}

<a asp-action="Index" class="btn btn-outline-secondary btn-sm mt-2">العودة للدفتر</a>
