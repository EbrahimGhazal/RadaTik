@{
    ViewData["Title"] = "خدماتنا";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<style>
    .page-hero {
        background: var(--gradient-hero);
        padding: 150px 0 100px;
        text-align: center;
        color: white;
    }

    .page-hero-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 30px;
    }

    .page-hero-title {
        font-size: 48px;
        font-weight: 800;
        margin-bottom: 20px;
    }

    .page-hero-desc {
        font-size: 20px;
        color: rgba(255,255,255,0.8);
    }

    .services-section {
        padding: 100px 0;
    }

    .services-container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 30px;
    }

    .services-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 40px;
    }

    .service-card {
        background: white;
        border-radius: 20px;
        padding: 50px;
        border: 1px solid #eee;
        transition: all 0.4s ease;
        display: flex;
        gap: 30px;
    }

    .service-card:hover {
        box-shadow: 0 20px 50px rgba(0,0,0,0.1);
        transform: translateY(-5px);
        border-color: var(--primary);
    }

    .service-icon {
        width: 80px;
        height: 80px;
        background: linear-gradient(135deg, rgba(0, 102, 204, 0.1) 0%, rgba(0, 200, 83, 0.1) 100%);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 32px;
        color: var(--primary);
        flex-shrink: 0;
        transition: all 0.3s;
    }

    .service-card:hover .service-icon {
        background: var(--gradient-primary);
        color: white;
        transform: scale(1.1);
    }

    .service-content h3 {
        font-size: 24px;
        font-weight: 700;
        color: var(--dark);
        margin-bottom: 15px;
    }

    .service-content p {
        color: var(--gray);
        line-height: 1.8;
        margin-bottom: 20px;
    }

    .service-features {
        list-style: none;
    }

    .service-features li {
        display: flex;
        align-items: center;
        gap: 10px;
        color: var(--gray);
        margin-bottom: 10px;
        font-size: 14px;
    }

    .service-features li i {
        color: var(--secondary);
    }

    .process-section {
        background: var(--light);
        padding: 100px 0;
    }

    .process-header {
        text-align: center;
        margin-bottom: 60px;
    }

    .process-header h2 {
        font-size: 36px;
        font-weight: 800;
        color: var(--dark);
        margin-bottom: 15px;
    }

    .process-header p {
        color: var(--gray);
        font-size: 18px;
    }

    .process-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 30px;
        position: relative;
    }

    .process-grid::before {
        content: '';
        position: absolute;
        top: 50px;
        left: 12.5%;
        right: 12.5%;
        height: 3px;
        background: linear-gradient(90deg, var(--primary), var(--secondary));
        z-index: 0;
    }

    .process-step {
        text-align: center;
        position: relative;
        z-index: 1;
    }

    .process-number {
        width: 100px;
        height: 100px;
        background: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 25px;
        font-size: 36px;
        font-weight: 800;
        color: var(--primary);
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        border: 4px solid var(--primary);
    }

    .process-step h4 {
        font-size: 20px;
        font-weight: 700;
        color: var(--dark);
        margin-bottom: 10px;
    }

    .process-step p {
        color: var(--gray);
        font-size: 14px;
    }

    .support-section {
        padding: 100px 0;
    }

    .support-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 60px;
        align-items: center;
    }

    .support-content h2 {
        font-size: 36px;
        font-weight: 800;
        color: var(--dark);
        margin-bottom: 25px;
    }

    .support-content p {
        color: var(--gray);
        line-height: 1.8;
        margin-bottom: 30px;
        font-size: 17px;
    }

    .support-features {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .support-feature {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .support-feature-icon {
        width: 50px;
        height: 50px;
        background: rgba(0, 200, 83, 0.1);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--secondary);
        font-size: 20px;
    }

    .support-feature span {
        color: var(--dark);
        font-weight: 600;
    }

    .support-image {
        background: var(--gradient-primary);
        border-radius: 20px;
        padding: 60px;
        text-align: center;
        color: white;
    }

    .support-image i {
        font-size: 100px;
        margin-bottom: 20px;
    }

    .support-image h3 {
        font-size: 28px;
        font-weight: 700;
    }

    @@media (max-width: 992px) {
        .services-grid {
            grid-template-columns: 1fr;
        }

        .service-card {
            flex-direction: column;
            text-align: center;
        }

        .service-icon {
            margin: 0 auto;
        }

        .process-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .process-grid::before {
            display: none;
        }

        .support-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 576px) {
        .page-hero-title {
            font-size: 36px;
        }

        .process-grid {
            grid-template-columns: 1fr;
        }

        .support-features {
            grid-template-columns: 1fr;
        }
    }
</style>

<section class="page-hero">
    <div class="page-hero-container">
        <h1 class="page-hero-title">خدماتنا</h1>
        <p class="page-hero-desc">نقدم مجموعة متكاملة من خدمات الإنترنت لتلبية جميع احتياجاتك</p>
    </div>
</section>

<section class="services-section">
    <div class="services-container">
        <div class="services-grid">
            <div class="service-card">
                <div class="service-icon">
                    <i class="fas fa-home"></i>
                </div>
                <div class="service-content">
                    <h3>إنترنت منزلي</h3>
                    <p>باقات إنترنت منزلية بسرعات متعددة تناسب جميع أفراد العائلة للتصفح والمشاهدة والألعاب.</p>
                    <ul class="service-features">
                        <li><i class="fas fa-check"></i> سرعات تصل حتى 100 Mbps</li>
                        <li><i class="fas fa-check"></i> بيانات غير محدودة</li>
                        <li><i class="fas fa-check"></i> راوتر مجاني</li>
                        <li><i class="fas fa-check"></i> تركيب مجاني</li>
                    </ul>
                </div>
            </div>

            <div class="service-card">
                <div class="service-icon">
                    <i class="fas fa-building"></i>
                </div>
                <div class="service-content">
                    <h3>إنترنت للشركات</h3>
                    <p>حلول إنترنت متقدمة للشركات والمؤسسات مع ضمان الاتصال المستمر والأمان العالي.</p>
                    <ul class="service-features">
                        <li><i class="fas fa-check"></i> IP ثابت</li>
                        <li><i class="fas fa-check"></i> SLA ضمان مستوى الخدمة</li>
                        <li><i class="fas fa-check"></i> دعم فني أولوية</li>
                        <li><i class="fas fa-check"></i> حلول مخصصة</li>
                    </ul>
                </div>
            </div>

            <div class="service-card">
                <div class="service-icon">
                    <i class="fas fa-wifi"></i>
                </div>
                <div class="service-content">
                    <h3>شبكات لاسلكية</h3>
                    <p>تغطية واسعة عبر شبكتنا اللاسلكية المتطورة لضمان اتصال مستقر في جميع المناطق.</p>
                    <ul class="service-features">
                        <li><i class="fas fa-check"></i> تغطية واسعة</li>
                        <li><i class="fas fa-check"></i> استقرار عالي</li>
                        <li><i class="fas fa-check"></i> أجهزة حديثة</li>
                        <li><i class="fas fa-check"></i> صيانة دورية</li>
                    </ul>
                </div>
            </div>

            <div class="service-card">
                <div class="service-icon">
                    <i class="fas fa-headset"></i>
                </div>
                <div class="service-content">
                    <h3>دعم فني متكامل</h3>
                    <p>فريق دعم فني متخصص متاح على مدار الساعة لحل جميع مشاكلك التقنية.</p>
                    <ul class="service-features">
                        <li><i class="fas fa-check"></i> دعم 24/7</li>
                        <li><i class="fas fa-check"></i> استجابة سريعة</li>
                        <li><i class="fas fa-check"></i> فنيين متخصصين</li>
                        <li><i class="fas fa-check"></i> زيارات منزلية</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="process-section">
    <div class="services-container">
        <div class="process-header">
            <h2>كيف تشترك معنا؟</h2>
            <p>خطوات بسيطة للحصول على أفضل خدمة إنترنت</p>
        </div>

        <div class="process-grid">
            <div class="process-step">
                <div class="process-number">1</div>
                <h4>اختر الباقة</h4>
                <p>اختر الباقة المناسبة لاحتياجاتك</p>
            </div>

            <div class="process-step">
                <div class="process-number">2</div>
                <h4>قدم طلبك</h4>
                <p>املأ نموذج الاشتراك بسهولة</p>
            </div>

            <div class="process-step">
                <div class="process-number">3</div>
                <h4>التركيب</h4>
                <p>فريقنا يقوم بالتركيب مجاناً</p>
            </div>

            <div class="process-step">
                <div class="process-number">4</div>
                <h4>استمتع</h4>
                <p>ابدأ الاستمتاع بالإنترنت فوراً</p>
            </div>
        </div>
    </div>
</section>

<section class="support-section">
    <div class="services-container">
        <div class="support-grid">
            <div class="support-content">
                <h2>دعم فني على مدار الساعة</h2>
                <p>
                    نفخر بتقديم دعم فني متميز لعملائنا على مدار الساعة طوال أيام الأسبوع. فريقنا من الفنيين المتخصصين جاهز دائماً لمساعدتك وحل أي مشكلة تواجهك.
                </p>

                <div class="support-features">
                    <div class="support-feature">
                        <div class="support-feature-icon">
                            <i class="fas fa-phone"></i>
                        </div>
                        <span>اتصال مباشر</span>
                    </div>
                    <div class="support-feature">
                        <div class="support-feature-icon">
                            <i class="fas fa-comments"></i>
                        </div>
                        <span>دردشة مباشرة</span>
                    </div>
                    <div class="support-feature">
                        <div class="support-feature-icon">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <span>بريد إلكتروني</span>
                    </div>
                    <div class="support-feature">
                        <div class="support-feature-icon">
                            <i class="fas fa-wrench"></i>
                        </div>
                        <span>زيارات ميدانية</span>
                    </div>
                </div>
            </div>

            <div class="support-image">
                <i class="fas fa-headset"></i>
                <h3>نحن هنا لمساعدتك</h3>
            </div>
        </div>
    </div>
</section>
