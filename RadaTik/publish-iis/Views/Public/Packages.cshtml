@model IEnumerable<RadaTik.Models.Profile>

@{
    ViewData["Title"] = "الباقات والأسعار";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<style>
    .page-hero {
        background: var(--gradient-hero);
        padding: 150px 0 100px;
        text-align: center;
        color: white;
    }

    .page-hero-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 0 30px;
    }

    .page-hero-title {
        font-size: 48px;
        font-weight: 800;
        margin-bottom: 20px;
    }

    .page-hero-desc {
        font-size: 20px;
        color: rgba(255,255,255,0.8);
    }

    .packages-section {
        padding: 80px 0;
        background: var(--light);
    }

    .packages-container {
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 30px;
    }

    .packages-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 30px;
    }

    .package-card {
        background: white;
        border-radius: 20px;
        padding: 40px;
        border: 2px solid #eee;
        transition: all 0.4s ease;
        position: relative;
        overflow: hidden;
    }

    .package-card:hover {
        box-shadow: 0 20px 50px rgba(0,0,0,0.1);
        transform: translateY(-10px);
        border-color: var(--primary);
    }

    .package-header {
        text-align: center;
        padding-bottom: 25px;
        border-bottom: 1px solid #eee;
        margin-bottom: 25px;
    }

    .package-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, rgba(0, 102, 204, 0.1) 0%, rgba(0, 200, 83, 0.1) 100%);
        border-radius: 20px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
        font-size: 28px;
        color: var(--primary);
    }

    .package-name {
        font-size: 24px;
        font-weight: 700;
        color: var(--dark);
        margin-bottom: 5px;
    }

    .package-type {
        color: var(--gray);
        font-size: 14px;
    }

    .package-speed-box {
        text-align: center;
        margin-bottom: 25px;
    }

    .package-speed {
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: 5px;
    }

    .package-speed-number {
        font-size: 56px;
        font-weight: 800;
        background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .package-speed-unit {
        font-size: 20px;
        color: var(--gray);
        font-weight: 600;
    }

    .package-speed-label {
        color: var(--gray);
        font-size: 14px;
    }

    .package-price-box {
        background: var(--light);
        padding: 20px;
        border-radius: 15px;
        text-align: center;
        margin-bottom: 25px;
    }

    .package-price {
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: 5px;
    }

    .package-price-number {
        font-size: 36px;
        font-weight: 800;
        color: var(--dark);
    }

    .package-price-currency {
        font-size: 16px;
        color: var(--gray);
    }

    .package-price-period {
        color: var(--gray);
        font-size: 14px;
    }

    .package-features {
        list-style: none;
        margin-bottom: 30px;
    }

    .package-features li {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px 0;
        border-bottom: 1px solid #f0f0f0;
        color: var(--gray);
    }

    .package-features li:last-child {
        border-bottom: none;
    }

    .package-features li i {
        color: var(--secondary);
        font-size: 16px;
        width: 20px;
    }

    .package-btn {
        display: block;
        width: 100%;
        padding: 16px;
        background: var(--gradient-primary);
        color: white;
        text-align: center;
        border-radius: 12px;
        text-decoration: none;
        font-weight: 600;
        font-size: 16px;
        transition: all 0.3s;
    }

    .package-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 30px rgba(0, 102, 204, 0.3);
    }

    .no-packages {
        text-align: center;
        padding: 80px 30px;
        color: var(--gray);
    }

    .no-packages i {
        font-size: 60px;
        color: #ddd;
        margin-bottom: 20px;
    }

    .no-packages h3 {
        font-size: 24px;
        color: var(--dark);
        margin-bottom: 10px;
    }

    @@media (max-width: 768px) {
        .page-hero-title {
            font-size: 36px;
        }

        .packages-grid {
            grid-template-columns: 1fr;
            max-width: 400px;
            margin: 0 auto;
        }
    }
</style>

<section class="page-hero">
    <div class="page-hero-container">
        <h1 class="page-hero-title">الباقات والأسعار</h1>
        <p class="page-hero-desc">اختر الباقة التي تناسب احتياجاتك من مجموعة متنوعة من باقاتنا المميزة</p>
    </div>
</section>

<section class="packages-section">
    <div class="packages-container">
        @if (Model.Any())
        {
            <div class="packages-grid">
                @foreach (var profile in Model)
                {
                    <div class="package-card">
                        <div class="package-header">
                            <div class="package-icon">
                                <i class="fas fa-wifi"></i>
                            </div>
                            <h3 class="package-name">@profile.Name</h3>
                            @if (!string.IsNullOrEmpty(profile.Description))
                            {
                                <p class="package-type">@profile.Description</p>
                            }
                        </div>

                        <div class="package-speed-box">
                            <div class="package-speed">
                                <span class="package-speed-number">@profile.DownloadSpeedDisplay</span>
                                <span class="package-speed-unit">Mbps</span>
                            </div>
                            <span class="package-speed-label">سرعة التحميل</span>
                        </div>

                        <div class="package-price-box">
                            <div class="package-price">
                                <span class="package-price-number">@profile.PriceWithVAT.ToString("N0")</span>
                                <span class="package-price-currency">ل.س</span>
                            </div>
                            <span class="package-price-period">شهرياً (شامل الضريبة)</span>
                        </div>

                        <ul class="package-features">
                            <li>
                                <i class="fas fa-download"></i>
                                سرعة التحميل: @profile.DownloadSpeedDisplay
                            </li>
                            <li>
                                <i class="fas fa-upload"></i>
                                سرعة الرفع: @(profile.UploadSpeedDisplay ?? "غير محدد")
                            </li>
                            @if (profile.DataLimit.HasValue && profile.DataLimit > 0)
                            {
                                <li>
                                    <i class="fas fa-database"></i>
                                    حد البيانات: @profile.DataLimit GB
                                </li>
                            }
                            else
                            {
                                <li>
                                    <i class="fas fa-infinity"></i>
                                    بيانات غير محدودة
                                </li>
                            }
                            <li>
                                <i class="fas fa-headset"></i>
                                دعم فني على مدار الساعة
                            </li>
                            <li>
                                <i class="fas fa-shield-alt"></i>
                                اتصال آمن ومشفر
                            </li>
                        </ul>

                        <a href="@Url.Action("JoinAsClient", "Public", new { profileId = profile.Id })" class="package-btn">
                            <i class="fas fa-user-plus"></i>
                            اشترك الآن
                        </a>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="no-packages">
                <i class="fas fa-box-open"></i>
                <h3>لا توجد باقات متاحة حالياً</h3>
                <p>يرجى التواصل معنا للمزيد من المعلومات</p>
            </div>
        }
    </div>
</section>
