@model IEnumerable<RadaTik.Models.PasswordResetRequest>

@{
    ViewData["Title"] = "طلبات استعادة كلمة المرور";
    var selectedStatus = ViewBag.SelectedStatus as RadaTik.Models.PasswordResetStatus?;
    int pendingCount = ViewBag.PendingCount ?? 0;
    ViewBag.PageHeroIcon = "fas fa-key";
    if (pendingCount > 0)
    {
        ViewBag.PageHeroSubtitle = $"يوجد {pendingCount} طلب/طلبات قيد الانتظار";
    }
}

<link rel="stylesheet" href="~/css/radatik-theme.css" asp-append-version="true" />
<div class="radtk-password-resets">


<partial name="_CrudPageHero" />

<!-- Alert Box -->
@if (pendingCount > 0)
{
    <div class="alert-box">
        <i class="fas fa-exclamation-circle"></i>
        <span>يوجد @pendingCount طلب/طلبات قيد الانتظار تحتاج لمراجعتك</span>
    </div>
}

<!-- Filter Bar -->
<form method="get" class="filter-bar">
    <label><i class="fas fa-filter"></i> تصفية:</label>
    <select name="status" onchange="this.form.submit()">
        @{
            var statusOptions = new[] { ("", "جميع الحالات"), ("1", "قيد الانتظار"), ("4", "مكتمل"), ("5", "ملغي") };
        }
        @foreach (var opt in statusOptions)
        {
            if (selectedStatus.HasValue && ((int)selectedStatus.Value).ToString() == opt.Item1)
            {
                <option value="@opt.Item1" selected>@opt.Item2</option>
            }
            else
            {
                <option value="@opt.Item1">@opt.Item2</option>
            }
        }
    </select>
</form>

<!-- Desktop Table View -->
<div class="table-card data-table-container">
    @if (Model != null && Model.Any())
    {
        <table class="table table-sm table-hover data-table radtk-data-table radtk-data-table--cards">
            <thead>
                <tr>
                    <th>#</th>
                    <th>المستخدم</th>
                    <th>الحالة</th>
                    <th>تاريخ الطلب</th>
                    <th>ملاحظات</th>
                    <th>إجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model)
                {
                    <tr>
                        <td>@request.Id</td>
                        <td>
                            <div class="user-info">
                                <span class="name">@(request.User?.FullName ?? request.User?.UserName ?? "غير معروف")</span>
                                <span class="email">@request.Email</span>
                            </div>
                        </td>
                        <td>
                            @switch (request.Status)
                            {
                                case RadaTik.Models.PasswordResetStatus.Pending:
                                    <span class="status-badge pending">
                                        <i class="fas fa-clock"></i>
                                        قيد الانتظار
                                    </span>
                                    break;
                                case RadaTik.Models.PasswordResetStatus.Completed:
                                    <span class="status-badge completed">
                                        <i class="fas fa-check"></i>
                                        مكتمل
                                    </span>
                                    break;
                                case RadaTik.Models.PasswordResetStatus.Cancelled:
                                    <span class="status-badge cancelled">
                                        <i class="fas fa-times"></i>
                                        ملغي
                                    </span>
                                    break;
                            }
                        </td>
                        <td>
                            <span class="date-info">
                                @request.CreatedDate.ToString("yyyy/MM/dd hh:mm tt")
                            </span>
                        </td>
                        <td>
                            <span class="notes-text" title="@(request.Notes ?? "-")">@(request.Notes ?? "-")</span>
                        </td>
                        <td>
                            @if (request.Status == RadaTik.Models.PasswordResetStatus.Pending)
                            {
                                <div class="action-buttons">
                                    <button type="button" class="action-btn reset" 
                                            onclick="openResetModal(@request.Id, '@(request.User?.FullName ?? request.User?.UserName ?? "المستخدم")')">
                                        <i class="fas fa-key"></i>
                                        إعادة تعيين
                                    </button>
                                    <form asp-action="RejectPasswordReset" method="post" style="display: inline;"
                                          onsubmit="return confirm('هل أنت متأكد من رفض هذا الطلب؟');">
                                        <input type="hidden" name="requestId" value="@request.Id" />
                                        <button type="submit" class="action-btn reject">
                                            <i class="fas fa-times"></i>
                                            رفض
                                        </button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="date-info">تمت المعالجة</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-inbox"></i>
            <h3>لا توجد طلبات</h3>
            <p>لم يتم العثور على طلبات استعادة كلمة مرور</p>
        </div>
    }
</div>

<!-- Mobile Cards View -->
<div class="mobile-cards">
    @if (Model != null && Model.Any())
    {
        @foreach (var request in Model)
        {
            <div class="request-card">
                <div class="request-card-header">
                    <div class="user-info">
                        <span class="name">@(request.User?.FullName ?? request.User?.UserName ?? "غير معروف")</span>
                        <span class="email">@request.Email</span>
                    </div>
                    @switch (request.Status)
                    {
                        case RadaTik.Models.PasswordResetStatus.Pending:
                            <span class="status-badge pending">
                                <i class="fas fa-clock"></i>
                                قيد الانتظار
                            </span>
                            break;
                        case RadaTik.Models.PasswordResetStatus.Completed:
                            <span class="status-badge completed">
                                <i class="fas fa-check"></i>
                                مكتمل
                            </span>
                            break;
                        case RadaTik.Models.PasswordResetStatus.Cancelled:
                            <span class="status-badge cancelled">
                                <i class="fas fa-times"></i>
                                ملغي
                            </span>
                            break;
                    }
                </div>
                <div class="request-card-body">
                    <div class="request-card-item">
                        <label>رقم الطلب</label>
                        <span>#@request.Id</span>
                    </div>
                    <div class="request-card-item">
                        <label>تاريخ الطلب</label>
                        <span>@request.CreatedDate.ToString("yyyy/MM/dd")</span>
                    </div>
                    @if (!string.IsNullOrEmpty(request.Notes))
                    {
                        <div class="request-card-item" style="grid-column: span 2;">
                            <label>ملاحظات</label>
                            <span>@request.Notes</span>
                        </div>
                    }
                </div>
                @if (request.Status == RadaTik.Models.PasswordResetStatus.Pending)
                {
                    <div class="request-card-footer">
                        <div class="action-buttons" style="width: 100%;">
                            <button type="button" class="action-btn reset" 
                                    onclick="openResetModal(@request.Id, '@(request.User?.FullName ?? request.User?.UserName ?? "المستخدم")')">
                                <i class="fas fa-key"></i>
                                إعادة تعيين
                            </button>
                            <form asp-action="RejectPasswordReset" method="post" style="flex: 1;"
                                  onsubmit="return confirm('هل أنت متأكد من رفض هذا الطلب؟');">
                                <input type="hidden" name="requestId" value="@request.Id" />
                                <button type="submit" class="action-btn reject" style="width: 100%;">
                                    <i class="fas fa-times"></i>
                                    رفض
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <i class="fas fa-inbox"></i>
            <h3>لا توجد طلبات</h3>
            <p>لم يتم العثور على طلبات استعادة كلمة مرور</p>
        </div>
    }
</div>

<!-- Modal for Password Reset -->
<div class="modal-overlay" id="resetModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3><i class="fas fa-key"></i> إعادة تعيين كلمة المرور</h3>
            <button type="button" class="modal-close" onclick="closeResetModal()">&times;</button>
        </div>
        <form asp-action="ResetUserPassword" method="post">
            <input type="hidden" name="requestId" id="resetRequestId" />
            <div class="modal-body">
                <p>
                    إعادة تعيين كلمة مرور المستخدم: <strong id="resetUserName"></strong>
                </p>
                <div class="form-group">
                    <label>كلمة المرور الجديدة</label>
                    <input type="password" name="newPassword" class="form-control" required minlength="6"
                           placeholder="أدخل كلمة المرور الجديدة (6 أحرف على الأقل)" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" onclick="closeResetModal()">إلغاء</button>
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save"></i>
                    حفظ
                </button>
            </div>
        </form>
    </div>
</div>

</div>

<script>
    function openResetModal(requestId, userName) {
        document.getElementById('resetRequestId').value = requestId;
        document.getElementById('resetUserName').textContent = userName;
        document.getElementById('resetModal').classList.add('show');
    }

    function closeResetModal() {
        document.getElementById('resetModal').classList.remove('show');
    }

    // Close modal on outside click
    document.getElementById('resetModal').addEventListener('click', function(e) {
        if (e.target === this) {
            closeResetModal();
        }
    });

    // Close modal on escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeResetModal();
        }
    });
</script>
