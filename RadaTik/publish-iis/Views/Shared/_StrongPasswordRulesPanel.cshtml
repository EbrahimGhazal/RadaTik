@using RadaTik.Security
@{
    var minLength = (int?)(ViewData["SpRulesMinLength"]) ?? StrongPasswordRules.MinimumLength;
    var passwordFieldId = ViewData["SpRulesPasswordFieldId"] as string ?? "Password";
    var userNameFieldId = ViewData["SpRulesUserNameFieldId"] as string;
    var emailFieldId = ViewData["SpRulesEmailFieldId"] as string;
    var interactive = ViewData["SpRulesInteractive"] as bool? ?? true;
    var panelId = ViewData["SpRulesPanelId"] as string ?? "spRulesPanel";
    var title = ViewData["SpRulesTitle"] as string ?? "كلمة مرور قوية";
    var subtitle = ViewData["SpRulesSubtitle"] as string ?? "اتبع المعايير أدناه لحماية حسابك";
}

<div class="sp-rules-panel@(interactive ? " sp-rules-panel--interactive" : "")"
     id="@panelId"
     role="region"
     aria-label="معايير كلمة المرور القوية"
     data-sp-rules-panel="@(interactive ? "true" : null)"
     data-sp-password-id="@(interactive ? passwordFieldId : null)"
     data-sp-username-id="@(interactive && !string.IsNullOrEmpty(userNameFieldId) ? userNameFieldId : null)"
     data-sp-email-id="@(interactive && !string.IsNullOrEmpty(emailFieldId) ? emailFieldId : null)"
     data-sp-min-length="@(interactive ? minLength.ToString() : null)">
    <div class="sp-rules-header">
        <div class="sp-rules-header-icon" aria-hidden="true">
            <i class="fas fa-shield-halved"></i>
        </div>
        <div class="sp-rules-header-text">
            <h3 class="sp-rules-title">@title</h3>
            <p class="sp-rules-subtitle mb-0">@subtitle</p>
        </div>
        @if (interactive)
        {
            <div class="sp-rules-strength" aria-live="polite" aria-atomic="true">
                <span class="sp-rules-strength-label" id="@(panelId)-strengthLabel">—</span>
                <div class="sp-rules-strength-track" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="@(panelId)-strengthBar">
                    <div class="sp-rules-strength-fill"></div>
                </div>
            </div>
        }
    </div>

    <ul class="sp-rules-checklist" @if (interactive) { <text>id="@(panelId)-checklist"</text> }>
        <li class="sp-rule-item" data-sp-rule="length">
            <span class="sp-rule-icon" aria-hidden="true"><i class="fas fa-circle"></i></span>
            <span class="sp-rule-text"><strong>@minLength أحرف</strong> على الأقل</span>
        </li>
        <li class="sp-rule-item" data-sp-rule="upper">
            <span class="sp-rule-icon" aria-hidden="true"><i class="fas fa-circle"></i></span>
            <span class="sp-rule-text">حرف <strong>كبير</strong> (A–Z)</span>
        </li>
        <li class="sp-rule-item" data-sp-rule="lower">
            <span class="sp-rule-icon" aria-hidden="true"><i class="fas fa-circle"></i></span>
            <span class="sp-rule-text">حرف <strong>صغير</strong> (a–z)</span>
        </li>
        <li class="sp-rule-item" data-sp-rule="digit">
            <span class="sp-rule-icon" aria-hidden="true"><i class="fas fa-circle"></i></span>
            <span class="sp-rule-text">رقم واحد على الأقل</span>
        </li>
        <li class="sp-rule-item" data-sp-rule="special">
            <span class="sp-rule-icon" aria-hidden="true"><i class="fas fa-circle"></i></span>
            <span class="sp-rule-text">رمز خاص <span class="sp-rule-chars">! &#64; # $ % &amp; *</span></span>
        </li>
        <li class="sp-rule-item sp-rule-item--wide" data-sp-rule="personal">
            <span class="sp-rule-icon" aria-hidden="true"><i class="fas fa-circle"></i></span>
            <span class="sp-rule-text">بدون كلمة افتراضية أو اسم المستخدم أو البريد</span>
        </li>
    </ul>
</div>
