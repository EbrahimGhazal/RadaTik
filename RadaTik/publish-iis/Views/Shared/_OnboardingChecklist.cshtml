@model RadaTik.ViewModels.Onboarding.OnboardingChecklistViewModel
@if (Model is { ShouldShow: true })
{
    <section class="onboarding-checklist card mb-4" aria-label="@Model.Title">
        <div class="card-body">
            <div class="onboarding-checklist-head">
                <div>
                    <h2 class="onboarding-checklist-title h5 mb-1">
                        <i class="fas fa-route text-primary" aria-hidden="true"></i>
                        @Model.Title
                    </h2>
                    @if (!string.IsNullOrWhiteSpace(Model.Subtitle))
                    {
                        <p class="onboarding-checklist-subtitle text-muted mb-0 small">@Model.Subtitle</p>
                    }
                </div>
                <form method="post" action="@Model.DismissUrl" class="onboarding-checklist-dismiss">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-secondary">إخفاء</button>
                </form>
            </div>

            <div class="onboarding-checklist-progress mt-3 mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1 small">
                    <span class="text-muted">الخطوات الأساسية</span>
                    <span class="fw-semibold">@Model.CompletedRequired / @Model.TotalRequired</span>
                </div>
                <div class="progress" style="height: 8px;" role="progressbar"
                     aria-valuenow="@Model.ProgressPercent" aria-valuemin="0" aria-valuemax="100"
                     aria-label="تقدم التهيئة">
                    <div class="progress-bar bg-primary" style="width: @(Model.ProgressPercent)%"></div>
                </div>
            </div>

            <ul class="onboarding-checklist-items list-unstyled mb-0">
                @foreach (var item in Model.Items)
                {
                    <li class="onboarding-checklist-item @(item.IsCompleted ? "is-done" : "")">
                        <span class="onboarding-checklist-status" aria-hidden="true">
                            @if (item.IsCompleted)
                            {
                                <i class="fas fa-check-circle text-success"></i>
                            }
                            else
                            {
                                <i class="far fa-circle text-muted"></i>
                            }
                        </span>
                        <div class="onboarding-checklist-body">
                            <div class="d-flex flex-wrap align-items-start justify-content-between gap-2">
                                <div>
                                    <strong class="onboarding-checklist-item-title">
                                        @item.Title
                                        @if (!item.IsRequired)
                                        {
                                            <span class="badge bg-light text-muted border ms-1">اختياري</span>
                                        }
                                    </strong>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <p class="small text-muted mb-0 mt-1">@item.Description</p>
                                    }
                                </div>
                                @if (!item.IsCompleted)
                                {
                                    <a href="@item.ActionUrl" class="btn btn-sm btn-primary micro-btn flex-shrink-0">@item.ActionLabel</a>
                                }
                            </div>
                        </div>
                    </li>
                }
            </ul>
        </div>
    </section>
}
