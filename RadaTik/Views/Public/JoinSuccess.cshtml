@{
    ViewData["Title"] = "تم تقديم الطلب";
    Layout = "~/Views/Shared/_PublicLayout.cshtml";
}

<style>
    .success-section {
        min-height: calc(100vh - 300px);
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--light);
        padding: 150px 30px 80px;
    }

    .success-card {
        background: white;
        border-radius: 20px;
        padding: 60px;
        text-align: center;
        max-width: 600px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
    }

    .success-icon {
        width: 120px;
        height: 120px;
        background: linear-gradient(135deg, rgba(0, 200, 83, 0.1) 0%, rgba(0, 200, 83, 0.2) 100%);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 30px;
        animation: scaleIn 0.5s ease;
    }

    .success-icon i {
        font-size: 60px;
        color: var(--secondary);
        animation: checkmark 0.5s ease 0.3s forwards;
        opacity: 0;
    }

    @@keyframes scaleIn {
        from {
            transform: scale(0);
        }
        to {
            transform: scale(1);
        }
    }

    @@keyframes checkmark {
        from {
            opacity: 0;
            transform: scale(0);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    .success-title {
        font-size: 32px;
        font-weight: 800;
        color: var(--dark);
        margin-bottom: 15px;
    }

    .success-message {
        color: var(--gray);
        font-size: 18px;
        line-height: 1.8;
        margin-bottom: 30px;
    }

    .success-steps {
        background: var(--light);
        border-radius: 15px;
        padding: 30px;
        margin-bottom: 30px;
        text-align: right;
    }

    .success-steps h4 {
        font-size: 18px;
        font-weight: 700;
        color: var(--dark);
        margin-bottom: 20px;
        text-align: center;
    }

    .success-step {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 15px 0;
        border-bottom: 1px solid #e0e0e0;
    }

    .success-step:last-child {
        border-bottom: none;
    }

    .success-step-number {
        width: 36px;
        height: 36px;
        background: var(--gradient-primary);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-weight: 700;
        flex-shrink: 0;
    }

    .success-step span {
        color: var(--gray);
    }

    .success-actions {
        display: flex;
        gap: 15px;
        justify-content: center;
        flex-wrap: wrap;
    }

    .success-btn {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        padding: 16px 32px;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.3s;
    }

    .success-btn-primary {
        background: var(--gradient-primary);
        color: white;
    }

    .success-btn-primary:hover {
        transform: translateY(-3px);
        box-shadow: 0 10px 30px rgba(0, 102, 204, 0.3);
    }

    .success-btn-secondary {
        background: var(--light);
        color: var(--dark);
    }

    .success-btn-secondary:hover {
        background: #e9ecef;
    }

    @@media (max-width: 576px) {
        .success-card {
            padding: 40px 25px;
        }

        .success-title {
            font-size: 26px;
        }

        .success-actions {
            flex-direction: column;
        }

        .success-btn {
            justify-content: center;
        }
    }
</style>

<section class="success-section">
    <div class="success-card">
        <div class="success-icon">
            <i class="fas fa-check"></i>
        </div>

        <h1 class="success-title">تم تقديم طلبك بنجاح!</h1>
        <p class="success-message">
            شكراً لاهتمامك بخدماتنا. تم استلام طلبك وسيتم مراجعته من قبل فريقنا والتواصل معك في أقرب وقت ممكن.
        </p>

        <div class="success-steps">
            <h4>الخطوات التالية</h4>
            <div class="success-step">
                <div class="success-step-number">1</div>
                <span>مراجعة طلبك من قبل الفريق المختص</span>
            </div>
            <div class="success-step">
                <div class="success-step-number">2</div>
                <span>التواصل معك هاتفياً للتأكيد</span>
            </div>
            <div class="success-step">
                <div class="success-step-number">3</div>
                <span>تحديد موعد للتركيب أو المقابلة</span>
            </div>
        </div>

        <div class="success-actions">
            <a href="@Url.Action("Index", "Public")" class="success-btn success-btn-primary">
                <i class="fas fa-home"></i>
                الصفحة الرئيسية
            </a>
            <a href="@Url.Action("Contact", "Public")" class="success-btn success-btn-secondary">
                <i class="fas fa-phone"></i>
                تواصل معنا
            </a>
        </div>
    </div>
</section>
