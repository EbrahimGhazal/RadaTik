@using RadaTik.Models
@using RadaTik.Services
@model ClientOperationsHubViewModel
@{
    var area = ViewContext.RouteData.Values["area"]?.ToString() ?? "CompanyAdmin";
    string StatusLabel(SubscriberInstallationInvoiceStatus s) => s switch
    {
        SubscriberInstallationInvoiceStatus.Draft => "مسودة",
        SubscriberInstallationInvoiceStatus.Finalized => "مُصدَّرة",
        SubscriberInstallationInvoiceStatus.Paid => "مسددة",
        SubscriberInstallationInvoiceStatus.PartiallyPaid => "مسددة جزئياً",
        SubscriberInstallationInvoiceStatus.PendingWalletPayment => "بانتظار الدفع",
        SubscriberInstallationInvoiceStatus.Cancelled => "ملغاة",
        _ => s.ToString()
    };
}

@if (Model != null)
{
<div class="card mb-4 border-primary">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center flex-wrap gap-2">
        <h5 class="mb-0"><i class="fas fa-layer-group"></i> ملف العمليات المتكامل</h5>
        <a asp-area="@area" asp-controller="NewSubscriberWizard" asp-action="Resume" asp-route-clientId="@Model.ClientId"
           class="btn btn-sm btn-light">
            <i class="fas fa-route"></i> متابعة المعالج
        </a>
    </div>
    <div class="card-body">
        @if (Model.IsPendingApproval)
        {
            <div class="alert alert-warning mb-3">
                <i class="fas fa-hourglass-half"></i>
                المشترك <strong>بانتظار موافقة المدير</strong> على التفعيل وMikroTik.
                @if (Model.PendingApprovalRequestId.HasValue && User.IsInRole("NetworkAdministrator"))
                {
                    <a asp-area="CompanyAdmin" asp-controller="EmployeeServiceApprovals" asp-action="Index"
                       asp-route-focusRequestId="@Model.PendingApprovalRequestId" class="alert-link ms-1">
                        فتح طلب الموافقة
                    </a>
                }
            </div>
        }

        <div class="row g-3">
            <div class="col-md-6">
                <h6 class="text-muted">فاتورة التجهيز الأولي</h6>
                @if (Model.InstallationInvoice == null)
                {
                    <p class="small text-muted mb-0">لا توجد فاتورة تركيب — أنشئها من معالج المشترك الجديد.</p>
                }
                else
                {
                    var inv = Model.InstallationInvoice;
                    <ul class="list-unstyled small mb-2">
                        <li><strong>رقم:</strong> #@inv.Id</li>
                        <li><strong>الحالة:</strong> @StatusLabel(inv.Status)</li>
                        <li><strong>الإجمالي:</strong> @inv.TotalAmount.ToString("N0") ل.س</li>
                        <li><strong>المتبقي:</strong> @inv.RemainingAmount.ToString("N0") ل.س</li>
                    </ul>
                    <div class="d-flex flex-wrap gap-2">
                        <a asp-area="@area" asp-controller="SubscriberInstallationInvoices" asp-action="Details" asp-route-id="@inv.Id"
                           class="btn btn-sm btn-outline-primary">تفاصيل الفاتورة</a>
                        @if (inv.CanFinalizeInWizard)
                        {
                            <a asp-area="@area" asp-controller="NewSubscriberWizard" asp-action="Resume" asp-route-clientId="@Model.ClientId"
                               class="btn btn-sm btn-warning">إكمال الإصدار في المعالج</a>
                        }
                        @if (inv.CanCollectPayment)
                        {
                            <a asp-area="@area" asp-controller="NewSubscriberWizard" asp-action="CollectPayment" asp-route-id="@inv.Id"
                               class="btn btn-sm btn-success">تحصيل</a>
                        }
                    </div>
                }
            </div>
            <div class="col-md-6">
                <h6 class="text-muted">الجدول الزمني</h6>
                <ul class="list-unstyled small mb-0">
                @foreach (var t in Model.Timeline)
                {
                    <li class="mb-1">
                        <span class="text-muted">@t.At.ToString("yyyy-MM-dd HH:mm")</span> — @t.Label
                        @if (!string.IsNullOrWhiteSpace(t.Detail)) { <br /><span>@t.Detail</span> }
                    </li>
                }
                </ul>
            </div>
        </div>
    </div>
</div>
}
