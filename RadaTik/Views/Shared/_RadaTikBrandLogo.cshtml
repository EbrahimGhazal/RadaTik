@* شعار RADATIK الرسمي (صورة كاملة + أيقونة للطّي) *@
@{
    var variant = (ViewData["RtBrandVariant"] as string ?? "default").ToLowerInvariant();
    var forceMark = string.Equals(ViewData["RtBrandMarkOnly"] as string, "true", StringComparison.OrdinalIgnoreCase)
                    || (ViewData["RtBrandMarkOnly"] as bool?) == true;
    var blockClass = forceMark
        ? $"rt-brand-block rt-brand-block--{variant} rt-brand-block--mark-only"
        : $"rt-brand-block rt-brand-block--{variant}";
}
<div class="@blockClass" dir="ltr" translate="no">
    <img class="rt-logo-img rt-logo-full"
         src="~/images/brand/radatik-logo.png"
         asp-append-version="true"
         alt="RADATIK technology L.L.C"
         width="220"
         height="61" />
    <img class="rt-logo-img rt-logo-mark"
         src="~/images/brand/radatik-mark.png"
         asp-append-version="true"
         alt=""
         aria-hidden="true"
         width="40"
         height="40" />
</div>
