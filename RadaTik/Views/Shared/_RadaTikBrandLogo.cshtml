@* شعار RADATIK — تصميم SVG متجه (يتكيّف مع خلفية الموضع والوضع الداكن) *@
@{
    var variant = (ViewData["RtBrandVariant"] as string ?? "default").ToLowerInvariant();
    var forceMark = string.Equals(ViewData["RtBrandMarkOnly"] as string, "true", StringComparison.OrdinalIgnoreCase)
                    || (ViewData["RtBrandMarkOnly"] as bool?) == true;
    var blockClass = forceMark
        ? $"rt-brand-block rt-brand-block--{variant} rt-brand-block--mark-only"
        : $"rt-brand-block rt-brand-block--{variant}";
}
<div class="@blockClass" dir="ltr" translate="no" role="img" aria-label="RADATIK technology L.L.C">
    <svg class="rt-logo-svg rt-logo-mark" viewBox="0 0 100 92" width="40" height="37" aria-hidden="true" focusable="false">
        <g fill="none" stroke-linecap="butt" stroke-linejoin="round">
            <path class="rt-logo-orange" stroke-width="12"
                  d="M46 14 H88 M74 14 V80" />
            <path class="rt-logo-orange-trace" stroke-width="1.8"
                  d="M52 14 H82 M74 20 V74" />
            <circle class="rt-logo-orange-trace" cx="52" cy="14" r="2.2" />
            <circle class="rt-logo-orange-trace" cx="82" cy="14" r="2.2" />
            <circle class="rt-logo-orange-trace" cx="74" cy="74" r="2.2" />
        </g>
        <g fill="none" stroke-linecap="butt" stroke-linejoin="round">
            <path class="rt-logo-navy" stroke-width="12"
                  d="M16 80 V14 H52 V14 H52 C66 14 66 14 66 31 C66 48 66 48 52 48 H16 M48 48 L70 80" />
            <path class="rt-logo-navy-trace" stroke-width="1.8"
                  d="M16 74 V20 H50 C58 20 58 20 58 31 C58 42 58 42 50 42 H22 M50 50 L64 72" />
            <circle class="rt-logo-navy-trace" cx="16" cy="74" r="2.2" />
            <circle class="rt-logo-navy-trace" cx="16" cy="20" r="2.2" />
            <circle class="rt-logo-navy-trace" cx="50" cy="20" r="2.2" />
            <circle class="rt-logo-navy-trace" cx="22" cy="42" r="2.2" />
            <circle class="rt-logo-navy-trace" cx="64" cy="72" r="2.2" />
        </g>
    </svg>

    <svg class="rt-logo-svg rt-logo-full" viewBox="0 0 330 92" width="210" height="58" aria-hidden="true" focusable="false">
        <g fill="none" stroke-linecap="butt" stroke-linejoin="round">
            <path class="rt-logo-orange" stroke-width="12"
                  d="M46 14 H88 M74 14 V80" />
            <path class="rt-logo-orange-trace" stroke-width="1.8"
                  d="M52 14 H82 M74 20 V74" />
            <circle class="rt-logo-orange-trace" cx="52" cy="14" r="2.2" />
            <circle class="rt-logo-orange-trace" cx="82" cy="14" r="2.2" />
            <circle class="rt-logo-orange-trace" cx="74" cy="74" r="2.2" />
        </g>
        <g fill="none" stroke-linecap="butt" stroke-linejoin="round">
            <path class="rt-logo-navy" stroke-width="12"
                  d="M16 80 V14 H52 V14 H52 C66 14 66 14 66 31 C66 48 66 48 52 48 H16 M48 48 L70 80" />
            <path class="rt-logo-navy-trace" stroke-width="1.8"
                  d="M16 74 V20 H50 C58 20 58 20 58 31 C58 42 58 42 50 42 H22 M50 50 L64 72" />
            <circle class="rt-logo-navy-trace" cx="16" cy="74" r="2.2" />
            <circle class="rt-logo-navy-trace" cx="16" cy="20" r="2.2" />
            <circle class="rt-logo-navy-trace" cx="50" cy="20" r="2.2" />
            <circle class="rt-logo-navy-trace" cx="22" cy="42" r="2.2" />
            <circle class="rt-logo-navy-trace" cx="64" cy="72" r="2.2" />
        </g>
        <g class="rt-logo-wordmark">
            <text class="rt-logo-word" x="108" y="44" font-family="Poppins, Arial, Helvetica, sans-serif"
                  font-size="30" font-weight="700" letter-spacing="0.045em">RADATIK</text>
            <text class="rt-logo-sub" x="110" y="68" font-family="Poppins, Arial, Helvetica, sans-serif"
                  font-size="13" font-weight="500" letter-spacing="0.02em">technology L.L.C</text>
        </g>
    </svg>
</div>
