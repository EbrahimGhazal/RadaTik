@{
    var userName = ViewData["Layout_UserName"] as string ?? (User.Identity?.Name ?? "مستخدم");
    var userInitials = ViewData["Layout_UserInitials"] as string ?? (userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "م");
    var userRole = ViewData["Layout_UserRole"] as string ?? "";
    var isCompanyEmployee = (bool?)(ViewData["Layout_IsCompanyEmployee"]) == true;
    var employeeNetworkName = ViewData["Layout_EmployeeNetworkName"] as string;

    var hasProfileOrHub =
        User.IsInRole("SystemAdministrator") ||
        User.IsInRole("NetworkAdministrator") ||
        User.IsInRole("Client") ||
        User.IsInRole("CollectionPoint") ||
        isCompanyEmployee;
}

<div class="dropdown header-user-wrapper">
    <button type="button" class="header-user" id="userDropdownToggle"
            data-bs-toggle="dropdown" data-bs-target="#userDropdown" data-bs-display="dynamic"
            data-bs-auto-close="true"
            aria-haspopup="menu" aria-expanded="false" aria-controls="userDropdown">
        <div class="header-user-avatar" aria-hidden="true">@userInitials</div>
        <div class="header-user-info">
            <div class="header-user-name">@userName</div>
            <div class="header-user-role">@userRole</div>
            @if (isCompanyEmployee && !string.IsNullOrWhiteSpace(employeeNetworkName))
            {
                <div class="header-user-role text-muted small">@employeeNetworkName</div>
            }
        </div>
        <i class="fas fa-chevron-down header-user-chevron" aria-hidden="true"></i>
    </button>

    <div class="dropdown-menu dropdown-menu-end header-user-dropdown" id="userDropdown" role="menu" aria-labelledby="userDropdownToggle">
        @if (User.IsInRole("SystemAdministrator"))
        {
            <a class="dropdown-item" role="menuitem" asp-route="systemAdmin-account-profile">
                <i class="fas fa-user" aria-hidden="true"></i> الملف الشخصي
            </a>
        }
        else if (User.IsInRole("NetworkAdministrator"))
        {
            <a class="dropdown-item" role="menuitem" asp-route="networkManager-account-profile">
                <i class="fas fa-user" aria-hidden="true"></i> الملف الشخصي
            </a>
        }
        else if (User.IsInRole("Client"))
        {
            <a class="dropdown-item" role="menuitem" asp-route="clientPortal-actions" asp-route-action="MyProfile">
                <i class="fas fa-user-edit" aria-hidden="true"></i> بروفايل العميل
            </a>
        }
        else if (User.IsInRole("CollectionPoint"))
        {
            <a class="dropdown-item" role="menuitem" asp-route="collectionPoint-actions" asp-route-action="Index">
                <i class="fas fa-cash-register" aria-hidden="true"></i> لوحة التحصيل
            </a>
        }
        else if (isCompanyEmployee)
        {
            <a class="dropdown-item" role="menuitem" asp-route="employee-dashboard">
                <i class="fas fa-tachometer-alt" aria-hidden="true"></i> لوحة التحكم
            </a>
        }

        @if (hasProfileOrHub)
        {
            <div class="dropdown-divider"></div>
        }

        <form asp-route="reglog-logout" method="post" class="m-0">
            @Html.AntiForgeryToken()
            <button type="submit" class="dropdown-item text-danger w-100 text-end" role="menuitem">
                <i class="fas fa-sign-out-alt" aria-hidden="true"></i> تسجيل الخروج
            </button>
        </form>
    </div>
</div>
