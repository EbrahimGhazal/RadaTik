@{
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString()
        ?? "CompanyAdmin";
}
<script type="application/json" id="receiverSectorsMapJson">@Html.Raw(ViewBag.MapDataJson ?? "[]")</script>
    <script>
        (function () {
            function bootReceiverMap() {
            if (typeof L === 'undefined') {
                return;
            }

            // بيانات القطاعات من الخادم (JSON منفصل لتجنب كسر السكربت بسبب علامات التنصيص أو HTML)
            var mapJsonEl = document.getElementById('receiverSectorsMapJson');
            var raw = mapJsonEl && mapJsonEl.textContent ? mapJsonEl.textContent.trim() : '[]';
            var sectors = [];
            try { sectors = JSON.parse(raw); } catch (e) { sectors = []; }

            var getSectorInfoUrl = '@Url.Action("GetSectorInfo", "Receiver", new { area = currentArea })';
            var analyzeLosUrl = '@Url.Action("AnalyzeLineOfSight", "Receiver", new { area = currentArea })';
            var calibrateAlignmentUrl = '@Url.Action("CalibrateAlignment", "Receiver", new { area = currentArea })';
            var calibrateLiveSignalUrl = '@Url.Action("CalibrateLiveSignal", "Receiver", new { area = currentArea })';
            var getElevationAtUrl = '@Url.Action("GetElevationAtPoint", "Receiver", new { area = currentArea })';
            var getNextIpUrl = '@Url.Action("GetNextReceiverIP", "Receiver", new { area = currentArea })';
            var sectorServerFilter = document.getElementById('sectorServerFilter');

            var sectorSelect = document.getElementById('sectorSelect');
            var ipInput = document.getElementById('ipAddressInput');
            var maskInput = document.getElementById('networkMaskInput');
            var latInput = document.getElementById('latitudeInput');
            var lngInput = document.getElementById('longitudeInput');
            var distanceInput = document.getElementById('distanceFromSector');
            var distanceStatus = document.getElementById('distanceStatus');
            var receiversCount = document.getElementById('receiversCount');
            var sectorIPRange = document.getElementById('sectorIPRange');
            var sectorInfo = document.getElementById('sectorInfo');
            var sectorInfoPlaceholder = document.getElementById('sectorInfoPlaceholder');
            var selectedSector = null;
            var receiverElevInput = document.getElementById('receiverElevationInput');
            var receiverAglInput = document.getElementById('receiverAntennaAglInput');
            var receiverElevationHint = document.getElementById('receiverElevationHint');
            var defaultReceiverAntennaM = 6;
            var terrainFetchToken = 0;

            if (!sectorSelect || !document.getElementById('map')) {
                return;
            }

            // إنشاء الخريطة بدون أي قطاع مبدئيًا
            var defaultLat = 35.5200;
            var defaultLng = 35.7800;
            var mapEl = document.getElementById('map');
            var map = L.map(mapEl || 'map', {
                zoomControl: true,
                attributionControl: true
            }).setView([defaultLat, defaultLng], 10);
            if (map.zoomControl) {
                map.zoomControl.setPosition('topleft');
            }

            var streetLayer = L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap', maxZoom: 19
            }).addTo(map);
            streetLayer.on('load', refreshMapLayout);

            var satelliteLayer = L.tileLayer('https://{s}.google.com/vt/lyrs=s&x={x}&y={y}&z={z}', {
                maxZoom: 20, subdomains: ['mt0', 'mt1', 'mt2', 'mt3']
            });

            var terrainLayer = L.tileLayer('https://{s}.tile.opentopomap.org/{z}/{x}/{y}.png', { maxZoom: 17 });

            var currentSectorMarker = null;
            var currentCoverage = null;
            var currentDirectionLine = null;
            var currentReceiversLayer = null;
            var receiverMarker = null;
            var losAnalysisLayerGroup = null;
            var calibrationLayerGroup = null;

            var sectorsById = {};
            sectors.forEach(function (s) {
                sectorsById[String(s.id)] = s;
            });

            function isNarrowMap() {
                return window.matchMedia('(max-width: 991.98px)').matches;
            }

            function refreshMapLayout() {
                requestAnimationFrame(function () {
                    try { map.invalidateSize({ animate: false, pan: false }); } catch (e) { /* ignore */ }
                    setTimeout(function () { try { map.invalidateSize({ animate: false, pan: false }); } catch (e2) { /* ignore */ } }, 80);
                    setTimeout(function () { try { map.invalidateSize({ animate: false, pan: false }); } catch (e3) { /* ignore */ } }, 320);
                });
            }

            if (typeof ResizeObserver !== 'undefined' && mapEl) {
                var mapSizeObserver = new ResizeObserver(function () { refreshMapLayout(); });
                mapSizeObserver.observe(mapEl);
                var wrapEl = document.getElementById('receiverMapWrap');
                if (wrapEl) {
                    mapSizeObserver.observe(wrapEl);
                }
            }
            window.addEventListener('resize', refreshMapLayout);
            window.addEventListener('orientationchange', function () {
                setTimeout(refreshMapLayout, 250);
            });
            if (window.visualViewport) {
                window.visualViewport.addEventListener('resize', refreshMapLayout);
            }
            map.whenReady(refreshMapLayout);

            function clearLosAnalysisOverlay() {
                if (losAnalysisLayerGroup) {
                    map.removeLayer(losAnalysisLayerGroup);
                    losAnalysisLayerGroup = null;
                }
            }

            function clearCalibrationOverlay() {
                if (calibrationLayerGroup) {
                    map.removeLayer(calibrationLayerGroup);
                    calibrationLayerGroup = null;
                }
            }

            function activateToolTab(name) {
                document.querySelectorAll('.receiver-tool-tab').forEach(function (btn) {
                    var on = btn.getAttribute('data-tool-tab') === name;
                    btn.classList.toggle('is-active', on);
                    btn.setAttribute('aria-selected', on ? 'true' : 'false');
                });
                document.querySelectorAll('.receiver-tool-pane').forEach(function (pane) {
                    var on = pane.getAttribute('data-tool-pane') === name;
                    pane.classList.toggle('d-none', !on);
                });
                if (name === 'calibrate' && lastCalibrateOk) {
                    startLiveSignalPoll();
                } else {
                    stopLiveSignalPoll();
                    if (name !== 'calibrate') {
                        stopPhoneCompass(false);
                    }
                }
                refreshMapLayout();
            }

            function heightSourceLabel(source) {
                if (source === 'osm_height') return 'من وسم الارتفاع في الخريطة';
                if (source === 'levels') return 'من عدد الطوابق';
                if (source === 'vegetation_type') return 'تقدير غطاء نباتي';
                return 'تقدير حسب نوع المبنى';
            }

            function isVegetationObstacle(b) {
                return b && b.obstacleKind === 'vegetation';
            }

            function heightConfidenceLabel(conf) {
                if (conf === 'high') return 'موثّق';
                if (conf === 'medium') return 'متوسط';
                return 'تقديري';
            }

            function losNum(v, digits) {
                var n = Number(v);
                return isFinite(n) ? n.toFixed(digits == null ? 1 : digits) : '—';
            }

            /** رسم خط المسار + مبانٍ تعيق + أضيق نقطة بعد نجاح التحليل */
            function renderLosAnalysisOnMap(analysis) {
                clearLosAnalysisOverlay();
                if (!selectedSector || !isFinite(selectedSector.latitude) || !isFinite(selectedSector.longitude)) {
                    return;
                }
                var lat0 = selectedSector.latitude;
                var lon0 = selectedSector.longitude;
                var lat1 = parseFloat(latInput.value);
                var lon1 = parseFloat(lngInput.value);
                if (!isFinite(lat1) || !isFinite(lon1)) {
                    return;
                }

                losAnalysisLayerGroup = L.layerGroup();

                var pathLine = L.polyline([[lat0, lon0], [lat1, lon1]], {
                    color: '#fd7e14',
                    weight: 3,
                    opacity: 0.9,
                    dashArray: '10,7'
                });
                pathLine.bindPopup('مسار خط الرؤية (تقريبي بين الهوائيات)');
                losAnalysisLayerGroup.addLayer(pathLine);

                var distTotal = analysis.distanceMeters || 0;
                if (distTotal > 0 && analysis.profile && analysis.profile.length) {
                    var worst = null;
                    analysis.profile.forEach(function (p) {
                        var score = p.fresnelMarginMeters != null ? p.fresnelMarginMeters : p.marginMeters;
                        if (worst == null || score < worst._score) {
                            worst = p;
                            worst._score = score;
                        }
                    });
                    if (worst && (worst.marginMeters < 2 || worst.fresnelMarginMeters < 0)) {
                        var t = worst.distanceFromStartMeters / distTotal;
                        if (isFinite(t)) {
                            t = Math.max(0, Math.min(1, t));
                            var wlat = lat0 + t * (lat1 - lat0);
                            var wlon = lon0 + t * (lon1 - lon0);
                            var wm = L.circleMarker([wlat, wlon], {
                                radius: 8,
                                color: '#e0a800',
                                fillColor: '#ffc107',
                                fillOpacity: 0.95,
                                weight: 2
                            });
                            wm.bindPopup(
                                'أضيق نقطة على المسار<br>' +
                                'هامش التضاريس: ' + losNum(worst.marginMeters) + ' م<br>' +
                                'هامش فريسنل: ' + losNum(worst.fresnelMarginMeters) + ' م'
                            );
                            losAnalysisLayerGroup.addLayer(wm);
                        }
                    }
                }

                var buildings = analysis.buildingObstructions || [];
                buildings.forEach(function (b) {
                    if (!isFinite(b.lat) || !isFinite(b.lon)) {
                        return;
                    }
                    if (!b.likelyBlocksLos && !b.likelyBlocksFresnel) {
                        return;
                    }
                    var veg = isVegetationObstacle(b);
                    var color = veg
                        ? (b.likelyBlocksLos ? '#2f9e44' : '#74b816')
                        : (b.likelyBlocksLos ? '#dc3545' : '#e8590c');
                    var title = veg
                        ? (b.likelyBlocksLos ? 'شجر/غابة — يعترض خط الرؤية' : 'شجر/غابة — يدخل منطقة فريسنل')
                        : (b.likelyBlocksLos ? 'مبنى — يعترض خط الرؤية' : 'مبنى — يدخل منطقة فريسنل');
                    var iconHtml = veg
                        ? '<i class="fas fa-tree"></i>'
                        : '<i class="fas fa-building"></i>';
                    var icon = L.divIcon({
                        className: 'los-building-marker',
                        html: '<div style="background:' + color + ';width:28px;height:28px;border-radius:50%;border:2px solid #fff;box-shadow:0 1px 5px rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center;color:#fff;font-size:11px;">' + iconHtml + '</div>',
                        iconSize: [28, 28],
                        iconAnchor: [14, 14]
                    });
                    var m = L.marker([b.lat, b.lon], { icon: icon });
                    m.bindPopup(
                        '<strong>' + title + '</strong><br>' +
                        'سقف تقريبي: ' + losNum(b.roofMslMeters) + ' م<br>' +
                        'خط الرؤية هنا: ' + losNum(b.lineHeightAtPointMslMeters) + ' م<br>' +
                        'جانبي عن المسار: ~' + losNum(b.crossTrackMeters) + ' م' +
                        (b.intersectsPath ? ' (يعترض المضلع المسار)' : '') + '<br>' +
                        'الارتفاع: ' + heightSourceLabel(b.heightSource) +
                        ' (' + heightConfidenceLabel(b.heightConfidence) + ')'
                    );
                    losAnalysisLayerGroup.addLayer(m);
                });

                losAnalysisLayerGroup.addTo(map);
                try {
                    var bounds = losAnalysisLayerGroup.getBounds();
                    if (bounds.isValid()) {
                        map.fitBounds(bounds.pad(0.15));
                    }
                } catch (e) { /* ignore */ }
            }

            function renderLosProfileChart(analysis) {
                var profile = analysis.profile || [];
                if (profile.length < 2) {
                    return '';
                }
                var w = 640, h = 190, padL = 48, padR = 16, padT = 14, padB = 32;
                var innerW = w - padL - padR;
                var innerH = h - padT - padB;
                var distMax = analysis.distanceMeters || profile[profile.length - 1].distanceFromStartMeters || 1;
                var yMin = Infinity, yMax = -Infinity;
                profile.forEach(function (p) {
                    var terr = p.effectiveTerrainMslMeters != null ? p.effectiveTerrainMslMeters : p.terrainElevationMslMeters;
                    yMin = Math.min(yMin, terr, p.lineHeightMslMeters, p.fresnelFloorMslMeters);
                    yMax = Math.max(yMax, terr, p.lineHeightMslMeters);
                });
                (analysis.buildingObstructions || []).forEach(function (b) {
                    if (b.roofMslMeters != null) {
                        yMin = Math.min(yMin, b.roofMslMeters);
                        yMax = Math.max(yMax, b.roofMslMeters);
                    }
                });
                if (!isFinite(yMin) || !isFinite(yMax) || yMax <= yMin) {
                    yMin -= 5;
                    yMax += 5;
                }
                var padY = Math.max(2, (yMax - yMin) * 0.08);
                yMin -= padY;
                yMax += padY;
                function xOf(d) { return padL + (d / distMax) * innerW; }
                function yOf(v) { return padT + (1 - (v - yMin) / (yMax - yMin)) * innerH; }
                function pts(getter) {
                    return profile.map(function (p) {
                        return xOf(p.distanceFromStartMeters).toFixed(1) + ',' + yOf(getter(p)).toFixed(1);
                    }).join(' ');
                }
                var terrainPts = pts(function (p) {
                    return p.effectiveTerrainMslMeters != null ? p.effectiveTerrainMslMeters : p.terrainElevationMslMeters;
                });
                var area = xOf(0).toFixed(1) + ',' + yOf(yMin).toFixed(1) + ' ' +
                    terrainPts + ' ' +
                    xOf(profile[profile.length - 1].distanceFromStartMeters).toFixed(1) + ',' + yOf(yMin).toFixed(1);
                var losPts = pts(function (p) { return p.lineHeightMslMeters; });
                var fresnelPts = pts(function (p) { return p.fresnelFloorMslMeters; });
                var bMarks = '';
                (analysis.buildingObstructions || []).forEach(function (b) {
                    if (!b.likelyBlocksLos && !b.likelyBlocksFresnel) return;
                    var d = (b.pathFraction || 0) * distMax;
                    var veg = isVegetationObstacle(b);
                    var color = veg
                        ? (b.likelyBlocksLos ? '#2f9e44' : '#74b816')
                        : (b.likelyBlocksLos ? '#dc3545' : '#e8590c');
                    var label = veg ? 'غطاء نباتي ' : 'سقف مبنى ';
                    bMarks += '<circle cx="' + xOf(d).toFixed(1) + '" cy="' + yOf(b.roofMslMeters).toFixed(1) +
                        '" r="4" fill="' + color + '" stroke="#fff" stroke-width="1"><title>' + label +
                        losNum(b.roofMslMeters) + ' م</title></circle>';
                });
                return '<div class="los-profile-wrap" dir="ltr">' +
                    '<svg class="los-profile-svg" viewBox="0 0 ' + w + ' ' + h + '" role="img" aria-label="مقطع ارتفاع خط الرؤية">' +
                    '<polygon points="' + area + '" fill="rgba(120, 90, 50, 0.22)"></polygon>' +
                    '<polyline points="' + terrainPts + '" fill="none" stroke="#8d6e4a" stroke-width="2"></polyline>' +
                    '<polyline points="' + fresnelPts + '" fill="none" stroke="#7c3aed" stroke-width="1.6" stroke-dasharray="5 4"></polyline>' +
                    '<polyline points="' + losPts + '" fill="none" stroke="#fd7e14" stroke-width="2.4"></polyline>' +
                    bMarks +
                    '<text x="' + padL + '" y="' + (h - 8) + '" font-size="11" fill="currentColor">قطاع</text>' +
                    '<text x="' + (w - padR - 52) + '" y="' + (h - 8) + '" font-size="11" fill="currentColor">مستقبل</text>' +
                    '<text x="6" y="' + (padT + 4) + '" font-size="10" fill="currentColor">' + losNum(yMax, 0) + ' م</text>' +
                    '<text x="6" y="' + (h - padB) + '" font-size="10" fill="currentColor">' + losNum(yMin, 0) + ' م</text>' +
                    '</svg>' +
                    '<div class="los-profile-legend">' +
                    '<span><i class="los-lg los-lg-terrain"></i> التضاريس</span>' +
                    '<span><i class="los-lg los-lg-los"></i> خط الرؤية</span>' +
                    '<span><i class="los-lg los-lg-fresnel"></i> أرضية فريسنل 60٪</span>' +
                    '<span><i class="los-lg los-lg-bldg"></i> مبنى حاجب</span>' +
                    '<span><i class="los-lg los-lg-veg"></i> شجر/غابة</span>' +
                    '</div></div>';
            }

            /** يملأ ارتفاع الأرض (Open-Elevation عبر الخادم) وارتفاع الهوائي الافتراضي عند تحديد موقع على الخريطة */
            function refreshReceiverTerrainFromMap(lat, lng) {
                clearLosAnalysisOverlay();
                if (!receiverElevInput || !receiverAglInput) {
                    return;
                }
                if (!isFinite(lat) || !isFinite(lng)) {
                    return;
                }
                receiverAglInput.value = String(defaultReceiverAntennaM);
                receiverElevInput.value = '';
                receiverElevInput.placeholder = 'جارٍ جلب الارتفاع...';
                if (receiverElevationHint) {
                    receiverElevationHint.textContent = 'جارٍ جلب الارتفاع من نموذج التضاريس...';
                }
                var myToken = ++terrainFetchToken;
                var url = getElevationAtUrl + '?lat=' + encodeURIComponent(lat) + '&lon=' + encodeURIComponent(lng);
                fetch(url, {
                    credentials: 'same-origin',
                    headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                    .then(function (r) {
                        return r.json();
                    })
                    .then(function (data) {
                        if (myToken !== terrainFetchToken) {
                            return;
                        }
                        receiverElevInput.placeholder = 'يُملأ عند النقر على الخريطة';
                        if (receiverElevationHint) {
                            receiverElevationHint.textContent = 'يُحدَّد تلقائياً عند اختيار موقع المستقبل على الخريطة (قابل للتعديل).';
                        }
                        if (data && data.success && data.elevationMeters != null) {
                            receiverElevInput.value = String(data.elevationMeters);
                        }
                    })
                    .catch(function () {
                        if (myToken !== terrainFetchToken) {
                            return;
                        }
                        receiverElevInput.placeholder = 'أدخل الارتفاع يدوياً أو أعد المحاولة';
                        if (receiverElevationHint) {
                            receiverElevationHint.textContent = 'تعذر جلب الارتفاع تلقائياً — يمكنك إدخاله يدوياً.';
                        }
                    });
            }

            function applySector(s) {
                if (!s) return;
                selectedSector = s;
                updateSectorInfoPanel(s);
                drawSelectedSector(s);
                if (maskInput && s.networkMask) {
                    maskInput.value = s.networkMask;
                }
                if (isFinite(s.latitude) && isFinite(s.longitude)) {
                    latInput.value = Number(s.latitude).toFixed(6);
                    lngInput.value = Number(s.longitude).toFixed(6);
                    updateReceiverMarker(s.latitude, s.longitude);
                    updateDistanceFromSector();
                    refreshReceiverTerrainFromMap(s.latitude, s.longitude);
                }
                refreshMapLayout();
            }

            /** مصدر الحقيقة: الخادم؛ القائمة المضمّنة احتياط عند فشل الشبكة */
            function loadSectorForMap(sectorId) {
                if (!sectorId) {
                    clearSectorInfo();
                    return;
                }
                fetch(getSectorInfoUrl + '?sectorId=' + encodeURIComponent(sectorId), {
                    credentials: 'same-origin',
                    headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                    .then(function (r) {
                        if (!r.ok) {
                            throw new Error('http_' + r.status);
                        }
                        var ct = r.headers.get('content-type') || '';
                        if (ct.indexOf('application/json') === -1) {
                            throw new Error('not_json');
                        }
                        return r.json();
                    })
                    .then(function (data) {
                        if (!data || !data.success || !data.sector) {
                            var fallback = sectorsById[String(sectorId)];
                            if (fallback) {
                                applySector(fallback);
                                return;
                            }
                            showAlert('تعذر تحميل بيانات القطاع للخريطة.', 'warning');
                            return;
                        }
                        var sec = data.sector;
                        var mapped = {
                            id: sec.id,
                            name: sec.name,
                            latitude: sec.latitude,
                            longitude: sec.longitude,
                            direction: sec.direction,
                            coverageAngle: sec.coverageAngle,
                            coverageRange: sec.coverageRange,
                            ipAddress: sec.ipAddress,
                            networkMask: sec.networkMask,
                            elevationMeters: sec.elevationMeters,
                            antennaHeightAglMeters: sec.antennaHeightAglMeters,
                            frequencyMhz: sec.frequencyMhz,
                            receivers: (data.receivers || []).map(function (r) {
                                return { id: r.id, name: r.name, latitude: r.latitude, longitude: r.longitude, ip: r.ip };
                            })
                        };
                        sectorsById[String(mapped.id)] = mapped;
                        applySector(mapped);
                    })
                    .catch(function () {
                        var fallback = sectorsById[String(sectorId)];
                        if (fallback) {
                            applySector(fallback);
                            return;
                        }
                        showAlert('تعذر الاتصال بالخادم لتحميل بيانات القطاع.', 'danger');
                    });
            }

            // تبديل نوع الخريطة
            document.querySelectorAll('.map-type-btn').forEach(function (button) {
                button.addEventListener('click', function () {
                    document.querySelectorAll('.map-type-btn').forEach(function (btn) { btn.classList.remove('active'); });
                    this.classList.add('active');
                    map.removeLayer(streetLayer); map.removeLayer(satelliteLayer); map.removeLayer(terrainLayer);
                    switch (this.getAttribute('data-map-type')) {
                        case 'satellite': satelliteLayer.addTo(map); break;
                        case 'terrain': terrainLayer.addTo(map); break;
                        default: streetLayer.addTo(map);
                    }
                    refreshMapLayout();
                });
            });

            // عند اختيار قطاع — Select2 + تعبئة IP/القناع + الخريطة
            var activeServerFilter = '';
            function onSectorChosen() {
                var id = sectorSelect.value;
                if (!id) {
                    clearSectorInfo();
                    return;
                }
                var opt = sectorSelect.options[sectorSelect.selectedIndex];
                var maskFromOption = opt ? opt.getAttribute('data-network-mask') : '';
                if (maskInput && maskFromOption) {
                    maskInput.value = maskFromOption;
                }
                generateIPForSector(id);
                loadSectorForMap(id);
            }
            sectorSelect.addEventListener('change', onSectorChosen);
            if (typeof jQuery !== 'undefined') {
                function sectorMatcher(params, data) {
                    if (data == null || typeof data.text === 'undefined') {
                        return null;
                    }
                    if (data.id && activeServerFilter) {
                        var el = data.element;
                        var serverId = el ? (el.getAttribute('data-server-id') || '') : '';
                        if (String(serverId) !== String(activeServerFilter)) {
                            return null;
                        }
                    }
                    if (jQuery.trim(params.term || '') === '') {
                        return data;
                    }
                    if (data.text.toUpperCase().indexOf(params.term.toUpperCase()) > -1) {
                        return data;
                    }
                    return null;
                }

                jQuery(sectorSelect)
                    .off('change.rtMap select2:select.rtMap select2:clear.rtMap')
                    .on('change.rtMap', onSectorChosen)
                    .on('select2:select.rtMap', onSectorChosen)
                    .on('select2:clear.rtMap', function () { clearSectorInfo(); });

                if (jQuery(sectorSelect).hasClass('select2-hidden-accessible')) {
                    jQuery(sectorSelect).select2('destroy');
                }
                jQuery(sectorSelect).select2({
                    theme: 'bootstrap-5',
                    width: '100%',
                    placeholder: sectorSelect.getAttribute('data-placeholder') || 'ابحث عن القطاع...',
                    allowClear: true,
                    matcher: sectorMatcher,
                    language: {
                        noResults: function () { return 'لا توجد نتائج'; },
                        searching: function () { return 'جاري البحث...'; }
                    }
                });
            }

            function applySectorServerFilter() {
                if (!sectorServerFilter) return;
                activeServerFilter = sectorServerFilter.value || '';
                var current = sectorSelect.value;
                if (current) {
                    var opt = sectorSelect.querySelector('option[value="' + current.replace(/"/g, '\\"') + '"]');
                    var optServer = opt ? (opt.getAttribute('data-server-id') || '') : '';
                    if (activeServerFilter && String(optServer) !== String(activeServerFilter)) {
                        sectorSelect.value = '';
                        if (typeof jQuery !== 'undefined') {
                            jQuery(sectorSelect).val(null).trigger('change');
                        }
                        clearSectorInfo();
                        return;
                    }
                }
                if (typeof jQuery !== 'undefined') {
                    jQuery(sectorSelect).trigger('change.select2');
                }
            }

            if (sectorServerFilter) {
                sectorServerFilter.addEventListener('change', applySectorServerFilter);
            }

            // النقر على الخريطة لتغيير موقع المستقبل
            var mapTapHint = document.getElementById('mapTapHint');
            function hideMapTapHint() {
                if (mapTapHint) {
                    mapTapHint.classList.add('is-hidden');
                }
            }
            map.on('click', function (e) {
                hideMapTapHint();
                clearLosAnalysisOverlay();
                latInput.value = e.latlng.lat.toFixed(6);
                lngInput.value = e.latlng.lng.toFixed(6);
                updateReceiverMarker(e.latlng.lat, e.latlng.lng);
                updateDistanceFromSector();
                refreshReceiverTerrainFromMap(e.latlng.lat, e.latlng.lng);
            });

            var btnUseMyLocation = document.getElementById('btnUseMyLocation');
            if (btnUseMyLocation) {
                btnUseMyLocation.addEventListener('click', function () {
                    if (!navigator.geolocation) {
                        showAlert('المتصفح لا يدعم تحديد الموقع', 'warning');
                        return;
                    }
                    var prevHtml = btnUseMyLocation.innerHTML;
                    btnUseMyLocation.disabled = true;
                    btnUseMyLocation.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري التحديد...';
                    navigator.geolocation.getCurrentPosition(function (pos) {
                        var lat = pos.coords.latitude;
                        var lng = pos.coords.longitude;
                        hideMapTapHint();
                        clearLosAnalysisOverlay();
                        latInput.value = lat.toFixed(6);
                        lngInput.value = lng.toFixed(6);
                        updateReceiverMarker(lat, lng);
                        updateDistanceFromSector();
                        refreshReceiverTerrainFromMap(lat, lng);
                        map.setView([lat, lng], Math.max(map.getZoom() || 0, 17));
                        refreshMapLayout();
                        btnUseMyLocation.disabled = false;
                        btnUseMyLocation.innerHTML = prevHtml;
                    }, function () {
                        showAlert('تعذر الحصول على موقعك. اسمح بالوصول للموقع ثم أعد المحاولة.', 'warning');
                        btnUseMyLocation.disabled = false;
                        btnUseMyLocation.innerHTML = prevHtml;
                    }, { enableHighAccuracy: true, timeout: 12000, maximumAge: 8000 });
                });
            }

            var btnGenerateIP = document.getElementById('btnGenerateIP');
            if (btnGenerateIP) {
                btnGenerateIP.addEventListener('click', function () {
                    var sectorId = sectorSelect.value;
                    if (!sectorId) {
                        showAlert('يرجى اختيار القطاع أولاً', 'warning');
                        return;
                    }
                    generateIPForSector(sectorId);
                });
            }

            document.querySelectorAll('.btn-copy').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var inputId = this.getAttribute('data-copy');
                    var input = document.getElementById(inputId);
                    input.select();
                    navigator.clipboard.writeText(input.value || '');
                    showAlert('تم النسخ', 'success');
                });
            });

            var btnCheckConnection = document.getElementById('btnCheckConnection');
            if (btnCheckConnection) {
                btnCheckConnection.addEventListener('click', checkConnection);
            }

            function parseOptionalFloatInput(el) {
                if (!el || el.value === '' || el.value === null) {
                    return null;
                }
                var v = parseFloat(el.value);
                return isFinite(v) ? v : null;
            }

            function analyzeLineOfSight() {
                var sectorId = sectorSelect.value;
                if (!sectorId) {
                    showAlert('يرجى اختيار القطاع أولاً', 'warning');
                    return;
                }
                var lat = parseFloat(latInput.value);
                var lng = parseFloat(lngInput.value);
                if (!isFinite(lat) || !isFinite(lng)) {
                    showAlert('يرجى تحديد موقع المستقبل على الخريطة أولاً', 'warning');
                    return;
                }
                var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                var token = tokenInput ? tokenInput.value : '';
                var elevIn = document.getElementById('receiverElevationInput');
                var aglIn = document.getElementById('receiverAntennaAglInput');
                var freqIn = document.getElementById('losFrequencyMhzInput');
                var body = {
                    sectorId: parseInt(sectorId, 10),
                    receiverLatitude: lat,
                    receiverLongitude: lng,
                    receiverElevationMeters: parseOptionalFloatInput(elevIn),
                    receiverAntennaHeightAglMeters: parseOptionalFloatInput(aglIn),
                    frequencyMhz: parseOptionalFloatInput(freqIn)
                };
                var btn = document.getElementById('btnAnalyzeLos');
                var prev = btn.innerHTML;
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري التحليل...';
                activateToolTab('los');
                clearLosAnalysisOverlay();
                var panel = document.getElementById('losResultPanel');
                var content = document.getElementById('losResultContent');
                panel.classList.remove('d-none');
                content.innerHTML = '<p class="text-muted mb-0">جارٍ جلب التضاريس وبيانات المبانٍ والأشجار...</p>';

                fetch(analyzeLosUrl, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'X-CSRF-TOKEN': token,
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(body)
                })
                    .then(function (r) {
                        if (!r.ok) {
                            throw new Error('http_' + r.status);
                        }
                        return r.json();
                    })
                    .then(function (data) {
                        if (!data || !data.success) {
                            content.innerHTML = '<p class="text-danger">' + (data && data.message ? data.message : 'فشل التحليل') + '</p>';
                            return;
                        }
                        var a = data.analysis;
                        var pathClear = a.pathClear !== undefined ? a.pathClear : a.terrainClear;
                        var terrainOk = pathClear
                            ? '<span class="badge-ok">لا يظهر حجب واضح في النموذج</span>'
                            : '<span class="badge-warn">قد يوجد حجب (تضاريس و/أو فريسنل و/أو مبنى/شجر)</span>';
                        var terrainSummary = pathClear
                            ? 'ضمن النموذج التقريبي، خط الرؤية و60٪ من منطقة فريسنل يبقيان فوق التضاريس، ولم يُرصد مبنى أو غطاء نباتي حاجب في البيانات المتاحة.'
                            : 'هناك موضع على المسار حيث التضاريس أو منطقة فريسنل أو مبنى/شجر قد يعيق الإشارة — راجع التفاصيل والمقطع والخريطة.';

                        var freqSource = a.frequencySource || (a.frequencyIsDefault ? 'default' : 'sector');
                        var freqNote = freqSource === 'user'
                            ? ' (أدخلته يدوياً)'
                            : (freqSource === 'default' || a.frequencyIsDefault
                                ? ' (افتراضي 5.8 غيغاهرتز — لم يُرصد تردد القطاع)'
                                : ' (من قياسات القطاع)');
                        var freqText = losNum(a.frequencyMhzUsed, 0) + ' ميغاهرتز' + freqNote;

                        var buildingIntro = '';
                        if (a.buildingsDataAvailable) {
                            buildingIntro = 'فُحصت عوائق OSM على ممر المسار: ' +
                                (a.buildingsConsidered || 0) + ' مبنى، و' +
                                (a.vegetationConsidered || 0) + ' عنصر غطاء نباتي. ' +
                                'ارتفاعات موثّقة: ' + (a.buildingsMeasuredHeightCount || 0) +
                                '، تقديرية: ' + (a.buildingsEstimatedHeightCount || 0) + '.';
                        } else {
                            buildingIntro = '<strong class="text-warning">لم تُحمّل بيانات المبانٍ والأشجار من الخادم الخارجي.</strong> النتيجة تعتمد على التضاريس وفريسنل فقط.';
                        }

                        var obstructs = (a.buildingObstructions || []).filter(function (b) {
                            return b.likelyBlocksLos || b.likelyBlocksFresnel;
                        });
                        var obstHtml = '';
                        if (obstructs.length) {
                            obstHtml = '<ul class="los-notes-list" style="margin-top:8px">';
                            obstructs.forEach(function (b) {
                                var veg = isVegetationObstacle(b);
                                var kind = (veg ? 'غطاء نباتي — ' : 'مبنى — ') +
                                    (b.likelyBlocksLos ? 'يعترض خط الرؤية' : 'يدخل منطقة فريسنل');
                                obstHtml += '<li>' + kind + ': ارتفاع تقريبي ~' + losNum(b.roofMslMeters) +
                                    ' م، خط الرؤية ~' + losNum(b.lineHeightAtPointMslMeters) +
                                    ' م، بعد عن المحور ~' + losNum(b.crossTrackMeters) + ' م. ' +
                                    heightSourceLabel(b.heightSource) + ' (' + heightConfidenceLabel(b.heightConfidence) + ').' +
                                    (b.intersectsPath ? ' المضلع يقطع المسار.' : '') +
                                    '</li>';
                            });
                            obstHtml += '</ul>';
                        } else if (a.buildingsDataAvailable && ((a.buildingsConsidered || 0) + (a.vegetationConsidered || 0)) > 0) {
                            obstHtml = '<p class="mb-0 mt-1 text-muted">لم يُعتبر أي مبنى أو غطاء نباتي حاجباً لخط الرؤية أو لمنطقة فريسنل ضمن القواعد المستخدمة.</p>';
                        } else if (!a.buildingsDataAvailable) {
                            obstHtml = '';
                        } else {
                            obstHtml = '<p class="mb-0 mt-1 text-muted">لم يُعثر على مبانٍ أو غطاء نباتي ضمن ممر الفحص.</p>';
                        }

                        var profileBlock = '';
                        if (a.profile && a.profile.length) {
                            profileBlock =
                                renderLosProfileChart(a) +
                                '<dl class="los-result-kv">' +
                                '<dt>أقل هامش عن سطح الأرض:</dt><dd><strong>' + losNum(a.minTerrainMarginMeters) + '</strong> م</dd>' +
                                '<dt>أقل هامش فريسنل (60٪):</dt><dd><strong>' + losNum(a.minFresnelMarginMeters) + '</strong> م</dd>' +
                                '</dl>' +
                                '<p class="form-hint mb-0 mt-1">الرقم السالب يعني أن العائق أعلى من الخط أو داخل منطقة فريسنل في النموذج.</p>';
                        }

                        content.innerHTML =
                            '<div class="los-result-block">' +
                            '<h5>الخلاصة</h5>' +
                            '<dl class="los-result-kv">' +
                            '<dt>المسافة (خط جوّي):</dt><dd>' + losNum(a.distanceMeters, 0) + ' م</dd>' +
                            '<dt>الحالة المجمّعة:</dt><dd>' + terrainOk + '</dd>' +
                            '<dt>التضاريس الهندسية:</dt><dd>' + (a.terrainClear ? 'ضمن الهامش' : 'قد تحجب') + '</dd>' +
                            '<dt>منطقة فريسنل:</dt><dd>' + (a.fresnelClear ? '60٪ خالية تقريباً' : 'غير خالية كفاية') + '</dd>' +
                            '<dt>التردد المستخدم:</dt><dd>' + freqText + '</dd>' +
                            '</dl>' +
                            '<p class="mb-0 mt-2">' + terrainSummary + '</p>' +
                            '</div>' +

                            '<div class="los-result-block">' +
                            '<h5>التضاريس ومقطع الارتفاع</h5>' +
                            '<p class="mb-1"><strong>ما يعنيه النظام:</strong> ' + (a.terrainNote || '—') + '</p>' +
                            profileBlock +
                            '</div>' +

                            '<div class="los-result-block">' +
                            '<h5>المبانٍ والأشجار (من بيانات خارجية)</h5>' +
                            '<p class="mb-1">' + buildingIntro + '</p>' +
                            obstHtml +
                            '</div>' +

                            '<div class="los-result-block">' +
                            '<h5>الخريطة</h5>' +
                            '<p class="mb-0">خط برتقالي متقطع = المسار؛ أحمر = مبنى يعترض؛ برتقالي غامق = مبنى يدخل فريسنل؛ أخضر = شجر/غابة؛ أصفر = أضيق نقطة.</p>' +
                            '</div>' +

                            '<div class="los-result-block">' +
                            '<h5>تحذير نهائي</h5>' +
                            '<p class="mb-0 text-muted">لا تُستخدم هذه الشاشة وحدها لاتخاذ قرار تركيب نهائي دون تحقق ميداني؛ البيانات والنموذج تقريبيان.</p>' +
                            '</div>';
                        renderLosAnalysisOnMap(a);
                    })
                    .catch(function () {
                        content.innerHTML = '<p class="text-danger">تعذر إكمال التحليل. تحقق من الاتصال أو حاول لاحقاً.</p>';
                    })
                    .finally(function () {
                        btn.disabled = false;
                        btn.innerHTML = prev;
                        panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    });
            }

            var btnAnalyzeLos = document.getElementById('btnAnalyzeLos');
            if (btnAnalyzeLos) {
                btnAnalyzeLos.addEventListener('click', analyzeLineOfSight);
            }
            var btnLosResultClose = document.getElementById('btnLosResultClose');
            if (btnLosResultClose) {
                btnLosResultClose.addEventListener('click', function () {
                    document.getElementById('losResultPanel').classList.add('d-none');
                });
            }

            document.querySelectorAll('.receiver-tool-tab').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    activateToolTab(btn.getAttribute('data-tool-tab'));
                });
            });

            var lastCalibrateOk = false;
            var livePollTimer = null;
            var livePollInFlight = false;
            var livePeakDbm = null;
            var phoneCompass = {
                targetMag: null,
                heading: null,
                listening: false,
                usingIos: false,
                gotAbsolute: false,
                wakeLock: null
            };

            function csrfToken() {
                var tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                return tokenInput ? tokenInput.value : '';
            }

            function formatDbm(v) {
                return (v == null || !isFinite(Number(v))) ? '—' : (Number(v).toFixed(0) + ' dBm');
            }

            function stopLiveSignalPoll() {
                if (livePollTimer) {
                    clearInterval(livePollTimer);
                    livePollTimer = null;
                }
            }

            function startLiveSignalPoll() {
                stopLiveSignalPoll();
                pollLiveSignal();
                livePollTimer = setInterval(pollLiveSignal, 2500);
            }

            function resetLivePeak() {
                livePeakDbm = null;
                var peakEl = document.getElementById('calLivePeak');
                if (peakEl) {
                    peakEl.textContent = '—';
                }
            }

            function setLiveText(id, text) {
                var el = document.getElementById(id);
                if (el) {
                    el.textContent = text;
                }
            }

            function renderLiveStations(stations) {
                var list = document.getElementById('calLiveStations');
                if (!list) {
                    return;
                }
                list.innerHTML = '';
                (stations || []).forEach(function (s) {
                    var li = document.createElement('li');
                    var mac = s.macAddress || 'بدون MAC';
                    var ip = s.lastIp || 'بدون IP';
                    li.innerHTML = '<button type="button" class="calibrate-station-pick">' +
                        '<strong>' + mac + '</strong> · ' + ip +
                        ' · ' + formatDbm(s.signalDbm) + '</button>';
                    var btn = li.querySelector('button');
                    btn.addEventListener('click', function () {
                        var macIn = document.getElementById('calibrateMacInput');
                        if (macIn && s.macAddress) {
                            macIn.value = s.macAddress;
                        }
                        resetLivePeak();
                        pollLiveSignal();
                    });
                    list.appendChild(li);
                });
            }

            function pollLiveSignal() {
                if (livePollInFlight) {
                    return;
                }
                var sectorId = sectorSelect && sectorSelect.value;
                var livePanel = document.getElementById('calibrateLivePanel');
                if (!sectorId || !livePanel || livePanel.classList.contains('d-none')) {
                    return;
                }
                livePollInFlight = true;
                var macIn = document.getElementById('calibrateMacInput');
                fetch(calibrateLiveSignalUrl, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'X-CSRF-TOKEN': csrfToken(),
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({
                        sectorId: parseInt(sectorId, 10),
                        receiverIp: ipInput && ipInput.value ? ipInput.value.trim() : '',
                        macAddress: macIn && macIn.value ? macIn.value.trim() : ''
                    })
                })
                    .then(function (r) {
                        if (!r.ok) {
                            throw new Error('http_' + r.status);
                        }
                        return r.json();
                    })
                    .then(function (data) {
                        if (!data || !data.success) {
                            setLiveText('calLiveStatus', (data && data.message) ? data.message : 'تعذر قراءة الإشارة الحية.');
                            setLiveText('calLiveAdvice', 'الهندسة جاهزة. الإشارة الحية تحتاج وصول MikroTik وظهور اللاقط على القطاع.');
                            return;
                        }
                        var matched = data.matched;
                        if (matched && matched.signalDbm != null && isFinite(Number(matched.signalDbm))) {
                            var dbm = Number(matched.signalDbm);
                            if (livePeakDbm == null || dbm > livePeakDbm) {
                                livePeakDbm = dbm;
                            }
                            setLiveText('calLiveSignal', formatDbm(dbm));
                            setLiveText('calLivePeak', formatDbm(livePeakDbm));
                            setLiveText('calLiveSnr', matched.snrDb == null ? '—' : (matched.snrDb + ' dB'));
                            setLiveText('calLiveCcq', matched.ccqPercent == null ? '—' : (matched.ccqPercent + ' %'));
                            var delta = livePeakDbm - dbm;
                            var liveSignalEl = document.getElementById('calLiveSignal');
                            if (liveSignalEl) {
                                liveSignalEl.classList.toggle('is-peak', delta <= 1.5);
                                liveSignalEl.classList.toggle('is-off-peak', delta > 1.5);
                            }
                            setLiveText('calLiveStatus', 'مطابقة حسب ' + (data.matchReason === 'mac' ? 'MAC' : data.matchReason === 'ip' ? 'IP' : 'محطة وحيدة') +
                                (matched.macAddress ? (' · ' + matched.macAddress) : ''));
                            if (delta <= 1.5) {
                                setLiveText('calLiveAdvice', 'قريب من الذروة. ثبّت الطبق ثم شدّ البراغي.');
                            } else {
                                setLiveText('calLiveAdvice', 'حرّك الطبق ببطء نحو الذروة (' + formatDbm(livePeakDbm) + '). الفرق الحالي ' + delta.toFixed(0) + ' dB.');
                            }
                        } else {
                            setLiveText('calLiveSignal', '—');
                            setLiveText('calLiveSnr', '—');
                            setLiveText('calLiveCcq', '—');
                            setLiveText('calLiveStatus', data.message || 'لا توجد محطة مطابقة بعد.');
                            setLiveText('calLiveAdvice', 'شغّل اللاقط حتى يظهر في القائمة أدناه، أو أدخل MAC ثم اضغط المحطة لتتبعها.');
                        }
                        renderLiveStations(data.stations);
                    })
                    .catch(function () {
                        setLiveText('calLiveStatus', 'تعذر قراءة الإشارة الحية. تحقق من اتصال المرسل.');
                    })
                    .finally(function () {
                        livePollInFlight = false;
                    });
            }

            function formatAzimuthTurn(delta) {
                var a = Math.abs(Number(delta) || 0);
                if (a < 0.8) {
                    return 'المحاذاة الأفقية ضمن أقل من درجة عن الاتجاه المطلوب.';
                }
                if (delta > 0) {
                    return 'أدر يميناً (مع عقارب الساعة) ' + a.toFixed(1) + '°';
                }
                return 'أدر يساراً (عكس عقارب الساعة) ' + a.toFixed(1) + '°';
            }

            function formatTilt(el) {
                var v = Number(el) || 0;
                var a = Math.abs(v);
                if (a < 0.15) {
                    return 'أبقِ الهوائي أفقياً تقريباً (ميل ≈ 0°).';
                }
                if (v > 0) {
                    return 'ارفع الهوائي للأعلى (uptilt) ' + a.toFixed(2) + '°';
                }
                return 'اخفض الهوائي للأسفل (downtilt) ' + a.toFixed(2) + '°';
            }

            function renderCompassSvg(currentDeg, requiredDeg) {
                var cur = Number(currentDeg) || 0;
                var req = Number(requiredDeg) || 0;
                return '<svg class="calibrate-compass" viewBox="0 0 160 160" role="img" aria-label="بوصلة المعايرة">' +
                    '<circle cx="80" cy="80" r="62" fill="rgba(15,23,42,0.04)" stroke="rgba(148,163,184,0.55)" stroke-width="2"></circle>' +
                    '<text x="80" y="22" text-anchor="middle" font-size="11" fill="currentColor">ش</text>' +
                    '<text x="80" y="154" text-anchor="middle" font-size="11" fill="currentColor">ج</text>' +
                    '<text x="18" y="84" text-anchor="middle" font-size="11" fill="currentColor">غ</text>' +
                    '<text x="142" y="84" text-anchor="middle" font-size="11" fill="currentColor">ق</text>' +
                    '<g transform="rotate(' + cur.toFixed(1) + ' 80 80)">' +
                    '<line x1="80" y1="80" x2="80" y2="28" stroke="#dc3545" stroke-width="3" stroke-linecap="round"></line>' +
                    '</g>' +
                    '<g transform="rotate(' + req.toFixed(1) + ' 80 80)">' +
                    '<line x1="80" y1="80" x2="80" y2="24" stroke="#198754" stroke-width="3" stroke-linecap="round"></line>' +
                    '<polygon points="80,18 75,30 85,30" fill="#198754"></polygon>' +
                    '</g>' +
                    '<circle cx="80" cy="80" r="4" fill="#334155"></circle>' +
                    '</svg>' +
                    '<div class="calibrate-compass-legend"><span class="cal-leg-cur"></span> اتجاه القطاع الحالي &nbsp; <span class="cal-leg-req"></span> السمت المطلوب</div>';
            }

            function signedHeadingDelta(fromDeg, toDeg) {
                var d = ((Number(toDeg) || 0) - (Number(fromDeg) || 0)) % 360;
                if (d > 180) {
                    d -= 360;
                }
                if (d <= -180) {
                    d += 360;
                }
                return d;
            }

            function normalizeHeading(deg) {
                var a = (Number(deg) || 0) % 360;
                return a < 0 ? a + 360 : a;
            }

            function screenOrientationDeg() {
                if (screen.orientation && typeof screen.orientation.angle === 'number') {
                    return screen.orientation.angle;
                }
                if (typeof window.orientation === 'number') {
                    return window.orientation;
                }
                return 0;
            }

            function readMagneticHeading(e) {
                if (!e) {
                    return null;
                }
                if (typeof e.webkitCompassHeading === 'number' && isFinite(e.webkitCompassHeading)) {
                    phoneCompass.usingIos = true;
                    return normalizeHeading(e.webkitCompassHeading);
                }
                if (typeof e.alpha !== 'number' || !isFinite(e.alpha)) {
                    return null;
                }
                return normalizeHeading(360 - e.alpha + screenOrientationDeg());
            }

            function smoothHeading(prev, next) {
                if (prev == null || !isFinite(prev)) {
                    return next;
                }
                return normalizeHeading(prev + signedHeadingDelta(prev, next) * 0.28);
            }

            function renderPhoneCompassSvg() {
                return '<div class="phone-compass-wrap">' +
                    '<svg id="phoneCompassSvg" class="calibrate-compass phone-compass-svg" viewBox="0 0 180 180" role="img" aria-label="بوصلة الموبايل الحية">' +
                    '<circle cx="90" cy="90" r="74" fill="rgba(15,23,42,0.05)" stroke="rgba(148,163,184,0.55)" stroke-width="2"></circle>' +
                    '<g id="phoneCompassRose" transform="rotate(0 90 90)">' +
                    '<text x="90" y="28" text-anchor="middle" font-size="13" font-weight="700" fill="currentColor">ش</text>' +
                    '<text x="90" y="164" text-anchor="middle" font-size="13" fill="currentColor">ج</text>' +
                    '<text x="22" y="95" text-anchor="middle" font-size="13" fill="currentColor">غ</text>' +
                    '<text x="158" y="95" text-anchor="middle" font-size="13" fill="currentColor">ق</text>' +
                    '<g id="phoneCompassTarget" transform="rotate(0 90 90)">' +
                    '<polygon points="90,20 83,36 97,36" fill="#198754"></polygon>' +
                    '<line x1="90" y1="36" x2="90" y2="90" stroke="#198754" stroke-width="3"></line>' +
                    '</g>' +
                    '</g>' +
                    '<polygon points="90,8 82,28 98,28" fill="#0d6efd"></polygon>' +
                    '<text x="90" y="48" text-anchor="middle" font-size="10" fill="#0d6efd">أعلى الشاشة</text>' +
                    '<circle cx="90" cy="90" r="5" fill="#334155"></circle>' +
                    '</svg>' +
                    '<div class="calibrate-compass-legend"><span class="cal-leg-phone"></span> اتجاه اللاقط / أعلى الشاشة &nbsp; <span class="cal-leg-req"></span> السمت المطلوب</div>' +
                    '<button type="button" class="btn btn-light phone-compass-field-close" id="btnPhoneCompassFieldClose">إغلاق الوضع الميداني</button>' +
                    '</div>';
            }

            function updatePhoneCompassUi(rawHeading) {
                var card = document.getElementById('receiverCompassCard');
                var rose = document.getElementById('phoneCompassRose');
                var targetMark = document.getElementById('phoneCompassTarget');
                var headingEl = document.getElementById('phoneHeadingVal');
                var deltaEl = document.getElementById('phoneDeltaVal');
                var statusEl = document.getElementById('phoneCompassStatus');
                var target = phoneCompass.targetMag;
                if (rawHeading != null && isFinite(rawHeading)) {
                    phoneCompass.heading = smoothHeading(phoneCompass.heading, rawHeading);
                }
                var heading = phoneCompass.heading;
                if (rose) {
                    rose.setAttribute('transform', 'rotate(' + (-(heading || 0)).toFixed(1) + ' 90 90)');
                }
                if (targetMark && target != null && isFinite(target)) {
                    targetMark.setAttribute('transform', 'rotate(' + Number(target).toFixed(1) + ' 90 90)');
                }
                if (headingEl) {
                    headingEl.textContent = heading == null ? '—' : losNum(heading) + '°';
                }
                if (target != null && heading != null) {
                    var delta = signedHeadingDelta(heading, target);
                    var abs = Math.abs(delta);
                    if (deltaEl) {
                        deltaEl.textContent = (delta > 0 ? '+' : '') + losNum(delta) + '°';
                    }
                    if (card) {
                        card.classList.toggle('is-aligned', abs <= 4);
                        card.classList.toggle('is-close', abs > 4 && abs <= 12);
                    }
                    if (statusEl) {
                        if (abs <= 4) {
                            statusEl.innerHTML = 'محاذى. ثبّت اللاقط ثم أكمل بذروة الإشارة الحية.';
                        } else if (delta > 0) {
                            statusEl.textContent = 'أدر اللاقط يميناً (مع عقارب الساعة) ' + abs.toFixed(0) + '°.';
                        } else {
                            statusEl.textContent = 'أدر اللاقط يساراً (عكس عقارب الساعة) ' + abs.toFixed(0) + '°.';
                        }
                    }
                }
            }

            function onPhoneOrientation(e) {
                if (typeof e.webkitCompassHeading === 'number' && isFinite(e.webkitCompassHeading)) {
                    phoneCompass.usingIos = true;
                } else if (phoneCompass.usingIos) {
                    return;
                } else if (e.type === 'deviceorientationabsolute') {
                    phoneCompass.gotAbsolute = true;
                } else if (phoneCompass.gotAbsolute) {
                    return;
                }
                var heading = readMagneticHeading(e);
                if (heading == null) {
                    return;
                }
                if (typeof e.webkitCompassAccuracy === 'number' && e.webkitCompassAccuracy > 25) {
                    var statusEl = document.getElementById('phoneCompassStatus');
                    if (statusEl) {
                        statusEl.textContent = 'البوصلة مضطربة قرب المعدن. أبعد الموبايل قليلاً عن جسم اللاقط.';
                    }
                }
                updatePhoneCompassUi(heading);
            }

            function stopPhoneCompass(resetHeading) {
                if (phoneCompass.listening) {
                    window.removeEventListener('deviceorientationabsolute', onPhoneOrientation, true);
                    window.removeEventListener('deviceorientation', onPhoneOrientation, true);
                    phoneCompass.listening = false;
                }
                if (phoneCompass.wakeLock) {
                    try {
                        phoneCompass.wakeLock.release();
                    } catch (err) { /* ignore */ }
                    phoneCompass.wakeLock = null;
                }
                var card = document.getElementById('receiverCompassCard');
                if (card) {
                    card.classList.remove('is-field');
                }
                document.body.classList.remove('phone-compass-field-open');
                if (resetHeading) {
                    phoneCompass.heading = null;
                    phoneCompass.usingIos = false;
                    phoneCompass.gotAbsolute = false;
                }
            }

            function requestPhoneWakeLock() {
                if (!navigator.wakeLock || !navigator.wakeLock.request) {
                    return;
                }
                navigator.wakeLock.request('screen').then(function (lock) {
                    phoneCompass.wakeLock = lock;
                }).catch(function () { /* ignore */ });
            }

            function startPhoneCompassListeners() {
                stopPhoneCompass(false);
                window.addEventListener('deviceorientationabsolute', onPhoneOrientation, true);
                window.addEventListener('deviceorientation', onPhoneOrientation, true);
                phoneCompass.listening = true;
                requestPhoneWakeLock();
                var statusEl = document.getElementById('phoneCompassStatus');
                if (statusEl) {
                    statusEl.innerHTML = 'البوصلة تعمل. أعلى الشاشة = اتجاه الإشعاع. أدر حتى يصبح السهم الأخضر عند الأعلى.';
                }
            }

            function enablePhoneCompass() {
                if (phoneCompass.targetMag == null) {
                    showAlert('احسب المعايرة أولاً لتحديد السمت المطلوب', 'warning');
                    return;
                }
                var Orientation = window.DeviceOrientationEvent;
                if (!Orientation) {
                    showAlert('هذا المتصفح لا يدعم بوصلة الموبايل. افتح الصفحة من هاتف عبر https.', 'warning');
                    return;
                }
                if (typeof Orientation.requestPermission === 'function') {
                    Orientation.requestPermission().then(function (state) {
                        if (state === 'granted') {
                            startPhoneCompassListeners();
                        } else {
                            showAlert('يلزم السماح بحساس الاتجاه لتشغيل البوصلة الحية', 'warning');
                        }
                    }).catch(function () {
                        showAlert('تعذر تفعيل بوصلة الموبايل', 'danger');
                    });
                    return;
                }
                startPhoneCompassListeners();
            }

            function togglePhoneCompassField() {
                var card = document.getElementById('receiverCompassCard');
                if (!card) {
                    return;
                }
                var on = !card.classList.contains('is-field');
                card.classList.toggle('is-field', on);
                document.body.classList.toggle('phone-compass-field-open', on);
                if (on && !phoneCompass.listening) {
                    enablePhoneCompass();
                }
            }

            function renderCalibrationOnMap(alignment) {
                clearCalibrationOverlay();
                if (!selectedSector || !isFinite(selectedSector.latitude) || !isFinite(selectedSector.longitude)) {
                    return;
                }
                var lat1 = parseFloat(latInput.value);
                var lon1 = parseFloat(lngInput.value);
                if (!isFinite(lat1) || !isFinite(lon1)) {
                    return;
                }
                calibrationLayerGroup = L.layerGroup();
                var line = L.polyline([[selectedSector.latitude, selectedSector.longitude], [lat1, lon1]], {
                    color: '#198754',
                    weight: 3,
                    opacity: 0.9,
                    dashArray: '8,6'
                });
                line.bindPopup('مسار المعايرة: سمت المرسل ' + losNum(alignment.transmitterAzimuthDegrees) + '°');
                calibrationLayerGroup.addLayer(line);
                calibrationLayerGroup.addTo(map);
            }

            function calibrateAlignment() {
                var sectorId = sectorSelect && sectorSelect.value;
                if (!sectorId) {
                    showAlert('يرجى اختيار القطاع أولاً', 'warning');
                    return;
                }
                var lat = parseFloat(latInput.value);
                var lng = parseFloat(lngInput.value);
                if (!isFinite(lat) || !isFinite(lng)) {
                    showAlert('يرجى تحديد موقع المستقبل على الخريطة أولاً', 'warning');
                    return;
                }
                activateToolTab('calibrate');
                var elevIn = document.getElementById('receiverElevationInput');
                var aglIn = document.getElementById('receiverAntennaAglInput');
                var freqIn = document.getElementById('losFrequencyMhzInput');
                var panel = document.getElementById('calibrateResultPanel');
                var content = document.getElementById('calibrateResultContent');
                var livePanel = document.getElementById('calibrateLivePanel');
                var btn = document.getElementById('btnCalibrateAlignment');
                var prev = btn ? btn.innerHTML : '';
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الحساب...';
                }
                lastCalibrateOk = false;
                stopLiveSignalPoll();
                stopPhoneCompass(true);
                if (livePanel) {
                    livePanel.classList.add('d-none');
                }
                panel.classList.remove('d-none');
                content.innerHTML = '<p class="text-muted mb-0">جارٍ حساب السمت والميل ومراجعة المسار...</p>';

                fetch(calibrateAlignmentUrl, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'X-CSRF-TOKEN': csrfToken(),
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({
                        sectorId: parseInt(sectorId, 10),
                        receiverLatitude: lat,
                        receiverLongitude: lng,
                        receiverElevationMeters: parseOptionalFloatInput(elevIn),
                        receiverAntennaHeightAglMeters: parseOptionalFloatInput(aglIn),
                        frequencyMhz: parseOptionalFloatInput(freqIn)
                    })
                })
                    .then(function (r) {
                        if (!r.ok) {
                            throw new Error('http_' + r.status);
                        }
                        return r.json();
                    })
                    .then(function (data) {
                        if (!data || !data.success || !data.alignment) {
                            content.innerHTML = '<p class="text-danger">' + (data && data.message ? data.message : 'فشل حساب المعايرة') + '</p>';
                            return;
                        }
                        var a = data.alignment;
                        var p = data.path;
                        var beam = a.insideCoverageBeam
                            ? '<span class="badge-ok">داخل زاوية انتشار القطاع</span>'
                            : '<span class="badge-warn">خارج زاوية انتشار القطاع — أعد توجيه المرسل أو راجع الموقع</span>';
                        var pathHtml = '';
                        if (p) {
                            var pathBadge = p.pathClear
                                ? '<span class="badge-ok">مسار مفتوح</span>'
                                : '<span class="badge-warn">مسار محجوب</span>';
                            var fresnelBadge = p.fresnelClear
                                ? '<span class="badge-ok">فريسنل كافٍ</span>'
                                : '<span class="badge-warn">فريسنل غير كافٍ</span>';
                            pathHtml =
                                '<p class="mb-1">جودة المسار: ' + pathBadge + ' · ' + fresnelBadge +
                                ' · هامش فريسنل ' + losNum(p.minFresnelMarginMeters) + ' م · تردد ' +
                                losNum(p.frequencyMhzUsed, 0) + ' MHz</p>';
                            if (p.blockingObstacles > 0) {
                                pathHtml += '<p class="mb-1 text-danger">عوائق على المسار: ' + p.blockingObstacles + '</p>';
                            }
                        } else {
                            pathHtml = '<p class="mb-1 text-muted">تعذر إرفاق تحليل خط الرؤية؛ الزوايا الهندسية ما زالت صالحة.</p>';
                        }
                        var heightNotes = '';
                        if (a.sectorAglAssumed || a.receiverAglAssumed) {
                            heightNotes = '<p class="mb-1 text-warning">ارتفاع هوائي مفترض' +
                                (a.sectorAglAssumed ? ' للمرسل (' + losNum(a.sectorAntennaAglMeters) + ' م)' : '') +
                                (a.receiverAglAssumed ? ' للمستقبل (' + losNum(a.receiverAntennaAglMeters) + ' م)' : '') +
                                ' — أدخل الارتفاع الحقيقي لدقة الميل.</p>';
                        }
                        var decl = Number(a.magneticDeclinationDegrees) || 0;
                        var declTxt = (decl >= 0 ? '+' : '') + losNum(decl) + '° (' + (decl >= 0 ? 'شرق' : 'غرب') + ')';
                        content.innerHTML =
                            '<div class="calibrate-summary">' +
                            '<p class="mb-2">المسافة الجوية <strong>' + losNum(a.distanceMeters, 0) + ' م</strong> بين هوائي ' +
                            (a.sectorName || 'المرسل') + ' ونقطة المستقبل.</p>' +
                            '<p class="mb-1">حالة الشعاع: ' + beam + '</p>' +
                            pathHtml +
                            heightNotes +
                            '<p class="calibrate-advice mb-0">' + (a.advice || '') + '</p>' +
                            '</div>' +
                            '<div class="calibrate-grid">' +
                            '<article class="calibrate-card">' +
                            '<h5><i class="fas fa-broadcast-tower"></i> المرسل (القطاع)</h5>' +
                            renderCompassSvg(a.currentSectorAzimuthDegrees, a.transmitterAzimuthDegrees) +
                            '<dl class="los-result-kv">' +
                            '<dt>الاتجاه الحالي:</dt><dd>' + losNum(a.currentSectorAzimuthDegrees) + '°</dd>' +
                            '<dt>السمت الجغرافي:</dt><dd><strong>' + losNum(a.transmitterAzimuthDegrees) + '°</strong> (' + (a.transmitterCardinal || '') + ')</dd>' +
                            '<dt>سمت البوصلة:</dt><dd><strong>' + losNum(a.transmitterMagneticAzimuthDegrees) + '°</strong></dd>' +
                            '<dt>الانحراف الأفقي:</dt><dd>' + formatAzimuthTurn(a.transmitterAzimuthDeltaDegrees) +
                            ' <span class="text-muted">(' + (a.transmitterAzimuthDeltaDegrees > 0 ? '+' : '') + losNum(a.transmitterAzimuthDeltaDegrees) + '°)</span></dd>' +
                            '<dt>الميل الرأسي:</dt><dd>' + formatTilt(a.transmitterElevationDegrees) +
                            ' <span class="text-muted">(' + losNum(a.transmitterElevationDegrees, 2) + '° مع انحناء الأرض)</span></dd>' +
                            '</dl>' +
                            '</article>' +
                            '<article class="calibrate-card calibrate-card--receiver" id="receiverCompassCard">' +
                            '<h5><i class="fas fa-wifi"></i> المستقبل</h5>' +
                            renderPhoneCompassSvg() +
                            '<div class="phone-compass-readout">' +
                            '<div><span>اتجاه الموبايل</span><strong id="phoneHeadingVal">—</strong></div>' +
                            '<div><span>المطلوب</span><strong id="phoneTargetVal">' + losNum(a.receiverMagneticAzimuthDegrees) + '°</strong></div>' +
                            '<div><span>الفرق</span><strong id="phoneDeltaVal">—</strong></div>' +
                            '</div>' +
                            '<p id="phoneCompassStatus" class="phone-compass-status">ضع الموبايل على اللاقط بحيث يكون <strong>أعلى الشاشة</strong> باتجاه الإشعاع، ثم فعّل البوصلة.</p>' +
                            '<div class="phone-compass-actions">' +
                            '<button type="button" class="btn btn-success" id="btnEnablePhoneCompass"><i class="fas fa-mobile-alt"></i> تفعيل بوصلة الموبايل</button>' +
                            '<button type="button" class="btn btn-outline-primary" id="btnPhoneCompassField"><i class="fas fa-expand"></i> وضع ميداني</button>' +
                            '</div>' +
                            '<dl class="los-result-kv mt-2">' +
                            '<dt>السمت الجغرافي:</dt><dd><strong>' + losNum(a.receiverAzimuthDegrees) + '°</strong> (' + (a.receiverCardinal || '') + ')</dd>' +
                            '<dt>سمت البوصلة:</dt><dd><strong>' + losNum(a.receiverMagneticAzimuthDegrees) + '°</strong></dd>' +
                            '<dt>الميل الرأسي:</dt><dd>' + formatTilt(a.receiverElevationDegrees) +
                            ' <span class="text-muted">(' + losNum(a.receiverElevationDegrees, 2) + '°)</span></dd>' +
                            '<dt>ارتفاع الهوائي:</dt><dd>' + losNum(a.receiverAntennaMslMeters) + ' م عن سطح البحر</dd>' +
                            '</dl>' +
                            '</article>' +
                            '</div>' +
                            '<p class="form-hint mt-2 mb-0">0° جغرافي = الشمال الحقيقي. انحراف المغناطيسية الحالي ' + declTxt +
                            '. سمت البوصلة = السمت الجغرافي − الانحراف.</p>';
                        renderCalibrationOnMap(a);
                        lastCalibrateOk = true;
                        phoneCompass.targetMag = Number(a.receiverMagneticAzimuthDegrees);
                        phoneCompass.heading = null;
                        updatePhoneCompassUi(null);
                        resetLivePeak();
                        if (livePanel) {
                            livePanel.classList.remove('d-none');
                        }
                        startLiveSignalPoll();
                    })
                    .catch(function () {
                        content.innerHTML = '<p class="text-danger">تعذر حساب المعايرة. تحقق من الاتصال أو حاول لاحقاً.</p>';
                    })
                    .finally(function () {
                        if (btn) {
                            btn.disabled = false;
                            btn.innerHTML = prev;
                        }
                        panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                    });
            }

            var btnCalibrateAlignment = document.getElementById('btnCalibrateAlignment');
            if (btnCalibrateAlignment) {
                btnCalibrateAlignment.addEventListener('click', calibrateAlignment);
            }
            var btnCalibrateAlignmentAction = document.getElementById('btnCalibrateAlignmentAction');
            if (btnCalibrateAlignmentAction) {
                btnCalibrateAlignmentAction.addEventListener('click', calibrateAlignment);
            }
            var btnCalibrateResetPeak = document.getElementById('btnCalibrateResetPeak');
            if (btnCalibrateResetPeak) {
                btnCalibrateResetPeak.addEventListener('click', function () {
                    resetLivePeak();
                    pollLiveSignal();
                });
            }
            var calibrateResultPanel = document.getElementById('calibrateResultPanel');
            if (calibrateResultPanel) {
                calibrateResultPanel.addEventListener('click', function (ev) {
                    var enableBtn = ev.target.closest('#btnEnablePhoneCompass');
                    var fieldBtn = ev.target.closest('#btnPhoneCompassField');
                    if (enableBtn) {
                        ev.preventDefault();
                        enablePhoneCompass();
                    } else if (fieldBtn) {
                        ev.preventDefault();
                        togglePhoneCompassField();
                    } else if (ev.target.closest('#btnPhoneCompassFieldClose')) {
                        ev.preventDefault();
                        var card = document.getElementById('receiverCompassCard');
                        if (card) {
                            card.classList.remove('is-field');
                        }
                        document.body.classList.remove('phone-compass-field-open');
                    }
                });
            }

            function clearMapLayers() {
                clearLosAnalysisOverlay();
                clearCalibrationOverlay();
                if (currentSectorMarker) { map.removeLayer(currentSectorMarker); currentSectorMarker = null; }
                if (currentCoverage) { map.removeLayer(currentCoverage); currentCoverage = null; }
                if (currentDirectionLine) { map.removeLayer(currentDirectionLine); currentDirectionLine = null; }
                if (currentReceiversLayer) { map.removeLayer(currentReceiversLayer); currentReceiversLayer = null; }
                if (receiverMarker) { map.removeLayer(receiverMarker); receiverMarker = null; }
            }

            function updateSectorInfoPanel(s) {
                var nameEl = document.getElementById('selectedSectorName');
                var dirEl = document.getElementById('sectorDirection');
                var angEl = document.getElementById('sectorAngle');
                var rangeEl = document.getElementById('coverageRange');
                if (nameEl) nameEl.textContent = s.name || '';
                if (dirEl) dirEl.textContent = (Number(s.direction) || 0).toFixed(1) + '°';
                if (angEl) angEl.textContent = (Number(s.coverageAngle) || 0).toFixed(1) + '°';
                if (rangeEl) rangeEl.textContent = (Number(s.coverageRange) || 0).toFixed(2);
                if (receiversCount) receiversCount.textContent = Array.isArray(s.receivers) ? s.receivers.length : 0;
                if (sectorIPRange) sectorIPRange.textContent = (s.ipAddress || '') + ' / ' + (s.networkMask || '');
                var freqIn = document.getElementById('losFrequencyMhzInput');
                var freqHint = document.getElementById('losFrequencyHint');
                if (freqIn) {
                    var f = Number(s.frequencyMhz);
                    if (isFinite(f) && f >= 400) {
                        freqIn.value = String(Math.round(f));
                        if (freqHint) freqHint.textContent = 'مأخوذ من قياس القطاع (' + Math.round(f) + ' ميغاهرتز) — يمكن تعديله.';
                    } else if (!freqIn.value) {
                        if (freqHint) freqHint.textContent = 'لا يوجد قياس للقطاع؛ سيُستخدم 5800 إن تُرك فارغاً. يمكن إدخال التردد يدوياً.';
                    }
                }
                if (sectorInfo) sectorInfo.classList.remove('d-none');
                if (sectorInfoPlaceholder) sectorInfoPlaceholder.classList.add('d-none');
            }

            function drawSelectedSector(s) {
                clearMapLayers();

                if (!isFinite(s.latitude) || !isFinite(s.longitude)) {
                    showAlert('لا يمكن عرض القطاع على الخريطة لأن إحداثياته غير محددة. يرجى ضبط موقع القطاع أولاً من صفحة القطاعات.', 'warning');
                    return;
                }

                var sectorIcon = L.divIcon({
                    html: '<div style="background:#007bff;width:40px;height:40px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;font-size:20px;"><i class="fas fa-broadcast-tower"></i></div>',
                    iconSize: [40, 40], iconAnchor: [20, 20]
                });

                currentSectorMarker = L.marker([s.latitude, s.longitude], { icon: sectorIcon }).addTo(map)
                    .bindPopup(
                        '<strong>' + (s.name || '') + '</strong>' +
                        '<br>IP: ' + (s.ipAddress || '') +
                        '<br>الاتجاه: ' + ((Number(s.direction) || 0).toFixed(1)) + '°' +
                        '<br>زاوية التغطية: ' + ((Number(s.coverageAngle) || 0).toFixed(1)) + '°' +
                        '<br>مدى التغطية: ' + ((Number(s.coverageRange) || 0).toFixed(2)) + ' كم'
                    );

                var coverageResult = drawCoverageSector(s);
                currentCoverage = coverageResult.coverageLayer;
                currentDirectionLine = coverageResult.directionLine;

                var bounds = [[s.latitude, s.longitude]];
                if (Array.isArray(coverageResult.boundsPoints)) {
                    coverageResult.boundsPoints.forEach(function (p) { bounds.push(p); });
                }

                var markers = [];
                if (Array.isArray(s.receivers)) {
                    s.receivers.forEach(function (r) {
                        if (!isFinite(r.latitude) || !isFinite(r.longitude)) return;
                        var icon = L.divIcon({
                            html: '<div style="background:#6c757d;width:25px;height:25px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;"><i class="fas fa-wifi"></i></div>',
                            iconSize: [25, 25], iconAnchor: [12.5, 12.5]
                        });
                        var m = L.marker([r.latitude, r.longitude], { icon: icon })
                            .bindPopup('<strong>' + (r.name || '') + '</strong><br>IP: ' + (r.ip || ''));
                        markers.push(m);
                        bounds.push([r.latitude, r.longitude]);
                    });
                }

                if (markers.length) {
                    currentReceiversLayer = L.layerGroup(markers).addTo(map);
                }

                function fitCoverageInView() {
                    try { map.invalidateSize({ animate: false, pan: false }); } catch (e) { /* ignore */ }
                    if (bounds.length > 0) {
                        map.fitBounds(bounds, {
                            padding: isNarrowMap() ? [24, 24] : [36, 36],
                            maxZoom: isNarrowMap() ? 15 : 17,
                            animate: false
                        });
                    } else {
                        map.setView([s.latitude, s.longitude], isNarrowMap() ? 14 : 15);
                    }
                }

                requestAnimationFrame(function () {
                    fitCoverageInView();
                    setTimeout(fitCoverageInView, 120);
                    setTimeout(fitCoverageInView, 400);
                });
            }

            function drawCoverageSector(s) {
                var direction = Number(s.direction) || 0;
                var angle = Number(s.coverageAngle) || 60;
                var range = Number(s.coverageRange) || 5;
                var rangeMeters = range * 1000;
                var center = [s.latitude, s.longitude];
                var boundsPoints = [];
                var coverageLayers = [];
                var directionEnd = destinationPointByBearing(center, rangeMeters, direction);

                if (angle >= 359.5) {
                    var circle = L.circle(center, {
                        radius: rangeMeters,
                        color: '#007bff',
                        fillColor: '#007bff',
                        fillOpacity: 0.18,
                        weight: 2
                    });
                    coverageLayers.push(circle);
                    boundsPoints.push(destinationPointByBearing(center, rangeMeters, 0));
                    boundsPoints.push(destinationPointByBearing(center, rangeMeters, 90));
                    boundsPoints.push(destinationPointByBearing(center, rangeMeters, 180));
                    boundsPoints.push(destinationPointByBearing(center, rangeMeters, 270));
                } else {
                    var startBearing = (direction - angle / 2 + 360) % 360;
                    var endBearing = (direction + angle / 2 + 360) % 360;
                    var points = [center];
                    var steps = 36;
                    for (var i = 0; i <= steps; i++) {
                        var b = (startBearing + ((angle * i) / steps) + 360) % 360;
                        var p = destinationPointByBearing(center, rangeMeters, b);
                        points.push(p);
                        boundsPoints.push(p);
                    }
                    points.push(center);

                    var wedge = L.polygon(points, {
                        color: '#007bff',
                        fillColor: '#007bff',
                        fillOpacity: 0.2,
                        weight: 2
                    });
                    coverageLayers.push(wedge);

                    var edgeStart = destinationPointByBearing(center, rangeMeters, startBearing);
                    var edgeEnd = destinationPointByBearing(center, rangeMeters, endBearing);
                    coverageLayers.push(L.polyline([center, edgeStart], { color: '#0b5ed7', weight: 1.5, dashArray: '4,4' }));
                    coverageLayers.push(L.polyline([center, edgeEnd], { color: '#0b5ed7', weight: 1.5, dashArray: '4,4' }));
                }

                var coverageLayer = L.layerGroup(coverageLayers).addTo(map);
                var directionLine = L.polyline([center, directionEnd], {
                    color: '#dc3545',
                    weight: 3,
                    opacity: 0.9
                }).addTo(map);
                boundsPoints.push(directionEnd);

                return {
                    coverageLayer: coverageLayer,
                    directionLine: directionLine,
                    boundsPoints: boundsPoints
                };
            }

            function destinationPointByBearing(center, distanceMeters, bearingDeg) {
                var R = 6371000;
                var brng = bearingDeg * Math.PI / 180;
                var lat1 = center[0] * Math.PI / 180;
                var lng1 = center[1] * Math.PI / 180;
                var dByR = distanceMeters / R;

                var lat2 = Math.asin(Math.sin(lat1) * Math.cos(dByR) + Math.cos(lat1) * Math.sin(dByR) * Math.cos(brng));
                var lng2 = lng1 + Math.atan2(
                    Math.sin(brng) * Math.sin(dByR) * Math.cos(lat1),
                    Math.cos(dByR) - Math.sin(lat1) * Math.sin(lat2)
                );

                return [lat2 * 180 / Math.PI, lng2 * 180 / Math.PI];
            }

            function updateReceiverMarker(lat, lng) {
                if (receiverMarker) { map.removeLayer(receiverMarker); }
                var receiverIcon = L.divIcon({
                    className: 'receiver-marker',
                    html: '<div style="background:#28a745;width:30px;height:30px;border-radius:50%;display:flex;align-items:center;justify-content:center;color:white;"><i class="fas fa-wifi"></i></div>',
                    iconSize: [30, 30], iconAnchor: [15, 15]
                });
                receiverMarker = L.marker([lat, lng], { icon: receiverIcon }).addTo(map);
            }

            function updateDistanceFromSector() {
                if (!distanceInput) {
                    return;
                }
                if (!selectedSector || !isFinite(selectedSector.latitude) || !isFinite(selectedSector.longitude)) {
                    distanceInput.value = 'غير محدد';
                    if (distanceStatus) distanceStatus.textContent = '';
                    return;
                }
                var lat = Number(latInput.value);
                var lng = Number(lngInput.value);
                if (!isFinite(lat) || !isFinite(lng)) {
                    distanceInput.value = 'غير محدد';
                    if (distanceStatus) distanceStatus.textContent = '';
                    return;
                }

                var R = 6371;
                var dLat = (lat - selectedSector.latitude) * Math.PI / 180;
                var dLon = (lng - selectedSector.longitude) * Math.PI / 180;
                var a = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
                    Math.cos(selectedSector.latitude * Math.PI / 180) *
                    Math.cos(lat * Math.PI / 180) *
                    Math.sin(dLon / 2) * Math.sin(dLon / 2);
                var distance = R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));

                distanceInput.value = distance.toFixed(2);
                if (!distanceStatus) {
                    return;
                }
                if (distance <= (Number(selectedSector.coverageRange) || 0)) {
                    distanceStatus.textContent = '✅ داخل نطاق التغطية';
                    distanceStatus.style.color = 'var(--success)';
                } else {
                    distanceStatus.textContent = '⚠️ خارج نطاق التغطية';
                    distanceStatus.style.color = 'var(--danger)';
                }
            }

            function generateIPForSector(sectorId) {
                var btn = document.getElementById('btnGenerateIP');
                if (btn) {
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';
                    btn.disabled = true;
                }
                var url = getNextIpUrl + '?sectorId=' + encodeURIComponent(sectorId);
                fetch(url, {
                    credentials: 'same-origin',
                    headers: {
                        'Accept': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                    .then(function (response) { return response.json(); })
                    .then(function (data) {
                        if (data && data.success) {
                            if (ipInput && data.nextIP) {
                                ipInput.value = data.nextIP;
                            }
                            if (maskInput && data.networkMask) {
                                maskInput.value = data.networkMask;
                            }
                        }
                    })
                    .finally(function () {
                        if (btn) {
                            btn.innerHTML = '<i class="fas fa-sync-alt"></i>';
                            btn.disabled = false;
                        }
                    });
            }

            function checkConnection() {
                var ip = ipInput ? ipInput.value : '';
                if (!ip) {
                    showAlert('يرجى إدخال عنوان IP أولاً', 'warning');
                    return;
                }
                var btn = document.getElementById('btnCheckConnection');
                if (!btn) {
                    return;
                }
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> جاري الفحص...';
                btn.disabled = true;
                setTimeout(function () {
                    var success = Math.random() > 0.3;
                    showAlert(success ? '✅ اتصال ناجح' : '❌ فشل الاتصال', success ? 'success' : 'danger');
                    btn.innerHTML = '<i class="fas fa-wifi"></i> فحص الاتصال';
                    btn.disabled = false;
                }, 1500);
            }

            function clearSectorInfo() {
                selectedSector = null;
                if (sectorInfo) sectorInfo.classList.add('d-none');
                if (sectorInfoPlaceholder) sectorInfoPlaceholder.classList.remove('d-none');
                if (receiversCount) receiversCount.textContent = '0';
                if (sectorIPRange) sectorIPRange.textContent = 'غير محدد';
                if (distanceInput) distanceInput.value = 'غير محدد';
                if (distanceStatus) distanceStatus.textContent = '';
                if (receiverElevInput) {
                    receiverElevInput.value = '';
                    receiverElevInput.placeholder = 'يُملأ عند النقر على الخريطة';
                }
                if (receiverAglInput) {
                    receiverAglInput.value = '';
                }
                if (receiverElevationHint) {
                    receiverElevationHint.textContent = 'يُحدَّد تلقائياً عند اختيار موقع المستقبل على الخريطة (قابل للتعديل).';
                }
                terrainFetchToken++;
                clearMapLayers();
            }

            function showAlert(message, type) {
                var alertHtml = '<div class="alert alert-' + type +
                    ' alert-dismissible fade show" style="position:fixed;top:20px;left:50%;transform:translateX(-50%);z-index:9999;">' +
                    message +
                    '<button type="button" class="btn-close" onclick="this.parentElement.remove()"></button></div>';
                document.body.insertAdjacentHTML('beforeend', alertHtml);
                setTimeout(function () {
                    var el = document.querySelector('.alert');
                    if (el) el.remove();
                }, 3000);
            }

            if (sectorSelect.value) {
                onSectorChosen();
            }
            refreshMapLayout();
            } /* bootReceiverMap */

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', bootReceiverMap);
            } else {
                bootReceiverMap();
            }
        })();
    </script>
