@using RadaTik.Security
@inject RadaTik.Services.IPermissionService PermissionService
@inject RadaTik.Services.IFeatureAccessService FeatureAccess

@{
    var isAuthenticated = (bool?)(ViewData["Layout_IsAuthenticated"]) == true;
    var userName = ViewData["Layout_UserName"] as string ?? (User.Identity?.Name ?? "مستخدم");
    var userInitials = ViewData["Layout_UserInitials"] as string ?? (userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "م");
    var userRole = ViewData["Layout_UserRole"] as string ?? "";

    var isCompanyEmployee = (bool?)(ViewData["Layout_IsCompanyEmployee"]) == true;
    var isSystemEmployee = (bool?)(ViewData["Layout_IsSystemEmployee"]) == true;
    var isAnyEmployee = (bool?)(ViewData["Layout_IsAnyEmployee"]) == true;

    var isClientOnly = (bool?)(ViewData["Layout_IsClientOnly"]) == true;
    var isCollectionPointOnly = (bool?)(ViewData["Layout_IsCollectionPointOnly"]) == true;

    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var tab = ViewContext.HttpContext.Request.Query["tab"].ToString();
    var currentType = ViewContext.HttpContext.Request.Query["type"].ToString();
    if (string.IsNullOrWhiteSpace(currentType))
    {
        currentType = ViewContext.RouteData.Values["type"]?.ToString() ?? "";
    }
}

<aside class="sidebar sidebar-pro" id="sidebar">
    <div class="sidebar-header">
        <div class="sidebar-logo sidebar-logo-brand">
            @{
                ViewData["RtBrandVariant"] = "sidebar";
            }
            <partial name="_RadaTikBrandLogo" />
        </div>
        <div class="sidebar-brand">
            <span class="sidebar-brand-name">RadaTik</span>
            <small class="sidebar-brand-sub">نظام إدارة ISP</small>
        </div>
    </div>

    <nav class="sidebar-nav" data-single-open="true">
        @if (!isAuthenticated)
        {
            <div class="nav-section">
                <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                    <i class="fas fa-bars"></i>
                    <span>القائمة</span>
                    <i class="fas fa-chevron-down nav-section-chevron"></i>
                </div>
                <ul class="nav-list">
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Public" && action == "Index" ? "active" : "")"
                           asp-controller="Public" asp-action="Index">
                            <span class="nav-icon"><i class="fas fa-home"></i></span>
                            <span>الصفحة الرئيسية</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Account" && action == "Login" ? "active" : "")"
                           asp-route="reglog-login">
                            <span class="nav-icon"><i class="fas fa-sign-in-alt"></i></span>
                            <span>تسجيل الدخول</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Public" && action == "JoinAsClient" ? "active" : "")"
                           asp-controller="Public" asp-action="JoinAsClient">
                            <span class="nav-icon"><i class="fas fa-user-plus"></i></span>
                            <span>انضم كعميل</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(controller == "Public" && action == "JoinAsEmployee" ? "active" : "")"
                           asp-controller="Public" asp-action="JoinAsEmployee">
                            <span class="nav-icon"><i class="fas fa-user-tie"></i></span>
                            <span>انضم كموظف</span>
                        </a>
                    </li>
                </ul>
            </div>
        }
        else
        {
            <div class="nav-section">
                <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                    <i class="fas fa-th-large"></i>
                    <span>الرئيسية</span>
                    <i class="fas fa-chevron-down nav-section-chevron"></i>
                </div>
                <ul class="nav-list">
                    <li class="nav-item">
                        @if (User.IsInRole("SystemAdministrator"))
                        {
                            <a class="nav-link @(controller == "SystemAdmin" && (string.IsNullOrEmpty(tab) || tab == "dashboard") ? "active" : "")"
                               asp-route="systemAdmin-actions" asp-route-action="Index" asp-route-tab="dashboard">
                                <span class="nav-icon"><i class="fas fa-home"></i></span>
                                <span>لوحة التحكم</span>
                            </a>
                        }
                        else if (User.IsInRole("NetworkAdministrator"))
                        {
                            <a class="nav-link @(ViewContext.RouteData.Values["area"]?.ToString() == "CompanyAdmin" ? "active" : "")"
                               asp-route="networkManager-dashboard">
                                <span class="nav-icon"><i class="fas fa-home"></i></span>
                                <span>لوحة التحكم</span>
                            </a>
                        }
                        else if (isCompanyEmployee)
                        {
                            <a class="nav-link @(ViewContext.RouteData.Values["area"]?.ToString() == "CompanyEmployee" ? "active" : "")"
                               asp-route="employee-dashboard">
                                <span class="nav-icon"><i class="fas fa-home"></i></span>
                                <span>لوحة التحكم</span>
                            </a>
                        }
                        else if (User.IsInRole("CollectionPoint"))
                        {
                            <a class="nav-link @(ViewContext.RouteData.Values["area"]?.ToString() == "CollectionPoint" ? "active" : "")"
                               asp-route="collectionPoint-actions" asp-route-action="Index">
                                <span class="nav-icon"><i class="fas fa-home"></i></span>
                                <span>لوحة التحكم</span>
                            </a>
                        }
                        else if (User.IsInRole("Client"))
                        {
                            <a class="nav-link @(ViewContext.RouteData.Values["area"]?.ToString() == "ClientPortal" ? "active" : "")"
                               asp-route="clientPortal-actions" asp-route-action="Index">
                                <span class="nav-icon"><i class="fas fa-home"></i></span>
                                <span>لوحة التحكم</span>
                            </a>
                        }
                        else
                        {
                            <a class="nav-link @(controller == "Home" && action == "Index" ? "active" : "")"
                               asp-controller="Home" asp-action="Index">
                                <span class="nav-icon"><i class="fas fa-home"></i></span>
                                <span>لوحة التحكم</span>
                            </a>
                        }
                    </li>
                </ul>
            </div>

            @if (User.IsInRole("SystemAdministrator"))
            {
                <div class="nav-section">
                    <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                        <i class="fas fa-shield-alt"></i>
                        <span>إدارة النظام</span>
                        <i class="fas fa-chevron-down nav-section-chevron"></i>
                    </div>
                    <ul class="nav-list">
                        <li class="nav-item">
                            <a class="nav-link @(controller == "SystemAdmin" && tab == "maintenance" ? "active" : "")"
                               asp-route="systemAdmin-actions" asp-route-action="Index" asp-route-tab="maintenance">
                                <span class="nav-icon"><i class="fas fa-tools"></i></span>
                                <span>طلبات الصيانة</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "SystemAdmin" && tab == "collectionpoints" ? "active" : "")"
                               asp-route="systemAdmin-actions" asp-route-action="Index" asp-route-tab="collectionpoints">
                                <span class="nav-icon"><i class="fas fa-cash-register"></i></span>
                                <span>نقاط التحصيل</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "ServiceCatalog" ? "active" : "")"
                               asp-route="systemAdmin-serviceCatalog">
                                <span class="nav-icon"><i class="fas fa-layer-group"></i></span>
                                <span>كتالوج الخدمات</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "Network" ? "active" : "")"
                               asp-area="SystemAdmin" asp-controller="Network" asp-action="Index">
                                <span class="nav-icon"><i class="fas fa-network-wired"></i></span>
                                <span>الشبكات</span>
                            </a>
                        </li>
                        <li class="nav-item has-dropdown">
                            <div class="nav-link-toggle">
                                <span class="nav-icon"><i class="fas fa-building"></i></span>
                                <span>إدارة مديري الشركة</span>
                                <i class="fas fa-chevron-down nav-chevron"></i>
                            </div>
                            <ul class="nav-sublist">
                                <li class="nav-item">
                                    <a class="nav-link nav-link-sub @(controller == "SystemAdmin" && action == "NetworkAdminRequests" ? "active" : "")"
                                       asp-route="systemAdmin-actions" asp-route-action="NetworkAdminRequests">
                                        <span class="nav-icon"><i class="fas fa-user-shield"></i></span>
                                        <span>طلبات مديري الشركة</span>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link nav-link-sub @(controller == "SystemAdmin" && action == "NetworksAndAdmins" ? "active" : "")"
                                       asp-route="systemAdmin-actions" asp-route-action="NetworksAndAdmins">
                                        <span class="nav-icon"><i class="fas fa-network-wired"></i></span>
                                        <span>الشركات ومدراء الشركة</span>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>
            }

            @if (isCollectionPointOnly)
            {
                <div class="nav-section">
                    <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                        <i class="fas fa-cash-register"></i>
                        <span>نقطة التحصيل</span>
                        <i class="fas fa-chevron-down nav-section-chevron"></i>
                    </div>
                    <ul class="nav-list">
                        <li class="nav-item">
                            <a class="nav-link @(controller == "CollectionPoint" && action == "Index" ? "active" : "")"
                               asp-route="collectionPoint-actions" asp-route-action="Index">
                                <span class="nav-icon"><i class="fas fa-cash-register"></i></span>
                                <span>لوحة التحصيل</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "CollectionPoint" && action == "History" ? "active" : "")"
                               asp-route="collectionPoint-actions" asp-route-action="History">
                                <span class="nav-icon"><i class="fas fa-history"></i></span>
                                <span>سجل التحصيل</span>
                            </a>
                        </li>
                    </ul>
                </div>
            }

            @if (User.IsInRole("NetworkAdministrator"))
            {
                <div class="nav-section nav-section-manager">
                    <ul class="nav-list">
                        <!-- React manager sidebar: 5 main links -->
                        <li class="nav-item">
                            <a class="nav-link @(controller == "Dashboard" && action == "Index" ? "active" : "")"
                               asp-route="networkManager-dashboard">
                                <span class="nav-icon"><i class="fas fa-tachometer-alt"></i></span>
                                <span>لوحة التحكم</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(controller == "Wallet" && action == "TopUp" ? "active" : "")"
                               asp-route="networkManager-wallet-topup">
                                <span class="nav-icon"><i class="fas fa-receipt"></i></span>
                                <span>الفوترة</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(controller == "Admin" ? "active" : "")"
                               asp-route="networkManager-users">
                                <span class="nav-icon"><i class="fas fa-building"></i></span>
                                <span>الفريق</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(controller == "Features" ? "active" : "")"
                               asp-route="networkManager-features">
                                <span class="nav-icon"><i class="fas fa-chart-bar"></i></span>
                                <span>التقارير</span>
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(controller == "Profile" ? "active" : "")"
                               asp-route="networkManager-profile" asp-route-action="Index">
                                <span class="nav-icon"><i class="fas fa-cog"></i></span>
                                <span>الإعدادات</span>
                            </a>
                        </li>
                    </ul>
                </div>
            }

            @if (isCompanyEmployee)
            {
                var canUseClients = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Clients);
                var canUseSectors = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Sectors);
                var canUseReceivers = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Receivers);

                var canViewClients = canUseClients && await PermissionService.HasPermissionAsync(User, "Clients.View");
                var canViewSectors = canUseSectors && await PermissionService.HasPermissionAsync(User, "Sectors.View");
                var canViewReceivers = canUseReceivers && await PermissionService.HasPermissionAsync(User, "Receivers.View");

                if (canViewClients || canViewSectors || canViewReceivers)
                {
                    <div class="nav-section">
                        <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                            <i class="fas fa-project-diagram"></i>
                            <span>إدارة الشبكة</span>
                            <i class="fas fa-chevron-down nav-section-chevron"></i>
                        </div>
                        <ul class="nav-list">
                            @if (canViewClients)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(controller == "Clients" ? "active" : "")"
                                       asp-area="CompanyEmployee" asp-controller="Clients" asp-action="Index">
                                        <span class="nav-icon"><i class="fas fa-users"></i></span>
                                        <span>العملاء</span>
                                    </a>
                                </li>
                            }

                            @if (canViewSectors)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(controller == "Sector" ? "active" : "")"
                                       asp-area="CompanyEmployee" asp-controller="Sector" asp-action="Index">
                                        <span class="nav-icon"><i class="fas fa-broadcast-tower"></i></span>
                                        <span>إدارة المرسلات (القطاعات)</span>
                                    </a>
                                </li>
                            }

                            @if (canViewReceivers)
                            {
                                <li class="nav-item">
                                    <a class="nav-link @(controller == "Receiver" ? "active" : "")"
                                       asp-area="CompanyEmployee" asp-controller="Receiver" asp-action="Index">
                                        <span class="nav-icon"><i class="fas fa-satellite-dish"></i></span>
                                        <span>إدارة المستقبلات</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }

            @if (User.IsInRole("NetworkAdministrator") || isCompanyEmployee)
            {
                var canUseRequestsFeature = await FeatureAccess.HasFeatureAsync(User, ViewContext.HttpContext, FeatureKeys.Requests);
                var canSeeRequests = false;

                if (User.IsInRole("NetworkAdministrator"))
                {
                    canSeeRequests = canUseRequestsFeature;
                }
                else if (isCompanyEmployee)
                {
                    var canViewRequests = await PermissionService.HasPermissionAsync(User, "Requests.View");
                    canSeeRequests = canUseRequestsFeature && canViewRequests;
                }

                if (canSeeRequests)
                {
                    <div class="nav-section">
                        <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                            <i class="fas fa-clipboard-list"></i>
                            <span>إدارة الطلبات</span>
                            <i class="fas fa-chevron-down nav-section-chevron"></i>
                        </div>
                        <ul class="nav-list">
                            <li class="nav-item">
                                @if (isCompanyEmployee && !User.IsInRole("NetworkAdministrator"))
                                {
                                    <a class="nav-link @(controller == "RequestsManagement" && action == "Index" ? "active" : "")"
                                       asp-route="employee-requestsManagement" asp-route-action="Index">
                                        <span class="nav-icon"><i class="fas fa-tasks"></i></span>
                                        <span>لوحة الطلبات</span>
                                        <span class="nav-badge" id="pendingRequestsBadge" style="display: none;">0</span>
                                    </a>
                                }
                                else
                                {
                                    <a class="nav-link @(controller == "RequestsManagement" && action == "Index" ? "active" : "")"
                                       asp-route="networkManager-requestsManagement" asp-route-action="Index">
                                        <span class="nav-icon"><i class="fas fa-tasks"></i></span>
                                        <span>لوحة الطلبات</span>
                                        <span class="nav-badge" id="pendingRequestsBadge" style="display: none;">0</span>
                                    </a>
                                }
                            </li>
                            <li class="nav-item">
                                @if (isCompanyEmployee && !User.IsInRole("NetworkAdministrator"))
                                {
                                    <a class="nav-link @(controller == "RequestsManagement" && action == "MaintenanceRequests" ? "active" : "")"
                                       asp-route="employee-requestsManagement" asp-route-action="MaintenanceRequests">
                                        <span class="nav-icon"><i class="fas fa-tools"></i></span>
                                        <span>طلبات الصيانة</span>
                                    </a>
                                }
                                else
                                {
                                    <a class="nav-link @(controller == "RequestsManagement" && action == "MaintenanceRequests" ? "active" : "")"
                                       asp-route="networkManager-requestsManagement" asp-route-action="MaintenanceRequests">
                                        <span class="nav-icon"><i class="fas fa-tools"></i></span>
                                        <span>طلبات الصيانة</span>
                                    </a>
                                }
                            </li>
                            <li class="nav-item">
                                @if (isCompanyEmployee && !User.IsInRole("NetworkAdministrator"))
                                {
                                    <a class="nav-link @(controller == "RequestsManagement" && action == "SpeedChangeRequests" ? "active" : "")"
                                       asp-route="employee-requestsManagement" asp-route-action="SpeedChangeRequests">
                                        <span class="nav-icon"><i class="fas fa-tachometer-alt"></i></span>
                                        <span>طلبات تغيير السرعة</span>
                                    </a>
                                }
                                else
                                {
                                    <a class="nav-link @(controller == "RequestsManagement" && action == "SpeedChangeRequests" ? "active" : "")"
                                       asp-route="networkManager-requestsManagement" asp-route-action="SpeedChangeRequests">
                                        <span class="nav-icon"><i class="fas fa-tachometer-alt"></i></span>
                                        <span>طلبات تغيير السرعة</span>
                                    </a>
                                }
                            </li>
                        </ul>
                    </div>
                }
            }

            @if (isClientOnly)
            {
                <div class="nav-section">
                    <div class="nav-section-title nav-section-toggle" role="button" tabindex="0" aria-expanded="true">
                        <i class="fas fa-user-circle"></i>
                        <span>حسابي</span>
                        <i class="fas fa-chevron-down nav-section-chevron"></i>
                    </div>
                    <ul class="nav-list">
                        <li class="nav-item">
                            <a class="nav-link @(controller == "ClientPortal" && action == "Index" ? "active" : "")"
                               asp-route="clientPortal-actions" asp-route-action="Index">
                                <span class="nav-icon"><i class="fas fa-home"></i></span>
                                <span>لوحة التحكم</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "Clients" ? "active" : "")"
                               asp-controller="Clients" asp-action="Index">
                                <span class="nav-icon"><i class="fas fa-id-card"></i></span>
                                <span>معلومات الاشتراك</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "ClientPortal" && action == "MaintenanceRequests" ? "active" : "")"
                               asp-route="clientPortal-actions" asp-route-action="MaintenanceRequests">
                                <span class="nav-icon"><i class="fas fa-tools"></i></span>
                                <span>طلبات الصيانة</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "ClientPortal" && action == "SpeedChangeRequests" ? "active" : "")"
                               asp-route="clientPortal-actions" asp-route-action="SpeedChangeRequests">
                                <span class="nav-icon"><i class="fas fa-tachometer-alt"></i></span>
                                <span>طلبات تغيير السرعة</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @(controller == "ClientPortal" && action == "AvailablePlans" ? "active" : "")"
                               asp-route="clientPortal-actions" asp-route-action="AvailablePlans">
                                <span class="nav-icon"><i class="fas fa-list-alt"></i></span>
                                <span>الباقات المتاحة</span>
                            </a>
                        </li>
                    </ul>
                </div>
            }
        }
    </nav>

    @if (isAuthenticated && User.IsInRole("NetworkAdministrator") && ViewBag.Networks != null)
    {
        <div class="sidebar-footer">
            <div class="network-selector">
                <div class="network-selector-header">
                    <div class="network-selector-icon">
                        <i class="fas fa-network-wired"></i>
                    </div>
                    <div class="network-selector-label">
                        الشبكة المحددة
                    </div>
                </div>
                <form asp-area="" asp-controller="Network" asp-action="SelectNetwork" method="post" class="network-selector-form">
                    <select name="networkId" class="network-selector-select" onchange="this.form.submit()">
                        @if (ViewBag.Networks is List<RadaTik.Models.Network> networks && networks.Any())
                        {
                            @foreach (var network in networks)
                            {
                                var isSelected = ViewBag.CurrentNetworkId != null && ViewBag.CurrentNetworkId == network.Id;
                                <option value="@network.Id" selected="@isSelected">@network.Name</option>
                            }
                        }
                    </select>
                    @Html.AntiForgeryToken()
                </form>
            </div>
        </div>
    }
</aside>
