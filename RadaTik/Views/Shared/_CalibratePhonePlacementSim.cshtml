@* محاكاة بصرية: LiteBeam + موبايل على ظهر الصحن *@
@{
    var isTx = string.Equals(ViewData["CalibrateRole"] as string, "tx", StringComparison.OrdinalIgnoreCase);
    var title = isTx ? "المرسل · القطاع / اللاقط" : "المستقبل · اللاقط";
    var toward = isTx ? "الحزمة نحو المستقبل" : "الحزمة نحو المرسل / البرج";
    var simId = isTx ? "calSimTx" : "calSimRx";
}

<div class="calibrate-sim" id="@simId" data-role="@(isTx ? "tx" : "rx")" aria-label="@title — محاكاة لصق الموبايل على ظهر الصحن">
    <div class="calibrate-sim-stage" dir="ltr">
        <img class="calibrate-sim-antenna" src="~/img/calibration/litebeam.png" asp-append-version="true" alt="هوائي LiteBeam" />
        <div class="calibrate-sim-beam" aria-hidden="true"></div>
        <div class="calibrate-sim-phone" aria-hidden="true">
            <img src="~/img/calibration/phone.png" asp-append-version="true" alt="" />
            <span class="calibrate-sim-phone-label">الشاشة نحو الفني</span>
        </div>
        <div class="calibrate-sim-badge calibrate-sim-badge-ok">صحيح · ظهر الصحن</div>
        <div class="calibrate-sim-badge calibrate-sim-badge-bad">خطأ</div>
        <div class="calibrate-sim-title">@title</div>
        <div class="calibrate-sim-toward">@toward</div>
    </div>

    <div class="calibrate-sim-controls">
        <button type="button" class="btn btn-sm btn-success cal-sim-play">تشغيل المحاكاة</button>
        <button type="button" class="btn btn-sm btn-outline-light cal-sim-ok">الوضع الصحيح</button>
        <button type="button" class="btn btn-sm btn-outline-danger cal-sim-bad">وضع خاطئ</button>
    </div>
    <p class="calibrate-sim-caption">الصق <strong>ظهر الموبايل</strong> على <strong>الظهر الخلفي للصحن</strong> (من جهة التركيب)، والشاشة نحو الفني. لا تلصق على الذراع المعدني أو المغناطيس.</p>
</div>
