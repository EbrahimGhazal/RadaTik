@model RadaTik.ViewModels.Account.LoginViewModel
@using RadaTik.Security
@{
    ViewData["Title"] = "تسجيل الدخول";
    ViewData["BodyClass"] = "login-page login-page--radatik-spa-identity";
    Layout = "~/Views/Shared/_AuthLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
}

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="login-brand" dir="ltr">
                <div class="login-brand-inner">
                    @{
                        ViewData["RtBrandVariant"] = "hero";
                    }
                    <partial name="_RadaTikBrandLogo" />
                </div>
            </div>
            @{
                var nativeApp = ViewData["NativeApp"] as string;
                var nativeAppTitle = ViewData["NativeAppTitle"] as string;
            }
            @if (!string.IsNullOrWhiteSpace(nativeApp))
            {
                <p class="login-subtitle login-app-lock">@nativeAppTitle — الدخول مسموح لهذا الدور فقط</p>
            }
            else
            {
                <p class="login-subtitle login-subtitle--muted">نظام إدارة مزود خدمة الإنترنت</p>
            }
        </div>

        <div class="login-body">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger rt-alert">
                    <i class="fas fa-exclamation-circle"></i>
                    @TempData["Error"]
                </div>
            }

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success rt-alert">
                    <i class="fas fa-check-circle"></i>
                    @TempData["Success"]
                </div>
            }

            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info rt-alert">
                    <i class="fas fa-info-circle"></i>
                    @TempData["Info"]
                </div>
            }

            <form id="loginForm" asp-route="reglog-login" method="post" novalidate>
                <input type="hidden" asp-for="AppRole" />
                @if (!string.IsNullOrWhiteSpace(ViewData["ReturnUrl"] as string))
                {
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                }
                <div asp-validation-summary="ModelOnly" class="validation-error"></div>

                <div class="form-group">
                    <label asp-for="UserName" class="form-label">اسم المستخدم أو رقم الجوال</label>
                    <div class="input-wrapper" dir="ltr">
                        <input asp-for="UserName"
                               class="form-control rt-input"
                               placeholder="اسم النظام / MikroTik / رقم الجوال"
                               autocomplete="username"
                               autocapitalize="none"
                               autocorrect="on"
                               spellcheck="true"
                               inputmode="text"
                               enterkeyhint="next"
                               dir="ltr"
                               required />
                        <i class="fas fa-user"></i>
                    </div>
                    <div class="form-text">يمكن الدخول باسم مستخدم النظام، أو اسم مستخدم MikroTik، أو رقم الجوال المسجّل — مع كلمة مرور الحساب.</div>
                    <span asp-validation-for="UserName" class="validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Password" class="form-label">كلمة المرور</label>
                    <div class="input-wrapper" dir="ltr">
                        <input asp-for="Password"
                               class="form-control rt-input"
                               id="passwordInput"
                               type="password"
                               placeholder="أدخل كلمة المرور"
                               autocomplete="current-password"
                               autocapitalize="none"
                               spellcheck="false"
                               enterkeyhint="go"
                               dir="ltr"
                               required />
                        <i class="fas fa-lock"></i>
                        <button type="button" class="password-toggle" id="passwordToggle" aria-label="إظهار كلمة المرور" title="إظهار كلمة المرور">
                            <i class="fas fa-eye" id="passwordToggleIcon"></i>
                        </button>
                    </div>
                    <div class="capslock-hint" id="capsLockHint" style="display:none;">
                        <i class="fas fa-triangle-exclamation"></i>
                        تنبيه: زر Caps Lock مفعّل
                    </div>
                    <span asp-validation-for="Password" class="validation-error"></span>
                </div>

                <div class="form-options">
                    @if (string.IsNullOrWhiteSpace(ViewData["NativeApp"] as string))
                    {
                        <div class="form-check">
                            <input asp-for="RememberMe" class="form-check-input" />
                            <label asp-for="RememberMe" class="form-check-label">تذكرني</label>
                        </div>
                    }
                    else
                    {
                        <p class="login-persist-note">سيبقى حسابك مسجلاً على هذا التطبيق حتى تسجّل الخروج بنفسك.</p>
                    }
                    <a asp-route="reglog-forgotpassword" class="forgot-link">نسيت كلمة المرور؟</a>
                </div>

                <button type="submit" class="btn btn-primary rt-btn-submit" id="loginSubmitBtn">
                    <span class="btn-content">
                        <i class="fas fa-sign-in-alt"></i>
                        تسجيل الدخول
                    </span>
                    <span class="btn-loading" aria-hidden="true">
                        <i class="fas fa-circle-notch fa-spin"></i>
                        جاري الدخول...
                    </span>
                </button>
            </form>

        </div>

        <div class="login-footer">
            <p class="login-footer-copy">© @DateTime.Now.Year RadaTik - جميع الحقوق محفوظة</p>
            <div class="login-footer-links">
                @if (string.IsNullOrWhiteSpace(nativeApp))
                {
                    <a asp-controller="Public" asp-action="Index" class="back-link">
                        <i class="fas fa-arrow-right"></i>
                        العودة للصفحة الرئيسية
                    </a>
                    <span class="login-footer-sep">|</span>
                    <a asp-action="RegisterNetworkAdmin" asp-controller="Account" asp-area="" class="back-link back-link--emphasis">
                        <i class="fas fa-user-shield"></i>
                        إنشاء حساب مدير شبكة
                    </a>
                    <span class="login-footer-sep">|</span>
                    <a asp-action="RegisterCollectionPoint" asp-controller="Account" asp-area="" class="back-link back-link--emphasis">
                        <i class="fas fa-paper-plane"></i>
                        طلب إنشاء نقطة تحصيل
                    </a>
                }
                else if (nativeApp == NativeAppContext.Company)
                {
                    <a asp-action="RegisterNetworkAdmin" asp-controller="Account" asp-area="" asp-route-app="company" class="back-link back-link--emphasis">
                        <i class="fas fa-user-shield"></i>
                        إنشاء حساب مدير شركة
                    </a>
                }
                else if (nativeApp == NativeAppContext.Collection)
                {
                    <a asp-action="RegisterCollectionPoint" asp-controller="Account" asp-area="" asp-route-app="collection" class="back-link back-link--emphasis">
                        <i class="fas fa-paper-plane"></i>
                        إنشاء حساب نقطة تحصيل
                    </a>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
    <script src="~/js/login.js" asp-append-version="true"></script>
}
