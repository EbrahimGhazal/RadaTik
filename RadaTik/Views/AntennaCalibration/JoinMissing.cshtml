@{
    Layout = "~/Views/Shared/_CalibrateFieldLayout.cshtml";
    ViewData["Title"] = "الجلسة غير موجودة";
    bool isEmployee = User.IsInRole("CompanyEmployee") || User.IsInRole("Employee");
    string backHref = isEmployee ? "/employee/Calibration" : "/networkManager/Calibration";
}

<div class="calibrate-field-page">
    <div class="alert alert-warning">انتهت جلسة المعايرة أو الرمز غير صحيح. اطلب رمزاً جديداً من شاشة المعايرة.</div>
    <a class="btn btn-primary w-100" href="@backHref">العودة للمعايرة</a>
</div>
